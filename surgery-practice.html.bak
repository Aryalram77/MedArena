er":"B","text":"Toddlers (1-3 years)"},{"letter":"C","text":"Children (5-15 years)"},{"letter":"D","text":"Adults (20+ years)"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":31,"chapter":"Public Health","src":"Loksewa paper p. 4 (Medical Officer 2083-01-04)","pdfPage":4,"stem":"What method is appropriate to promote ORS use in communities?","options":[{"letter":"A","text":"Demonstration"},{"letter":"B","text":"Role play"},{"letter":"C","text":"Brain storming"},{"letter":"D","text":"Group discussion"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":32,"chapter":"Public Health","src":"Loksewa paper p. 4 (Medical Officer 2083-01-04)","pdfPage":4,"stem":"The constant presence of a disease or infectious agent within a geographical region is known as:","options":[{"letter":"A","text":"Epidemic"},{"letter":"B","text":"Epizootic"},{"letter":"C","text":"Sporadic"},{"letter":"D","text":"Endemic"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":33,"chapter":"Public Health","src":"Loksewa paper p. 4 (Medical Officer 2083-01-04)","pdfPage":4,"stem":"What will be your first action in outbreak of diarrheal disease in community?","options":[{"letter":"A","text":"Supply of ORS"},{"letter":"B","text":"Improvement of personal hygiene"},{"letter":"C","text":"Quick mobilization of medical persons"},{"letter":"D","text":"Sufficient supply of antibiotics and IV fluids"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":34,"chapter":"Public Health","src":"Loksewa paper p. 4 (Medical Officer 2083-01-04)","pdfPage":4,"stem":"The diet recommended at high altitude is:","options":[{"letter":"A","text":"High protein diet"},{"letter":"B","text":"High fat diet"},{"letter":"C","text":"High carbohydrate diet"},{"letter":"D","text":"Low carbohydrate and high