r"},{"letter":"D","text":"Malaria"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":81,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"A patient with obstructive jaundice due to pancreatic carcinoma might have all of the following clinical findings EXCEPT:","options":[{"letter":"A","text":"A palpable gallbladder"},{"letter":"B","text":"Pain early in the course of the disease"},{"letter":"C","text":"Pulmonary metastases"},{"letter":"D","text":"A mass in the head of the pancreas"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":82,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"The most common site of volvulus in adults is:","options":[{"letter":"A","text":"Cecum"},{"letter":"B","text":"Sigmoid colon"},{"letter":"C","text":"Duodenum"},{"letter":"D","text":"Jejunum"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":83,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"Which of the following is the primary imaging modality for diagnosing gallstones?","options":[{"letter":"A","text":"CT scan"},{"letter":"B","text":"MRI"},{"letter":"C","text":"Ultrasound"},{"letter":"D","text":"Endoscopic retrograde cholangiopancreatography"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":84,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"Which of the following indicates carcinoma of breast?","options":[{"letter":"A","text":"Serous discharge"},{"letter":"B","text":"Cracked nipple"},{"letter":"C","text":"Ulceration of nipple"},{"letter":"D","text":"Recent retraction of nipple"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":85,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"Primary closure of incised wound must be done within:","options":[{"letter":"A","text":"4 hrs"},{"letter":"B","text":"2 hrs"},{"letter":"C","text":"6 hrs"},{"letter":"D","text":"8 hrs"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":86,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"Murphy's triad is the combination of symptoms:","options":[{"letter":"A","text":"Fever, pain and jaundice"},{"letter":"B","text":"Pain, jaundice and vomiting"},{"letter":"C","text":"Pain, vomiting and fever"},{"letter":"D","text":"Jaundice, fever and vomiting"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":87,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"The commonest cause of pulmonary insufficiency in the early post operative period following major abdominal surgery is:","options":[{"letter":"A","text":"Aspiration of gastric contents"},{"letter":"B","text":"Atelectasis"},{"letter":"C","text":"Pneumothorax"},{"letter":"D","text":"Pulmonary oedema"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":88,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"Vasectomy is surgical contraception for male. Where is this surgery mostly done in Nepal?","options":[{"letter":"A","text":"In OPD setting"},{"letter":"B","text":"In camp setting"},{"letter":"C","text":"In operation room"},{"letter":"D","text":"In clinic"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":89,"chapter":"Surgery","src":"Loksewa paper p. 7 (Medical Officer 2083-01-04)","pdfPage":7,"stem":"What is the commonest cause of liver abscess in Nepal based on hospital experience?","options":[{"letter":"A","text":"Gram negative bacteria"},{"letter":"B","text":"Gram positive bacteria"},{"letter":"C","text":"Amoeba"},{"letter":"D","text":"Fungus"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":90,"chapter":"Medicine","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"What is a complication of long-term antibiotics administration in a case of lung abscess?","options":[{"letter":"A","text":"Capsule formation"},{"letter":"B","text":"Preformation"},{"letter":"C","text":"Pleural effusion"},{"letter":"D","text":"Opportunist infection"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":91,"chapter":"Public Health","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"Which occupation has more chance of eye injury in Nepal?","options":[{"letter":"A","text":"Factory labor"},{"letter":"B","text":"Cement factory labor"},{"letter":"C","text":"Farmer"},{"letter":"D","text":"Computer operator"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":92,"chapter":"Ophthalmology","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"The Snellen chart is used to assess:","options":[{"letter":"A","text":"Visual fields"},{"letter":"B","text":"Visual acuity"},{"letter":"C","text":"Color vision"},{"letter":"D","text":"Depth perception"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":93,"chapter":"Ophthalmology","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"The confirmatory diagnostic sign of corneal ulcer is:","options":[{"letter":"A","text":"Ciliary infection"},{"letter":"B","text":"Blepharospasm"},{"letter":"C","text":"Miosis"},{"letter":"D","text":"Positive fluorescein test"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":94,"chapter":"Ophthalmology","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"Which is the leading cause of blindness globally?","options":[{"letter":"A","text":"Trachoma"},{"letter":"B","text":"Cataract"},{"letter":"C","text":"Diabetic retinopathy"},{"letter":"D","text":"Vitamin A deficiency"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":95,"chapter":"ENT","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"Which one is vaccine preventable disease?","options":[{"letter":"A","text":"Hoarseness of voice"},{"letter":"B","text":"Otitis media"},{"letter":"C","text":"Tonsillitis"},{"letter":"D","text":"Diphtheria"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":96,"chapter":"ENT","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"3 years old child has history of nasal discharge which is foul smelling since last few weeks, what can be the cause?","options":[{"letter":"A","text":"Allergic rhinitis"},{"letter":"B","text":"Foreign body in nose"},{"letter":"C","text":"Rhinorrhea"},{"letter":"D","text":"Sinusitis"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":97,"chapter":"ENT","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"Hoarseness lasting more than three weeks should be evaluated for:","options":[{"letter":"A","text":"Laryngitis"},{"letter":"B","text":"Vocal cord paralysis"},{"letter":"C","text":"Laryngeal cancer"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":98,"chapter":"Dentistry","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"Which of the following is a common complication of untreated tooth decay?","options":[{"letter":"A","text":"Abscess formation"},{"letter":"B","text":"Tooth sensitivity"},{"letter":"C","text":"Bleeding gums"},{"letter":"D","text":"Gingivitis"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":99,"chapter":"Dentistry","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"What is the preferred management of pyogenic granuloma of oral cavity?","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Antibiotic therapy"},{"letter":"C","text":"Radiotherapy"},{"letter":"D","text":"Surgical excision"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":100,"chapter":"Dentistry","src":"Loksewa paper p. 8 (Medical Officer 2083-01-04)","pdfPage":8,"stem":"A 60 year old male presents with yellowing of his teeth, along with halitosis (bad breath). He has a history of smoking and poor dental hygiene. His oral examination reveals plaque accumulation along the gumline and evidence of calculus on the molars. What is the most appropriate management for this condition as a medical officer?","options":[{"letter":"A","text":"Fluoride treatment"},{"letter":"B","text":"Professional dental cleaning and scaling"},{"letter":"C","text":"Antifungal therapy"},{"letter":"D","text":"Root canal therapy"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null}]};
const BANKS = [{ id: "se1", bank: BANK }, { id: "loksewa", bank: LOKSEWA }];
let CUR = BANKS[0].bank;
const LETTERS = "ABCDE";
const $ = s => { const d = document; const el = d.getElementById(s); return el || d.querySelector(s); };
const esc = t => (t ?? "").toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const shuffle = a => { const x = [...a]; for (let i = x.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [x[i], x[j]] = [x[j], x[i]]; } return x; };
const fmtTime = s => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
const QKEY = q => q.stem.slice(0, 120);

const state = { exam: null, errors: new Set(JSON.parse(store.getItem("se1.errors") || "[]")) };
function toast(m){ const t = $("toast"); t.textContent = m; t.style.display = "block"; clearTimeout(t._h); t._h = setTimeout(() => t.style.display = "none", 3500); }

function runtimeQuestion(q, shufO){
  const noKey = !!CUR.noKey;
  const correctSet = noKey ? [] : (q.correctSet || [q.answerLetter]).filter(L => q.options.some(o => o.letter === L));
  const multi = correctSet.length > 1;
  let opts = q.options.map(o => ({ k: o.letter, text: o.text, correct: (!noKey && correctSet.includes(o.letter)) ? 1 : 0 }));
  if (shufO) opts = shuffle(opts);
  return { stem: q.stem, options: opts, correctSet, multi, chapter: q.chapter, src: q.src, pdfPage: q.pdfPage, explanation: noKey ? null : q.explanation, n: q.n, noKey };
}

function buildPool(){
  const size = parseInt($("setSizeSel").value, 10);
  const n = CUR.questions.length;
  const val = $("setSel").value;
  let src;
  if (val === "all") src = [...CUR.questions];
  else if (val === "errors") { src = CUR.questions.filter(q => state.errors.has(QKEY(q))); if (!src.length) { toast("No past errors recorded yet."); return null; } }
  else if (val.startsWith("ch:")) { const ch = val.slice(3); src = CUR.questions.filter(q => q.chapter === ch); }
  else { const i = parseInt(val, 10); src = CUR.questions.slice(i * size, Math.min(n, (i + 1) * size)); }
  return { src, label: $("setSel").selectedOptions[0].textContent };
}

$("setSizeSel").onchange = renderSets;
$("modeSel").onchange = () => { const m = $("modeSel").value; $("timerMin").disabled = m === "tutor"; $("timerMin").value = m === "tutor" ? 0 : 60; };
$("startBtn").onclick = startExam;
function startExam(){
  const bp = buildPool(); if (!bp) return;
  let pool = $("shufQ").checked ? shuffle([...bp.src]) : [...bp.src];
  pool = pool.map(q => runtimeQuestion(q, $("shufO").checked));
  const mode = CUR.noKey ? "timed" : $("modeSel").value;
  const minutes = mode === "tutor" ? 0 : Math.max(0, parseInt($("timerMin").value, 10) || 0);
  state.exam = { pool, label: bp.label, mode, minutes, sel: pool.map(() => null), flags: pool.map(() => false), marks: {}, cur: 0, timeLeft: minutes * 60, timerInt: null };
  if (mode === "timed" && minutes > 0) { state.exam.timerInt = setInterval(tick, 1000); updateTimer(); }
  ["examOrchestrator", "examResults"].forEach(id => $(`#${id}`).style.display = "none");
  $("examPlay").style.display = "block";
  $("examTitle").textContent = `${CUR.name} · ${bp.label}`;
  const pill = $("examModePill");
  pill.textContent = CUR.noKey ? "📝 Self-assess" : (mode === "tutor" ? "🎓 Tutor" : "⏱ Timed");
  pill.className = "pill " + (mode === "tutor" ? "tutor" : "timed");
  $("timerBox").style.display = mode === "timed" && minutes > 0 ? "" : "none";
  $("timerBox").classList.remove("low");
  renderQuestion(); renderPalette();
  window.scrollTo(0, 0);
}
function tick(){
  if (!state.exam) return;
  state.exam.timeLeft--;
  updateTimer();
  if (state.exam.timeLeft <= 60) $("timerBox").classList.add("low");
  if (state.exam.timeLeft <= 0) finishExam(true);
}
function updateTimer(){ if (state.exam) $("timerBox").textContent = fmtTime(Math.max(0, state.exam.timeLeft)); }
function renderPalette(){
  const ex = state.exam; const pal = $("palette"); pal.innerHTML = "";
  ex.pool.forEach((_, i) => {
    const b = document.createElement("button");
    b.textContent = i + 1;
    if (ex.sel[i] && ex.sel[i].length) b.classList.add("ans");
    if (ex.flags[i]) b.classList.add("flag");
    if (i === ex.cur) b.classList.add("cur");
    b.onclick = () => { ex.cur = i; renderQuestion(); renderPalette(); };
    pal.appendChild(b);
  });
}
function baselineOpts(q){
  return q.options.map((o, oi) =>
    `<div class="optrow${q.multi ? " multi" : ""}" data-oi="${oi}" data-text="${esc(o.text)}"><span class="lt">${esc(o.k)}</span><span class="ot">${esc(o.text)}</span><button class="strikebtn" title="strike out">⊘</button></div>`);
}
function renderQuestion(){
  const ex = state.exam; if (!ex) return;
  const i = ex.cur, q = ex.pool[i];
  const sel = ex.sel[i] || [];
  const answered = !!(sel.length);
  const flag = ex.flags[i];
  const marks = ex.marks[i];
  const revealed = revealedView(i);
  let optHtml = revealed || (marks && marks.opts ? marks.opts.slice() : baselineOpts(q));
  if (answered && ex.mode !== "tutor") {
    optHtml = (marks && marks.opts ? marks.opts.slice() : baselineOpts(q)).map(h => {
      const oi = parseInt(h.match(/data-oi="(\d+)"/)[1], 10);
      if (q.options[oi] && sel.includes(q.options[oi].k)) return h.replace(/class="optrow/, 'class="optrow sel');
      return h;
    });
  }
  $("qBody").innerHTML = `
    <div class="qnum"><span>Question ${i + 1} of ${ex.pool.length} ${flag ? "<span style='color:var(--flag)'>⚑</span>" : ""}
      <span class="badge a">${esc(q.chapter)}</span>${q.multi ? '<span class="badge m">multi-select</span>' : ""}</span>
      <span style="display:flex;gap:8px">
        <button class="hlbtn" id="hlBtn">🖍 Highlight</button>
        <button class="hlbtn" id="clrBtn">↺ Clear marks</button>
        <button class="hlbtn" style="border-color:#fcd34d" id="flagBtn">${flag ? "🚩 Unflag" : "⚑ Flag"}</button>
      </span></div>
    <div class="stem" id="stemEl"><span class="s0">${esc(q.stem)}</span></div>
    <div id="optsEl" style="margin-top:12px">${optHtml.join("")}</div>
    ${q.noKey ? "" : `<div class="explain ${revealed ? "show" : ""}" id="explPanel">
      <span class="tag">Explanation</span>
      ${esc(q.explanation || "No explanation available.")}
    </div>`}`;
  $("qBody").querySelectorAll(".optrow").forEach(row => {
    row.onclick = e => {
      if (e.target.classList.contains("strikebtn")) { e.stopPropagation(); toggleStrike(row, i); return; }
      if (revealed) return;
      choose(i, parseInt(row.dataset.oi, 10), row);
    };
  });
  $("prevBtn").onclick = () => { if (ex.cur > 0) { ex.cur--; renderQuestion(); renderPalette(); } };
  $("nextBtn").onclick = () => { if (ex.cur < ex.pool.length - 1) { ex.cur++; renderQuestion(); renderPalette(); } else if (ex.mode === "tutor") { /* stay */ } };
  $("flagBtn").onclick = () => { ex.flags[i] = !ex.flags[i]; renderQuestion(); renderPalette(); };
  $("hlBtn").onclick = () => applyHighlight(i);
  $("clrBtn").onclick = () => { delete ex.marks[i]; renderQuestion(); };
  $("posLabel").textContent = `Answered ${ex.sel.filter(x => x && x.length).length}/${ex.pool.length} · Flagged ${ex.flags.filter(Boolean).length}`;
}
function revealedView(i){
  const ex = state.exam;
  if (ex.pool[i] && ex.pool[i].noKey) return null;
  if (ex.mode !== "tutor" || !ex.reveal || !ex.reveal[i]) return null;
  const q = ex.pool[i];
  const sel = ex.sel[i] || [];
  return q.options.map((o, oi) => {
    const isC = o.correct === 1, isU = sel.includes(o.k);
    let cls = isC ? "reveal-ok" : isU ? "reveal-bad" : "";
    const tag = isC ? "Correct" : isU ? "Your pick" : "";
    return `<div class="optrow multi ${cls}" data-oi="${oi}" style="cursor:default"><span class="lt">${esc(o.k)}</span><span class="ot">${esc(o.text)}</span>${tag ? `<span class="pill" style="margin-left:auto;flex-shrink:0;font-size:11px">${tag}</span>` : ""}</div>`;
  });
}
function choose(i, oi, row){
  const ex = state.exam, q = ex.pool[i];
  const k = q.options[oi].k;
  ex.sel[i] = ex.sel[i] || [];
  const at = ex.sel[i].indexOf(k);
  if (q.multi) { if (at >= 0) ex.sel[i].splice(at, 1); else ex.sel[i].push(k); }
  else {
    if (ex.mode === "tutor" && !q.noKey) {
      ex.sel[i] = [k];
      ex.reveal = ex.reveal || {};
      ex.reveal[i] = true;
      record_error(q, false);
    } else {
      if (ex.sel[i][0] === k) ex.sel[i] = []; else ex.sel[i] = [k];
    }
  }
  renderQuestion(); renderPalette();
}
function record_error(q, wrong){
  const key = QKEY(q);
  if (wrong) { state.errors.add(key); store.setItem("se1.errors", JSON.stringify([...state.errors])); }
  else if (state.errors.has(key)) { state.errors.delete(key); store.setItem("se1.errors", JSON.stringify([...state.errors])); }
}
function toggleStrike(row, qi){
  const ot = row.querySelector(".ot"); if (!ot) return;
  if (ot.parentElement.tagName === "S") { const par = ot.parentElement.parentElement; par.replaceChild(ot, ot.parentElement); }
  else { const s = document.createElement("s"); s.appendChild(ot.cloneNode(true)); ot.replaceWith(s); }
  saveMarks(qi);
}
function applyHighlight(qi){
  const sel = window.getSelection(), stemEl = $("stemEl");
  if (!sel || sel.rangeCount === 0 || sel.isCollapsed) { toast("Select some text in the stem first."); return; }
  const range = sel.getRangeAt(0);
  if (!stemEl.contains(range.commonAncestorContainer)) { toast("Selection must be inside the question stem."); return; }
  const mk = document.createElement("mark");
  try { range.surroundContents(mk); } catch (e) { try { mk.appendChild(range.extractContents()); range.insertNode(mk); } catch (e2) { toast("Cannot highlight this selection."); return; } }
  sel.removeAllRanges(); saveMarks(qi);
}
function saveMarks(qi){
  state.exam.marks[qi] = { stem: $("stemEl").innerHTML, opts: [...$("optsEl").querySelectorAll(".optrow")].map(r => r.outerHTML) };
}
$("submitBtn").onclick = () => {
  if (!state.exam) return;
  const un = state.exam.sel.filter(x => !x || !x.length).length;
  if (un > 0 && !confirm(`${un} unanswered. Submit anyway?`)) return;
  finishExam(false);
};
document.addEventListener("keydown", e => {
  if (!state.exam || $("examPlay").style.display === "none" || !$("examPlay").style.display) return;
  const ex = state.exam, q = ex.pool[ex.cur];
  if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
  if (e.key === "ArrowRight" && ex.cur < ex.pool.length - 1) { ex.cur++; renderQuestion(); renderPalette(); }
  else if (e.key === "ArrowLeft" && ex.cur > 0) { ex.cur--; renderQuestion(); renderPalette(); }
  else if (/^[1-9]$/.test(e.key)) { const oi = parseInt(e.key, 10) - 1; if (oi < q.options.length) choose(ex.cur, oi); }
  else if (e.key.toLowerCase() === "f") { ex.flags[ex.cur] = !ex.flags[ex.cur]; renderQuestion(); renderPalette(); }
  else if (e.key === "Enter" && ex.cur < ex.pool.length - 1) { ex.cur++; renderQuestion(); renderPalette(); }
});
function finishExam(auto){
  const ex = state.exam; if (!ex) return;
  clearInterval(ex.timerInt);
  let correct = 0;
  const isNoKey = !!ex.pool[0].noKey;
  ex.pool.forEach((q, i) => {
    const sel = ex.sel[i] || [];
    const ok = isNoKey ? false : (!q.multi ? sel.length === 1 && q.correctSet.includes(sel[0]) : sel.sort().join(",") === q.correctSet.sort().join(","));
    if (ok) correct++;
    else if (!isNoKey) record_error(q, true);
  });
  const a = { startedAt: Date.now(), label: ex.label, mode: ex.mode, minutes: ex.minutes, total: ex.pool.length, correct, timeUsed: ex.minutes * 60 - Math.max(0, ex.timeLeft), pool: ex.pool, sel: ex.sel, flags: ex.flags };
  store.setItem("se1.last", JSON.stringify(a));
  const hist = JSON.parse(store.getItem("se1.hist") || "[]");
  hist.unshift({ d: new Date().toLocaleString(), label: a.label, mode: a.mode, total: a.total, correct: a.correct, timeUsed: a.timeUsed });
  store.setItem("se1.hist", JSON.stringify(hist.slice(0, 30)));
  const saved = state.exam;
  state.exam = null;
  buildResults(ex.pool, ex.sel, a);
  if (auto) toast("⏱ Time's up — block submitted.");
}
window.addEventListener("beforeunload", e => { if (state.exam) { e.preventDefault(); e.returnValue = ""; } });

function buildResults(pool, sel, a){
  const total = pool.length;
  const isNoKey = !!pool[0].noKey;
  let correct = 0, unanswered = 0, flaggedCount = 0;
  const items = pool.map((q, i) => {
    const ua = sel[i] || [], ok = isNoKey ? null : (ua.length && ua.sort().join(",") === q.correctSet.sort().join(","));
    if (!ua.length) unanswered++; else if (ok) correct++;
    if (a.flags && a.flags[i]) flaggedCount++;
    return { q, ua: [...ua], ok, flag: a.flags ? a.flags[i] : false };
  });
  const answered = total - unanswered;
  const pct = isNoKey ? null : Math.round(correct / total * 100);
  ["examOrchestrator"].forEach(id => $(`#${id}`).style.display = "none");
  $("examPlay").style.display = "none";
  const res = $("examResults"); res.style.display = "block";
  $("scoreCirc").style.background = isNoKey ? "#64748b" : (pct >= 70 ? "var(--ok)" : pct >= 50 ? "var(--flag)" : "var(--bad)");
  $("scorePct").textContent = isNoKey ? "—" : pct + "%";
  $("scoreFrac").textContent = isNoKey ? `${answered}/${total} answered` : `${correct}/${total}`;
  $("resMeta").textContent = `${CUR.name} · ${a.label} · ${isNoKey ? "Self-assessment (no key)" : a.mode === "tutor" ? "Tutor" : "Timed"} · ${new Date(a.startedAt).toLocaleString()}${a.timeUsed != null ? ` · time ${fmtTime(a.timeUsed)}` : ""}`;
  $("resLines").innerHTML = isNoKey ?
    `<div>◻ Answered: <b style="color:var(--accent2)">${answered}</b> / ${total}</div>
     <div>○ Unanswered: <b>${unanswered}</b></div>
     <div>⚑ Flagged: <b style="color:var(--flag)">${flaggedCount}</b></div>
     <div class="mut" style="margin-top:6px">This bank has no answer key — open each question below and compare your picks with the official Loksewa key yourself.</div>` :
    `<div>✔ Correct: <b style="color:var(--ok)">${correct}</b></div>
     <div>✘ Incorrect: <b style="color:var(--bad)">${total - correct - unanswered}</b></div>
     <div>○ Unanswered: <b>${unanswered}</b></div>
     <div>⚑ Flagged: <b style="color:var(--flag)">${flaggedCount}</b></div>
     <div class="mut" style="margin-top:6px">Wrong answers are added to <b>My errors</b> for targeted re-practice.</div>`;
  $("againBtn").onclick = () => { res.style.display = "none"; renderSets(); $("examOrchestrator").style.display = "block"; };
  revData = items; renderReview("all");
  window.scrollTo(0, 0);
}
let revData = null;
function renderReview(f){
  const isNoKey = !!(revData && revData.length && revData[0].q.noKey);
  const bar = $("revFilters"); bar.innerHTML = "";
  (isNoKey ? [["all", "All"], ["ans", "◻ Answered"], ["unans", "○ Unanswered"], ["flag", "⚑ Flagged"]]
            : [["all", "All"], ["wrong", "✘ Incorrect"], ["unans", "○ Unanswered"], ["ok", "✔ Correct"], ["flag", "⚑ Flagged"]]).forEach(([k, lab]) => {
    const c = document.createElement("div");
    c.className = "chip" + (k === f ? " on" : "");
    c.textContent = lab;
    c.onclick = () => renderReview(k);
    bar.appendChild(c);
  });
  const wrap = $("reviewList"); wrap.innerHTML = "";
  const list = revData.filter(it => f === "all" ? true : f === "wrong" ? (it.ua.length && !it.ok) : f === "unans" ? !it.ua.length : f === "ok" ? it.ok : f === "ans" ? !!it.ua.length : it.flag);
  if (!list.length) { wrap.innerHTML = `<div class="mut">Nothing in this filter.</div>`; return; }
  list.forEach(it => {
    const det = document.createElement("details");
    det.className = "optrow";
    det.style.flexDirection = "column";
    det.style.border = "1px solid var(--line)";
    det.style.marginBottom = "10px";
    const status = isNoKey ? (!it.ua.length ? "<span class='badge y'>unanswered</span>" : "<span class='badge a'>answered</span>")
      : (!it.ua.length ? "<span class='badge y'>unanswered</span>" : it.ok ? "<span class='badge g'>correct</span>" : "<span class='badge r'>incorrect</span>");
    det.innerHTML = `<summary style="cursor:pointer;font-weight:600;font-size:14px;padding:12px 14px">Q${it.q.n} — ${esc(it.q.stem.slice(0, 100))}… ${status} ${it.flag ? "<span style='color:var(--flag)'>⚑</span>" : ""}</summary>
      <div style="padding:0 14px 14px">
        <div class="stem" style="margin-top:10px">${esc(it.q.stem)}</div>
        <div class="mut" style="margin:6px 0">${esc(it.q.chapter)}${it.q.src ? " · " + esc(it.q.src) : ""}${it.q.pdfPage ? " · PDF p." + it.q.pdfPage : ""}</div>
        ${it.q.options.map(o => {
          const isC = o.correct === 1, isU = it.ua.includes(o.k);
          const cls = isNoKey ? (isU ? "sel" : "") : (isC ? "reveal-ok" : isU ? "reveal-bad" : "");
          const tag = isNoKey ? (isU ? "Your pick" : "") : (isC ? "Correct" : isU ? "Your pick" : "");
          return `<div class="optrow ${cls}" style="cursor:default"><span class="lt" ${cls === "reveal-ok" ? 'style="background:var(--ok);color:#fff"' : cls === "reveal-bad" ? 'style="background:var(--bad);color:#fff"' : cls === "sel" ? 'style="background:var(--accent);color:#fff"' : ""}>${esc(o.k)}</span><span class="ot">${esc(o.text)}</span>${tag ? `<span class="pill" style="margin-left:auto;flex-shrink:0;font-size:11px">${tag}</span>` : ""}</div>`;
        }).join("")}
        ${isNoKey ? "" : `<div class="explain show">${esc(it.q.explanation || "No explanation available.")}</div>`}
      </div>`;
    wrap.appendChild(det);
  });
}
function renderSets(){
  const sel = $("setSel"); const size = parseInt($("setSizeSel").value, 10);
  const n = CUR.questions.length;
  const chapters = [];
  CUR.questions.forEach(q => { if (!chapters.includes(q.chapter)) chapters.push(q.chapter); });
  let html = "";
  for (let i = 0; i < Math.ceil(n / size); i++) html += `<option value="${i}">Set ${i + 1} (Q${i * size + 1}–Q${Math.min(n, (i + 1) * size)})</option>`;
  chapters.forEach(c => { const cnt = CUR.questions.filter(q => q.chapter === c).length; html += `<option value="ch:${esc(c)}">📖 ${esc(c)} (${cnt})</option>`; });
  html += `<option value="all">All questions (${n})</option>`;
  if (!CUR.noKey) html += `<option value="errors">🔁 My errors (${state.errors.size} catalogued)</option>`;
  sel.innerHTML = html;
}

function renderBankSel(){
  $("bankSel").innerHTML = BANKS.map((b, i) => `<option value="${i}">${esc(b.bank.name)}${b.bank.noKey ? " — questions only" : ""}</option>`).join("");
  const at = BANKS.findIndex(b => b.bank === CUR);
  $("bankSel").value = String(at < 0 ? 0 : at);
}
$("bankSel").onchange = () => { CUR = BANKS[parseInt($("bankSel").value, 10) || 0].bank; renderSets(); updateBankLine(); };
function updateBankLine(){
  const n = CUR.questions.length;
  const chs = [...new Set(CUR.questions.map(q => q.chapter))].length;
  $("bankLine").textContent = `Bank: ${CUR.name} — ${n} questions across ${chs} ${CUR.noKey ? "topics (answer key not included — self-assessment mode)" : "chapters"}`;
}
renderBankSel();
renderSets();
updateBankLine();
$("examOrchestrator").style.display = "block";
</script>
</body>
</html>
