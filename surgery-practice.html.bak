<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Surgery Essence — Part 1 · MCQ Practice</title>
<style>
:root{
  --bg:#f1f5f9; --card:#ffffff; --ink:#0f172a; --muted:#64748b;
  --line:#e2e8f0; --accent:#1d4ed8; --accent2:#3b82f6; --ok:#16a34a;
  --bad:#dc2626; --flag:#f59e0b; --mark:#fde047;
}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
header{background:#0f172a;color:#fff;padding:10px 20px;display:flex;align-items:center;gap:14px}
header .logo{font-weight:800;font-size:18px}
header .logo span{color:#60a5fa}
header .tag{color:#94a3b8;font-size:12.5px}
.container{max-width:1080px;margin:24px auto;padding:0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 1px 3px rgba(15,23,42,.06);margin-bottom:18px}
h1{font-size:22px;margin:0 0 6px}
.sub{color:var(--muted);font-size:13.5px;margin-bottom:14px}
.btn{background:var(--accent);color:#fff;border:none;padding:10px 18px;border-radius:9px;font-weight:600;font-size:14px;cursor:pointer}
.btn:hover{background:#1e40af}
.btn.sec{background:#e2e8f0;color:#0f172a}
.btn.sec:hover{background:#cbd5e1}
.btn.small{padding:6px 12px;font-size:12.5px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:16px}
label.f{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:#334155}
label.f select,label.f input[type=number]{padding:9px 10px;border:1px solid #cbd5e1;border-radius:9px;font-size:14px;background:#fff}
.chkrow{display:flex;flex-direction:column;gap:8px;font-size:13.5px;font-weight:600;color:#334155;margin-bottom:18px}
.chkrow label{display:flex;gap:8px;align-items:center}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.badge{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11.5px;font-weight:700}
.badge.a{background:#dbeafe;color:#1d4ed8}
.badge.g{background:#dcfce7;color:#15803d}
.badge.r{background:#fee2e2;color:#b91c1c}
.badge.y{background:#fef3c7;color:#b45309}
.badge.m{background:#e0e7ff;color:#4338ca}
mark{background:var(--mark);border-radius:3px;padding:0 1px}
.exview{display:none}
.exview.active{display:block}
.pill{padding:3px 10px;border-radius:99px;background:#e2e8f0;font-size:12px;font-weight:700}
.pill.tutor{background:#fef3c7;color:#b45309}
.pill.timed{background:#dbeafe;color:#1d4ed8}
.timer{font-variant-numeric:tabular-nums;background:#0f172a;color:#fff;padding:7px 14px;border-radius:9px;font-weight:700}
.timer.low{background:#7f1d1d}
.qwrap{padding:22px 26px}
.qnum{color:var(--muted);font-size:13px;font-weight:600;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.stem{white-space:pre-wrap;line-height:1.7;font-size:15.5px}
.optrow{display:flex;align-items:flex-start;gap:12px;border:1px solid var(--line);border-radius:11px;padding:12px 14px;margin-top:10px;cursor:pointer;position:relative;transition:.12s;background:#fff;line-height:1.55;font-size:15px;white-space:pre-wrap}
.optrow:hover{border-color:#93c5fd;background:#f8fafc}
.optrow.multi{cursor:default}
.optrow .lt{min-width:24px;height:24px;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px;flex-shrink:0}
.optrow.multi .lt{border-radius:6px;cursor:pointer;user-select:none}
.optrow.sel{border-color:var(--accent);background:#eff6ff}
.optrow.sel .lt{background:var(--accent);color:#fff}
.optrow.reveal-ok{border-color:#86efac;background:#f0fdf4}
.optrow.reveal-ok .lt{background:var(--ok);color:#fff}
.optrow.reveal-bad{border-color:#fca5a5;background:#fef2f2}
.optrow.reveal-bad .lt{background:var(--bad);color:#fff}
.strikebtn{margin-left:auto;background:none;border:none;color:#94a3b8;font-size:15px;cursor:pointer;flex-shrink:0;padding:0 2px}
.strikebtn:hover{color:var(--bad)}
.optrow s{opacity:.55}
.explain{display:none;margin-top:16px;border-left:4px solid var(--accent);background:#f8fafc;border-radius:0 10px 10px 0;padding:12px 16px;font-size:14px;line-height:1.6;white-space:pre-wrap}
.explain.show{display:block}
.explain .tag{font-weight:800;color:var(--accent);margin-bottom:4px;display:block;font-size:12px;text-transform:uppercase;letter-spacing:.5px}
.qfoot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:22px;flex-wrap:wrap}
.palette{display:grid;grid-template-columns:repeat(auto-fill,minmax(34px,1fr));gap:6px}
.palette button{padding:7px 0;border:1px solid var(--line);border-radius:8px;background:#fff;font-weight:700;font-size:12.5px;cursor:pointer}
.palette button.ans{background:#dbeafe;border-color:#93c5fd}
.palette button.flag{background:#fef3c7;border-color:#fcd34d}
.palette button.cur{outline:3px solid var(--accent2)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.chip{background:#f1f5f9;color:#475569;border:1px solid var(--line);padding:6px 12px;border-radius:99px;font-size:12.5px;font-weight:600;cursor:pointer}
.chip.on{background:#1d4ed8;border-color:#1d4ed8;color:#fff}
.resultscore{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.scorecirc{width:130px;height:130px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;color:#fff;flex-shrink:0}
.scorecirc small{font-weight:600;font-size:11px;opacity:.85}
.hlbtn{background:#fffbeb;border:1px solid #fde68a;color:#92400e;font-size:12px;font-weight:700;border-radius:7px;padding:4px 10px;cursor:pointer}
.toast{position:fixed;bottom:20px;right:20px;background:#0f172a;color:#fff;padding:12px 18px;border-radius:10px;font-size:13.5px;z-index:200;display:none;max-width:340px}
kbd{background:#f1f5f9;border:1px solid #cbd5e1;border-bottom-width:2px;border-radius:5px;padding:1px 6px;font-size:11.5px;font-family:inherit}
.mut{color:var(--muted);font-size:13px}
@media(max-width:640px){.qwrap{padding:14px}}
</style>
</head>
<body>
<header>
  <div class="logo">✚ <span>MCQ</span> Trainer</div>
  <div class="tag" id="hdrTag">Surgery Essence (8<sup>th</sup> Ed.) + Federal Loksewa · banks embedded</div>
</header>

<main class="container">

<section id="examOrchestrator" style="display:none">
  <div class="card">
    <h1>Create Practice Session</h1>
    <div class="sub" id="bankLine"></div>
    <div class="formgrid">
      <label class="f">Bank
        <select id="bankSel"></select>
      </label>
      <label class="f">Question source
        <select id="setSel"></select>
      </label>
      <label class="f">Set size (for block sets)
        <select id="setSizeSel">
          <option>10</option><option>20</option><option selected>40</option><option>50</option><option>100</option>
        </select>
      </label>
      <label class="f">Mode
        <select id="modeSel">
          <option value="timed" selected>⏱ Timed (exam-like)</option>
          <option value="tutor">🎓 Tutor (instant feedback)</option>
        </select>
      </label>
      <label class="f">Timer (minutes, 0 = none)
        <input type="number" id="timerMin" min="0" max="360" value="60">
      </label>
    </div>
    <div class="chkrow">
      <label><input type="checkbox" id="shufQ" checked> 🔀 Shuffle question order</label>
      <label><input type="checkbox" id="shufO" checked> Shuffle answer options</label>
    </div>
    <button class="btn" id="startBtn">▶ Start session</button>
    <div class="mut" style="margin-top:8px">Shortcuts: <kbd>←</kbd><kbd>→</kbd> navigate · <kbd>1</kbd>–<kbd>9</kbd> select option · <kbd>F</kbd> flag · <kbd>Enter</kbd> next</div>
  </div>
</section>

<section id="examPlay" style="display:none">
  <div class="card" style="padding:0">
    <div class="qnum" style="padding:12px 20px;border-bottom:1px solid var(--line);margin:0">
      <b id="examTitle" style="font-size:14px;color:var(--ink)">Session</b>
      <div style="display:flex;gap:10px;align-items:center">
        <span id="examModePill" class="pill"></span>
        <div id="timerBox" class="timer">--:--</div>
        <button class="btn small" id="submitBtn">Submit block</button>
      </div>
    </div>
    <div class="qwrap" id="qBody"></div>
    <div class="qfoot" style="padding:0 26px 22px">
      <button class="btn sec" id="prevBtn">← Previous</button>
      <div class="mut" id="posLabel"></div>
      <button class="btn" id="nextBtn">Next →</button>
    </div>
  </div>
  <div class="card">
    <div class="sub" style="margin-bottom:8px">Question palette — click to jump. <span style="color:#b45309">⚑</span> = flagged · blue = answered · dark border = current.</div>
    <div class="palette" id="palette"></div>
  </div>
</section>

<div id="examResults" style="display:none">
  <div class="card">
    <h1>Results</h1>
    <div class="sub" id="resMeta"></div>
    <div class="resultscore">
      <div class="scorecirc" id="scoreCirc"><span id="scorePct" style="font-size:30px">0%</span><small id="scoreFrac"></small></div>
      <div id="resLines" style="font-size:14px;line-height:1.9"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn sec small" id="againBtn">🔁 New session</button>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="chips" id="revFilters"></div>
    <div id="reviewList"></div>
  </div>
</div>

</main>
<div class="toast" id="toast"></div>

<script>
"use strict";
/* Safe storage: falls back to in-memory if localStorage is blocked (e.g. strict file:// settings) */
const store = (() => {
  try { const t = "__mqt"; localStorage.setItem(t, "1"); localStorage.removeItem(t); return localStorage; }
  catch (e) {
    const mem = {};
    return { getItem: k => (k in mem ? mem[k] : null), setItem: (k, v) => { mem[k] = String(v); }, removeItem: k => { delete mem[k]; } };
  }
})();
const BANK = {"name":"Surgery Essence — Part 1","questions":[{"n":1,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 25","pdfPage":18,"stem":"A 40 years old women presented to the clinic with a 4 cm mass in the upper outer quadrant. Biopsy from the mass showed densely packed cells with bland nuclei and mucin infiltrating the stroma. Most probable diagnosis is:","options":[{"letter":"A","text":"Colloid carcinoma"},{"letter":"B","text":"Tubular carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Medullary carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Colloid carcinoma","explanation":"“The infiltrating cells may secrete copious amounts of mucin and appear to float in this material. These\nlesions are called mucinous or colloid tumors.”-Sabiston 20/e p840\n“Mucinous carcinoma (colloid carcinoma), another special-type breast cancer, accounts for 2% of all invasive breast\ncancers and typically presents in the older population as a bulky tumor. This cancer is defined by extracellular\npools of mucin, which surround aggregates of low-grade cancer cells.”-Schwartz 11/e p566\nAnswer (book): Answer: A. Colloid carcinoma\nReference: Bailey 27/e p872; Schwartz 11/e p566; Sabiston 20/e p840"},{"n":2,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 25","pdfPage":18,"stem":"Which of the following statements is true regarding retrosternal goitres?","options":[{"letter":"A","text":"Operated only if patient is symptomatic"},{"letter":"B","text":"Sternal incision is always required"},{"letter":"C","text":"Majority of the goitres derive their blood supply from mediastinal vessels"},{"letter":"D","text":"Majority of the retrosternal goitres can be removed by a neck incision"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Majority of the retrosternal goitres can be removed by a neck incision","explanation":"The vast majority (>95%) of retrosternal goitres can be removed transcervically.\n“Retrosternal goitre tends to arise from the slow growth of a multinodular gland down in to the mediastinum. As the\ngland enlarges within the thoracic inlet, pressure may lead to dysphagia, tracheal compression and eventually\nairway symptoms. The vast majority of patients have minimal symptoms. Patient should be considered for surgery\nif there is significant airway compression, if symptoms are present or in young patients in whom symptoms are\nlikely to develop.”-Bailey 27/e p810\n“If a decision is made to proceed to surgery, assessment of the extent of disease is critical. The vast majority\n(>95%) of retrosternal goitres can be removed transcervically. Those at most risk of requiring conversion to an\nopen sternotomy approach include malignant or revision cases, those which extend into the posterior mediastinum\nand those in which the diameter of the goitre exceeds that of the thoracic inlet. In such cases a joint case with\nthoracic surgery should be planned.”-Bailey 27/e p811\nAnswer (book): Answer: D. Majority of the retrosternal goitres can be removed by a neck incision\nReference: Bailey 27/e p810, 811; Schwartz 11/e p1642; Sabiston 20/e p892"},{"n":3,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 25","pdfPage":18,"stem":"A 25 years old male presented with a 2 cm nodule. Thyroidectomy was done. The histology picture is given below. What is the most likely diagnosis?","options":[{"letter":"A","text":"Papillary thyroid carcinoma"},{"letter":"B","text":"Medullary thyroid carcinoma"},{"letter":"C","text":"Toxic nodular goitre"},{"letter":"D","text":"Follicular thyroid carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary thyroid carcinoma","explanation":"The given HPE image shows optically clear nuclei (Orphan Annie eye nuclei), which is highly suggestive\nof papillary carcinoma thyroid.\n“Papillary Carcinoma Thyroid: The diagnosis is established by characteristic nuclear cellular features. Cells are\ncuboidal with pale, abundant cytoplasm, crowded nuclei that may demonstrate “grooving,” and intranuclear\ncytoplasmic inclusions (leading to the designation of Orphan Annie nuclei, which allow diagnosis by FNAB.\nPsammoma bodies, which are microscopic, calcified deposits representing clumps of sloughed cells, also may be\npresent.”-Schwartz 11/e p1647\nImage-based question: the picture / video this question refers to is on PDF p. 18 of the source and is not reproduced here.\nAnswer (book): Answer: A. Papillary thyroid carcinoma\nReference: Schwartz 11/e p1647; Sabiston 20/e p898"},{"n":4,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 25","pdfPage":18,"stem":"A 30 years old female presents with a diffuse thyroid swelling. On investigations, TSH levels were elevated. Postoperative HPE reports showed intense lymphocytic infiltration and Hürthle cells. Which of the following is the most likely diagnosis?","options":[{"letter":"A","text":"Grave’s disease"},{"letter":"B","text":"Hashimoto’s thyroiditis"},{"letter":"C","text":"Follicular carcinoma"},{"letter":"D","text":"Medullary thyroid carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hashimoto’s thyroiditis","explanation":"History of diffuse thyroid swelling in a female, who is hypothyroid (elevated TSH levels) and HPE\nreports showing intense lymphocytic infiltration with Hürthle cells is highly suggestive of Hashimoto’s thyroiditis.\n“Hashimoto’s thyroiditis is also more common in women (male-to-female ratio is 1:10 to 20) between the ages of\n30 and 50 years old. The most common presentation is that of a minimally or moderately enlarged firm granular\ngland discovered on routine physical examination or the awareness of a painless anterior neck mass, although 20%\nof patients present with hypothyroidism, and 5% present with hyperthyroidism (Hashitoxicosis).”-Schwartz 11/e\np1640\n“On microscopic examination, the gland is diffusely infiltrated by small lymphocytes and plasma cells and\noccasionally shows well-developed germinal centers. Thyroid follicles are smaller than normal with reduced\namounts of colloid and increased interstitial connective tissue. The follicles are lined by Hürthle or Askanazy cells,\nwhich are characterized by abundant eosinophilic, granular cytoplasm.”-Schwartz 11/e p1640\nAnswer (book): Answer: B. Hashimoto’s thyroiditis\nReference: Bailey 27/e p821; Schwartz 11/e p1640; Sabiston 20/e p891"},{"n":5,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 26","pdfPage":18,"stem":"In a patient with parathyroid adenoma, how do we confirm the removal of the correct gland after surgery?","options":[{"letter":"A","text":"50% reduction in PTH within 10 mins of gland removal"},{"letter":"B","text":"50% reduction in PTH within 5 mins of gland removal"},{"letter":"C","text":"25% reduction in PTH within 10 mins of gland removal"},{"letter":"D","text":"25% reduction in PTH within 5 mins of gland removal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"50% reduction in PTH within 10 mins of gland removal","explanation":"“The Miami criteria were developed to determine the extent of resection. A drop in the PTH into the\nnormal range and to less than half the maximum preoperative PTH at 10 minutes appears to accurately predict\nsingle-gland disease.”-Bailey 27/e p830\n“Various protocols exist that use intraoperative PTH measurements. The “Miami” criteria developed by Irvin and\ncolleagues describe biochemical cure as a 50% decrease in PTH levels from baseline 10 to 15 minutes after\nresection of the targeted parathyroid gland.” -Sabiston 20/e p934\nAnswer (book): Answer: A. 50% reduction in PTH within 10 mins of gland removal\nReference: Bailey 27/e p830; Sabiston 20/e p934"},{"n":6,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 26","pdfPage":18,"stem":"What is the Child-Pugh class for patient who has a serum bilirubin of 2.5 mg/dL, serum albumin of 3 g/dL, INR of 2 along with mild ascites but no encephalopathy?","options":[{"letter":"A","text":"CP class A"},{"letter":"B","text":"CP class B"},{"letter":"C","text":"CP class C"},{"letter":"D","text":"CP class D"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CP class B","explanation":"The Child-Pugh class for patient who has a serum bilirubin of 2.5 mg/dL (2 points), serum albumin of 3\ng/dL (2 points), INR of 2 (2 points) along with Mild ascites (2 points) but no encephalopathy (1 point) is class B (total\npoints = 9). Child-Turcotte-Pugh (CTP) Scoring System\n• CTP score is a measure to assess hepatic functionQ in many liver diseases.\n• It was initially devised to classify patients into risk groups prior to undergoing porto-systemic shunt surgeriesQ.\n• It is used to assess prognosis in cirrhosisQ and many liver diseases. Child-Turcotte-Pugh (CTP) Score\nVariable | 1 Point | 2 Points | 3 Points | Serum albumin (g/dL) | >3.5 | 2.8–3.5 | <2.8 | Bilirubin (mg/dL) | <2 | 2–3 |\nProthrombin time (sec above normal) or INR | <4 <1.7 | 4–6 1.7–2.3Q | Ascites | None | ControlledQ | Uncontrolled |\nEncephalopathy | None | Controlled | Uncontrolled | Q | >3 | Q | >6 >2.3 | Q | Class A | 5–6 pointsQ | Class B | 7–9\npointsQ | Class C | 10–15 pointsQ | Q\nAnswer (book): Answer: B. CP class B\nReference: Bailey 27/e p1157; Schwartz 11/e p1365; Sabiston 20/e p216"},{"n":7,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 26","pdfPage":18,"stem":"Ligation of common hepatic artery will impair blood supply in:","options":[{"letter":"A","text":"Right gastric and right gastroepiploic artery"},{"letter":"B","text":"Right gastric and left gastric artery"},{"letter":"C","text":"Right gastroepiploic artery and short gastric vessels"},{"letter":"D","text":"Right gastric and short gastric vessels"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Right gastric and right gastroepiploic artery","explanation":"Ligation of common hepatic artery will impair blood supply in right gastric and right gastroepiploic\nartery.\nFig. Branches of coeliac trunk\n“The stomach has an arterial supply on both lesser and greater curves. On the lesser curve, the left gastric artery, a\nbranch of the coeliac axis, forms an anastomotic arcade with the right gastric artery, which arises from the\ncommon hepatic artery. Branches of the left gastric artery pass up towards the cardia. The gastroduodenal artery,\nwhich is also a branch of the hepatic artery, passes behind the first part of the duodenum, highly relevant with\nrespect to the bleeding duodenal ulcer. Here it divides into the superior pancreaticoduodenal artery and the right\ngastroepiploic artery. The superior pancreaticoduodenal artery supplies the duodenum and pancreatic head, and\nforms an anastomosis with the inferior pancreaticoduodenal artery, a branch of the superior mesenteric artery. The\nright gastroepiploic artery runs along the greater curvature of the stomach, eventually forming an anastomosis\nwith the left gastroepiploic artery, a branch of the splenic artery.”-Bailey 27/e p1106\nAnswer (book): Answer: A. Right gastric and right gastroepiploic artery\nReference: Bailey 27/e p1106; Schwartz 11/e p1103; Sabiston 20/e p1189"},{"n":8,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 27","pdfPage":18,"stem":"An 80 years old female presented with colicky pain and jaundice. Serum bilirubin and GGT was raised. MRCP image shows gallstones and CBD stones with dilated biliary radicles. Next step in the management:","options":[{"letter":"A","text":"Cholecystectomy"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"CECT"},{"letter":"D","text":"PET scan"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ERCP","explanation":"“ERCP is performed in patients with obstructive jaundice when an endoscopic intervention is\nanticipated based on prior imaging (endoscopic removal of CBD stones, biliary drainage in septic patient or insertion\nof a biliary tract stent).”-Bailey 27/e p1158\n“However, for cases of choledocholithiasis, obstructive jaundice, biliary strictures, or cholangitis, ERCP has the\nadvantage of being both diagnostic and therapeutic. If ductal stones are identified on the endoscopic\ncholangiogram, biliary sphincterotomy and stone extraction can be performed, clearing the common bile duct of\nstones.”-Schwartz 11/e p1400\nImage-based question: the picture / video this question refers to is on PDF p. 18 of the source and is not reproduced here.\nAnswer (book): Answer: B. ERCP\nReference: Bailey 27/e p1158; Schwartz 11/e p1400; Sabiston 20/e p1489"},{"n":9,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 27","pdfPage":18,"stem":"A 35 years old male presented with recurrent episodes of abdominal pain, abdominal tenderness, fever and jaundice. MRCP image of the patient is given below. Most likely diagnosis is:","options":[{"letter":"A","text":"Primary sclerosing cholangitis"},{"letter":"B","text":"Primary biliary cirrhosis"},{"letter":"C","text":"Oriental cholangiohepatitis"},{"letter":"D","text":"Caroli’s disease"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Primary sclerosing cholangitis","explanation":"History of recurrent episodes of abdominal pain, abdominal tenderness, fever and jaundice (suggestive\nof recurrent attacks of cholangitis) in a 35 years old male and MRCP image showing multiple strictures of intrahepatic\nand extrahepatic bile duct is highly suggestive of primary sclerosing cholangitis.\n“The mean age of presentation for PSC is 30 to 45 years, and men are affected twice as often as women. Most\npatients are symptomatic when diagnosed, and may complain of intermittent jaundice, fatigue, weight loss,\npruritus, or abdominal pain.” -Schwartz 11/e p1417\n“PSC: ERCP is the preferred route for cholangiography and can demonstrate the characteristic multifocal, diffusely\ndistributed dilations and strictures of the intrahepatic and extrahepatic biliary trees.”-Sabiston 20/e p1509\nImage-based question: the picture / video this question refers to is on PDF p. 18 of the source and is not reproduced here.\nAnswer (book): Answer: A. Primary sclerosing cholangitis\nReference: Bailey 27/e p1206; Schwartz 11/e p1417; Sabiston 20/e p1509"},{"n":10,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 27","pdfPage":18,"stem":"Tumor of the uncinate process of pancreas affects which of the following?","options":[{"letter":"A","text":"Superior mesenteric artery"},{"letter":"B","text":"Portal vein"},{"letter":"C","text":"Common hepatic artery"},{"letter":"D","text":"Inferior mesenteric artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Superior mesenteric artery","explanation":"Tumor of the uncinate process of pancreas affects superior mesenteric artery (SMA) due to its close\nrelation with SMA.\nFig. Transverse section of the pancreas (Note the position of the uncinate process behind the vessels)\n“The uncinate process extends from the head of the pancreas behind the superior mesenteric vein (SMV) and\nterminates adjacent to the superior mesenteric artery (SMA).”-Sabiston 20/e p1520\n“The uncinate process and the head of the pancreas wrap around the right side of the portal vein and end\nposteriorly near the space between the superior mesenteric vein and superior mesenteric artery.”-Schwartz 11/e\np1430\nAnswer (book): Answer: A. Superior mesenteric artery\nReference: Bailey 27/e p1213; Schwartz 11/e p1430; Sabiston 20/e p1238, 1520"},{"n":11,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 27","pdfPage":18,"stem":"Most common pancreatic endocrine neoplasm:","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Gastrinoma"},{"letter":"C","text":"VIPoma"},{"letter":"D","text":"Glucagonoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma","explanation":"“Insulinomas are the most common functional pancreatic endocrine neoplasms and present with a\ntypical clinical syndrome known as Whipple’s triad.”-Schwartz 11/e p1480\n“Insulinomas are the most frequent of all the functioning PETs with a reported incidence of 2–4 cases per million\npopulation per year.”-Bailey 27/e p849\nAnswer (book): Answer: A. Insulinoma\nReference: Bailey 27/e p849; Schwartz 11/e p1480; Sabiston 20/e p952"},{"n":12,"chapter":"Recent Questions","src":"question on PDF p. 18 · answer on PDF p. 28","pdfPage":18,"stem":"What is the most common site of gastrinoma in MEN 1 syndrome?","options":[{"letter":"A","text":"Jejunum"},{"letter":"B","text":"Ileum"},{"letter":"C","text":"Duodenum"},{"letter":"D","text":"Stomach"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Duodenum","explanation":"MC site of gastrinoma in MEN 1 syndrome is duodenum.\n“MEN 1 gastrinomas are more often located in the duodenum as multiple small tumours than in the pancreas. For\ngastrinomas located in the duodenum or pancreatic head (gastrinoma triangle), pylorus-preserving partial\npancreaticoduodenectomy is recommended. In rare cases the gastrinoma is located in the body or tail of the\npancreas. In such cases distal pancreatectomy with excision of tumours in the pancreatic head is the procedure of\nchoice.”-Bailey 27/e p857\nAnswer (book): Answer: C. Duodenum\nReference: Bailey 27/e p857; Schwartz 11/e p1136; Sabiston 20/e p958"},{"n":13,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 28","pdfPage":19,"stem":"Patient presents with halitosis and a swelling in the lateral aspect of the neck, which on pressing gives rise to a regurgitant sound. Barium swallow image is shown. What is the diagnosis?","options":[{"letter":"A","text":"Laryngocele"},{"letter":"B","text":"Achalasia cardia"},{"letter":"C","text":"Pharyngeal pouch"},{"letter":"D","text":"Schatzki’s ring"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pharyngeal pouch","explanation":"History of halitosis and a swelling in the lateral aspect of the neck, which on pressing gives rise to a\nregurgitant sound along and the given Barium swallow image is highly suggestive of pharyngeal pouch (Zenker’s\ndiverticulum).\n“Zenker’s diverticulum (pharyngeal pouch) is not really an oesophageal diverticulum as it protrudes posteriorly\nabove the cricopharyngeal sphincter through the natural weak point (the dehiscence of Killian) between the oblique\nand horizontal (cricopharyngeus) fibres of the inferior pharyngeal constrictor. When the diverticulum is small,\nsymptoms largely reflect this in coordination with predominantly pharyngeal dysphagia. As the pouch enlarges, it\ntends to fill with food on eating, and the fundus descends into the mediastinum. This leads to halitosis and\noesophageal dysphagia.”-Bailey 27/e p1101\n“Diagnosis is made by barium esophagram. At the level of the cricothyroid cartilage, the diverticulum can be seen\nfilled with barium resting posteriorly alongside the esophagus (the “cricopharyngeal bar”). Lateral views are critical\nbecause this is usually a posterior structure. Neither esophageal manometry nor endoscopy is needed to diagnose\nZenker diverticulum.”-Sabiston 20/e p1019\nImage-based question: the picture / video this question refers to is on PDF p. 19 of the source and is not reproduced here.\nAnswer (book): Answer: C. Pharyngeal pouch\nReference: Bailey 27/e p1101; Schwartz 11/e p1053; Sabiston 20/e p1019"},{"n":14,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 28","pdfPage":19,"stem":"On esophageal manometry, abnormal spastic contractions in esophagus >450 mm Hg·s·cm in the body is suggestive of:","options":[{"letter":"A","text":"Type I achalasia"},{"letter":"B","text":"Type II achalasia"},{"letter":"C","text":"Type III achalasia"},{"letter":"D","text":"Jackhammer esophagus"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Type III achalasia","explanation":"On esophageal manometry, abnormal spastic contractions in esophagus >450 mm Hg·s·cm in the\nbody is suggestive of Type III achalasia (spastic achalasia). Type of Achalasia\nCriteria\nType I achalasia (classic achalasia)\n• Elevated median IRP (>15 mm Hg), 100% failed peristalsis (DCI <100 mm Hg·s·cm)\n• Premature contractions with DCI values <450 mm Hg·s·cm satisfy criteria for failed peristalsis\nType II achalasia (with oesophageal compression)\n• Elevated median IRP (>15 mm Hg), 100% failed peristalsis, panoesophageal pressurisation with ≥20% of\nswallows\n• Contractions may be masked by oesophageal pressurisation & DCI should not be calculated\nType III achalasia (spastic achalasia)\n• Elevated median IRP (>15 mm Hg), no normal peristalsis, premature (spastic) contractions with DCI >450 mm\nHg·s·cm with ≥20% of swallowsQ\n• May be mixed with panoesophageal pressurisation\nDCI, distal contractile integral (mm Hg·s·cm); EGJ, esophaogastric junction; IRP, integrated relaxation pressure (mm\nHg); LES, lower esophageal sphincter.\nAnswer (book): Answer: C. Type III achalasia\nReference: Bailey 27/e p1096; Sabiston 20/e p1015"},{"n":15,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 28","pdfPage":19,"stem":"What is the diagnosis based on the given barium swallow image?","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Esophageal stricture"},{"letter":"D","text":"GERD"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Carcinoma esophagus","explanation":"The given barium swallow shows advanced carcinoma esophagus with abrupt, irregular narrowing in\nthe distal esophagus, with more proximal dilation along with shouldered margin and apple core appearance.\n“Barium esophagram may demonstrate irregular narrowing or ulceration. The classic “apple-core” filling defect is\nseen only if there is symmetrical, circumferential narrowing. Instead, there is often an asymmetrical bulge seen\nwith an infiltrative appearance.” -Sabiston 20/e p1028\nImage-based question: the picture / video this question refers to is on PDF p. 19 of the source and is not reproduced here.\nAnswer (book): Answer: B. Carcinoma esophagus\nReference: Bailey 27/e p1086; Schwartz 11/e p1070; Sabiston 20/e p1028"},{"n":16,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 28","pdfPage":19,"stem":"A middle aged man complains of upper abdominal pain after a heavy meal. There is tenderness in the upper abdomen and on X-ray, widening of the mediastinum is seen with pneumo-mediastinum. What is the diagnosis?","options":[{"letter":"A","text":"Spontaneous perforation of the esophagus"},{"letter":"B","text":"Perforated peptic ulcer"},{"letter":"C","text":"Foreign body in esophagus"},{"letter":"D","text":"Rupture of emphysematous bulla"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Spontaneous perforation of the esophagus","explanation":"History of upper abdominal pain after a heavy meal along with tenderness in the upper abdomen and\non X-ray, widening of the mediastinum with pneumo-mediastinum is highly suggestive of Spontaneous perforation of\nthe esophagus (Boerhaave’s syndrome).\n“Barotrauma (spontaneous perforation, Boerhaave’s syndrome): This occurs classically when a person vomits\nagainst a closed glottis. The pressure in the oesophagus increases rapidly, and the oesophagus bursts at its\nweakest point in the lower third, sending a stream of material into the mediastinum and often the pleural cavity as\nwell.”-Bailey 27/e p1072\n“The diagnosis can usually be suspected from the history and associated clinical features. A chest radiograph is\noften confirmatory with air in the mediastinum, pleura or peritoneum. Pleural effusion occurs rapidly either as a\nresult of free communication with the pleural space or as a reaction to adjacent inflammation in the mediastinum. A\ncontrast swallow or CT is nearly always required to guide management.”-Bailey 27/e p1072, 1073\nAnswer (book): Answer: A. Spontaneous perforation of the esophagus\nReference: Bailey 27/e p1072, 1073; Schwartz 11/e p1083; Sabiston 20/e p1025"},{"n":17,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 29","pdfPage":19,"stem":"A young man met with a motor bike accident and had injury to ileum and jejunum. Therefore the entire ileum and part of jejunum was resected. Which of the following would the patient suffer from?","options":[{"letter":"A","text":"Vitamin B12 deficiency"},{"letter":"B","text":"Constipation"},{"letter":"C","text":"Gastric ulcer"},{"letter":"D","text":"Hypogastrinemia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Vitamin B12 deficiency","explanation":"“Short Bowel Syndrome: Length alone, however, is not the only determining factor of complications\nrelated to small bowel resection. For example, if the distal two thirds of the ileum, including the ileocecal valve, is\nresected, significant abnormalities of absorption of bile salts and vitamin B12 may occur, resulting in diarrhea and\nanemia, although only 25% of the total length of the small bowel has been removed.”-Sabiston 20/e p1291\n“Short Bowel Syndrome: Patients with as little as 100–200 cm of jejunum anastomosed to an intact colon may\ntherefore be able to maintain satisfactory macronutrient, fluid and electrolyte status, although they will, of course,\nbe at risk of fat-soluble and B12 vitamin deficiencies and will also generally need oral nutritional supplements of\ntrace elements, vitamins and minerals.” -Bailey 27/e p1256\nAnswer (book): Answer: A. Vitamin B12 deficiency\nReference: Bailey 27/e p1256; Schwartz 11/e p1254; Sabiston 20/e p1291"},{"n":18,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 29","pdfPage":19,"stem":"A patient presented with abdominal pain, blood in stool and a palpable mass on the abdominal examination. The following barium image was obtained from the patient. What is the most probable diagnosis?","options":[{"letter":"A","text":"Meckel’s diverticulum"},{"letter":"B","text":"Intussusception"},{"letter":"C","text":"Volvulus"},{"letter":"D","text":"Diverticulitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Intussusception","explanation":"History of abdominal pain, blood in stools and a palpable mass on the abdominal examination along\nwith barium enema showing coiled spring sign is highly suggestive of Intussusception.\n“Intussusception: Classically, a previously healthy infant presents with colicky pain and vomiting (milk then bile).\nBetween episodes, the child initially appears well. Later, they may pass a ‘redcurrant jelly’ stool. Clinical signs\ninclude dehydration, abdominal distension and a palpable sausage-shaped mass in the right upper quadrant. Rectal\nexamination may reveal blood or rarely the apex of the intussusceptum.”-Bailey 27/e p129\n“Contrast enemas demonstrate a filling defect or cupping in the head of the contrast media where its advance is\nobstructed by the intussusceptum. A central linear column of contrast media may be visible in the compressed\nlumen of the intussusceptum, and a thin rim of contrast may be seen trapped around the invaginating intestine in\nthe folds of mucosa within the intussuscipiens (coiledspring sign), especially after evacuation.”-Nelson 20/e p1813\nImage-based question: the picture / video this question refers to is on PDF p. 19 of the source and is not reproduced here.\nAnswer (book): Answer: B. Intussusception\nReference: Bailey 27/e p129; Schwartz 11/e p1253; Sabiston 20/e p1879; Nelson 20/e p1813"},{"n":19,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 29","pdfPage":19,"stem":"Patient presents with peritonitis and during surgery a diverticular perforation is seen with fecal peritonitis. What is the Hinchey’s stage?","options":[{"letter":"A","text":"1"},{"letter":"B","text":"2"},{"letter":"C","text":"3"},{"letter":"D","text":"4"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"4","explanation":"Hinchey Classification of Complicated Diverticulitis\nGrade I | Mesenteric or pericolic abscessQ | Grade II | Pelvic abscessQ | Grade III | Purulent peritonitisQ | Grade IV |\nFaecal peritonitisQ\nAnswer (book): Answer: D. 4\nReference: Bailey 27/e p1274; Schwartz 11/e p1287; Sabiston 20/e p1333"},{"n":20,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 29","pdfPage":19,"stem":"A 5 years old child presented with history of blood in stools. On examination, there was a polypoidal mass in the rectum, biopsy of which is shown as below. Most probably diagnosis is:","options":[{"letter":"A","text":"Villous adenoma"},{"letter":"B","text":"Juvenile polyp"},{"letter":"C","text":"Vascular malformation"},{"letter":"D","text":"Serrated adenoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Juvenile polyp","explanation":"History of bleeding PR in a 5 years old child with presence of a polypoidal mass in the rectum and\nbiopsy showing dilated crypts and inflamed stroma is highly suggestive of juvenile polyp.\n“Juvenile polyp: This is a bright red, glistening pedunculated sphere (‘cherry tumour’), which is found in infants and\nchildren. Occasionally, it persists into adult life. It can cause bleeding, or pain if it prolapses during defecation. It\noften separates itself, but can be removed easily with forceps or a snare. A solitary juvenile polyp has virtually no\ntendency to malignant change, but should be treated if it is causing symptoms. It has a unique histological\nstructure with large mucus-filled spaces covered by a smooth surface of thin rectal cuboidal epithelium.”-Bailey\n27/e p1327\nImage-based question: the picture / video this question refers to is on PDF p. 19 of the source and is not reproduced here.\nAnswer (book): Answer: B. Juvenile polyp\nReference: Bailey 27/e p1327; Schwartz 11/e p1291; Sabiston 20/e p1372"},{"n":21,"chapter":"Recent Questions","src":"question on PDF p. 19 · answer on PDF p. 29","pdfPage":19,"stem":"What is the diagnosis based on the given image?","options":[{"letter":"A","text":"Omphalocele"},{"letter":"B","text":"Gastroschisis"},{"letter":"C","text":"Umbilical hernia"},{"letter":"D","text":"Spigelian hernia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gastroschisis","explanation":"In this newborn image, the bowel is exposed and located on the right side of umbilical cord is highly\nsuggestive of gastroschisis.\n“Gastroschisis is another congenital defect of the abdominal wall in which the umbilical membrane has ruptured in\nutero, allowing the intestine to herniate outside the abdominal cavity. The defect is almost always to the right of\nthe umbilical cord, and the intestine is not covered with skin or amnion.”-Sabiston 20/e p1071\nImage-based question: the picture / video this question refers to is on PDF p. 19 of the source and is not reproduced here.\nAnswer (book): Answer: B. Gastroschisis\nReference: Bailey 27/e p135; Schwartz 11/e p1554; Sabiston 20/e p1071"},{"n":22,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"Management of RCC less than 4 cm in size:","options":[{"letter":"A","text":"Radical nephrectomy"},{"letter":"B","text":"Partial nephrectomy"},{"letter":"C","text":"Chemotherapy"},{"letter":"D","text":"Surgery followed by chemotherapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Partial nephrectomy","explanation":"“The trend in extirpative surgery is to perform nephron sparing or partial nephrectomy for most T1\ntumors (Tumor 7 cm or less in greatest dimension, limited to the kidney). Partial nephrectomy is equivalent to radical\nnephrectomy in this tumor stage and should be considered for all patients with a T1a tumor (Tumor 4 cm or less) and\nmost with T1b (Tumor more than 4 cm but not more than 7 cm) tumors.”-Sabiston 20/e p2098\nAnswer (book): Answer: B. Partial nephrectomy\nReference: Bailey 27/e p1420; Sabiston 20/e p2098"},{"n":23,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"A man is brought to the emergency after he fell into a man hole and injured his perineum. He feels the urge to micturate but is unable to pass urine and there is blood at the tip of the meatus with extensive swelling of the penis and scrotum. What is the location of the injury?","options":[{"letter":"A","text":"Bulbar urethra"},{"letter":"B","text":"Prostatic urethra"},{"letter":"C","text":"Bladder"},{"letter":"D","text":"Membranous urethra"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Bulbar urethra (Ref: Bailey 27/e p1479","explanation":"“Rupture of the bulbar urethra: There is a history of a blow to the perineum, usually due to a fall\nastride injury. The bulbar urethra is crushed upwards onto the pubic bone, typically with significant bruising. In the\ndays of sailing ships, the common cause was falling astride a spar and the modern equivalent is seen among workers\nlosing their footing on scaffolding. Cycling accidents, loose manhole covers and gymnasium accidents astride the\nbeam account for a number of cases.”-Bailey 27/e p1479\nAnswer (book): Answer: A. Bulbar urethra (Ref: Bailey 27/e p1479"},{"n":24,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"Identify the investigation being performed and possible diagnosis:","options":[{"letter":"A","text":"MCU with membranous urethral stricture"},{"letter":"B","text":"MCU with bulbar urethral stricture"},{"letter":"C","text":"RGU with penile urethral stricture"},{"letter":"D","text":"RGU with prostatic urethral stricture"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"MCU with bulbar urethral stricture","explanation":"The given image is of MCU showing bulbar urethral stricture.\nImage-based question: the picture / video this question refers to is on PDF p. 20 of the source and is not reproduced here.\nAnswer (book): Answer: B. MCU with bulbar urethral stricture\nReference: Schwartz 11/e p2093"},{"n":25,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"True statement about intermittent claudication:","options":[{"letter":"A","text":"Felt at rest"},{"letter":"B","text":"Most common site is the calf"},{"letter":"C","text":"Claudication distance can vary from day to day"},{"letter":"D","text":"Relieved after getting out of bed and walking"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Most common site is the calf","explanation":"“Intermittent claudication: Intermittent claudication occurs as a result of anaerobic muscle metabolism\nand is classically described as debilitating cramp-like pain felt in the muscles that is: reliably brought on by walking;\nnot present on taking the first step (unlike osteoarthritis); reliably relieved by rest both in the standing and sitting\npositions; usually within 5 minutes. The distance that a patient is able to walk without stopping varies (claudication\ndistance) only slightly from day to day. It is decreased by increasing the work demands and hence oxygen\nrequirements of the muscles affected, e.g. walking up hill, increasing the speed of walking and/ or carrying heavy\nweights, and secondly by general health conditions that reduce the oxygen delivery capacity of the arterial system,\ne.g. anaemia or heart failure. The muscle group affected by claudication is classically one anatomical level below the\nlevel of arterial disease and is usually felt in the calf because the superficial femoral artery is the most commonly\naffected artery (70% of cases). Aorto-iliac disease (30% of cases) may cause thigh or buttock claudication. Buttock\nclaudication in association with sexual impotence resulting from arterial insufficiency is eponymously called Leriche’s\nsyndrome. It is very rare.”-Bailey 27/e p943\nAnswer (book): Answer: B. Most common site is the calf\nReference: Bailey 27/e p943; Schwartz 11/e p953; Sabiston 20/e p1780"},{"n":26,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"A 30 years old man presents with cramping gluteal pain after walking 500 meters. Which is the vessel involved?","options":[{"letter":"A","text":"Arterial disease with aorto-iliac involvement"},{"letter":"B","text":"Arterial disease with femoral artery involvement"},{"letter":"C","text":"Femoral venous insufficiency"},{"letter":"D","text":"Saphenous venous insufficiency"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Arterial disease with aorto-iliac involvement","explanation":"“Aorto-iliac disease (30% of cases) may cause thigh or buttock claudication. Buttock claudication in\nassociation with sexual impotence resulting from arterial insufficiency is eponymously called Leriche’s syndrome. It is\nvery rare.”-Bailey 27/e p943\n“Aorto-iliac disease: Symptoms typically consist of bilateral thigh or buttock claudication and fatigue. Men report\ndiminished penile tumescence and may have complete loss of erectile function. These symptoms in the absence of\nfemoral pulses constitute Leriche’s syndrome.”-Schwartz 11/e p941\nAnswer (book): Answer: A. Arterial disease with aorto-iliac involvement\nReference: Bailey 27/e p943; Schwartz 11/e p941; Sabiston 20/e p1738"},{"n":27,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"Male patient presents to the hospital with abdominal pain and is incidentally detected with an abdominal aortic aneurysm. What is the appropriate management of this patient?","options":[{"letter":"A","text":"Immediate surgery"},{"letter":"B","text":"USG monitoring till size of the aneurysm reaches 70 mm"},{"letter":"C","text":"Monitor till size reaches 40 mm"},{"letter":"D","text":"Monitor till size reaches 55 mm"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Monitor till size reaches 55 mm","explanation":"“An asymptomatic abdominal aortic aneurysm in an otherwise fit patient should be considered for\nrepair if >55 mm in diameter (measured by ultrasonography). The annual incidence of rupture rises from 1% or less\nin aneurysms that are <55 mm in diameter to a significant level, perhaps as high as 25%, in those that are 70 mm in\ndiameter. Assuming open elective surgery (transabdominal) carries a 5% mortality rate, the balance is in favour of\nelective operation once the maximum diameter is >55 mm, provided there is no major comorbidity. Regular\nultrasonographic assessment is indicated for asymptomatic aneurysms <55 mm in diameter.”-Bailey 27/e p961\n“Abdominal Aortic Aneurysm: Surgical treatment is generally recommended for aneurysms more than 5.5 cm in\nmaximal diameter, those demonstrating more than 5 mm of growth in 6 months or more than 1 cm in a year, and\naneurysms with a saccular rather than the typical fusiform anatomy.”-Sabiston 20/e p1725\nAnswer (book): Answer: D. Monitor till size reaches 55 mm\nReference: Bailey 27/e p961; Schwartz 11/e p920; Sabiston 20/e p1725"},{"n":28,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 30","pdfPage":20,"stem":"Which one of the following is not a component of THORACOSCORE?","options":[{"letter":"A","text":"Performance status"},{"letter":"B","text":"Complication of surgery"},{"letter":"C","text":"ASA grading"},{"letter":"D","text":"Priority of surgery"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Complication of surgery (Ref: Bailey 27/e p915","explanation":"“The Thoracoscore is the most widely used model to assess risk of operative mortality in thoracic\npatients. Risk is calculated based on nine variables—age, sex, American Society of Anesthesiologists (ASA) score,\nperformance status, dyspnoea score, priority of surgery, extent of surgery, malignant diagnosis and composite\ncomorbidity score. It is currently the most robust model available to estimate the risk of death when considering\npatients for thoracic surgery.”-Bailey 27/e p915\nAnswer (book): Answer: B. Complication of surgery (Ref: Bailey 27/e p915"},{"n":29,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 31","pdfPage":20,"stem":"What is the T stage of a 2.5 cm lung carcinoma, which is not involving the pleura?","options":[{"letter":"A","text":"T1a"},{"letter":"B","text":"T1b"},{"letter":"C","text":"T1c"},{"letter":"D","text":"T2"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T1c","explanation":"T1c is Tumor >2 cm but ≤3 cm in greatest dimension. 8th AJCC TNM Classification of Lung Cancer Tis:\nCarcinoma in situ T1a: Tumor ≤1 cm in greatest dimensionQ T1b: Tumor >1 cm but ≤2 cm in greatest dimensionQ\nT1c: Tumor >2 cm but ≤3 cm in greatest dimensionQ T2: Tumor >3 cm but ≤5 cm or tumor with any of the following\nfeatures: Involves main bronchus, regardless of distance to the carina but without involvement of carinaQ\n• Invades visceral pleuraQ\n• Associated with atelectasis or obstructive pneumonitis that extends to the hilar region either involving part of or\nthe entire lungQ\n• T2a: Tumor >3 cm but ≤4 cm in greatest dimensionQ\n• T2b: Tumor >4 cm but ≤5 cm in greatest dimensionQ T3: Tumor >5 cm but ≤7 cm in greatest dimension or one\nthat directly invades any of the following: parietal pleura, chest wall (including superior sulcus tumors), phrenic\nnerve, parietal pericardium; or separate tumor nodule(s) in the same lobe as the primaryQ T4: Tumor >7 cm or of\nany size that invades any of the following: diaphragm, mediastinum, heart, great vessels, trachea, recurrent\nlaryngeal nerve, esophagus, vertebral body, carina; or Separate tumor nodule(s) in a different ipsilateral lobe to\nthat of primaryQ N1: Metastasis in ipsilateral peribronchial and/or ipsilateral hilar lymph nodes and\nintrapulmonary nodes, including involvement by direct extensionQ N2: Metastasis in ipsilateral mediastinal and/or\nsubcarinal lymph node(s)Q N3: Metastasis in contralateral mediastinal, contralateral hilar, ipsilateral or\ncontralateral scalene, or supraclavicular lymph node(s)Q M1a: Separate tumor nodule(s) in a contralateral lobe;\ntumor with pleural or pericardial nodules or malignant pleural (or pericardial) effusionQ M1b: Single extra-thoracic\nmetastasis in a single or multiple organsQ M1c: Multiple extra-thoracic metastasis in single or multiple organsQ\nAnswer (book): Answer: C. T1c\nReference: Bailey 27/e p927; Schwartz 11/e p690; Sabiston 20/e p1587"},{"n":30,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 31","pdfPage":20,"stem":"Patient with clinical signs of DVT had tachycardia and history of bladder cancer. According to modified Well’s scoring, the probability of pulmonary embolism would be:","options":[{"letter":"A","text":"Low"},{"letter":"B","text":"Moderate"},{"letter":"C","text":"High"},{"letter":"D","text":"Severe"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Moderate","explanation":"The patient with clinical signs of DVT (score 3) has tachycardia (score 1.5) and history of bladder\ncancer (score 1). According to modified Well’s scoring, there would be moderate probability (Score 5.5) of pulmonary\nembolism. Modified Wells Criteria for Predicting Pulmonary Embolism (PE) Variable\nScore\nClinical signs & symptoms DVT (minimum of leg swelling & pain on palpation of deep veins)\n3 | Alternative diagnosis less likely than PEQ | 3 | Q | 1.5\nHeart rate >100 bpmQ Immobilisation >3 days or surgery within past 4 weeks\n1.5 | Previous DVT or PEQ | 1.5 | HaemoptysisQ | 1\nMalignancyQ (treatment or palliation within past 6 months)\n1\nQ\nLow risk: <2; Moderate risk: 3-6; High risk: >6\nAnswer (book): Answer: B. Moderate\nReference: Bailey 27/e p989"},{"n":31,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 31","pdfPage":20,"stem":"A child was brought to the emergency with multiple injuries which included a femur fracture as well. He was confused and dyspneic. There was presence of rash all over the body. What is the most probable diagnosis?","options":[{"letter":"A","text":"Fat embolism"},{"letter":"B","text":"Air embolism"},{"letter":"C","text":"Pulmonary embolism"},{"letter":"D","text":"DIC"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Fat embolism","explanation":"“Fat embolism may follow major bony fractures.”-Bailey 27/e p956\n“Fat emboli syndrome (FES) is a condition characterized by respiratory distress, altered mental status, and skin\npetechiae.” -Sabiston 20/e p501\nAnswer (book): Answer: A. Fat embolism\nReference: Bailey 27/e p956; Sabiston 20/e p501"},{"n":32,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 31","pdfPage":20,"stem":"What is the most probable cause of this condition?","options":[{"letter":"A","text":"Chronic lymphedema"},{"letter":"B","text":"Chronic arterial blockage"},{"letter":"C","text":"Chronic venous blockage"},{"letter":"D","text":"Chronic venous insufficiency"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Chronic lymphedema","explanation":"In the given image, there is swelling of dorsum of foot and buffalo hump appearance of foot, which is\nseen in chronic lymphedema.\n“Unlike other types of oedema, lymphoedema characteristically involves the foot. The contour of the ankle is lost\nthrough infilling of the submalleolar depressions, a ‘buffalo hump’ forms on the dorsum of the foot, the toes appear\n‘square’ because of confinement of footwear and the skin on the dorsum of the toes cannot be pinched because of\nsubcutaneous fibrosis (Stemmer’s sign).” -Bailey 27/e p998\n“In most patients with second-or third-stage lymphedema, the characteristic findings on physical examination can\nusually establish the diagnosis. The edematous limb has a firm and hardened consistency. There is loss of the\nnormal perimalleolar shape, resulting in a “tree trunk” pattern. The dorsum of the foot is characteristically swollen,\nresulting in the appearance of the “buffalo hump,” and the toes become thick and squared.”-Sabiston 20/e p1850\nAnswer (book): Answer: A. Chronic lymphedema\nReference: Bailey 27/e p998; Sabiston 20/e p1850"},{"n":33,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 32","pdfPage":20,"stem":"Elderly man with a long standing mole over the face which is increasing in size and showing irregular borders. Diagnosis:","options":[{"letter":"A","text":"Superficial spreading melanoma"},{"letter":"B","text":"Lentigo maligna"},{"letter":"C","text":"Acral melanoma"},{"letter":"D","text":"Nodular melanoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Lentigo maligna","explanation":"“Lentigo maligna melanoma occurs most commonly on the sun-exposed areas of older individuals and\nis manifested as a flat, dark, variably pigmented lesion, with irregular borders and a history of slow\ndevelopment.”-Sabiston 20/e p729\n“Lentigo maligna represents 10% of melanoma cases and is a less aggressive subtype of melanoma in situ that\ntypically arises on sun-exposed areas of the head and neck.”-Schwartz 11/e p530\nAnswer (book): Answer: B. Lentigo maligna\nReference: Bailey 27/e p609; Schwartz 11/e p530; Sabiston 20/e p729"},{"n":34,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 32","pdfPage":20,"stem":"For frost-bite rewarming, the temperature should be:","options":[{"letter":"A","text":"20 o C"},{"letter":"B","text":"25 o C"},{"letter":"C","text":"37 o C"},{"letter":"D","text":"42 o C"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"42 o C","explanation":"“Frostbite usually affects the distal aspects of the extremities or exposed parts of the face, such as the\nears, nose, chin, and cheeks.”-Harrison 20/e p1930\n“Initial treatment is rewarming, performed in an environment where reexposure to freezing conditions will not\noccur. Rewarming is accomplished by immersion of the affected part in a water bath at temperatures of 40°–44°C\n(104°–111°F). Massage, application of ice water, and extreme heat are contraindicated. The injured area should be\ncleansed with soap or antiseptic, and sterile dressings should be applied. Analgesics are often required during\nrewarming. Antibiotics are used if there is evidence of infection.”-Harrison 20/e p1930\n“Frostbite injuries affect the peripheries in cold climates. The initial treatment is with rapid rewarming in a bath at\n42°C. The cold injury produces delayed microvascular damage similar to that of cardiac reperfusion injury. The\nlevel of damage is difficult to assess, and surgery usually does not play a role in its management, which is\nconservative, until there is absolute demarcation of the level of injury.”-Bailey 27/e p632\n“Even so, the standard treatment of frostbite injury begins with rapid rewarming to 40°C to 42°C.”-Schwartz 11/e\np523\nAnswer (book): Answer: D. 42°C\nReference: Bailey 27/e p632; Schwartz 11/e p523; Harrison 20/e p1930"},{"n":35,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 32","pdfPage":20,"stem":"CT scan image showing cystic lesion with suprasellar calcification is suggestive of:","options":[{"letter":"A","text":"Craniopharyngioma"},{"letter":"B","text":"Meningioma"},{"letter":"C","text":"Astrocytoma"},{"letter":"D","text":"Oligodendroglioma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Craniopharyngioma","explanation":"“Craniopharyngiomas are rare, usually suprasellar, partially calcified, solid, or mixed solid-cystic\nbenign tumors that arise from remnants of Rathke’s pouch. They have a bimodal distribution, occurring\npre-dominantly in children but also between the ages of 55 and 65 years. They present with headaches, visual\nimpairment, and impaired growth in children and hypopituitarism in adults. Treatment involves surgery, RT, or a\ncombination of the two.”-Harrison 20/e p648\nImage-based question: the picture / video this question refers to is on PDF p. 20 of the source and is not reproduced here.\nAnswer (book): Answer: A. Craniopharyngioma\nReference: Schwartz 11/e p1858; Sabiston 20/e p1915; Harrison 20/e p648"},{"n":36,"chapter":"Recent Questions","src":"question on PDF p. 20 · answer on PDF p. 32","pdfPage":20,"stem":"Which of the following is not a surgical landmark for facial nerve identification in parotid surgery?","options":[{"letter":"A","text":"Inferior belly of omohyoid"},{"letter":"B","text":"Tragal pointer"},{"letter":"C","text":"Posterior belly of digastric"},{"letter":"D","text":"Dissecting from peripheral branches"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Inferior belly of omohyoid","explanation":"“LOCATION OF THE FACIAL NERVE TRUNK: The main methods of facial nerve trunk localisation can be\ndivided into antegrade and retrograde. The former utilises anatomical landmarks to identify the nerve trunk after its\nexit from the stylomastoid foramen, which is then traced distally. Landmarks commonly used are: 1. The inferior\nportion of the cartilaginous canal. This is termed Conley’s pointer (tragal pointer) and indicates the position of the\nfacial nerve, which lies 1 cm deep and inferior to its tip; 2. The upper border of the posterior belly of the digastric\nmuscle. Identification of this muscle not only helps to mobilise the parotid gland, but also exposes an area\nimmediately superior, in which the facial nerve is usually located; 3. The squamotympanic fissure; 4. The styloid\nprocess (the nerve is superficial to it); 5. The mastoid process can be drilled and the nerve identified more\nproximally.”-Bailey 27/e p790\nAnswer (book): Answer: A. Inferior belly of omohyoid\nReference: Bailey 27/e p790"},{"n":37,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 32","pdfPage":21,"stem":"A middle aged man presented with a swelling over the neck since childhood. Neck swelling has a bag of worm appearance. Most probable diagnosis is:","options":[{"letter":"A","text":"Plexiform neurofibroma"},{"letter":"B","text":"Toxic nodular goitre"},{"letter":"C","text":"Vasculitis"},{"letter":"D","text":"Lymphangioma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Plexiform neurofibroma","explanation":"“Plexiform neurofibroma: A special type of neurofibroma is the plexiform variant, which involves an\nentire large nerve and its branches, forming a mass of tangled, ropelike structures that feel like a “bag of worms” on\npalpation and that can reach an enormous size and be associated with massive soft tissue overgrowth leading to\nsignificant functional impairment. A plexiform neurofibroma is considered to be pathognomonic of NF1.”-Fitzpatrick\n6/e p1159\nFig. Plexiform neurofibromatosis\n“Plexiform neurofibromas: Diffuse plaques that feel knotty or wormy on palpation.”-Neena Khanna 4/e p34\nAnswer (book): Answer: A. Plexiform neurofibroma\nReference: Harrison 20/e p655; Neena Khanna 4/e p34"},{"n":38,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 33","pdfPage":21,"stem":"Primary survey of ATLS does not include:","options":[{"letter":"A","text":"CT scan"},{"letter":"B","text":"FAST"},{"letter":"C","text":"Chest X-ray"},{"letter":"D","text":"Pelvic X-ray"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CT scan","explanation":"Primary survey of ATLS does not include CT scan.\n“Following a defined order of assessment, life-threatening conditions are immediately addressed at the time of\nidentification. This initial assessment, also termed the primary survey, follows the mnemonic ABCDE: Airway and\ncervical spine protection; Breathing; Circulation; Disability or neurologic condition; Exposure and environmental\ncontrol”-Sabiston 20/e p413\n“Circulation: A chest radiograph can then evaluate for thoracic blood loss, and a pelvic radiograph will identify a\npelvic fracture. To evaluate the abdomen, the focused abdominal sonography in trauma (FAST) scan is a rapidly\nobtainable ultrasound examination that assesses for intraperitoneal fluid.”-Sabiston 20/e p416\nAnswer (book): Answer: A. CT scan\nReference: Sabiston 20/e p413, 414, 416"},{"n":39,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 33","pdfPage":21,"stem":"A 20 years old boy is brought to the emergency following a RTA with respiratory distress and hypotension. He has subcutaneous emphysema and no air entry on the right side. What is the next best step in the management?","options":[{"letter":"A","text":"Start IV fluids after insertion of wide bore IV line"},{"letter":"B","text":"Needle decompression in the 5th intercostal space"},{"letter":"C","text":"Shift to ICU and intubate"},{"letter":"D","text":"Positive pressure ventilation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Needle decompression in the 5th intercostal space","explanation":"“Tension pneumothorax: The clinical presentation is dramatic. The patient is increasingly restless with\ntachypnoea, dyspnoea and distended neck veins (similar to pericardial tamponade). Clinical examination may reveal\ntracheal deviation; this is a late finding and is not necessary to clinically confirm diagnosis. There will also be\nhyper-resonance and decreased or absent breath sounds over the affected hemithorax. Tension pneumothorax is a\nclinical diagnosis and treatment should never be delayed by waiting for radiological confirmation. Treatment consists\nof immediate decompression, initially by rapid insertion of a large-bore cannula into the second intercostal space in\nthe mid-clavicular line of the affected side, then followed by insertion of a chest tube through the fifth intercostal\nspace in the anterior axillary line.”-Bailey 27/e p367\nAnswer (book): Answer: B. Needle decompression in the 5th intercostal space\nReference: Bailey 27/e p367; Schwartz 11/e p186; Sabiston 20/e p415"},{"n":40,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 33","pdfPage":21,"stem":"Patient with stab injury to the lower chest presented with low pulses and BP improved after giving IV fluids. Chest X-ray showed clear lung fields. Next step in the management:","options":[{"letter":"A","text":"Chest tube insertion"},{"letter":"B","text":"CECT abdomen"},{"letter":"C","text":"CECT chest"},{"letter":"D","text":"E-fast"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"E-fast","explanation":"“Thoracic Injury: Ultrasound can be used to differentiate between contusion and the actual presence of\nblood. Extended focused assessment with sonar for trauma (eFAST) is becoming the most common investigation. The\ntechnique uses sonar assessment in the chest, looking for a cardiac tamponade or free blood and air in the\nhemithorax on each side, and assessment for blood in the abdominal cavity, in the paracolic gutters,\nsubdiaphragmatic spaces and pelvis.”-Bailey 27/e p366\nAnswer (book): Answer: D. E-fast\nReference: Bailey 27/e p366; Schwartz 11/e p188"},{"n":41,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 33","pdfPage":21,"stem":"The given below image in a patient with road traffic accident shows:","options":[{"letter":"A","text":"Battle sign"},{"letter":"B","text":"Bezold abscess"},{"letter":"C","text":"Citelli’s abscess"},{"letter":"D","text":"Griesinger sign"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Battle sign","explanation":"“Battle’s sign: A skull base fracture may be associated with bruising over the mastoid process.”-Bailey\n27/e p332\n“Extravasation of blood results in ecchymosis behind the ear, known as Battle’s sign.”-Schwartz 11/e p1835\nImage-based question: the picture / video this question refers to is on PDF p. 21 of the source and is not reproduced here.\nAnswer (book): Answer: A. Battle sign\nReference: Bailey 27/e p332; Schwartz 11/e p1835"},{"n":42,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 33","pdfPage":21,"stem":"A 5 years old child is having acute liver failure. Which one of the following criteria is not included in the King’s college criteria?","options":[{"letter":"A","text":"Age <11 years"},{"letter":"B","text":"INR >6.5"},{"letter":"C","text":"Bilirubin >300 μmol/L"},{"letter":"D","text":"Jaundice <7 days before development of encephalopathy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Jaundice <7 days before development of encephalopathy","explanation":"Time from onset of jaundice to development of coma >7 days (not <7 days) is included in King’s\nCollege Criteria).\nKing’s College Criteria Associated with Poor Prognosis for Acute Liver Failure (ALF) Patients Patients with\nNon–Acetaminophen-Induced ALF INR >6.5 or Three of the following five criteria:\n• Patient age <11 or >40 yearsQ\n• Serum bilirubin >300 μmol/LQ\n• Time from onset of jaundice to development of coma >7 daysQ\n• INR >3.5Q\n• Drug toxicity, regardless of whether it caused ALF Q\nPatients with Acetaminophen-Induced ALF Arterial pH <7.3 (taken by arterial blood sampling) All three of the\nfollowing:\n• INR >6.5Q\n• Serum creatinine >300 μmol/LQ\n• Presence of encephalopathyQ (grade III or IV)\nAnswer (book): Answer: D. Jaundice <7 days before development of encephalopathy\nReference: Blumgart 6/e p1775"},{"n":43,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"Which is the most common infection in a transplant patient after 3-4 months? In renal transplant recipients, which is the likely organism causing reactivation disease within 3-4 months after surgery?","options":[{"letter":"A","text":"HSV"},{"letter":"B","text":"CMV"},{"letter":"C","text":"EBV"},{"letter":"D","text":"VZV"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CMV","explanation":"“The risk of viral infection is highest during the first 6 months after transplantation and the most\ncommon problem is CMV infection. CMV disease may arise because of either reactivation of latent infection or\nprimary infection that can be transmitted by an organ from a CMV-positive donor.”-Bailey 27/e p1541\nAnswer (book): Answer: B. CMV\nReference: Bailey 27/e p1541; Schwartz 11/e p363"},{"n":44,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"Nosocomial infections are diagnosed after how many hours of hospitalization/admission?","options":[{"letter":"A","text":"24 hours"},{"letter":"B","text":"48 hours"},{"letter":"C","text":"72 hours"},{"letter":"D","text":"96 hours"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"48 hours","explanation":"“Nosocomial infections can be defined as those occurring within 48 hours of hospital admission, 3 days\nof discharge or 30 days of an operation.”-Practical Healthcare Epidemiology 3/e p124\nAnswer (book): Answer: B. 48 hours\nReference: Sabiston 20/e p291"},{"n":45,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"All of the following are part of the ASEPSIS wound score except:","options":[{"letter":"A","text":"Serous discharge"},{"letter":"B","text":"Purulent exudate"},{"letter":"C","text":"Induration"},{"letter":"D","text":"Erythema"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Induration","explanation":"Induration is not the part of the ASEPSIS wound score. The ASEPSIS wound score Criterion\nPoints\nAdditional treatmentQ\n• Antibiotics for wound infection\n• Drainage of pus under local anaesthesia\n• Debridement of wound under general anaesthesia\n0 10 5 10 | Serous dischargeQ Erythema | Daily 0–5 Daily 0–5 | Q | Purulent exudateQ | Daily 0–10 | Separation of\ndeep tissuesQ | Daily 0–10\nIsolation of bacteria from woundQ Stay as inpatient prolonged over 14 days as result of wound infection\n10 Q\n5\nAnswer (book): Answer: C. Induration\nReference: Bailey 27/e p48"},{"n":46,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"Graft taken from identical twin is called as:","options":[{"letter":"A","text":"Autograft"},{"letter":"B","text":"Allograft"},{"letter":"C","text":"Isograft"},{"letter":"D","text":"Xenograft"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Isograft","explanation":"“Isografts are organs transplanted between identical twins and are immunologically indistinguishable\nand thus are not rejected.” -Sabiston 20/e p602\nAIIMS November 2019 — Q47 to Q65\nAnswer (book): Answer: C. Isograft\nReference: Sabiston 20/e p602"},{"n":47,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"Which of the following structure is not removed in radical neck dissection? (AIIMS November 2019)","options":[{"letter":"A","text":"SCM"},{"letter":"B","text":"Digastric muscle"},{"letter":"C","text":"Spinal accessory nerve"},{"letter":"D","text":"Level 1-5 lymph nodes"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Digastric muscle","explanation":"Digastric muscle is not removed in radical neck dissection.\n“Classical Radical Neck Dissection (Crile): The classic operation involves resection of the cervical lymphatics and\nlymph nodes and those structures closely associated: the internal jugular vein, the accessory nerve, the\nsubmandibular gland and the sternocleidomastoid muscle. These structures are all removed en bloc and in\ncontinuity with the primary disease if possible. The main disability that follows the operation is weakness and\ndrooping of the shoulder due to paralysis of the trapezius muscle as a consequence of excision of the accessory\nnerve.”-Bailey 27/e p758\nAnswer (book): Answer: B. Digastric muscle\nReference: Bailey 27/e p758; Schwartz 11/e p647; Sabiston 20/e p794"},{"n":48,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 34","pdfPage":21,"stem":"Identify this instrument: (AIIMS November 2019)","options":[{"letter":"A","text":"Monopolar cautery"},{"letter":"B","text":"Bipolar cautery"},{"letter":"C","text":"Hyfrecators"},{"letter":"D","text":"LigaSure"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Monopolar cautery","explanation":"The name of given instrument is monopolar cautery.\nMonopolar Electrocautery | Bipolar Electrocautery | LigaSure | Hyfrecators\nImage-based question: the picture / video this question refers to is on PDF p. 21 of the source and is not reproduced here.\nAnswer (book): Answer: A. Monopolar cautery\nReference: Sabiston 20/e p235-236"},{"n":49,"chapter":"Recent Questions","src":"question on PDF p. 21 · answer on PDF p. 35","pdfPage":21,"stem":"Which of the following cannula is used in the patient with dehydration and diarrhea? (AIIMS November 2019, November 2018)","options":[{"letter":"A","text":"Blue"},{"letter":"B","text":"Green"},{"letter":"C","text":"Grey"},{"letter":"D","text":"Pink"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Grey","explanation":"http://bulletin.facs.org/2018/06/atls-10th-edition-offers-new-insights-intomanaging-trauma-patients/\nGrey cannula has the large bore (16 G) with flow rate of 180 mL/min and is the preferred option for\nrapid fluid resuscitation in patients with rehydration.\nColor code | Gauge | External Diameter (mm) | Length (mm) | Flow Rate (mL/min) | Orange | Q | 14G | 2.1 | Grey |\n16GQ | Green | Indications | 45 | 240 | Q | Trauma, surgical proceduresQ | 1.8 | 45 | 180Q | Trauma, surgical\nproceduresQ | 18GQ | 1.3 | 32/45 | 90Q | Trauma, quick blood transfusionQ | Pink | 20GQ | 1.1 | 32 | 60Q | Normal IV or\nblood transfusionQ | Blue | 22GQ | 0.9 | 25 | 36Q | Children, older adultsQ | Yellow | 24G | 0.7 | 19 | 20 | Neonates,\nchildren, elderly | Violet | 26G | 0.6 | 19 | 13 | NeonatesQ\nAnswer (book): Answer: C. Grey\nReference: Bailey 25/e p29; ATLS 10th edition 2018 Chapter 3"},{"n":51,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 36","pdfPage":22,"stem":"What is the name of this treatment modality? (AIIMS November 2019)","options":[{"letter":"A","text":"Positive pressure wound therapy"},{"letter":"B","text":"Negative pressure wound therapy"},{"letter":"C","text":"Sclerotherapy"},{"letter":"D","text":"Foam therapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Negative pressure wound therapy","explanation":"The name of given treatment modality is vacuum assisted closure or negative pressure wound therapy\n(NPWT).\n“Vacuum-assisted closure: This is now more correctly known as negative pressure wound closure. Applying\nintermittent negative pressure of approximately −125 mm Hg appears to hasten debridement and the formation of\ngranulation tissue in chronic wounds and ulcers. A foam dressing is cut to size to fit the wound. A perforated wound\ndrain is placed over the foam, and the wound is sealed with a transparent adhesive film. A vacuum is then applied\nto the drain. Negative pressure may act by decreasing oedema, by removing interstitial fluid and by increasing\nblood flow. As a result, bacterial counts decrease and cell proliferation increases, thereby creating a suitable bed\nfor graft or flap cover.”-Bailey 27/e p30\nAnswer (book): Answer: B. Negative pressure wound therapy\nReference: Bailey 27/e p30; Schwartz 11/e p; Sabiston 20/e p"},{"n":52,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 36","pdfPage":22,"stem":"What is the name of this method of thyroid palpation. Video-based question- Thyroid gland is pushed to left side and being palpated with fingers of left hand? (AIIMS November 2019)","options":[{"letter":"A","text":"Lahey’s method"},{"letter":"B","text":"Kocher’s test"},{"letter":"C","text":"Pizillo’s method"},{"letter":"D","text":"Crile’s method"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lahey’s method","explanation":"In this method of thyroid palpation, thyroid gland is pushed to left side and being palpated with fingers\nof left hand. This is Lahey’s method of thyroid palpation.\n“The hallmark of a thyroid swelling is that the swelling moves on deglutition. Examination of the thyroid is best\nperformed both from behind and in front of the patient with their neck in slight extension. The gland can be made\nmore prominent by Pizillo’s manoeuvre in which the patient’s hands are placed behind their occiput and the head is\npushed backwards against the clasped hands.”-Hamilton Bailey’s Demonstration of Physical Signs in Clinical\nSurgery 19/e p409\n“The lobes may be better examined by Lahey’s method in which, for examination of the left lobe, the thyroid gland\nis pushed to the left from the right side by the examiner’s left hand, and similarly to the right by the right hand.\nSmaller nodules within the substance of the gland are better appreciated by palpating the gland using the thumb\nwhile the patient swallows (Crile’s method).”-Hamilton Bailey’s Demonstration of Physical Signs in Clinical Surgery\n19/e p410\nThyroid Palpation | Pizillo’s Method | Lahey’s method | Crile’s method\n• Examination of thyroid • Thyroid gland is made more prominent • Lobes may be better\n• For palpation of is best performed in short necked & obese patients. examined by Lahey’s method smaller\nnodules both from behind & in • Patient’s hands are placed behind within gland substance\n• Thyroid gland is pushed front of the patient with Palpating the gland their occiput & head is pushed to one side by\nexaminer’s their neck in slight using the thumb while backwards against the clasped hand & lobe is palpated with\nextension. the patient swallows hands. fingers of other hand.\nImage-based question: the picture / video this question refers to is on PDF p. 22 of the source and is not reproduced here.\nAnswer (book): Answer: A. Lahey’s method\nReference: Hamilton Bailey’s Demonstration of Physical Signs in Clinical Surgery 19/e p409, 410"},{"n":53,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 36","pdfPage":22,"stem":"Slow growing alveolar like tumour in liver is caused by: (AIIMS November 2019)","options":[{"letter":"A","text":"E. granulossus"},{"letter":"B","text":"E. multilocularis"},{"letter":"C","text":"Amoebic liver abscess"},{"letter":"D","text":"Cysticercus cellulosae"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"E. multilocularis","explanation":"Slow growing alveolar like tumour in liver is caused by Echinococcus multilocularis. Echinococcus\nmultilocularis causes malignant hydatid disease.\n“E. multilocularis, which causes multilocular alveolar lesions that are locally invasive, is found in Alpine, sub-Arctic,\nor Arctic regions, including central and northern Europe; western China and central Asia; and isolated areas in\nNorth America.” -Harrison 20/e p1644\n“The larval forms of E. multilocularis characteristically present as a slowly growing hepatic tumor, with progressive\ndestruction of the liver and extension into vital structures. Patients commonly report upper-quadrant and epigastric\npain. Liver enlargement and obstructive jaundice may be apparent. The lesions may infiltrate adjoining organs\n(e.g., diaphragm, kidneys, or lungs) or may metastasize to the spleen, lungs, or brain.”-Harrison 20/e p1645\nAnswer (book): Answer: B. E. multilocularis\nReference: Harrison 20/e p1644, 1645"},{"n":54,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 37","pdfPage":22,"stem":"A patient of chronic liver failure presented with acute variceal bleeding. The BP was 80/60 mm Hg. Which of the following is not done? (AIIMS November 2019)","options":[{"letter":"A","text":"Octreotide infusion"},{"letter":"B","text":"Urgent endoscopy"},{"letter":"C","text":"Packed RBC"},{"letter":"D","text":"Platelet transfusion"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Platelet transfusion","explanation":"In patients with acute variceal bleeding with hypotension fluid resuscitation and packed cell\ntransfusion is indicated. Octreotide infusion is given to control the ongoing bleeding. After stabilization of the patient,\nupper GI endoscopy is done to confirm the diagnosis and for endoscopic variceal ligation or sclerotherapy. In variceal\nbleeding patients, associated thrombocytopenia is usually secondary to hypersplenism due to cirrhosis and is treated\nif the platelet count falls below 50 × 109/L. So, platelet transfusion is usually not given in the patients of acute\nvariceal bleeding.\n“Varices usually present with the acute onset of a large-volume haematemesis, the lower oesophagus being the\nmost common site for variceal bleeding. The diagnosis may be suspected if the patient is known to have liver\ncirrhosis, but it needs to be confirmed following initial resuscitation of the patient. Variceal haemorrhage is a\nmedical emergency. Patients with massive hemorrhage should be admitted to the intensive care unit. Venous\naccess should be obtained through two large-bore peripheral cannulae. Resuscitation should be commenced,\nideally with blood. Liver function tests will reveal underlying liver disease, and a coagulation profile will reveal any\nunderlying coagulopathy. Hypervolaemia should be avoided since this may increase portal pressure and\nexacerbate the bleeding. Vitamin K is administered (10 mg intravenously (IV)) as well as tranexamic acid (1 g i.v.),\nbut correction of a coagulopathy will require the administration of fresh frozen plasma (FFP). A major transfusion\nprotocol should be activated. An associated thrombocytopenia is usually secondary to hypersplenism due to\ncirrhosis and is treated if the platelet count falls below 50 × 109/L. Treatment with a splanchnic vasoconstrictor\n(such as terlipressin) should be started. Administration of a prophylactic antibiotic is recommended to prevent or\ntreat associated bacterial infection. As soon as the patient is haemodynamically stabilized, an upper\ngastrointestinal endoscopy should be performed to establish the diagnosis because 50% of patients with portal\nhypertension will have a non-variceal source of bleeding.”-Bailey 27/e p1163\nAnswer (book): Answer: D. Platelet transfusion\nReference: Bailey 27/e p1163; Schwartz 11/e p1367; Sabiston 20/e p1149"},{"n":56,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 38","pdfPage":22,"stem":"A bed-ridden patient is having the sore in the lower back region. Identify the stage of pressure sore: (AIIMS November 2019)","options":[{"letter":"A","text":"Stage 1"},{"letter":"B","text":"Stage 2"},{"letter":"C","text":"Stage 3"},{"letter":"D","text":"Stage 4"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Stage 4","explanation":"The given pressure sore is stage 4 as there is full thickness skin loss through fascia with extensive\ntissue destruction. Staging of Pressure Sore Stage\nDescription\n1\nNon-blanchable erythema without a breach in epidermis (Early superficial ulcerQ)\n2\nPartial thickness skin loss involving epidermis & dermis (Late superficial ulcerQ)\n3\nFull thickness skin loss extending into subcutaneous tissue but not through underlying fascia (Early deep ulcerQ)\n4\nFull thickness skin loss through fascia with extensive tissue destruction, maybe involving muscle, bone, tendon or\njoint (Late deep ulcerQ)\nImage-based question: the picture / video this question refers to is on PDF p. 22 of the source and is not reproduced here.\nAnswer (book): Answer: D. Stage 4\nReference: Bailey 27/e p29, 30, 615, 616; Schwartz 11/e p290, 291, 523, 524"},{"n":57,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 38","pdfPage":22,"stem":"A 10 years old boy came to emergency with complains of severe pain in right scrotum that is not relieved for the past 1 hour. On examination, testicular torsion of the right side is suspected. The surgical intervention should be: (AIIMS November 2019)","options":[{"letter":"A","text":"Immediate scrotal exploration of the affected side and operate opposite side if symptomatic"},{"letter":"B","text":"Delay exploration and operate opposite side if symptomatic"},{"letter":"C","text":"Immediate exploration of the affected side and operate opposite side even if asymptomatic"},{"letter":"D","text":"Delayed exploration on the affected side along with the opposite side even if asymptomatic"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Immediate exploration of the affected side and operate opposite side even if asymptomatic","explanation":"In cases of testicular torsion, immediate exploration of the affected side and operation of opposite side\neven if asymptomatic should be done because the anatomical predisposition is likely to be bilateral.\n“Surgical exploration of the testis through a hemiscrotal transverse (dartos pouch) or midline raphe incision should\nfirst address the affected side. The testis is delivered and the tunica vaginalis opened to note the color of the testis,\nthe number of rotations, and the anatomy of the tunica vaginalis. The testis is untwisted, wrapped in warm soaked\ngauze, and observed for improvement in color while the contralateral testis is fixed with nonabsorbable suture to\nreduce the risk of metachronous torsion. The affected testis is re-examined for potential viability, and the largely\nsubjective decision for orchidopexy or orchiectomy is made. A Doppler flow probe or incision of the tunica\nalbuginea with assessment of bleeding may document intratesticular flow after detorsion; however, the reliability of\nthese assessments lacks validation. If the testis is to be retained, it is fixed either via dartos pouch or directly to the\ndartos with nonabsorbable suture.”-Campbell 11/e p3390\nAnswer (book): Answer: C. Immediate exploration of the affected side and operate opposite side even if asymptomatic\nReference: Bailey 27/e p1501; Campbell 11/e p3390"},{"n":58,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 38","pdfPage":22,"stem":"Identify the drain: (AIIMS November 2019)","options":[{"letter":"A","text":"Jackson-Pratt suction drain"},{"letter":"B","text":"Corrugated drain"},{"letter":"C","text":"Hemovac drain"},{"letter":"D","text":"Large suction drain"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Jackson-Pratt suction drain","explanation":"The given drain is Jackson-Pratt suction drain, used as a postoperative drain for collecting bodily fluids\nfrom surgical sites.\n“A Jackson-Pratt drain (also called a JP drain) is a closed-suction medical device that is commonly used as a\npostoperative drain for collecting bodily fluids from surgical sites. The device consists of an internal drain\nconnected to a grenade-shaped bulb via plastic tubing.”\nImage-based question: the picture / video this question refers to is on PDF p. 22 of the source and is not reproduced here.\nAnswer (book): Answer: A. Jackson-Pratt suction drain\nReference: Schwartz 11/e p1383; Sabiston 20/e p1302"},{"n":59,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 38","pdfPage":22,"stem":"A 25 years old patient complains of pain in the right side of forearm and arm. The following test is done to demonstrate the diagnosis: (AIIMS November 2019)","options":[{"letter":"A","text":"Roos test"},{"letter":"B","text":"Pemberton test"},{"letter":"C","text":"Adson test"},{"letter":"D","text":"Wright test"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Roos test","explanation":"The given clinical picture suggests the diagnosis of thoracic outlet compression syndrome (TOS). In the\ntest, patient is instructed to draw shoulders backwards, raise arms to horizontal position with elbows flexed to 90°\nand Exercise the hands. This test is known as Roos test (Arm claudication test).\n“A Roos test is performed by asking the patient to hold both arms overhead in a surrender position while opening\nand closing the fists. This reproduces symptoms within 1 minute and, if continued, the arm collapses at the\nside.”-Sabiston 20/e p2007\nAnswer (book): Answer: A. Roos test\nReference: Sabiston 20/e p2007"},{"n":60,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 39","pdfPage":22,"stem":"ABCDE mnemonic is used for which of the following disease? (AIIMS November 2019)","options":[{"letter":"A","text":"Malignant melanoma"},{"letter":"B","text":"SCC"},{"letter":"C","text":"Basal cell carcinoma"},{"letter":"D","text":"Verrucous cancer"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Malignant melanoma","explanation":"ABCDE mnemonic is used for malignant melanoma. ABCDE rule for Malignant melanoma: Asymmetry\n(one half of the mole doesn’t match the other), Border irregularity, Color that is not uniform, Diameter greater than 6\nmm (about the size of a pencil eraser), and Evolving size, shape or color.\n“Melanoma commonly is manifested as an irregular pigmented skin lesion that has grown or changed over time.\nThe ABCDEs of melanoma are used to guide diagnosis and the decision to perform a biopsy: asymmetry, irregular\nborders, color changes, diameter greater than 6 mm, and evolution or change over time.”-Sabiston 20/e p726\n“Melanoma most commonly manifests as cutaneous disease, and clinical characteristics include an Asymmetric\noutline, changing irregular Borders, Color variations, Diameter greater than 6 mm, and Elevation (ABCDE). Other\nkey clinical characteristics include a pigmented lesion that has enlarged, ulcerated, or bled.”-Schwartz 11/e p530\nA | B | C | D | E\nAnswer (book): Answer: A. Malignant melanoma\nReference: Schwartz 11/e p530; Sabiston 20/e p726"},{"n":61,"chapter":"Recent Questions","src":"question on PDF p. 22 · answer on PDF p. 39","pdfPage":22,"stem":"The following device is used: (AIIMS November 2019)","options":[{"letter":"A","text":"For draining liver abscess"},{"letter":"B","text":"To create pneumoperitoneum"},{"letter":"C","text":"To drain ascites"},{"letter":"D","text":"Used in emergency pneumothorax"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"To create pneumoperitoneum","explanation":"The given instrument is Veress needle, used to create pneumoperitoneum in laparoscopic surgeries.\n“Pneumoperitoneum is created using a Veress needle or insufflation via a Hasson port.”-Schwartz 11/e p1699\n“The pneumoperitoneum is created with carbon dioxide gas, either with an open technique or by closed needle\ntechnique. Initially, a small incision is made in the upper edge of the umbilicus. With the closed technique, a special\nhollow insufflation needle (Veress needle) that is spring-loaded with a retractable cutting outer sheath is inserted\ninto the peritoneal cavity and used for insufflation.” -Schwartz 11/e p1412\nAnswer (book): Answer: B. To create pneumoperitoneum\nReference: Schwartz 11/e p1412, 459-460; Sabiston 20/e p1051, 2058"},{"n":62,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 39","pdfPage":23,"stem":"You are an intern posted in AIIMS. You are going to perform the ABG analysis. Which test you will perform before doing ABG analysis? (AIIMS November 2019)","options":[{"letter":"A","text":"Allen test"},{"letter":"B","text":"Adson test"},{"letter":"C","text":"Barbeau test"},{"letter":"D","text":"Halsted test"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Allen test","explanation":"The test being done is Allen’s test, which is done before performing the ABG analysis. Allen’s test\nexamines the patency of the interconnection between the superficial and deep palmar arches, and determines\nwhether either artery is capable of maintaining the arterial supply to the hand in isolation.\n“Sites for arterial cannulation: At the wrist, the radial artery is commonly used for arterial cannulation for arterial\nblood sampling and blood pressure monitoring. Thrombosis or vasospasm of the radial artery at this site should not\nnormally jeopardize the circulation to the hand since the interconnecting palmar arterial arches provide a collateral\ncirculation to the hand. Allen’s test should be performed prior to any such procedure.”-Gray’s 41/e p791\nA\nB Fig. Allen’s test\n“Allen’s test examines the patency of the interconnection between the superficial and deep palmar arches, and\ndetermines whether either artery is capable of maintaining the arterial supply to the hand in isolation. To perform\nthe test, the radial and ulnar arteries of one hand are compressed by the examiner’s thumbs. The forearm is then\nelevated and the hand exsanguinated by clenching the fist. The hand is then opened while arterial compression is\ncontinued. The palm of the hand appears pale, unless there is an anomalous arterial supply, e.g. from a persistent\nmedian artery. The rapid return of a normal pink colour to the palmar skin following removal of digital pressure\nfrom one of the arteries suggests that artery is capable of perfusing the hand adequately in isolation. If the palmar\nskin remains pale, it must be assumed either that there is a distal obstruction to the artery or that the artery cannot\nadequately perfuse the hand in isolation. The test is then repeated with release of digital pressure on the other\nartery.”-Gray’s 41/e p791\nImage-based question: the picture / video this question refers to is on PDF p. 23 of the source and is not reproduced here.\nNote: Image-based question: a picture labelled A and B accompanies this question in the PDF.\nAnswer (book): Answer: A. Allen test\nReference: Bailey 27/e p444; Schwartz 11/e p1412, 459-460; Sabiston 20/e p1051, 2058"},{"n":63,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 40","pdfPage":23,"stem":"Daily insensible fluid loss per day: (AIIMS November 2019)","options":[{"letter":"A","text":"100–200 mL/day"},{"letter":"B","text":"200–300 mL/day"},{"letter":"C","text":"500–600 mL/day"},{"letter":"D","text":"600–800 mL/day"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"600–800 mL/day","explanation":"Daily insensible fluid loss is 600–800 mL/day.\n“The healthy person consumes an average of 2000 mL of water per day, approximately 75% from oral intake and\nthe rest extracted from solid foods. Daily water losses include 800 to 1200 mL in urine, 250 mL in stool, and 600 mL\nin insensible losses. Insensible losses of water occur through both the skin (75%) and lungs (25%) and can be\nincreased by such factors as fever, hypermetabolism, and hyperventilation. Sensible water losses such as sweating\nor pathologic loss of gastrointestinal (GI) fluids vary widely, but these include the loss of electrolytes as well as\nwater. To clear the products of metabolism, the kidneys must excrete a minimum of 500 to 800 mL of urine per\nday, regardless of the amount of oral intake.”-Schwartz 11/e p85\nWater exchange (60- to 80-kg man) Routes | Avg Daily Volume (mL) | Minimal (mL) | Maximal (mL) | Oral fluids |\n800–1500Q | 0 | 1500/h | Solid foods | 500–700 | 0 | 1500 | H2O gain: Sensible: | Q | Insensible: Water of oxidation |\n250Q | 125 | 800 | Water of solution | 0 | 0 | 500 | Water exchange (60- to 80-kg man) Routes | Avg Daily Volume\n(mL) | Minimal (mL) | Maximal (mL) | Urine | 800–1500Q | 300 | 1400/h | Intestinal | 0–250 | 0 | 2500/h | Sweat | 0 | 0\n| 4000/h | 600Q | 600 | 1500 | H2O loss: Sensible: Q | Insensible: Lungs and skin\nAnswer (book): Answer: D. 600–800 mL/day\nReference: Bailey 27/e p280; Schwartz 11/e p85"},{"n":64,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 41","pdfPage":23,"stem":"Match the following: Column A Column B 1. Primary survey A. Identify what can cause death 2. Secondary survey B. Identify other injuries 3. Definitive care C. Treat what can cause death 4. Resuscitation D. Make a management plan (AIIMS November 2019)","options":[{"letter":"A","text":"1-A; 2-B; 3-C; 4-D"},{"letter":"B","text":"1-A; 2-D; 3-B; 4-C"},{"letter":"C","text":"1-A; 2-C; 3-B; 4-D"},{"letter":"D","text":"1-A; 2-B; 3-D; 4-C"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"1-A; 2-B; 3-D; 4-C","explanation":"1. Primary survey: A. Identify what can cause death; 2. Secondary survey: B. Identify other injuries; 3.\nDefinitive care: D. Make a management plan; 4. Resuscitation: C. Treat what can cause death\n“Following a defined order of assessment, life-threatening conditions are immediately addressed at the time of\nidentification. This initial assessment, also termed the primary survey, follows the mnemonic ABCDE: Airway and\ncervical spine protection; Breathing; Circulation; Disability or neurologic condition; Exposure and environmental\ncontrol.”-Sabiston 20/e p413\n“Secondary Survey: A thorough head to toe examination is required to assist in identifying all potential injuries. This\nis often performed immediately after the primary survey in patients who are stable and not requiring emergent\nintervention. Findings identified during the secondary survey often prompt further evaluation with imaging or other\ndiagnostic modalities.”-Sabiston 20/e p417\n“The primary survey aims to identify and manage the most immediately life-threatening pathologies first.”-Bailey\n27/e p323\n“Secondary Survey: All severely injured patients require a detailed top to toe examination after life-threatening\ninjuries have been identified and managed during the primary survey.”-Bailey 27/e p326\nPrimary Survey | Secondary Survey | Tertiary Survey\n• Aimed at detecting & simultaneously treating immediately life threatening injuriesQ\n• Identified by the mnemonic ‘ABCDE’\n• A: Airway maintenance with cervical spine protectionQ\n• B: Breathing (ventilation & oxygenation)Q\n• C: Circulation with hemorrhage controlQ\n• D: Disability (Brief neurological examination)Q\n• E: Exposure /Environmental controlQ\n• Consists of head to toe systematic assessment of abdominal, pelvic & thoracic areasQ\n• Complete inspection of body surface to find all injuries & neurological examinationQ\n• Patients & surrogates should be queried to obtain an AMPLE history\n• A: AllergiesQ\n• M: MedicationQ\n• P: Past illness or pregnancyQ\n• L: Last mealQ\n• E: Events related to injuryQ\n• Comprehensive patient evaluation after initial resuscitation periodQ\n• Usually performed about 24 hours after admissionQ\n• Include a thorough physical examination combined with targeted radiographic imaging (X-ray usage or CT) based\non examination findingQ\n• Decreases the delay in diagnosis of potentially lifethreatening injuriesQ\nAnswer (book): Answer: D. 1-A; 2-B; 3-D; 4-C\nReference: Bailey 27/e p322, 323, 326; Schwartz 11/e p183, 195; Sabiston 20/e p413, 417"},{"n":65,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 41","pdfPage":23,"stem":"Most common cause of post solid organ transplant infection: (AIIMS November 2019)","options":[{"letter":"A","text":"Varicella zoster"},{"letter":"B","text":"CMV"},{"letter":"C","text":"EBV"},{"letter":"D","text":"BK virus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CMV","explanation":"Most common cause of post solid organ transplant infection among the given options is CMV.\n“The risk of viral infection is highest during the first 6 months after transplantation and the most common problem\nis CMV infection. CMV disease may arise because of either reactivation of latent infection or primary infection that\ncan be transmitted by an organ from a CMV-positive donor. Recipients at most risk from CMV infection are those\nwho are CMV seronegative (i.e. those who have not been infected previously with CMV) and receive an organ from\na CMV-seropositive donor (about half of all UK donors are CMV seropositive).”-Bailey 27/e p1541\nAIIMS May 2019 — Q66 to Q88\nAnswer (book): Answer: B. CMV\nReference: Harrison 20/e p1035; Robbin’s 9/e p360; Bailey 27/e p1541; Schwartz 11/e p363"},{"n":66,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 42","pdfPage":23,"stem":"Most common mediastinal tumor: (AIIMS May 2019)","options":[{"letter":"A","text":"Neurogenic tumor"},{"letter":"B","text":"Thymoma"},{"letter":"C","text":"Lymphoma"},{"letter":"D","text":"Bronchogenic cyst"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Neurogenic tumor","explanation":"Most common mediastinal tumor is neurogenic tumor.\n“Mediastinal pathology varies significantly by patient age. In children, neurogenic tumors of the posterior\nmediastinum are most common, followed by lymphoma, which is usually located in the anterior or middle\ncompartment. Thymoma in childhood is rare. In adults, the most common tumors include neurogenic tumors of the\nposterior compartment, benign cysts occurring in any compartment, and thymomas of the anterior\nmediastinum.”-Schwartz 11/e p727\nMediastinal Tumors in Adults Percentage of Total\nTumor Type | Location | Neurogenic tumors | 21 | Posterior | CystsQ | 20 | All | Thymomas | 19 | Anterior |\nLymphomasQ | 13 | Anterior/middle | Germ cell tumors | 11 | Anterior | Mesenchymal tumors | 7 | All | Endocrine\ntumors | 6 | Anterior/middle | Q | Q\nMediastinal Tumors in Children Percentage of Total\nTumor Type | Location | Neurogenic tumorsQ | 40 | Posterior | LymphomasQ | 18 | Anterior/middle | CystsQ | 18 | All |\nGerm cell tumors | 11 | Anterior | Mesenchymal tumors | 9 | All | Thymomas | Rare | Anterior | Q\nLocations of the Common Mediastinal Masses Anterior Mediastinum\n• ThymomaQ (MC in anterior mediastinum)\n• LymphomaQ\n• Germ cell tumorsQ\n• Thyroid & parathyroid massesQ\n• Bronchogenic cystQ\n• AneurysmQ\nMiddle Mediastinum\n• Cysts (MC in middle mediastinum):\n– Pericardial (MC)Q\n– BronchogenicQ\n– Enterogenous\n– NeuroentericQ\n• Vascular masses (aneurysmQ)\n• LN enlargement & lymphomaQ\n• Mesenchymal tumors\n• Pheochromocytoma\nPosterior Mediastinum\nNeurogenic tumors (MC overallQ) MeningocelesQ Mesenchymal tumors Pheochromocytoma LymphomaQ Bochdalek\nherniaQ Bronchogenic cystQ Enterogenous cystQ\nMediastinal Masses\nMC anterior MM: ThymomaQ MC middle MM: CystQ (Pericardial cyst is MCQ) MC posterior MM: Neurogenic tumorsQ\nMC MM (overall): Neurogenic tumorsQ MM seen in all three compartments of mediastinum: Lymphoma,\nbronchogenic cyst & mesenchymal tumorsQ\n• IOC for diagnosis of MM (except neurogenic tumors): CTQ\n• IOC for diagnosis of neurogenic tumors: MRIQ\nAnswer (book): Answer: A. Neurogenic tumor\nReference: Schwartz 11/e p727; Sabiston 20/e p1608"},{"n":67,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 43","pdfPage":23,"stem":"A patient underwent thyroidectomy for hyperthyroidism. Two days later he presented with features of thyroid storm. What is the most likely cause? (AIIMS May 2019, November 2018, November 2015, ComedK 2007)","options":[{"letter":"A","text":"Infection"},{"letter":"B","text":"Inadequate preoperative preparation"},{"letter":"C","text":"Thyroiditis"},{"letter":"D","text":"Rough handling of thyroid at surgery"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Inadequate preoperative preparation","explanation":"Thyrotoxic crisis (storm) is an acute exacerbation of hyperthyroidism. It occurs if a thyrotoxic patient\nhas been inadequately prepared for thyroidectomy.\n“Thyrotoxic crisis (storm): This is an acute exacerbation of hyperthyroidism. It occurs if a thyrotoxic patient has\nbeen inadequately prepared for thyroidectomy and is now extremely rare. Very rarely, a thyrotoxic patient presents\nin a crisis and this may follow an unrelated operation. Symptomatic and supportive treatment is for dehydration,\nhyperpyrexia and restlessness. This requires the administration of intravenous fluids, cooling the patient with ice\npacks, administration of oxygen, diuretics for cardiac failure, digoxin for uncontrolled atrial fibrillation, sedation and\nintravenous hydrocortisone. Specific treatment is by carbimazole 10–20 mg 6-hourly, Lugol’s iodine 10 drops\n8-hourly by mouth or sodium iodide 1g IV. Propranolol intravenously (1–2 mg) or orally (40 mg 6-hourly) will block\nβ-adrenergic effects.”-Bailey 27/e p815\nAnswer (book): Answer: B. Inadequate preoperative preparation\nReference: Bailey 27/e p815; Harrison 20/e p2707; Schwartz 11/e p1662, 10/e p1534; Sabiston 20/e p304"},{"n":68,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 43","pdfPage":23,"stem":"Treatment of choice in a patient with a staghorn calculus with minimal hydronephrosis: (AIIMS May 2019)","options":[{"letter":"A","text":"ESWL"},{"letter":"B","text":"PCNL"},{"letter":"C","text":"URS"},{"letter":"D","text":"Open nephrolithotomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"PCNL","explanation":"Treatment of choice in a patient with a staghorn calculus with minimal hydronephrosis is PCNL.\n“The management of patients with staghorn stones by a combined approach must be viewed as primarily\npercutaneous in nature, with SWL being used only as an adjunct to minimize the number of access points required.\nImproved PNL techniques, incorporating the increasing use of flexible nephroscopy and providing complete or\nnearly complete clearance of stone material at the time of the primary procedure, may have decreased or\neliminated the need for additional SWL treatment.”-Campbell 11/e p1281\n“The procedure of choice for patients with staghorn calculi is PNL. When they are left untreated, staghorn calculi\nare associated with the loss of renal function and increased mortality.”-Campbell 10/e p1374\n“PNL followed by either SWL or repeated PNL, should be used for most patients with struvite staghorn calculi, with\nPNL being the initial element of the combination therapy.”-Campbell 11/e p1286\nRenal Stones Treatment decisions by stone burden Stone size/ Composition\nTreatment of Choice\nStone ≤2 cm\n• ESWLQ\n• Unless factors of stone composition, location, location or renal anatomy shift the balance towards more invasive\nmodalities (PCNL/URS).\nStone >2 cm\n• PCNLQ\nStaghorn calculi\n• PCNL + ESWL is TOCQ\n• Initial approach is PCNL, followed by ESWL, as an adjunct to minimize the number of repeat PCNL accesses.\nAnswer (book): Answer: B. PCNL\nReference: Campbell 11/e p1281, 1286; 10/e p1364, 1374, 1380-1381, 1399-1405; Bailey 27/e p1409"},{"n":69,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 43","pdfPage":23,"stem":"A patient presented to emergency after RTA with multiple rib fractures. He is conscious, speaking single word. On examination, respiratory rate was 40/minute and BP was 90/40 mm Hg and hyper-resonant note on involved side. What is immediate next step? (AIIMS May 2019, November 2018)","options":[{"letter":"A","text":"Urgent IV fluid administration"},{"letter":"B","text":"Intubate the patient"},{"letter":"C","text":"Chest X-ray"},{"letter":"D","text":"Wide bore needle insertion in 2nd intercostal space"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Wide bore needle insertion in 2nd intercostal space","explanation":"History of chest trauma with respiratory rate >40/minute, BP 90/60 mm Hg and hyper-resonant note\non involved side is highly suggestive of tension pneumothorax. Immediate decompression with large bore needle in\nmid clavicular line in 2nd intercostal space is the urgent treatment for this patient.\n“Tension pneumothorax and simple pneumothorax have similar signs, symptoms, and examination findings, but\nhypotension qualifies the pneumothorax as a tension pneumothorax. Although immediate needle thoracostomy\ndecompression with a 14-gauge angiocatheter in the second intercostal space in the midclavicular line may be\nindicated in the field, tube thoracostomy should be performed immediately in the ED before a chest radiograph is\nobtained. Recent studies suggest the preferred location for needle decompression may be the 5th intercostal space\nin the anterior axillary line due to body habitus.”-Schwartz 11/e p186\n“Tension pneumothorax: Treatment consists of immediate decompression, initially by rapid insertion of a\nlarge-bore cannula into the second intercostal space in the mid-clavicular line of the affected side, then followed by\ninsertion of a chest tube through the fifth intercostal space in the anterior axillary line.”-Bailey 27/e p367\nAnswer (book): Answer: D. Wide bore needle insertion in 2nd intercostal space\nReference: Sabiston 20/e p428; Schwartz 11/e p186, 10/e p163; Bailey 27/e p367"},{"n":70,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 43","pdfPage":23,"stem":"After parotidectomy, numbness on the face during shaving is due to damage of: (AIIMS May 2019)","options":[{"letter":"A","text":"Auriculotemporal nerve"},{"letter":"B","text":"Facial nerve"},{"letter":"C","text":"Mandibular nerve"},{"letter":"D","text":"Greater auricular nerve"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Greater auricular nerve","explanation":"After parotidectomy, numbness on the face during shaving is due to damage of greater auricular\nnerve.\n“Complications of parotid gland surgery include: haematoma formation; infection; deformity: unsightly scar and\nretromandibular hollowing; temporary facial nerve weakness; transection of the facial nerve and permanent facial\nweakness; sialocele; facial numbness; permanent numbness of the ear lobe associated with great auricular nerve\ntransection; Frey’s syndrome”-Bailey 27/e p792\nComplications of Parotidectomy\n• Hematoma formation\n• Infection\n• Deformity: unsightly scar & retromandibular hollowing\n• Temporary facial nerve weaknessQ\n• Transection of facial nerve & permanent facial weaknessQ\n• Sialocele\n• Facial numbnessQ\n• Permanent numbness of ear lobe associated with great auricular nerve transectionQ\n• Frey’s syndromeQ\nAnswer (book): Answer: D. Greater auricular nerve\nReference: Bailey 27/e p792"},{"n":71,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 44","pdfPage":23,"stem":"A chronic alcoholic patient came to emergency with severe pain in epigastrium and multiple episodes of vomiting. On examination, guarding was present in upper epigastrium. Chest X-ray was normal. What is the next best step? (AIIMS May 2019)","options":[{"letter":"A","text":"Upper GI endoscopy"},{"letter":"B","text":"Serum lipase"},{"letter":"C","text":"Alcohol breath test"},{"letter":"D","text":"CECT"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Serum lipase","explanation":"Severe pain in epigastrium and multiple episodes of vomiting with guarding in epigastrium in chronic\nalcoholic patient is highly suggestive of acute pancreatitis. The cornerstone of the diagnosis of acute pancreatitis is\nthe clinical findings plus an elevation of pancreatic enzyme levels in the plasma. So the next best step is serum\nlipase, which helps in making the diagnosis.\n“Abdominal pain is the major symptom of acute pancreatitis. Pain may vary from a mild discomfort to severe,\nconstant, and incapacitating distress. Characteristically, the pain, which is steady and boring in character, is\nlocated in the epigastrium and periumbilical region, and may radiate to the back, chest, flanks, and lower\nabdomen. Nausea, vomiting, and abdominal distention due to gastric and intestinal hypomotility and chemical\nperitonitis are also frequent complaints.”-Harrison 20/e p2439\n“Acute pancreatitis: Abdominal tenderness and muscle rigidity are present to a variable degree, but compared with\nthe intense pain, these signs may be less impressive.”-Harrison 20/e p2439\n“Any severe acute pain in the abdomen or back should suggest the possibility of acute pancreatitis. The diagnosis\nis established by two of the following three criteria: (1) typical abdominal pain in the epigastrium that may radiate\nto the back, (2) threefold or greater elevation in serum lipase and/or amylase, and (3) confirmatory findings of\nacute pancreatitis on cross-sectional abdominal imaging. Patients also have associated nausea, emesis, fever,\ntachycardia, and abnormal findings on abdominal examination. Laboratory studies may reveal leukocytosis,\nhypocalcemia, and hyperglycemia.”-Harrison 20/e p2440\n“The cornerstone of the diagnosis of AP is the clinical findings plus an elevation of pancreatic enzyme levels in the\nplasma. A threefold or higher elevation of amylase and lipase levels confirms the diagnosis.”-Sabiston 20/e p1526\nAnswer (book): Answer: B. Serum lipase\nReference: Bailey 27/e p1223; Schwartz 11/e p1444; Sabiston 20/e p1526; Harrison 20/e p2439, 2440"},{"n":72,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 44","pdfPage":23,"stem":"Most common functional neuroendocrine tumor of pancreas: (AIIMS May 2019)","options":[{"letter":"A","text":"Glucagonoma"},{"letter":"B","text":"Gastrinoma"},{"letter":"C","text":"VIPoma"},{"letter":"D","text":"Somatostatinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gastrinoma","explanation":"Most common functional neuroendocrine tumor of pancreas is insulinoma. In the question, insulinoma\nwas not given in the option, so the correct answer would be gastrinoma.\n“Insulinomas are the most common functional pancreatic endocrine neoplasms and present with a typical clinical\nsyndrome known as Whipple’s triad.”-Schwartz 11/e p1480\n“Insulinoma is the most common functioning PNET, with an incidence of 1 to 2 per 1 million population annually in\nthe United States.”-Sabiston 20/e p952\n“Gastrin-secreting PNET (gastrinoma) is the second most common functional pancreatic endocrine tumor, with an\nincidence of 1 per 2.5 million population, and was first described in 1955 by Zollinger and Ellison.”-Sabiston 20/e\np954\nNeuroendocrine Tumors of Pancreas\nMC NET of Pancreas: Non-functional (Mostly malignant)Q MC functional NET of Pancreas: InsulinomaQ MC benign\nNET of Pancreas: InsulinomaQ MC malignant functional NET of Pancreas: GastrinomaQ\nAnswer (book): Answer: B. Gastrinoma\nReference: Bailey 27/e p849; Schwartz 11/e p1480; Sabiston 20/e p952, 954"},{"n":73,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 44","pdfPage":23,"stem":"A 4 years old child was brought to the hospital with right non-palpable testis. During diagnostic laparoscopy for undescended testis, blind testicular vessels were seen. What should be done next? (AIIMS May 2019)","options":[{"letter":"A","text":"Abdominal exploration"},{"letter":"B","text":"Nothing is to be done"},{"letter":"C","text":"Inguinal exploration"},{"letter":"D","text":"Scrotal exploration"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Nothing is to be done","explanation":"Blind-ending testicular vessels during diagnostic laparoscopy is most consistent with an abdominal\nvanishing testis. So, nothing is to be done in this situation.\n“Diagnostic laparoscopy followed by laparoscopic orchidopexy if the testis is abdominal has become the preferred\napproach of many clinicians. Important observations include size and position of the spermatic vessels and vas;\ntesticular size, quality, and position; and patency of the internal inguinal ring. The combination of a closed internal\nring and a blind-ending spermatic artery and vas is most consistent with an abdominal vanishing testis, whereas a\nhernia is frequently but not always associated with a viable abdominal or distal testis.”-Campbell 10/e p3565\nAnswer (book): Answer: B. Nothing is to be done\nReference: Campbell 11/e p3440, 10/e p3565; Bailey 27/e p125"},{"n":74,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 45","pdfPage":23,"stem":"Percentage of surgical site infection in patients with clean contaminated wound after antibiotic prophylaxis? (AIIMS May 2019)","options":[{"letter":"A","text":"1–2%"},{"letter":"B","text":"<10%"},{"letter":"C","text":"10–20%"},{"letter":"D","text":"20–30%"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"<10%","explanation":"Percentage of surgical site infection in patients with clean contaminated wound after antibiotic\nprophylaxis is 10%. Wounds Class\nRisk of Infection\nNeed for Prophylaxis\n• Usually not requiredQ\nClean | 5% | Clean-contaminated | 10% | Contaminated | 20-30%Q\n• RequiredQ\nDirty\n30-40%\n• Treatment requiredQ (not the prophylaxis)\nQ\n• Usually requiredQ\nQ\nQ\nAnswer (book): Answer: B. <10%\nReference: Bailey 27/e p53; Schwartz 11/e p169; Sabiston 20/e p225"},{"n":75,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 45","pdfPage":23,"stem":"Which of the following is not classified as locally advanced breast cancer? (AIIMS May 2019)","options":[{"letter":"A","text":"Tumor >4 cm"},{"letter":"B","text":"Inflammatory breast cancer"},{"letter":"C","text":"Chest wall involvement"},{"letter":"D","text":"Matted axillary lymph node"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tumor >4 cm","explanation":"Tumor >4 cm is not classified as locally advanced breast cancer. Early invasive breast cancer includes\nstage I, IIA, IIB; Locally advanced breast cancer includes stage IIIA, IIIB, IIIC & Distant metastases includes stage IV.\nLocally advanced breast cancer includes T4 (T4a: Extension to chest wall, not including pectoralis muscle; T4d:\ninflammatory breast cancer), N2 (N2a: Metastasis in ipsilateral level I, II axillary LNs fixed or matted) & N3. 8th AJCC\n(2017) TNM Staging for Breast Cancer T: Primary tumor\nN: Regional lymph nodes\nT1: Tumor ≤2 cm\nN1: Metastasis to movable ipsilateral level I, II axillary LNs\nT2: Tumor >2 cm & ≤5 cm\nN2a: Metastasis in ipsilateral level I, II axillary LNs fixed or matted\nT3: Tumor >5 cm\nN2b: Metastasis only in clinically apparent ipsilateral internal T4a: Extension to chest wall, not including pectoralis\nmammary LNs and in the absence of clinically evident axillary LNs metastasis muscle (Note: Clinically apparent is\ndefined as detected by imaging studies T4b: Edema (including Peau d’orange) or ulceration of (excluding\nlymphoscintigraphy) or by clinical examination or grossly skin, or satellite skin nodules confined to the same breast\nvisible pathologically.) T4c: Both T4a & T4b\nN3a: Metastasis in ipsilateral infraclavicular LNs\nT4d: Inflammatory carcinoma\nN3b: Metastasis in ipsilateral internal mammary LNs & axillary LNs\nNote\n• Invasion of dermis alone does not qualify as T4.\n• Chest wall includes ribs, intercostal muscles & serratus anterior but not the pectoral muscles.\n• Dimpling of the skin, nipple retraction, or other skin changes, except those in T4b & T4d, may occur in T1, T2 or\nT3 without affecting the classification.\nN3c: Metastasis in ipsilateral supraclavicular LNs\nStage I | Stage IIA | Stage IIB | Stage IIIA | T1 N0M0 | T0N1 M0 T1N1 M0 T2 N0M0 | T2N1 M0 T3 N0M0 | T0 N2 M0\nT1-2 N2 M0 T3 N1-2 M0\nM: Distant metastases M0: No distant metastasis M1: Distant metastasis\nStage IIIB T4 N0-2 M0 | Stage IIIC | Stage IV | AnyT N3 M0 | AnyT anyN M1\nAnswer (book): Answer: A. Tumor >4 cm\nReference: Schwartz 11/e p576-578"},{"n":77,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 46","pdfPage":23,"stem":"Which of the following is not the component of qSOFA? (AIIMS May 2019)","options":[{"letter":"A","text":"Respiratory rate ≥22/min"},{"letter":"B","text":"Systolic BP ≥100 mm Hg"},{"letter":"C","text":"Altered mental status"},{"letter":"D","text":"Unequally dilated pupils"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Unequally dilated pupils","explanation":"Unequally dilated pupils are not the component of qSOFA.\n“The qSOFA suggests potentially life-threatening sepsis when at least two of the following parameters are met:\naltered mental status, systolic blood pressure of 100 mm Hg or less, and respiratory rate greater than 22\nbreaths/minute.”-Schwartz 11/e p161\nQuick Sequential Organ Failure Assessment (SOFA) Score qSOFA (Quick SOFA) Criteria Points\n• Respiratory rate ≥22/minQ 1\n• Change in mental statusQ 1\n• Systolic BP ≤100 mm HgQ 1 Interpretation Score Mortality 0 <1% 1 2-3% ≥2 ≥10%\nAnswer (book): Answer: D. Unequally dilated pupils\nReference: Schwartz 11/e p161"},{"n":78,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 46","pdfPage":23,"stem":"Which of the following statements are true and false about prostate cancer? (AIIMS May 2019)  [Multiple statements may be correct — mark all true options]","options":[{"letter":"A","text":"Histological grading by Gleason score"},{"letter":"B","text":"Most common region involved is central zone"},{"letter":"C","text":"Most common type of prostate cancer is squamous cell carcinoma"},{"letter":"D","text":"It is a hormone dependent cancer"}],"multi":["A","D"],"correctSet":["A","D"],"answerIdx":0,"answerLetter":"A, D","answerText":"Correct statements: A, D","explanation":"Carcinoma prostate histological grading is done by Gleason score. Most common site is peripheral\nzone. Most common type of prostate cancer is adenocarcinoma. It is a hormone dependent cancer.\n“The Gleason system grades prostate cancer according to the degree of differentiation of the two most prevalent\narchitectural patterns. The final score is the sum of the two grades and can vary from 2 (1+1) to 10 (5+5) with the\nhigher scores indicating poorer prognosis.” -Bailey 27/e p147\n“The peripheral zone is the area from which most prostate cancers arise.”-Bailey 27/e p1457\n“The prostate is a glandular structure consisting of ducts and acini; thus, the histological pattern is one of an\nadenocarcinoma.” -Bailey 27/e p1469\n“Prostate Cancer: Treatment of advanced disease is palliative, and hormone ablation remains the first-line\ntherapy.”-Bailey 27/e p1473\nAnswer (book): Answer: a-T; b-F; c-F; d-T\nReference: Bailey 27/e p147, 1457, 1469, 1473"},{"n":79,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 46","pdfPage":23,"stem":"Which of these scoring systems is helpful in assessing severity of wound infection and is used for research and surveillance? (AIIMS May 2019, November 2016)","options":[{"letter":"A","text":"ASA score"},{"letter":"B","text":"SIRS score"},{"letter":"C","text":"Southampton score"},{"letter":"D","text":"Glasgow score"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Southampton score","explanation":"Southampton grading is used for surgical site infections.\n“The differentiation between major and minor and the definition of surgical site infection (SSI) is important in audit\nor trials of antibiotic prophylaxis. There are scoring systems for the severity of wound infection, which are\nparticularly useful in surveillance and research. Examples are the Southampton and ASEPSIS systems.”-Bailey 27/e\np47\nSouthampton Wound Grading System Grade/Appearance Subtype/Appearance 0: Normal healingQ\nSouthampton Wound Grading System I: Normal healing with mild bruising or erythemaQ\n• Ia: Some bruising\n• Ib: Considerable bruising\n• Ic: Mild erythema II: Erythema plus other signs of inflammationQ\n• IIa: At one point\n• IIb: Around sutures\n• IIc: Along wound\n• IId: Around wound III: Clear or hemoserous dischargeQ\n• IIIa: At one point only (<2 cm)\n• IIIb: Along wound (>2 cm)\n• IIIc: Large volume\n• IIId: Prolonged (>3 days) IV: PusQ\n• IVa: At one point only (<2 cm)\n• IVb: Along wound (>2 cm) V: Deep or severe wound infection with or without tissue breakdown; Hematoma\nrequiring aspirationQ\nAnswer (book): Answer: C. Southampton score\nReference: Bailey 27/e p47"},{"n":80,"chapter":"Recent Questions","src":"question on PDF p. 23 · answer on PDF p. 47","pdfPage":23,"stem":"All of the following are features of SIRS except: (AIIMS May 2019)","options":[{"letter":"A","text":"WBC >12000/mm 3 or <4000/mm 3"},{"letter":"B","text":"Temperature >38 0 C"},{"letter":"C","text":"Pulse rate >90/minute"},{"letter":"D","text":"Respiratory rate >24/minute and PaCO 2 <22 mm Hg"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Respiratory rate >24/minute and PaCO2 <22 mm Hg","explanation":"Respiratory rate >20 breaths/min (not >24/minute) for patients spontaneously ventilating or a PaCO2\n<32 mm Hg (not <22 mm Hg) is included in SIRS.\n“SIRS is defined by the presence of two or more of the following criteria: temperature less than 36° C or greater\nthan 38° C, heart rate greater than 90 beats/min, white blood cell count less than 4000/mm3 or greater than\n12,000/mm3 or band neutrophils greater than 10%, and respiratory rate greater than 20 or arterial carbon dioxide\npressure less than 32 mm Hg.”-Sabiston 20/e p571\nAnswer (book): Answer: D. Respiratory rate >24/minute and PaCO2 <22 mm Hg\nReference: Bailey 27/e p51; Schwartz 11/e p426; Sabiston 20/e p571"},{"n":81,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 47","pdfPage":24,"stem":"Following image of FAST in a trauma patient suggests: (AIIMS May 2019)","options":[{"letter":"A","text":"Positive FAST"},{"letter":"B","text":"Negative FAST"},{"letter":"C","text":"Equivocal FAST"},{"letter":"D","text":"Inconclusive FAST"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Positive FAST","explanation":"In the given image, anechoic fluid is seen between the liver and kidney (the hepatorenal space or\nMorison’s pouch), which is suggestive of hemoperitoneum in a trauma setting. So, FAST is positive in this case.\n“To evaluate the abdomen, the focused abdominal sonography in trauma (FAST) scan is a rapidly obtainable\nultrasound examination that assesses for intraperitoneal fluid. Specifically, the FAST scan assesses the\nhepatorenal, splenorenal, and pelvic spaces for fluid, which is presumed to be blood in the setting of\ntrauma.”-Sabiston 20/e p416\n“FAST is used to identify free intraperitoneal fluid in Morrison’s pouch, the left upper quadrant, and the pelvis.\nAlthough this method is exquisitely sensitive for detecting intraperitoneal fluid of >250 mL, it does not reliably\ndetermine the source of hemorrhage nor grade solid organ injuries. Patients with fluid on FAST examination,\nconsidered a “positive FAST,” who do not have immediate indications for laparotomy and are hemodynamically\nstable undergo CT scanning to quantify their injuries.”-Schwartz 11/e p202\nFluid (Hemorrhage) between Right Kidney & Liver\nFluid (Hemorrhage) between Left Kidney & Spleen\nFluid (Hemorrhage) between in Pelvis\nImage-based question: the picture / video this question refers to is on PDF p. 24 of the source and is not reproduced here.\nAnswer (book): Answer: A. Positive FAST\nReference: Bailey 27/e p372; Schwartz 11/e p202; Sabiston 20/e p416"},{"n":82,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 47","pdfPage":24,"stem":"Which of the following structures is not removed in radical neck dissection? (AIIMS May 2019)","options":[{"letter":"A","text":"Sublingual gland"},{"letter":"B","text":"Submandibular gland"},{"letter":"C","text":"Tail of parotid"},{"letter":"D","text":"Level IIb lymph node"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Sublingual gland","explanation":"Sublingual gland is not removed in radical neck dissection.\n“CLASSICAL RADICAL NECK DISSECTION (CRILE): The classic operation involves resection of the cervical lymphatics\nand lymph nodes and those structures closely associated: the internal jugular vein, the accessory nerve, the\nsubmandibular gland and the sternocleidomastoid muscle. These structures are all removed en bloc and in\ncontinuity with the primary disease if possible. The main disability that follows the operation is weakness and\ndrooping of the shoulder due to paralysis of the trapezius muscle as a consequence of excision of the accessory\nnerve.”-Bailey 27/e p758\n“All modifications of neck dissection are described in relation to the standard RND, which removes nodal levels I\nthrough V and the sternocleidomastoid muscle, internal jugular vein, cranial nerve XI, cervical plexus, and\nsubmandibular gland.” -Sabiston 20/e p794\nRadical Neck Dissection\n• Radical neck dissection described by Crile in 1906. Remove level I-V LNs in the neck & their interconnecting\nlymphatics along with\n• SCMQ\n• Submandibular glandQ\n• Tail of parotid glandQ\n• Internal & external jugular veinsQ\n• Cervical sensory nervesQ\n• Cranial nerve XIQ\nAnswer (book): Answer: A. Sublingual gland\nReference: Bailey 27/e p758; Schwartz 11/e p647; Sabiston 20/e p794"},{"n":83,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 48","pdfPage":24,"stem":"Which of the following is not an etiological factor for head and neck malignancies? (AIIMS May 2019)","options":[{"letter":"A","text":"Betel nut"},{"letter":"B","text":"HPV infection"},{"letter":"C","text":"EBV infection"},{"letter":"D","text":"Vitamin A deficiency"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Vitamin A deficiency","explanation":"Vitamin A deficiency is not an etiological factor for head and neck malignancies.\n“Head and Neck cancer (HNC): For many primary sites, tobacco use is associated with an increased risk. Alcohol\nhas also been implicated as a causative factor; the effects of alcohol and tobacco may be synergistic.”-Devita 11/e\np999\n“In India and Southeast Asia, the product of the areca catechu tree, known as a betel nut, is chewed in a habitual\nmanner and acts as a mild stimulant similar to that of coffee. The nut is chewed in combination with lime and cured\ntobacco as a mixture known as a quid. The long-term use of the betel nut quid can be destructive to oral mucosa\nand dentition and is highly carcinogenic.”-Schwartz 11/e p630\n“Human papillomavirus (HPV) infection (most commonly HPV16) plays a role in the development of certain HNCs,\nparticularly those in the oropharynx.”-Devita 11/e p999\n“There is a longstanding association between Epstein-Barr virus (EBV) and nasopharyngeal cancer.”-Devita 11/e\np999\nTobaccoQ AlcoholQ Areca nut/pan masalaQ Sharp or jagged toothQ\nRisk Factors for Cancer of Oral Cavity\n• Ill-fitting dentures Q\n• Syphilitic glossitisQ\n• Human papilloma virusQ\nEpstein-Barr virusQ Plummer-Vinson syndromeQ Poor nutrition\nAnswer (book): Answer: D. Vitamin A deficiency\nReference: Bailey 27/e p740; Schwartz 11/e p630; Devita 11/e p999"},{"n":84,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 48","pdfPage":24,"stem":"On 5th post-operative day of CABG, patient develops tachypnea and hypertension. What is the most probable cause? (AIIMS May 2019)","options":[{"letter":"A","text":"Acute respiratory failure"},{"letter":"B","text":"Acute renal failure"},{"letter":"C","text":"Sepsis"},{"letter":"D","text":"Acute cardiac failure"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute respiratory failure","explanation":"After CABG, tachypnea is seen in patients because of atelectasis (or acute respiratory failure), whereas\nin patients of acute cardiac failure, there is low blood pressure (hypotension). So, in this patient, who developed\ntachypnea and hypertension after CABG, the most probable cause appears to be acute respiratory failure.\n“Myocardial function typically declines in the first few hours following cardiac surgery, presumably in response to\nan ischaemia/ reperfusion-type injury. Inotropic agents are often required at this time to support the heart function\nand maintain the circulation. Occasionally, the patient develops a persistent low cardiac output state. The clinical\nmanifestations include poor peripheral perfusion, low urine output, a developing metabolic acidosis and low blood\npressure.”-Bailey 27/e p892\nComplications after CABG\n• Myocardial dysfunctionQ\n• Cardiac tamponadeQ\n• Cerebrovascular complicationsQ\n• Respiratory tract infectionsQ\n• Acute renal failureQ\n• Aortic dissectionQ\nAnswer (book): Answer: A. Acute respiratory failure\nReference: Bailey 27/e p892; Sabiston 20/e p1678"},{"n":85,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 48","pdfPage":24,"stem":"Which of the following is true about thyroglossal cyst? (AIIMS May 2019)","options":[{"letter":"A","text":"Secondary infection leads to sinus"},{"letter":"B","text":"40% contains heterotopic thyroid tissue"},{"letter":"C","text":"Resolve spontaneously in 20–30% cases"},{"letter":"D","text":"Lining epithelium is non-ciliary stratified squamous epithelium"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Secondary infection leads to sinus","explanation":"Thyroglossal duct sinuses result from infection of the cyst secondary to spontaneous or surgical\ndrainage of the cyst and are accompanied by minor inflammation of the surrounding skin. It is lined by\npseudostratified ciliated columnar epithelium and squamous epithelium, with heterotopic thyroid tissue present in\n20% of cases.\n“Thyroglossal duct sinuses result from infection of the cyst secondary to spontaneous or surgical drainage of the\ncyst and are accompanied by minor inflammation of the surrounding skin. Histologically, thyroglossal duct cysts are\nlined by pseudostratified ciliated columnar epithelium and squamous epithelium, with heterotopic thyroid tissue\npresent in 20% of cases.”-Schwartz 11/e p1625\nAnswer (book): Answer: A. Secondary infection leads to sinus\nReference: Bailey 27/e p755; Schwartz 11/e p1625; Sabiston 20/e p1861"},{"n":86,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 49","pdfPage":24,"stem":"Most common artery involved in pseudoaneurysm: (AIIMS May 2019)","options":[{"letter":"A","text":"Aorta"},{"letter":"B","text":"Iliac artery"},{"letter":"C","text":"Popliteal artery"},{"letter":"D","text":"Femoral artery"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Femoral artery","explanation":"Michael W. Mulholland/p 359\nMost common artery involved in pseudoaneurysm among the given options is femoral artery because\nfemoral artery is most commonly punctured vessel among the given options for diagnostic and therapeutic purposes.\nMost common anatomic factor associated with pseudoaneurysm formation is aberrant puncture.\n“Pseudoaneurysm formation is the most commonly reported adverse sequela of blood draws from arteries and\nveins.”-Current Therapy in Vascular and Endovascular Surgery by James C. Stanley 5/e p704\n“The most common anatomic factor associated with femoral pseudoaneurysm formation is aberrant puncture,\nentering the vessel in either the external iliac artery or superficial femoral artery.”-Complications in Surgery by\nMichael W. Mulholland/p 359\nAnswer (book): Answer: D. Femoral artery\nReference: Current Therapy in Vascular and Endovascular Surgery by James C. Stanley 5/e p704; Complications in Surgery by"},{"n":87,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 49","pdfPage":24,"stem":"Identify the name of diseases shown below: (AIIMS May 2019)","options":[{"letter":"A","text":"Paget’s disease"},{"letter":"B","text":"Mondor’s disease"},{"letter":"C","text":"Teitze syndrome"},{"letter":"D","text":"Red manhood"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mondor’s disease","explanation":"In the given image, there is a cord like structure in the breast, known as string phlebitis also known as\nMondor’s disease.\n“Mondor’s disease is a variant of thrombophlebitis that involves the superficial veins of the anterior chest wall and\nbreast. In 1939, Mondor described the condition as “string phlebitis,” a thrombosed vein presenting as a tender,\ncord-like structure. Frequently involved veins include the lateral thoracic vein, the thoracoepigastric vein, and, less\ncommonly, the superficial epigastric vein. Typically, a woman presents with acute pain in the lateral aspect of the\nbreast or the anterior chest wall. A tender, firm cord is found to follow the distribution of one of the major\nsuperficial veins.”-Schwartz 11/e p550\nImage-based question: the picture / video this question refers to is on PDF p. 24 of the source and is not reproduced here.\nAnswer (book): Answer: B. Mondor’s disease\nReference: Bailey 27/e p867; Schwartz 11/e p550; Sabiston 20/e p1603"},{"n":88,"chapter":"Recent Questions","src":"question on PDF p. 24 · answer on PDF p. 49","pdfPage":24,"stem":"Which of the following is not a topical haemostatic agent? (AIIMS May 2019)","options":[{"letter":"A","text":"Zeolite"},{"letter":"B","text":"Chitosan"},{"letter":"C","text":"Boric acid"},{"letter":"D","text":"Kaolin"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Boric acid","explanation":"Boric acid is not a topical haemostatic agent. Zeolite, chitosan & kaolin are components of topical\nhaemostatic agents.\n“Mineral Zeolite: The mineral zeolite, QuickClot® is comprised of a kaolin impregnated polyester gauze. When\nkaolin contacts the blood it immediately initiates the clotting process by transforming Factor XII to its activated\nform. The active form of Factor XII then activates Factor XI and pre-kallikrien. Factor XII is capable of activating\npre-kallikrien without kaolin but, in the presence of kaolin the activation is markedly enhanced. It is the activation\nof Factor XI and Factor XII that subsequently leads to the activation of the rest of the coagulation cascade. A clot is\nformed that can be left in place for up to 24 h and then painlessly removed.”-https://\nwww.ncbi.nlm.nih.gov/pmc/articles/PMC3752468/\n“Chitin and Chitosan Dressings: Chitosan is the deacylated form of chitin, an organic polymer derived from shrimp\nand crab exoskeletons. Chitosan and chitin are believed to have hemostatics capabilities. Chitosan dressings work\nby adhering to tissue and sealing wounds.”-https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3752468/\nTopical Hemostatic Agents\n• Important role in helping to facilitate surgical hemostasis.\n• Absorbable agents: Gelatin foams (Gelfoam), oxidized cellulose (Surgicel) & Microfibrillar collagens (Avitene)\n• Biologic agents: Topical thrombin, fibrin sealants (FloSeal) & platelet sealant (Vitagel). Structural Composition of\nMost Commonly Used Hemostatic Agents QuickClot\n• Composed of manufactured granular mineral zeolite, composed of oxides of silicon, sodium, aluminum and\nmagnesium & small amount of quartz.\nCelox\n• Composed of chitosan granule that promotes clot formation through adsorption & dehydration, & advancement of\nRBCs bonding.\nmRDH\n• Composed of poly N-acetyl glucosamine (pGlcNAc) nanofiber material.\n• mRDH causes vasoconstriction, platelet activation & RBC aggregation.\nTraumaStat\n• Composed of chitosan, silica & polyethylene\n• Trauma Stat dressing covers a much greater surface area than is currently possible with other chitosan dressings\nor gauzes.\nHem Con Bandage\n• Lyophilized chitosan derivative\nWound Stat\n• Composed of smectite granules, and is considered to stop bleeding by means of granules that absorb water,\nswelling & forming a clay substance with high plasticity that adheres to the tissue & seals the sites of\nhemorrhage.\n238 MCQs · questions on PDF pp. 125–135 · answers and explanations on PDF pp. 136–148\nAnswer (book): Answer: C. Boric acid\nReference: https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3752468/"},{"n":1,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Blood stained nipple discharge is seen in: (Recent Question 2017, DNB 2013, 2011, Orissa 2011, PGI June 2009, UPPG 2010, AIIMS Nov 2003, All India 2005)","options":[{"letter":"A","text":"Breast abscess"},{"letter":"B","text":"Fibroadenoma"},{"letter":"C","text":"Ductal papilloma"},{"letter":"D","text":"Fat necrosis of breast"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Ductal papilloma","explanation":"• MC cause of greenish discharge: Duct ectasiaQ\n• MC cause of blood-stained discharge: Duct papillomaQ\nAnswer (book): Answer: C. Ductal papilloma\nReference: Schwartz 10/e p554, 9/e p467; Sabiston 20/e p824-826; 19/e p828; Bailey 27/e p863, 26/e p802"},{"n":2,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Green discharge is most commonly seen with: (Recent Question 2016, Kerala PG 2015, WBPG 2015, AIIMS Nov 98)","options":[{"letter":"A","text":"Duct papilloma"},{"letter":"B","text":"Duct ectasia"},{"letter":"C","text":"Retention cyst"},{"letter":"D","text":"Fibroadenosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Duct ectasia.","explanation":"b. Duct ectasia."},{"n":3,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"A 25 years old female complains of discharge of blood from a single duct in her breast. The most appropriate treatment is: (All India 2008)","options":[{"letter":"A","text":"Radical excision"},{"letter":"B","text":"Microdochectomy"},{"letter":"C","text":"Radical mastectomy"},{"letter":"D","text":"Biopsy to rule out carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Microdochectomy","explanation":"b. Microdochectomy (Ref: Bailey 27/e p863, 26/e p802; CSDT 12/e p299; Schwartz 10/e p526, 9/e p448)"},{"n":4,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"True statement (s) about nipple discharge is/are: (PGI June 2004)","options":[{"letter":"A","text":"Mammography"},{"letter":"B","text":"Cone excision done in single intraductal tumour"},{"letter":"C","text":"Mammography done when duct papilloma is <4.5cm"},{"letter":"D","text":"Red discharge indicate malignancy"},{"letter":"E","text":"Blue-black discharge indicate duct ectasia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Mammography, B. Cone excision done in single intraductal tumour, D. Red discharge indicate","explanation":"a. Mammography, b. Cone excision done in single intraductal tumour, d. Red discharge indicate malignancy, e. Blue-black\ndischarge indicate duct ectasia"},{"n":5,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"A 25 years old lady presents with spontaneous nipple discharge of 3-months duration. On examination the discharge is bloody and from a single duct. The following statements about management of this patient are true except: (AIIMS Nov 2004)","options":[{"letter":"A","text":"Ultrasound can be a useful investigation"},{"letter":"B","text":"Radical duct excision is the operation of choice"},{"letter":"C","text":"Galactogram, though useful, is not essential"},{"letter":"D","text":"Majority of blood stained nipple discharges are due to papillomas or other benign condition"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Radical duct excision is the operation of choice.","explanation":"b. Radical duct excision is the operation of choice."},{"n":6,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Triple assessment for CA Breast includes: (Kerala PG 2015) (DNB 2010, All India 2009)","options":[{"letter":"A","text":"History, clinical examination and mammogram"},{"letter":"B","text":"History, clinical examination and FNAC"},{"letter":"C","text":"USG, mammogram and FNAC"},{"letter":"D","text":"Clinical examination, mammogram and FNAC"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Clinical examination, Mammogram and FNAC","explanation":"• Triple Assessment includes a combination of clinical assessment, radiological imaging (USG/ Mammography) and\ntissue sample analysis (FNAC/Biopsy)Q\n• The positive predictive value of Triple Assessment should exceed 99.9%Q\nAnswer (book): Answer: D. Clinical examination, Mammogram and FNAC\nReference: Schwartz 10/e p522-523, 9/e p444-446; Sabiston 20/e p826-828; 19/e p840-842; Bailey 27/e p863, 26/e p799-801"},{"n":7,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Best diagnostic method for breast lump is: (AIIMS June 95)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"Mammogram"},{"letter":"C","text":"Biopsy"},{"letter":"D","text":"FNAC"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Biopsy","explanation":"CA Breast\n• First investigation for tissue sampling: FNACQ\n• Best and diagnostic investigation: BiopsyQ\nAnswer (book): Answer: C. Biopsy\nReference: Schwartz 10/e p529-530, 9/e p450; Sabiston 20/e p826-828; 19/e p830-831; Bailey 27/e p862, 26/e p800"},{"n":8,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"A 45-years old woman presents with a hard and mobile lump in the breast. Next investigation is: (All India 2001)","options":[{"letter":"A","text":"FNAC"},{"letter":"B","text":"USG"},{"letter":"C","text":"Mammography"},{"letter":"D","text":"Excision biopsy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mammography","explanation":"• First investigation: Mammography\n• Best and diagnostic investigation: BiopsyQ\nMammography Ultrasound MRI PET scan\nInvestigations in CA Breast Initial investigation for symptomatic breast in women >35 years and for screeningQ IOC\nfor microcalcificationQ Initial investigation for palpable lesions in women <35 yearsQ Not useful in screening\nIndicated in scarred breast, implants and borderline lesions for breast conservation IOC for implant related\ncomplicationsQ Gold standard for imaging breast in females with implantsQ IOC for detecting recurrences in scarred\nbreastQ Useful in multifocal disease and in helping detect axillary involvement\nAnswer (book): Answer: C. Mammography\nReference: Schwartz 10/e p523-529, 9/e p447-450; Sabiston 20/e p826-827; 19/e p830-832; Bailey 27/e p861, 26/e p799-801"},{"n":9,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"A female patient present with a hard mobile lump in her right breast. Which investigation would be most helpful in making the diagnosis? (AIIMS Nov 2001)","options":[{"letter":"A","text":"FNAC"},{"letter":"B","text":"Needle biopsy"},{"letter":"C","text":"Excision biopsy"},{"letter":"D","text":"Mammography"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Needle biopsy","explanation":"b. Needle biopsy"},{"n":10,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Investigation of choice for high risk breast cancer in female is: (DNB 2014)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"CT-PET"},{"letter":"C","text":"Mammography"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MRI","explanation":"a. MRI"},{"n":11,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Gold standard investigation for screening of breast carcinoma in patients with breast implant: (Recent Question 2015)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"USG"},{"letter":"C","text":"Mammography"},{"letter":"D","text":"CT Scan"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MRI","explanation":"a. MRI"},{"n":12,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"A 60-year-old lady comes with blood stained discharge from the nipple with family history of breast cancer. Next best step for her will be: (AIIMS May 2015)","options":[{"letter":"A","text":"Ductoscopy"},{"letter":"B","text":"Sono-mammogram"},{"letter":"C","text":"Nipple discharge cytology"},{"letter":"D","text":"MRI"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"MRI","explanation":"p799-801\nA 60-year-old lady comes with blood stained discharge from the nipple with family history of breast\ncancer. Next best step for her (high risk female) will be MRI for screening of breast cancer.\n“There is current interest in the use of MRI to screen the breasts of high-risk women and of women with a newly\ndiagnosed breast cancer. In the first case, women who have a strong family history of breast cancer or who carry\nknown genetic mutations require screening at an early age, but mammographic evaluation is limited because of\nthe increased breast density in younger women. In the second case, an MRI study of the contralateral breast in\nwomen with a known breast cancer has shown a contralateral breast cancer in 5.7% of these women.”- Schwartz\n10/e p527, 9/e p450\nAnswer (book): Answer: D. MRI\nReference: Schwartz 10/e p527, 9/e p447-450; Harrison 20/e p557,19/e p526; Sabiston 20/e 828; 19/e p830-832; Bailey 26/e"},{"n":13,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"Best investigation to differentiate scar from recurrence after mastectomy done for carcinoma breast: (Recent Question 2016)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"CT"},{"letter":"C","text":"PET scan"},{"letter":"D","text":"Mammography"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"PET scan","explanation":"c. PET scan"},{"n":14,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 136","pdfPage":125,"stem":"All of the following are indications for MRI in breast carcinoma except: (Recent Question 2017)","options":[{"letter":"A","text":"Microcalcification"},{"letter":"B","text":"High-risk cases"},{"letter":"C","text":"Breast-implant patients"},{"letter":"D","text":"Lobular carcinoma in situ"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Microcalcification","explanation":"a. Microcalcification (Ref: Schwartz 10/e p527; Sabiston 20/e p828; Bailey 27/e p862)\nExplanations"},{"n":15,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"What is the sensitivity of axillary ultrasound in identifying axillary metastases in clinically node negative carcinoma breast? (AIIMS May 2017)","options":[{"letter":"A","text":"10–20%"},{"letter":"B","text":"20–30%"},{"letter":"C","text":"30–40%"},{"letter":"D","text":"55–60%"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"55–60%","explanation":"d. 55–60% (Ref: Schwartz 10/e p527; De Vita 10/e p1122)\n“The status of the regional lymph nodes is one of the most important prognostic factors in early stage breast cancer. Ultrasound\nmay add to clinical examination and improve the sensitivity of node detection (combined sensitivity ranges from 60–80% in\nvarious trials, as it is based on subjective findings and operator dependence), but surgical staging using US guided FNA or SLNB/ALND is\nrequired for all patients.”-De Vita 10/e p1122\nMAMMOGRAPHY"},{"n":16,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"Most sensitive imaging for ductal carcinoma in situ of breast is: (AIIMS Nov 2010)","options":[{"letter":"A","text":"Mammography"},{"letter":"B","text":"MRI"},{"letter":"C","text":"PET"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"MRI","explanation":"• Screening with MRI is superior to mammography in detecting invasive breast cancer in younger womenQ, where\nthe sensitivity of mammography is low due to presence of mammographically dense breast parenchymaQ\n“The status of the regional lymph nodes is one of the most important prognostic factors in early stage breast\ncancer. Ultrasound may add to clinical examination and improve the sensitivity of node detection (combined\nsensitivity ranges from 60–80% in various trials, as it is based on subjective findings and operator dependence), but\nsurgical staging using US guided FNA or SLNB/ALND is required for all patients.”-De Vita 10/e p1122\nAnswer (book): Answer: B. MRI\nReference: Grainger 5/e p1190, 1188"},{"n":17,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"Dose of radiation per study in mammography: (Recent Question 2016)","options":[{"letter":"A","text":"0.1cGy"},{"letter":"B","text":"0.2"},{"letter":"C","text":"0.3"},{"letter":"D","text":"0.4"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"0.1cGy","explanation":"a. 0.1cGy"},{"n":18,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"True about screening mammography: (PGI June 2004)","options":[{"letter":"A","text":"Indicated in 50–70 years of age"},{"letter":"B","text":"Mortality reduced by 30%"},{"letter":"C","text":"Radiation due to mammography can cause carcinoma"},{"letter":"D","text":"MRI is better than mammography"},{"letter":"E","text":"USG is better than mammography"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Indicated in 50–70 years of age, B. Mortality reduced by 30%","explanation":"a. Indicated in 50–70 years of age, b. Mortality reduced by 30% (Ref: Schwartz 10/e p523-525, 9/e p447; Sabiston 20/e p828; 19/e p831-832;\nBailey 27/e p861, 26/e p799)"},{"n":19,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"On mammogram all of the following are the features of a malignant tumor except: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Spiculation"},{"letter":"B","text":"Microcalcification"},{"letter":"C","text":"Macrocalcification"},{"letter":"D","text":"Irregular mass"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Macrocalcification","explanation":"c. Macrocalcification (Ref: Schwartz 10/e p523-525, 9/e p447; Sabiston 20/e p828, 19/e p831-832; Bailey 27/e p861, 26/e p799)"},{"n":20,"chapter":"Breast","src":"question on PDF p. 125 · answer on PDF p. 137","pdfPage":125,"stem":"BIRADS stands for: (AIIMS Nov 2012)","options":[{"letter":"A","text":"Breast Imaging Reporting and Data System"},{"letter":"B","text":"Best Imaging Reporting and Data System"},{"letter":"C","text":"Brain Imaging Reporting and Data System"},{"letter":"D","text":"Best Imaging Reporting and Data System"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Breast Imaging Reporting and Data System","explanation":"a. Breast Imaging Reporting and Data System (Ref: Sabiston 20/e p831, 19/e p834)"},{"n":21,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"All are indicators of malignancy in a mammography except: (PGI Dec 99)","options":[{"letter":"A","text":"Nodular calcification"},{"letter":"B","text":"Speckled margin"},{"letter":"C","text":"Attenuated architecture"},{"letter":"D","text":"Irregular mass"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nodular calcification","explanation":"a. Nodular calcification"},{"n":22,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Popcorn calcification in mammography is seen in: (Recent Question 2016, AIIMS June 2000)","options":[{"letter":"A","text":"Fibroadenoma"},{"letter":"B","text":"Fat necrosis"},{"letter":"C","text":"Cystosarcoma phyllodes"},{"letter":"D","text":"CA Breast"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Fibroadenoma","explanation":"Carcinoma\nPattern of Calcification in Breast Diseases Microcalcification, punctate, branchingQ\nFibroadenoma | PopcornQ (coarse, granular, crushed stone) | Fibrocystic disease | Powdery | Fat necrosis |\nCurvilinear\nAnswer (book): Answer: A. Fibroadenoma\nReference: Robbins 9/e p1069"},{"n":23,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"A 55-year-old post menopausal woman, on hormone replacement therapy (HRT), presents with heaviness in both breasts. A screening mammogram reveals a high density speculated mass with cluster of pleomorphic microcalcification and ipsilateral large axillary lymph nodes. The mass described here most likely represents: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Cystosarcoma phyllodes"},{"letter":"B","text":"Lymphoma"},{"letter":"C","text":"Fibroadenoma"},{"letter":"D","text":"Carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Carcinoma","explanation":"d. Carcinoma"},{"n":24,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"With reference to mammography, which one of the following statements is correct? (UPSC 2005)","options":[{"letter":"A","text":"A baseline study should be done for all women at age 30"},{"letter":"B","text":"It uses less radiation energy than a chest X-ray"},{"letter":"C","text":"It should be part of the regular follow up of a woman following therapy for unilateral breast cancer"},{"letter":"D","text":"It provides an effective substitute for biopsy of suspicious lesions"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"It should be part of the regular follow-up of a woman following therapy for unilateral breast cancer","explanation":"c. It should be part of the regular follow-up of a woman following therapy for unilateral breast cancer"},{"n":25,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"What is the age of routine screening mammography? (DNB 2014)","options":[{"letter":"A","text":"20 years"},{"letter":"B","text":"30 years"},{"letter":"C","text":"40 years"},{"letter":"D","text":"50 years"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"40 years","explanation":"c. 40 years"},{"n":26,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"BIRADS score 4 suggests: (Recent Question 2018)","options":[{"letter":"A","text":"Normal lesion"},{"letter":"B","text":"Suspicion of malignancy"},{"letter":"C","text":"Mostly benign"},{"letter":"D","text":"Proven malignancy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Suspicion of malignancy","explanation":"b. Suspicion of malignancy (Ref: Sabiston 20/e p831)"},{"n":27,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"BIRADS score 5 is: (Recent Question 2015)","options":[{"letter":"A","text":"Negative"},{"letter":"B","text":"Probably benign"},{"letter":"C","text":"Suspicious abnormality"},{"letter":"D","text":"Highly suggestive of malignancy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Highly suggestive of malignancy","explanation":"d. Highly suggestive of malignancy"},{"n":28,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Risk of malignancy in BIRADS II: (Recent Question 2017)","options":[{"letter":"A","text":"0–2%"},{"letter":"B","text":"2–4%"},{"letter":"C","text":"10%"},{"letter":"D","text":"50%"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"0–2%","explanation":"Intraductal papilloma | No increased risk | Florid hyperplasia | 1.5 to 2-fold Q | Atypical lobular\nhyperplasia | 4–fold | Atypical ductal hyperplasiaQ | 4–fold\nDuctal involvement by cells of atypical ductal hyperplasia\n7–fold | Lobular carcinoma in situQ | 10–fold | Ductal carcinoma in situQ | 10–fold | Q\nAnswer (book): Answer: A. 0–2%\nReference: Sabiston 20/e p831"},{"n":29,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Radiation dose in mammography: (Recent Question 2017)","options":[{"letter":"A","text":"0.1 Gray/study"},{"letter":"B","text":"0.01 cGray/study"},{"letter":"C","text":"0.1 cGray/study"},{"letter":"D","text":"0.01 Gray/study"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"0.1 cGray/study","explanation":"c. 0.1 cGray/study (Ref: Schwartz 10/e p523; Sabiston 20/e p828; Bailey 27/e p861)"},{"n":30,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Which of the following is seen in carcinoma breast? (Recent Question 2017)","options":[{"letter":"A","text":"Powdery calcification"},{"letter":"B","text":"Popcorn calcification"},{"letter":"C","text":"Nodular calcification"},{"letter":"D","text":"Pleomorphic calcification"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pleomorphic calcification","explanation":"d. Pleomorphic calcification (Ref: Schwartz 10/e p526; Sabiston 20/e p828)"},{"n":31,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Risk factor for carcinoma breast: (PGI Nov 2011, Nov 2010)","options":[{"letter":"A","text":"Nulliparity"},{"letter":"B","text":"OCP"},{"letter":"C","text":"Family history"},{"letter":"D","text":"BRCA-1 mutation"},{"letter":"E","text":"Estrogen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nulliparity, C. Family history, D. BRCA-1 mutation, E. Estrogen","explanation":"a. Nulliparity, c. Family history, d. BRCA-1 mutation, e. Estrogen (Ref: Schwartz 10/e p511-512, Sabiston 20/e p831, Bailey 27/e p871)"},{"n":32,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Which of the following is a predisposing factor for carcinoma of breast? (MHSSMCET 2005)","options":[{"letter":"A","text":"Sclerosing adenosis"},{"letter":"B","text":"Epithelial hyperplasia"},{"letter":"C","text":"Fibrocystic disease of breast"},{"letter":"D","text":"Fibroadenoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Epithelial hyperplasia","explanation":"Proliferative Lesions Relative Risks for Developing Invasive Breast Cancer\n• Nonproliferative changes: 70%\n• Adenosis\n• Relative Risk = 1.0\n• Cysts and apocrine change\n• Ductal ectasia\n• Mild epithelial hyperplasia of usual type\n• Proliferative disease without atypia:\n• Hyperplasia of usual type, moderate or florid 26%\n• Papilloma\n• Relative Risk = 1.5–2.0\n• Sclerosing adenosis\n• Proliferative disease with atypia: 4%\n• Atypical ductal hyperplasiaQ\n• Relative Risk = 4–5\n• Atypical lobular hyperplasiaQ\nAnswer (book): Answer: B. Epithelial hyperplasia\nReference: Schwartz 10/e p508, Sabiston 20/e p832, Bailey 27/e p871"},{"n":33,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 137","pdfPage":126,"stem":"Following condition has no increased risk of invasive breast carcinoma except: (MHCET 2016)","options":[{"letter":"A","text":"Hyperplasia atypical"},{"letter":"B","text":"Sclerosing adenosis"},{"letter":"C","text":"Apocrine metaplagia"},{"letter":"D","text":"Duct ectasia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hyperplasia atypical","explanation":"Cancer Risk Associated (with Benign Breast Disorders and In Situ Carcinoma of the Breast) Abnormality\nRelative Risk | Nonproliferative lesions of the breast | No increased risk | Sclerosing adenosis | No increased risk\nAnswer (book): Answer: A. Hyperplasia atypical\nReference: Schwartz 10/e p508, Sabiston 20/e p832, Bailey 26/e p809"},{"n":34,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Moderately increased risk for invasive breast carcinoma is associated with which of the following? (DNB 2010, Kerala 2000)","options":[{"letter":"A","text":"Sclerosing adenoma"},{"letter":"B","text":"Apocrine metaplasia"},{"letter":"C","text":"Duct ectasia"},{"letter":"D","text":"Atypical ductal hyperplasia"},{"letter":"E","text":"Fibro adenoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Atypical ductal hyperplasia","explanation":"d. Atypical ductal hyperplasia"},{"n":35,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"All of the following are predisposing factors for breast carcinoma except: (DNB 2008, MCI Sept 2008)","options":[{"letter":"A","text":"Family history of breast carcinoma"},{"letter":"B","text":"First child at a younger age"},{"letter":"C","text":"Early menarche and late menopause"},{"letter":"D","text":"Nulliparous women"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"First child at a younger age","explanation":"b. First child at a younger age"},{"n":36,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"BRCA-1 positive woman have ______% increased risk of breast carcinoma: (JIPMER 2011)","options":[{"letter":"A","text":"10"},{"letter":"B","text":"20"},{"letter":"C","text":"40"},{"letter":"D","text":"60"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"60","explanation":"p754-755; Devita 9/e p1373\n\n• Harrison says “Women who inherit a mutated allele of BRCA-1 gene from either parent have at least a 60–80%\nlifetime chance of developing breast cancer and about a 33% chance of developing ovarian cancer.”\n• Schwartz says “Germline mutations in BRCA1 represent a predisposing genetic factor in as many as 45% of\nhereditary breast cancers and in at least 80% of hereditary ovarian cancers. Female mutation carriers have up to\na 90% lifetime risk for developing breast cancer and up to a 40% lifetime risk for developing ovarian cancer.”\nAnswer (book): Answer: D. 60\nReference: Schwartz 10/e p514-515; Sabiston 20/e p832; Bailey 26/e p817-818; Harrison 20/e p556, 19/e p523-524, 18/e"},{"n":37,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Gail model of risk assessment is used for: (Recent Question 2013)","options":[{"letter":"A","text":"CA stomach"},{"letter":"B","text":"CA esophagus"},{"letter":"C","text":"CA breast"},{"letter":"D","text":"CA prostate"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"CA breast","explanation":"c. CA breast"},{"n":38,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Which of the following cancer is least associated with genetic and familial cause? (DNB 2008)","options":[{"letter":"A","text":"Ovarian"},{"letter":"B","text":"Prostate"},{"letter":"C","text":"Lung"},{"letter":"D","text":"Breast"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lung","explanation":"c. Lung"},{"n":39,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Least risk of CA breast is seen in: (AIIMS Nov 2006)","options":[{"letter":"A","text":"BRCA-1"},{"letter":"B","text":"BRCA-2"},{"letter":"C","text":"Li-Fraumeni syndrome"},{"letter":"D","text":"Ataxia telangiectasia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ataxia telangiectasia","explanation":"Incidence of Sporadic, Familial and Hereditary Breast Cancer\n• Sporadic breast cancerQ\n65–75%\n• Familial breast cancerQ\n20–30%\nHereditary breast cancer BRCA1Q BRCA2Q p53 (Li-Fraumeni syndrome)Q STK11/LKB1a (Peutz-Jeghers syndrome)Q\nPTENa (Cowden disease)Q MSH2/MLH1a (Muir-Torre syndrome)Q ATMa (Ataxia-telangiectasia)Q Unknown\n5–10% 45% 35% 1% <1% <1% <1% <1% 20%\nHereditary Breast Cancer\n• BRCA and PLACH: PJS, Li-Fraumeni, Ataxia telangiectasia, Cowden’s, HNPCC\nAnswer (book): Answer: D. Ataxia telangiectasia\nReference: Schwartz 10/e p514-515; Sabiston 20/e p832; Bailey 26/e p817"},{"n":40,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"BRCA-1 gene is associated with: (DPG 2008)","options":[{"letter":"A","text":"Ductal carcinoma"},{"letter":"B","text":"Lobular carcinoma"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Colloid carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ductal carcinoma","explanation":"a. Ductal carcinoma (Ref: Schwartz 10/e p514-515; Sabiston 20/e p832; Bailey 27/e p880)"},{"n":41,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Type of fibroadenosis most likely to undergo malignant change is: (AIIMS June 93)","options":[{"letter":"A","text":"Adenosis"},{"letter":"B","text":"Epitheliosis"},{"letter":"C","text":"Sclerosing adenosis"},{"letter":"D","text":"Cystic"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Epitheliosis","explanation":"b. Epitheliosis"},{"n":42,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Doesn’t lead to carcinoma breast: (DPG 2006)","options":[{"letter":"A","text":"Sclerosing adenosis"},{"letter":"B","text":"Epithelial hyperplasia"},{"letter":"C","text":"Fibrocystic change"},{"letter":"D","text":"Papillomatosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Fibrocystic change","explanation":"• Fibrocystic change doesn’t lead to carcinoma breast.\n• Robbins says “Fibrocystic changes (Non-proliferative breast changes): Non-proliferative changes are most likely\npart of the spectrum of histologic features that can be observed in normal breast.”\nAnswer (book): Answer: C. Fibrocystic change\nReference: Robbins 9/e p1048"},{"n":43,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Which of the following is an increased risk of breast cancer? (PGI Dec 2005)","options":[{"letter":"A","text":"Sclerosing adenosis"},{"letter":"B","text":"Atypical hyperplasia"},{"letter":"C","text":"Fibroadenoma"},{"letter":"D","text":"Florid hyperplasia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Atypical hyperplasia, D. Florid hyperplasia","explanation":"b. Atypical hyperplasia, d. Florid hyperplasia"},{"n":44,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"BRCA-1 gene is located on which chromosome? (MHCET 2016)","options":[{"letter":"A","text":"11"},{"letter":"B","text":"13"},{"letter":"C","text":"17"},{"letter":"D","text":"22"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"17","explanation":"c. 17"},{"n":45,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"BRCA-2 gene is located on chromosome: (Recent Question 2017)","options":[{"letter":"A","text":"17"},{"letter":"B","text":"13"},{"letter":"C","text":"7"},{"letter":"D","text":"11"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"13","explanation":"b. 13 (Ref: Schwartz 10/e p515; Sabiston 20/e p832; Bailey 27/e p880)"},{"n":46,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"All of the following are true about tumors associated with BRCA-1 except: (Recent Question 2017)","options":[{"letter":"A","text":"Hormone receptor positive"},{"letter":"B","text":"Poorly differentiated"},{"letter":"C","text":"Chromosome 17"},{"letter":"D","text":"Early age onset"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hormone receptor positive","explanation":"a. Hormone receptor positive (Ref: Schwartz 10/e p514; Sabiston 20/e p832; Bailey 27/e p880)"},{"n":47,"chapter":"Breast","src":"question on PDF p. 126 · answer on PDF p. 138","pdfPage":126,"stem":"Which of the following is the most significant risk factor for developing breast cancer is? (Karnataka 96)","options":[{"letter":"A","text":"The presence of sclerosing adenosis"},{"letter":"B","text":"Nullipartiy"},{"letter":"C","text":"Atypical lobular hyperplasia"},{"letter":"D","text":"Atypical ductal hyperplasia"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Atypical lobular hyperplasia, D. Atypical ductal hyperplasia","explanation":"c. Atypical lobular hyperplasia, d. Atypical ductal hyperplasia"},{"n":48,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 138","pdfPage":127,"stem":"All the following are risk factors for development of carcinoma breast except: (APPG 2016)","options":[{"letter":"A","text":"BRCA 1 gene mutation"},{"letter":"B","text":"Multiparity & prolonged lactation"},{"letter":"C","text":"History of contralateral breast carcinoma"},{"letter":"D","text":"Early age of menarche and multiparity"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Multiparity & prolonged lactation","explanation":"b. Multiparity & prolonged lactation"},{"n":49,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 138","pdfPage":127,"stem":"All are risk factors for carcinoma breast except: (Recent Question 2013)","options":[{"letter":"A","text":"Early menarche"},{"letter":"B","text":"Late menopause"},{"letter":"C","text":"Ovarian cancer"},{"letter":"D","text":"Early full term pregnancy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Early full term pregnancy","explanation":"d. Early full term pregnancy"},{"n":50,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 138","pdfPage":127,"stem":"% of malignancy in duct ectasia is: (Recent Question 2015)","options":[{"letter":"A","text":"No risk"},{"letter":"B","text":"15:1"},{"letter":"C","text":"7:1"},{"letter":"D","text":"10:1"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"No risk","explanation":"a. No risk"},{"n":51,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 138","pdfPage":127,"stem":"Premalignant lesion with high-risk for malignancy: (Recent Question 2017)","options":[{"letter":"A","text":"Atypical ductal hyperplasia"},{"letter":"B","text":"Sclerosing adenosis"},{"letter":"C","text":"Duct ectasia"},{"letter":"D","text":"Papilloma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Atypical ductal hyperplasia","explanation":"a. Atypical ductal hyperplasia (Ref: Schwartz 10/e p508; Sabiston 20/e p831; Bailey 27/e p871)"},{"n":52,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"In which of the following types of carcinoma breast, comedo growth pattern is seen?","options":[{"letter":"A","text":"Ductal carcinoma in-situ"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Lobular carcinoma in-situ"},{"letter":"D","text":"Infiltrating lobular carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ductal carcinoma in-situ","explanation":"a. Ductal carcinoma in-situ (Ref: Schwartz 10/e p520; Sabiston 20/e p837; Bailey 27/e p872)"},{"n":53,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"False about lobular carcinoma breast is: (DNB 2008)","options":[{"letter":"A","text":"Present as breast mass"},{"letter":"B","text":"Frequently bilateral"},{"letter":"C","text":"Poor prognosis"},{"letter":"D","text":"Multicentric"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Poor prognosis","explanation":"c. Poor prognosis"},{"n":54,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"True about histology in infiltrating lobular breast carcinoma: (JIPMER 2012, 2011)","options":[{"letter":"A","text":"Single file pattern"},{"letter":"B","text":"Pleomorphic cells in sheets"},{"letter":"C","text":"Cribiform pattern"},{"letter":"D","text":"Pin wheel pattern"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Single file pattern","explanation":"a. Single file pattern"},{"n":55,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Lymph node first involved in CA breast is/are: (PGI Nov 2009)","options":[{"letter":"A","text":"Axillary LN"},{"letter":"B","text":"Internal mammary LN"},{"letter":"C","text":"Supraclavicular LN"},{"letter":"D","text":"Contralateral axillary LN"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Axillary LN, B. Internal mammary LN","explanation":"a. Axillary LN, b. Internal mammary LN (Ref: Bailey 27/e p873)"},{"n":56,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"In breast cancer following are expressed: (PGI Dec 2007)","options":[{"letter":"A","text":"Her-2-neu"},{"letter":"B","text":"p53"},{"letter":"C","text":"BRCA-1"},{"letter":"D","text":"BCL-1"},{"letter":"E","text":"CEA"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Her-2-neu, B. p53, C. BRCA-1, E. CEA","explanation":"• BCL-1 gene is expressed in mantle cell lymphomaQ.\n• Her-2-neu, p53, BRCA-1 and CEA is expressed in CA breastQ.\nDuplicate: same question text and options as Chapter 1 Q143.\nAnswer (book): Answer: A. Her-2-neu, B. p53, C. BRCA-1, E. CEA\nReference: Schwartz 9/e p438; Sabiston 20/e p840; Bailey 27/e p875"},{"n":57,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Most common presentation of lobular carcinoma breast is: (DNB 2012)","options":[{"letter":"A","text":"Nipple discharge"},{"letter":"B","text":"Breast mass"},{"letter":"C","text":"Mammographic calcification"},{"letter":"D","text":"Nipple retraction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Breast mass","explanation":"b. Breast mass"},{"n":58,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Carcinoma breast is most commonly seen in which quadrant of breast: (MHSSMCET 2005)","options":[{"letter":"A","text":"Upper outer"},{"letter":"B","text":"Upper inner"},{"letter":"C","text":"Lower inner"},{"letter":"D","text":"Lower outer"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Upper outer","explanation":"a. Upper outer"},{"n":59,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Nottingham Prognostic Index for CA breast is: (MHSSMCET 2008)","options":[{"letter":"A","text":"I = (0.2 x size) + grade + nodes"},{"letter":"B","text":"I = (0.4 x size) + grade + nodes"},{"letter":"C","text":"I = (0.6 x size) + grade + nodes"},{"letter":"D","text":"I = (0.8 x size) + grade + nodes"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"{I= (0.2 x size) + grade + nodes}","explanation":"Nottingham Prognostic Index (NPI)\n• NPI = (0.2 X tumor size in cm) + Tumor grade (1–3) + LN stage (1–3)Q\n• Used to select patients for adjuvant treatment\nAnswer (book): Answer: A. {I= (0.2 x size) + grade + nodes}\nReference: Bailey 27/e p875"},{"n":60,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Rare histological variants of carcinoma breast with better prognosis include all except: (DPG 2009 March)","options":[{"letter":"A","text":"Colloid carcinoma"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Inflammatory carcinoma"},{"letter":"D","text":"Tubular carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Inflammatory carcinoma","explanation":"Inflammatory Carcinoma\n• Ominous clinical categoryQ associated with diffuse tumor involvement of the lymphatic channelsQ within the\nbreast and overlying skin\nAnswer (book): Answer: C. Inflammatory carcinoma\nReference: Schwartz 10/e p520-522; Sabiston 20/e p860"},{"n":61,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"In which of the following types of carcinoma breast, comedo growth pattern is seen? (Karnataka 2006)","options":[{"letter":"A","text":"Ductal carcinoma in-situ"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Lobular carcinoma in-situ"},{"letter":"D","text":"Infiltrating lobular carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ductal carcinoma in situ","explanation":"a. Ductal carcinoma in-situ (Ref: Schwartz 10/e p520; Sabiston 20/e p837; Bailey 27/e p872)"},{"n":62,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Histological variety of breast carcinoma with best prognosis is: (DNB 2012, 2008, 2005, 2002)","options":[{"letter":"A","text":"Medullary"},{"letter":"B","text":"Colloid"},{"letter":"C","text":"Lobular"},{"letter":"D","text":"Tubular"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Tubular","explanation":"d. Tubular"},{"n":63,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Breast cancer which is multicentric and bilateral? (DPG 2008, AIIMS Feb 97, May 95, All India 96, PGI June 95)","options":[{"letter":"A","text":"Ductal carcinoma"},{"letter":"B","text":"Lobular carcinoma"},{"letter":"C","text":"Mucoid carcinoma"},{"letter":"D","text":"Colloid carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Lobular carcinoma","explanation":"b. Lobular carcinoma"},{"n":64,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Single file pattern is seen breast cancer type: (APPG 2004)","options":[{"letter":"A","text":"Intraductal"},{"letter":"B","text":"Infiltrating lobular"},{"letter":"C","text":"Infiltrating ductular"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Infiltrating lobular","explanation":"b. Infiltrating lobular"},{"n":65,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"In which of the following type of carcinoma of the breast, is a biopsy of the opposite breast advised? (UPSC 2002)","options":[{"letter":"A","text":"Inflammatory carcinoma"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Lobular carcinoma"},{"letter":"D","text":"Scirrhous carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lobular carcinoma","explanation":"c. Lobular carcinoma"},{"n":66,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"In which of the following type of breast carcinoma, would you consider biopsy of opposite breast? (All India 2006)","options":[{"letter":"A","text":"Adenocarcinoma poorly differentiated"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Lobular carcinoma"},{"letter":"D","text":"Comedo carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lobular carcinoma","explanation":"c. Lobular carcinoma"},{"n":67,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"The type of mammary ductal carcinoma is situ (DCIS) most likely to result in a palpable abnormality in the breast is: (All India 2006)","options":[{"letter":"A","text":"Apocrine DCIS"},{"letter":"B","text":"Neuroendocrine DCIS"},{"letter":"C","text":"Well differentiated DCIS"},{"letter":"D","text":"Comedo DCIS"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Comedo DCIS","explanation":"d. Comedo DCIS"},{"n":68,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Not true about CA breast in India: (AIIMS June 98)","options":[{"letter":"A","text":"Incidence is 20/1,00,000"},{"letter":"B","text":"Average age 42 years"},{"letter":"C","text":"Positive family history is a risk factor"},{"letter":"D","text":"More common in muslims"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"More common in Muslims","explanation":"d. More common in Muslims"},{"n":69,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Best prognosis amongst the following histological variants of breast carcinoma is seen with: (All India 98)","options":[{"letter":"A","text":"Intraductal"},{"letter":"B","text":"Colloid (Mucinous)"},{"letter":"C","text":"Lobular"},{"letter":"D","text":"Medullary"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Colloid (Mucinous)","explanation":"b. Colloid (Mucinous)"},{"n":70,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Which of the following carcinoma is familial? (All India 99)","options":[{"letter":"A","text":"Breast"},{"letter":"B","text":"Prostate"},{"letter":"C","text":"Cervix"},{"letter":"D","text":"Vaginal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Breast","explanation":"a. Breast (Ref: Sabiston 20/e p691)"},{"n":71,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"Which one of the following familial carrier syndromes is associated with mutation in BRCA genes? (APPG 2016)","options":[{"letter":"A","text":"Hereditary non-polyposis colorectal cancer"},{"letter":"B","text":"Von Hippel Lindau disease"},{"letter":"C","text":"Peutz- Jegher syndrome"},{"letter":"D","text":"Familial breast/ovarian cancer"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Familial breast/ovarian cancer","explanation":"d. Familial breast/ovarian cancer"},{"n":72,"chapter":"Breast","src":"question on PDF p. 127 · answer on PDF p. 139","pdfPage":127,"stem":"A 45-year-old female presented to your OPD with this lesion in the left breast. What is the most probable diagnosis?","options":[{"letter":"A","text":"DCIS"},{"letter":"B","text":"LCIS"},{"letter":"C","text":"Peau-d’orange"},{"letter":"D","text":"Paget’s disease of nipple"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Peau-d’orange","explanation":"c. Peau-d’orange"},{"n":73,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"‘Peau-d-orange’ appearance of the mammary skin is due to: (DNB 2012, PGI June 95, Dec 95)","options":[{"letter":"A","text":"Intra-epithelial cancer"},{"letter":"B","text":"Sub-epidermal cancer"},{"letter":"C","text":"Lymphatic permeation"},{"letter":"D","text":"Vascular embolisation"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lymphatic permeation","explanation":"• Peau-d-orange is due to cutaneous lymphatic edema, where the infiltrated skin is tethered by sweat ducts, it can\nnot swell, leading to an appearance like orange skinQ.\n• Due to obstruction of subdermal lymphatics (lymphatic permeation by tumor cells)\n• Seen in advanced breast cancer (may be seen in chronic abscess)\nAnswer (book): Answer: C. Lymphatic permeation\nReference: Bailey 27/e p873"},{"n":74,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Which is the most conspicuous sign in breast cancer? (AIIMS November 2018)","options":[{"letter":"A","text":"Nipple retraction"},{"letter":"B","text":"Peau-d’orange"},{"letter":"C","text":"Puckering"},{"letter":"D","text":"Both nipple retraction and puckering"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Peau-d’orange","explanation":"b. Peau-d’orange (Ref: Schwartz 10/e p518; Sabiston 20/e p860; Bailey 27/e p873)"},{"n":75,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Most common site of metastasis from breast carcinoma: (DNB 2012)","options":[{"letter":"A","text":"Thoracic vertebra"},{"letter":"B","text":"Pelvis"},{"letter":"C","text":"Femur"},{"letter":"D","text":"Lumbar vertebra"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Lumbar vertebra","explanation":"• Most common site of metastasis from breast carcinoma is lumbar vertebra. Bailey says that “It is by this route\n(spread by the bloodstream) that skeletal metastases occur, although the initial spread may be via the lymphatic\nsystem. In order of frequency the lumbar vertebrae, femur, thoracic vertebrae, rib and skull are affected and\nthese deposits are generally osteolytic.”\nAnswer (book): Answer: D. Lumbar vertebra\nReference: Bailey 27/e p873"},{"n":76,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Carcinoma breast with high incidence of involving opposite breast is: (Recent Question 2016, AIIMS Nov 94)","options":[{"letter":"A","text":"Lobular carcinoma"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Scirrhous adenocarcinoma"},{"letter":"D","text":"Atrophic scirrhous carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lobular carcinoma","explanation":"a. Lobular carcinoma"},{"n":77,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"All are true about CA breast, except: (AIIMS May 93)","options":[{"letter":"A","text":"Affected sibling is a risk factor"},{"letter":"B","text":"Paget’s disease of nipple is intraductal type of CA"},{"letter":"C","text":"Common in aged nulliparous"},{"letter":"D","text":"Increased incidence with prolonged breast feeding"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Increased incidence with prolonged breastfeeding","explanation":"d. Increased incidence with prolonged breastfeeding"},{"n":78,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"‘Peau-d-orange’ is due to: (DNB 2009, 2008, AIIMS Nov 93) (AIIMS November 2015)","options":[{"letter":"A","text":"Arterial obstruction"},{"letter":"B","text":"Blockage of subdermal lymphatics"},{"letter":"C","text":"Invasion of skin with malignant cells"},{"letter":"D","text":"Secondary infection"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Blockage of subdermal lymphatics","explanation":"b. Blockage of subdermal lymphatics"},{"n":79,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"True about lymphatic spread of CA breast: (PGI June 2005)","options":[{"letter":"A","text":"Axillary nodes are most commonly involved"},{"letter":"B","text":"Internal mammary nodes are also involved"},{"letter":"C","text":"If supraclavicular lymph node is involved then it is N3"},{"letter":"D","text":"Axillary nodes are treated by surgical resection"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Axillary nodes are most commonly involved, B. Internal mammary nodes are also involved, C. If","explanation":"a. Axillary nodes are most commonly involved, b. Internal mammary nodes are also involved, c. If supraclavicular lymph node is\ninvolved then it is N3, d. Axillary nodes are treated by surgical resection (Ref: Bailey 27/e p873)"},{"n":80,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Secondary deposits from carcinoma breast is commonest in: (DNB 2010, 2001, All India 89)","options":[{"letter":"A","text":"Lung"},{"letter":"B","text":"Liver"},{"letter":"C","text":"Brain"},{"letter":"D","text":"Bone"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Bone","explanation":"d. Bone"},{"n":81,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Most common type of breast carcinoma: (WBPG 2014, 2015)","options":[{"letter":"A","text":"LCIS"},{"letter":"B","text":"DCIS"},{"letter":"C","text":"Phyllodes tumour"},{"letter":"D","text":"Invasive ductal carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Invasive ductal carcinoma","explanation":"d. Invasive ductal carcinoma"},{"n":82,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Carcinoma breast is least commonly seen in: (Recent Question 2013)","options":[{"letter":"A","text":"Superior outer quadrant"},{"letter":"B","text":"Inferior outer quadrant"},{"letter":"C","text":"Subareolar"},{"letter":"D","text":"Lower inner quadrant"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Lower inner quadrant","explanation":"• Upper inner (12–15%) • Upper outer (~ 50%)\nAnswer (book): Answer: D. Lower inner quadrant\nReference: Bailey 27/e p874"},{"n":83,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 139","pdfPage":128,"stem":"Nipple inversion occurs due to involvement of: (DNB 2014)","options":[{"letter":"A","text":"Cooper’s ligament"},{"letter":"B","text":"Subareolar duct"},{"letter":"C","text":"Parenchyma of breast"},{"letter":"D","text":"Subdermal lymphatics"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Subareolar duct","explanation":"• Lower inner (3–5%) • Lower outer (6–10%)\n• Central/areolar (20%)\nPeau-d-orange\n• Retraction of nipple is due to fibrosis in and around subareolar duct\n• Retraction/dimpling of skin is due to involvement of cooper’s ligament\n• Peau-D-orange is due to blockage of subdermal lymphatics\nAnswer (book): Answer: B. Subareolar duct\nReference: Bailey 27/e p873"},{"n":84,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"Van Nuys grading system is used for: (DNB 2014)","options":[{"letter":"A","text":"LCIS"},{"letter":"B","text":"DCIS"},{"letter":"C","text":"Inflammatory"},{"letter":"D","text":"Medullary Carcinoma breast"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"DCIS","explanation":"Van Nuys Prognostic Index (VNPI)\n• Van Nuys prognostic index (VNPI) is widely used to classify ductal carcinoma in situ (DCIS) into dissimilar risk\ncategories that may be treated accordingly. Attempts have been made to identify subsets of DCIS for which wide\nexcision without irradiation would provide sufficient local control.\n• Silverstein and colleagues derived the Van Nuys criteria from a series of DCIS patients treated by wide excision\nwith and without radiation therapy and proposed a system to identify patients who do not need radiation therapy\nbased on:\n1. Patient’s ageQ\n2. DCIS nuclear gradeQ and presence of microcalcificationQ\n3. SizeQ of the lesion\n4. WidthQ of the surgical margin.\nAnswer (book): Answer: B. DCIS\nReference: Sabiston 20/e p853, Bailey 27/e p872, p838"},{"n":85,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"Van-Nuys classification does not include which of the following? (Recent Question 2018)","options":[{"letter":"A","text":"Patients age"},{"letter":"B","text":"Size of tumor"},{"letter":"C","text":"Presence of microcalcification"},{"letter":"D","text":"Her-2-neu receptor status"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Her-2-neu receptor status","explanation":"d. Her-2-neu receptor status (Ref: Sabiston 20/e p853; Bailey 27/e p872)"},{"n":86,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"Which of the following statements is fully true? (APPG 2015)","options":[{"letter":"A","text":"Paget’s disease of the nipple is a type of breast cancer with prominent Paget cells and presence of S-100 Ag immu-nostaining"},{"letter":"B","text":"BRCA 1 and 2 gene mutations cause breast cancer and are passed from mother to daughter by mitochondrial inheritance"},{"letter":"C","text":"Raloxifene is an SERM that prevents breast cancer but increases risk of endometrial cancer"},{"letter":"D","text":"Lobular carcinoma in situ arises from epithelial lining of the minor ducts and 10% occur in males"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Raloxifene is an SERM that prevents breast cancer but increases risk of endometrial cancer","explanation":"c. Raloxifene is an SERM that prevents breast cancer but increases risk of endometrial cancer"},{"n":87,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"Dimpling in carcinoma breast is due to: (Recent Question 2016)","options":[{"letter":"A","text":"Edema"},{"letter":"B","text":"Contraction of Cooper’s ligaments"},{"letter":"C","text":"Subdermal lymphangitis"},{"letter":"D","text":"Scarring"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Subdermal lymphangitis","explanation":"c. Subdermal lymphangitis"},{"n":88,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"Most common site of metastases in carcinoma breast: (Recent Question 2017)","options":[{"letter":"A","text":"Bone"},{"letter":"B","text":"Lung"},{"letter":"C","text":"Liver"},{"letter":"D","text":"Brain"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Bone","explanation":"a. Bone (Ref: Schwartz 10/e p543; Sabiston 20/e p838; Bailey 27/e p873)"},{"n":89,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"A 45 years old postmenopausal lady presents with an 8-cm breast lump that is adherent to the skin, with one firm apical lymph node in the axilla and one more node in the ipsilateral supraclavicular area with no clinical evidence of distant metastasis. The staging is: (COMEDK 2010)","options":[{"letter":"A","text":"T3 N2 M1"},{"letter":"B","text":"T4 N3c M0"},{"letter":"C","text":"T4 N2c M1"},{"letter":"D","text":"T3 N3 M0"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"T3 N3 M0","explanation":"d. T3 N3 M0 (Ref: Schwartz 10/e p532; Sabiston 20/e p843)"},{"n":90,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"The clinician was palpating with tips of finger except thumb started from 2 o’clock posteriorly, palpated at 3 points on line joining periphery to nipple. Then again went to 3 o’clock point directly and came back centripetally while palpating at 3 points again on the line joining periphery and nipple. What is the method of breast examination depicted in the video? (AIIMS November 2018)","options":[{"letter":"A","text":"Vertical strip method"},{"letter":"B","text":"Concentric method"},{"letter":"C","text":"Dial of clock method"},{"letter":"D","text":"Quadrant method"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Dial of clock method","explanation":"“Dial of Clock” Method of Breast Examination\n“Dial of Clock” Method of Breast Examination\n• In dial of clock method, palpation is performed in segmental manner until entire breast is examined with “pads of\nmiddle three fingers” (index, middle, and ring) with hand held in slightly bowed position.\n• Whole breast is palpated as if it was “dial of a clock”:\n– 12 o’clock: Highest point at upper edge of breast just below mid-clavicular point\n– 6 o’clock: At infra-mammary crease.\n• Palpation begins at 12 o’clock from periphery to nipple by describing small circles of about 3 cm in diameter.\n• Breast is palpated by making circular movements of the “pad of fingers”, three times with increasing pressure &\nwithout lifting the fingers.\n• Next circle is palpated towards nipple, overlapping with the previous circle to about half in diameter. Once areola\n& nipple area is reached, the next segment/sector is palpated at 1 o’clock.\n• Inner half of mammary gland is palpated in supine position.\n• Patient is requested to roll over the opposite side for palpation of outer half of mammary gland. This allows the\nmammary tissue to fall towards the midline by gravity resulting in flattening of lateral half of mammary gland,\nmaking a lump in lateral half more discernible.\nImage-based question: the picture / video this question refers to is on PDF p. 128 of the source and is not reproduced here.\nAnswer (book): Answer: C. Dial of clock method\nReference: https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5473793/"},{"n":91,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 140","pdfPage":128,"stem":"In patients with breast cancer, chest wall involvement means involvement of any one of the following structures except: (DPG 2010, AIIMS Nov 2005)","options":[{"letter":"A","text":"Serratus anterior"},{"letter":"B","text":"Pectoralis major"},{"letter":"C","text":"Intercostal muscles"},{"letter":"D","text":"Ribs"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pectoralis major","explanation":"• Chest wall involvement means involvement of ribsQ, intercostal musclesQ or Serratus anteriorQ as chest wall is\nformed by these structures not the pectoralis major.\nAnswer (book): Answer: B. Pectoralis major\nReference: Schwartz 9/e p452; Sabiston 20/e p843"},{"n":92,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"Ipsilateral supraclavicular lymph nodes are positive in a patient of CA breast. Stage is: (Recent Question 2013, AIIMS Nov 2008)","options":[{"letter":"A","text":"II"},{"letter":"B","text":"III B"},{"letter":"C","text":"III C"},{"letter":"D","text":"IV"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"III C","explanation":"41\nContraindications\n• Large, bulky tumor involving the pectoralis major muscle or the fascia\n• Bulky axillary LN involvement\n• Grossly involved interpectoral nodes in whom posterior fascia of muscle is also involved\nNon-palpable or small tumorQ Advanced disease with distant metastasisQ Who wants reconstructive surgery Need\nof improved cosmetic result that is achieved by MRMQ Co-existing severe systemic diseases like DM, CHF or CRFQ\nAnswer (book): Answer: C. IIIC"},{"n":93,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"CA breast stage T4b involves all except: (AIIMS May 2012)","options":[{"letter":"A","text":"Nipple retraction"},{"letter":"B","text":"Skin ulcer over the swelling"},{"letter":"C","text":"Dermal edema"},{"letter":"D","text":"Satellite nodule"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nipple retraction","explanation":"a. Nipple retraction"},{"n":94,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"Which of the following stage of breast cancer corresponds with following feature: Breast mass of 6×3 cm size with hard mobile ipsilateral axillary lymph node and ipsilateral supraclavicular lymph node: (AIIMS June 2000)","options":[{"letter":"A","text":"T4N2M0"},{"letter":"B","text":"T3N1M1"},{"letter":"C","text":"T4N1M1"},{"letter":"D","text":"T3N3M0"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"T3N3M0","explanation":"d. T3N3M0"},{"n":95,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"A 43-year-old lady presents with a 5cm lump in right breast with a 3cm node in the supraclavicular fossa. Which of the following TNM stage she belongs to as per the latest AJCC staging system? (AIIMS June 2004)","options":[{"letter":"A","text":"T2N0M1"},{"letter":"B","text":"T1N0M1"},{"letter":"C","text":"T2N3M0"},{"letter":"D","text":"T2N2M0"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T2N3M0","explanation":"c. T2N3M0"},{"n":96,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"Patient with 1.2 cm breast lump with three lymph nodes in the axilla with no metastasis is in which stage as per AJCC? (COMEDK 2014)","options":[{"letter":"A","text":"T1N0M0"},{"letter":"B","text":"T1bN1bM0"},{"letter":"C","text":"T1cN1bM0"},{"letter":"D","text":"T2N1cM0"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T1cN1bM0","explanation":"c. T1cN1bM0"},{"n":97,"chapter":"Breast","src":"question on PDF p. 128 · answer on PDF p. 141","pdfPage":128,"stem":"TNM staging of breast carcinoma with positive bilateral supraclavicular lymph nodes is? (DNB 2014)","options":[{"letter":"A","text":"N3a"},{"letter":"B","text":"N3b"},{"letter":"C","text":"N3c"},{"letter":"D","text":"M1"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"M1","explanation":"d. M1"},{"n":98,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"True about modified radical mastectomy is: (Punjab 2007)","options":[{"letter":"A","text":"Pectoralis major is removed"},{"letter":"B","text":"Axillary lymph nodes are preserved"},{"letter":"C","text":"Pectoralis minor is divided"},{"letter":"D","text":"Internal mammary lymph nodes are removed"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pectoralis minor is divided","explanation":"c. Pectoralis minor is divided (Ref: Schwartz 10/e p547-549; Sabiston 20/e p848-850; Bailey 27/e p876)"},{"n":99,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Contraindication for radical mastectomy in CA breast: (PGI Dec 2006)","options":[{"letter":"A","text":"Distant metastasis"},{"letter":"B","text":"Fixity to chest wall"},{"letter":"C","text":"Axillary LN involvement"},{"letter":"D","text":"Supraclavicular LN involvement"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Distant metastasis","explanation":"Radical Mastectomy Indications\nAnswer (book): Answer: A. Distant metastasis\nReference: Breast diseases by Jay R. Harris 2/e p354; Bailey 27/e p876"},{"n":100,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Breast conservation surgery indicated in: (PGI Nov 2011)","options":[{"letter":"A","text":"Tumor size < 4 cm"},{"letter":"B","text":"Central"},{"letter":"C","text":"Mobile"},{"letter":"D","text":"Pendulous breast"},{"letter":"E","text":"Diffuse microcalcification"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tumor size < 4 cm c. Mobile.","explanation":"a. Tumor size < 4 cm c. Mobile."},{"n":101,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"All of the following are removed in radical mastectomy except: (MHPGMCET 2005, AIIMS 92)","options":[{"letter":"A","text":"Pectoralis major"},{"letter":"B","text":"Pectoralis minor"},{"letter":"C","text":"Axillary lymph node"},{"letter":"D","text":"Supraclavicular lymph node"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Supraclavicular lymph node","explanation":"Halstead’s Radical Mastectomy Structures Removed\n• Whole breast, skin and nipple-areola complexQ.\n• Subcutaneous fat, deep fascia vertically from lower border of the clavicle upto the upper quarter of the sheath of\nthe rectus abdominis and horizontally from sternum to anterior border of lattissimus dorsi.\n• Pectoralis major and minor muscleQ with clavipectoral fasciaQ\n• Level I, II and III axillary LNsQ\nAnswer (book): Answer: D. Supraclavicular lymph node\nReference: Schwartz 9/e p461; Bailey 27/e p876"},{"n":102,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"In Patey’s modified mastectomy, which of the following is preserved? (Recent Question 2014, MHSSMCET 2006)","options":[{"letter":"A","text":"Intercostobrachial nerve"},{"letter":"B","text":"Pectoralis major"},{"letter":"C","text":"Pectoralis minor"},{"letter":"D","text":"Axillary fascia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pectoralis major","explanation":"Structures Preserved (ABC)\n• Axillary vein and cephalic veinQ\n• Long thoracic nerve of Bell (Nerve to serratus anterior)Q.\nAnswer (book): Answer: B. Pectoralis major"},{"n":103,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Patey’s mastectomy following are preserved except: (Recent Question 2014, MHSSMCET 2009)","options":[{"letter":"A","text":"Teres major"},{"letter":"B","text":"Teres minor"},{"letter":"C","text":"Axillary vein"},{"letter":"D","text":"Breast"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Breast","explanation":"d. Breast"},{"n":104,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Drug used in estrogen dependent breast cancer: (AIIMS May 2012)","options":[{"letter":"A","text":"Tamoxifen"},{"letter":"B","text":"Clomiphene citrate"},{"letter":"C","text":"Estrogen"},{"letter":"D","text":"Adriamycin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tamoxifen","explanation":"a. Tamoxifen (Ref: Schwartz 10/e p552; Goodman and Gillman’s 12/e p1179)"},{"n":105,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Components of QUARTZ except: (MHSSMCET 2009)","options":[{"letter":"A","text":"Quadrantectomy"},{"letter":"B","text":"Axillary dissection"},{"letter":"C","text":"Radiotherapy"},{"letter":"D","text":"Tamoxifen"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Tamoxifen","explanation":"• QUARTZ: Quadrantectomy + Axillary LN dissection + RadiotherapyQ\nAnswer (book): Answer: D. Tamoxifen"},{"n":106,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Chronic treatment with tamoxifen can cause carcinoma of: (COMEDK 2010, 2007)","options":[{"letter":"A","text":"Ovary"},{"letter":"B","text":"Endometrium"},{"letter":"C","text":"Cervix"},{"letter":"D","text":"Vulva"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endometrium","explanation":"b. Endometrium (Ref: Goodman and Gillman’s 12/e p1179)"},{"n":107,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Use of tamoxifen for breast cancer can cause all of the following adverse effects, except: (AIIMS May 2011, DPG 2011, PGI Dec 2001)","options":[{"letter":"A","text":"Thromboembolism"},{"letter":"B","text":"Endometrial carcinoma"},{"letter":"C","text":"Carcinoma in contralateral breast"},{"letter":"D","text":"Cataract"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Carcinoma in contralateral breast","explanation":"c. Carcinoma in contralateral breast"},{"n":108,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"True about treatment of early breast cancer: (AIIMS May 2008)","options":[{"letter":"A","text":"Aromatase inhibitors are replacing tamoxifen in premenopausal women"},{"letter":"B","text":"Postmastectomy radiation therapy is given when 4 or more lymph nodes are positive"},{"letter":"C","text":"Tamoxifen is not useful in post-menopausal women"},{"letter":"D","text":"In premenopausal women, multidrug chemo-therapy is given in selected patients"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Postmastectomy radiation therapy is given when 4 or more lymph nodes are positive","explanation":"Indications of Radiotherapy in Carcinoma Breast\n• Locally Advanced Breast CancerQ (to decrease recurrence rate)\n• Margin is positive after mastectomyQ\nAfter breast conservation surgeryQ Metastases to 4 or more lymph nodesQ\n• Metastatic disease is the principal cause of death from breast cancerQ.\nAnswer (book): Answer: B. Postmastectomy radiation therapy is given when 4 or more lymph nodes are positive\nReference: Schwartz 10/e p550; Sabiston 20/e p853-854; Bailey 27/e p877"},{"n":109,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 141","pdfPage":129,"stem":"Superolateral boundary of axillary dissection is: (DNB 2010)","options":[{"letter":"A","text":"Clavipectoral fascia"},{"letter":"B","text":"Brachial plexus"},{"letter":"C","text":"Axillary artery"},{"letter":"D","text":"Axillary vein"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Axillary vein","explanation":"Axillary Node Clearance\n• Axillary node clearance can be defined as clearing the axillary contents bounded by:\n– Laterally: Axillary skin\n– Posteriorly: Lattisimus dorsi, Teres major and Subscapularis\n– Superiorly: Lower border of axillary veinQ\n– Anteriorly: Pectoralis muscle\n– Medially: Chest wall\nAnswer (book): Answer: D. Axillary vein\nReference: Gray’s 39/e p841"},{"n":110,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"A 50-years old female has under gone mastectomy for CA breast. After mastectomy patient is not able to extend adduct and internally rotate the arm. Now supply to which of the following muscle is damaged? (AIIMS May 2012)","options":[{"letter":"A","text":"Pectoralis major"},{"letter":"B","text":"Teres minor"},{"letter":"C","text":"Lattisimus dorsi"},{"letter":"D","text":"Long head of triceps"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Latissimus dorsi","explanation":"• Latissimus dorsi is active in adduction, extension and especially in medial rotation of the humerus.\nAnswer (book): Answer: C. Latissimus dorsi"},{"n":111,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"In Patey’s mastectomy, the step not done is: (PGI 95)","options":[{"letter":"A","text":"Nipple and areola removed"},{"letter":"B","text":"Surrounding normal tissue of tumor is removed"},{"letter":"C","text":"Pectoralis major removed"},{"letter":"D","text":"Pectoralis minor removed"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pectoralis major removed","explanation":"c. Pectoralis major removed"},{"n":112,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"Which is used in CA Breast? (DPG 2007)","options":[{"letter":"A","text":"Daunorubicin"},{"letter":"B","text":"Doxorubicin"},{"letter":"C","text":"Cisplatin"},{"letter":"D","text":"Actinomycin D"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Doxorubicin","explanation":"b. Doxorubicin (Ref: Bailey 27/e p878; Schwartz 10/e p550-551)"},{"n":113,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"Malti, a 45-year-female patient with a family history of breast carcinoma, showed diffuse microcalcifi-cation on mammography. Indraductal carcinoma is situ was seen on biopsy. Most appropriate management is: (Recenrt Question 2013, AIIMS June 2001)","options":[{"letter":"A","text":"Quadrantectomy"},{"letter":"B","text":"Radical mastectomy"},{"letter":"C","text":"Simple mastectomy"},{"letter":"D","text":"Chemotherapy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Simple mastectomy","explanation":"c. Simple mastectomy"},{"n":114,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"For CA breast best chemotherapeutic regimen: (AIIMS Sept 96, PGI June 96)","options":[{"letter":"A","text":"Cyclophosphamide, methotrexate, 5-fluorouracil"},{"letter":"B","text":"Methotrexate, cisplatin"},{"letter":"C","text":"Cisplatin, adrimaycin, steroid"},{"letter":"D","text":"Methotrexate, adriamycin, steroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cyclophosphamide, methotrexate, 5-fluorouracil","explanation":"a. Cyclophosphamide, methotrexate, 5-fluorouracil"},{"n":115,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"A 30-year-old female presented with unilateral breast cancer associated with axillary lymph node enlargement. Modified radical mastectomy was done, further treatment plan will be: (AIIMS May 2007)","options":[{"letter":"A","text":"Observation and follow-up"},{"letter":"B","text":"Adriamycin based chemotherapy followed by tamoxifen depending on estrogen/progesterone receptor status"},{"letter":"C","text":"Adriamycin based chemotherapy only"},{"letter":"D","text":"Tamoxifen only"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Adriamycin based chemotherapy followed by tamoxifen depending on estrogen/progesterone","explanation":"b. Adriamycin based chemotherapy followed by tamoxifen depending on estrogen/progesterone receptor status"},{"n":116,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"Breast conservative surgery is done in all except: (DPG 2010, UPPG 2000)","options":[{"letter":"A","text":"Young patients"},{"letter":"B","text":"Ductal carcinoma in situ"},{"letter":"C","text":"Lobular carcinoma"},{"letter":"D","text":"Infiltrative ductal carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lobular carcinoma","explanation":"• Lobular carcinoma is frequently multifocal, multicentric and bilateral and is contraindication for breast\nconservative surgeryQ.\nAnswer (book): Answer: C. Lobular carcinoma\nReference: Schwartz 10/e p520; Sabiston 20/e p833-834; Bailey 27/e p872"},{"n":117,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"In breast conservation surgery, the healthy margion excised is typically: (DNB 2013)","options":[{"letter":"A","text":"1 cm"},{"letter":"B","text":"2 cm"},{"letter":"C","text":"3 cm"},{"letter":"D","text":"5 cm"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"1 cm","explanation":"Breast Conservation Surgery\n• The amount of breast tissue excised with the lesion may vary with the clinical situation, but is typically 5 mm to\n10 mm in all directions.\n• BCS may consist of removal of tumor with 1 cm margin of normal tissue (wide local excision) or a more extensive\nexcision of a whole quadrant of breast (Quadrantectomy).\nAnswer (book): Answer: A. 1 cm\nReference: Mastery of Surgery 5/e p525"},{"n":118,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"In the breast conservation surgery, which of the following investigation is required: (DNB 2002)","options":[{"letter":"A","text":"Serum calcium"},{"letter":"B","text":"Total body scan"},{"letter":"C","text":"Sentinel node biopsy"},{"letter":"D","text":"Tumor markers"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Sentinel node biopsy","explanation":"c. Sentinel node biopsy"},{"n":119,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"Post operative radiotherapy in breast is given for: (JIPMER 95)","options":[{"letter":"A","text":"To prevent metastasis"},{"letter":"B","text":"For ablation of remnant of cancer tissue"},{"letter":"C","text":"To prevent recurrence"},{"letter":"D","text":"Prevents distant metastasis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"To prevent recurrence","explanation":"c. To prevent recurrence"},{"n":120,"chapter":"Breast","src":"question on PDF p. 129 · answer on PDF p. 142","pdfPage":129,"stem":"A 40-year-old female with a 2 cms nodule in the breast and a proved metastatic node in the axilla, treatment is: (PGI 96)","options":[{"letter":"A","text":"Quadrantectomy"},{"letter":"B","text":"Mastectomy with local radiotherapy"},{"letter":"C","text":"Patey’s with adjuvant chemotherapy"},{"letter":"D","text":"Halstedt’s operation with tamoxifen"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mastectomy with local radiotherapy","explanation":"b. Mastectomy with local radiotherapy"},{"n":121,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"Treatment of hormone dependent fungating carcinoma of breast with secondaries in the lung in a female patient aged 30 years is: (MAHE 2005)","options":[{"letter":"A","text":"Simple mastectomy followed by oophorectomy"},{"letter":"B","text":"Radical mastectomy followed by oophorectomy"},{"letter":"C","text":"Adrenalectomy"},{"letter":"D","text":"Lumpectomy followed by castration"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Simple mastectomy followed by oophorectomy","explanation":"a. Simple mastectomy followed by oophorectomy"},{"n":122,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"A premenopausal lady presents with pulmonary metastasis. She underwent mastectomy 3 years back. True statement regarding her management: (PGI Nov 2011)","options":[{"letter":"A","text":"It was better if she took adjuvant therapy after mastectomy"},{"letter":"B","text":"First analyze estrogen and progesterone receptor levels on the tumor"},{"letter":"C","text":"Response of chemotherapy is dose dependent"},{"letter":"D","text":"Combined chemotherapy is better than monotherapy"},{"letter":"E","text":"She should now be given chemotherapy with radiotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"It was better if she took adjuvant therapy after mastectomy, B. First analyze estrogen and","explanation":"a. It was better if she took adjuvant therapy after mastectomy, b. First analyze estrogen and progesterone receptor levels on the tumor"},{"n":123,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"Aromatase inhibitors used in CA breast are: (PGI June 2007)","options":[{"letter":"A","text":"Letrozole"},{"letter":"B","text":"Anastrozole"},{"letter":"C","text":"Exemestane"},{"letter":"D","text":"Tamoxifen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Letrozole, B. Anastrozole, C. Exemestane","explanation":"Hormonal Therapy in Carcinoma Breast\n• Tamoxifen is DOC in pre-menopausal patientsQ\n• Aromatase inhibitors are DOC in post-menopausal patients\nAnswer (book): Answer: A. Letrozole, B. Anastrozole, C. Exemestane\nReference: Schwartz 10/e p552-553; Sabiston 20/e p857-858"},{"n":124,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"According to NSABP tamoxifen given in breast carcinoma for: (WBPG 2014)","options":[{"letter":"A","text":"5 years"},{"letter":"B","text":"3 years"},{"letter":"C","text":"10 years"},{"letter":"D","text":"Lifelong"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"5 years","explanation":"a. 5 years"},{"n":125,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"In radical mastectomy, the structures preserved are all except: (Recent Question 2015)","options":[{"letter":"A","text":"Axillary vein"},{"letter":"B","text":"Cephalic vein"},{"letter":"C","text":"Nerve to Serratus anterior"},{"letter":"D","text":"Pectoralis minor"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pectoralis minor","explanation":"d. Pectoralis minor"},{"n":126,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"Treatment of choice for locally advanced breast cancer: (Recent Question 2016)","options":[{"letter":"A","text":"Neoadjuvant chemotherapy followed by MRM followed by radiotherapy"},{"letter":"B","text":"Surgery alone"},{"letter":"C","text":"Radiation alone"},{"letter":"D","text":"Surgery followed by chemotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Neoadjuvant chemotherapy followed by MRM followed by radiotherapy","explanation":"a. Neoadjuvant chemotherapy followed by MRM followed by radiotherapy"},{"n":127,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 142","pdfPage":130,"stem":"A 36-year-old patient underwent breast conservation therapy and chemotherapy for a 1.5 × 1.2 cm ER positive breast cancer with one positive axillary lymph node. She is now on tamoxifen. How will you follow up the patient? (AIIMS May 2017)","options":[{"letter":"A","text":"Annual bone scan"},{"letter":"B","text":"Assessment of tumor markers 6 monthly"},{"letter":"C","text":"Routine clinical examination 3 monthly in 1st year with annual mammogram"},{"letter":"D","text":"Routine clinical examination 3 monthly and 6 monthly liver function tests"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Routine clinical examination 3 monthly in 1st year with annual mammogram","explanation":"5/e p71-72\n“Follow-up of breast cancer: Patients with breast cancer used to be followed for life to detect\nrecurrence and dissemination. This led to large clinics with little value for either patient or doctor. It is current\npractice to arrange yearly or two-yearly mammography of the treated and contralateral breast. There is a move to\nreturn the patient early to the care of the general practitioner with fast-track access back to the breast clinic if\nsuspicious symptoms appear. There is currently no routine role for repeated measurements of tumor markers or\nimaging other than mammography.”- Bailey 27/e p879\nBreast Cancer Follow-Up\nRecommended for Routine Surveillance History/physical examination\n• Every 3 to 6 months for the first 3 years, every 6 to 12 months, 4 and 5 years, annually thereafterQ\nMammography\n• Annually, beginning no earlier than 6 months after radiation therapyQ\nBreast self-examination\n• All women should be counseled to perform monthlyQ\nPelvic examination\n• AnnuallyQ\nCoordination of care\n• Continuity of care with breast cancer specialist and appropriate other health care providers Not Recommended\nfor Routine Surveillance\nRoutine blood test\n• Complete blood count & LFT are not recommendedQ\nImaging studies\n• CXR, bone scans, liver USG, CT scans, FDG-PET scans & breast MRI are not recommended for routine breast\ncancer surveillanceQ\nTumor markers\n• Cancer antigen 15.3, 27.29 & CEA are not recommendedQ\nAnswer (book): Answer: C. Routine clinical examination 3 monthly in 1st year with annual mammogram\nReference: De Vita 10/e p1145 (ASCO 2006 Updated guidelines); Bailey 27/e p879; MD Anderson Handbook of Surgical Oncology"},{"n":128,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"A 45 years old female presented with a history of painless breast lump of size 6 × 5 cm in left upper quadrant with no axillary lymph nodes. A true-cut biopsy was suggestive of ductal carcinoma in situ. She undergoes surgery with resection of all tumor tissue with adequate margins and postoperative HPE showing DCIS with high-grade necrosis with 4 mm clearance on margins. Which of the following is needed? (AIIMS May 2017)","options":[{"letter":"A","text":"Adjuvant chemotherapy"},{"letter":"B","text":"Adjuvant chemoradiotherapy"},{"letter":"C","text":"Adjuvant radiotherapy"},{"letter":"D","text":"No additional treatment"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Adjuvant radiotherapy","explanation":"“Ixabepilone is approved for breast cancer treatment.”-Goodman Gilman 12/e p1709\nAnswer (book): Answer: C. Adjuvant radiotherapy\nReference: Sabiston 20/e p851-855; Schwartz 10/e p537; Bailey 27/e p877"},{"n":129,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Ixabepilone is used in: (Recent Question 2017)","options":[{"letter":"A","text":"Melanoma"},{"letter":"B","text":"Breast carcinoma"},{"letter":"C","text":"Oat cell carcinoma"},{"letter":"D","text":"Small cell carcinoma lung"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Breast carcinoma","explanation":"b. Breast carcinoma (Ref: Goodman Gilman 12/e p1709)\n“Ixabepilone is approved for breast cancer treatment.”-Goodman Gilman 12/e p1709"},{"n":130,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Adjuvant therapy after mastectomy is needed in all of the following except: (Recent Question 2017)","options":[{"letter":"A","text":"High risk, node positive"},{"letter":"B","text":"Low risk, no node"},{"letter":"C","text":"HR –ve"},{"letter":"D","text":"Her-2-neu +ve"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Low risk, no node","explanation":"b. Low risk, no node (Ref: Schwartz 10/e p550; Sabiston 20/e p853)"},{"n":131,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Prophylactic mastectomy is done in: (Recent Question 2017)","options":[{"letter":"A","text":"BRCA-1 and BRCA-2 carrier"},{"letter":"B","text":"History of breast cancer in mother"},{"letter":"C","text":"After surgery in opposite breast"},{"letter":"D","text":"Invasive ductal cancer"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"BRCA-1 and BRCA-2 carrier","explanation":"a. BRCA-1 and BRCA-2 carrier (Ref: Schwartz 10/e p516; Sabiston 20/e p835; Bailey 27/e p881)"},{"n":132,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Level II axillary lymph node: (Recent Question 2017)","options":[{"letter":"A","text":"Lateral to pectoralis major and minor"},{"letter":"B","text":"Behind pectoralis minor"},{"letter":"C","text":"Medial to pectoralis minor"},{"letter":"D","text":"Superomedial to pectoralis major"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Behind pectoralis minor","explanation":"b. Behind pectoralis minor (Ref: Schwartz 10/e p502; Sabiston 20/e p819)"},{"n":133,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Which of the following statements is not true about tamoxifen? (Recent Question 2019)","options":[{"letter":"A","text":"It is used for visceral metastasis"},{"letter":"B","text":"Tamoxifen is useful in post-menopausal and aromatase inhibitors in premenopausal patients"},{"letter":"C","text":"Dose is 20 mg for 5 years"},{"letter":"D","text":"It can cause endometrial carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tamoxifen is useful in post-menopausal and aromatase inhibitors in premenopausal patients","explanation":"In this case, patient is 45 years old (Score 2) with size 5 cm (Score 3), margin of 4 mm (Score 2),\nnecrotic features without high grade (Score 2), the total score is 9. Usually for score 7-9, if local excision is done\nradiotherapy should be given. If simple mastectomy is done, there is no need of adjuvant treatment. In this patient\nnext best step would be adjuvant radiotherapy.\nAnswer (book): Answer: B. Tamoxifen is useful in post-menopausal and aromatase inhibitors in premenopausal patients\nReference: Schwartz 10/e p552; Sabiston 20/e p857; Bailey 27/e p878"},{"n":134,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"A patient underwent breast conservation surgery for a 3 cm lesion along with sentinel lymph node biopsy, which showed one third of sentinel lymph nodes are positive for macro-metastasis. Next step is: (Recent Question 2017)","options":[{"letter":"A","text":"Completion axillary lymph node dissection, chemotherapy and radiotherapy"},{"letter":"B","text":"MRM with level I lymphadenectomy"},{"letter":"C","text":"MRM with level III lymphadenectomy"},{"letter":"D","text":"Only chemotherapy and radiotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Completion axillary lymph node dissection, chemotherapy and radiotherapy","explanation":"a. Completion axillary lymph node dissection, chemotherapy and radiotherapy (Ref: Schwartz 10/e p541; Sabiston 20/e p853)"},{"n":135,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"The most important prognostic factor of carcinoma breast is: (COMEDK 2010)","options":[{"letter":"A","text":"Tumor size"},{"letter":"B","text":"DNA content of tumour"},{"letter":"C","text":"Histologic subtype"},{"letter":"D","text":"Tumor grade"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tumor size","explanation":"• The most important prognostic variables are provided by tumor stagingQ.\n• The size of the tumor and status of the axillary LN provide resonably accurate information on the likelihood of\ntumor relapseQ.\nAnswer (book): Answer: A. Tumor size\nReference: Schwartz 10/e p535-536; Bailey 27/e p875; Harrison 20/e p19/e p528"},{"n":136,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"True regarding axillary lymph node dissection in breast cancer: (PGI November 2017)","options":[{"letter":"A","text":"Axillary dissection can be carried out through the incision for a mastectomy"},{"letter":"B","text":"Level I, II and III nodes are removed in modified radical mastectomy"},{"letter":"C","text":"In Halsted radical mastectomy, all breast tissue and skin, the nipple, areola complex, the pectoralis major and pectoralis minor muscles, and the level I, II and III axillary lymph nodes are removed"},{"letter":"D","text":"Arm is kept abducted at 90 0 during axillary dissection"},{"letter":"E","text":"Halsted radical mastectomy preserves pectoralis major and the lateral pectoral nerve"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Axillary dissection…, B. Level I, II and III…, C. In Halsted, D. Arm is kept….","explanation":"a. Axillary dissection…, b. Level I, II and III…, c. In Halsted, d. Arm is kept…. (Ref: Schwartz 10/e p547; Sabiston 20/e p851; Bailey\n27/e p877)"},{"n":137,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Not a poor prognostic factor in breast carcinoma: (PGI May 2011)","options":[{"letter":"A","text":"Her-2-neu +ve"},{"letter":"B","text":"Progesterone receptor +ve"},{"letter":"C","text":"Extranodal metastasis"},{"letter":"D","text":"Vascularity of tumor"},{"letter":"E","text":"ER +ve"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Progesterone receptor +ve, E. ER +ve","explanation":"b. Progesterone receptor +ve, e. ER +ve"},{"n":138,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Good prognosis in carcinoma breast are all except: (UPPG 2010)","options":[{"letter":"A","text":"Positive estrogen progesterone hormone receptor"},{"letter":"B","text":"High HER-2-neu oncogene"},{"letter":"C","text":"DNA flow cytometry shows-diploidy"},{"letter":"D","text":"Low cathepsin-D"},{"letter":"E","text":"Tumour labeling index <3%"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"High HER-2-neu oncogene","explanation":"b. High HER-2-neu oncogene"},{"n":139,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"The most important prognostic factor in carcinoma breast is: (DPG 2009 Feb)","options":[{"letter":"A","text":"Size of tumour"},{"letter":"B","text":"Skin involvement"},{"letter":"C","text":"Involvement of muscles"},{"letter":"D","text":"Axillary LN involvement"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Axillary LN involvement","explanation":"d. Axillary LN involvement"},{"n":140,"chapter":"Breast","src":"question on PDF p. 130 · answer on PDF p. 143","pdfPage":130,"stem":"Prognosis of breast cancer is best determined by: (APPG 2008)","options":[{"letter":"A","text":"Estrogen/progesterone receptors"},{"letter":"B","text":"Axillary lymph node status"},{"letter":"C","text":"Clinical assessment"},{"letter":"D","text":"CT"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Axillary lymph node status","explanation":"b. Axillary lymph node status"},{"n":141,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"In case of CA breast most important prognostic factor is: (WB PG 2015, AIIMS Nov 96, Feb 97)","options":[{"letter":"A","text":"Size of tumor"},{"letter":"B","text":"Lymph node status"},{"letter":"C","text":"Presence of estrogen receptor"},{"letter":"D","text":"Age of menopause"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Lymph node status","explanation":"Prognosis in Male Breast Cancer\n• Stage >Lymph node status is the best prognostic indicatorQ as in female breast carcinoma.\nAnswer (book): Answer: B. Lymph node status"},{"n":142,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"The risk factor for increased incidence of relapse in stage I carcinoma breast includes all except: (All India 98)","options":[{"letter":"A","text":"Negative estrogen/progesterone receptor status"},{"letter":"B","text":"High ‘S’ phase"},{"letter":"C","text":"Aneuploidy"},{"letter":"D","text":"Decreased Her-2-neu oncogene"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Decreased Her-2-neu oncogene","explanation":"d. Decreased Her-2-neu oncogene"},{"n":143,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"In breast cancer following are expressed: (PGI Dec 2007)","options":[{"letter":"A","text":"Her-2-neu"},{"letter":"B","text":"p53"},{"letter":"C","text":"BRCA-1"},{"letter":"D","text":"BCL-1"},{"letter":"E","text":"CEA"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"HER-2-neu, B. p53, C. BRCA-1, E. CEA","explanation":"Bloom-Richardson Grading (TNM) | 1. Tubule formationQ 2. Nuclear pleomorphismQ | 3. Mitotic countQ\nDuplicate: same question text and options as Chapter 1 Q56.\nAnswer (book): Answer: A. HER-2-neu, B. p53, C. BRCA-1, E. CEA"},{"n":144,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"Features, which are evaluated for histological grading of breast carcinoma, include all of the following except: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Tumour necrosis"},{"letter":"B","text":"Mitotic count"},{"letter":"C","text":"Tubule formation"},{"letter":"D","text":"Nuclear pleomorphism"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tumour necrosis","explanation":"a. Tumour necrosis (Ref: Bailey 27/e p872)\nBloom-Richardson Grading (TNM)\n1. Tubule formationQ  2. N uclear pleomorphismQ  3. M itotic countQ"},{"n":145,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"The most important prognostic factor in breast carcinoma is: (All India 2006)","options":[{"letter":"A","text":"Histological grade of the tumour"},{"letter":"B","text":"Stage of the tumour at the time of diagnosis"},{"letter":"C","text":"Status of estrogen and progesterone receptors"},{"letter":"D","text":"Over expression of p53 tumor suppressor gene"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Stage of the tumour at the time of diagnosis","explanation":"b. Stage of the tumour at the time of diagnosis"},{"n":146,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"Molecular classification of breast cancer is based on: (AIIMS November 2014)","options":[{"letter":"A","text":"Serum hormone levels"},{"letter":"B","text":"Expression of hormone receptors (ER/PR)"},{"letter":"C","text":"In-vitro response to chemotherapeutic agents"},{"letter":"D","text":"Gene expression profiling"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Gene expression profiling","explanation":"Molecular classification of breast cancer is based on gene expression profiling. Gene expression\nprofiling, which can measure the relative quantities of mRNA for essentially every gene, has identified five major\npatterns of gene expression in the NST group: luminal A, luminal B, normal, basal-like, and HER2 positive. These\nmolecular classes correlate with prognosis and response to therapy, and thus have taken on clinical importance.\n-Robbins 8/e p1084 One of the most exciting aspects of breast cancer biology has been its recent subdivision into at\nleast five subtypes based upon gene expression profiling. -Harrison 19/e p526\nAnswer (book): Answer: D. Gene expression profiling\nReference: Harrison 19/e p526; Schwartz 9/e p453; Sabiston 20/e p839, 19/e p842-845"},{"n":147,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"Estrogen receptor studies in carcinoma breast is done on: (JIPMER 87)","options":[{"letter":"A","text":"Blood"},{"letter":"B","text":"Urine"},{"letter":"C","text":"Tumour tissue"},{"letter":"D","text":"Ovary"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Tumour tissue","explanation":"c. Tumour tissue (Ref: Schwartz 9/e p453; Sabiston 19/e p842-845; Sabiston 20/e p840, 19/e p844; Bailey 27/e p878, 26/e p816)"},{"n":148,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 143","pdfPage":131,"stem":"Oncotype Dx test is done to for the following in breast cancer: (AIIMS May 2015)","options":[{"letter":"A","text":"Chemotherapy in hormone receptor positive patients"},{"letter":"B","text":"Hormone therapy in hormone positive"},{"letter":"C","text":"Chemotherapy in hormone receptor negative patients"},{"letter":"D","text":"Herceptin in Her-2-neu +ve"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Chemotherapy in hormone receptor positive patients","explanation":"http://www.cancercare.on.ca/common/pages/UserFile.aspx?fileld=291504\nOncotype DX may be used to guide chemotherapy decisions among certain women with:\n• Node-negativeQ\n• Hormone receptor-positiveQ\n• HER2-negative breast cancerQ\nThe Oncotype DX, PAM5O, and Mamma Print are multigene tests that are being used clinically for early-stage\nbreast cancer to predict recurrence risk and guide adjuvant chemotherapy decisions.\nAnswer (book): Answer: A. Chemotherapy in hormone receptor positive patients\nReference: Harrison 19/e p528; http://www.oncotypedx.com/http://education.nccn. org/node/11346."},{"n":149,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"In the cases of carcinoma breast with Her-2 neu immunohistochemistry staining, which of the following score needs further FISH study? (AIIMS November 2017)","options":[{"letter":"A","text":"0"},{"letter":"B","text":"1+"},{"letter":"C","text":"2+"},{"letter":"D","text":"3+"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"2+","explanation":"“Scoring of HER-2 Immunohistochemistry Assays: Only membrane staining of the invasive tumor\nshould be considered when scoring IHC tests. If a commercial kit assay system is used, it is recommended that\nlaboratories adhere strictly to the kit assay protocol and scoring methodology. Local modifications of techniques can\nlead to false-positive and false-negative assay results. The scoring method recommended is a semi quantitative\nsystem based on the intensity of reaction product and percentage of membrane positive cells, giving a score of 0 to\n3+. Samples scoring 3+ are regarded as positive and those scoring 0/1+ as negative. Borderline scores of 2+ require\nconfirmation with use of another analysis system, ideally FISH.”-Diagnostic Histopathology of Tumors By Christopher\nD. M. Fletcher 4/e p1117\nAnswer (book): Answer: C. 2+\nReference: Sabiston 20/e p840, 857; Diagnostic Histopathology of Tumors By Christopher D. M. Fletcher 4/e p1117"},{"n":150,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Most common histo-immunological type of breast cancer: (Recent Question 2017)","options":[{"letter":"A","text":"Luminal A"},{"letter":"B","text":"Luminal B"},{"letter":"C","text":"Basal cell type"},{"letter":"D","text":"Her-2-neu type"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Luminal A","explanation":"a. Luminal A (Ref: Sabiston 20/e p840)"},{"n":151,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Luminal A breast cancer shows following feature: (PGI May 2018)","options":[{"letter":"A","text":"Low-grade tumor"},{"letter":"B","text":"Her-2-neu amplification"},{"letter":"C","text":"Good prognosis"},{"letter":"D","text":"High-grade tumor"},{"letter":"E","text":"ER-negative"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Low-grade tumor, C. Good prognosis","explanation":"a. Low-grade tumor, c. Good prognosis (Ref: Sabiston 20/e p840)"},{"n":152,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Poor prognosis of breast carcinoma is associated with: (PGI May 2018)","options":[{"letter":"A","text":"Over expression of Her-2-neu"},{"letter":"B","text":"Increased estrogen & progesterone receptor expression"},{"letter":"C","text":"Triple negative tumor"},{"letter":"D","text":"Decreased percentage of cells in ‘S’ phase of mitosis"},{"letter":"E","text":"Increased percentage of cells expressing Ki-67 marker"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Over expression.., C. Triple negative, E. Increased percentage of cells expressing Ki-67 marker","explanation":"a. Over expression.., c. Triple negative, e. Increased percentage of cells expressing Ki-67 marker  (Ref: Schwartz 10/e p535-536;\nBailey 27/e p875)"},{"n":153,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Which of the following is incorrect about triple negative breast cancer? (Recent Question 2016)","options":[{"letter":"A","text":"Does not express the genes for ER, PR and Her-2-neu"},{"letter":"B","text":"More common in postmenopausal women"},{"letter":"C","text":"Germline mutations of BRCA1 and BRCA2 genes increases the risk"},{"letter":"D","text":"Very susceptible to chemotherapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"More common in postmenopausal women","explanation":"Triple-Negative Breast Cancer\n• Tends to be more aggressiveQ than other types of breast cancer.\n• Tends to be higher gradeQ than other types of breast cancer.\n• Usually is a cell type called “basal-like”Q\nAnswer (book): Answer: B. More common in postmenopausal women\nReference: Bailey 27/e p878; Schwartz 10/e p515"},{"n":154,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Distressing complication after modified radical mastectomy? (Kerala PG 2015, APPG 2008, Orissa 90)","options":[{"letter":"A","text":"Lymphedema"},{"letter":"B","text":"Axillary vein thrombosis"},{"letter":"C","text":"Seroma"},{"letter":"D","text":"Death"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lymphedema","explanation":"a. Lymphedema (Ref: Schwartz 10/e p549; Sabiston 20/e p852; Bailey 27/e p879)"},{"n":155,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"The tumour, which may occur in the residual breast or overlying skin following wide local excision and radiotherapy for mammary carcinoma is: (Recent Question 2016, All India 2004)","options":[{"letter":"A","text":"Leiomyosarcoma"},{"letter":"B","text":"Squamous cell carcinoma"},{"letter":"C","text":"Basal cell carcinoma"},{"letter":"D","text":"Angiosarcoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Angiosarcoma","explanation":"d. Angiosarcoma (Ref: Schwartz 10/e p549; Sabiston 20/e p848; Bailey 27e p879)"},{"n":156,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Complication of post mastectomy lymphedema is: (JIPMER 95)","options":[{"letter":"A","text":"Metastases of cancer"},{"letter":"B","text":"Recurrence"},{"letter":"C","text":"Lymphosarcoma"},{"letter":"D","text":"Pain"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lymphosarcoma","explanation":"c. Lymphosarcoma"},{"n":157,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Pain along medial aspect of arm in a post-mastectomy patient is due to: (DNB 2009, 2008)","options":[{"letter":"A","text":"Phantom breast pain"},{"letter":"B","text":"Intercostobrachial neuralgia"},{"letter":"C","text":"Neuroma pain"},{"letter":"D","text":"Other nerve injury pain"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Intercostobrachial neuralgia","explanation":"b. Intercostobrachial neuralgia (Ref: Medical Care of Cancer Patients by Sai-Ching Jim Yeung, Carmen P. Escalanate, Robert F)"},{"n":158,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Winging of scapula is seen after mastectomy due to injury of: (Recent Question 2017)","options":[{"letter":"A","text":"Musculocutaneous nerve"},{"letter":"B","text":"Long thoracic nerve of Bell"},{"letter":"C","text":"Intercostobrachial nerve"},{"letter":"D","text":"Thoracodorsal nerve"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Long thoracic nerve of Bell","explanation":"b. Long thoracic nerve of Bell (Ref: Schwartz 10/e p548; Sabiston 20/e p848)"},{"n":159,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Most common complication of mastectomy: (Recent Question 2017)","options":[{"letter":"A","text":"Intercostobrachial nerve palsy"},{"letter":"B","text":"Long thoracic nerve palsy"},{"letter":"C","text":"Thoracodorsal palsy"},{"letter":"D","text":"Angiosarcoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Intercostobrachial nerve palsy","explanation":"a. Intercostobrachial nerve palsy (Ref: Schwartz 10/e p502)"},{"n":160,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"In a post mastectomy patient, the suction drain is accidentally removed on 2nd postoperative day and the lady started to have ooze with swelling in the chest. Next option in management in this case is: (Recent Question 2018)","options":[{"letter":"A","text":"Open incision and pack with saline gauze"},{"letter":"B","text":"Aspiration followed by pressure dressing and one more aspiration only"},{"letter":"C","text":"Re-insert the drain"},{"letter":"D","text":"Wait and watch"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Open incision and pack with saline gauze","explanation":"a. Open incision and pack with saline gauze (Ref: Schwartz 10/e p549; Sabiston 20/e p852; Bailey 27/e p879)"},{"n":161,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Reconstruction surgery in breast carcinoma, best myocutaneous flap is: (UPPG 2009)","options":[{"letter":"A","text":"Pectoralis minor"},{"letter":"B","text":"Pectoralis major"},{"letter":"C","text":"Latissimus dorsi"},{"letter":"D","text":"Transverse rectus abdominis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Transverse rectus abdominis","explanation":"d. Transverse rectus abdominis (Ref: Schwartz 10/e p549-550; Sabiston 20/e p867; Bailey 26/e p816-817)"},{"n":162,"chapter":"Breast","src":"question on PDF p. 131 · answer on PDF p. 144","pdfPage":131,"stem":"Flap commonly used in breast reconstruction is: (Recent Question 2014)","options":[{"letter":"A","text":"Serratus anterior"},{"letter":"B","text":"TRAM"},{"letter":"C","text":"Flap from arm"},{"letter":"D","text":"Delto pectoral flap"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"TRAM","explanation":"b. TRAM (Ref: Schwartz 10/e p549-550; Sabiston 20e/ p867; Bailey 27/ep 879)"},{"n":163,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"All of the following are used for reconstruction of breast except: (AIIMS Nov 2000)","options":[{"letter":"A","text":"Transverse rectus abdominis myocutaneous flap"},{"letter":"B","text":"Latissimus dorsi myocutaneous flap"},{"letter":"C","text":"Pectoralis major myocutaneous flap"},{"letter":"D","text":"Transversus rectus abdominis free flap"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pectoralis major myocutaneous flap","explanation":"c. Pectoralis major myocutaneous flap"},{"n":164,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"Which of the following flaps gives best cosmetic results for breast reconstruction? (MHPGMCET 2008)","options":[{"letter":"A","text":"Pectoralis major muscle flap"},{"letter":"B","text":"Latissimus dorsi flap"},{"letter":"C","text":"Transversus rectus abdominis muscle flap"},{"letter":"D","text":"Serratus anterior muscle flap"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Transversus rectus abdominis muscle flap","explanation":"c. Transversus rectus abdominis muscle flap"},{"n":165,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"Most malignant type of carcinoma breast is: (Recent Question 2015)","options":[{"letter":"A","text":"Paget’s disease"},{"letter":"B","text":"Anaplastic carcinoma"},{"letter":"C","text":"Scirrhous carcinoma"},{"letter":"D","text":"Atrophic Scirrhous carcinoma"},{"letter":"E","text":"Mastitis carcinomatosa"}],"multi":null,"correctSet":["E"],"answerIdx":4,"answerLetter":"E","answerText":"Mastitis carcinomatosa","explanation":"• MC type of CA breast: Invasive ductal carcinomaQ\n• Most malignant type of CA breast: Inflammatory breast cancerQ\nAnswer (book): Answer: E. Mastitis carcinomatosa\nReference: Schwartz 10/e p555; Sabiston 20/e p860"},{"n":167,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"True about breast carcinoma in men: (Recent Question 2016)","options":[{"letter":"A","text":"Estrogen receptor positive"},{"letter":"B","text":"Associated with gynaecomastia"},{"letter":"C","text":"Radiotherapy contraindicated due to close proximity to chest wall"},{"letter":"D","text":"Seen in young males"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Estrogen receptor positive, B. Associated with gynaecomastia","explanation":"a. Estrogen receptor positive, b. Associated with gynaecomastia (Ref: Schwartz 10/e p555; Sabiston 20/e p861; Bailey 27/e p862)"},{"n":168,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"What is true about male breast carcinoma? (DPG 2008)","options":[{"letter":"A","text":"Gynaecomastia is a predisposing factor"},{"letter":"B","text":"More common on right side"},{"letter":"C","text":"Tamoxifen is not given"},{"letter":"D","text":"No estrogen present"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gynaecomastia is a predisposing factor","explanation":"• Male breast cancer is preceded by gynecomastia in 20% of menQ.\nAnswer (book): Answer: A. Gynaecomastia is a predisposing factor\nReference: Schwartz 9/e p468; Sabiston 20/e p861; Bailey 25/e p848"},{"n":169,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"True regarding male breast cancer: (PGI June 2009)","options":[{"letter":"A","text":"MC lobular type"},{"letter":"B","text":"Estrogen receptor positive"},{"letter":"C","text":"History of gynaecomastia may be present"},{"letter":"D","text":"Paget’s disease of nipple is more common in male than female"},{"letter":"E","text":"Undescended testis is a risk factor"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Estrogen receptor positive, C. History of gynaecomastia may be present, E. Undescended testis is a","explanation":"b. Estrogen receptor positive, c. History of gynaecomastia may be present, e. Undescended testis is a risk factor"},{"n":170,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"True about male breast cancer is all except: (MHPGMCET 2009)","options":[{"letter":"A","text":"Less than 2% of all cases of breast cancer"},{"letter":"B","text":"Most commonly it is infiltrating duct carcinoma"},{"letter":"C","text":"Most commonly it is infiltrating lobular carcinoma"},{"letter":"D","text":"Exocrine or endocrine estrogen exposure can predispose to it"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Most commonly it is infiltrating lobular carcinoma","explanation":"c. Most commonly it is infiltrating lobular carcinoma"},{"n":171,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"True abort male breast cancer: (Recent Question 2014)","options":[{"letter":"A","text":"Invasive lobular carcinoma is most common type"},{"letter":"B","text":"ER is negative"},{"letter":"C","text":"Seen in young males"},{"letter":"D","text":"BRCA-2 mutation is associated with increased risk"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"BRCA‑2 mutation is associated with increased risk","explanation":"d. BRCA-2 mutation is associated with increased risk"},{"n":172,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 144","pdfPage":132,"stem":"Most common carcinoma breast in male is: (Recent Question 2014)","options":[{"letter":"A","text":"LCIS"},{"letter":"B","text":"DCIS"},{"letter":"C","text":"Invasive ductal cancer"},{"letter":"D","text":"Invasive lobular cancer"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Invasive ductal cancer","explanation":"c. Invasive ductal cancer"},{"n":173,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"True about breast cancer in pregnancy:","options":[{"letter":"A","text":"Occurs in 1 of every 3000 pregnant women"},{"letter":"B","text":"MC non-gynecologic malignancy associated with preg nancy"},{"letter":"C","text":"Ductal carcinoma is MC type, accounting for 75-90% of breast cancer in pregnancy"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above (Ref: Schwartz 10/e p554; Sabiston 20/e p2059-2060; Bailey 27/e p881)\nMONDOR’S DISEASE"},{"n":174,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Mondor’s disease is: (MCI June 2018, Recent Question 2015, 2014) (DNB 2014, All India 96)","options":[{"letter":"A","text":"Thrombophlebitis of the superficial veins of breast"},{"letter":"B","text":"Carcinoma of the breast"},{"letter":"C","text":"Premalignant condition of the breast"},{"letter":"D","text":"Filariasis of the breast"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thrombophlebitis of the superficial veins of breast","explanation":"a. Thrombophlebitis of the superficial veins of breast (Ref: Schwartz 10/e p507; Sabiston 19/e p1594; Bailey 27/e p867)"},{"n":175,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Mondor’s disease is superficial thrombophlebitis of: (COMEDK 2005)","options":[{"letter":"A","text":"Axillary vein"},{"letter":"B","text":"Long saphenous vein"},{"letter":"C","text":"Veins of the breast"},{"letter":"D","text":"Internal mammary vein"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Veins of the breast","explanation":"c. Veins of the breast"},{"n":176,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Treatment of choice in duct papilloma of breast is: (Kerala PG 2015, All India 98, All India 96)","options":[{"letter":"A","text":"Simple mastectomy"},{"letter":"B","text":"Microdochectomy"},{"letter":"C","text":"Local wide excision"},{"letter":"D","text":"Chemotherapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Microdochectomy","explanation":"b. Microdochectomy (Ref: Bailey 27/e p865)"},{"n":177,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Treatment for duct ectasia: (Recent Question 2014, MAHE 2008)","options":[{"letter":"A","text":"Hadfield’s operation"},{"letter":"B","text":"Patey’s mastectomy"},{"letter":"C","text":"Modified radical mastectomy"},{"letter":"D","text":"Radical mastectomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hadfield’s operation","explanation":"a. Hadfield’s operation (Ref: Bailey 27/e p865)"},{"n":178,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Slit shaped nipple is seen in: (Recent Question 2015)","options":[{"letter":"A","text":"Duct ectasia"},{"letter":"B","text":"Duct papilloma"},{"letter":"C","text":"Paget’s disease"},{"letter":"D","text":"CA breast"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Duct ectasia","explanation":"a. Duct ectasia"},{"n":179,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"A woman noticed mass in her left breast with bloody discharge. Histopathology revealed duct ectasia. Treatment is: (AIIMS Nov 2008)","options":[{"letter":"A","text":"Simple mastectomy"},{"letter":"B","text":"Microdochotomy"},{"letter":"C","text":"Lobectomy"},{"letter":"D","text":"Hadfield’s operation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hadfield’s operation","explanation":"d. Hadfield’s operation"},{"n":180,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Using a small fine probe, single lactiferous duct is excised. What is the name of the procedure? (Recent Question 2018)","options":[{"letter":"A","text":"Macrodochectomy"},{"letter":"B","text":"Microdochectomy"},{"letter":"C","text":"Webster operation"},{"letter":"D","text":"Hadfield operation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Microdochectomy","explanation":"“Microdochectomy: A lacrimal probe or length of stiff nylon suture is inserted into the duct from which\nthe discharge is emerging. A tennis racquet incision can be made to encompass the entire duct or a periareolar\nincision used and the nipple flap dissected to reach the duct. The duct is then excised.”- Bailey 27/e p865\nAnswer (book): Answer: B. Microdochectomy\nReference: Bailey 27/e p865"},{"n":181,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Sign seen in large duct papilloma is: (DNB 2012)","options":[{"letter":"A","text":"Nipple discharge"},{"letter":"B","text":"Breast mass"},{"letter":"C","text":"Skin excoriation"},{"letter":"D","text":"Lymph node involvement"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nipple discharge","explanation":"a. Nipple discharge"},{"n":182,"chapter":"Breast","src":"question on PDF p. 132 · answer on PDF p. 145","pdfPage":132,"stem":"Treatment of cystosarcoma phyllodes in a young woman: (JIPMER 2011)","options":[{"letter":"A","text":"Wide excision with a margin"},{"letter":"B","text":"Wide excision with chemotherapy"},{"letter":"C","text":"Wide excision with radiotherapy"},{"letter":"D","text":"MRM"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Wide excision with a margin","explanation":"a. Wide excision with a margin (Ref: Schwartz 10/e p555; Sabiston 20/e p841-842; Bailey 27/e p870)"},{"n":183,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"A 50 years old female presented with the given tumor in the OPD. The tumor was found to be malignant on biopsy. What is the best treatment option?","options":[{"letter":"A","text":"Breast conservation surgery"},{"letter":"B","text":"Simple mastectomy"},{"letter":"C","text":"Wide local excision"},{"letter":"D","text":"Modified radical mastectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Simple mastectomy","explanation":"On the basis of clinical findings, patient is having malignant cystosarcoma phyllodes, which is best\ntreated by simple mastectomy.\nAnswer (book): Answer: B. Simple mastectomy\nReference: Schwartz 10/e p555; Sabiston 20/e p841; Bailey 27/e p870"},{"n":184,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Cystosarcoma phyllodes is treated by: (Recent Question 2015, AIIMS May 93)","options":[{"letter":"A","text":"Simple mastectomy"},{"letter":"B","text":"Radical mastectomy"},{"letter":"C","text":"Modified radical mastectomy"},{"letter":"D","text":"Antibiotic with conservative treatment"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Simple mastectomy","explanation":"a. Simple mastectomy"},{"n":185,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Which one of the following statements is true of cystosarcoma phyllodes? (UPSC 96)","options":[{"letter":"A","text":"It is a malignant tumour"},{"letter":"B","text":"It often metastasizes to axillary nodes"},{"letter":"C","text":"It is usually bulky and may fungate through the skin"},{"letter":"D","text":"It is treated by radical mastectomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"It is usually bulky and may fungate through the skin","explanation":"c. It is usually bulky and may fungate through the skin"},{"n":186,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"A mobile, variegated large lump in the breast of a 20-years old female is most likely to be due to: (UPSC 97)","options":[{"letter":"A","text":"Medullary carcinoma"},{"letter":"B","text":"Inflammatory carcinoma"},{"letter":"C","text":"Cystosarcoma phyllodes"},{"letter":"D","text":"Lobular carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cystosarcoma phyllodes","explanation":"c. Cystosarcoma phyllodes"},{"n":187,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"True about cystosarcoma phyllodes is: (DNB 2007)","options":[{"letter":"A","text":"Calcification"},{"letter":"B","text":"Cystic compondent"},{"letter":"C","text":"Tendency to recur"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above"},{"n":188,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Most common sarcoma of breast: (Recent Question 2015)","options":[{"letter":"A","text":"Angiosarcoma"},{"letter":"B","text":"Phyllodes tumor"},{"letter":"C","text":"Kaposi sarcoma"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Phyllodes tumor","explanation":"b. Phyllodes tumor"},{"n":189,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"True about phyllodes tumor is: (PGI May 2018)","options":[{"letter":"A","text":"Associated with BRCA1"},{"letter":"B","text":"FNAC can diagnose reliability"},{"letter":"C","text":"Treated with mastectomy"},{"letter":"D","text":"Axillary lymph nodes are commonly involved"},{"letter":"E","text":"Associated with BRCA2"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Treated with mastectomy","explanation":"c. Treated with mastectomy (Ref: Schwartz 10/e p555; Sabiston 20/e p841-842; Bailey 27/e p870)\nGYNECOMASTIA"},{"n":190,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Gynecomastia may be seen in all of the following conditions except: (All India 98)","options":[{"letter":"A","text":"Klinefelter’s syndrome"},{"letter":"B","text":"Cirrhosis of liver"},{"letter":"C","text":"Cryptorchidism"},{"letter":"D","text":"Sex-cord tumour of sertoli cells"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cryptorchidism","explanation":"c. Cryptorchidism (Ref: Schwartz 10/e p505-506; Sabiston 20/e p824; Bailey 27/e p882)"},{"n":191,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"All of the following statements about gynecomastia are true except: (All India 2007)","options":[{"letter":"A","text":"Subcutaneous mastectomy is the initial treatment of choice"},{"letter":"B","text":"Seen in liver disease"},{"letter":"C","text":"There may be estrogen/testosterone imbalance"},{"letter":"D","text":"Can be drug induced"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Subcutaneous mastectomy is the initial treatment of choice","explanation":"a. Subcutaneous mastectomy is the initial treatment of choice  (Ref: Schwartz 10/e p505-506; Sabiston 20/e p824; Bailey 27/e p882;\nWilliams Endocrinology 10/e p741)"},{"n":192,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"All are true regarding gynaecomastia except: (AIIMS Nov 93)","options":[{"letter":"A","text":"May be seen in Addison’s disease"},{"letter":"B","text":"Usually unilateral in young males"},{"letter":"C","text":"Acini are not involved"},{"letter":"D","text":"Bilaterality is due to endocrinopathy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"May be seen in Addison’s disease, B. Usually unilateral in young males","explanation":"a. May be seen in Addison’s disease, b. Usually unilateral in young males"},{"n":193,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Gynaecomastia may be seen in patient with all except: (Recent Question 2016)","options":[{"letter":"A","text":"Cimetidine therapy"},{"letter":"B","text":"Cirrhosis of liver"},{"letter":"C","text":"Klinefelter’s syndrome"},{"letter":"D","text":"Turner’s syndrome"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Turner’s syndrome","explanation":"d. Turner’s syndrome"},{"n":194,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"An adolescent boy presents with bilateral prominence of breasts and wants the breasts to be removed. Which one of the following incisions would be ideal? (UPSC 97)","options":[{"letter":"A","text":"Radial"},{"letter":"B","text":"Incision along the areolar margin"},{"letter":"C","text":"Submammary incision"},{"letter":"D","text":"Elliptical incision"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Incision along the areolar margin","explanation":"b. Incision along the areolar margin"},{"n":195,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Which of the following is least likely to be associated with gynecomastia? (All India 2012)","options":[{"letter":"A","text":"Prolactinoma"},{"letter":"B","text":"Adrenal tumors"},{"letter":"C","text":"hCG secreting tumors"},{"letter":"D","text":"Estrogen secreting tumors"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Prolactinoma","explanation":"Prolactinoma\n• Prolactinomas are essentially associated with galactorrhea, not the gynecomastiaQ.\n• Gynecomastia does not result from either excess or deficiency of prolactin.\nAnswer (book): Answer: A. Prolactinoma\nReference: Harrison 20/e 92676, 19/e p2267"},{"n":196,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Paget’s disease of breast, true statements are: (PGI Nov 2009)","options":[{"letter":"A","text":"Intraductal carcinoma"},{"letter":"B","text":"Mastectomy needed"},{"letter":"C","text":"Malignant"},{"letter":"D","text":"Bilateral"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Intraductal carcinoma, B. Mastectomy needed, C. Malignant","explanation":"a. Intraductal carcinoma, b. Mastectomy needed, c. Malignant (Ref: Schwartz 10/e p506-521; Sabiston 20/e p860-861; Bailey 27/e p873)"},{"n":197,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"A 40-year-old female presented to your OPD with this lesion in the left breast. What is the most probable diagnosis?","options":[{"letter":"A","text":"DCIS"},{"letter":"B","text":"LCIS"},{"letter":"C","text":"Peau-d’orange"},{"letter":"D","text":"Paget’s disease of nipple"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Paget’s disease of nipple","explanation":"d. Paget’s disease of nipple"},{"n":198,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Consider the following statements regarding Paget’s disease of the breast: 1.It is a malignant disease 2. Diagnosis can be established by scrape cytology 3. Lymph nodes involvement is an associated clinical feature 4. Treatment of choice is simple mastectomy Which of the statements given above is/are correct? (UPSC 2008)","options":[{"letter":"A","text":"1, 2 and 4 only"},{"letter":"B","text":"1, 2 and 3 only"},{"letter":"C","text":"3 and 4 only"},{"letter":"D","text":"1, 2, 3 and 4"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"1, 2, 3 and 4","explanation":"d. 1, 2, 3 and 4"},{"n":199,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Paget’s disease: (DPG 2006)","options":[{"letter":"A","text":"Incidence is 1:1000"},{"letter":"B","text":"Has underlying intralobular carcinoma"},{"letter":"C","text":"May have underlying carcinoma"},{"letter":"D","text":"Blood stained discharge"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"May have underlying carcinoma","explanation":"c. May have underlying carcinoma"},{"n":200,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Primarily a disease of nipple and areola: (DNB 2007)","options":[{"letter":"A","text":"Duct papilloma"},{"letter":"B","text":"Paget’s disease"},{"letter":"C","text":"Periductal mastitis"},{"letter":"D","text":"Fibroadenoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Paget’s disease","explanation":"b. Paget’s disease"},{"n":201,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Paget’s disease of breast following are true except: (Recent Question 2015)","options":[{"letter":"A","text":"Treated by simple mastectomy"},{"letter":"B","text":"Represents underlying malignancy"},{"letter":"C","text":"Presents as eczema"},{"letter":"D","text":"Cytology diagnostic"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cytology diagnostic","explanation":"d. Cytology diagnostic"},{"n":202,"chapter":"Breast","src":"question on PDF p. 133 · answer on PDF p. 145","pdfPage":133,"stem":"Characteristic feature of Paget’s cell is: (Kerala 94)","options":[{"letter":"A","text":"Eosinophilic cytoplasm"},{"letter":"B","text":"Abundant clear cytoplasm"},{"letter":"C","text":"Glycogen mass"},{"letter":"D","text":"Multinucleated giant cell"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Abundant clear cytoplasm","explanation":"b. Abundant clear cytoplasm"},{"n":203,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"True about Paget’s disease of the nipple is: (Kerala 95)","options":[{"letter":"A","text":"Always there is underlying carcinoma"},{"letter":"B","text":"Often bilateral eczema of nipple seen"},{"letter":"C","text":"Histology reveals giant cells"},{"letter":"D","text":"Highly malignant"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Always there is underlying carcinoma","explanation":"a. Always there is underlying carcinoma"},{"n":204,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"All are true about Paget disease of breast except: (DNB 2014)","options":[{"letter":"A","text":"1% associated with underlying invasive carcinoma of breast"},{"letter":"B","text":"Hormone receptor negative"},{"letter":"C","text":"Poor prognosis"},{"letter":"D","text":"Wedge or punch is biopsy taken from nipple for diagnosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"1% associated with underlying invasive carcinoma of breast","explanation":"a. 1% associated with underlying invasive carcinoma of breast"},{"n":205,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"Following are true of Paget’s disease of breast except: (Karnataka 98)","options":[{"letter":"A","text":"Usually bilateral"},{"letter":"B","text":"Associated intraductal carcinoma"},{"letter":"C","text":"Prognosis good in absence of lump"},{"letter":"D","text":"Treatment simple mastectomy with axillary clearance"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Usually bilateral","explanation":"a. Usually bilateral"},{"n":206,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"Which of the following is the first line drug for mastitis? (Recent Question 2019)","options":[{"letter":"A","text":"Cloxacillin"},{"letter":"B","text":"Cefazolin"},{"letter":"C","text":"Ampicillin"},{"letter":"D","text":"Metronidazole"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cloxacillin","explanation":"a. Cloxacillin (Ref: Sabiston 20/e p836; Bailey 27/e p866)"},{"n":207,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"A lady primigravida developed fluctuant painful mass of breast and fever after 14 days of delivery. Preferred treatment option is: (Recent Question 2019)","options":[{"letter":"A","text":"Stop lactation"},{"letter":"B","text":"Analgesics and continue breastfeeding"},{"letter":"C","text":"Antipyretic"},{"letter":"D","text":"Incision and drainage"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Incision and drainage","explanation":"d. Incision and drainage (Ref: Schwartz 10/e p506; Sabiston 20/e p836; Bailey 27/e p866)"},{"n":208,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 145","pdfPage":134,"stem":"Which is not having underlying malignancy? (APPG 2008)","options":[{"letter":"A","text":"Paget disease of bone"},{"letter":"B","text":"Paget disease of nipple"},{"letter":"C","text":"Paget disease of vulva"},{"letter":"D","text":"Paget disease of anal region"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Paget disease of bone","explanation":"a. Paget disease of bone"},{"n":209,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Retromammary abscess arises from:","options":[{"letter":"A","text":"Tuberculous rib"},{"letter":"B","text":"Infected hematoma"},{"letter":"C","text":"Chronic empyema"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Retromammary Breast Abscess\n• It may an extension of Breast abscess, Empyema thoracis, Osteomyelitis of the ribsQ\n• No need to drain retromammary abscess, only conservative treatmentQ\nAnswer (book): Answer: D. All of the above\nReference: http://nobleboss.awardspace.com/mednotes/surgnotes/operativ/ebreast_abscess.htm"},{"n":210,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Acute mastitis commonly occurs during: (DNB 2000)","options":[{"letter":"A","text":"Pregnancy"},{"letter":"B","text":"Puberty"},{"letter":"C","text":"Lactation"},{"letter":"D","text":"Infancy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lactation","explanation":"Nonepidemic (sporadic) Puerperal Mastitis\nInvolvement of the interlobular connective tissue of the breast by an infectious process. The patient develops\nnipple fissuring and milk stasis, which initiate a retrograde bacterial infectionQ. Emptying of the breast using breast\nsuction pumps shortens the duration of symptomsQ and reduces the incidence of recurrences. The addition of\nantibiotic therapyQ results in a satisfactory outcome in >95% of cases.\nAnswer (book): Answer: C. Lactation\nReference: Schwartz 10/e p506; Sabiston 20/e p836; Bailey 27/e p866"},{"n":211,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"A lactating female presented with breast abscess. Most common organism responsible for her mastitis and abscess formation is: (Recent Queston 2014, Punjab 2011)","options":[{"letter":"A","text":"S. aureus"},{"letter":"B","text":"E. coli"},{"letter":"C","text":"Streptococci"},{"letter":"D","text":"Anaerobes"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"S. aureus","explanation":"a. S. aureus (Ref: Schwartz 10/e p506; Sabiston 20/e p836; Bailey 27/e p866)"},{"n":212,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Fibroadenoma of the breast are:","options":[{"letter":"A","text":"Fixed mass"},{"letter":"B","text":"Diffuse mass"},{"letter":"C","text":"Multiple diffuse mass"},{"letter":"D","text":"Solitary mobile mass"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Solitary mobile mass","explanation":"d. Solitary mobile mass (Ref: Bailey 27/e p870; Schwartz 10/e p510; Sabiston 20/e p836)"},{"n":213,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"A young female came to the surgery OPD with bilateral breast mass. On examination, mass was firm and mobile. What is the diagnosis on the basis of findings?","options":[{"letter":"A","text":"Breast cyst"},{"letter":"B","text":"Fibroadenoma"},{"letter":"C","text":"DCIS"},{"letter":"D","text":"LCIS"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Fibroadenoma","explanation":"Pattern of Calcification in Breast Diseases Carcinoma\nMicrocalcification, punctate, branchingQ | Fibroadenoma | PopcornQ (coarse, granular, crushed stone) | Fibrocystic\ndisease | Powdery | Fat necrosis | Curvilinear\nAnswer (book): Answer: B. Fibroadenoma\nReference: Schwartz 10/e p510; Bailey 27/e p870"},{"n":214,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Pre-menstrual fullness in breast in 21-years old unmarried female is: (AIIMS 98)","options":[{"letter":"A","text":"Galactocele"},{"letter":"B","text":"Fibroadenoma"},{"letter":"C","text":"Fibroadenosis"},{"letter":"D","text":"Breast cancer"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Fibroadenosis","explanation":"• Fibroadenosis or fibrocystic disease is the cause of pre-menstrual fullness in breast in 21 years old unmarried\nfemale.\n• Rest of the options are highly unlikely.\nAnswer (book): Answer: C. Fibroadenosis\nReference: Schwartz 10/e p507; Sabiston 20/e p824; Bailey 27/e p869"},{"n":215,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Regarding cystic disease of breast, which one is true? (AIIMS Nov 97)","options":[{"letter":"A","text":"Common in 25 years of age"},{"letter":"B","text":"Excision is the treatment"},{"letter":"C","text":"May turn into malignant"},{"letter":"D","text":"Aspiration is the treatment"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Aspiration is the treatment","explanation":"d. Aspiration is the treatment (Ref: Schwartz 10/e p51; Bailey 27/e p869)"},{"n":216,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"The following are suitable for simple mastectomy except: (Recent Question 2013)","options":[{"letter":"A","text":"Pagets disease"},{"letter":"B","text":"Fibroadenoma"},{"letter":"C","text":"Cystosarcoma phyllodes"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Fibroadenoma","explanation":"b. Fibroadenoma"},{"n":217,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"A 17-year-old female underwent Fine Needle Aspiration cytology (FNAC) for a lump in the breast which was nontender, firm and mobile. Which of the following features would suggest finding of a benign breast disease? (AIIMS November 2014, May 2013)","options":[{"letter":"A","text":"Dyscohesive ductal epithelial cells without cellular fragments"},{"letter":"B","text":"Tightly arranged ductal epithelial cells with dyscohesive bare nuclei"},{"letter":"C","text":"Stromal predominance with spindle cells"},{"letter":"D","text":"Polymorphism with single or arranged ductal epithelial cells"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tightly arranged ductal epithelial cells with dyscohesive bare nuclei","explanation":"Fibroadenoma:\n• Diagnostic findings on needle biopsy consist of:\n– Abundant stromal cells which appear as bare bipolar nuclei\n– Sheets of fairly uniform-size epithelial cells that are typically arranged in either an antler like pattern or a\nhoneycomb pattern.\n– Foam cells and apocrine cells may also be seen, although these are less diagnostic features.\nAnswer (book): Answer: B. Tightly arranged ductal epithelial cells with dyscohesive bare nuclei\nReference: Winfred Grays diagnostic cytopathology 2/e p279-280"},{"n":218,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 146","pdfPage":134,"stem":"Cracked nipple may be:","options":[{"letter":"A","text":"Due to syphilitic chancre"},{"letter":"B","text":"Cause of retention cyst"},{"letter":"C","text":"Paget’s disease of nipple"},{"letter":"D","text":"Forerunner of breast abscess"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Forerunner of breast abscess","explanation":"Cracked Nipple\n• This may occur during lactation and be the forerunner of acute infective mastitisQ.\n• If the nipple becomes cracked during lactation, it should be rested for 24–48 hours and the breast should be\nemptied with a breast pumpQ.\n• Feeding should be resumed as soon as possible.\nAnswer (book): Answer: D. Forerunner of breast abscess\nReference: Bailey 27/e p863"},{"n":219,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"A 50 years old lady presented with lump in the left breast, which has developed suddenly in weeks. Perimenstrual symptoms are present. No associated family history. On examination, the lump is well circumscribed, fluctuant, 1.5 cm oval in shape. Most likely diagnosis: ( JIPMER May 2018)","options":[{"letter":"A","text":"Breast cyst"},{"letter":"B","text":"Galactocele"},{"letter":"C","text":"Fibroadenoma"},{"letter":"D","text":"Breast cancer"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Breast cyst","explanation":"• Mostly occur in last decade of reproductive life, as a result of non-integrated involution of stroma & epithelium.\nClinical Features\n• Often multiple, may be bilateral & can mimic malignancy; Typically present suddenly Diagnosis\n• Diagnosis can be confirmed by aspiration and/or ultrasound. Treatment\n• Aspiration: In cases of solitary cyst or cyst with small collection (Reaspiration in cases of recurrence)\nBreast Cysts\nAnswer (book): Answer: A. Breast cyst\nReference: Bailey 27/e p869"},{"n":220,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"Lymphatic drainage of breast: (PGI Dec 2003)","options":[{"letter":"A","text":"Axillary"},{"letter":"B","text":"Supraclavicular"},{"letter":"C","text":"Internal mammary"},{"letter":"D","text":"Mediastinal"},{"letter":"E","text":"Celiac"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Axillary, B. Supraclavicular, C. Internal mammary","explanation":"a. Axillary, b. Supraclavicular, c. Internal mammary"},{"n":221,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"Breast examination is done yearly in patients with: (PGI 88)","options":[{"letter":"A","text":"Multiple fibroadenoma"},{"letter":"B","text":"Family history of CA breast"},{"letter":"C","text":"Carcinoma cervix"},{"letter":"D","text":"Endometrial carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Family history of CA breast","explanation":"b. Family history of CA breast"},{"n":222,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"A 50 years old woman complains of intermittent bleeding from the left nipple over the past 3 months. No mass is palpable, but a bead of blood can be expressed from the nipple. The ideal procedure in this case would be: (UPSC 97)","options":[{"letter":"A","text":"Cytological examination of discharge and if no malignant cells, to be kept under careful observation"},{"letter":"B","text":"Segmental excision of breast"},{"letter":"C","text":"Microdochotomy"},{"letter":"D","text":"Simple mastectomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Microdochotomy","explanation":"c. Microdochotomy"},{"n":223,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"Tylectomy literally means: (DNB 91)","options":[{"letter":"A","text":"Excision of a lump"},{"letter":"B","text":"Excision of LN"},{"letter":"C","text":"Excision of breast"},{"letter":"D","text":"Excision of skin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Excision of a lump","explanation":"• Lumpectomy (Tylectomy): Surgical procedure designed to remove a discrete lump\nAnswer (book): Answer: A. Excision of a lump"},{"n":224,"chapter":"Breast","src":"question on PDF p. 134 · answer on PDF p. 147","pdfPage":134,"stem":"True about galactorrhoea: (PGI Dec 2008)","options":[{"letter":"A","text":"Always bilateral"},{"letter":"B","text":"Found in pregnancy and lactation"},{"letter":"C","text":"Associated with prolactinoma and other endocrinopathies"},{"letter":"D","text":"Surgery is done"},{"letter":"E","text":"Hypothyroidism can cause galactorrhoea"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Associated with prolactinoma and other endocrinopathies, D. Surgery is done, E. Hypothyroidism","explanation":"c. Associated with prolactinoma and other endocrinopathies, d. Surgery is done, e. Hypothyroidism can cause galactorrhoea\n(Ref: Harrison 20/e p2676, 19/e p2267; Dutta Gynecology 5/e p548-549)"},{"n":225,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"Large breast is not seen in: (AIIMS Dec 95)","options":[{"letter":"A","text":"Filariasis"},{"letter":"B","text":"Giant fibroadenoma"},{"letter":"C","text":"Cystosarcoma phylloides"},{"letter":"D","text":"Schirrhous carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Schirrhous carcinoma","explanation":"Causes of Massive Breast Enlargement | 1. Benign hypertrophyQ (usually bilateral) | 4. SarcomaQ | 2.\nCystosarcoma phyllodesQ | 5. Colloid carcinomaQ | 3. Giant fibroadenomaQ | 6. Filarial elephanitiasisQ\nAnswer (book): Answer: D. Schirrhous carcinoma\nReference: Norman Brows/e p277"},{"n":226,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"A 14 years old healthy girl of normal height and weight for age, complains that her right breast has developed twice the size of her left breast since the onset of puberty at the age of 12. Both breasts have a similar consistency on palpation with normal nipples areolae. The most likely cause for these findings is: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Cystosarcoma phyllodes"},{"letter":"B","text":"Virginal hypertrophy"},{"letter":"C","text":"Fibrocystic disease"},{"letter":"D","text":"Early state of carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Virginal hypertrophy","explanation":"Virginal Hypertrophy Massive enlargement of usually both breasts It can also be unilateral Usually\noccurs due to an alteration in the normal sensitivity of the breast to estrogenic hormonesQ Treatment: Reduction\nmammoplastyQ\nAnswer (book): Answer: B. Virginal hypertrophy\nReference: CPDT 16/e p1128"},{"n":227,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"Haagensen’s sing of inoperability of carcinoma include all except: (DNB 91)","options":[{"letter":"A","text":"Edema of skin of breast or arm"},{"letter":"B","text":"Satellite tumor nodules in skin of breast"},{"letter":"C","text":"Proved supraclavicular or distant metastases"},{"letter":"D","text":"Parasternal tumorous growth"},{"letter":"E","text":"None of the above"}],"multi":null,"correctSet":["E"],"answerIdx":4,"answerLetter":"E","answerText":"None of the above","explanation":"Haagensen’s Criteria of Inoperability\n1. Extensive edema of the breastQ\n5. A parasternal tumorQ, indicating spread to the Q internal mammary LNs\n2. Satellite nodule of carcinoma | 6. Edema of armQ | 3. Inflammatory carcinomaQ | 7. Distant metastasisQ | 4.\nSupraclavicular metastasisQ\nAnswer (book): Answer: E. None of the above\nReference: NMS surgery 4/e p456"},{"n":228,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"Unilateral amastia is associated 90% of the time with absence or hypoplasia of following muscle: (COMEDK 2004)","options":[{"letter":"A","text":"Latissimus doris"},{"letter":"B","text":"Subclavian"},{"letter":"C","text":"Pectoral"},{"letter":"D","text":"Serratus anterior"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pectoral","explanation":"c. Pectoral (Ref: Bailey 27/e p865)"},{"n":229,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"True about leiomyosarcoma breast: (PGI Nov 2010)","options":[{"letter":"A","text":"Axillary lymph node dissection is mandatory"},{"letter":"B","text":"Well encapsulated"},{"letter":"C","text":"Follow up not required"},{"letter":"D","text":"Mastectomy is mainstay treatment"},{"letter":"E","text":"Metastasize by lymphatic channel"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Well encapsulated, D. Mastectomy is mainstay treatment","explanation":"b. Well encapsulated, d. Mastectomy is mainstay treatment (Ref: Cancer of Breast by Donegau 5/e p933-936; Breast Cancer by Roses 2/e\np207-208)"},{"n":230,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"Most frequent site of accessory breast: (Orissa 2011)","options":[{"letter":"A","text":"Axilla"},{"letter":"B","text":"Groin"},{"letter":"C","text":"Buttock"},{"letter":"D","text":"Thigh"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Axilla","explanation":"a. Axilla (Ref: Bailey 27/e p865)"},{"n":231,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 147","pdfPage":135,"stem":"Zuska’s disease common is smokers causes: (DNB 2012, 2007)","options":[{"letter":"A","text":"Acute mastitis"},{"letter":"B","text":"Chronic areolar abscess"},{"letter":"C","text":"Fibroadenosis"},{"letter":"D","text":"Acute abscess formation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chronic areolar abscess","explanation":"Zuska’s Disease (Recurrent Periductal Mastitis)\n• Condition of recurrent retroareolar infections and abscesses\n• Smoking has been implicated as a risk factor\n• Managed symptomatically by antibiotics with incision and drainage Prognosis\n• The prognosis is favorable, with 5- and 10-year survival rates of 74 and 51%, respectively.\nQ\nAnswer (book): Answer: B. Chronic areolar abscess\nReference: Schwartz 10/e p506"},{"n":232,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"Lymphatic from left upper quadrant of breast brain into all of the following group of lymphnodes except: (DNB 2001)","options":[{"letter":"A","text":"Anterior axillary"},{"letter":"B","text":"Central"},{"letter":"C","text":"Apical"},{"letter":"D","text":"Parasternal"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Parasternal","explanation":"d. Parasternal (Ref: Bailey 27/e p873)"},{"n":233,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"A lady 35 years old lactating mother presented with a painful breast lump. Most appropriate initial investigation should be: (AIIMS Nov 2012)","options":[{"letter":"A","text":"Mammography"},{"letter":"B","text":"USG"},{"letter":"C","text":"MRI"},{"letter":"D","text":"X-ray"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"USG","explanation":"Indications of Breast Ultrasound Symptomatic breast lump in women <35 years Breast lump during\nlactation and pregnancy Assessment of mammographic abnormality Assessment of MRI or scintimammography\ndetected lesions (± further mammographic views) chemotherapy\n• Guidance of needle biopsy or localization\n• Clinical breast mass with negative mammogram\n• Breast inflammation\n• Augmented breast (together with MRI)\n• Breast lumps in males (together with MRI)\n• Follow-up of breast carcinoma treated with adjuvant\nAnswer (book): Answer: B. USG\nReference: Sutton’s Radiology 7/e p1456; Schwartz 9/e p467; Sabiston 20/e p828; Bailey 27/e p861"},{"n":234,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"In patients of breast pain, primrose oil is used for how many months? (Recent Question 2017)","options":[{"letter":"A","text":"1"},{"letter":"B","text":"2"},{"letter":"C","text":"3"},{"letter":"D","text":"4"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"3","explanation":"“Treatment of mastalgia: Oil of evening primrose, in adequate doses given over 3 months, will help\nmore than half of these women” –Bailey 27/e p869\nAnswer (book): Answer: C. 3\nReference: Bailey 27/e p869"},{"n":235,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"In sentinel node biopsy for breast cancer, the most commonly injured nerve is: (AIIMS May 2013)","options":[{"letter":"A","text":"Lateral pectoral nerve"},{"letter":"B","text":"Nerve to lattissimus dorsi"},{"letter":"C","text":"Intercostobrachial nerve"},{"letter":"D","text":"Long thoracic nerve (Nerve to serratus anterior)"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Intercostobrachial nerve","explanation":"c. Intercostobrachial nerve"},{"n":236,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"Intraoperative sentinel lymph node detection in axilla is done by using: (Recent Question 2013)","options":[{"letter":"A","text":"Mammography"},{"letter":"B","text":"Isosulfan blue dye"},{"letter":"C","text":"MRI"},{"letter":"D","text":"CT"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Isosulfan blue dye","explanation":"b. Isosulfan blue dye (Ref: Schwartz 10/e p545)"},{"n":237,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"Sentinel lymph node biopsy in carcinoma breast is done if: (Recent Question 2013)","options":[{"letter":"A","text":"LN palpable"},{"letter":"B","text":"Breast mass but no lymph node palpable"},{"letter":"C","text":"Breast lump with palpable axillary node"},{"letter":"D","text":"Metastatic CA breast"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Breast mass but no lymph node palpable","explanation":"b. Breast mass but no lymph node palpable (Ref: Schwartz 10/e 545)"},{"n":238,"chapter":"Breast","src":"question on PDF p. 135 · answer on PDF p. 148","pdfPage":135,"stem":"Radioisotope used in sentinel lymph node biopsy in breast: (Recent Question 2017)","options":[{"letter":"A","text":"Technetium iodine"},{"letter":"B","text":"Technetium labeled colloid sulfur"},{"letter":"C","text":"Tc99"},{"letter":"D","text":"Iodine-131"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Technetium labeled colloid sulfur","explanation":"“Lymphatic mapping can be performed with a combination of 99mTc-labeled sulfur colloid and a vital\nblue dye, isosulfan blue (Lymphazurin), or with a single agent for localization of the sentinel node.”-Sabiston 20/e\np850\n226 MCQs · questions on PDF pp. 165–174 · answers and explanations on PDF pp. 175–186\nAnswer (book): Answer: B. Technetium labeled colloid sulfur\nReference: Schwartz 10/e p545; Sabiston 20/e p850; Bailey 27/e p877"},{"n":1,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"A 35 years old female presented with a swelling in the neck for the past 2 months, she had the treatment for Hodgkin’s lymphoma when she was 22 years with irradiation. On, examination, her vitals were normal, there was a single, firm, irregular nodule, moving with deglutition in the left side of midline. Clinical examination also revealed a single node in the left side of the neck. The most likely clinical diagnosis of this condition is: (COMEDK 2011)","options":[{"letter":"A","text":"Recurrence of lymphoma"},{"letter":"B","text":"Malignant goiter"},{"letter":"C","text":"Benign multinodular goiter"},{"letter":"D","text":"Toxic nodular goiter"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Malignant goiter","explanation":"b. Malignant goiter (Ref: Schwartz 10/e p1542-1544; Sabiston 20/e p902; Bailey 27/e p818; Harrison 20/e p2715, 19/e p2305)"},{"n":2,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Most probable pathological diagnosis would be: (COMEDK 2011)","options":[{"letter":"A","text":"Anaplastic carcinoma"},{"letter":"B","text":"Follicular carcinoma"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Papillary carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Papillary carcinoma","explanation":"d. Papillary carcinoma"},{"n":3,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"The FNAC of the lesion should reveal: (COMEDK 2011)","options":[{"letter":"A","text":"‘Orphan-Annie eye’ nucleus cells"},{"letter":"B","text":"Amyloid deposits"},{"letter":"C","text":"Epitheloid cells and giant cells"},{"letter":"D","text":"Follicular cells"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"‘Orphan-Annie eye’ nucleus cells","explanation":"a. ‘Orphan-Annie eye’ nucleus cells"},{"n":4,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"The ideal treatment of the above condition would be: (COMEDK 2011)","options":[{"letter":"A","text":"Total thyroidectomy with lymph nodal dissection of the same side"},{"letter":"B","text":"Radiotherapy"},{"letter":"C","text":"Lobectomy"},{"letter":"D","text":"Lobectomy with isthmusectomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Total thyroidectomy with lymph nodal dissection of the same side","explanation":"a. Total thyroidectomy with lymph nodal dissection of the same side"},{"n":5,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"About papillary carcinoma what is/are true? (PGI Dec 2008)","options":[{"letter":"A","text":"Often encapsulated"},{"letter":"B","text":"Prognosis is bad"},{"letter":"C","text":"Lymph node metastases is common"},{"letter":"D","text":"Can metastasize to lung"},{"letter":"E","text":"Multiple foci of tumour is seen"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lymph node metastases is common; D. Can metastasize to lung; E. Multiple foci of tumour is seen","explanation":"Papillary carcinoma are rarely encapsulatedQ\nAnswer (book): Answer: C. Lymph node metastases is common; D. Can metastasize to lung; E. Multiple foci of tumour is seen"},{"n":6,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Variant of papillary carcinoma thyroid: (PGI June 2007)","options":[{"letter":"A","text":"Medullary"},{"letter":"B","text":"Warthin"},{"letter":"C","text":"Columnar"},{"letter":"D","text":"Insular"},{"letter":"E","text":"Diffuse sclerosing"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Columnar d. Insular; E. Diffuse sclerosing","explanation":"p793-796\nTypes of Papillary Carcinoma Associated with Poor Prognosis\n1. Tall cellQ | 2. InsularQ | 3. ColumnarQ | 4. Diffuse sclerosingQ | 5. Clear cellQ | 6. TrabecularQ | 7. Poorly\ndifferentiated type\nAnswer (book): Answer: C. Columnar d. Insular; E. Diffuse sclerosing\nReference: Schwartz 10/e p1542, 9/e p1361-1363; Sabiston 20/e p902, 19/e p906-909; Bailey 27/e p818, 26/e p765, 25/e"},{"n":7,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Which of the following would be the best treatment for a 2 cm thyroid nodule in a 50-year-old man with FNAC revealing it to be a papillary carcinoma? (AIIMS May 2011)","options":[{"letter":"A","text":"Hemithyroidectomy"},{"letter":"B","text":"Total thyroidectomy with left sided modified neck dissection"},{"letter":"C","text":"Near total thyroidectomy with radiotherapy"},{"letter":"D","text":"Hemithyroidectomy with modified neck dissection"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Total thyroidectomy with left sided modified neck dissection","explanation":"b. Total thyroidectomy with left sided modified neck dissection"},{"n":8,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Psammoma bodies may be seen in all of the following, except: (Recent Question 2016, All India 2011)","options":[{"letter":"A","text":"Follicular carcinoma of thyroid"},{"letter":"B","text":"Papillary carcinoma of thyroid"},{"letter":"C","text":"Meningioma"},{"letter":"D","text":"Serous cystadenocarcinoma of ovary"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular carcinoma of thyroid","explanation":"Psammoma Bodies (PSM) | 1. Papillary carcinoma thyroidQ | 3. Serous cystadenomaQ | 2. Papillary\ncarcinoma (RCC) Q | 4. MeningiomaQ\nAnswer (book): Answer: A. Follicular carcinoma of thyroid\nReference: Schwartz 10/e p1542; Sabiston 20/e p902; Bailey 27/e p818"},{"n":9,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Features of papillary carcinoma includes: (PGI May 2011)","options":[{"letter":"A","text":"FNAC easy"},{"letter":"B","text":"Almost always unifocal"},{"letter":"C","text":"Psammoma body"},{"letter":"D","text":"Spread to cervical LN"},{"letter":"E","text":"Bad prognosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"FNAC easy; C. Psammoma body; D. Spread to cervical LN","explanation":"a. FNAC easy; c. Psammoma body; d. Spread to cervical LN"},{"n":10,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"About papillary carcinoma true statement is/are: (PGI Nov 2010)","options":[{"letter":"A","text":"Radiation is a risk factor"},{"letter":"B","text":"Multifocal"},{"letter":"C","text":"Hematogenous spread is common"},{"letter":"D","text":"Distant metastasis is seen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Radiation is a risk factor; B. Multifocal; D. Distant metastasis is seen","explanation":"a. Radiation is a risk factor; b. Multifocal; d. Distant metastasis is seen"},{"n":11,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Most common thyroid malignancy is: (DNB 2012, MHPGMCET 2002)","options":[{"letter":"A","text":"Anaplastic carcinoma"},{"letter":"B","text":"Follicular carcinoma"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Papillary carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Papillary carcinoma","explanation":"d. Papillary carcinoma"},{"n":12,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"Which thyroid malignancy is common after radiation exposure? (Recent Question 2016, MHSSMCET 2005)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Papillary"},{"letter":"C","text":"Medullary"},{"letter":"D","text":"Anaplastic"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Papillary","explanation":"b. Papillary"},{"n":13,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 175","pdfPage":165,"stem":"A 10 years old boy presented with cervical lymph adenopathy. Needle biopsy from the nodes revealed secondaries from papillary carcinoma of thyroid. The child under went complete removal of tumor near total thyroidectomy and radical neck dissection. What should be the immediate next line of management? (All India 2012)","options":[{"letter":"A","text":"Start thyroxine suppression therapy"},{"letter":"B","text":"I-131 whole body scan to assess the extent of disease"},{"letter":"C","text":"Bone scan to evaluate secondaries"},{"letter":"D","text":"CECT scan to assess any residual disease"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Start thyroxine suppression therapy","explanation":"Well Differentiated Thyroid Cancer\n1. Papillary carcinoma of thyroid\n3. Follicular variant of papillary carcinoma thyroidQ Q\n2. Follicular carcinoma of thyroidQ\n4. Hurthle cell carcinoma (variant of follicular carcinoma thyroid) Q\nPostoperative Management of Well-differentiated Thyroid Cancer Radioiodine Therapy\n• Postoperative RAI therapy reduces recurrence and provides a small improvement in survival, even in low-risk\npatientsQ.\n• Metastatic differentiated thyroid carcinoma can be detected and treated by 131I in about 75% of patientsQ.\n• RAI effectively treats >70% of lung micrometastasesQ that are detected by RAI scan in the presence of a normal\nchest x-ray, whereas the success rates drop to <10% with pulmonary macrometastases. Early detection\ntherefore appears to be very important to improve prognosis. RAI Ablation Currently is Recommended for\nAll patients with stage III or IV diseaseQ All patients with stage II disease <45 yearsQ Most patients 45 years or older\nwith stage II diseaseQ Patients with stage I disease who have aggressive histologies, nodal metastases, multifocal\ndisease, and extrathyroid or vascular invasionQ\n• T4 therapy should be discontinued for 6 weeks before scanning with 131I. Patients should receive T3 during this\ntime period to decrease the period if hypothyroidism. T3 has a shorter half-life than T4 (1 day vs. 1 week) and\nneeds to be discontinued for 2 weeks to allow TSH levels to rise before treatmentQ.\n• A low-iodine diet also is recommended during this 2-week periodQ.\n• The usual protocol involves administering a screening dose of 1 to 3 mCi of 123I and measuring uptake 24 hours\nlater. After a total thyroidectomy, this value should be <1%. A “hot” spot in the neck after initial screening\nusually represents residual normal tissue in the thyroid bed.\n• If there is significant uptake, then a therapeutic dose of 131I, 30 to 100 mCiQ should be administered to low-risk\npatients and 100 to 200 mCi in high-risk patientsQ.\n• Approximately one third of these patients demonstrate uptake on posttreatment imaging, and Tg levels usually\ndecrease in these patients, documenting therapeutic benefitQ.\n• Patients with previously positive scans and patients with serum Tg levels >2 ng/mLQ usually need another 131I\ntreatment after 6 to 12 months until one or two negative scans are obtained.\n• The follow-up scan can be done after hormone withdrawal or after recombinant TSH. The latter is more\nexpensiveQ but is preferred by patients. External Beam Radiotherapy and Chemotherapy\n• EBRT is occasionally required to control unresectable, locally invasive or recurrent disease and to treat\nmetastases in support bonesQ to decrease the risk of fractures.\n• EBRT is of value for the treatment and control of pain from bony metastasesQ when there is minimal or no RAIUQ.\n• Single and multidrug chemotherapy has been used with little successQ in disseminated thyroid cancer, and there\nis no role for routine chemotherapy\n• Doxorubicin (Adriamycin) and paclitaxel (Taxol) are the most frequently used agents. Thyroid Hormone\n• T4 is necessary as replacement therapyQ in patients after total or near-total thyroidectomy\n• Has the additional effect of suppressing TSHQ and reducing the growth stimulusQ for any possible residual thyroid\ncancer cellsQ.\n• TSH suppression reduces tumor recurrence ratesQ.\n• T4 should be administered to ensure that the patient remains euthyroidQ, with circulating TSH levels at about 0.1\nU/L in low-risk patients, or <0.1 U/mL in high-risk patients.\nAnswer (book): Answer: A. Start thyroxine suppression therapy\nReference: Schwartz 10/e p1549; Sabiston 20/e p906; Bailey 27/e p819"},{"n":14,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"Orphan Annie-eye nuclei seen in: (Orissa 2011)","options":[{"letter":"A","text":"Papillary carcinoma of thyroid"},{"letter":"B","text":"Medullary carcinoma of thyroid"},{"letter":"C","text":"Anaplastic carcinoma of thyroid"},{"letter":"D","text":"Follicular carcinoma of thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary carcinoma of thyroid","explanation":"a. Papillary carcinoma of thyroid"},{"n":15,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"Psammoma bodies are seen in following except: (PGI 2002)","options":[{"letter":"A","text":"Serous cystadenoma of ovary"},{"letter":"B","text":"Mucinous cystadenoma of ovary"},{"letter":"C","text":"Meningioma"},{"letter":"D","text":"Papillary carcinoma of thyroid"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mucinous cystadenoma of ovary","explanation":"b. Mucinous cystadenoma of ovary"},{"n":16,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"Which of the following would be the best treatment for a 2 cm thyroid nodule in a 50 years old man with FNAC revealing it to be a papillary carcinoma? (All India 2009) (Recent Question 2015)","options":[{"letter":"A","text":"Hemithyroidectomy"},{"letter":"B","text":"Subtotal thyroidectomy with modified neck dissection"},{"letter":"C","text":"Near total thyroidectomy with modified neck dissection"},{"letter":"D","text":"Hemithyroidectomy with modified neck dissection"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Near total thyroidectomy with modified neck dissection","explanation":"c. Near total thyroidectomy with modified neck dissection"},{"n":17,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"True regarding papillary carcinoma of thyroid: (MCI March 2006)","options":[{"letter":"A","text":"Undifferentiated carcinoma"},{"letter":"B","text":"Blood-borne metastasis is commoner"},{"letter":"C","text":"Excellent prognosis"},{"letter":"D","text":"Capsulated"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Excellent prognosis","explanation":"c. Excellent prognosis"},{"n":18,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"Which type of thyroid carcinoma has the best prognosis? (DNB 2010, All India 96)","options":[{"letter":"A","text":"Papillary carcinoma"},{"letter":"B","text":"Anaplastic carcinoma"},{"letter":"C","text":"Follicular carcinoma"},{"letter":"D","text":"Medullary carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary carcinoma","explanation":"a. Papillary carcinoma"},{"n":19,"chapter":"Thyroid","src":"question on PDF p. 165 · answer on PDF p. 176","pdfPage":165,"stem":"Compared to follicular carcinoma, papillary carcinoma of thyroid have: (PGI Dec 2007, June 2005, Dec 2006)","options":[{"letter":"A","text":"More male preponderance"},{"letter":"B","text":"Bilaterality"},{"letter":"C","text":"Local recurrence common"},{"letter":"D","text":"Increased lymph node metastasis"},{"letter":"E","text":"Increased mortality"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bilaterality; C. Local recurrence common; D. Increased lymph node metastasis","explanation":"Papillary | Follicular | + | ++Q | Lymph node metastasis | +++Q | + | Blood vessel invasion | + | +++Q\n| Recurrence rate | + | ++Q | Overall mortality | + | ++Q | Male incidence\nLocation of recurrent carcinoma Distant metastasis\n+ | ++ | Nodal metastasis | Q | +++ | + | Local recurrence | ++Q | + | Bilaterality | +++Q | +\nAnswer (book): Answer: B. Bilaterality; C. Local recurrence common; D. Increased lymph node metastasis\nReference: Schwartz 10/e p1542-1545; Sabiston 20/e p902, 904"},{"n":20,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 176","pdfPage":166,"stem":"Occult thyroid malignancy with nodal metastasis is: (DNB 2005, 2001, AIIMS Sept 96)","options":[{"letter":"A","text":"Medullary carcinoma"},{"letter":"B","text":"Follicular carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Anaplastic carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Papillary carcinoma","explanation":"c. Papillary carcinoma"},{"n":21,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 176","pdfPage":166,"stem":"Least malignant thyroid cancer is: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Papillary carcinoma"},{"letter":"B","text":"Follicular carcinoma"},{"letter":"C","text":"Anaplastic carcinoma"},{"letter":"D","text":"Medullary carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary carcinoma","explanation":"a. Papillary carcinoma"},{"n":22,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 176","pdfPage":166,"stem":"Lateral aberrant thyroid refers to: (AIIMS June 2002)","options":[{"letter":"A","text":"Congenital thyroid abnormality"},{"letter":"B","text":"Metastatic foci from primary in thyroid"},{"letter":"C","text":"Struma ovarii"},{"letter":"D","text":"Lingual thyroid"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Metastatic foci from primary in thyroid","explanation":"Lateral Aberrant Thyroid\n• Any thyroid tissue found laterally separate from the thyroid gland, is always considered to be a metastasis in a\ncervical lymph nodeQ, as aberrant thyroid tissue never occurs in lateral position.\n• Aberrant thyroid tissues are found along the course of the thyroglossal tract: − LingualQ − CervicalQ − ThoracicQ\n• Papillary carcinoma of thyroid is MC associatedQ with lateral aberrant thyroid\nAnswer (book): Answer: B. Metastatic foci from primary in thyroid\nReference: Schwartz 10/e p1542; Sabiston 20/e p903"},{"n":23,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Which of the following is used in the treatment of differentiated thyroid cancer? (All India 2006)","options":[{"letter":"A","text":"I-131"},{"letter":"B","text":"99mTc"},{"letter":"C","text":"P-32"},{"letter":"D","text":"I-131 MIBG"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"I-131","explanation":"a. I-131"},{"n":24,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"In treatment of papillary carcinomas thyroid, radioiodine destroys the neoplastic cells predominantly by: (AIIMS Nov 2005)","options":[{"letter":"A","text":"X-rays"},{"letter":"B","text":"Beta rays"},{"letter":"C","text":"Gamma rays"},{"letter":"D","text":"Alpha particles"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Beta rays","explanation":"b. Beta rays (Schwartz 10/e p1546; Sabiston 20/e p908; William’s Endocrinology 10/e p479)"},{"n":25,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"A 21 years old woman has 3 cm node in the lower deep cervical chain on the left. The biopsy is interpreted as revealing normal thyroid tissue in a lymph node. The most likely diagnosis is: (DNB 2012, DPG 2009 Feb)","options":[{"letter":"A","text":"Subacute thyroiditis"},{"letter":"B","text":"Metastatic carcinoma thyroid"},{"letter":"C","text":"Hashimoto’s disease"},{"letter":"D","text":"Lateral aberrant thyroid"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Lateral aberrant thyroid","explanation":"d. Lateral aberrant thyroid"},{"n":26,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"All of the following regarding papillary carcinoma thyroid is true except: (All India 90)","options":[{"letter":"A","text":"Multicentric origin"},{"letter":"B","text":"Secondaries to lymph nodes"},{"letter":"C","text":"Slowing growing"},{"letter":"D","text":"Bony metastasis in early stage"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Bony metastasis in early stage","explanation":"d. Bony metastasis in early stage (Ref: Schwartz 9/e p1362, 1363, 1367, 1368; Sabiston 20/e p902, 904, 909, 910; Bailey 27/e p818)"},{"n":27,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Most common type of carcinoma thyroid having least chances of hematogenous spread: (Recent Question 2015)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Papillary"},{"letter":"C","text":"Anaplastic"},{"letter":"D","text":"Medullary"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Papillary","explanation":"b. Papillary"},{"n":28,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Chance of metastasis to lymph nodes in PTC: (Recent Question 2017)","options":[{"letter":"A","text":"<10%"},{"letter":"B","text":"10–20%"},{"letter":"C","text":"20–40%"},{"letter":"D","text":">60%"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":">60%","explanation":"d. >60% (Ref: Schwartz 10/e p1542; Sabiston 20/e p904)"},{"n":29,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Orphan-Annie eye nuclei is seen in: (Recent Question 2017)","options":[{"letter":"A","text":"Papillary carcinoma thyroid"},{"letter":"B","text":"Follicular carcinoma thyroid"},{"letter":"C","text":"Medullary carcinoma thyroid"},{"letter":"D","text":"Anaplastic carcinoma thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary carcinoma thyroid","explanation":"a. Papillary carcinoma thyroid (Ref: Schwartz 10/e p1542; Sabiston 20/e p903)"},{"n":30,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Psammoma bodies are seen in: (Recent Question 2017)","options":[{"letter":"A","text":"Papillary carcinoma thyroid"},{"letter":"B","text":"Follicular carcinoma thyroid"},{"letter":"C","text":"Medullary carcinoma thyroid"},{"letter":"D","text":"Thyroid lymphoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary carcinoma thyroid","explanation":"a. Papillary carcinoma thyroid (Ref: Schwartz 10/e p1542; Sabiston 20/e p903)"},{"n":31,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"A 27-year-old lady with 20 weeks pregnancy presented with a thyroid nodule on right side. FNAC from the nodule was suggestive of papillary carcinoma. Which of the following is contraindicated in her management? (AIIMS May 2017)","options":[{"letter":"A","text":"Total thyroidectomy plus neck node dissection"},{"letter":"B","text":"Right lobectomy"},{"letter":"C","text":"Radioactive iodine ablation"},{"letter":"D","text":"Total thyroidectomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Radioactive iodine ablation","explanation":"c. Radioactive iodine ablation  (Ref: Schwartz 10/e p1546; Sabiston 20/e p906; Bailey 27/e p819)"},{"n":32,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"All of the following are true for follicular carcinoma of thyroid except: (COMEDK 2006)","options":[{"letter":"A","text":"Lymph node involvement rare"},{"letter":"B","text":"Vascular involvement common"},{"letter":"C","text":"Younger patients have good prognosis"},{"letter":"D","text":"Diagnosis by FNAC"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Diagnosis by FNAC","explanation":"Limitations of FNAC in Thyroid Diseases\n1. Not able to distinguish follicular adenoma from follicular carcinomaQ\n2. Not able to distinguish Hurthle cell adenoma from Hurthle cell carcinomaQ\n3. Useless in Reidel’s thyroiditisQ (Biopsy is preferred)Q\n4. FNAC is less reliable in patients who have history of head and neck irradiation or family history of thyroid cancer\ndue to higher likelihood of multifocal lesions and occult cancerQ\nAnswer (book): Answer: D. Diagnosis by FNAC\nReference: Fef: Schwartz 10/e p1544, 1357; Sabiston 20/e p906; Bailey 27/e p818"},{"n":33,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Thyroid carcinoma with pulsating vascular skeletal metastasis is: (COMEDK 2007, All India 95)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Anaplastic"},{"letter":"C","text":"Medullary"},{"letter":"D","text":"Papillary"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular","explanation":"a. Follicular"},{"n":34,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Follicular carcinoma of thyroid is due to mutation of: (JIPMER 2010)","options":[{"letter":"A","text":"RAS"},{"letter":"B","text":"HGF"},{"letter":"C","text":"RET"},{"letter":"D","text":"ABL"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"RAS","explanation":"• Genes implicated in FCT: p53Q, PTENQ, RasQ , PAX8/PPAR1 Oncogenes and Tumor-Suppressor Genes Implicated\nin Thyroid Tumorigenesis Gene\nFunction | Tumor | RETQ\nMembrane receptor with tyrosine kinase activity\nSporadic and familial MTC, PTC (RET/PTC rearrangements)\nMETQ | Same | Overexpressed in PTC | TRK1 | Same | Activated in some PTC | TSH-R | Linked to heterotrimeric G\nprotein | Hyperfunctioning adenoma | Gs (gsp) | Signal transduction molecule (GTP binding) | Hyperfunctioning\nadenoma, follicular adenoma | RasQ | Signal transduction protein | Follicular adenoma and carcinoma, PTC |\nPAX8/PPAR1 | Oncoprotein | Follicular adenoma, follicular carcinoma | B-Raf (BRAF)Q | Signal transduction\nPTC, tall cell and poorly differentiated, anaplastic\np53Q\nCell cycle regulator, arrests cells in G1, induces apoptosis\nDe-differentiated PTC, FTC, anaplastic cancers\np16Q\nCell cycle regulator, inhibits cyclin dependent kinase\nThyroid cancer cell lines | PTENQ | Protein tyrosine phosphatase | Follicular adenoma and carcinoma | Tumor\nsuppressors\nAnswer (book): Answer: A. RAS\nReference: Schwartz 10/e p1541; Sabiston 20/e p901"},{"n":35,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"A well differentiated follicular carcinoma of thyroid can be best differentiated from a follicular adenoma by: (All India 2011, 2009)","options":[{"letter":"A","text":"Hurthle cell change"},{"letter":"B","text":"Lining of tall columnar and cuboidal cells"},{"letter":"C","text":"Vascular invasion"},{"letter":"D","text":"Nuclear features"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Vascular invasion","explanation":"c. Vascular invasion (Ref: Schwartz 10/e p1544; Sabiston 20/e p904; Bailey 27/e p818; Harrison 20/e p2715, 19/e p2305)"},{"n":36,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"FNAC is useful in all the following types of thyroid carcinoma except: (UPPG 2010, MCI March 2005, All India 95)","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Follicular"},{"letter":"C","text":"Anaplastic"},{"letter":"D","text":"Medullary"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Follicular","explanation":"b. Follicular"},{"n":37,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Most probable malignancy that develops in a case of longstanding goiter is: (MCI June 2018, Recent Question 2015, Kerala PG 2015, AIIMS Feb 97, Nov 2001)","options":[{"letter":"A","text":"Follicular carcinoma"},{"letter":"B","text":"Anaplastic carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Medullary carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular carcinoma","explanation":"a. Follicular carcinoma"},{"n":38,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Bone metastasis is common in which thyroid tumor: (AIIMS Nov 99)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Papillary"},{"letter":"C","text":"Hurthle cell tumour"},{"letter":"D","text":"Anaplastic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular","explanation":"a. Follicular"},{"n":39,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Thyroid nodule of 4 cm size, mobile but causing compressive symptoms. All are true except: (DNB 2011)","options":[{"letter":"A","text":"FNAC is investigation of choice"},{"letter":"B","text":"FNAC cannot distinguish follicular adenoma from carcinoma"},{"letter":"C","text":"Managed by sub-total thyroidectomy"},{"letter":"D","text":"Cold nodules are diagnostic of malignancy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cold nodules are diagnostic of malignancy","explanation":"d. Cold nodules are diagnostic of malignancy"},{"n":40,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"In case of adenomatoid goiter which carcinoma is commonest to occur: (AIIMS Nov 98)","options":[{"letter":"A","text":"Medullary carcinoma"},{"letter":"B","text":"Follicular carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Anaplastic carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Follicular carcinoma","explanation":"b. Follicular carcinoma"},{"n":41,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Carcinoma thyroid with blood borne metastasis is: (AIIMS Feb 97)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Papillary"},{"letter":"C","text":"Medullary"},{"letter":"D","text":"Anaplastic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular; C. Medullary","explanation":"a. Follicular; c. Medullary"},{"n":42,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"Lymph node metastasis is least commonly seen with: (All India 94)","options":[{"letter":"A","text":"Papillary CA Thyroid"},{"letter":"B","text":"Medullary CA Thyroid"},{"letter":"C","text":"Follicular CA Thyroid"},{"letter":"D","text":"Anaplastic CA Thyroid"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Follicular CA Thyroid","explanation":"c. Follicular CA Thyroid"},{"n":43,"chapter":"Thyroid","src":"question on PDF p. 166 · answer on PDF p. 177","pdfPage":166,"stem":"A 20 years old female patient presented with a thyroid swelling. Most probably, the fine needle aspiration cytology will not diagnose: (AIIMS Nov 97)","options":[{"letter":"A","text":"Papillary carcinoma of thyroid"},{"letter":"B","text":"Medullary carcinoma of thyroid"},{"letter":"C","text":"Non-Hodgkin’s lymphoma of thyroid"},{"letter":"D","text":"Follicular carcinoma of thyroid"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Follicular carcinoma of thyroid","explanation":"Oncogenes\nAnswer (book): Answer: D. Follicular carcinoma of thyroid"},{"n":44,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Hurthle cells tumour is: (WBPG 2012, DPG 2007)","options":[{"letter":"A","text":"Papillary carcinoma thyroid"},{"letter":"B","text":"Follicular carcinoma thyroid"},{"letter":"C","text":"Medullary carcinoma thyroid"},{"letter":"D","text":"Anaplastic carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Follicular carcinoma thyroid","explanation":"b. Follicular carcinoma thyroid (Ref: Schwartz 10/e p1546; Sabiston 20/e p910)"},{"n":45,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Metastasis from follicular carcinoma should be treated by: (MCI Sept 2006)","options":[{"letter":"A","text":"Radioiodine"},{"letter":"B","text":"Surgery"},{"letter":"C","text":"Thyroxine"},{"letter":"D","text":"Observation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Radioiodine","explanation":"a. Radioiodine"},{"n":46,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"True regarding follicular carcinoma of thyroid: (JIPMER 2014, 2013)","options":[{"letter":"A","text":"Hematogemous spread"},{"letter":"B","text":"Commonly multifocal"},{"letter":"C","text":"Readily diagnosed by face"},{"letter":"D","text":"Most commonly carcinoma of thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hematogenous spread","explanation":"a. Hematogenous spread"},{"n":47,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"The microscopic feature that differentiates a follicular carcinoma from a follicular adenoma: (COMEDK 2014)","options":[{"letter":"A","text":"Nuclear pleomorphism"},{"letter":"B","text":"Hurthle cell change"},{"letter":"C","text":"Capsular invasion"},{"letter":"D","text":"Absence of colloid"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Capsular invasion","explanation":"c. Capsular invasion"},{"n":48,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"FNAC cannot detect which of the following? (AIIMS November 2014)","options":[{"letter":"A","text":"Follicular carcinoma"},{"letter":"B","text":"Papillary carcinoma"},{"letter":"C","text":"Colloid goiter"},{"letter":"D","text":"Hashimoto’s thyroiditis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular carcinoma","explanation":"a. Follicular carcinoma"},{"n":49,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Screening method of medullary carcinoma thyroid is: (All India 97, AIIMS Nov 95)","options":[{"letter":"A","text":"Serum calcitonin"},{"letter":"B","text":"Serum calcium"},{"letter":"C","text":"Serum alkaline phosphate"},{"letter":"D","text":"Serum acid phosphatase"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Serum calcitonin","explanation":"a. Serum calcitonin (Ref: Schwartz 10/e p1549-1550; Sabiston 20/e p909; Bailey 27/e p820; Harrison 20/e p2716, 19/e p2307)"},{"n":50,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Treatment of medullary carcinoma thyroid: (AIIMS May 2011)","options":[{"letter":"A","text":"Surgery and Radiotherapy"},{"letter":"B","text":"Radiotherapy and Chemotherapy"},{"letter":"C","text":"Surgery only"},{"letter":"D","text":"Radioiodine ablation"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Surgery only","explanation":"c. Surgery only (Ref: Schwartz 10/e p1550; Sabiston 20/e p909; Bailey 27/e p820)"},{"n":51,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"False statement about feature of MTC: (PGI Nov 2011)","options":[{"letter":"A","text":"Familial MTC may presents in 2nd decade"},{"letter":"B","text":"It has characteristic amyloid stroma"},{"letter":"C","text":"Secrete serotonin"},{"letter":"D","text":"Take up radioiodine"},{"letter":"E","text":"Secrete calcitonin"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Take up radioiodine","explanation":"• I131 scan is of no use as MTC is TSH independentQ, so MTC does not take up radioiodine (I131).\nAnswer (book): Answer: D. Take up radioiodine"},{"n":52,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Thyroid radioiodine ablation therapy is useful in all except: (PGI May 2011)","options":[{"letter":"A","text":"Recurrent papillary carcinoma"},{"letter":"B","text":"Residual papillary carcinoma"},{"letter":"C","text":"Anaplastic carcinoma"},{"letter":"D","text":"Follicular carcinoma"},{"letter":"E","text":"Medullary carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Anaplastic carcinoma, E. Medullary carcinoma","explanation":"• Radioactive iodine is used to destroy residual thyroid tissue (thyroid ablation) in well differentiated thyroid\ncancer.\nAnswer (book): Answer: C. Anaplastic carcinoma, E. Medullary carcinoma"},{"n":53,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Age for prophylactic thyroidectomy in MEN IIB syndrome? (MHSSMCET 2009)","options":[{"letter":"A","text":"1 month"},{"letter":"B","text":"2 months"},{"letter":"C","text":"4 months"},{"letter":"D","text":"6 months"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"6 months","explanation":"Prophylactic Thyroidectomy in RET Mutation Carriers MEN-2A\nBefore 5 yearsQ | MEN-2B | Before 1 yearQ\n• Central neck dissection is avoided in childrenQ.\n• Indications of central neck dissection in children:\n1. Raised calcitoninQ | 2. USG suggesting thyroid cancerQ >5 mm | 3. Evidence of LN metastasis\nAnswer (book): Answer: D. 6 months\nReference: Schwartz 9/e p1368; Sabiston 20/e p909"},{"n":54,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Recommended age for prophylactic thyroidectomy for MEN-2 is: (Recent Question 2015)","options":[{"letter":"A","text":"5 years"},{"letter":"B","text":"Before 1 year"},{"letter":"C","text":"At the time of diagnosis"},{"letter":"D","text":"Any time"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"5 years","explanation":"a. 5 years"},{"n":56,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Medullary carcinoma thyroid arises from: (AIIMS Nov 93)","options":[{"letter":"A","text":"Parafollicular cells"},{"letter":"B","text":"Cells lining the acini"},{"letter":"C","text":"Capsule of thyroid"},{"letter":"D","text":"Stroma of the gland"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Parafollicular cells","explanation":"a. Parafollicular cells"},{"n":57,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"A biopsy from a mass in front of the neck revealed parafollicular cells. How do you follow up? (JIPMER November 2017)","options":[{"letter":"A","text":"Calcitonin"},{"letter":"B","text":"T4"},{"letter":"C","text":"Thyroxine"},{"letter":"D","text":"Thyroglobulin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Calcitonin","explanation":"a. Calcitonin (Ref: Schwartz 10/e p1549; Sabiston 20/e p909; Bailey 27/e p820)\n 58. c. Surgery only"},{"n":58,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Treatment of medullary carcinoma thyroid: (AIIMS Nov 2008)","options":[{"letter":"A","text":"Surgery and radiotherapy"},{"letter":"B","text":"Radiotherapy and chemotherapy"},{"letter":"C","text":"Surgery only"},{"letter":"D","text":"Radioiodine ablation"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Surgery only","explanation":"c. Surgery only (Ref: Schwartz 10/e p1550; Sabiston 20/e p909; Bailey 27/e p820)"},{"n":59,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Needle biopsy of solitary thyroid nodule in a young woman with palpable cervical lymph nodes on the same sides demonstrates amyloid in stroma of lesion. Likely diagnosis is: (All India 2002)","options":[{"letter":"A","text":"Medullary carcinoma thyroid"},{"letter":"B","text":"Follicular carcinoma thyroid"},{"letter":"C","text":"Thyroid adenoma"},{"letter":"D","text":"Multinodular goiter"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Medullary carcinoma thyroid","explanation":"a. Medullary carcinoma thyroid"},{"n":60,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"In medullary carcinoma thyroid tumour marker is: (WBPG 2014, AIIMS June 98)","options":[{"letter":"A","text":"TSH"},{"letter":"B","text":"Calcitonin"},{"letter":"C","text":"T3, T4 and TSH"},{"letter":"D","text":"Alpha Fetoprotein"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Calcitonin","explanation":"b. Calcitonin"},{"n":61,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"After thyroidectomy for medullary carcinoma of thyroid, which is important for determining recurrence of tumour? (MCI Sept 2009)","options":[{"letter":"A","text":"Thyroglobulin"},{"letter":"B","text":"TSH"},{"letter":"C","text":"CEA"},{"letter":"D","text":"Thyroxine levels"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"CEA","explanation":"c. CEA"},{"n":62,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"The expression of the following oncogene is associated with a high incidence of medullary carcinoma of thyroid: (AIIMS Nov 2005)","options":[{"letter":"A","text":"p53"},{"letter":"B","text":"Her-2-neu"},{"letter":"C","text":"Ret proto-oncogene"},{"letter":"D","text":"Rb gene"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Ret proto-oncogene","explanation":"c. Ret proto-oncogene"},{"n":63,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"A 26 years old women presents with a palpable thyroid nodule, and needle biopsy demonstrates amyloid in the stroma of the lesion. A cervical lymph node is palpable on the same side as the lesion. The preferred treatment should be: (BIHAR PG 2014, All India 2002)","options":[{"letter":"A","text":"Removal of the involved node, the isthmus, a portion of the opposite bone and he enlarged lymph node"},{"letter":"B","text":"Removal of the involved lobe, the isthmus, a portion of the opposite lobe, and he enlarged lymph node"},{"letter":"C","text":"Total thyroidectomy and modified neck dissection on the side of the enlarged lymph node"},{"letter":"D","text":"Total thyroidectomy and irradiation of the cervical lymph nodes"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Total thyroidectomy and modified neck dissection on the side of enlarged lymph node","explanation":"c. Total thyroidectomy and modified neck dissection on the side of enlarged lymph node"},{"n":64,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"Amyloid stroma is seen in which carcinoma thyroid: (AIIMS June 2000)","options":[{"letter":"A","text":"Papillary carcinoma"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Anaplastic carcinoma"},{"letter":"D","text":"Follicular carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Medullary carcinoma","explanation":"b. Medullary carcinoma"},{"n":65,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"A patient has pituitary tumour and pheochromocytoma and a thyroid nodule. Which carcinoma is most likely to occur? (AIIMS Nov 2000)","options":[{"letter":"A","text":"Follicular carcinoma"},{"letter":"B","text":"Medullary carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Anaplastic carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Medullary carcinoma","explanation":"b. Medullary carcinoma"},{"n":66,"chapter":"Thyroid","src":"question on PDF p. 167 · answer on PDF p. 178","pdfPage":167,"stem":"A 52 years old female patient presents with symptoms of pheochromocytoma. She also has a thyroid carcinoma. Her thyroid carcinoma is of which type: (AIIMS June 99)","options":[{"letter":"A","text":"Anaplastic"},{"letter":"B","text":"Medullary"},{"letter":"C","text":"Follicular"},{"letter":"D","text":"Papillary"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Medullary","explanation":"b. Medullary"},{"n":67,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"MEN-2 is seen with the following type of thyroid carcinoma: (All India 97)","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Medullary"},{"letter":"C","text":"Anaplastic"},{"letter":"D","text":"Follicular"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Medullary","explanation":"b. Medullary"},{"n":68,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Serum calcitonin is a marker for: (DNB 2003, All India 94)","options":[{"letter":"A","text":"Anaplastic carcinoma"},{"letter":"B","text":"Papillary carcinoma"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Follicular carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Medullary carcinoma","explanation":"c. Medullary carcinoma"},{"n":69,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Treatment of choice for medullary carcinoma of thyroid is: (AIIMS May 2005)","options":[{"letter":"A","text":"Total thyroidectomy"},{"letter":"B","text":"Partial thyroidectomy"},{"letter":"C","text":"I-131 ablation"},{"letter":"D","text":"Hemithyroidectomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Total thyroidectomy","explanation":"a. Total thyroidectomy"},{"n":70,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"All of the following are helpful for diagnosis of medullary carcinoma thyroid except: (PGI 2000)","options":[{"letter":"A","text":"Spindle cell stroma with few follicles"},{"letter":"B","text":"Amyloid deposition"},{"letter":"C","text":"Calcitonin in stroma"},{"letter":"D","text":"Histological mitochondria is essential for diagnosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Histological mitochondria is essential for diagnosis","explanation":"d. Histological mitochondria is essential for diagnosis"},{"n":71,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Which of the following gene defects is associated with development of medullary carcinoma of thyroid? (All India 2004)","options":[{"letter":"A","text":"Ret proto-oncogene"},{"letter":"B","text":"FAP gene"},{"letter":"C","text":"Rb gene"},{"letter":"D","text":"BRCA-1 gene"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ret proto-oncogene","explanation":"a. Ret proto-oncogene"},{"n":72,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Commonest presenting complaints of medullary carcinoma thyroid: (PGI 84)","options":[{"letter":"A","text":"Diarrhea"},{"letter":"B","text":"Dysphagia"},{"letter":"C","text":"Hoarseness"},{"letter":"D","text":"Flushing"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diarrhea","explanation":"a. Diarrhea"},{"n":73,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Which of the following is true about medullary carcinoma? (DPG 2008)","options":[{"letter":"A","text":"Calcitonin is not a marker"},{"letter":"B","text":"Arises from parafollicular C cells"},{"letter":"C","text":"Produces PTH"},{"letter":"D","text":"Take up radioiodine"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Arises from parafollicular C cells","explanation":"b. Arises from parafollicular C cells"},{"n":74,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"True about medullary carcinoma thyroid: (DPG 2007)","options":[{"letter":"A","text":"Good prognosis"},{"letter":"B","text":"Associated with MEN-1"},{"letter":"C","text":"Increased calcitonin is not associated with hypocalcemia"},{"letter":"D","text":"Treated by near total thyroidectomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Increased calcitonin is not associated with hypocalcemia","explanation":"c. Increased calcitonin is not associated with hypocalcemia"},{"n":75,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"All are true regarding medullary carcinoma of thyroid except: (JIPMER 2014, 2013)","options":[{"letter":"A","text":"It arises from ‘C’ cells"},{"letter":"B","text":"Secrete high levels of calcitonin"},{"letter":"C","text":"It is dependent on TSH"},{"letter":"D","text":"Most cases are familial"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"It is dependent on TSH","explanation":"c. It is dependent on TSH"},{"n":76,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Which of the following does not take radioactive iodine? (Recent Question 2017)","options":[{"letter":"A","text":"Medullary carcinoma thyroid"},{"letter":"B","text":"Papillary carcinoma thyroid"},{"letter":"C","text":"Follicular carcinoma thyroid"},{"letter":"D","text":"Hürthle cell carcinoma thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Medullary carcinoma thyroid","explanation":"a. Medullary carcinoma thyroid (Ref: Schwartz 10/e p1550; Sabiston 20/e p909; Bailey 27/e p820)"},{"n":77,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Calcitonin is the marker for: (Recent Question 2017)","options":[{"letter":"A","text":"Papillary carcinoma thyroid"},{"letter":"B","text":"Follicular carcinoma thyroid"},{"letter":"C","text":"Medullary carcinoma thyroid"},{"letter":"D","text":"Anaplastic carcinoma thyroid"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Medullary carcinoma thyroid","explanation":"c. Medullary carcinoma thyroid (Ref: Schwartz 10/e p1550; Sabiston 20/e p909; Bailey 27/e p820)"},{"n":78,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Medullary carcinoma thyroid is associated with which mutation? (Recent Question 2017)","options":[{"letter":"A","text":"RET"},{"letter":"B","text":"MET"},{"letter":"C","text":"p53"},{"letter":"D","text":"PTEN"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"RET","explanation":"a. RET (Ref: Schwartz 10/e p1541; Sabiston 20/e p909)"},{"n":79,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"RET proto-oncogene is associated with development of: (Recent Question 2018)","options":[{"letter":"A","text":"Medullary carcinoma thyroid"},{"letter":"B","text":"Astrocytoma"},{"letter":"C","text":"Paraganglioma"},{"letter":"D","text":"Hürthle cell tumor thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Medullary carcinoma thyroid","explanation":"a. Medullary carcinoma thyroid (Ref: Schwartz 10/e p1541; Sabiston 20/e p909)"},{"n":80,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Not true about anaplastic thyroid carcinoma: (PGI May 2011)","options":[{"letter":"A","text":"Local infiltration common"},{"letter":"B","text":"Spread by lymphatic route"},{"letter":"C","text":"Long term survival in patient undergoing surgery"},{"letter":"D","text":"Surgery is of limited value"},{"letter":"E","text":"Highly chemosensitive"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Long term survival in patient undergoing surgery; E. Highly chemosensitive","explanation":"c. Long term survival in patient undergoing surgery; e. Highly chemosensitive (Ref: Schwartz 10/e p1551, Sabiston 20/e p910)"},{"n":81,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"A patient with long standing multinodular goitre develops hoarseness of voice and swelling undergoes sudden increase in size. Likely diagnosis is: (Recent Question 2014, All India 2001)","options":[{"letter":"A","text":"Follicular carcinoma"},{"letter":"B","text":"Papillary carcinoma"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Anaplastic carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Anaplastic carcinoma","explanation":"d. Anaplastic carcinoma"},{"n":82,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"The treatment of choice for anaplastic carcinoma of thyroid infiltrating trachea and sternum will be: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Radical excision"},{"letter":"B","text":"Chemotherapy"},{"letter":"C","text":"Radiotherapy"},{"letter":"D","text":"Palliative/Symptomatic treatment"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Palliative/Symptomatic treatment","explanation":"d. Palliative/Symptomatic treatment"},{"n":83,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Least common thyroid malignancy is: (Recent Question 2015)","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Follicular"},{"letter":"C","text":"Medullary"},{"letter":"D","text":"Anaplastic"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Anaplastic","explanation":"d. Anaplastic"},{"n":84,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 178","pdfPage":168,"stem":"Metastasis in thyroid gland come most commonly from carcinoma of: (PGI June 98)","options":[{"letter":"A","text":"Testis"},{"letter":"B","text":"Prostate"},{"letter":"C","text":"Breast"},{"letter":"D","text":"Lungs"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Breast","explanation":"Metastatic Tumors of Thyroid\nAnswer (book): Answer: C. Breast\nReference: Schwartz 10/e p1551"},{"n":85,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 179","pdfPage":168,"stem":"All of the following are true about lymphoma of the thyroid except: (All India 2007)","options":[{"letter":"A","text":"More common in females"},{"letter":"B","text":"Slow growing"},{"letter":"C","text":"Clinically confused with undifferentiated tumors"},{"letter":"D","text":"May present with respiratory distress and dysphagia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Slow growing","explanation":"• Lymphomas of the thyroid gland are rapidly growing tumors and usually present with goiter that has grown\nsignificantly over a short period.\n• Rare, most cases are found in autopsy\n• MC site of primary: CA BreastQ > CA Lung\n• If thyroid metastases is detected pre-mortem, MC site of primary: RCCQ >CA Breast > CA Lung\nAnswer (book): Answer: B. Slow growing\nReference: Schwartz 10/e p1551; Sabiston 20/e p910; Bailey 27/e p821; Harrison 19/e p2307"},{"n":86,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 179","pdfPage":168,"stem":"False statement regarding thyroid carcinoma: (PGI Nov 2011)","options":[{"letter":"A","text":"Medullary thyroid carcinoma is associated with MEN-2A"},{"letter":"B","text":"Follicular carcinoma -Most common type of carcinoma"},{"letter":"C","text":"Papillary carcinoma -Multifocal"},{"letter":"D","text":"Thyroid lymphoma is often associated with Hashimoto thyroiditis"},{"letter":"E","text":"Anaplastic carcinoma occur in old age women"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Follicular carcinoma—Most common type of carcinoma","explanation":"b. Follicular carcinoma—Most common type of carcinoma (Ref: Schwartz 9/e p1361; Sabiston 20/e p900; Bailey 27/e p818)"},{"n":87,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 179","pdfPage":168,"stem":"True about thyroid carcinoma: (PGI Dec 2006)","options":[{"letter":"A","text":"Follicular carcinoma have worse prognosis than papillary carcinoma"},{"letter":"B","text":"Papillary carcinoma spreads by hematogenous route more frequently than follicular carcinoma"},{"letter":"C","text":"Papillary carcinoma have increased mortality than follicular carcinoma"},{"letter":"D","text":"Follicular carcinoma are more bilateral than papillary carcinoma"},{"letter":"E","text":"Follicular carcinoma have more male incidence than papillary carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular carcinoma have worse prognosis than papillary carcinoma; E. Follicular carcinoma have","explanation":"a. Follicular carcinoma have worse prognosis than papillary carcinoma; e. Follicular carcinoma have more male incidence than\npapillary carcinoma"},{"n":88,"chapter":"Thyroid","src":"question on PDF p. 168 · answer on PDF p. 179","pdfPage":168,"stem":"Low risk in carcinoma thyroid: (PGI Dec 2006)","options":[{"letter":"A","text":"Men <50 years"},{"letter":"B","text":"Women <40 years"},{"letter":"C","text":"Papillary carcinoma <4 cm"},{"letter":"D","text":"Metastasis"},{"letter":"E","text":"Follicular carcinoma >5c m"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Women <40 years; C. Papillary carcinoma <4 cm","explanation":"Prognostic Risk Classification for Well Differentiated Thyroid Cancer (AMES or AGES) Features\nLow Risk | High Risk | Age | <40 years | >40 years | Metastasis | None | Regional or distantQ | Size | <4 cmQ | >4 cm\n| Grade | Well differentiated | Poorly differentiatedQ | Extent\nNo local extension, intrathyroidal, no capsular invasion\nCapsular invasion, extrathyroidal extensionQ\nQ\nPrognostic Indicators of Differentiated Thyroid cancer (PTC, FTC)\n• Age, histologic Grade, Extrathyroidal invasion, and metastases and tumor Size to predict the risk of dying from\npapillary cancer.\n• Low-risk patients are young, with well-differentiated tumors, no metastases, and small primary lesions\n• High-risk patients are older, with poorly differentiated tumors, local invasion, distant metastases, and large\nprimary lesions. The MACIS ScaleQ\n• This scale incorporates distant Metastases, Age at presentation (<40 or >40 years old), Completeness of original\nsurgical resection, extrathyroidal Invasion, and Size of original lesion. AMES SystemQ\n• To classify differentiated thyroid tumors into low-and high-risk groups using Age (men <40 years old, women <50\nyears old), Metastases, Extrathyroidal spread, and Size of tumors (<5 or >5 cm).\nAnswer (book): Answer: B. Women <40 years; C. Papillary carcinoma <4 cm\nReference: Schwartz 9/e p1362-1363; Sabiston 20/e p903; Bailey 27/e p818"},{"n":89,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"The most common histologic type of thyroid cancer is: (Recent Question 2015, All India 2008, 2004, AIIMS Nov 05, PGI Dec 2005)","options":[{"letter":"A","text":"Medullary type"},{"letter":"B","text":"Follicular type"},{"letter":"C","text":"Papillary type"},{"letter":"D","text":"Anaplastic type"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Papillary type","explanation":"c. Papillary type"},{"n":90,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Which of the following is not a histological variant of thyroid neoplasm? (All India 2007)","options":[{"letter":"A","text":"Follicular"},{"letter":"B","text":"Merkel cell"},{"letter":"C","text":"Insular"},{"letter":"D","text":"Anaplastic"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Merkel cell","explanation":"b. Merkel cell"},{"n":91,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Thyroid carcinoma:","options":[{"letter":"A","text":"Is often associated with hypothyroidism"},{"letter":"B","text":"Often produces hyperthyroidism"},{"letter":"C","text":"Is usually euthyroid"},{"letter":"D","text":"Occurs in toxic nodules"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Is usually euthyroid","explanation":"c. Is usually euthyroid"},{"n":92,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Amount of I-131 given for carcinoma thyroid: (DPG 2006)","options":[{"letter":"A","text":"5 micro curie"},{"letter":"B","text":"50 micro curie"},{"letter":"C","text":"5 milli curie"},{"letter":"D","text":"50 milli curie"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"50 milli curie","explanation":"• Amount of I131 given for carcinoma thyroid is 50 milli curie (30-100 mCi).\n• Schwartz says “If there is significant uptake, then a therapeutic dose of 131I, 30 to 100 mCi should be\nadministered to low-risk patients and 100 to 200 mCi in high-risk patients.”\nAnswer (book): Answer: D. 50 milli curie\nReference: Schwartz 9/e p1365-1366; Sabiston 20/e p908; Bailey 25/e p797; Harrison 20/e p2716, 19/e p2306"},{"n":93,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Thyroxine can be given in which thyroid carcinoma: (MCI Sept 2009)","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Medullary"},{"letter":"C","text":"Anaplastic"},{"letter":"D","text":"Undifferentiated"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary","explanation":"a. Papillary"},{"n":94,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Thyroid carcinoma causes laryngeal paralysis due to: (PGI June 96)","options":[{"letter":"A","text":"Recurrent laryngeal nerve palsy"},{"letter":"B","text":"Vagus nerve palsy"},{"letter":"C","text":"Glossopharyngeal nerve palsy"},{"letter":"D","text":"Hypoglossal nerve palsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Recurrent laryngeal nerve palsy","explanation":"• The nerves found in close relationship to thyroid gland and therefore likely to be involved in malignant spread\nand thyroid surgery are recurrent laryngeal nerve and superior laryngeal nerve.\nAnswer (book): Answer: A. Recurrent laryngeal nerve palsy"},{"n":95,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Which of the following is used in the treatment of thyroid malignancy? (PGI June 2001)","options":[{"letter":"A","text":"I-131"},{"letter":"B","text":"I-125"},{"letter":"C","text":"Tc-99"},{"letter":"D","text":"P-32"},{"letter":"E","text":"Strontium"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"I-131","explanation":"a. I-131 (Ref: Schwartz 10/e p1546; Sabiston 20/e p908; Bailey 27/e p819; Harrison 20/e p2716, 19/e p2306; William’s Endocrinology 10/e p479)"},{"n":96,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 179","pdfPage":169,"stem":"Which of the following is used in the treatment of well differentiated thyroid carcinoma: (Recent Question 2013)","options":[{"letter":"A","text":"I 131"},{"letter":"B","text":"99m Tc"},{"letter":"C","text":"32P"},{"letter":"D","text":"MIBG"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"I 131","explanation":"AGES Scoring SystemQ\nSOLITARY THYROID NODULE`\nAnswer (book): Answer: A. I131"},{"n":97,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 180","pdfPage":169,"stem":"Most sensitive investigation of thyroid nodule: (Punjab 2011)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"PET Scan"},{"letter":"C","text":"USG"},{"letter":"D","text":"Clinical examination"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"USG","explanation":"• PET scans are not routinely used in the evaluation of thyroid nodules, however, they may show clinically occult\nthyroid lesions.\n• Emedicine-Medscape says “USG is the most sensitive method for diagnosing intrathyroid lesions”\n• CT and MRI are neither specific nor sensitive in diagnosing the intrathyroid lesions.\nUltrasound in STN\n• Ultrasound is helpful in assessing a thyroid nodule.\n• Advantages: Portability, cost-effectiveness, and lack of ionizing radiation.\n• It is extremely useful in patients who are being managed conservativelyQ because it can easily determine\nwhether a nodule has increased in size.\n• Ultrasound is used routinelyQ in the office setting and is also available for intraoperative evaluation.\n• It has proved highly effective in determining the location and characteristics (cystic versus solid) Q of nodules but\nis unable to accurately predict the diagnosis of solid nodules. Ultrasound features of carcinoma in a Thyroid\nNodule Feature Carcinoma/Malignancy Structure Hypoechoic/ Nonhomogeneous/ SolidQ Regressive changes Rare\nMicrocalcifications CommonQ Peripheral rim Variable Internal vascularity CommonQ (70-100 percent) Lymph\nnodes Relatively commonQ\nAnswer (book): Answer: C. USG\nReference: Schwartz 10/e p1540; Sabiston 20/e p895"},{"n":98,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 180","pdfPage":169,"stem":"True about solitary thyroid nodule: (PGI Dec 2006)","options":[{"letter":"A","text":"THR-Antibody"},{"letter":"B","text":"Lined by columnar epithelium"},{"letter":"C","text":"Diffuse hyperplasia of thyroid"},{"letter":"D","text":"Common in female"},{"letter":"E","text":"Thyroidectomy done"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Common in female; E. Thyroidectomy done","explanation":"Solitary Thyroid Nodule Palpable discrete swelling within an otherwise apparently normal thyroid\ngland. Incidence in adults is 1–10%. STN are 4 times more common in womenQ than in men. There is nodular\nhyperplasiaQ (not the diffuse hyperplasia) THR-Ab is not found in STN. STN are more likely to be neoplastic than\nmultiple nodules. Nodules in younger patients are more likely to be neoplasticQ than those in older patients. History\nof radiation exposure increases the risk of malignancyQ. Cold nodules (don’t take up radioactive iodine) are more\nlikely to be malignant (15–20%)Q than hot (take up radioactive iodine) nodules (1–3%)Q\n• STN are removed surgicallyQ to exclude malignancy.\nAnswer (book): Answer: D. Common in female; E. Thyroidectomy done\nReference: Schwartz 10/e p1537-1539; Harrison 20/e p2711, 19/e p2303"},{"n":99,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 180","pdfPage":169,"stem":"A case of solitary thyroid nodule, investigation of choice is: (PGI June 97, 96, AIIMS Nov 97)","options":[{"letter":"A","text":"T3, T4 estimation"},{"letter":"B","text":"Thyroid scan"},{"letter":"C","text":"FNAC"},{"letter":"D","text":"Excision biopsy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"FNAC","explanation":"• FNAC is the investigation of choice in discrete thyroid swellings, offers excellent patient compliance and is easy\nand quick to performQ.\n• FNAC cannot distinguish between benign follicular adenoma and follicular carcinomaQ.\nAnswer (book): Answer: C. FNAC\nReference: Schwartz 10/e p1538; Sabiston 20/e p897"},{"n":100,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 180","pdfPage":169,"stem":"Initial preferred investigation for thyroid nodule is: (DPG 2008)","options":[{"letter":"A","text":"FNAC"},{"letter":"B","text":"Radionucleide test"},{"letter":"C","text":"Thyroid function test"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Thyroid function test","explanation":"• Initial investigation done in STN is thyroid function test (TFT) Q.\n• Investigation of choice in STN for diagnosis is FNACQ.\nSolitary Thyroid Nodule\n• Initial investigation done in STN is thyroid function test (TFT) Q.\n• If TFT is raised, next investigation is thyroid scan, (For hot nodules, RAI ablation or surgery is done; For warm or\ncold nodules, follow-up or surgery) Q\n• If TFT is normal, USG is done (Aspiration in cystic lesions, FNAC for solid or heterogenous lesions) Q.\n• Investigation of choice in STN for diagnosis is FNACQ.\nAnswer (book): Answer: C. Thyroid function test\nReference: Sabiston 20/e p890; Harrison 20/e p2711, 19/e p2303"},{"n":101,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Investigation of choice in discrete thyroid swelling is: (Recent Question 2014)","options":[{"letter":"A","text":"Isotope scans"},{"letter":"B","text":"Ultrasonography"},{"letter":"C","text":"Autoantibody titres"},{"letter":"D","text":"FNAC"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"FNAC","explanation":"d. FNAC"},{"n":102,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"A patient came with a small solitary nodule in right lobe of thyroid. FNAC shows follicular adenoma. The best surgery is: (DNB 2002)","options":[{"letter":"A","text":"Enucleation"},{"letter":"B","text":"Sub-total thyroidectomy"},{"letter":"C","text":"Right hemithyroidectomy"},{"letter":"D","text":"Near-total thyroidectomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Right hemithyroidectomy","explanation":"81\nAnswer (book): Answer: C. Right hemithyroidectomy"},{"n":103,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"A 53-year-old female with multinodular goiter underwent radioisotope scan, whose report shows warm nodules. Her chances of warm nodules being malignant is: (MHCET 2016)","options":[{"letter":"A","text":"5%"},{"letter":"B","text":"10%"},{"letter":"C","text":"15%"},{"letter":"D","text":"20%"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"5%","explanation":"a. 5%"},{"n":104,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"A 45-year-old male presents with 4 × 4 cm, mobile right solitary thyroid nodule of 5 months. The patient is euthyroid. The following statements about his management are true except: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Cold nodule on thyroid scan is diagnostic of malignancy"},{"letter":"B","text":"FNAC is the investigation of choice"},{"letter":"C","text":"The patient should undergo hemithyroidectomy if FNAC report is inconclusive"},{"letter":"D","text":"Indirect laryngoscopy be done in the preoperative period to assess mobility of vocal cords"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cold nodule on thyroid scan is diagnostic of malignancy","explanation":"a. Cold nodule on thyroid scan is diagnostic of malignancy (Ref: Schwartz 10/e p1537; Sabiston 20/e p890; Chandrasoma Taylor 3/e\np849-850; Harrison 20/e p2711, 19/e p2303)"},{"n":105,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Most common solitary thyroid nodule is: (AIIMS Nov 2004, June 93)","options":[{"letter":"A","text":"Follicular adenoma"},{"letter":"B","text":"Hurthle cell carcinoma"},{"letter":"C","text":"Papillary carcinoma"},{"letter":"D","text":"Solitary idiopathic goiter"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follicular adenoma","explanation":"• MC STN is colloid goiter > follicular adenoma.\nAnswer (book): Answer: A. Follicular adenoma"},{"n":106,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"What is the most appropriate operation for a solitary nodule in one lobe of thyroid? (All India 2003, AIIMS Nov 95)","options":[{"letter":"A","text":"Lobectomy"},{"letter":"B","text":"Hemithyroidectomy"},{"letter":"C","text":"Nodule removal"},{"letter":"D","text":"Partial lobectomy with 1 cm margin around nodule"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hemithyroidectomy","explanation":"Hemithyroidectomy\n• Hemithyroidectomy is removal of one lobe with isthmus.\n• Hemithyroidectomy is treatment of choice for follicular adenoma and solitary thyroid nodule.\nAnswer (book): Answer: B. Hemithyroidectomy\nReference: Schwartz 10/e p1540; Harrison 20/e p2711, 19/e p2303"},{"n":107,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Which of the following is true about subtotal thyroidectomy? (Recent Question 2018)","options":[{"letter":"A","text":"Removal of one lobe and isthmus"},{"letter":"B","text":"Removal of both lobes leaving behind 6-8 grams of tissue"},{"letter":"C","text":"Removal of entire lobe with cervical lymph nodes"},{"letter":"D","text":"Removal of one lobe with isthmus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Removal of both lobes leaving behind 6-8 grams of tissue","explanation":"Surgery | Structure Removed | Hemithyroidectomy (Thyroid lobectomy) | Removal of one lobe with\nisthmusQ | Subtotal thyroidectomy\nRemoval of both lobes leaving behind 3-4 gms of tissue in each lobeQ\nNear-total thyroidectomy\nLeaving <1 gm of tissue adjacent to RLN at ligament of Berry on one sideQ\nTotal thyroidectomy | Removal of all visible thyroid tissueQ | Hartley-Dunhill procedure\nRemoval of one lobe with isthmus & second lobe partially (leaving 4-6 gms of thyroid tissue)Q\nAnswer (book): Answer: B. Removal of both lobes leaving behind 6-8 grams of tissue\nReference: Sabiston 20/e p906; Bailey 27/e p814; Schwartz 10/e p1551"},{"n":108,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Percentage of cold nodules that becomes malignant are? (DNB 2014)","options":[{"letter":"A","text":"5%"},{"letter":"B","text":"15%"},{"letter":"C","text":"20%"},{"letter":"D","text":"40%"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"20%","explanation":"• About 80% of discrete swellings are cold. The risk of malignancy is higher in “cold” lesions (20%) compared to\n“hot” or\n“warm” lesions (< 5%).\nAnswer (book): Answer: C. 20%\nReference: Bailey 27/e p804"},{"n":109,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Which is the investigation of choice to differentiate between benign and malignant thyroid nodule? (DNB 2014)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"FNAC"},{"letter":"C","text":"Scintigraphy"},{"letter":"D","text":"Biopsy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"FNAC","explanation":"b. FNAC"},{"n":110,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Management of a single 1 cm non-functioning dominant nodule of thyroid in an asymptomatic patient: (Recent Question 2017)","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Radioiodine ablation"},{"letter":"C","text":"Hemithyroidectomy"},{"letter":"D","text":"Antithyroid drugs"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Observation","explanation":"a. Observation (Ref: Schwartz 10/e p1540; Sabiston 20/e p890; Bailey 27/e p810)\nGOITER"},{"n":111,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Multi-nodular goiter (MNG) secondary thyrotoxicosis is seen how much percentage of patient with MNG: (MHSSMCET 2005)","options":[{"letter":"A","text":"10%"},{"letter":"B","text":"20%"},{"letter":"C","text":"30%"},{"letter":"D","text":"40%"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"30%","explanation":"• Secondary Thyrotoxicosis: Transient episodes of mild hyperthyroidism are common, occurring in up to 30%Q of\npatients.\n• Carcinoma: An increased incidence of cancer (usually follicular) has been reported from endemic areasQ.\nAnswer (book): Answer: C. 30%\nReference: Bailey 27/e p807"},{"n":112,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"The most common presentation of endemic goiter is: (All India 96)","options":[{"letter":"A","text":"Hypothyroid"},{"letter":"B","text":"Diffuse goiter"},{"letter":"C","text":"Hyperthyroid"},{"letter":"D","text":"Solitary nodule"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Diffuse goiter","explanation":"Endemic Goiter\n• Worldwide, diffuse goiter is most commonly caused by iodine deficiency and is termed endemic goiter when it\naffects >5%Q of the population.\n• Endemic goiter occurs in geographical areas where the soil, water and food supply contains low levels of iodineQ.\n• The lack of iodine leads to decreased synthesis of thyroid hormones and a compensatory increase in TSH which in\nturn leads to follicular cell hypertrophy and hyperplasia and goitrous enlargement leading to diffuse hyperplastic\ngoiterQ.\n• Mostly, patients are euthyroidQ.\nAnswer (book): Answer: B. Diffuse goiter\nReference: Harrison 20/e p2711, 19/e p2301"},{"n":113,"chapter":"Thyroid","src":"question on PDF p. 169 · answer on PDF p. 181","pdfPage":169,"stem":"Thoracic extension of cervical goitre is usually approached through: (AIIMS May 2005)","options":[{"letter":"A","text":"Neck"},{"letter":"B","text":"Chest"},{"letter":"C","text":"Combined cervico-thoracic"},{"letter":"D","text":"Thoracoscopic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Neck","explanation":"• Virtually all intrathoracic goiters can be removed via a cervical incisionQ.\nAnswer (book): Answer: A. Neck\nReference: Schwartz 10/e p1554"},{"n":114,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 181","pdfPage":170,"stem":"A 20-year-old girl presents with 9 months history of neck swelling with thyrotoxic symptoms. On investigation increased T4 and decreased TSH with palpable 2 cm nodule was found. Next investigation will be: (AIIMS May 2007)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"Thyroid scan"},{"letter":"C","text":"Radioactive iodine uptake"},{"letter":"D","text":"CT scan"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Thyroid scan","explanation":"b. Thyroid scan (Ref: Sabiston 20/e p897; Schwartz 10/e p1537)"},{"n":115,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 181","pdfPage":170,"stem":"Indication of surgery in a case of thyroid swelling is/are: (PGI June 2004)","options":[{"letter":"A","text":"Cosmetic"},{"letter":"B","text":"Pressure symptoms"},{"letter":"C","text":"Myxedema"},{"letter":"D","text":"Pain"},{"letter":"E","text":"Swelling with symptoms"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cosmetic; B. Pressure symptoms; E. Swelling with symptoms","explanation":"Indications of Surgery in Thyroid Swelling\n1. Neoplasia (FNAC positive, clinical suspicion) Q\n2. Toxic adenomaQ | 3. Pressure symptomsQ | 4. Cosmetic reason or patient’s preferenceQ | Complications of\nMulti-nodular Goiter\nAnswer (book): Answer: A. Cosmetic; B. Pressure symptoms; E. Swelling with symptoms\nReference: Schwartz 9/e p1358; Sabiston 20/e p899"},{"n":116,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"In a patient presenting with a swelling of the thyroid, the radionuclide scan showed a cold nodule and the ultrasound showed a non cystic solid mass. The management of this patient would be: (AIIMS June 2002)","options":[{"letter":"A","text":"Lobectomy"},{"letter":"B","text":"Hemithyroidectomy"},{"letter":"C","text":"Eltroxin"},{"letter":"D","text":"Radio Iodine therapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hemithyroidectomy","explanation":"b. Hemithyroidectomy"},{"n":118,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"What percentage of cold thyroid nodules are malignant? (MHCET 2016)","options":[{"letter":"A","text":"70–80%"},{"letter":"B","text":"50–60%"},{"letter":"C","text":"40–50%"},{"letter":"D","text":"10–20%"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"10–20%","explanation":"• Cold nodules (don’t take up radioactive iodine) are more likely to be malignant (15–20%)Q than hot (take up\nradioactive iodine) nodules (1–3%)Q\nAnswer (book): Answer: D. 10–20%"},{"n":119,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Treatment of choice in cold nodule of thyroid: (JIPMER 93)","options":[{"letter":"A","text":"Subtotal thyroidectomy"},{"letter":"B","text":"Wait and watch"},{"letter":"C","text":"I-131"},{"letter":"D","text":"Hemithyroidectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hemithyroidectomy","explanation":"d. Hemithyroidectomy"},{"n":120,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Which of the following is true? (AIIMS May 2011)","options":[{"letter":"A","text":"Colloid goiter mostly presents as hyperthyroidism"},{"letter":"B","text":"Thyroid storm, the clinical features are primarily due to increased thyroxine"},{"letter":"C","text":"Excess calcium intake can lead to hyperthyroidism"},{"letter":"D","text":"Goiter more than 5% of population is endemic goiter"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Goiter more than 5% of population is endemic goitre","explanation":"d. Goiter more than 5% of population is endemic goitre (Ref: Harrison 19/e p2301, 18/e p2931)"},{"n":121,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"A 12-year old girl presents with nodular goiter. Which of the following statements regarding her evaluation and management is incorrect? (AIIMS May 2014)","options":[{"letter":"A","text":"99 m-Tc scan should be performed to determine whether the nodules are hypofunctioning or hyperfunctioning"},{"letter":"B","text":"Functional thyroid nodules are usually benign"},{"letter":"C","text":"All nodules > 4 cm should be resected irrespective of cytology"},{"letter":"D","text":"FNAC should be performed for allnodules > 1 cm in diameter"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"All nodules > 4 cm should be resected irrespective of cytology","explanation":"All nodules > 4 cm should be resected irrespective of cytology, is an incorrect statement.\nAnswer (book): Answer: C. All nodules > 4 cm should be resected irrespective of cytology\nReference: Schwartz 9/e p1358; Sabiston 20/e p895-899, 19/e p899; Harrison 20/e p2711, 19/e p2301"},{"n":122,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Most common symptom of retrosternal goiter: (Punjab 2010, PGI June 97)","options":[{"letter":"A","text":"Dysphagia"},{"letter":"B","text":"Stridor"},{"letter":"C","text":"Dyspnea"},{"letter":"D","text":"Superior vena cava syndrome"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Dyspnea","explanation":"c. Dyspnea (Ref: Schwartz 10/e p1537; Sabiston 20/e p893-894; Bailey 27/e p810)"},{"n":123,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Retrosternal goiter is characterized by: (DPG 2005)","options":[{"letter":"A","text":"Stridor"},{"letter":"B","text":"Always malignant"},{"letter":"C","text":"Bilateral"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stridor","explanation":"a. Stridor"},{"n":124,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Most commonly used approach for retrosternal goitre: (Recent Question 2019)","options":[{"letter":"A","text":"Transthoracic via second intercostal space"},{"letter":"B","text":"Transthoracic via fourth intercostal space"},{"letter":"C","text":"Trans-sternal through anterior mediastinum"},{"letter":"D","text":"Transcervical"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Transcervical","explanation":"d. Transcervical (Ref: Schwartz 10/e p1537; Sabiston 20/e p894; Bailey 27/e p810)\nTHYROTOXICOSIS"},{"n":125,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Thyroid storm after operation is due to: (COMEDK 2007)","options":[{"letter":"A","text":"Inadequate control of hyperthyroidism"},{"letter":"B","text":"Massive bleeding"},{"letter":"C","text":"Recurrent laryngeal nerve injury"},{"letter":"D","text":"Postoperative infection"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Inadequate control of hyperthyroidism","explanation":"a. Inadequate control of hyperthyroidism (Ref: Schwartz 10/e p1534; Sabiston 20/e p920; Bailey 27/e p811, 758; Harrison 20/e p2712,\n19/e p2297)"},{"n":126,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Which of the following is the agent of choice for treating thyrotoxicosis during pregnancy? (COMEDK 2010)","options":[{"letter":"A","text":"Carbimazole"},{"letter":"B","text":"Propylthiouracil"},{"letter":"C","text":"Methimazole"},{"letter":"D","text":"Radioactive I-131"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Carbimazole","explanation":"a. Carbimazole (Ref: Harrison 20/e p2706)"},{"n":127,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"All of the following are features of thyrotoxicosis, except: (Recent Question 2016)","options":[{"letter":"A","text":"Diastolic murmur"},{"letter":"B","text":"Soft non-ejection systolic murmur"},{"letter":"C","text":"Irregularly, irregular pulse"},{"letter":"D","text":"Scratching sound in systole"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diastolic murmur","explanation":"a. Diastolic murmur (Ref: Harrison 20/e p2704, 19/e p2294)"},{"n":128,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Dancing carotid is seen in: (AIIMS Dec 98)","options":[{"letter":"A","text":"Thyrotoxicosis"},{"letter":"B","text":"Hypothyroidism"},{"letter":"C","text":"AV Fistula"},{"letter":"D","text":"Blow out carotid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thyrotoxicosis","explanation":"Dancing Carotids may be seen in\n• Aortic regurgitationQ\nThyrotoxicosisQ\nAnswer (book): Answer: A. Thyrotoxicosis\nReference: Harrison 20/e p2704, 19/e p2294"},{"n":129,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"The best marker to diagnose thyroid related disorder is:","options":[{"letter":"A","text":"T3"},{"letter":"B","text":"T4"},{"letter":"C","text":"TSH"},{"letter":"D","text":"Thyroglobulin"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"TSH","explanation":"The ultrasensitive TSH assay has become the most sensitive and specific test for the diagnosis of\nhyper-and hypothyroidism and for optimizing T4 therapyQ. The enhanced sensitivity and specificity of TSH assays\nhave greatly improved laboratory assessment of thyroid functionQ.\nAnswer (book): Answer: C. TSH\nReference: Schwartz 10/e p1529; Sabiston 20/e p895; Bailey 27/e p/802; Harrison 20/e p2697, 19/e p2288"},{"n":130,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"The occurrence of hypothyroidism following administration of supplemental iodine to subjects with endemic iodine to subjects with endemic iodine deficiency goiter is known as: (All India 2004)","options":[{"letter":"A","text":"Jod- Basedow effect"},{"letter":"B","text":"Wolff-Chaikoff effect"},{"letter":"C","text":"Thyrotoxicosis factitia"},{"letter":"D","text":"De Quervain’s thyroiditis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Wolff-Chaikoff effect","explanation":"Wolff-Chaikoff effect\n• Iodine induced hypothyroidismQ (Iodine dependent transient thyroid suppression)\nJod-Basedow’s effect\n• Iodine induced hyperthyroidismQ\nAnswer (book): Answer: B. Wolff-Chaikoff effect\nReference: Schwartz 10/e p1526; Sabiston 20/e p886; Harrison 20/e p2710, 19/e p2286"},{"n":131,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"In thyrotoxicosis, β-blockers do not control: (All India 94)","options":[{"letter":"A","text":"Anxiety"},{"letter":"B","text":"Tremors"},{"letter":"C","text":"Tachycardia"},{"letter":"D","text":"Oxygen consumption"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Oxygen consumption","explanation":"• Beta-blockers do not correct the underlying metabolic abnormalities (i.e. does not affect the oxygen\nconsumption) Beta Blockers in Thyrotoxicosis\nAdvantages | Limitations | Alleviates adrenergic manifestations:\n• Sweating, tremorQ\n• Tachycardia, palpitationsQ\n• Nervousness, anxietyQ\nAnswer (book): Answer: D. Oxygen consumption\nReference: Harrison 20/e p2712, 19/e p2296"},{"n":132,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"All of the following are associated with thyroid storm, except: (All India 2002)","options":[{"letter":"A","text":"Surgery for thyroiditis"},{"letter":"B","text":"Surgery for thyrotoxicosis"},{"letter":"C","text":"Stressful illness in thyrotoxicosis"},{"letter":"D","text":"I-131 therapy for thyrotoxicosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Surgery for thyroiditis","explanation":"• Beta blockers do not significantly affect the thyroid statusQ, it reduces to some extent the conversion of T4 to T3.\n• Beta blockers do not correctQ the underlying metabolic abnormalities (i.e. does not affect the oxygen\nconsumption) Q\nAnswer (book): Answer: A. Surgery for thyroiditis"},{"n":133,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Cardiovascular findings in an elderly thyrotoxicosis patient are all, except: (All India 2000)","options":[{"letter":"A","text":"Early diastolic murmur"},{"letter":"B","text":"Systolic ejection murmur"},{"letter":"C","text":"Scratch in left 2nd intercostal space"},{"letter":"D","text":"Irregularly irregular pulse"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Early diastolic murmur","explanation":"a. Early diastolic murmur"},{"n":134,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Treatment of thyroid storm includes all, except: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Propranolol"},{"letter":"B","text":"Radioactive iodine"},{"letter":"C","text":"Hydrocortisone"},{"letter":"D","text":"Lugol’s iodine"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Radioactive iodine","explanation":"b. Radioactive iodine"},{"n":135,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Difference between thyrotoxicosis and malignant hyperthermia is: (AIIMS June 2001)","options":[{"letter":"A","text":"Hyperthermia"},{"letter":"B","text":"Tachycardia"},{"letter":"C","text":"Muscle rigidity"},{"letter":"D","text":"Elevated serum CPK level"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Elevated serum CPK level","explanation":"• Both thyrotoxicosis and malignant hyperthermia may cause myopathy, but in hyperthyroidism serum CPK is often\nnormal.\nAnswer (book): Answer: D. Elevated serum CPK level"},{"n":136,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"In thyrotoxicosis, which of the following is seen?","options":[{"letter":"A","text":"Pretibial myxedema"},{"letter":"B","text":"Glycosuria"},{"letter":"C","text":"Unilateral exophthalmos"},{"letter":"D","text":"All"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All","explanation":"d. All"},{"n":137,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Toxic adenoma on scanning appear as: (JIPMER 98)","options":[{"letter":"A","text":"Hot nodule"},{"letter":"B","text":"Cold nodule"},{"letter":"C","text":"Warm nodule"},{"letter":"D","text":"Neutral"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hot nodule","explanation":"a. Hot nodule (Ref: Schwartz 10/e p1533; Sabiston 19/e p896; Bailey 27/e p804; Harrison 20/e p2713, 19/e p2302)"},{"n":138,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"Thyroid storm after operation is due to: (COMEDK 2007)","options":[{"letter":"A","text":"Inadequate control of hyperthyroidism"},{"letter":"B","text":"Massive bleeding"},{"letter":"C","text":"Recurrent laryngeal nerve injury"},{"letter":"D","text":"Postoperative injection"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Inadequate control of hyperthyroidism","explanation":"a. Inadequate control of hyperthyroidism (Ref: Schwartz 10/e p1534; Sabiston 20/e p920; Bailey 27/e p811, 758; Harrison 20/e p2712,\n19/e p2297)"},{"n":139,"chapter":"Thyroid","src":"question on PDF p. 170 · answer on PDF p. 182","pdfPage":170,"stem":"A 48-year-old woman underwent subtotal thyroidectomy. She has vague family history of malignant hyperthermia. She develops agitation, restlessness, fever, tremor, shivering, and tachypnea. Thyrotoxic crises can be best distinguished from malignant hyperthermia by estimating: (Kerala 2004)","options":[{"letter":"A","text":"Temperature variation"},{"letter":"B","text":"Increased CPK levels"},{"letter":"C","text":"LDH"},{"letter":"D","text":"Muscular rigidity"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Increased CPK levels","explanation":"b. Increased CPK levels"},{"n":140,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 182","pdfPage":171,"stem":"A 55-year-old male patient underwent cholecystectomy for Gall stone calculus. During surgery the patient’s pulse was irregularly irregular, 160/min, BP = 80/50 mm of Hg, temp. 40°C. On examination a swelling in the neck was found. Most likely diagnosis is: (MAHE 2007)","options":[{"letter":"A","text":"Thyroid storm"},{"letter":"B","text":"Myocardial infarction"},{"letter":"C","text":"Arrythmias"},{"letter":"D","text":"Stridor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thyroid storm","explanation":"a. Thyroid storm"},{"n":141,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 182","pdfPage":171,"stem":"All of the following conditions are associated with hyperthyroidism, except: (All India 2011)","options":[{"letter":"A","text":"Hashimoto’s thyroiditis"},{"letter":"B","text":"Grave’s disease"},{"letter":"C","text":"Toxic multinodular goiter"},{"letter":"D","text":"Struma ovary"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hashimoto’s thyroiditis","explanation":"a. Hashimoto’s thyroiditis"},{"n":142,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 182","pdfPage":171,"stem":"Hyperthyroidism occurs in: (PGI Nov 2011)","options":[{"letter":"A","text":"Hashimoto thyroiditis"},{"letter":"B","text":"Graves’ disease"},{"letter":"C","text":"Medullary thyroid carcinoma"},{"letter":"D","text":"Plummer’s disease"},{"letter":"E","text":"Struma ovarii"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Graves’ disease; D. Plummer’s disease; E. Struma ovarii","explanation":"b. Graves’ disease; d. Plummer’s disease; e. Struma ovarii (Ref: Harrison 20/e p2703, 19/e p2293)"},{"n":143,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Which of the following is a symptom of hypothyroidism? (JIPMER 2014, 2007)","options":[{"letter":"A","text":"Hyperactivity"},{"letter":"B","text":"Palpitation"},{"letter":"C","text":"Diarrhoea"},{"letter":"D","text":"Hair loss"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hair loss","explanation":"d. Hair loss"},{"n":144,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Reduction of size and vascularity prior to thyroidectomy is done by: (Recent Question 2015)","options":[{"letter":"A","text":"Iodides"},{"letter":"B","text":"Propylthiouracil"},{"letter":"C","text":"Radioiodine"},{"letter":"D","text":"Propranolol"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Iodides","explanation":"a. Iodides"},{"n":145,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"A patient underwent thyroidectomy for Hyperthyroidism. Two days later he presented with features of thyroid storm. What is the most likely cause? (AIIMS November 2015)","options":[{"letter":"A","text":"Poor antibiotic coverage"},{"letter":"B","text":"Rough handling during surgery"},{"letter":"C","text":"Removal of parathyroid"},{"letter":"D","text":"Inadequate preoperative preparation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Inadequate preoperative preparation","explanation":"83\nAnswer (book): Answer: D. Inadequate preoperative preparation"},{"n":146,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Treatment of choice for recurrent thyrotoxicosis after surgery is: (MCI June 2018)","options":[{"letter":"A","text":"Further surgery"},{"letter":"B","text":"Radioiodine followed by surgery"},{"letter":"C","text":"Radioiodine"},{"letter":"D","text":"Observation & follow-up"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Radioiodine","explanation":"c. Radioiodine\nGRAVE’S DISEASE"},{"n":147,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"All of the following are features of Grave’s disease except: (MCI Sept 2005)","options":[{"letter":"A","text":"More common in males"},{"letter":"B","text":"Tremor"},{"letter":"C","text":"Pretibial myxoedema"},{"letter":"D","text":"Intolerance to heat"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"More common in males","explanation":"a. More common in males (Ref: Schwartz 10/e p1531-1533; Sabiston 20/e p892; Bailey 27/e p811; Harrison 20/e p2703, 19/e p2293)"},{"n":148,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Complications of therapy with radioactive iodine includes:","options":[{"letter":"A","text":"Thyroid malignancy"},{"letter":"B","text":"Hypothyroidism"},{"letter":"C","text":"Leukemia"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Complications of Radioactive Iodine (I131) Therapy Acute Long-term Bone marrow suppressionQ\n• Chronic sialedenitis, taste dysfunction Cerebral edema & hemorrhageQ (brain • Fertility: Ovarian & testicular\ndamage leading to infertility & increased abortion rate metastasis)\n• Hematologic: Bone marrow suppressionQ, LeukemiaQ Nausea & vomitingQ\n• HypoparathyroidismQ Neck pain, swelling\n• Increased risk of cancer: Anaplastic carcinoma thyroidQ, carcinoma stomach, Sialedenitis, thyroiditis carcinoma\nbladder lung & breast, HCC Vocal cord paralysisQ\n• Pulmonary fibrosis\nAnswer (book): Answer: D. All of the above\nReference: William’s Endocrinology 10/e p479"},{"n":149,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Which of the following conditions is most common complication of radioiodine treatment of Grave’s disease? (COMEDK 2005, 2004)","options":[{"letter":"A","text":"Thyroid storm"},{"letter":"B","text":"Subacute thyroiditis"},{"letter":"C","text":"Thyroid cancer"},{"letter":"D","text":"Hypothyroidism"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypothyroidism","explanation":"d. Hypothyroidism"},{"n":150,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"In which of the following conditions radioactive iodine (Irradiation) can be used in Grave’s disease: (PGI Nov 2010)","options":[{"letter":"A","text":"Recurrence"},{"letter":"B","text":"Age >40 years"},{"letter":"C","text":"Elderly"},{"letter":"D","text":"Pregnant"},{"letter":"E","text":"Presence of associated co-morbidities"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Age >40 years; C. Elderly; E. Presence of associated co-morbidities","explanation":"b. Age >40 years; c. Elderly; e. Presence of associated co-morbidities (Ref: Schwartz 10/e p1532-1533; Sabiston 20/e p892-893; Bailey\n27/e p812; Harrison 20/e p2706, 19/e p2296)"},{"n":151,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Pretibial myxedema is seen in: (MHPGMET 2005)","options":[{"letter":"A","text":"Thyrotoxicosis"},{"letter":"B","text":"Hypothyroidism"},{"letter":"C","text":"Hyperparathyroidism"},{"letter":"D","text":"All"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thyrotoxicosis","explanation":"a. Thyrotoxicosis"},{"n":152,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Therapy of choice for diffuse toxic goiter in a patient over 45 years:","options":[{"letter":"A","text":"Surgery"},{"letter":"B","text":"Antithyroid drugs"},{"letter":"C","text":"Radioiodine"},{"letter":"D","text":"Antithyroid drugs first followed by surgery"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Radioiodine","explanation":"c. Radioiodine"},{"n":153,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Which of the following statements about Grave’s disease is false? (Recent Question 2018)","options":[{"letter":"A","text":"Results in hyperthyroidism"},{"letter":"B","text":"Autoimmune disorder"},{"letter":"C","text":"Common in male"},{"letter":"D","text":"Referred as diffuse toxic goiter"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Common in male","explanation":"c. Common in male (Ref: Schwartz 10/e p; Sabiston 20/e p; Bailey 27/e p)"},{"n":154,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"All of the following are true about Graves disease except: (JIPMER 2013)","options":[{"letter":"A","text":"Cardiac failure is common"},{"letter":"B","text":"Hypertrophy and hyperplasia or thyroid gland is due to TSH-Rab"},{"letter":"C","text":"Remissions and exacerbations are not infrequent"},{"letter":"D","text":"It is highly vascular with audible bruit"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Remissions and exacerbations are not infrequent","explanation":"c. Remissions and exacerbations are not infrequent\nHYPOTHYROIDISM"},{"n":155,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"In case of hypothyroidism which investigation is most informative and most commonly used: (AIIMS June 98)","options":[{"letter":"A","text":"Serum TSH level"},{"letter":"B","text":"Serum T3, T4 level"},{"letter":"C","text":"Serum calcitonin assay"},{"letter":"D","text":"Serum TRH assay"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Serum TSH level","explanation":"• The ultrasensitive TSH assay has become the most sensitive and specific test for the diagnosis of hyper-and\nhypothyroidism and for optimizing T4 therapyQ.\n• The enhanced sensitivity and specificity of TSH assays have greatly improved laboratory assessment of thyroid\nfunctionQ.\nAnswer (book): Answer: A. Serum TSH level\nReference: Schwartz 10/e p1529; Sabiston 20/e p895; Bailey 27/e p802; Harrison 20/e p2701, 19/e p2288"},{"n":156,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Hypothyroidism with increased TSH level is seen in all except: (PGI 90)","options":[{"letter":"A","text":"Sheehan’s syndrome"},{"letter":"B","text":"Lithium carbonate therapy"},{"letter":"C","text":"Post radioiodine ablation"},{"letter":"D","text":"Endemic goitre"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Sheehan’s syndrome","explanation":"Sheehan’s syndrome causes hypopituitarism leading to decreased TSHQ.\nAnswer (book): Answer: A. Sheehan’s syndrome\nReference: Harrison 20/e p2734, 19/e p2257"},{"n":157,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"During thyroidectomy, inferior thyroid artery is ligated at: (MCI Sept 2005)","options":[{"letter":"A","text":"Maximally away from the gland"},{"letter":"B","text":"Close to the gland"},{"letter":"C","text":"Half way from the gland"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Close to the gland","explanation":"• Both superior and inferior thyroid vessels should be ligated close to the thyroidQ.\n• Superiorly, to avoid injury to the external branch of the superior laryngeal nerve.\n• Inferiorly, to minimize devascularization of the parathyroids (extracapsularQ dissection) or injury to the RLNQ.\nThyroidectomy: Schwartz 10/e p1553\n• The dissection plane is kept as close to the thyroid as possible and the superior pole vessels are individually\nidentified, skeletonized, ligated, and divided low on the thyroid gland to avoid injury to the external branch of the\nsuperior laryngeal nerveQ\n• The inferior thyroid vessels are dissected, skeletonized, ligated, and divided as close to the surface of the thyroid\ngland as possible to minimize devascularization of the parathyroids (extracapsular dissection) or injury to the\nRLNQ.\nAnswer (book): Answer: B. Close to the gland\nReference: Schwartz 10/e p1551-1554; Sabiston 20/e p913; Bailey 27/e p813"},{"n":158,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Complications of total thyroidectomy include all except: (AIIMS May 2005)","options":[{"letter":"A","text":"Hoarseness"},{"letter":"B","text":"Airway obstruction"},{"letter":"C","text":"Hemorrhage"},{"letter":"D","text":"Hypercalcemia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypercalcemia","explanation":"d. Hypercalcemia (Ref: Schwartz 10/e p1556; Sabiston 20/e p920; Bailey 27/e p815)"},{"n":159,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Two hours after subtotal thyroidectomy for thyrotoxicosis, young woman rapidly becomes agitated and complains of increasing difficulty in breathing. Her pulse rate rises and central cyanosis is noticed on examination, her neck is found to be tensely swollen beneath the stitches. The most appropriate management in this case would be: (DPG 2011)","options":[{"letter":"A","text":"Intranasal oxygen"},{"letter":"B","text":"Passing an endotracheal tube in the ward"},{"letter":"C","text":"Removing sutures from all layers in the ward and evacuation of hematoma"},{"letter":"D","text":"Immediate transfer of the patient to the operation theatre for tracheostomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Removing sutures from all layers in the ward and evacuation of hematoma","explanation":"c. Removing sutures from all layers in the ward and evacuation of hematoma"},{"n":160,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 183","pdfPage":171,"stem":"Horner’s syndrome, all are true except: (AIIMS May 2011)","options":[{"letter":"A","text":"Miosis"},{"letter":"B","text":"Anhydrosis"},{"letter":"C","text":"Hyperchromatic iris"},{"letter":"D","text":"Apparent exophthalmos"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Apparent exophthalmos","explanation":"Clinical Features\nPtosisQ Miosis (constricted pupil)Q AnhydrosisQ EnopthalmosQ Loss of ciliospinal reflexesQ\nHorner’s Syndrome Less Common Features\n• Hyperactive accommodation\n• Hypochromic heterochromia\n• Hypotony\n• Hyperaemia\nAnswer (book): Answer: D. Apparent exophthalmos\nReference: Harrison 20/e p3173, 19/e p196, 208"},{"n":161,"chapter":"Thyroid","src":"question on PDF p. 171 · answer on PDF p. 184","pdfPage":171,"stem":"Horner’s syndrome is seen in all except: (AIIMS Nov 2010)","options":[{"letter":"A","text":"Carotid artery aneurysm"},{"letter":"B","text":"Medial medullary syndrome"},{"letter":"C","text":"Can occur following surgery for Raynaud’s syndrome"},{"letter":"D","text":"Multiple sclerosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Medial medullary syndrome","explanation":"b. Medial medullary syndrome (Ref: Harrison 20/e p3173, 19/e p196, 208)"},{"n":162,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Horner’s syndrome does not include: (COMEDK 2004)","options":[{"letter":"A","text":"Ptosis"},{"letter":"B","text":"Anhydrosis"},{"letter":"C","text":"Flushing"},{"letter":"D","text":"Mydriasis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Mydriasis","explanation":"d. Mydriasis"},{"n":163,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"During thyroidectomy, inferior thyroid artery ligation is done at what level? (MHPGMCET 2003)","options":[{"letter":"A","text":"As close to the thyroid gland as possible"},{"letter":"B","text":"As far away as possible from the thyroid gland"},{"letter":"C","text":"In the trachea-esophageal groove"},{"letter":"D","text":"Any of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"As close to the thyroid gland as possible","explanation":"a. As close to the thyroid gland as possible (Ref: Schwartz 10/e p1553; Sabiston 20/e p913)"},{"n":164,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"About thyroid surgery all are true except: (Punjab 2008)","options":[{"letter":"A","text":"Superior thyroid artery is ligated near the gland"},{"letter":"B","text":"Capsule is removed"},{"letter":"C","text":"Inferior thyroid artery is ligated away from gland"},{"letter":"D","text":"Capsule is kept intact"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Inferior thyroid artery is ligated away from gland; D. Capsule is kept intact","explanation":"• The inferior thyroid vessels are dissected, skeletonized, ligated, and divided as close to the surface of the thyroid\ngland as possible to minimize devascularization of the parathyroids (extracapsular dissection) or injury to the\nRLNQ.\n• Dissection is extracapsular (Capsule is removed) Q.\nAnswer (book): Answer: C. Inferior thyroid artery is ligated away from gland; D. Capsule is kept intact\nReference: Schwartz 10/e p1553"},{"n":165,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Hypoparathyroidism following thyroid surgery occurs within: (AIIMS Nov 2004, Nov 2003)","options":[{"letter":"A","text":"24 hours"},{"letter":"B","text":"2–5 days"},{"letter":"C","text":"7–14 days"},{"letter":"D","text":"2–3 weeks"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"2–5 days","explanation":"b. 2–5 days"},{"n":166,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Complications of hemithyroidectomy include all of the following except? (All India 2008)","options":[{"letter":"A","text":"Hypocalcemia"},{"letter":"B","text":"Wound hematoma"},{"letter":"C","text":"Recurrent laryngeal nerve palsy"},{"letter":"D","text":"External branch of superior laryngeal nerve palsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hypocalcemia","explanation":"a. Hypocalcemia\n 167. b.  Oral calcium and vitamin D (Ref: Sabiston 20/e p919, 19/e p921; Bailey 27/e p815)\nManagement of Post-operative Hypocalcemia\nTransient Hypocalcemia Prolonged or Permanent Hypocalcemia\n• Asymptomatic\twith\tcalcium\tlevel\t>8 mg/dL: No treatmentQ\n• Mild symptoms or calcium level <8 mg/dL: Oral calciumQ\n• Severe Symptoms: IV calciumQ\n• Oral calcium with vitamin DQ\n•\t If hypocalcemia is expected to be prolonged or permanent (as following a 3 and 1/2 gland parathyroid resection or following\ntotal parathyroidectomy with autograft) then oral calcium should be started as soon as possible with vitamin D."},{"n":167,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A patient undergoes thyroid surgery, following which he develops perioral tingling. Blood calcium is 8.9 meq/L. Next step is: (All India 2001)","options":[{"letter":"A","text":"Vitamin D orally"},{"letter":"B","text":"Oral calcium and vitamin D"},{"letter":"C","text":"Intravenous calcium gluconate and serial monitoring"},{"letter":"D","text":"Wait for calcium to decrease to < 7.0 before talking further action"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Oral calcium and vitamin D","explanation":"Management of Post-operative Hypocalcemia Transient Hypocalcemia\nProlonged or Permanent Hypocalcemia\n• Asymptomatic with calcium level >8 mg/dL: No treatmentQ\n• Mild symptoms or calcium level <8 mg/dL: Oral calciumQ\n• Severe Symptoms: IV calciumQ\n• Oral calcium with vitamin DQ\n• If hypocalcemia is expected to be prolonged or permanent (as following a 3 and 1/2 gland parathyroid resection\nor following total parathyroidectomy with autograft) then oral calcium should be started as soon as possible with\nvitamin D.\nAnswer (book): Answer: B. Oral calcium and vitamin D\nReference: Sabiston 20/e p919, 19/e p921; Bailey 27/e p815"},{"n":168,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Patient after thyroid surgery presents with perioral paresthe-sia. Serum calcium level is 7 mg/dl. What will be the best management: (AIIMS Nov 2000)","options":[{"letter":"A","text":"Oral vitamin D3"},{"letter":"B","text":"Oral vitamin D3 with calcium"},{"letter":"C","text":"IV calcium gluconate"},{"letter":"D","text":"Oral calcium"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Oral calcium","explanation":"d. Oral calcium"},{"n":169,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A post-thyroidectomy patient develops signs and symptoms of tetany. The management is: (All India 2000)","options":[{"letter":"A","text":"IV calcium gluconate"},{"letter":"B","text":"Bicarbonate"},{"letter":"C","text":"Calcitonin"},{"letter":"D","text":"Vitamin D"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"IV calcium gluconate","explanation":"a. IV calcium gluconate"},{"n":170,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"In postoperative room after thyroid surgery patient developed sudden respiratory distress, dressing was removed and it was found to be slightly blood stained and wound was bulging. What will be first thing to be done? (AIIMS June 2000, Nov 2000)","options":[{"letter":"A","text":"Tracheostomy"},{"letter":"B","text":"Cricothyroidotomy"},{"letter":"C","text":"Laryngoscopy and intubation"},{"letter":"D","text":"Remove the stitch and take the patient to O.T."}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Remove the stitch and take the patient to O.T.","explanation":"d. Remove the stitch and take the patient to O.T."},{"n":171,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A patient presents with swelling in the neck following a thyroidectomy; what is the most likely resulting complication? (All India 2001)","options":[{"letter":"A","text":"Respiratory obstruction"},{"letter":"B","text":"Recurrent laryngeal nerve palsy"},{"letter":"C","text":"Hypovolemia"},{"letter":"D","text":"Hypocalcemia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Respiratory obstruction","explanation":"a. Respiratory obstruction"},{"n":172,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Patient presents with neck swelling and respiratory distress few hours after a thyroidectomy surgery. Next management would be: (All India 2001)","options":[{"letter":"A","text":"Open immediately"},{"letter":"B","text":"Trecheostomy"},{"letter":"C","text":"Wait and watch"},{"letter":"D","text":"Oxygen by mask"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Open immediately","explanation":"a. Open immediately"},{"n":173,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Most dangerous complication in a patient who had undergone thyroid surgery and develop hematoma at the operative site: (AIIMS Nov 99)","options":[{"letter":"A","text":"Respiratory obstruction"},{"letter":"B","text":"Recurrent laryngeal nerve palsy"},{"letter":"C","text":"Dysphagia"},{"letter":"D","text":"Shock"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Respiratory obstruction","explanation":"a. Respiratory obstruction"},{"n":174,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"After thyroidectomy, patient developed stridor within 2 hours. All are likely cause of stridor except: (AIIMS Nov 2001, Nov 2000)","options":[{"letter":"A","text":"Hypocalcemia"},{"letter":"B","text":"Recurrent laryngeal nerve palsy"},{"letter":"C","text":"Laryngomalacia"},{"letter":"D","text":"Wound hematoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hypocalcemia","explanation":"a. Hypocalcemia"},{"n":175,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A 50-year-old male is suffering from severe dyspnea after thyroid surgery, treatment of choice is: (AIIMS June 97)","options":[{"letter":"A","text":"Tracheostomy"},{"letter":"B","text":"Open the operative site"},{"letter":"C","text":"Wait and watch"},{"letter":"D","text":"Cricothyroidotomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Open the operative site","explanation":"b. Open the operative site"},{"n":176,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A patient operated for thyroid surgery for a thyroid swelling, later in the evening developed difficulty in breathing. There was swelling in the neck. The immediate management would be: (AIIMS June 2002)","options":[{"letter":"A","text":"Epinephrine injection"},{"letter":"B","text":"Tracheostomy"},{"letter":"C","text":"IV calcium gluconate"},{"letter":"D","text":"Open the wound sutures in the ward"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Open the wound sutures in the ward","explanation":"d. Open the wound sutures in the ward"},{"n":177,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Replacement dose of thyroxine is: (All India 93)","options":[{"letter":"A","text":"0.1–0.2 mg"},{"letter":"B","text":"0.3–0.4 mg"},{"letter":"C","text":"1–2 mg"},{"letter":"D","text":"3–4 mg"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"0.1–0.2 mg","explanation":"• Daily replacement dose of thyroxine: 1.6 μg/Kg body weight (0.1–0.15 gm) Q\n• For TSH suppression (in PTC and FTC), dose of thyroxine: 2.7 μg/Kg body weightQ\nAnswer (book): Answer: A. 0.1–0.2 mg\nReference: Harrison 19/e p2306"},{"n":178,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"All of the following are early life threatening complications of thyroid operation except: (DPG 2010, SGPGI 2005)","options":[{"letter":"A","text":"Tracheomalacia and collapse of the larynx"},{"letter":"B","text":"Wound hematoma with compression of the trachea"},{"letter":"C","text":"Hypocalcemia"},{"letter":"D","text":"Thyroid storm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hypocalcemia","explanation":"• Tracheomalacia and collapse of the larynx, wound hematoma with compression of the trachea and thyroid storm\nare early life threatening complications of thyroidectomyQ.\n• Hypocalcemia which occurs after 2–5 days after operation and severity of causing life threatening situation is\nleast with hypocalcemia as compared to the given options.\nAnswer (book): Answer: C. Hypocalcemia"},{"n":179,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Vocal cord palsy in thyroid surgery is due to injury to: (COMEDK 2008, UPSC 2008)","options":[{"letter":"A","text":"Superficial laryngeal nerve"},{"letter":"B","text":"Recurrent laryngeal nerve"},{"letter":"C","text":"Ansa cervicalis"},{"letter":"D","text":"Vagus nerve"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Recurrent laryngeal nerve","explanation":"b. Recurrent laryngeal nerve"},{"n":180,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Hemorrhage after thyroidectomy is due to: (Recent Question 2014)","options":[{"letter":"A","text":"External carotid artery"},{"letter":"B","text":"Internal carotid artery"},{"letter":"C","text":"Superior thyroid artery"},{"letter":"D","text":"Inferior thyroid artery"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Superior thyroid artery","explanation":"c. Superior thyroid artery\nTHYROIDITIS"},{"n":181,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"Thyroid biopsy of a patient showed the presence of Hurthle cells. Antibodies found in this condition are: (Punjab 2011)","options":[{"letter":"A","text":"Anti-TPO"},{"letter":"B","text":"Anti-mitochondrial"},{"letter":"C","text":"Anti-RNP"},{"letter":"D","text":"Anti-dsDNA"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Anti-TPO","explanation":"a. Anti-TPO (Ref: Schwartz 10/e p1535; Sabiston 20/e p891; Bailey 27/e p821; Harrison 20/e p2699, 19/e p2290)"},{"n":182,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A 40-year-old female presents with fever, fatigue, diffuse painful swelling in the midline of the neck, FNAC of the same reveals epitheloid cells and giant cells, the likely diagnosis is:","options":[{"letter":"A","text":"Acute thyroiditis"},{"letter":"B","text":"Subacute thyroiditis"},{"letter":"C","text":"Tubercular lymphadenitis"},{"letter":"D","text":"Hashimotos thyroiditis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Subacute thyroiditis","explanation":"b. Subacute thyroiditis (Ref: Schwartz 10/e p1535; Sabiston 20/e p891; Bailey 27/e p822; Harrison 20/e p2708, 19/e p2298)"},{"n":183,"chapter":"Thyroid","src":"question on PDF p. 172 · answer on PDF p. 184","pdfPage":172,"stem":"A patient with autoimmune thyroiditis present with hypothyroidism. Which of the following is true? (JIPMER 2011)","options":[{"letter":"A","text":"Thyroid peroxidase antibodies"},{"letter":"B","text":"Painless enlargement of thyroid"},{"letter":"C","text":"Common in men"},{"letter":"D","text":"No malignant risk"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thyroid peroxidase antibodies","explanation":"a. Thyroid peroxidase antibodies"},{"n":184,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"A person has fever and pain in thyroid gland. True statement(s) is/are: (PGI June 2009)","options":[{"letter":"A","text":"T3 and T4 level normal"},{"letter":"B","text":"↑ESR"},{"letter":"C","text":"↑TSH"},{"letter":"D","text":"It is due to TB"},{"letter":"E","text":"Radioactive iodine uptake is ↑ed"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"↑ESR","explanation":"b. ↑ESR"},{"n":185,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"Hashimoto’s thyroiditis, all are true except: (AIIMS May 2011)","options":[{"letter":"A","text":"Follicular destruction"},{"letter":"B","text":"Increase in lymphocytes"},{"letter":"C","text":"Oncocytic metaplasia"},{"letter":"D","text":"Orphan Annie eye nuclei"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Orphan Annie eye nuclei","explanation":"d. Orphan Annie eye nuclei"},{"n":186,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"The laboratory investigation of a patient shows ↓T4, and ↑TSH. Which of the following is the most likely diagnosis: (All India 2011)","options":[{"letter":"A","text":"Grave’s disease"},{"letter":"B","text":"Hashimoto’s disease"},{"letter":"C","text":"Pituitary failure"},{"letter":"D","text":"Hypothalamic failure"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hashimoto’s disease","explanation":"b. Hashimoto’s disease"},{"n":187,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"Which of the following conditions is associated with hypothyroidism? (All India 2011)","options":[{"letter":"A","text":"Hashimoto’s thyroiditis"},{"letter":"B","text":"Grave’s disease"},{"letter":"C","text":"Toxic multinodular goiter"},{"letter":"D","text":"Struma ovary"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hashimoto’s thyroiditis","explanation":"a. Hashimoto’s thyroiditis"},{"n":188,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"Most common cause of thyroiditis is: (All India 2000)","options":[{"letter":"A","text":"Reidel’s thyroiditis"},{"letter":"B","text":"Subacute thyroiditis"},{"letter":"C","text":"Hashimoto’s thyroiditis"},{"letter":"D","text":"Viral thyroiditis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hashimoto’s thyroiditis","explanation":"c. Hashimoto’s thyroiditis"},{"n":189,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"All of the following are true of de-Quervain’s thyroiditis except: (All India 1996)","options":[{"letter":"A","text":"Pain"},{"letter":"B","text":"Increased ESR"},{"letter":"C","text":"Increased radioactive iodine uptake"},{"letter":"D","text":"Fever"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Increased radioactive iodine uptake","explanation":"c. Increased radioactive iodine uptake"},{"n":190,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"Not a feature of de-Quervain’s disease: (All India 2002)","options":[{"letter":"A","text":"Autoimmune in etiology"},{"letter":"B","text":"↑ ESR"},{"letter":"C","text":"Tends to regress spontaneously"},{"letter":"D","text":"Painful and associated with enlargement of thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Autoimmune in etiology","explanation":"a. Autoimmune in etiology"},{"n":191,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"Which of the following is wrong about subacute thyroiditis? (Orissa 2011)","options":[{"letter":"A","text":"Usually presents with painful enlargement of thyroid gland"},{"letter":"B","text":"There may be features of hyperthyroidism or hypothyroidism"},{"letter":"C","text":"In the thyrotoxic phase radioiodine uptake is increased"},{"letter":"D","text":"High ESR"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"In the thyrotoxic phase radioiodine uptake is increased","explanation":"c. In the thyrotoxic phase radioiodine uptake is increased"},{"n":192,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"‘Hurthle cells ‘ are seen in: (All India 95)","options":[{"letter":"A","text":"Agranulomatous thyroiditis"},{"letter":"B","text":"Hashimoto’s thyroiditis"},{"letter":"C","text":"Papillary carcinoma of the thyroid"},{"letter":"D","text":"Thyroglossal cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hashimoto’s thyroiditis","explanation":"b. Hashimoto’s thyroiditis"},{"n":193,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"A patient presents with bilateral proptosis, heat intolerance and palpitations. Most unlikely diagnosis here would be: (All India 2001)","options":[{"letter":"A","text":"Hashimoto’s thyroiditis"},{"letter":"B","text":"Thyroid adenoma"},{"letter":"C","text":"Diffuse thyroid goitre"},{"letter":"D","text":"Reidel’s thyroiditis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Reidel’s thyroiditis","explanation":"d. Reidel’s thyroiditis (Ref: Schwartz 10/e p1536; Sabiston 20/e p891; Bailey 27/e p822)"},{"n":194,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"A 25-years-old male presents with ophthalmologic signs of thyrotoxicosis. All are possibilities, except: (All India 2002)","options":[{"letter":"A","text":"Diffused thyroid goitre"},{"letter":"B","text":"Hashimoto’s thyroiditis"},{"letter":"C","text":"Riedel’s thyroiditis"},{"letter":"D","text":"Adenomatous goitre"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Riedel’s thyroiditis","explanation":"c. Riedel’s thyroiditis"},{"n":195,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"A young patient has a midline, tender swelling in neck occurring after an attack of sore throat. The diagnosis is: (AIIMS Nov 93)","options":[{"letter":"A","text":"Acute thyroiditis"},{"letter":"B","text":"Thyroglossal cyst"},{"letter":"C","text":"Subacute thyroiditis"},{"letter":"D","text":"Toxic goiter"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Subacute thyroiditis","explanation":"Diagnosis in this case is subacute thyroiditis. Symptoms are more severe in acute thyroiditis with\ncomplications and acute thyroiditis is more common in children.\nAnswer (book): Answer: C. Subacute thyroiditis\nReference: Schwartz 10/e p1535; Sabiston 20/e p891"},{"n":196,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"In Hashimoto’s disease serum antibodies are mainly against: (Recent Question 2016)","options":[{"letter":"A","text":"Thyroid follicles"},{"letter":"B","text":"Thyroxine"},{"letter":"C","text":"Thyroglobulins"},{"letter":"D","text":"Iodine"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Thyroglobulins","explanation":"c. Thyroglobulins"},{"n":197,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"The only reason for operating in case thyroiditis:","options":[{"letter":"A","text":"To prevent cancerous degeneration"},{"letter":"B","text":"For relief of pain in neck and ear"},{"letter":"C","text":"To overcome pressure on trachea or esophagus"},{"letter":"D","text":"To cure the toxic reaction"},{"letter":"E","text":"If there is auto immune reaction"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"To overcome pressure on trachea or esophagus","explanation":"c. To overcome pressure on trachea or esophagus"},{"n":198,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"All are true abut Hashimoto’s thyroiditis except: (Kerala 95)","options":[{"letter":"A","text":"Antithyroid microsomal antibodies"},{"letter":"B","text":"Antithyroid nuclear antibodies"},{"letter":"C","text":"Anti-TSH receptor antibodies"},{"letter":"D","text":"Increased level of thyroid hormones"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Antithyroid nuclear antibodies","explanation":"b. Antithyroid nuclear antibodies"},{"n":199,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"The thyroiditis also known as “Painless Thyroiditis”: (MAHE 2007)","options":[{"letter":"A","text":"Subacute lymphocytic thyroiditis"},{"letter":"B","text":"de-Quervain’s thyroiditis"},{"letter":"C","text":"Hashimoto’s thyroiditis"},{"letter":"D","text":"Riedel’s thyroiditis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Subacute lymphocytic thyroiditis","explanation":"a. Subacute lymphocytic thyroiditis"},{"n":200,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"A patient present with bilateral proptosis, heat intolerance and palpitations; most unlikely diagnosis here would be: (All India 2001, 2000)","options":[{"letter":"A","text":"Hashimoto’s thyroiditis"},{"letter":"B","text":"Thyroid adenoma"},{"letter":"C","text":"Diffuse thyroid goiter"},{"letter":"D","text":"Reidel’s thyroiditis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Reidel’s thyroiditis","explanation":"d. Reidel’s thyroiditis"},{"n":201,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 184","pdfPage":173,"stem":"DeQvervain’s thyroiditis is characterised by: (COMEDK 2014)","options":[{"letter":"A","text":"Mononuclear cell infiltration"},{"letter":"B","text":"Histiocyte reaction"},{"letter":"C","text":"Giant cell infiltration"},{"letter":"D","text":"Eosinophilia"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gaint cell infiltration","explanation":"c. Gaint cell infiltration"},{"n":202,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 185","pdfPage":173,"stem":"Hyoid bone is closely associated with: (Orissa 2011)","options":[{"letter":"A","text":"Bronchogenic cyst"},{"letter":"B","text":"Cystic hygroma"},{"letter":"C","text":"Branchial cyst"},{"letter":"D","text":"Thyroglossal cyst/fistula"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Thyroglossal cyst/fistula","explanation":"d. Thyroglossal cyst/fistula (Ref: Schwartz 10/e p1521; Sabiston 20/e p1861)"},{"n":203,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 185","pdfPage":173,"stem":"True about thyroglossal cyst is all except: (MHPGMCET 2003)","options":[{"letter":"A","text":"Does not move with deglutition"},{"letter":"B","text":"Move with protrusion of tongue"},{"letter":"C","text":"Sistrunk’s operation is treatment of choice"},{"letter":"D","text":"Most common site is subhyoid region"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Does not move with deglutition","explanation":"a. Does not move with deglutition"},{"n":204,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 185","pdfPage":173,"stem":"A 10-year-old child presented with midline swelling in anterior position of neck. Most probable diagnosis is:","options":[{"letter":"A","text":"Thyroglossal cyst"},{"letter":"B","text":"Thyroglossal fistula"},{"letter":"C","text":"Cold abscess"},{"letter":"D","text":"Acute lymphadenitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Thyroglossal cyst","explanation":"a. Thyroglossal cyst (Ref: Schwartz 10/e p1521; Sabiston 20/e p1861)"},{"n":205,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 185","pdfPage":173,"stem":"Sistrunk’s operation is done in: (WBPG 2015, MHPGMCET 2008, 2006)","options":[{"letter":"A","text":"Parotid tumor"},{"letter":"B","text":"Thyroglossal fistula"},{"letter":"C","text":"Thyroglossal cyst"},{"letter":"D","text":"Branchial fistula"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Thyroglossal cyst","explanation":"c. Thyroglossal cyst"},{"n":206,"chapter":"Thyroid","src":"question on PDF p. 173 · answer on PDF p. 185","pdfPage":173,"stem":"Most common site of thyroglossal cyst: (Recent Question 2013, DNB 2009, 2007, 2005, 2003, MHSSMCET 2005, AIIMS June 97)","options":[{"letter":"A","text":"Suprahyoid"},{"letter":"B","text":"Hyoid"},{"letter":"C","text":"Subhyoid"},{"letter":"D","text":"Intra-thyroid"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Subhyoid","explanation":"c. Subhyoid"},{"n":207,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"The following statements about thyroglossal cyst are true, except: (All India 2006)","options":[{"letter":"A","text":"Frequent cause of anterior midline neck masses in the first decade of life"},{"letter":"B","text":"The cyst is located within 2 cm of the midline"},{"letter":"C","text":"Incision and drainage is the treatment of choice"},{"letter":"D","text":"The swelling moves upwards on protrusion of tongue"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Incision and drainage is the treatment of choice","explanation":"c. Incision and drainage is the treatment of choice"},{"n":208,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Thyroglossal cyst may occasionally give rise to carcinoma:","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Medullary"},{"letter":"C","text":"Anaplastic"},{"letter":"D","text":"Follicular"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary","explanation":"a. Papillary"},{"n":209,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Sistrunk’s operation consists of: (DPG 2009 March)","options":[{"letter":"A","text":"Excision of hyoid bone and cone of tongue muscle"},{"letter":"B","text":"Excision of hyoid bone and the cyst"},{"letter":"C","text":"Excision of central part of hyoid bone and cone of tongue muscles upto foramen caecum"},{"letter":"D","text":"Excision of cyst only"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Excision of central part of hyoid bone and cone of tongue muscles upto foramen caecum","explanation":"c. Excision of central part of hyoid bone and cone of tongue muscles upto foramen caecum"},{"n":210,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"A central midline neck swelling is noted in a 4 years old girl posted for tonsillectomy. The swelling is, painless, mobile, and cystic, just below the hyoid bone of size 2x1.1x1cm. USG showed a thick walled cystic lesion. Management would include: (AIIMS Nov 97)","options":[{"letter":"A","text":"Surgical removal"},{"letter":"B","text":"Antibiotics"},{"letter":"C","text":"Percutaneous aspiration"},{"letter":"D","text":"Chest X-ray"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Surgical removal","explanation":"a. Surgical removal"},{"n":211,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"The occurence of hyperthyroidism following administration of supplemental iodine to subject with endemic iodine deficiency goitre is known as: (All India 2012)","options":[{"letter":"A","text":"Jod-Basedow effect"},{"letter":"B","text":"Wolff-Chaikoff effect"},{"letter":"C","text":"Thyrotoxicosis factitia"},{"letter":"D","text":"De-Quervains thyroiditis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Jod-Basedow effect","explanation":"a. Jod-Basedow effect (Ref: Schwartz 10/e p1526; Sabiston 20/e p886; Harrison 20/e p2710, 19/e p2286)"},{"n":212,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Which of the following most closely represents the lowest detection limit for third generation TSH assays? (All India 2012)","options":[{"letter":"A","text":"0.4 mIU/L"},{"letter":"B","text":"0.04 mIU/L"},{"letter":"C","text":"0.004 mIU/L"},{"letter":"D","text":"0.0004 mIU/L"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"0.04 mIU/L","explanation":"The lower functional limit for third generation TSH assays is about 0.01 to 0.02 mIU/L.\nAnswer (book): Answer: B. 0.04 mIU/L\nReference: The thyroid: a Fundamental and Clinical Text (Lippincott Williams) 2008/329-330"},{"n":213,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Recurrent laryngeal nerve is in close association with: (AIIMS Nov 93)","options":[{"letter":"A","text":"Superior thyroid artery"},{"letter":"B","text":"Inferior thyroid artery"},{"letter":"C","text":"Middle thyroid vein"},{"letter":"D","text":"Superior thyroid vein"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Inferior thyroid artery","explanation":"b. Inferior thyroid artery"},{"n":214,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Normal thyroid weight varies …….. with dietary iodine content:","options":[{"letter":"A","text":"Directly proportional"},{"letter":"B","text":"Inversely"},{"letter":"C","text":"Inverse cubically"},{"letter":"D","text":"Not fixed"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Inversely","explanation":"b. Inversely"},{"n":215,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Average weight of thyroid gland where diet is rich in iodine is:","options":[{"letter":"A","text":"10–12 gm"},{"letter":"B","text":"14–16 gm"},{"letter":"C","text":"18–20 gm"},{"letter":"D","text":"28–30 gm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"18–20 gm","explanation":"c. 18–20 gm"},{"n":216,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Protein bound iodine measures secretary function of thyroid in all of the following circumstances except: (All India 90)","options":[{"letter":"A","text":"Nephrotic syndrome"},{"letter":"B","text":"Following hemithyroidectomy"},{"letter":"C","text":"During ampicillin therapy"},{"letter":"D","text":"Asthamatics on ephedrine"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nephrotic syndrome","explanation":"• In Nephrotic syndrome, iodine binding proteins are decreased.\nAnswer (book): Answer: A. Nephrotic syndrome"},{"n":217,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Isthmus of thyroid gland overlies the: (DPG 97)","options":[{"letter":"A","text":"1st tracheal cartilage"},{"letter":"B","text":"1st and 2nd tracheal cartilage"},{"letter":"C","text":"2nd and 3rd and 4th tracheal cartilage"},{"letter":"D","text":"3rd and 4th tracheal cartilage"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"2nd and 3rd and 4th tracheal cartilage","explanation":"Isthmus that is located just inferior to the cricoid cartilage, usually anterior to the 2nd and 3rd tracheal\ncartilages.\nThyroid Gland\nCoverings of the Gland\n• True capsule: Thin capsule of connective tissue, which extends into the glandular parenchyma & divides each\nlobe into irregularly shaped & sized lobules.\n• False capsule is derived from pretracheal fascia.\nBeahr’s Triangle\n• Boundaries: Base: Common carotid artery; Superiorly: Inferior thyroid artery; Inferiorly: RLNQ\n• Helps in identifying RLN & avoiding its injuryQ\nAnswer (book): Answer: C. 2nd and 3rd and 4th tracheal cartilage\nReference: Schwartz 10/e p1523; Sabiston 20/e p880-882"},{"n":218,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"Scabard trachea is seen in: (Karnataka 99)","options":[{"letter":"A","text":"Thyroid cancer"},{"letter":"B","text":"Thyroiditis"},{"letter":"C","text":"Goitre"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All the above (www.medixon.com)","explanation":"Scabard (Saber-Sheath) Trachea\n• Flattening of trachea caused by lateral compressionQ by swellings or tumors\n• Causes: Carcinoma thyroid, thyroiditis, carcinoma larynx, goitreQ\nAnswer (book): Answer: D. All the above (www.medixon.com)"},{"n":219,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 185","pdfPage":174,"stem":"A new born with a goiter large enough to cause dyspnoea is best treated with:","options":[{"letter":"A","text":"Sulfonamides"},{"letter":"B","text":"Tracheostomy"},{"letter":"C","text":"T3"},{"letter":"D","text":"Iodides"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tracheostomy","explanation":"Partial thyroidectomy is preferred over tracheostomy.\nNormal weight of thyroid gland: 20–25 gmsQ Thyroid is storage site of > 90% of body’s iodine contentQ Daily iodine\nrequirement: 100–150 μgQ Father of thyroid surgery: Theodor KocherQ Gland weight varies inversely with iodine\nintakeQ. Isthmus that is located just inferior to the cricoid cartilage, usually anterior to 2nd & 3rd (mainly) and 4th\ntracheal ringsQ. A pyramidal lobe is present in about 50% of patients. Thyroid capsule is condensed into the\nposterior suspensory or Berry’s ligamentQ near the cricoid cartilage & upper tracheal rings.\n• Thyroid gland has a thin capsule of connective tissue, which extends into glandular parenchyma & divides each\nlobe into irregularly shaped and sized lobules.\n• External laryngeal nerve runs close to the superior thyroid artery and the recurrent laryngeal nerve runs close to\nthe inferior thyroid arteryQ.\nAnswer (book): Answer: B. Tracheostomy\nReference: Nelson 19/e p2284"},{"n":220,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"Which of the following factors contribute to the development of duodenal ulcer? (PGI 2001)","options":[{"letter":"A","text":"I-131"},{"letter":"B","text":"I-125"},{"letter":"C","text":"Tc-99"},{"letter":"D","text":"P-32"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"I-131","explanation":"a. I-131"},{"n":221,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"In pregnancy: (APPG 2004)","options":[{"letter":"A","text":"Radioiodine contraindicated"},{"letter":"B","text":"Thiouracil is contraindicated"},{"letter":"C","text":"Surgery is contraindicated"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Radioiodine is contraindicated","explanation":"a. Radioiodine is contraindicated"},{"n":222,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"Pendred’s syndrome is due to a defect in: (MCI June 2018, COMEDK 2007, 2008)","options":[{"letter":"A","text":"Chromosome 7p"},{"letter":"B","text":"Chromosome 7q"},{"letter":"C","text":"Chromosome 8p"},{"letter":"D","text":"Chromosome 8q"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chromosome 7q","explanation":"Pendred’s Syndrome\n• Consists of congenital sensorineural hearing loss + goitreQ\n• Due to defect in sulfate transport protein (chromosome 7qQ) to the thyroid gland and cochlea\nRafetoff Syndrome\nEnd organ resistance to T4Q\nAnswer (book): Answer: B. Chromosome 7q\nReference: Harrison 20/e p2693, 19/e p2284; Schwartz 10/e p1534"},{"n":223,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"Reddish swelling in the region of foramen caecum: (DPG 2007)","options":[{"letter":"A","text":"Lingual thyroid"},{"letter":"B","text":"Lingual tonsil"},{"letter":"C","text":"Ranula"},{"letter":"D","text":"Thyroglossal cyst"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lingual thyroid","explanation":"Reddish swelling in the region of foramen caecum is Lingual thyroid.\nLingual Thyroid Forms a rounded swelling at the back of tongue at the foramen caecumQ It may represent the only\nthyroid tissue presentQ May cause dysphasia, impairment of speech, respiratory obstruction or hemorrhage Medical\ntreatment options include administration of exogenous thyroid hormone to suppress TSH and RAI ablation followed\nby hormone replacement.\n• Surgical excision is rarely needed but, if required, should be preceded by an evaluation of normal thyroid tissue in\nthe neck to avoid inadvertently rendering the patient hypothyroid.\nAnswer (book): Answer: A. Lingual thyroid\nReference: Schwartz 10/e p1522"},{"n":224,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"True about Struma Ovarii: (PGI June 2007)","options":[{"letter":"A","text":"Ectopic thyroid"},{"letter":"B","text":"Ectopic ovary"},{"letter":"C","text":"Malignancy"},{"letter":"D","text":"Benign lesion"},{"letter":"E","text":"Included in teratoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Benign lesion; E. Included in Teratoma","explanation":"Struma Ovarii\nHighly specialized variety of teratoma A benign ovarian tumor containing thyroid tissueQ The tumor is solid and\nconsisting entirely of thyroid tissue Some cases develop thyrotoxicosisQ Most of the tumor is innocent, but\nmalignant transformation have been recorded\nAnswer (book): Answer: D. Benign lesion; E. Included in Teratoma\nReference: Shaws Gynecology 14/e p336-337"},{"n":225,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"Absent parathyroid, thymic aplasia with immuno-deficiency and cardiac defects are features of: (MHPGMCET 2009)","options":[{"letter":"A","text":"Autoimmune polyglandular syndrome"},{"letter":"B","text":"Pendred syndrome"},{"letter":"C","text":"Di George syndrome"},{"letter":"D","text":"Lesch-Nyhan syndrome"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Di George syndrome","explanation":"Di-George Syndrome Characterized by\n• Congenital cardiac defects, particularly those involving great vesselsQ\n• Hypocalcemic tetany due to failure of parathyroid developmentQ\n• Absence of normal thymus, T-cell immunodeficiencyQ\nAnswer (book): Answer: C. Di George syndrome\nReference: Schwartz 10/e p1574"},{"n":226,"chapter":"Thyroid","src":"question on PDF p. 174 · answer on PDF p. 186","pdfPage":174,"stem":"This picture depicts …….. of examination of the thyroid gland. Choose the correct answer: (APPG 2016)","options":[{"letter":"A","text":"Kocher’s method"},{"letter":"B","text":"Lahey’s method"},{"letter":"C","text":"Crile’s method"},{"letter":"D","text":"Pizzillo’s method"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pizzillo’s method.","explanation":"d. Pizzillo’s method."},{"n":1,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"A 20-year-old male presents with chronic constipation, headache and habitus, neuromas of tongue, medullated corneal nerve fibers and nodule of 2X2 cm size in left lobe of thyroid. This patient is a case of: (All India 2004)","options":[{"letter":"A","text":"Sporadic medullary carcinoma of thyroid"},{"letter":"B","text":"Familial medullary carcinoma of thyroid"},{"letter":"C","text":"MEN-2A"},{"letter":"D","text":"MEN-2B"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"MEN-2B","explanation":"MEN-1 (WerMer’s Syndrome) | Parathyroid Adenoma | Pancreatic NET (PGI) | Pituitary Adenoma\n• MC endocrine abnormality (>98% of affected individuals) in MEN-1 is multiglandular parathyroid tumorsQ.\n• Hyperparathyroidism is MC manifestation (cardinal sign of MEN-1 is parathyroid adenoma of multicentricity) Q.\n• Hypercalcemia is first biochemical abnormalityQ detected in MEN-1 and may precede the clinical onset of a\npancreatic NET or pituitary neoplasm by several years.\n• Pancreatic NET is 2nd MC manifestationQ.\n• Nonfunctioning or that secrete pancreatic polypeptideQ are MC pancreatic NET in MEN-1.\n• MC functional NET in patients with MEN-1 is gastrinomaQ followed by insulinoma.\n• MC increased pancreatic hormone: Pancreatic polypeptides >Gastrin >InsulinQ (PGI)\n• Prolactinoma is most commonQ.\n• Diagnosed by increased prolactin (>200 μg/l) and MRI.\nMEN-2A (Sipple syndrome MEN) Medullary carcinoma thyroidQ PheochromocytomaQ Parathyroid hyperplasia or\nadenomaQ Hirschprung’s diseaseQ Cutaneous lichen amyloidosisQ\nMEN-2B (MEN-3)\nComponents\nMedullary carcinoma thyroidQ PheochromocytomaQ Intestinal ganglioneuromasQ Mucosal neuromasQ MegacolonQ\nMarfanoid featuresQ\nDefect\n• RET oncogene (cysteineQ codon)\n• Chromosome: 10Q\n• RET oncogene (tyrosine kinaseQ domain)\n• Chromosome: 10Q\nTransmission\n• Autosomal dominantQ\n• Autosomal dominantQ\nAnswer (book): Answer: D. MEN-2B\nReference: Schwartz 10/e p289; Sabiston 20/e p993, 1003, 1006; Bailey 27/e p856-857; Harrison 20/e p2752, 19/e p2335"},{"n":2,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"True about MEN-1: (PGI June 2004)","options":[{"letter":"A","text":"↑ VMA in urine"},{"letter":"B","text":"↑ Calcitonin"},{"letter":"C","text":"Hypergastrinemia"},{"letter":"D","text":"Hyperprolactinemia"},{"letter":"E","text":"Hypocalcemia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"↑ VMA in urine, C. Hypergastrinemia, D. Hyperprolactinemia","explanation":"a. ↑ VMA in urine, c. Hypergastrinemia, d. Hyperprolactinemia (Ref: Schwartz 10/e p289; Sabiston 20/e p993; Bailey 27/e p856-857;\nHarrison 20/e p2747, 19/e p2335)"},{"n":3,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"The most common organ involved in MEN-1 is: (COMEDK 2010)","options":[{"letter":"A","text":"Parathyroid"},{"letter":"B","text":"Thyroid"},{"letter":"C","text":"Adrenal"},{"letter":"D","text":"Testis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Parathyroid","explanation":"a. Parathyroid (Ref: Schwartz 10/e p289; Sabiston 20/e p993; Bailey 27/e p856-857; Harrison 20/e p2747, 19/e p2335)"},{"n":4,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"True about MEN-2A (Sipple syndrome): (PGI Dec 2006)","options":[{"letter":"A","text":"Pheochromocytoma"},{"letter":"B","text":"Hyperparathyroidism"},{"letter":"C","text":"Mucocutaneous neuromas"},{"letter":"D","text":"Medullary carcinoma of thyroid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pheochromocytoma, B. Hyperparathyroidism, D. Medullary carcinoma of thyroid","explanation":"a. Pheochromocytoma, b. Hyperparathyroidism, d. Medullary carcinoma of thyroid"},{"n":5,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"Intestinal obstruction with jejunal neuromas are found in: (MHSSMCET 2006)","options":[{"letter":"A","text":"MEN-1"},{"letter":"B","text":"MEN-2A"},{"letter":"C","text":"MEN-2B"},{"letter":"D","text":"Familial intestinal polyposis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"MEN-2B","explanation":"c. MEN-2B"},{"n":6,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"An infant is diagnosed with MEN-2B trait. Which the following will be best line of management? (Recent Question 2016, MHSSMCET 2007)","options":[{"letter":"A","text":"Prophylactic surgery"},{"letter":"B","text":"Clinical observation and follow up"},{"letter":"C","text":"Regular FNAC"},{"letter":"D","text":". All of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Prophylactic surgery","explanation":"Prophylactic Thyroidectomy in RET Mutation Carriers MEN-2A\nBefore 5 yearsQ | MEN-2B | Before 1 yearQ\nAnswer (book): Answer: A. Prophylactic surgery\nReference: Schwartz 10/e p1550; Sabiston 20/e p1008"},{"n":7,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"Common feature to MEN1 and MEN2? (MHSSMCET 2010, 2006)","options":[{"letter":"A","text":"Hyperparathyroidism"},{"letter":"B","text":"Medullary carcinoma of thyroid"},{"letter":"C","text":"Pheochromocytoma"},{"letter":"D","text":"Carcinoids"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hyperparathyroidism","explanation":"a. Hyperparathyroidism"},{"n":8,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"Most common NET of pancreas seen in MEN-1: (Recent Question 2017)","options":[{"letter":"A","text":"Gastrinoma"},{"letter":"B","text":"Glucagonoma"},{"letter":"C","text":"Insulinoma"},{"letter":"D","text":"Somatostatinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gastrinoma","explanation":"a. Gastrinoma (Ref: Sabiston 20/e p1000; Schwartz 10/e p1071; Bailey 27/e p857)"},{"n":9,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"All of the following are true about MEN-I except: (Recent Question 2017)","options":[{"letter":"A","text":"Pituitary tumors"},{"letter":"B","text":"Parathyroid hyperplasia"},{"letter":"C","text":"Medullary carcinoma"},{"letter":"D","text":"Pancreatic endocrine tumors"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Medullary carcinoma","explanation":"c. Medullary carcinoma (Ref: Sabiston 20/e p998; Schwartz 10/e p289; Bailey 27/e p857)"},{"n":10,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 199","pdfPage":195,"stem":"In MEN-2B prophylactic surgery in a child is indicated at: (Recent Question 2017)","options":[{"letter":"A","text":"1 year"},{"letter":"B","text":"3 years"},{"letter":"C","text":"5 years"},{"letter":"D","text":"10 years"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"1 year","explanation":"a. 1 year (Ref: Sabiston 20/e p1008; Schwartz 10/e p1550; Bailey 27/e p858)\nExplanations"},{"n":11,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Primary hyperparathyroidism is caused by: (PGI June 2002)","options":[{"letter":"A","text":"Parathyroid hyperplasia"},{"letter":"B","text":"Adenosis"},{"letter":"C","text":"MEN-1"},{"letter":"D","text":"Thyrotoxicosis"},{"letter":"E","text":"CRF"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Parathyroid hyperplasia, B. Adenosis, C. MEN-1","explanation":"a. Parathyroid hyperplasia, b. Adenosis, c. MEN-1 (Ref: Schwartz 10/e p1559-1563; Sabiston 20/e p927; Bailey 27/e p825; Harrison 20/e\np2925, 19/e p2470-2475)"},{"n":12,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Treatment for parathyroid hyperplasia is: (UPSC 2001)","options":[{"letter":"A","text":"Removal of all four glands"},{"letter":"B","text":"Calcitonin"},{"letter":"C","text":"Removal of 3½ glands"},{"letter":"D","text":"Enlarged glands to be removed"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Removal of 3½ glands","explanation":"Treatment of Primary Hyperparathyroidism\n• Initial correction of hypercalcemia (Rapid IV Normal saline with furosemide)Q\n• Neck exploration is done and treatment is done accordingly A single parathyroid adenoma (85%)Q\n• ResectionQ\nTwo adenomas (5%)\n• ResectionQ\nHyperplasia of all four glands (10-15%)\n• Resection of 3½ glandsQ\n• Resection of all four glands with autotransplantation of a parathyroid gland in the forearm (brachioradialis) or\nSCM muscleQ\nParathyroid Autotransplantation\n• Whenever multiple parathyroids are resected, it is preferable to cryopreserve tissue, so that it may be\nautotransplanted should the patient become hypoparathyroidQ.\n• Approx. 12–14 pieces of 1 mm are transplanted into the nondominant forearm in belly of brachioradialisQ muscle\nAnswer (book): Answer: C. Removal of 3½ glands\nReference: Harrison 20/e p2928, 19/e p2473-2475; Schwartz 10/e p156; Sabiston 20/e p931"},{"n":13,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Parathyroid adenoma most commonly involves which of the following site: (AIIMS June 2002)","options":[{"letter":"A","text":"Thyroid substance"},{"letter":"B","text":"Superior parathyroid lobe"},{"letter":"C","text":"Inferior parathyroid lobe"},{"letter":"D","text":"In the mediastinum"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Inferior parathyroid lobe","explanation":"• Parathyroid adenomas are most commonly located in inferiorQ parathyroid glands.\nAnswer (book): Answer: C. Inferior parathyroid lobe\nReference: Harrison 20/e p2925, 19/e p2470"},{"n":14,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Features to differentiate parathyroid adenoma from hyperplasia would include which of the following? (AIIMS June 2002)","options":[{"letter":"A","text":"Presence of excess chief cells"},{"letter":"B","text":"High levels of parathormone"},{"letter":"C","text":"Infiltration of capsule"},{"letter":"D","text":"Identifying hyperplasia of all 4 glands at surgery in parathyroid hyperplasia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Identifying hyperplasia of all 4 glands at surgery in parathyroid hyperplasia","explanation":"• Parathyroid adenoma can be differentiated from hyperplasia only at the time of surgeryQ.\n• In case of adenoma, only one gland is found to be enlargedQ, the other three are normal.\n• In hyperplasia, all four glands are enlargedQ.\nAnswer (book): Answer: D. Identifying hyperplasia of all 4 glands at surgery in parathyroid hyperplasia\nReference: Harrison 20/e p2928, 19/e p2470"},{"n":15,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"True about parathyroid carcinoma:","options":[{"letter":"A","text":"Parathyroid gland is palpable"},{"letter":"B","text":"High calcium lebel"},{"letter":"C","text":"Cinacalcet is used"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above (Ref: Schwartz 10/e p1560; Sabiston 20/e p937; Bailey 27/e p835)"},{"n":16,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"In case of parathyroid adenoma, treatment is: (AIIMS Nov 95)","options":[{"letter":"A","text":"Calcitonin and steroid"},{"letter":"B","text":"Removal of adenoma"},{"letter":"C","text":"Total parathyroidectomy and implantation in arm"},{"letter":"D","text":"Total parathyroidectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Removal of adenoma","explanation":"b. Removal of adenoma"},{"n":17,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Kamli Rani, 75-year-old woman present with post myocardial infarction after 6 weeks mild CHF. There was past H/O neck surgery for parathyroid adenoma 5 years ago, ECG shows slow atrial fibrillation. Serum Ca 2+ 13.0 mg/L and urinary Ca 2+ is 300 mg/24 hr. On examination there is small mass in the Para tracheal position behind the right clavicle. Appropriate management at this time is: (All India 2002)","options":[{"letter":"A","text":"Repeat neck surgery"},{"letter":"B","text":"Treatment with technetium-99"},{"letter":"C","text":"Observation and repeat serum Ca 2+ in two months"},{"letter":"D","text":"Ultrasound-guided alcohol injection of the mass"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ultrasound-guided alcohol injection of the mass","explanation":"• Patient is a case of recurrent hyperparathyroidism, as she was operated previously for parathyroid adenoma.\n• In the setting of recent myocardial infarction, CHF and atrial fibrillation, any operation carries a high risk.\n• Ultrasound-guided alcohol injection in the mass is preferred in this setting.\nAnswer (book): Answer: D. Ultrasound-guided alcohol injection of the mass\nReference: Harrison 20/e p2929, 19/e p2470"},{"n":18,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Commonest cause for hyperparathyroidism is: (MHCET 2016, All India 89)","options":[{"letter":"A","text":"Single adenoma"},{"letter":"B","text":"Multiple adenomas"},{"letter":"C","text":"Single gland hyperplasia"},{"letter":"D","text":"Multiple gland hyperplasia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Single adenoma","explanation":"a. Single adenoma"},{"n":19,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Most common cause of hypercalcemic crisis is:","options":[{"letter":"A","text":"Parathyroid adenoma"},{"letter":"B","text":"Parathyroid hyperplasia"},{"letter":"C","text":"Carcinoma breast"},{"letter":"D","text":"Paget’s disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Carcinoma breast","explanation":"• Parathyroid adenoma is the MC cause of hypercalcemiaQ.\n• Malignant tumors are the MC cause of hypercalcemic crisis, of which CA breastQ is the common cause.\nAnswer (book): Answer: C. Carcinoma breast\nReference: Harrison 20/e p2925, 19/e p2470"},{"n":20,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 195 · answer on PDF p. 200","pdfPage":195,"stem":"Hypoparathyroidism occurs as a result of: (Recent Question 2015)","options":[{"letter":"A","text":"Idiopathic atrophy of parathyroids"},{"letter":"B","text":"Following surgery"},{"letter":"C","text":"Thyroiditis with secondary atrophy of parathyroids"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Following surgery","explanation":"Parathyroid Insufficiency or Hypoparathyroidism\n• Mostly due to removal of the parathyroid glands or infarction due to vascular injuryQ.\n• Vascular injuryQ is more important.\n• Cases usually present 2–5 days after operationQ with symptoms of hypocalcemia (circumoral and fingertip\nnumbness and tingling tetany, carpopedal spasm and laryngeal stridor) Q\n• Treatment with oral calcium and vitamin D supplementsQ\n• IV calcium gluconateQ may be required in severe cases.\nAnswer (book): Answer: B. Following surgery\nReference: Schwartz 10/e p1574; Sabiston 20/e p936; Bailey 27/e p825"},{"n":21,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 200","pdfPage":196,"stem":"Hypoparathyroidism can occur in: (PGI May 2018)","options":[{"letter":"A","text":"After thyroid surgery"},{"letter":"B","text":"DiGeorge syndrome"},{"letter":"C","text":"Radical resection of head & neck cancer"},{"letter":"D","text":"MEN1"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"After thyroid surgery, B. DiGeorge syndrome, C. Radical resection of head & neck cancer","explanation":"a. After thyroid surgery, b. DiGeorge syndrome, c. Radical resection of head & neck cancer (Ref: Harrison 20/e p2935; Schwartz 10/e\np1574; Sabiston 20/e p925)"},{"n":22,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Hypocalcemia in immediate post-op period following excision of parathyroid adenoma is due to: (Recent Question 2015)","options":[{"letter":"A","text":"Stress"},{"letter":"B","text":"Increased uptake by bones"},{"letter":"C","text":"Hypercalciuria"},{"letter":"D","text":"Increased calcitonin"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Increased uptake by bones","explanation":"• Hypocalcemia in immediate postoperative period following excision of parathyroid adenoma is due to increased\nuptake by bonesQ.\n• It is known as Hungry Bone Syndrome\nAnswer (book): Answer: B. Increased uptake by bones\nReference: Schwartz 10/e p73"},{"n":23,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"In parathyroid crisis with sudden elevations of calcium over 16 mg/dL; the treatment consist of:","options":[{"letter":"A","text":"Intravenous vitamin D"},{"letter":"B","text":"Parathyroidectomy for removal of adenoma"},{"letter":"C","text":"Thyrocalcitonin"},{"letter":"D","text":"Intravenous bicarbonate"},{"letter":"E","text":"All of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Parathyroidectomy for removal of adenoma, C. Thyrocalcitonin","explanation":"Hypercalcemic Crisis\n• Patients with PHPT may occasionally present acutely with nausea, vomiting, fatigue, muscle weakness,\nconfusionQ, and a decreased level of consciousness; a complex referred to as hypercalcemic crisis.\nHungry Bone Syndrome\n• These symptoms result from severe hypercalcemia from uncontrolled PTH secretion, worsened by polyuria,\ndehydration, and reduced kidney functionQ and may occur with other conditions causing hypercalcemia.\n• Calcium levels are markedly elevated and may be as high as 16 to 20 mg/dLQ.\n• Parathyroid glands tend to be large or multiple, and the tumor may be palpable.\n• Patients with parathyroid cancer or familial HPT are more likelyQ to present with hypercalcemic crisis. Treatment\n• Treatment consists of therapies to lower serum calcium levels followed by surgery to correct HPT.\n• Mainstay of therapy: Rehydration with a 0.9% saline and diuresis with furosemideQ\n• Other drugs used to lower serum calcium levels: − Bisphosphonates, CalcitoninQ − Mithramycin (plicamycin),\nGallium nitrateQ − Glucocorticoids (Hydrocortisone)Q\nAnswer (book): Answer: B. Parathyroidectomy for removal of adenoma, C. Thyrocalcitonin\nReference: Harrison 20/e p2935, 19/e p2478"},{"n":24,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Hyperparathyroidism is characterized by the following except: (Recent Question 2016)","options":[{"letter":"A","text":"Generalized osteoporosis"},{"letter":"B","text":"Renal calculi"},{"letter":"C","text":"Hypercalcemia"},{"letter":"D","text":"Osteosclerosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Osteosclerosis","explanation":"d. Osteosclerosis"},{"n":25,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"A patient has hypocalcaemia which was the result of a surgical complication. Which operation could it possibly have been? (Recent Question 2015)","options":[{"letter":"A","text":"Nephrectomy"},{"letter":"B","text":"Thyroidectomy"},{"letter":"C","text":"Gastrectomy"},{"letter":"D","text":"Vocal cord tumour biopsy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Thyroidectomy","explanation":"b. Thyroidectomy"},{"n":26,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"The symptoms of hyperparathyroidism include:","options":[{"letter":"A","text":"Constipation and muscle weakness"},{"letter":"B","text":"Anorexia and weight loss"},{"letter":"C","text":"Polydipsia and polyuria"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Chronic renal failure, Hypoparathyroidism, Pseudo hypoparathyroidism are causes of hypocalcemia.\nAnswer (book): Answer: D. All of the above"},{"n":27,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"A known patient with renal stone disease developed pathological fractures along with abdominal pain and certain psychiatric symptoms. He should be investigated for: (Recent Question 2016)","options":[{"letter":"A","text":"Polycystic kidney"},{"letter":"B","text":"Renal tubular acidosis"},{"letter":"C","text":"Hyperparathyroidism"},{"letter":"D","text":"Paget’s disease of bone"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hyperparathyroidism","explanation":"c. Hyperparathyroidism"},{"n":28,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Hypocalcemia is a feature of all of the following except: (UPSC 2000)","options":[{"letter":"A","text":"Chronic renal failure"},{"letter":"B","text":"Hypoparathyroidism"},{"letter":"C","text":"Pseudo hypoparathyroidism"},{"letter":"D","text":"Total thyroidectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Total thyroidectomy","explanation":"d. Total thyroidectomy (Ref: Harrison 20/e p2937, 19/e p314)\n  Chronic renal failure, Hypoparathyroidism, Pseudo hypoparathyroidism are causes of hypocalcemia."},{"n":29,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Which of the following is true about secondary hyperparathyroidism? (Recent Question 2015)","options":[{"letter":"A","text":"Commonly occurs in CRF"},{"letter":"B","text":"Related to hyperphophatemia"},{"letter":"C","text":"Patients are generally hypocalcemic"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above (Ref: Schwartz 10/e p1572-1573; Sabiston 20/e p927-928; Bailey 27/e p833; Harrison 20/e p2933, 19/e p2478-2479)"},{"n":30,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Which of the following is true about parathyroid?","options":[{"letter":"A","text":"Post parathyroid glands are within junction of inferior thyroid artery and RLN"},{"letter":"B","text":"Most common location of ectopic parthyroid glands is paraesophageal"},{"letter":"C","text":"Lower parathyroid is anterior to RLN"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Identification of Parathyroids\n• Approximately 85% of the parathyroid glands are found within 1 cm of the junction of the inferior thyroid artery\nand RLNsQ.\nLower parathyroid glands\nSuperior to junction of inferior thyroid artery and RLNsQ Dorsal (posterior) to RLNQ Inferior to junction of inferior\nthyroid artery and RLNsQ Ventral (anterior) to RLNQ\n• The thin fascia overlying a “suspicious” fat lobule should be incised using a sharp curved hemostat and scalpel.\nThis maneuver often causes the parathyroid gland to “pop” out.\n• Alternatively, gentle, blunt peanut sponge dissection between the carotid sheath and the thyroid gland often\nreveals a “float” sign, suggesting the site of the abnormal parathyroid gland.\n• Normal parathyroids are light beige and only slightly darker or brown compared to adjacent fat.\n• MC location of ectopic parathyroid gland: ParaesophagealQ >Mediastinal >Intrathymic\nAnswer (book): Answer: D. All of the above\nReference: Schwartz 10/e p1568; Sabiston 20/e p929-930; Bailey 27/e p829"},{"n":31,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Parathyroid gland was implanted into forearm muscle. What is the type of transplantation? (Recent Question 2016)","options":[{"letter":"A","text":"Orthotopic"},{"letter":"B","text":"Heterotopic"},{"letter":"C","text":"Auxiliary"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Heterotopic","explanation":"b. Heterotopic"},{"n":32,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Parathyroid autotransplantation is done in which of the following muscle? (Recent Question 2019)","options":[{"letter":"A","text":"Brachioradialis"},{"letter":"B","text":"Biceps"},{"letter":"C","text":"Triceps"},{"letter":"D","text":"Sartorius"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Brachioradialis","explanation":"“Total parathyroidectomy requires complete resection of all glands combined with immediate\nheterotopic transplantation of several 1- to 3-mm slices of fresh parathyroid tissue into individual pockets created in\nthe brachioradialis muscle of the nondominant forearm.”Sabiston 20/e p936\nAnswer (book): Answer: A. Brachioradialis\nReference: Schwartz 10/e p1569; Sabiston 20/e p936; Bailey 27/e p830"},{"n":33,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"A young female with history of renal calculi complains of bone pain and abdominal cramps. On investigation, multiple fractures were discovered and serum calcium and PTH was raised. Which of the following will be the best investigation to arrive at a definitive diagnosis? (AIIMS May 2017)","options":[{"letter":"A","text":"CECT neck"},{"letter":"B","text":"Sestamibi scan"},{"letter":"C","text":"Radioiodine scan"},{"letter":"D","text":"Ultrasound neck"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Sestamibi scan","explanation":"b. Sestamibi scan (Ref: Sabiston 20/e p930; Schwartz 10/e p1565; Bailey 27/e p827)"},{"n":34,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"Which of the following is least sensitive for parathyroid imaging? (Recent Question 2017)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"Sestamibi"},{"letter":"C","text":"Sestamibi-SPECT"},{"letter":"D","text":"MRI"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"MRI","explanation":"d. MRI (Ref: Sabiston 20/e p930; Schwartz 10/e p1565; Bailey 27/e p828)"},{"n":35,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 201","pdfPage":196,"stem":"During bilateral adrenalectomy, intra-operative dose of hydrocortisone should be given after: (AIIMS Nov 2004)","options":[{"letter":"A","text":"Opening the abdomen"},{"letter":"B","text":"Ligation of left adrenal vein"},{"letter":"C","text":"Ligation of right adrenal vein"},{"letter":"D","text":"Excision of both adrenal glands"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Excision of both adrenal glands","explanation":"• Patients undergoing surgical treatment of endogenous hypercortisolism require glucocorticoid replacement.\n• Steroids are not given pre-operatively because these patients are already hypercortisolemic.\n• Instead hydrocortisone 100 mg IV is given after the removal of second hyperplastic adrenal gland.\nUpper parathyroid glands\nAnswer (book): Answer: D. Excision of both adrenal glands\nReference: Schwartz 10/e p1590-1590"},{"n":36,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 202","pdfPage":196,"stem":"Parathyroid autotransplantation is done in which of the following muscle? (Recent Question 2019)","options":[{"letter":"A","text":"Hyperparathyroidism"},{"letter":"B","text":"Cushing’s syndrome"},{"letter":"C","text":"Zollinger-Ellison syndrome"},{"letter":"D","text":"Adrenogenital syndrome"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hyperparathyroidism","explanation":"a. Hyperparathyroidism (Ref: Harrison 20/e p2923; Sabiston 20/e p925)"},{"n":37,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 202","pdfPage":196,"stem":"A 35-year-old woman has had recurrent episodes of headache and sweating. Her mother had renal calculi and died of thyroid cancer. Physical observations revealed a thyroid nodule and ipsilateral enlarged cervical lymph nodes. Before performing thyroid surgery the woman’s physician should order: (All India 2002)","options":[{"letter":"A","text":"Thyroid scan"},{"letter":"B","text":"Estimation of hydroxyl indole acetic acid in urine"},{"letter":"C","text":"Estimation of urinary metanephrines, VMA and catecholamines"},{"letter":"D","text":"Estimation of TSH, and TRH levels in serum"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Estimation of urinary metanephrines, VMA and catecholamines","explanation":"The combination of symptoms suggests MEN-2A (Sipple syndrome), so the patient should be\ninvestigated for pheochromocytoma by estimation of urinary metanephrines, VMA and catecholamines. MEN-2A\n(Sipple Syndrome)\n• Medullary carcinoma thyroidQ\n• Hirschprung’s diseaseQ\n• PheochromocytomaQ\n• Cutaneous lichen amyloidosisQ\n• Parathyroid hyperplasia or adenomaQ\nAnswer (book): Answer: C. Estimation of urinary metanephrines, VMA and catecholamines"},{"n":38,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 202","pdfPage":196,"stem":"Young female presents with hypertension with VMA >14 mg/day, associated with: (PGI Dec 2002)","options":[{"letter":"A","text":"Medullary carcinoma thyroid"},{"letter":"B","text":"Von-Hippel Lindau disease"},{"letter":"C","text":"Sturge-Weber syndrome"},{"letter":"D","text":"Grave’s disease"},{"letter":"E","text":"Neurofibromatosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Medullary carcinoma thyroid, B. Von-Hippel Lindau disease, C. Sturge-Weber syndrome, E.","explanation":"Neurofibromatosis\nReference: Schwartz 9/e p1399-1400; Sabiston 20/e p985; Bailey 26/e p784-785\nSyndromes Associated with Pheochromocytoma (MVVS)\n• MEN-2A and MEN-2BQ\n• VHL syndromeQ\n• Von-Recklinghausen syndromeQ\n• Sturge-Weber syndromeQ\nAnswer (book): Answer: A. Medullary carcinoma thyroid, B. Von-Hippel Lindau disease, C. Sturge-Weber syndrome, E."},{"n":39,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 202","pdfPage":196,"stem":"Palpation on the costovertebral angle produces pain and tenderness in acute adrenal insufficiency. This is:","options":[{"letter":"A","text":"Rotch’s sign"},{"letter":"B","text":"Rossolimo’s sign"},{"letter":"C","text":"Rogoff’s sign"},{"letter":"D","text":"Osler’s sign"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Rogoff’s sign","explanation":"Rogoff’s Sign\n• Costovertebral angle pain and tenderness in acute adrenal insufficiency is known as Rogoff’s signQ.\nAnswer (book): Answer: C. Rogoff’s sign\nReference: www.medhelp.org"},{"n":40,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 196 · answer on PDF p. 202","pdfPage":196,"stem":"Commonest cause of Cushing syndrome is: (Kerala 95)","options":[{"letter":"A","text":"Adrenal adenoma"},{"letter":"B","text":"Carcinoma"},{"letter":"C","text":"Hyperplasia"},{"letter":"D","text":"Atrophy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hyperplasia","explanation":"• MC cause of Cushing’s syndrome is iatrogenic exogenous administration of steroidsQ.\n• MC endogenous cause of Cushing’s syndrome is bilateral adrenal hyperplasiaQ secondary to hypersecretion of\nACTH from pituitary or from an ectopic non-pituitary source. Causes of Cushing’s Syndrome Endogenous\nADRENAL HYPERPLASIA\n• Pituitary ACTH overproduction:\n– MicroadenomaQ >Macroadenoma\n• Ectopic ACTH overproduction:\n• Small cell carcinoma lungQ − Thymus carcinoid\n– Carcinoma pancreas\n– Bronchial adenoma ADRENAL NEOPLASIA\n• AdenomaQ\nExogenous\n• Iatrogenic exogenous administration of steroids (MC cause) Q\nCarcinomaQ\nAnswer (book): Answer: C. Hyperplasia\nReference: Harrison 20/e p2724, 19/e p2314"},{"n":41,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"Most common cause of Addison’s disease in India: (AIIMS Nov 2011)","options":[{"letter":"A","text":"Tuberculosis"},{"letter":"B","text":"Post-partum"},{"letter":"C","text":"Autoimmune"},{"letter":"D","text":"HIV"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tuberculosis","explanation":"• Most common cause of adrenal insufficiency (Addison’s disease) in developing countries is TuberculosisQ followed\nby autoimmune disorders.\nAnswer (book): Answer: A. Tuberculosis\nReference: ASI 7/e p1073"},{"n":42,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"Indication for surgery in a case of adrenal incidentaloma: (MAHE 2008, 2007)","options":[{"letter":"A","text":"Size >5 cm"},{"letter":"B","text":"Bilateral adrenal metastasis"},{"letter":"C","text":"Functional tumor"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above (Ref: Schwartz 10/e p1589; Sabiston 20/e p985-987; Bailey 27/e p839; Harrison 20/e p2731, 19/e p2321)"},{"n":43,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"Incidental finding in CT scan, a 3 cm adrenal mass, which of the following is not done? (UPPG 2008)","options":[{"letter":"A","text":"Adrenalectomy"},{"letter":"B","text":"Dexamethasone suppression test"},{"letter":"C","text":"Measurement of catecholamines"},{"letter":"D","text":"Midnight plasma cortisol"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adrenalectomy","explanation":"a. Adrenalectomy"},{"n":44,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"Accidental finding of incidentaloma (Adrenal mass) on USG is detected. Following is/are to be ruled out: (PGI Dec 2006)  [Multiple statements may be correct — mark all true options]","options":[{"letter":"A","text":"Cushing’s disease"},{"letter":"B","text":"Metastasis"},{"letter":"C","text":"Adrenal adenoma"},{"letter":"D","text":"Carcinoma"},{"letter":"E","text":"Adrenal hyperplasia"}],"multi":["A","B","C","D","E"],"correctSet":["A","B","C","D","E"],"answerIdx":0,"answerLetter":"A, B, C, D, E","answerText":"Correct statements: A, B, C, D, E","explanation":"All (Ref: CSDT 11/e p811-812; Bailey 27/e p839; Schwartz 10/e p1589; Sabiston 20/e p986; Harrison 20/e p2731, 19/e p2321)"},{"n":45,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"True about adrenocortical carcinoma: (Recent Question 2016)","options":[{"letter":"A","text":"Rare tumor"},{"letter":"B","text":"More than half are functional"},{"letter":"C","text":"Most commonly associated with Cushing syndrome"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above (Ref: Schwartz 10/e p1588; Sabiston 20/e p979-980; Bailey 27/e p843; Harrison 20/e p2732, 19/e p2322)"},{"n":46,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"A 50-year-old male presents with severe refractory hypertension, weakness, muscle cramps and hypokalemia, the most likely diagnosis is: (COMEDK 2011)","options":[{"letter":"A","text":"Hypoaldosteronism"},{"letter":"B","text":"Hyperaldosteronism"},{"letter":"C","text":"Cushing syndrome"},{"letter":"D","text":"Pheochromocytoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hyperaldosteronism","explanation":"Manifestation of Conn’s Syndrome (Primary Hyperaldosteronism) Clinical Laboratory\n• Muscle weakness and fatigue (due to\n• Hypokalemia hypokalemia)\n• Metabolic alkalosis\n• Hypertension without edema\n• Hypernatremia\n• Polyuria and polydipsia\n• Increased Aldosterone\n• Low rennin\nAnswer (book): Answer: B. Hyperaldosteronism\nReference: Harrison 20/e p2729, 19/e p1618-1619"},{"n":47,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 202","pdfPage":197,"stem":"Which one of the following is not a CT feature of adrenal adenoma? (AIIMS Nov 2010)","options":[{"letter":"A","text":"Low attenuation"},{"letter":"B","text":"Homogeneous density and well defined borders"},{"letter":"C","text":"Enhances rapidly, contrast stays in it for relatively longer time and washes out late"},{"letter":"D","text":"Calcification is rare"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Enhances rapidly, contrast stays in it for a relatively longer time and washes out late","explanation":"• Adrenal adenoma on contrast enhanced CT/MRI show rapid uptake and relatively rapid washout of contrastQ\nmaterial than do non adenomas.\nCT Features of Adrenal Adenoma Well defined /sharply definedQ <5 cm in sizeQ Low attenuation (<10 HU) due to\nlipid contentQ Mild homogenous enhancement\n• Relatively rapid washout of contrast material (due to lack of large interstitial spaces) Q\n• Relatively rapid washout is characteristic of adenomaQ\nAnswer (book): Answer: C. Enhances rapidly, contrast stays in it for a relatively longer time and washes out late\nReference: Grainger Radiology 4/e p1388; Dahnert Wolfgang Radiology Review Manual 6/e p919"},{"n":48,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"After bilateral adrenalectomy, patient developed gradual loss of vision, with hyperpigmentation of skin, and headache. Likely cause is: (MHSSMCET 2006)","options":[{"letter":"A","text":"Addison’s disease"},{"letter":"B","text":"Nelson’s syndrome"},{"letter":"C","text":"Cushing’s disease"},{"letter":"D","text":"Hypopituitarism"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Nelson’s syndrome","explanation":"Nelson’s Syndrome\n• Adrenalectomy in the setting of residual corticotroph adenoma tissue predisposes to the development of Nelson’s\nsyndromeQ.\n• Characterized by rapid pituitary tumor enlargement and increased pigmentation secondary to high ACTH levelsQ.\n• Radiation therapy may be indicated to prevent the development of Nelson’s syndrome after adrenalectomyQ.\nPrimary adrenal Cushing’s syndrome → Adrenalectomy → Loss of negative feedback to pituitary → Development\nof pituitary adenoma → Nelson’s syndrome.\nAnswer (book): Answer: B. Nelson’s syndrome\nReference: Harrison 20/e p2682, 19/e p2273"},{"n":49,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"Nonfunctional adrenal tumors are operated at what size: (MHSSMCET 2009)","options":[{"letter":"A","text":">3 cm"},{"letter":"B","text":">5 cm"},{"letter":"C","text":">6 cm"},{"letter":"D","text":">10 cm"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":">5 cm","explanation":"b. >5 cm"},{"n":50,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"In renal agenesis, the adrenal gland is: (MHSSMCET 2006)","options":[{"letter":"A","text":"Absent"},{"letter":"B","text":"Present on contralateral side"},{"letter":"C","text":"Ectopic in the iliac fossa"},{"letter":"D","text":"Present at the usual location"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Present at the usual location","explanation":"• Embryological development of kidneys and adrenal is different, hence even in renal agenesis, adrenal glands will\nbe in normal positionQ.\nAnswer (book): Answer: D. Present at the usual location\nReference: Grainger Radiology 4/e p1722"},{"n":51,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"Most prevalent incidentacoma is: (MHCET 2016)","options":[{"letter":"A","text":"Cushing’s adenoma"},{"letter":"B","text":"Pheochromocytoma"},{"letter":"C","text":"Adrenocortical carcinoma"},{"letter":"D","text":"Non-functioning adenoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Non‑functioning adenoma","explanation":"d. Non-functioning adenoma\nPHEOCHROMOCYTOMA"},{"n":52,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"Which one of the following clinical features is not seen in pheochromocytoma? (COMEDK 2011)","options":[{"letter":"A","text":"Hypertension"},{"letter":"B","text":"Episodic palpitations"},{"letter":"C","text":"Weight loss"},{"letter":"D","text":"Diarrhea"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Diarrhea","explanation":"d. Diarrhea (Ref: Schwartz 10/e p1586; Sabiston 20/e p980-985; Bailey 27/e p845; Harrison 20/e p2740, 19/e p2329-2331)"},{"n":53,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"Episodic hypertension is a feature of: (JIPMER 2010)","options":[{"letter":"A","text":"Carcinoid tumor"},{"letter":"B","text":"Insulinoma"},{"letter":"C","text":"Pheochromocytoma"},{"letter":"D","text":"Zollinger-Ellison syndrome"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pheochromocytoma","explanation":"c. Pheochromocytoma"},{"n":54,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"The investigation of choice for extra adrenal pheochromocytoma: (PGI Dec 2007)","options":[{"letter":"A","text":"MIBG scan"},{"letter":"B","text":"MRI"},{"letter":"C","text":"CT"},{"letter":"D","text":"X-ray"},{"letter":"E","text":"USG"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"MRI","explanation":"b. MRI"},{"n":55,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 203","pdfPage":197,"stem":"All are true about pheochromocytoma except: (All India 2011)","options":[{"letter":"A","text":"90% are malignant"},{"letter":"B","text":"95% occur in the abdomen"},{"letter":"C","text":"They secrete catecholamines"},{"letter":"D","text":"They arise from sympathetic ganglions"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"90% are malignant","explanation":"Management of Pheochromocytoma\nAnswer (book): Answer: A. 90% are malignant"},{"n":56,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"Investigation useful for detecting extra-adrenal pheochromocytoma: (PGI May 2011)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"CT"},{"letter":"C","text":"T2-weighted MRI with gadolinium contrast"},{"letter":"D","text":"MIBG"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T2-weighted MRI with gadolinium contrast","explanation":"c. T2-weighted MRI with gadolinium contrast"},{"n":57,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"True about pheochromocytoma is: (MHPGMCET 2002)","options":[{"letter":"A","text":"Arises from chromaffin cells of adrenal medulla"},{"letter":"B","text":"Bilateral in 20% of all cases"},{"letter":"C","text":"Hypotension rules out pheochromocytoma"},{"letter":"D","text":"Almost always a malignant tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Arises from chromaffin cells of adrenal medulla","explanation":"a. Arises from chromaffin cells of adrenal medulla"},{"n":58,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"Pheochromocytoma with malignant potential exclusively secretes: (MHPGMCET 2008)","options":[{"letter":"A","text":"Dopamine"},{"letter":"B","text":"Epinephrine"},{"letter":"C","text":"Metanephrine"},{"letter":"D","text":"Norepinephrine"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Dopamine","explanation":"a. Dopamine (Ref: Schwartz 10/e p1587; Sabiston 20/e p985; Bailey 27/e p846; Harrison 20/e p2744, 19/e p2331)"},{"n":59,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"False regarding pheochromocytoma: (MHSSMCET 2006)","options":[{"letter":"A","text":"10% of nonfamilial adrenal pheochromocytomas are bilateral"},{"letter":"B","text":"Only 10% of hypertensive patients have an underlying pheochromocytoma"},{"letter":"C","text":"10% of adrenal pheochromocytomas arise in childhood"},{"letter":"D","text":"FNAC is must for diagnosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"FNAC is must for diagnosis","explanation":"d. FNAC is must for diagnosis"},{"n":60,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"Commonest symptom of pheochromocytoma is: (Recent Question 2015)","options":[{"letter":"A","text":"Palpitation"},{"letter":"B","text":"Headache"},{"letter":"C","text":"Sweating"},{"letter":"D","text":"Dyspnea"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Headache","explanation":"b. Headache"},{"n":61,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"In pheochromocytoma, the urine will contain: (UPPG 96)","options":[{"letter":"A","text":"VMA"},{"letter":"B","text":"HIAA"},{"letter":"C","text":"Both"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"VMA","explanation":"a. VMA"},{"n":63,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"Radionuclide used in pheochromocytoma is: (COMEDK 2005)","options":[{"letter":"A","text":"Radioactive iodine I-131"},{"letter":"B","text":"Technitium pertechnate"},{"letter":"C","text":"Radiolabelled chromium"},{"letter":"D","text":"I 123 Metaiodobenzylguanidine (MIBG)"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"I123 Metaiodobenzylguanidine (MIBG)","explanation":"d. I123 Metaiodobenzylguanidine (MIBG)"},{"n":64,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 197 · answer on PDF p. 204","pdfPage":197,"stem":"The most common site of ectopic pheochromo-cytoma is: (COMEDK 2008)","options":[{"letter":"A","text":"Organ of Zuckerkandl"},{"letter":"B","text":"Bladder"},{"letter":"C","text":"Filum terminale"},{"letter":"D","text":"Celiac plexus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Organ of Zuckerkandl","explanation":"a. Organ of Zuckerkandl"},{"n":65,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"A patient presented with headache and flushing. He has a family history of his relative having died of a thyroid tumour. The investigation that would be required for this patient would be: (AIIMS June 99)","options":[{"letter":"A","text":"Chest X-ray"},{"letter":"B","text":"Measurement of 5 HIAA"},{"letter":"C","text":"Measurement of catecholamine"},{"letter":"D","text":"Intravenous pyelography"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Measurement of catecholamine","explanation":"c. Measurement of catecholamine"},{"n":66,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Investigation of choice in case of a patient with episodic hypertension, headache and thyroid nodule: (AIIMS Nov 97)","options":[{"letter":"A","text":"Urinary HIAA"},{"letter":"B","text":"Urinary catecholamine and aspiration of nodule"},{"letter":"C","text":"Thyroid function test only"},{"letter":"D","text":"Urinary basic amino acid metabolite"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Urinary catecholamine and aspiration of nodule","explanation":"b. Urinary catecholamine and aspiration of nodule"},{"n":67,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Best way to localize extra-adrenal pheochromocytoma: (MCI June 2018)","options":[{"letter":"A","text":"X-ray"},{"letter":"B","text":"Nucleotide scan"},{"letter":"C","text":"VMA excretion"},{"letter":"D","text":"Clinical examination"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Nucleotide scan","explanation":"b. Nucleotide scan (Ref: Schwartz 10/e p1586; Sabiston 20/e p980; Harrison 20/e p2741)\nNEUROBLASTOMA"},{"n":68,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Neuroblastomas: Good prognostic factor is: (PGI June 2000)","options":[{"letter":"A","text":"N-myc amplification"},{"letter":"B","text":"RAS oncogene"},{"letter":"C","text":"Hyperdiploidy"},{"letter":"D","text":"Translocations"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hyperdiploidy","explanation":"p477\nPrognostic Factors in Neuroblastomas Variable Favorable Stage Stage 1, 2A, 2B, 4SQ Age <18Q months\nEvidence of schwannian stroma and gangliocytic differentiation PresentQ Mitosis-karyorrhexis index <200/5000 cells\nDNA ploidy Hyperdiploid or near-triploidQ N-MYC Not amplified Chromosome 17q gain Absent Chromosome 1p loss\nAbsent Chromosome 11q loss Absent TRKA expression PresentQ TRKB expression Absent Telomerase expression Low\nor absent\nUnfavorable Stage 3, 4Q >18 months Absent >200/5000 cells Near-diploid AmplifiedQ PresentQ PresentQ PresentQ\nAbsent PresentQ Highly expressedQ\nAnswer (book): Answer: C. Hyperdiploidy\nReference: Schwartz 10/e p1639-1640; Sabiston 20/e p1887-1888; Bailey 27/e p847; Harrison 20/e p443, 19/e p618; Robbins 9/e"},{"n":69,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Opsoclonus-Myoclonus is a phenomenon seen in: (PGI 97)","options":[{"letter":"A","text":"Wilm’s tumor"},{"letter":"B","text":"Neuroblastoma"},{"letter":"C","text":"Meningioma"},{"letter":"D","text":"Cortical tuberculoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Neuroblastoma","explanation":"b. Neuroblastoma (Ref: Schwartz 10/e p1639-1640; Sabiston 20/e p1887-1888; Bailey 27/e p847; Harrison 20/e p443, 19/e p618; Robbins 9/e p475-479)"},{"n":70,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"All of the following are correct about neuroblastoma except: (Recent Question 2017)","options":[{"letter":"A","text":"Arises from adrenal cortex"},{"letter":"B","text":"Can cause paraplegia"},{"letter":"C","text":"May cause hypertension"},{"letter":"D","text":"Secretes hormones"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Arises from adrenal cortex","explanation":"a. Arises from adrenal cortex (Ref: Sabiston 20/e p1887; Schwartz 10/e p1639; Bailey 27/e p847)"},{"n":71,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Not seen in neuroblastoma is: (UPPG 96)","options":[{"letter":"A","text":"Diarrhea"},{"letter":"B","text":"Proptosis"},{"letter":"C","text":"Splenomegaly"},{"letter":"D","text":"Bone involvement"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Splenomegaly","explanation":"c. Splenomegaly"},{"n":72,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"True about neuroblastoma: (PGI Dec 2006)","options":[{"letter":"A","text":"Seen in adrenal glands"},{"letter":"B","text":"↑ VMA/HVA"},{"letter":"C","text":"Lymphatic metastasis more common than blood metastasis"},{"letter":"D","text":"Presents with abdominal mass"},{"letter":"E","text":"Old age presentation implies good prognosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Seen in adrenal glands, B. ↑ VMA/HVA, D. Presents with abdominal mass","explanation":"a. Seen in adrenal glands, b. ↑ VMA/HVA, d. Presents with abdominal mass"},{"n":73,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Which of the following statements about neuro-blastoma is not true? (All India 2009)","options":[{"letter":"A","text":"Most common extra cranial solid tumor in childhood"},{"letter":"B","text":">50% present with metastasis at time of diagnosis"},{"letter":"C","text":"Lung metastasis are common"},{"letter":"D","text":"Often encase aorta and its branches at time diagnosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lung metastasis are common","explanation":"Neuroblastoma\nLung metastasis are rare in neuroblastoma Metastasis is present in 60–70% of patients at the time of diagnosisQ\nCommon sites of metastasis: Long bones (MC), Liver, Lymph nodes and Skin Encasement of abdominal aorta and\nIVC by tumor is common Some neuroblastomas are sharply demarcated with a fibrous pseudocapsule but others\nare far more infiltrative and invade surrounding strictures including the kidney, renal vein, IVC and envelop the\naorta\nNeuroblastoma is the MC extracranial solid tumor in childhood Neuroblastoma is the 2nd MC solid malignancy of\nchildhood after brain tumors. MC solid tumor in childhood: Brain tumorsQ MC intra abdominal solid tumor in\nchildhood: NeuroblastomaQ\nFeature Common tumor At the time of diagnosis Lung Metastasis Encasement of Aorta Calcification\nNeuroblastoma MC intra-abdominal solid tumor in childrenQ Already metastatic in >50% of patientsQ RareQ\nCharacteristicQ Common (Stippled calcificationQ)\nWilm’s Tumor MC renal tumor in children Generally confined to the kidney Common Uncommon Rare\nAnswer (book): Answer: C. Lung metastasis are common\nReference: Sabiston 20/e p1887-1888; Robbins 9/e p475-479"},{"n":74,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Mrs. Neena noted an abdominal mass in left side of her 6 months old child, which showed calcification near the left kidney. What will be the cause? (AIIMS Nov 2000)","options":[{"letter":"A","text":"Leukemia"},{"letter":"B","text":"Neuroblastoma"},{"letter":"C","text":"RCC"},{"letter":"D","text":"Lymphoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Neuroblastoma","explanation":"b. Neuroblastoma"},{"n":75,"chapter":"Parathyroid and Adrenal Glands","src":"question on PDF p. 198 · answer on PDF p. 204","pdfPage":198,"stem":"Tumor arising from olfactory nasal mucosa is: (All India 2012)","options":[{"letter":"A","text":"Nasal glioma"},{"letter":"B","text":"Adenoid cystic carcinoma"},{"letter":"C","text":"Nasopharyngeal carcinoma"},{"letter":"D","text":"Esthesioneuroblastoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Esthesioneuroblastoma","explanation":"d. Esthesioneuroblastoma (Ref: Dhingra 5/e p217-218; Washington Manual of Surgical Pathology 2/e p45; Harrison 20/e p656, 19/e p199-e4)"},{"n":1,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Most common cause of liver abscess in chronic granulomatous disease: (ILBS 2012)","options":[{"letter":"A","text":"Klebsiella"},{"letter":"B","text":"Staph. aureus"},{"letter":"C","text":"Peptostreptococcus"},{"letter":"D","text":"E. coli"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Staph. aureus","explanation":"Shackelford 8/e p1434, 7/e p1464-1471\nPyogenic Liver Abscess in Children\n• In children, Staphylococcus PLAQ is most common\n• Occurs in the setting of chronic granulomatous diseaseQ, disorder of granulocyte function and hematologic\nmalignancies.\n• In chronic granulomatous conditions, abscess are dense and thick, early excision and treatment with antibiotics\nagainst Staphylococcus aureus is recommendedQ.\nAnswer (book): Answer: B. Staph. aureus\nReference: Sabiston 20/e p1445-1449; Schwartz 10/e p1284-1285; Bailey 27/e p1168; Blumgart 6/e p1074, 5/e p1006-1115;"},{"n":2,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Most common cause of liver abscess: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"E. coli"},{"letter":"B","text":"Proteus"},{"letter":"C","text":"Klebsiella"},{"letter":"D","text":"Staphylococcus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"E. coli","explanation":"a. E. coli"},{"n":3,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Which of the following is the most common cause of pyogenic liver abscess? (All India 2012, AIIMS GIS Dec 2009) (Recent Question 2014)","options":[{"letter":"A","text":"Trauma"},{"letter":"B","text":"Biliary tract infection"},{"letter":"C","text":"Colonic Diverticulitis"},{"letter":"D","text":"Appendicitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Biliary tract infection","explanation":"b. Biliary tract infection"},{"n":4,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"All are true about pyogenic liver abscess except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Most common route of infection is biliary tree"},{"letter":"B","text":"Most common site is right lobe"},{"letter":"C","text":"Klebsiella is most common in gas forming abscess"},{"letter":"D","text":"Percutaneous drainage is least cured"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Percutaneous drainage is least cured","explanation":"d. Percutaneous drainage is least cured"},{"n":5,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"All are true about amoebic liver abscess except: (PGI Nov 2010)","options":[{"letter":"A","text":"Metronidazole is mainstay of treatment"},{"letter":"B","text":"Multifocal abscess can not be treated by aspiration"},{"letter":"C","text":"More common in left side"},{"letter":"D","text":"More common in female"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"More common in left side, D. More common in female","explanation":"c. More common in left side, d. More common in female  (Ref: Sabiston 20/e p1449-1452; Schwartz 10/e p1285; Bailey 27/e p1168;\nBlumgart  6e/ p1074-1076, 5/e p1016-1024; Shackelford 8/e p1431, 7/e p1471-1478)"},{"n":6,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Liver abscess ruptures most commonly in: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Pleural cavity"},{"letter":"B","text":"Peritoneal cavity"},{"letter":"C","text":"Pericardial cavity"},{"letter":"D","text":"Bronchus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Peritoneal cavity","explanation":"b. Peritoneal cavity"},{"n":7,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"True about amebic liver abscess: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Male:female >10:1"},{"letter":"B","text":"Not predisposed by alcohol"},{"letter":"C","text":"More common in diabetics"},{"letter":"D","text":"E. histolytica is isolated in >50% from blood culture"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Male:female >10:1","explanation":"a. Male:female >10:1"},{"n":8,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Not an indication for percutaneous aspiration in amebic liver abscess: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Radiographically unresolved lesion after 6 months"},{"letter":"B","text":"Suspected diagnosis"},{"letter":"C","text":"Left lobe liver abscess"},{"letter":"D","text":"Compression or outflow obstruction of hepatic or portal vein"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Radiographically unresolved lesion after 6 months","explanation":"Amoebic Liver Abscess\n• Although clinical improvement after adequate treatment with antiamebic agents is the rule, radiologic resolution\nof the abscess cavity is usually delayed.\n• The average time to radiologic resolution is 3 to 9 months and can take as long as years in some patients.\n• Studies have shown that more than 90% of the visible lesions disappear radiologically, but a small percentage of\npatients are left with a clinically irrelevant residual lesion.\nAnswer (book): Answer: A. Radiographically unresolved lesion after 6 months\nReference: Sabiston 20/e p1452"},{"n":9,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Commonest cause of pyogenic liver abscess: (AIIMS Sept 96)","options":[{"letter":"A","text":"Aspiration"},{"letter":"B","text":"Hematogenous spread from a distant site"},{"letter":"C","text":"Direct contact"},{"letter":"D","text":"Lymphatic spread"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hematogenous spread from a distant site","explanation":"Hematogenous spread is most common among the given options.\nAnswer (book): Answer: B. Hematogenous spread from a distant site"},{"n":10,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Anchovy sauce pus is a feature of: (All India 99)","options":[{"letter":"A","text":"Amebic liver abscess"},{"letter":"B","text":"Lung abscess"},{"letter":"C","text":"Splenic abscess"},{"letter":"D","text":"Pancreatic abscess"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Amebic liver abscess","explanation":"a. Amebic liver abscess"},{"n":11,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"In pyogenic liver abscess commonest route of spread is: (AIIMS Nov 98, AIIMS Nov 95)","options":[{"letter":"A","text":"Hematogenous through portal vein"},{"letter":"B","text":"Ascending infection through biliary tract"},{"letter":"C","text":"Hepatic artery"},{"letter":"D","text":"Local spread"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Ascending infection through biliary tract","explanation":"b. Ascending infection through biliary tract"},{"n":12,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"True statement regarding pyogenic liver abscess is/are: (PGI May 2018)","options":[{"letter":"A","text":"More common on left side of liver"},{"letter":"B","text":"Surgical drainage is the treatment of choice"},{"letter":"C","text":"Most common organism responsible is E. coli"},{"letter":"D","text":"X-rays are diagnostic"},{"letter":"E","text":"Diagnosis is confirmed by aspiration and culture"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Most common organism responsible is E. coli, E. Diagnosis is confirmed by aspiration and culture","explanation":"c. Most common organism responsible is E. coli, e. Diagnosis is confirmed by aspiration and culture (Ref: Schwartz 10/e p1284-\n1285; Sabiston 20/e p1445-1449; Bailey 27/e p1168)"},{"n":13,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Indications for needle aspiration in liver abscess are: (PGI June 2006)","options":[{"letter":"A","text":"Recurrent"},{"letter":"B","text":"Left lobe"},{"letter":"C","text":"Refractory to treatment after 48–72 hours"},{"letter":"D","text":">10 cm size"},{"letter":"E","text":"Multiple"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Left lobe, D. >10 cm size","explanation":"b. Left lobe, d. >10 cm size"},{"n":14,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"True treatment regarding hepatic amoebiasis: (PGI 96)","options":[{"letter":"A","text":"More common in females"},{"letter":"B","text":"Multiple lesions"},{"letter":"C","text":"Mostly treated conservatively"},{"letter":"D","text":"Jaundice is common"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mostly treated conservatively","explanation":"c. Mostly treated conservatively"},{"n":15,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Which one of the following is not corrected regarding amoebic liver abscess? (ICS 2005)","options":[{"letter":"A","text":"Its usual occurrence is in the right lobe"},{"letter":"B","text":"Patient is toxic"},{"letter":"C","text":"Surgical drainage is always indicated"},{"letter":"D","text":"Extension of abscess from liver to pericardium is the most dreaded complication"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Surgical drainage is always indicated","explanation":"c. Surgical drainage is always indicated"},{"n":16,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"All are used in treatment of amoebic liver abscess except: (MAHE 2007)","options":[{"letter":"A","text":"Diloxanide furoate"},{"letter":"B","text":"Chloroquine"},{"letter":"C","text":"Metronidazole"},{"letter":"D","text":"Emetine"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diloxanide furoate","explanation":"Diloxanide Furoate\n• Diloxanide furoate is highly effective luminal amebicideQ but has no systemic anti-amebic activityQ, because\nfuroate ester is hydrolysed in the intestine and the released diloxanide is absorbed.\n• Diloxanide is a weaker amebicide than its furoate ester and no systemic antiamebic activity is seen despite its\nabsorption.\nAnswer (book): Answer: A. Diloxanide furoate\nReference: Goodman Gilman 12/e p1420"},{"n":17,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"Not true about amebic liver abscess is: (DPG 2006)","options":[{"letter":"A","text":"Adult forms are seen"},{"letter":"B","text":"Conservative treatment is generally seen"},{"letter":"C","text":"Larvae are seen"},{"letter":"D","text":"USG can diagnose it"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Larvae are seen","explanation":"Larvae are not seen in amoebic liver abscess.\nAnswer (book): Answer: C. Larvae are seen\nReference: Bailey 27/e p1169; Schwartz 10/e p1285"},{"n":18,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 228","pdfPage":220,"stem":"A patient with 8 cm × 8 cm abscess in right lobe of liver was treated with aspiration multiple times (3 times) and with systemic amebicide. Now cavity is remaining in right lobe of liver but there is nothing in the cavity. Seven days course of luminal amebicides is given. How will you follow-up? (AIIMS Nov 2012)","options":[{"letter":"A","text":"Stool examination only"},{"letter":"B","text":"USG weekly for 1 month followed by monthly USG till 1 year"},{"letter":"C","text":"USG weekly for 3 months followed by CT scan at 3 months"},{"letter":"D","text":"USG or CT scan monthly and stool examination weekly"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"USG weekly for 1 month followed by monthly USG till 1 year","explanation":"p1471-1478\nIn uncomplicated cases of amebic liver abscess, follow-up is done with ultrasound.\nAnswer (book): Answer: B. USG weekly for 1 month followed by monthly USG till 1 year\nReference: Sabiston 20/e p1451; Schwartz 10/e p1284; Blumgart 6/e p 1087, 5/e p1016-1024; Shackelford 8/e p1440, 7/e"},{"n":19,"chapter":"Liver","src":"question on PDF p. 220 · answer on PDF p. 229","pdfPage":220,"stem":"A young patient presents to the emergency department with fever and right upper quadrant pain. Clinical examination reveals obvious hepatomegaly but there is no jaundice. Ultrasound reveals a solitary, homogeneous, hypoechoic lesion in the right lobe measuring 5 cm × 5 cm × 4 cm. Tests for hydatid disease were negative. Which of the following is the best recommendation for initial treatment? (All India 2011)","options":[{"letter":"A","text":"Multiple aspirations and antiamoebics/antibiotics"},{"letter":"B","text":"Catheter drainage and antiamoebics/antibiotics"},{"letter":"C","text":"Antiamoebics/antibiotics alone"},{"letter":"D","text":"Hepatectomy followed by antiamoebics/antibiotics"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Antiamebics/antibiotics alone","explanation":"c. Antiamebics/antibiotics alone\n•\t Presence of a solitary homogeneous, hypoechoic lesion  in the right lobe of the liver in a young patient with fever and right\nupper quadrant pain suggests a diagnosis of amebic liver abscess.\n•\t The initial treatment of choice for amebic liver abscess is metronidazole alone.\n•\t Multiple aspirations and/ or catheter drainage or hepatectomy have no role in the “initial” management of amebic liver abscess."},{"n":20,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Flask shaped ulcers in colon is caused by: (Recent Question 2019)","options":[{"letter":"A","text":"Giardia lamblia"},{"letter":"B","text":"Entamoeba histolytica"},{"letter":"C","text":"H. pylori"},{"letter":"D","text":"Enterobius vermicularis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Entamoeba histolytica","explanation":"b. Entamoeba histolytica (Ref: Schwartz 10/e p1285; Bailey 27/e p58)"},{"n":21,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Water lily appearance in a chest radiograph suggests: (COMEDK 2005, 2004)","options":[{"letter":"A","text":"Metastasis"},{"letter":"B","text":"Cavitating metastasis"},{"letter":"C","text":"Aspergilloma"},{"letter":"D","text":"Ruptured hydatid cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ruptured hydatid cyst","explanation":"Shackelford 8/e p1425, 7/e p1459-1462\n\n• Presence of a solitary homogeneous, hypoechoic lesion in the right lobe of the liver in a young patient with fever\nand right upper quadrant pain suggests a diagnosis of amebic liver abscess.\n• The initial treatment of choice for amebic liver abscess is metronidazole alone.\n• Multiple aspirations and/ or catheter drainage or hepatectomy have no role in the “initial” management of\namebic liver abscess.\nAnswer (book): Answer: D. Ruptured hydatid cyst\nReference: Sabiston 20/e p1452-1455; Schwartz 10/e p1285-1286; Bailey 27/e p1169; Blumgart 6/e p1108, 5/e p10351048;"},{"n":22,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Which of the following is not a sign of pulmonary hydatidosis? (COMEDK 2010)","options":[{"letter":"A","text":"Water lily sign"},{"letter":"B","text":"Rising sun sign"},{"letter":"C","text":"Meniscus sign"},{"letter":"D","text":"Drooping lily sign"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Drooping lily sign","explanation":"• Drooping lily sign is seen in neuroblastoma and duplication of ureterQ.\n• Duplication of ureter: Drooping lily signQ on IVP (Nonvisualized upper pole of a duplex system displaces the lower\npole down, looking like a drooped down lily flower on IVP) Characteristic Signs of Pulmonary Hydatidosis\n• Meniscus sign\n• Double arc signQ\n• Moon signQ\n• Water lily signQ\n• Crescent signQ\nQ\n• Only completely calcified cyst (eggshell appearance) is accepted as a dead cyst.\n• CL, CE 1, and CE 2 are active fertile cysts; CE 3 is a transitional cyst with degeneration started; CE 4 is a\ndegenerated cyst; CE 5 is a calcified cyst; CE 4 and CE 5 is inactive cyst. Gharbi Classification of Hydatid Cyst\nType I\nPure (clear) fluid collectionQ\nType II\nFluid collection with a split wall (Floating membrane)Q\nType III | Fluid collection with septa (Honeycomb image)Q | Type IV | Heterogeneous complex massQ | Type V |\nCalcified mass (eggshell)Q\nAnswer (book): Answer: D. Drooping lily sign\nReference: Wolfgang 2/e p309"},{"n":23,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Ultrasound was performed in a patient of hydatid cyst. What is the name of this sign?","options":[{"letter":"A","text":"Water lily sign"},{"letter":"B","text":"Honeycomb sign"},{"letter":"C","text":"Spoke wheel sign"},{"letter":"D","text":"Triradiate sign"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Water lily sign","explanation":"a. Water lily sign (Ref: Bailey 27/e p66)"},{"n":24,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"False about hydatid cyst of liver: (PGI Nov 2010)","options":[{"letter":"A","text":"Hepatic resection is never done"},{"letter":"B","text":"Laparoscopic aspiration of cyst is performed"},{"letter":"C","text":"Most commonly located in the right liver"},{"letter":"D","text":"Mostly asymptomatic"},{"letter":"E","text":"Most common causative organism is Echinococcus granulosus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hepatic resection is never done","explanation":"a. Hepatic resection is never done"},{"n":25,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Not an indication for PAIR treatment in hydatid cyst: (PGI Nov 2010)","options":[{"letter":"A","text":"Size >5 cm"},{"letter":"B","text":"Multiloculated"},{"letter":"C","text":"Cyst in lung"},{"letter":"D","text":"Recurrence after surgery"},{"letter":"E","text":"Perforated cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Multiloculated, C. Cyst in lung, D. Recurrence after surgery, E. Perforated cyst","explanation":"b. Multiloculated, c. Cyst in lung, d. Recurrence after surgery, e. Perforated cyst"},{"n":26,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"Capitonnage is used in treatment of: (MHSSMCET 2008)","options":[{"letter":"A","text":"Choledochal cyst"},{"letter":"B","text":"Dermoid cyst"},{"letter":"C","text":"Hydatid cyst"},{"letter":"D","text":"Renal cyst"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hydatid cyst","explanation":"Methods of Management of the Residual Cavity after Cyst Evacuation\nExternal tube drainage Capsulorrhaphy CapitonnageQ Myoplasty\nAnswer (book): Answer: C. Hydatid cyst\nReference: Blumgart 6/e p1114, 5/e p1045"},{"n":27,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 229","pdfPage":221,"stem":"A 40-year-old female presented with abdominal discomfort, dyspepsia and palpable abdominal mass. USG and CECT was performed. What is the diagnosis based on this ultrasound image?","options":[{"letter":"A","text":"Hydatid cyst"},{"letter":"B","text":"Multiple HCC"},{"letter":"C","text":"Liver secondaries"},{"letter":"D","text":"Polycystic liver disease"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hydatid cyst","explanation":"OmentoplastyQ Internal collapseQ IntroflexionQ MarsupializationQ\n• Introflexion plus omentoplasty\n• Cystojejunostomy or Cystogastrostomy\nWHO Classification of Hydatid Cyst CL Type • Well-circumscribed liquid image with a clearly defined wall CE 1\n• Concentric hyperechogenic halo around the cyst which may contain free-floating hyperechogenic foci called\nhydatid sandQ CE 2\n• Multivesicular cyst with the daughter and grand-daughter cysts identified by honeycomb, rosette, spoke wheel or\ncluster imagesQ CE 3\n• Partial or total detachment of the laminated layer with floating undulated hyperechogenic membranes showing\nthe dual wall, water lilly and water snake signsQ. CE 4\n• Cystic and solid componentsQ together without visible daughter cysts. CE 5\n• Matrix or amorphous mass with a solid or semisolid appearance; limited amount of calcification; least common\ntype.\nImage-based question: the picture / video this question refers to is on PDF p. 221 of the source and is not reproduced here.\nAnswer (book): Answer: A. Hydatid cyst"},{"n":28,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"In the treatment of hydatid cyst, PAIR is contraindicated in: (PGI Dec 2006)","options":[{"letter":"A","text":"Lung cyst"},{"letter":"B","text":"Size > 5 cm"},{"letter":"C","text":"Not amenable to treatment with albendazole"},{"letter":"D","text":"Multiple"},{"letter":"E","text":"Inaccessible location"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lung cyst, E. Inaccessible location","explanation":"a. Lung cyst, e. Inaccessible location (Ref: Sabiston 20/e p1454; Bailey 27/e p1169; Blumgart 6/e p1117, 5/e p1047-1048; Shackelford 8/e p1425,\n7/e p1461)"},{"n":29,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"A 40-year old male presents with a painless cystic liver enlargement of four years duration without fever or jaundice. The most likely diagnosis is: (UPSC 96)","options":[{"letter":"A","text":"Amoebic liver abscess"},{"letter":"B","text":"Hepatoma"},{"letter":"C","text":"Hydatid cyst of liver"},{"letter":"D","text":"Choledochal cyst"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hydatid cyst of liver","explanation":"c. Hydatid cyst of liver"},{"n":30,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"All are complications of hydatid cyst in the liver except: (APPG 97)","options":[{"letter":"A","text":"Jaundice"},{"letter":"B","text":"Suppuration"},{"letter":"C","text":"Cirrhosis"},{"letter":"D","text":"Rupture"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cirrhosis","explanation":"c. Cirrhosis"},{"n":31,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"During surgical exploration for hydatid cyst of the liver, any of the following agents can be used as scolicidal agent except: (UPSC 2004)","options":[{"letter":"A","text":"Hypertonic sodium chloride"},{"letter":"B","text":"Formalin"},{"letter":"C","text":"Cetrimide"},{"letter":"D","text":"Povidone iodine"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Formalin","explanation":"b. Formalin"},{"n":32,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"Ring like calcification on CECT is seen in: (Recent Question 2016)","options":[{"letter":"A","text":"HC"},{"letter":"B","text":"FNH"},{"letter":"C","text":"Liver metastasis"},{"letter":"D","text":"Hydatid cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hydatid cyst","explanation":"• Ring like calcification on CECT is seen in hydatid cyst.\nAnswer (book): Answer: D. Hydatid cyst\nReference: Sabiston 20/e p1452"},{"n":33,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"Which of the following is true about hydatid cyst of liver? (Recent Question 2014, DPG 2007)","options":[{"letter":"A","text":"Surgical management is done always"},{"letter":"B","text":"Conservative treatment is effective"},{"letter":"C","text":"Aspiration is safe"},{"letter":"D","text":"E. multilocularis is the most common cause"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Aspiration is safe","explanation":"Aspiration is safe in Hydatid cyst of liver.\nAnswer (book): Answer: C. Aspiration is safe\nReference: Bailey 27/e p1169"},{"n":34,"chapter":"Liver","src":"question on PDF p. 221 · answer on PDF p. 230","pdfPage":221,"stem":"Treatment of hydatid cyst: (APPG 2008)","options":[{"letter":"A","text":"Excision of cyst"},{"letter":"B","text":"Percutaneous drainage"},{"letter":"C","text":"Conservative management"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Percutaneous drainage","explanation":"b. Percutaneous drainage"},{"n":35,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Investigation of choice for hydatid disease is: (MCI Sept 2009)","options":[{"letter":"A","text":"CT scan"},{"letter":"B","text":"ELISA"},{"letter":"C","text":"Biopsy"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ELISA","explanation":"b. ELISA"},{"n":36,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Medical management of hydatid disease is indicated in","options":[{"letter":"A","text":"Pregnancy"},{"letter":"B","text":"Infected hydatid cyst"},{"letter":"C","text":"Moribund patients"},{"letter":"D","text":"Multiple peritoneal cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Multiple peritoneal cyst, C. Moribund patients","explanation":"d. Multiple peritoneal cyst, c. Moribund patients (Ref: Sabiston 20/e p1453)"},{"n":37,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"The sensitivity of Casoni’s test is: (Recent Question 2016)","options":[{"letter":"A","text":"50%"},{"letter":"B","text":"60%"},{"letter":"C","text":"75%"},{"letter":"D","text":"90%"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"60%","explanation":"• The sensitivity of Casoni’s test varies from 55 to 65%Q.\nAnswer (book): Answer: B. 60%"},{"n":38,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Malignant hydatidosis is caused by: (Recent Question 2016)","options":[{"letter":"A","text":"Echinococcus granulosus"},{"letter":"B","text":"Echinococcus multilocularis"},{"letter":"C","text":"Echinococcus vogelli"},{"letter":"D","text":"Echinococcus oligarthus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Echinococcus multilocularis","explanation":"b. Echinococcus multilocularis"},{"n":39,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Malignant hydatid disease is caused by: (Recent Question 2017)","options":[{"letter":"A","text":"E. granulosus"},{"letter":"B","text":"E. oligarthus"},{"letter":"C","text":"E. vogelli"},{"letter":"D","text":"E. multilocularis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"E. multilocularis","explanation":"d. E. multilocularis (Ref: Sabiston 20/e 1452p; Schwartz 10/e p1286)"},{"n":40,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"What is the name of this sign seen on CT chest? (Recent Question 2017)","options":[{"letter":"A","text":"Rising sun sign"},{"letter":"B","text":"Water lily sign"},{"letter":"C","text":"Meniscus sign"},{"letter":"D","text":"Serpent sign"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Water lily sign","explanation":"“The water-lily sign is seen in hydatid cyst when there is detachment of the endocyst membrane which\nresults in floating membranes within the pericyst that mimic the appearance of a water lily. It is classically described\non plain radiographs (mainly chest X-ray) when the collapsed membranes are calcified but may be seen on\nultrasound and CT.” Water Lily Sign\nAnswer (book): Answer: B. Water lily sign\nReference: Wolfgang 2/e p309"},{"n":41,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"False about hepatic adenoma: (ILBS 2012)","options":[{"letter":"A","text":"Chances of malignancy in 10% cases"},{"letter":"B","text":"Rupture in 20% cases"},{"letter":"C","text":"Hepatic architecture is maintained"},{"letter":"D","text":"Most patients are symptomatic"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hepatic architecture is maintained","explanation":"c. Hepatic architecture is maintained  (Ref: Sabiston 20/e p1455; Schwartz 10/e p1290-1291; Bailey 26/e p1083; Blumgart 6/e p1284, 5/e\np1258-1262; Shackelford 8/e p1537, 7/e p1564-1565)"},{"n":42,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"All are true about liver adenoma except: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Normal liver architecture"},{"letter":"B","text":"Increased fat"},{"letter":"C","text":"Increased glycogen"},{"letter":"D","text":"Cells arranged in cords"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Normal liver architecture","explanation":"a. Normal liver architecture"},{"n":43,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"About hepatic adenoma, all are true except: (AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"Increased glycogen and fat in hepatocytes"},{"letter":"B","text":"Normal liver architecture"},{"letter":"C","text":"Bile ductules are not seen"},{"letter":"D","text":"Tumor markers are normal"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Normal liver architecture","explanation":"b. Normal liver architecture"},{"n":44,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Most common cause of non-traumatic hemo-peritoneum: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Hepatic adenoma"},{"letter":"B","text":"FNH"},{"letter":"C","text":"HCC"},{"letter":"D","text":"Hemangioma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hepatic adenoma","explanation":"a. Hepatic adenoma"},{"n":45,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Most common liver tumor in those on OCPs: (MHSSMCET 2007)","options":[{"letter":"A","text":"HCC"},{"letter":"B","text":"Liver cell adenoma"},{"letter":"C","text":"Bile duct adenoma"},{"letter":"D","text":"Focal nodular hyperplasia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Liver cell adenoma","explanation":"b. Liver cell adenoma"},{"n":46,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"All are true about hepatic adenoma except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Usually multiple"},{"letter":"B","text":"OCP is a predisposing factor"},{"letter":"C","text":"Has cords of benign hepatocytes"},{"letter":"D","text":"50-75% are symptomatic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Usually multiple","explanation":"a. Usually multiple"},{"n":47,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Which of the following liver tumors always merit surgery? (DPG 2009 March)","options":[{"letter":"A","text":"Hemangioma"},{"letter":"B","text":"Hepatic adenoma"},{"letter":"C","text":"Focal nodular hyperplasia"},{"letter":"D","text":"Peliosis hepatis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatic adenoma","explanation":"Hepatic adenoma always merits surgery. As no characteristic radiological features to differentiate\nthese lesions from malignant tumor. These tumors are thought to have malignant potential and resection is therefore\nthe treatment of choiceQ.\nAnswer (book): Answer: B. Hepatic adenoma\nReference: Bailey 27/e p1172; Taber’s Medical Dictionary 19/e p1600"},{"n":48,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Central stellate scar is seen in: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"FNH"},{"letter":"B","text":"Hemangioma"},{"letter":"C","text":"Hepatic adenoma"},{"letter":"D","text":"HCC"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"FNH","explanation":"a. FNH (Ref: Sabiston 20/e p1456; Schwartz 10/e p1291; Bailey 27/e p1172; Blumgart 6/e p1306, 5/e p1255-1258; Shackelford 8/e p1536, 7/e p1563-\n1564)"},{"n":49,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"Radiographic image of a benign tumor is given below. What is the most probable diagnosis?","options":[{"letter":"A","text":"Hemangioma"},{"letter":"B","text":"Focal nodular hyperplasia"},{"letter":"C","text":"Hepatic adenoma"},{"letter":"D","text":"Peliosis hepatis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Focal nodular hyperplasia","explanation":"The given image shows central stellate scar, which is seen in focal nodular hyperplasia.\nImage-based question: the picture / video this question refers to is on PDF p. 222 of the source and is not reproduced here.\nAnswer (book): Answer: B. Focal nodular hyperplasia\nReference: Sabiston 20/e p1456; Schwartz 10/e p1291; Bailey 27/e p1172"},{"n":50,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 230","pdfPage":222,"stem":"All of the following are true regarding FNH except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Not frequently associated with OCPs"},{"letter":"B","text":"Surgical resection is required due to risk of malignancy"},{"letter":"C","text":"Stellate scar is diagnostic"},{"letter":"D","text":"Typical hepatic vascularity is not seen with spoke wheel pattern"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Surgical resection is required due to risk of malignancy","explanation":"b. Surgical resection is required due to risk of malignancy"},{"n":51,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 231","pdfPage":222,"stem":"True statement regarding focal nodular hyperplasia: (PGI Nov 2011)","options":[{"letter":"A","text":"More common in young women"},{"letter":"B","text":"Associated with OCP use"},{"letter":"C","text":"May present with abdominal pain"},{"letter":"D","text":"Excision biopsy may aid in diagnosis"},{"letter":"E","text":"Progress to cirrhosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"More common in young women, B. Associated with OCP use, C. May present with abdominal pain,","explanation":"a. More common in young women, b. Associated with OCP use, c. May present with abdominal pain, d. Excision biopsy may\naid in diagnosis"},{"n":52,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 231","pdfPage":222,"stem":"Similarity between FNH and hepatic adenoma are all except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Hemoperitoneum is common"},{"letter":"B","text":"Biliary abnormalities are seen"},{"letter":"C","text":"More common in females"},{"letter":"D","text":"Associated with OCPs"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hemoperitoneum is common","explanation":"a. Hemoperitoneum is common"},{"n":53,"chapter":"Liver","src":"question on PDF p. 222 · answer on PDF p. 231","pdfPage":222,"stem":"Which one of the following hepatic lesions can be diagnosed with high accuracy by using nuclear imaging? (AIIMS Nov 2004)","options":[{"letter":"A","text":"Hepatocellular carcinoma"},{"letter":"B","text":"Hepatic adenoma"},{"letter":"C","text":"Focal nodular hyperplasia"},{"letter":"D","text":"Hemangioma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Focal Nodular Hyperplasia","explanation":"c. Focal Nodular Hyperplasia\nHEMANGIOMA"},{"n":54,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"All are true about liver hemangioma except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"CHF is very common"},{"letter":"B","text":"Incidental detection"},{"letter":"C","text":"Consumptive coagulopathy can occur"},{"letter":"D","text":"Spontaneous regression is seen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CHF is very common","explanation":"a. CHF is very common (Ref: Sabiston 20/e p1456-1457; Schwartz 10/e p1289-1290; Bailey 27/e p1172; Blumgart 6/e p1300, 5/e p1250-1255;\nShackelford 8/e p1532, 7/e p1560-1563)"},{"n":55,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Most common benign tumor of liver is: (DNB 2005, 2000, JIPMER GIS 2011","options":[{"letter":"A","text":"Hemangioma"},{"letter":"B","text":"Hepatic adenoma"},{"letter":"C","text":"Hepatoma"},{"letter":"D","text":"Hamartoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hemangioma","explanation":"a. Hemangioma"},{"n":56,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"CECT with nodular enhancement is suggestive of: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Hepatic adenoma"},{"letter":"B","text":"FNH"},{"letter":"C","text":"Hemangioma"},{"letter":"D","text":"HCC"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hemangioma","explanation":"c. Hemangioma"},{"n":57,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Most common nodule found in the liver is:","options":[{"letter":"A","text":"Hepatoma"},{"letter":"B","text":"Hamartoma"},{"letter":"C","text":"Hemangioma"},{"letter":"D","text":"Cholangiodenoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hemangioma","explanation":"c. Hemangioma"},{"n":58,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Which is the commonest incidentaloma detected in the liver? (Karnataka 94)","options":[{"letter":"A","text":"Focal nodular hyperplasia"},{"letter":"B","text":"Hemangioma"},{"letter":"C","text":"Hepatocellular adenoma"},{"letter":"D","text":"Hydatid cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hemangioma","explanation":"Hepatic Adenoma | Focal Nodular Hyperplasia | Peliosis Hepatis\n• MC hepatic neoplasmQ\n• Benign in nature\n• CT scan showing characteristic appearance of slow contrast enhancement due to small vessel uptakeQ in the\nhemangioma\n• Little malignant potential, hemangioma is not an indication for surgeryQ\n• Rare benign liver tumors\n• No characteristic radiological features to differentiate these lesions from malignant tumorsQ\n• These tumors are thought to have malignant potential and resection is the treatment of choiceQ\n• Benign conditionQ of unknown etiology\n• Focal overgrowthQ of functioning liver tissue supported by fibrous stroma\n• Patients are middle aged femalesQ, no association with underlying liver disease\n• Sulphur colloid scan of liver is useful for diagnosis. FNH contain both hepatocytes and Kupffer cellsQ. The latter\ntake up the colloid, differentiating FNH from either a benign adenoma or a primary or metastatic cancer, none of\nwhich contains a significant number of Kupffer cellsQ.\n• Multiple cystic blood filled spacesQ in the liver associated with dilatation of the sinusoidsQ.\n• Leads to hepatic enlargement and painQ\n• Associated with use of OCPs, anabolic steroids and BartonellaQ\n• If due to infection, treatment requires parenteral doxycyclineQ (surgery is not required in every case)\nAnswer (book): Answer: B. Hemangioma\nReference: Schwartz 10/e p1288-1289; Bailey 27/e p1172; Blumgart 6/e p1300, 5/e p1250-1262"},{"n":59,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Most common liver tumor in children: (Recent Question 2017)","options":[{"letter":"A","text":"Hemangioma"},{"letter":"B","text":"Non-parasitic cyst"},{"letter":"C","text":"Adenoma"},{"letter":"D","text":"Focal nodular hyperplasia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hemangioma","explanation":"a. Hemangioma (Ref: Sabiston 20/e p1456; Schwartz 10/e p1289; Bailey 27/e p1171)"},{"n":60,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Solitary Hypoechoic lesion of the liver without septa or debris is most likely to be: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Hydatid cyst"},{"letter":"B","text":"Caroli’s disease"},{"letter":"C","text":"Liver abscess"},{"letter":"D","text":"Simple cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Simple cyst","explanation":"d. Simple cyst: (Ref: Sabiston  20/e p1469; Schwartz 10/e p1288-1289; Blumgart 6/e p530, 5/e p1052-1054; Shackelford 8/e p1421, 7/e p1453-\n1457)"},{"n":61,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Simple hepatic cyst, all are true except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Asymptomatic"},{"letter":"B","text":"Lined by columnar epithelium"},{"letter":"C","text":"Intracystic bleeding is common and deroofing is mandatory"},{"letter":"D","text":"Congenital"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Intracystic bleeding is common and deroofing is mandatory","explanation":"c. Intracystic bleeding is common and deroofing is mandatory"},{"n":62,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"What is the diagnosis based on this ultrasound image?","options":[{"letter":"A","text":"Simple hepatic cyst"},{"letter":"B","text":"HCC"},{"letter":"C","text":"Liver secondaries"},{"letter":"D","text":"Intrahepatic cholangiocarcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Simple hepatic cyst","explanation":"p1453-1457\nSimple Hepatic Cyst\n• Contain serous fluid, do not communicate with the biliary tree, and do not have septationsQ\n• Diagnosis: USG (Posterior acoustic enhancement)\nImage-based question: the picture / video this question refers to is on PDF p. 223 of the source and is not reproduced here.\nAnswer (book): Answer: A. Simple hepatic cyst\nReference: Sabiston 20/e p1469; Schwartz 10/e p1288; Blumgart 6/e p530, 5/e p1052-1054; Shackelford 8/e p1421, 7/e"},{"n":63,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Treatment of choice for simple cyst of liver: (JIPMER November 2017)","options":[{"letter":"A","text":"Percutaneous drainage"},{"letter":"B","text":"Cysto-enterostomy"},{"letter":"C","text":"Deroofing"},{"letter":"D","text":"Aspiration"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Deroofing","explanation":"c. Deroofing (Ref: Schwartz 10/e p1289; Sabiston 20/e p1469)"},{"n":64,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Treatment of symptomatic polycystic liver disease is: (DPG 2008)","options":[{"letter":"A","text":"Deroofing of the cyst"},{"letter":"B","text":"Injection of sclerosant"},{"letter":"C","text":"Hepatic resection"},{"letter":"D","text":"Liver transplantation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Deroofing of the cyst","explanation":"p1457-1458; Maingot 11/e p776\nTreatment of symptomatic polycystic liver disease is deroofing of the cyst.\nAnswer (book): Answer: A. Deroofing of the cyst\nReference: Sabiston 20/e p1469; Schwartz 10/e p1288-1289; Blumgart 6/e p1140, 5/e p1054-1062; Shackelford 8/e p1424, 7/e"},{"n":65,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"All are risk factors for HCC except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"HBV"},{"letter":"B","text":"HCV"},{"letter":"C","text":"Alcohol"},{"letter":"D","text":"IBS"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"IBS","explanation":"d. IBS (Ref: Sabiston 20/e p1458; Schwartz 10/e p1291, 1294-1296; Bailey 27/e p1173; Blumgart 6/e p1334, 5/e p1284; Shackelford 8/e p1542,\n7/e p1565-1568)"},{"n":66,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Which of the following most significantly increases the risk of HCC? (AIIMS May 2012)","options":[{"letter":"A","text":"HBV"},{"letter":"B","text":"HAV"},{"letter":"C","text":"CMV"},{"letter":"D","text":"EBV"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"HBV","explanation":"a. HBV"},{"n":67,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"True regarding HCC: (JIPMER 2010)","options":[{"letter":"A","text":"Non alcoholic steatohepatitis is a risk factor"},{"letter":"B","text":"OCP’s are a cause"},{"letter":"C","text":"Focal nodular hyperplasia may turn malignant"},{"letter":"D","text":"Chromosomal abnormalities are common"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Non alcoholic steatohepatitis is a risk factor","explanation":"• Cirrhosis due to NAFLD (Non-alcoholic fatty liver disease) mainly caused by obesity is a risk factor for HCC.\nAnswer (book): Answer: A. Non alcoholic steatohepatitis is a risk factor\nReference: Shackelford 8/e p1542, 7/e p1567"},{"n":68,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 231","pdfPage":223,"stem":"Tumor marker of HCC: (AIIMS GIS 2003)","options":[{"letter":"A","text":"AFP"},{"letter":"B","text":"Alpha fucosidases"},{"letter":"C","text":"DCGP"},{"letter":"D","text":"Carbohydrate antigen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"AFP","explanation":"Shackelford 8/e p1544, 7/e p1567-1576\nHemangioma\nAnswer (book): Answer: A. AFP\nReference: Sabiston 20/e p1458-1463; Schwartz 10/e p1294-1296; Bailey 27/e p1175; Blumgart 6/e p1335, 5/e p1283-1289;"},{"n":69,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"In high risk population, HCC is best detected by: (AIIMS GIS 2003)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"CT"},{"letter":"C","text":"MRI"},{"letter":"D","text":"PET scan"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"USG","explanation":"a. USG"},{"n":70,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"All are true about AFP except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Not return to normal after hepatic resection"},{"letter":"B","text":"Levels >400 ng/mL with typical radiological findings is diagnostic of HCC"},{"letter":"C","text":"Can be raised in other benign conditions"},{"letter":"D","text":"Fibrolamellar HCC has normal levels"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Not return to normal after hepatic resection","explanation":"a. Not return to normal after hepatic resection"},{"n":71,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"AFP is elevated in: (PGI May 2011)","options":[{"letter":"A","text":"HCC"},{"letter":"B","text":"Hepatoblastoma"},{"letter":"C","text":"Infant hemangioendothelioma"},{"letter":"D","text":"Amoebic liver abscess"},{"letter":"E","text":"Embryonic sarcoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"HCC, B. Hepatoblastoma","explanation":"a. HCC, b. Hepatoblastoma"},{"n":72,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"Okuda staging contains all except: (ILBS 2012)","options":[{"letter":"A","text":"Bilirubin"},{"letter":"B","text":"Tumor size"},{"letter":"C","text":"Ascites"},{"letter":"D","text":"AFP"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"AFP","explanation":"d. AFP (Ref: Sabiston 20/e p1460; Blumgart 6/e p1335, 5/e p1286-1287; Shackelford 8/e p1544, 7/e p1567-1576)"},{"n":73,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"What is the most probable diagnosis based on this triple-phase CT?","options":[{"letter":"A","text":"Hemangioma"},{"letter":"B","text":"Focal nodular hyperplasia"},{"letter":"C","text":"Hepatic adenoma"},{"letter":"D","text":"Hepatocellular carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hepatocellular carcinoma","explanation":"In the given triple-phase CT, there is arterial hyper vascularization with venous washout, diagnostic of\nHCC.\nAnswer (book): Answer: D. Hepatocellular carcinoma\nReference: Sabiston 20/e p1459; Schwartz 10/e p1291; Bailey 27/e p1173-1174"},{"n":74,"chapter":"Liver","src":"question on PDF p. 223 · answer on PDF p. 232","pdfPage":223,"stem":"In HCC: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Arterial bruit is present in 80% cases"},{"letter":"B","text":"Two third patients present with signs of liver disease"},{"letter":"C","text":"Hemoperitoneum in 7% patients"},{"letter":"D","text":"Percutaneous biopsy is mandatory for diagnosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hemoperitoneum in 7% patients","explanation":"Clinical Features of HCC\n• Vascular bruit (25%) , GI bleed (10%), tumor rupture (2-5%)Q, jaundice due to biliary obstruction (10%),\nparaneoplastic syndrome (<5%). Q\nAnswer (book): Answer: C. Hemoperitoneum in 7% patients\nReference: Sabiston 20/e p1459"},{"n":75,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Most common paraneoplastic syndrome of HCC: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Hypoglycemia"},{"letter":"B","text":"Hypertension"},{"letter":"C","text":"Hypercalcemia"},{"letter":"D","text":"Erythrocytosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hypoglycemia","explanation":"Paraneoplastic Syndromes in HCC\n• Hypercholesterolemia (MC) >hypoglycemiaQ, erythrocytosis, hypercalcemia Q\nAnswer (book): Answer: A. Hypoglycemia\nReference: Sabiston 20/e p1459"},{"n":76,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Oncological outcome in HCC is described by all except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"MELD"},{"letter":"B","text":"BCLC"},{"letter":"C","text":"CLIP"},{"letter":"D","text":"OKUDA"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MELD","explanation":"a. MELD"},{"n":77,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"The following are true about HCC except: (AIIMS Nov 2003)","options":[{"letter":"A","text":"It has a high incidence in East Africa and South East Asia"},{"letter":"B","text":"Its worldwide incidence parallels the prevalence of hepatitis B"},{"letter":"C","text":"Over 80% of tumors are surgically resectable"},{"letter":"D","text":"Liver transplantation offers the only chance of cure in those with unresectable disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Over 80% of tumors are surgically resectable","explanation":"c. Over 80% of tumors are surgically resectable"},{"n":78,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"The most unlikely clinical feature of hepatocellular carci noma is: (All India 94)","options":[{"letter":"A","text":"Hepatomegaly"},{"letter":"B","text":"Raised AFP levels"},{"letter":"C","text":"Raised alkaline phosphatase"},{"letter":"D","text":"Jaundice"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Jaundice","explanation":"d. Jaundice"},{"n":79,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"True about Hepatocellular carcinoma: (PGI Dec 2002)","options":[{"letter":"A","text":"Most common tumor of liver"},{"letter":"B","text":"Resectable only in 1% cases"},{"letter":"C","text":"AFP increased in 70% cases"},{"letter":"D","text":"USG guided aspiration biopsy is used for diagnosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"AFP is increased in 70% cases","explanation":"c. AFP is increased in 70% cases"},{"n":80,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Spontaneous rupture of the liver occurs in:","options":[{"letter":"A","text":"Hepatoma"},{"letter":"B","text":"Portal hypertension"},{"letter":"C","text":"Spherocytosis"},{"letter":"D","text":"Secondary deposits"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hepatoma","explanation":"a. Hepatoma"},{"n":81,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Tumor marker for primary hepatocellular carcinoma are all except: (AIIMS May 2007)","options":[{"letter":"A","text":"Alpha-feto protein"},{"letter":"B","text":"Alpha-2 macroglobulin"},{"letter":"C","text":"PIVKA-2"},{"letter":"D","text":"Neurotensin"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Alpha-2 macroglobulin","explanation":"b. Alpha-2 macroglobulin"},{"n":82,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"All of the following are modalities of therapy for hepatocellular carcinoma except: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Radiofrequency ablation"},{"letter":"B","text":"Transarterial catheter embolization"},{"letter":"C","text":"Percutaneous acetic acid"},{"letter":"D","text":"Nd-YAG laser ablation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Nd-YAG laser ablation","explanation":"Shackelford 8/e p1547, 7/e p1571-1577\nTreatment of HCC\n• Hepatic resection as the first-line treatment for cirrhotic patients with small HCC and preserved liver function and\nreserve salvage transplantation for recurrence or deterioration of liver function after hepatic resectionQ\n• Only patients with normal bilirubin concentration and absence of portal hypertension should be considered for\nresectionQ.\n• If not candidate for surgery offer percutaneous ablation; patients with more advanced disease (large or multifocal\nHCC) without portal vein invasion are candidates for transarterial chemoembolization if liver function is preserved\n(the sole palliative approach that has been shown to have a positive impact in survival is transarterial\nchemoembolization)Q.\n• For patients without cirrhosis who develop HCC, resection is the treatment of choice Q.\n• For those patients with Child’s class A cirrhosis with preserved liver function and no portal hypertension,\nresection also is considered Q.\n• If resection is not possible because of poor liver function and the HCC meets the Milan criteria (one nodule <5\ncm, or two or three nodules all <3 cm, no gross vascular invasion or extrahepatic spread), liver transplantation is\nthe treatment of choice Q. Milan Criteria (Mazzafero)\n• One nodule <5 cm\nTwo or three nodules all <3 cm\nNo gross vascular invasion or extrahepatic spread\nAnswer (book): Answer: D. Nd-YAG laser ablation\nReference: Sabiston 20/e p1461; Schwartz 10/e p1291, 1294-1296; Bailey 27/e p1174; Blumgart 6/e p1338, 5/e p12871288;"},{"n":83,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Which of the following liver tumour has a propensity to invade the portal or hepatic vein? (AIIMS June 2004)","options":[{"letter":"A","text":"Cavernous hemangioma"},{"letter":"B","text":"Hepatocellular carcinoma"},{"letter":"C","text":"Focal nodular hyperplasia"},{"letter":"D","text":"Hepatic adenoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatocellular carcinoma","explanation":"p1573-1574\nHepatocellular Carcinoma\n• HCC derive its blood supply from hepatic arteryQ.\n• HCC is characterized by being hyperdense on the arterial phase of contrast imaging, meaning that they have\nmore arterial perfusionQ.\n• Arterial perfusion of HCC also allows for treatment of the lesions via embolization of feeding arteryQ.\n• Characteristic of HCC: Propensity to invade the portal veinQ.\n• Risk of portal vein invasion appears to correlate with tumor size & differentiationQ.\n• Outcome of patients with portal venous invasion is worse than that of patients whose tumor does not invade the\nportal vein.\nAnswer (book): Answer: B. Hepatocellular carcinoma\nReference: Sabiston 20/e p1459; Schwartz 10/e p1291-1294-1296; Blumgart 6/e p1334, 5/e p1344; Shackelford 8/e p1547, 7/e"},{"n":84,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Ramu, 40-year old male, chronic alcoholic, diagnosed as cirrhosis, presents with a lump in the right lobe of liver. Serum AFP level is normal. Most probable diagnosis is: (AIIMS June 2001)","options":[{"letter":"A","text":"Fibrohyperplasia"},{"letter":"B","text":"Hepatocellular carcinoma"},{"letter":"C","text":"Secondaries"},{"letter":"D","text":"Hepatocellular adenoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatocellular carcinoma","explanation":"This is a typical case of HCC, remember AFP is raised in about 75% of Africans and only 30% of\npatients in US and Europe.\nAnswer (book): Answer: B. Hepatocellular carcinoma"},{"n":85,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 232","pdfPage":224,"stem":"Least common presentation of HCC: (AIIMS GIS 2003)","options":[{"letter":"A","text":"PUO"},{"letter":"B","text":"Mass"},{"letter":"C","text":"Jaundice"},{"letter":"D","text":"Weakness"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"PUO","explanation":"Rare Presentations of HCC\nAnswer (book): Answer: A. PUO\nReference: Sabiston 20/e p1459; Schwartz 10/e p1291, 1294-1296"},{"n":86,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"Hypercalcemia is seen in: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Pancreatic cancer"},{"letter":"B","text":"HCC"},{"letter":"C","text":"CA stomach"},{"letter":"D","text":"CA GB"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"HCC","explanation":"b. HCC"},{"n":87,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"All are tumor markers of HCC except: (PGI SS Dec 2010)","options":[{"letter":"A","text":"Neurotensin"},{"letter":"B","text":"AFP"},{"letter":"C","text":"CA 19-9"},{"letter":"D","text":"PIVKA-2"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"CA 19-9","explanation":"c. CA 19-9"},{"n":88,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"New drug in HCC: (GB Pant 2010)","options":[{"letter":"A","text":"Sorafenib"},{"letter":"B","text":"Bevacizumab"},{"letter":"C","text":"Sunitinib"},{"letter":"D","text":"Cetuximab"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Sorafenib","explanation":"Sorafenib\n• On rare occasions, HCC can present as a rupture with the sudden onset of abdominal pain followed by\nhypovolemic shock secondary to intraperitoneal bleeding.\n• Other rare presentations include hepatic vein occlusion (Budd-Chiari syndrome), obstructive jaundice, hemobilia,\nor fever of unknown origin (PUO)Q.\n• Sorafenib inhibits serine/threonine kinase Raf-1, vascular endothelial growth factor receptor 1, 2,3;\nplatelet-derived growth factor receptor -β; and tumorigenic receptor tyrosine kinases (RTKs; RET, Flt-3, and\nc-Kit)Q.\n• Sorafenib is approved as a standard therapy for unresectable HCCQ.\nAnswer (book): Answer: A. Sorafenib\nReference: Sabiston 20/e p1462; Blumgart 6/e p1513, 5/e p1289; Shackelford 8/e p1547, 7/e p1568"},{"n":89,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"Consider the following features - Asian Male, alcoholic cirrhosis, hypervascular lesion during arterial phase of CT & Portal vein thrombosis. The above features are mostly suggestive of: (APPG 2016)","options":[{"letter":"A","text":"Cholangiocarcinoma"},{"letter":"B","text":"Hepatocellular carcinoma"},{"letter":"C","text":"Metastatic colorectal carcinoma"},{"letter":"D","text":"Neuroendocrine tumors"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatocellular carcinoma","explanation":"b. Hepatocellular carcinoma"},{"n":90,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"The screening for HCC in chronic liver disease is: ) (MHCET 2016)","options":[{"letter":"A","text":"Serial USG + AFP"},{"letter":"B","text":"Serial LFT + AFP"},{"letter":"C","text":"Serial LFT + CT scan"},{"letter":"D","text":"Serial USG + Serial LFT"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Serial USG + AFP","explanation":"a. Serial USG + AFP"},{"n":91,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"Which of the following is not true about Milan’s criteria? (Recent Question 2017)","options":[{"letter":"A","text":"Single tumor <5 cm in size"},{"letter":"B","text":"3 nodules <3 cm in size"},{"letter":"C","text":">5 nodules"},{"letter":"D","text":"No extrahepatic disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":">5 nodules","explanation":"c. >5 nodules (Ref: Shackelford 8/e p1551, 7/e p1576; Sabiston 20/e p645; Schwartz 10/e p1295; Bailey 27/e p1175)"},{"n":92,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"True statement regarding hepatocellular carcinoma is/are: (PGI May 2018)","options":[{"letter":"A","text":"Frequently associated with raised AFP"},{"letter":"B","text":"Good prognosis even without resection"},{"letter":"C","text":"Ultrasound guided biopsy is diagnostic"},{"letter":"D","text":"There is extensive vascular invasion"},{"letter":"E","text":"Most cases present with resectable tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Frequently associated with raised AFP, C. Ultrasound guided biopsy is diagnostic, D. There is","explanation":"a. Frequently associated with raised AFP, c. Ultrasound guided biopsy is diagnostic, d. There is extensive vascular invasion\n(Ref: Schwartz 10/e p1294-1296; Sabiston 20/e p1461; Bailey 27/e p1174)"},{"n":93,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"All are true about fibrolamellar HCC except: (AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"AFP is not raised"},{"letter":"B","text":"Recurrence is common"},{"letter":"C","text":"Raised neurotensin levels"},{"letter":"D","text":"Well demarcated and encapsulated"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Well demarcated and encapsulated","explanation":"d. Well demarcated and encapsulated (Ref: Sabiston 20/e p1462-1463; Blumgart 6/e p1337-1338, 5/e p1227-1228)"},{"n":94,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"True statement about fibrolamellar carcinoma: (GB Pant 2010)","options":[{"letter":"A","text":"Young adults, children"},{"letter":"B","text":"More in males"},{"letter":"C","text":"Related to OCP use"},{"letter":"D","text":"Bad prognosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Young adults, children","explanation":"a. Young adults, children"},{"n":95,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"All are true about fibrolamellar HCC except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Associated with cirrhosis"},{"letter":"B","text":"Recurrences are seen despite of better prognosis"},{"letter":"C","text":"Increased neurotensin and vitamin B12 binding factor"},{"letter":"D","text":"Lymph node metastasis is seen"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Associated with cirrhosis","explanation":"Characteristic Feature | HCC | Fibrolamellar Variant of HCC | Age | 55-60 yearsQ | 25-30 yearsQ | Sex |\nMale >Female | Male=FemaleQ | HBV positivity | 60-70%Q | RareQ | Presence of cirrhosis | 90% | RareQ | Tumor\nMarkers | AFPQ PIVKA-2Q | NeurotensinQ Vitamin B12 binding globulinQ | Tumor | Multicentric, bilobar & invasiveQ |\nWell-circumscribedQ | Resectability | Unresectable in 70-75% casesQ | Resectable in 70-75% casesQ | Prognosis | Poor\n| GoodQ | Q\nAnswer (book): Answer: A. Associated with cirrhosis\nReference: Sabiston 20/e p1463"},{"n":96,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"All of the following are true about fibrolamellar carcinoma of the liver except: (JIPMER 2012, All India 2001)","options":[{"letter":"A","text":"More common in females"},{"letter":"B","text":"Better prognosis than HCC"},{"letter":"C","text":"AFP levels always >1000 pg/ml"},{"letter":"D","text":"Occur in younger individuals"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"AFP level always >1000 pg/ml","explanation":"Q\nQ\nAnswer (book): Answer: C. AFP level always >1000 pg/ml"},{"n":97,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"Which of the following is having better prognosis?","options":[{"letter":"A","text":"HCC"},{"letter":"B","text":"Cholangiocarcinoma"},{"letter":"C","text":"Fibrolamellar variant of HCC"},{"letter":"D","text":"Angiosarcoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Fibrolamellar variant of HCC","explanation":"c. Fibrolamellar variant of"},{"n":98,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"All of the following modalities can be used for in situ ablation of liver secondaries, except: (All India 2006)","options":[{"letter":"A","text":"Ultrasonic waves"},{"letter":"B","text":"Cryotherapy"},{"letter":"C","text":"Alcohol"},{"letter":"D","text":"Radiofrequency"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ultrasonic waves","explanation":"8/e p1568, 7/e p1585-1591\nUltrasonic waves are not described as a method of local ablative therapy for liver secondaries.\nAnswer (book): Answer: A. Ultrasonic waves\nReference: Sabiston 20/e p1464-1465; Schwartz 10/e p1123; Bailey 27/e p1172; Blumgart 6/e p1665, 5/e p1290-1305; Shackelford"},{"n":99,"chapter":"Liver","src":"question on PDF p. 224 · answer on PDF p. 233","pdfPage":224,"stem":"Multiple liver secondaries are most common in the following cancers:","options":[{"letter":"A","text":"Head of pancreas"},{"letter":"B","text":"Stomach"},{"letter":"C","text":"Gallbladder"},{"letter":"D","text":"Periampullary"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gallbladder","explanation":"CA GB leads to multiple secondaries to liver in advanced stage, and is the most common cause among\nthe given option.\nAnswer (book): Answer: C. Gallbladder"},{"n":100,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 233","pdfPage":225,"stem":"All are considered to be poor prognostic factors in liver metastasis except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Synchronous lesions"},{"letter":"B","text":"Metachronous lesions"},{"letter":"C","text":"Extra-hepatic metastasis"},{"letter":"D","text":"CEA >200 ng/ml"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Metachronous lesions","explanation":"b. Metachronous lesions  (Ref: Sabiston 20/e p1465; Schwartz 10/e p1293-1294; Bailey 27/e p1172; Blumgart 6/e p1643, 5/e p1290-1305;\nShackelford 8/e p1566, 7/e p1585-1589)"},{"n":101,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 233","pdfPage":225,"stem":"Calcific hepatic metastases are seen in: (COMEDK 2009)","options":[{"letter":"A","text":"Adenocarcinoma of the colon"},{"letter":"B","text":"Carcinoid tumours"},{"letter":"C","text":"Renal cell carcinoma"},{"letter":"D","text":"Lymphoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenocarcinoma of the colon","explanation":"Calcified Hepatic Metastases\n• Calcified hepatic metastases are most frequently associated with mucin-producing neoplasms such as colon\ncarcinomaQ or less likely ovarian carcinoma.\nAnswer (book): Answer: A. Adenocarcinoma of the colon\nReference: www.learningradiology.com"},{"n":102,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"Which of the following liver metastasis appear hypoechoic on ultrasound? (All India 2012)","options":[{"letter":"A","text":"Breast cancer"},{"letter":"B","text":"Colon cancer"},{"letter":"C","text":"RCC"},{"letter":"D","text":"Mucinous adenocarcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Breast cancer","explanation":"Hepatic Metastases\n• Metastases from breast cancer are typically hypoechoic (echopoor)Q on ultrasonography.\n• Metastases from carcinoma colon and RCC are typically hyperechoic (echogenic)Q.\n• Metastases from mucinous adenocarcinoma of colon are typically calcifiedQ.\nSonographic Pattern of Hepatic Metastases Echogenic (NCR)\nEchopoor (BPL)\nNeuroendocrine tumors Colonic carcinomaQ Choriocarcinoma RCCQ Multifocal HCC\nBreast cancerQ Carcinoma pancreas Lung cancer Lymphoma\nAnswer (book): Answer: A. Breast cancer\nReference: Focal Liver Lesions (Springer) 2006/266"},{"n":103,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"All are true about hepatoblastoma except: (AIIMS GIS May 2008, Dec 2006)","options":[{"letter":"A","text":"Associated with FAP"},{"letter":"B","text":"Most cases <3 years"},{"letter":"C","text":"Prognosis is very poor with pulmonary metastasis"},{"letter":"D","text":"Treatment is chemotherapy followed by surgical resection"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Prognosis is very poor with pulmonary metastasis","explanation":"c. Prognosis is very poor with pulmonary metastasis  (Ref: Sabiston 20/e p1464; Schwartz 10/e p1641-1642; Blumgart 5/e p1328-1334;\nShackelford 7/e p2037-2038)"},{"n":104,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"All are true about hepatoblastoma except: (PGI SS June 2005)","options":[{"letter":"A","text":"Present in childhood"},{"letter":"B","text":"Common in cirrhosis of liver due to HBV"},{"letter":"C","text":"Chemosensitive"},{"letter":"D","text":"Surgical resection is treatment of choice"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Common in cirrhosis of liver due to HBV","explanation":"No explanation given in the book.\nAnswer (book): Answer: B. Common in cirrhosis of liver due to HBV"},{"n":105,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"AFP is raised in: (KGMC 2011)","options":[{"letter":"A","text":"100% of hepatoblastoma"},{"letter":"B","text":"90% of hepatoblastoma"},{"letter":"C","text":"100% of HCC"},{"letter":"D","text":"90% of HCC"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"90% of hepatoblastoma","explanation":"b. 90% of hepatoblastoma\nHEMANGIOENDOTHELIOMA"},{"n":106,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"All are true about hemangioendothelioma except: (ILBS 2012)","options":[{"letter":"A","text":"Adult variant is benign"},{"letter":"B","text":"More common in females"},{"letter":"C","text":"Multiple and involve bilateral lobe"},{"letter":"D","text":"An indication for liver transplant"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adult variant is benign","explanation":"• Infantile variety is benign, adult one is malignant and highly aggressiveQ.\nAnswer (book): Answer: A. Adult variant is benign\nReference: Blumgart 6/e p1395, 5/e p1246"},{"n":107,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"All of the following are true regarding epitheloid hemangioendothelioma except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Most common in males"},{"letter":"B","text":"Liver transplantation is treatment of choice"},{"letter":"C","text":"Associated with vinyl chloride"},{"letter":"D","text":"Factor VIII staining is used for diagnosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Most common in males","explanation":"Epitheloid hemangioendothelioma is more common in females.\nAnswer (book): Answer: A. Most common in males"},{"n":108,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"False in cystadenoma: (ILBS 2012)","options":[{"letter":"A","text":"More common in females due to OCP use"},{"letter":"B","text":"Cystadenocarcinoma presents as hemorrhagic fluid"},{"letter":"C","text":"Internal septations are better delineated by USG than CT"},{"letter":"D","text":"Most patients are symptomatic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"More common in females due to OCP use","explanation":"a. More common in females due to OCP use (Ref: Sabiston 20/e p1469; Schwartz 10/e p1409-1413; Blumgart 6/e p1326, 5/e p1268-1276;\nShackelford 8/e p1426, 7/e p1459)"},{"n":109,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"True about biliary cystic adenocarcinoma: (PGI Nov 2009)","options":[{"letter":"A","text":"CT scan is used for diagnosis"},{"letter":"B","text":"CA 19-9 is elevated"},{"letter":"C","text":"Intrahepatic location"},{"letter":"D","text":"Extrahepatic location"},{"letter":"E","text":"Common in males"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CT scan is used for diagnosis, B. CA 19-9 is elevated, C. Intrahepatic location","explanation":"a. CT scan is used for diagnosis, b. CA 19-9 is elevated, c. Intrahepatic location  (Ref: Sabiston 20/e p1469, 19/e p1464; Blumgart 6/e\np1327-1328, 5/e p1277-1280; Shackelford 8/e p1426, 7/e p1459)"},{"n":110,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"All are true about hepatic cystadenoma except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Age >40 years and asymptomatic"},{"letter":"B","text":"Malignant predisposition"},{"letter":"C","text":"Surgical resection is required"},{"letter":"D","text":"Large projection with thickened wall is suggestive of malignancy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Age > 40 years and asymptomatic","explanation":"Majority of patients of biliary cystadenoma present with a history of abdominal pain or massQ.\nAnswer (book): Answer: A. Age > 40 years and asymptomatic"},{"n":111,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"Most common indication for liver transplantation in children is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Biliary atresia"},{"letter":"B","text":"Indian childhood cirrhosis"},{"letter":"C","text":"HCC"},{"letter":"D","text":"Hepatitis C infection"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Biliary atresia","explanation":"a. Biliary atresia (Ref: Sabiston 20/e p637-638; Schwartz 10/e p1277; Bailey 27/e p1554; Blumgart 6/e p661, 5/e p1662-1663; Shackelford 8/e\np1365, 7/e p1519-1520)"},{"n":112,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"Place of first liver transplant: (ILBS 2011)","options":[{"letter":"A","text":"Pittsburgh"},{"letter":"B","text":"Boston"},{"letter":"C","text":"Colarado"},{"letter":"D","text":"Cambridge"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Colorado","explanation":"c. Colorado (Ref: Sabiston 20/e p637, 19/e p655-664; Schwartz 10/e p1277, 9/e p295; Bailey 27/e p1554, 26/e p1427, 25/e p1408; Blumgart 6/e\np1848, 5/e p1662)"},{"n":113,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 234","pdfPage":225,"stem":"Auxiliary orthotopic liver transplant is indicated for: (AIIMS May 2008)","options":[{"letter":"A","text":"Metabolic liver disease"},{"letter":"B","text":"As a standby procedure until finding a suitable donor"},{"letter":"C","text":"Drug induced hepatic failure"},{"letter":"D","text":"Acute fulminant liver failure for any cause"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"> d. Metabolic liver disease >Acute fulminant liver failure for any cause","explanation":"APOLT is used in acute fulminant liver failure mainly caused by metabolic liver diseases, not in liver\nfailure from any cause.\nIndications of Auxiliary Partial Orthotopic Liver Transplantation (APOLT)\n1. Reversible fulminant hepatic failureQ | 3. Non-cirrhotic metabolic liver diseaseQ | Small-for-size graftsQ\nABO-incompatibilityQ\nAuxiliary Partial Orthotopic Liver Transplantation (APOLT)\n• APOLT can compensate for enzyme deficiency in non-cirrhotic metabolic liver disease (most commonly\nCriggler-Najjar syndrome) without complete removal of native liver.\n• Transplants of ABO-incompatible grafts are often unavoidable due to limited number of potential donor\ncandidates. A high incidence of early graft failure with a high rate of biliary and vascular complications in\nABO-incompatible liver transplantation is reported. The remnant liver could sustain a patient’s life if the\nanticipated graft failure occurred in an ABO-incompatible case.\n• In small-for-size graft, the remnant liver is expected to support the function of implanted graft during the early\npost-op period. The graft liver expands its function in proportion to volume growth. After the graft liver has grown\nsufficiently, it can be expected to meet the hepatic functional demands of the recipient.\n• In fulminant hepatic failure, APOLT provides temporary support until the native liver recovers and then\nimmunosuppression can be withdrawn.\nAnswer (book): Answer: A. > d. Metabolic liver disease >Acute fulminant liver failure for any cause\nReference: Blumgart 6/e p 1779, 5/e p1689-1693"},{"n":114,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"In orthotropic liver transplantation, which is the best way to get bile drainage in donor liver?","options":[{"letter":"A","text":"Donor bile duct with recipient bile duct or Roux-en-Y choledochojejunostomy"},{"letter":"B","text":"Donor bile duct with duodenum of recipien"},{"letter":"C","text":"Donor bile duct with jejunum of recipient"},{"letter":"D","text":"External drainage for few days followed by choledo chojejunostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Donor bile with recipient bile duct or Roux-en-Y choledochojejunostomy","explanation":"The preferred method biliary drainage during orthotropic liver transplantation is direct end-to-end\nanastomosis between donor common bile duct and recipient common bile duct. Bile duct anastomosis in orthotropic\nliver transplantation\n1. Suprahepatic IVC | 4. Hepatic artery | Choledochojejunostomy (CDJ)\n• This is an Roux-en-Y configuration anastomosis between the end of the common bile duct and the side of a loop\nof jejunum\n• This is an alternative bile duct anastomosis and is performed when CDCD anastomosis is not feasible. This may\nbe the case when the recipient extrahepatic bile duct is diseased or small or when there is significant recipient\ndonor duct size mismatch.\nFive sequential anastomosis of OLT (SIPH-B) | 2. Infrahepatic IVC | 3. Portal vein | 5. Bile duct\nAnswer (book): Answer: A. Donor bile with recipient bile duct or Roux-en-Y choledochojejunostomy\nReference: Blumgart 6/e p1807, 5/e p1727-1728"},{"n":115,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"Reduced liver transplants: (GB Pant 2011)","options":[{"letter":"A","text":"Given to two recipients after dividing into two parts"},{"letter":"B","text":"Left lateral lobe divided and given to child"},{"letter":"C","text":"Left lateral segment divided from segment 2 and given to child"},{"letter":"D","text":"Part of liver segment transplanted into recipient depend ing upon requirement"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Part of liver segment transplanted into recipient depending upon requirement","explanation":"d. Part of liver segment transplanted into recipient depending upon requirement"},{"n":116,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"Liver after transplantation enlarges by: (Recent Question 2015)","options":[{"letter":"A","text":"Increase in size of cell"},{"letter":"B","text":"Increase in number of cells"},{"letter":"C","text":"Both of the above"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Increase in number of cells","explanation":"b. Increase in number of cells"},{"n":117,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"All are indications of liver transplantation except: (Recent Question 2014)","options":[{"letter":"A","text":"Cholangiocarcinoma"},{"letter":"B","text":"Cirrhosis"},{"letter":"C","text":"Biliary atresia"},{"letter":"D","text":"Fulminant hepatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cholangiocarcinoma","explanation":"a. Cholangiocarcinoma"},{"n":118,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"Contraindications to major hepatic resection for metastatic disease includes all of the following except: (COMEDK 2006, Karnataka 2006)","options":[{"letter":"A","text":"Total hepatic involvement"},{"letter":"B","text":"Advanced cirrhosis"},{"letter":"C","text":"Extrahepatic tumour involvement"},{"letter":"D","text":"Jaundice from extrinsic ductal obstruction"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Jaundice from extrinsic ductal obstruction","explanation":"Jaundice from extrinsic ductal obstruction is not a contraindication to major hepatic resection.\nAnswer (book): Answer: D. Jaundice from extrinsic ductal obstruction\nReference: Sabiston 20/e p1470; Blumgart 5/e p1462"},{"n":119,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"The minimum amount of normal perfused liver parenchyma to be left intact when a hepatic resection is planned is: (COMEDK 2008, 2007)","options":[{"letter":"A","text":"10%"},{"letter":"B","text":"20%"},{"letter":"C","text":"50%"},{"letter":"D","text":"75%"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"20%","explanation":"• Up to 70% to 75% of the hepatic volume may be resected with good recovery in patients with relatively normal\nhepatic parenchymaQ (without active hepatitis, cirrhosis, or metabolic defects), as long as the remnant liver has\nadequate portal venous and hepatic arterial inflow, adequate hepatic venous outflow, and adequate biliary\ndrainage.\nAnswer (book): Answer: B. 20%\nReference: Blumgart 5/e p1462; Shackelford 7/e p1494"},{"n":120,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"Regarding hepatic artery ligation which statement is false? (Karnataka 96)","options":[{"letter":"A","text":"The best results are obtained in case of hemobilia"},{"letter":"B","text":"Not useful in primary hepatoma"},{"letter":"C","text":"Can cure secondary carcinoma"},{"letter":"D","text":"Must be covered by massive antibiotic administration"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Not useful in primary hepatoma, C. Can cure secondary carcinoma","explanation":"Hepatic Artery Ligation\n• Used in management of hemobilia, hepatic artery aneurysm and pseudoaneurysm\n• Hepatic artery ligation or embolization is a method of ablation for HCC and liver secondaries, as these tumors are\nexclusively supplied by hepatic artery but it does not cure the malignancyQ.\n• In each case massive antibiotic therapy should be given post-operativelyQ.\nAnswer (book): Answer: B. Not useful in primary hepatoma, C. Can cure secondary carcinoma\nReference: Sabiston 20/e p1470; Blumgart 6/e p1925, 5/e p1344"},{"n":121,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 235","pdfPage":225,"stem":"Vascular inflow occlusion of the liver is by: (DNB 2012)","options":[{"letter":"A","text":"Clamping the hepatic artery"},{"letter":"B","text":"Occluding the portal vein"},{"letter":"C","text":"Clamping the hepatic veins"},{"letter":"D","text":"The Pringle maneuver"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"The Pringle maneuver","explanation":"Choledochocholedochostomy (CDCD)\n• This is end-to-end anastomosis between donor common bile duct and recipient common bile duct\n• This is preferred bile duct anastomosis and is used when the recipient bile duct not diseased.\nPringle Maneuver (Total Inflow Occlusion)\n• Total clamping of the hepatic pedicle, by placing an atraumatic clamp across the foramen of WinslowQ.\n• Appropriate-sized vascular clamp or loop snare easily controls hemorrhage from either the portal vein or the\nhepatic arteriesQ.\n• Inflow occlusion durations of up to 30 minutes can be tolerated safely in cirrhotic livers and possibly up to 60\nminutes in early disease.\n• If prolonged occlusion is required, intermittent clamping can be used with repeated clampings of 10-20 minutes\nduration, each followed by 5 minutes declamping.\nAnswer (book): Answer: D. The Pringle maneuver\nReference: Sabiston 20/e p439; Blumgart 6/e p1581, 5/e p1547; Shackelford 8/e p1417, 7/e p1450-1451"},{"n":122,"chapter":"Liver","src":"question on PDF p. 225 · answer on PDF p. 236","pdfPage":225,"stem":"Pringle maneuver may be required for treatment of: (APPG 2015, Recent Question 2014)","options":[{"letter":"A","text":"Injury to tail of pancreas"},{"letter":"B","text":"Mesenteric ischemia"},{"letter":"C","text":"Bleeding esophageal varices"},{"letter":"D","text":"Liver laceration"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Liver Laceration","explanation":"d. Liver Laceration"},{"n":123,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 236","pdfPage":226,"stem":"Left trisegmentectomy involves removal of: (GB PANT 2010)","options":[{"letter":"A","text":"Segment II III IV V VIII"},{"letter":"B","text":"Segment II III IV"},{"letter":"C","text":"Segment IV V VI VII VIII"},{"letter":"D","text":"Segment V VI VII VIII"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Segment II III IV V VIII","explanation":"Trisegmentectomy\n• Right trisegmentectomy or extended right hepatectomy: Complete resection of segment IV with the right liver\n(removal of segment IV, V, VI, VII, VIII)Q.\n• Left trisegmentectomy or extended left hepatectomy: Complete resection of segments V and VIII with the left\nliver (removal of segment II, III, IV, V, VIII)Q.\nAnswer (book): Answer: A. Segment II III IV V VIII\nReference: Blumgart 6/e p1548, 5/e p1512-1513; Shackelford 8/e p1466, 7/e p1501-1503"},{"n":124,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 236","pdfPage":226,"stem":"Following resection of 2/3 rd of the liver, regeneration is complete within:","options":[{"letter":"A","text":"2-3 months"},{"letter":"B","text":"8-10 weeks"},{"letter":"C","text":"4-6 months"},{"letter":"D","text":"4-5 weeks"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"4-6 months","explanation":"Liver Regeneration\n• Following resection of 2/3rd of the liver, regeneration is complete within 5-6 months.\nAnswer (book): Answer: C. 4-6 months"},{"n":125,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 236","pdfPage":226,"stem":"A 17-years old boy is admitted to the hospital after a road traffic accident. Per abdomen examination is normal. After adequate resuscitation, his pulse rate is 80/min and BP is 110/70 mmHg. Abdominal CT reveals 1 cm deep laceration in the left lobe of the liver extending from the done more than half way through the parenchyma. Appropriate management at this time would be: (DPG 2011, UPSC 2005)","options":[{"letter":"A","text":"Conservative management"},{"letter":"B","text":"Abdominal exploration and packing of hepatic wounds"},{"letter":"C","text":"Abdominal exploration and ligation of left hepatic artery"},{"letter":"D","text":"Left hepatectomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Conservative management","explanation":"p1806-1814; Shackelford 8/e p1448, 7/e p1479-1487\nIn stable patients, conservative management is preferred option.\nAnswer (book): Answer: A. Conservative management\nReference: Sabiston 20/e p437-439; Schwartz 10/e p173-174, 1642; Bailey 27/e p1161; Blumgart 6/e p1890-1891, 5/e"},{"n":126,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 236","pdfPage":226,"stem":"‘Beer-Claw’ appearance on CECT abdomen is seen in: (MHCET 2016)","options":[{"letter":"A","text":"Hepatic laceration"},{"letter":"B","text":"Pancreatic laceration"},{"letter":"C","text":"HCC"},{"letter":"D","text":"RCC"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hepatic laceration","explanation":"a. Hepatic laceration"},{"n":127,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 236","pdfPage":226,"stem":"Left posterior sector of liver consists of: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Segment II and III"},{"letter":"B","text":"Segment II, III and IV"},{"letter":"C","text":"Segment II only"},{"letter":"D","text":"Segment I only"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Segment II only","explanation":"Lobar Anatomy of the Liver\n• Cantlie’s line describes a 750 angle with a horizontal planeQ\n• It extends from the gallbladder fossa to the left side of the IVCQ.\nRight & left halves of the liver is delineated by a plane through the MHV and IVCQ. Right portal fissure divides the\nright lobe into an anteromedial and posterolateral sector. RHV courses along this fissureQ. Right portal fissure\ndescribe an angle of 400 with the transverse planeQ. Left portal fissure divides the left lobe into an anterior and\nposterior sector, LHV courses along this fissureQ.\n• Liver is divided into two lobes by the main portal fissure (scissura), known as Cantlie’s lineQ.\n• Physiological right & left lobe are equally divided by an imaginary line (cholecysto-vena caval lineQ) running from\nGB fossa to groove for IVCQ.\n• In the right lobe:\n– Anteromedial sector: Segment V anteriorly & segment VIII posteriorlyQ\n– Posterolateral sector: Segment VI anteriorly & segment VII posteriorlyQ\n• In the left lobe:\n– Anterior sector is divided by the umbilical fissure into segment IV and segment IIIQ\n– Posterior sector is comprised of only one segment, segment II Q\n• Umbilical fissure is not a scissuraQ, does not contain a hepatic vein, but contains the left portal triad.\n• Left scissura runs posterior to the ligamentum teres and contains the LHV; the left liver is split into an anterior\n(segments III and IV)Q and posterior (segment II-the only sector composed of a single segment)Q sector by the left\nscissura.\nAnswer (book): Answer: C. Segment II only\nReference: Sabiston 20/e p1421-1422; Schwartz 10/e p1264-1269; Bailey 27/e p161"},{"n":128,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 237","pdfPage":226,"stem":"All of the following are true about caudate lobe except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Blood supply from both right and left hepatic artery"},{"letter":"B","text":"Ductal drainage from both right and left duct"},{"letter":"C","text":"Venous drainage is mainly by left and middle hepatic vein"},{"letter":"D","text":"Supply by both branches of portal vein"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Venous drainage is mainly by left and middle hepatic vein","explanation":"p1431\nCaudate lobe Caudate lobe is unique\n• It receives blood supply from both right & left portal pediclesQ\n• Bile drain into both right & left hepatic ductQ\n• Venous drainage is directly into IVCQ\n• Caudate lobe is anatomically divided into three parts,\n1. Spigel lobe (Segment I) | 2. Paracaval portion (segment 9) | 3. Caudate process\nAnswer (book): Answer: C. Venous drainage is mainly by left and middle hepatic vein\nReference: Sabiston 20/e p1422; Schwartz 10/e p1267; Bailey 27/e p1154; Blumgart 6/e p37, 5/e p36; Shackelford 8/e p1250, 7/e"},{"n":129,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 237","pdfPage":226,"stem":"Which is not true regarding the basis of functional divisions of liver? (AIIMS May 2015)","options":[{"letter":"A","text":"Based on portal vein and hepatic vein"},{"letter":"B","text":"Divided into 8 segments"},{"letter":"C","text":"There are three major and three minor fissures"},{"letter":"D","text":"4 sectors"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Divided into 8 segments","explanation":"p1426-1430\nAll of the given options are true. If we have to choose one answer, most preferred option is ‘liver is\ndivided into 8 segments’, because sometimes segment IX is described. Segment IX is a recent subdivision of segment\nI, and describes that part of the segment that lies posterior to segment VIII.\n“Current understanding of the functional anatomy of the liver is based on Couinaud’s division of the liver into eight\n(subsequently nine) functional segments, based upon the distribution of portal venous branches and the location of\nthe hepatic veins in the parenchyma (Couinaud 1957).”-Gray’s 40/e p1165\n“Segment IX is a recent subdivision of segment I, and describes that part of the segment that lies posterior to\nsegment VIII.”-Gray’s 40/e p1166\nAnswer (book): Answer: B. Divided into 8 segments\nReference: Gray’s 40/e p1165, 1166,1178; Sabiston 20/e p1421-1423; Blumgart 6/e p37, 5/e p31-37; Shackelford 8/e p1250, 7/e"},{"n":130,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 237","pdfPage":226,"stem":"Left medial sector contains segment: (GB Pant 2010)","options":[{"letter":"A","text":"III, IV"},{"letter":"B","text":"II, III"},{"letter":"C","text":"I, II"},{"letter":"D","text":"I, IV"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"III, IV","explanation":"• Caudate lobe (segment I), lies between left portal vein & IVC and extends to hepatic venous confluenceQ.\n• Left medial sector contains segment III & IV\n• Left lateral sector contains only one segment, II.\nAnswer (book): Answer: A. III, IV"},{"n":131,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Portal triad is not formed by: (Punjab 2008)","options":[{"letter":"A","text":"Hepatic artery"},{"letter":"B","text":"Portal Vein"},{"letter":"C","text":"Bile duct"},{"letter":"D","text":"Hepatic vein"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hepatic vein","explanation":"Portal Triad Relations\n• CBD laterallyQ\nPortal vein posteriorlyQ\nHepatic artery mediallyQ\nMickey Mouse View: Ultrasound image of hepatic artery, bile duct & portal vein is in a configuration, referred as\nMickey Mouse ViewQ.\nAnswer (book): Answer: D. Hepatic vein"},{"n":132,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Function of hepatic Kupffer cells is: (COMEDK 2004)","options":[{"letter":"A","text":"Formation of sinusoids"},{"letter":"B","text":"Vitamin A storage"},{"letter":"C","text":"Increase blood perfusion"},{"letter":"D","text":"Phagocytosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Phagocytosis","explanation":"Kupffer Cells\nKupffer cells, derived from the macrophage-monocyte systemQ Are irregular stellate-shaped cells that also line the\nsinusoids, insinuating between endothelial cells. Phagocytic, play a major role in the trapping of foreign\nsubstancesQ and initiating an inflammatory response. MHC-II antigens are expressed on Kupffer cells but do not\nconfer efficient antigen presentation compared with macrophages elsewhere in the body.\nHepatic Stellate Cells\n• Hepatic stellate cells (also known as Ito cells or lipocytes) are cells high in lipid content (accounting for their\nphenotypic identification)Q\n• Found in the space of DisseQ\n• Have dendritic processes that contact hepatocyte microvilli and also wrap around endothelial cells.\n• Major function: Vitamin A storage and synthesis of extracellular collagenQ.\nAnswer (book): Answer: D. Phagocytosis\nReference: Sabiston 20/e p1430"},{"n":133,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Which of the following is false about portal vein? (JIPMER 2011)","options":[{"letter":"A","text":"Formed behind the neck of pancreas"},{"letter":"B","text":"Bile duct lies anterior and right to it"},{"letter":"C","text":"Gastro duodenal artery lies to the left and anterior to it"},{"letter":"D","text":"Ascends behind the 2nd part of duodenum"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ascends behind the 2nd part of duodenum","explanation":"Portal vein ascends behind the 1st part, not the 2nd part of duodenum. Portal Vein Part Infraduodenal\nPart Retroduodenal Part\nSupraduodenal Part | Position Anterior Posterior Anterior Posterior | Anterior Posterior\nStructure Neck of pancreas IVC Duodenum (first part)Q Common Bile ductQ Gastroduodenal arteryQ IVC Hepatic\narteryQ Bile ductQ IVCQ (separated by epiploic foramen)\nAnswer (book): Answer: D. Ascends behind the 2nd part of duodenum\nReference: Gray’s 40/e p1170"},{"n":134,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Surgeon excises a portion of liver to the left of the attachment of the falciform ligament. The segments that have been resected are: (All India 2011, 2008)","options":[{"letter":"A","text":"Segment 1a and 4"},{"letter":"B","text":"Segment 1 and 4b"},{"letter":"C","text":"Segment 2 and 3"},{"letter":"D","text":"Segment 1 and 3"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Segment 2 and 3","explanation":"Falciform Ligament\n• Falciform ligament is the most obvious external landmark on the liver surface.\n• Plane passing through the falciform ligament passes through the left lobe\n• It divides the left lobe into a medial segment (segment IV) and lateral segment (segment II and III)Q\nAnswer (book): Answer: C. Segment 2 and 3\nReference: Sabiston 20/e p1421; Schwartz 10/e p1264-1265; Bailey 27/e p1154"},{"n":135,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"False about hepatic duct: (AIIMS May 2011, 2009)","options":[{"letter":"A","text":"Left hepatic duct formed in umbilical fissure"},{"letter":"B","text":"Caudate lobe drains only left hepatic duct"},{"letter":"C","text":"Right hepatic duct formed by V and VIII segments"},{"letter":"D","text":"Left hepatic duct crosses IV segment"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Caudate lobe drains only left hepatic duct","explanation":"Caudate Lobe\n• In approx. 80% of the individuals, caudate lobe drains into both the right & left hepatic ductsQ\n• In 15%, caudate lobe drains only into left hepatic duct\n• In 5%, caudate is drained exclusively by right hepatic duct.\nAnswer (book): Answer: B. Caudate lobe drains only left hepatic duct\nReference: Blumgart 6/e p37, 5/e p36"},{"n":136,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Surgical lobes of liver are divided on the basis of: (PGI June 2002)","options":[{"letter":"A","text":"Hepatic artery"},{"letter":"B","text":"Hepatic vein"},{"letter":"C","text":"Bile ducts"},{"letter":"D","text":"Portal vein"},{"letter":"E","text":"Central veins"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatic vein, D. Portal vein","explanation":"b. Hepatic vein, d. Portal vein"},{"n":137,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"In Couinaud’s classification, segment IV of liver is: (AIIMS Nov 2007)","options":[{"letter":"A","text":"Caudate lobe"},{"letter":"B","text":"Quadrate lobe"},{"letter":"C","text":"Right lobe"},{"letter":"D","text":"Left lobe"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Quadrate lobe","explanation":"b. Quadrate lobe"},{"n":138,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 238","pdfPage":226,"stem":"Line of surgical division of the lobes of the liver is: (AIIMS 85, 87)","options":[{"letter":"A","text":"Falciform ligament to the diaphragm"},{"letter":"B","text":"Gall bladder bed to IVC"},{"letter":"C","text":"Gall bladder bed to the left crus of diaphragm"},{"letter":"D","text":"One inch to the left of falciform ligament to the IVC"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gallbladder bed to IVC","explanation":"Hepatic Vascular Supply Hepatic artery\nWeight: 1800 gm in men and 1400 gm in women Total blood flow: 1.5 L/minQ Free pressure in a hepatic vein: 1-2\nmm HgQ Liver can store up to maximum of 65 gm of glycogen/kg of liver tissueQ. Account for 4% of body weight,\nconsumes about 28% of total body blood flow and 20% of the total oxygen consumed by the bodyQ.\n• Expends 20% of the total kilocalories used by the whole body.\nQ\nPortal vein\n• Hepatic artery supplies about 30 mL/min per 100 gm of liver tissueQ\n• Approx. 25% of the total blood flow to the liverQ\n• Provide 30-50% of the oxygen requirement Q.\n• The intrahepatic bile ducts are exclusively perfused by the hepatic arterial blood via the peribiliary plexusQ.\nPortal vein carries 90 mL/min per 100 gm liver tissueQ It carries about 75% of the total blood flow to the liverQ It\nmay provide 50% to 70% of the oxygen requirementQ. Normal portal pressure is 5-10 mm HgQ.\nRelationship between Hepatic Artery and Portal vein Blood Flow\n• There is an increase in hepatic arterial blood flow after portal flow reduction but the converse is not observedQ.\nAnswer (book): Answer: B. Gallbladder bed to IVC"},{"n":139,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"With Couinaud’s nomenclature, which one of the following segments of liver has an independent vascularization? (UPSC 2002)","options":[{"letter":"A","text":"Segment I"},{"letter":"B","text":"Segment II"},{"letter":"C","text":"Segment IV"},{"letter":"D","text":"Segment VIII"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Segment I","explanation":"a. Segment I"},{"n":140,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"The Couinaud’s segmental nomenclature is based on the position of the: (All India 2004)","options":[{"letter":"A","text":"Hepatic veins and portal vein"},{"letter":"B","text":"Hepatic veins and biliary ducts"},{"letter":"C","text":"Portal vein and biliary ducts"},{"letter":"D","text":"Portal vein and hepatic artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hepatic veins and portal vein","explanation":"Fascial plates of liver hilus\nAnswer (book): Answer: A. Hepatic veins and portal vein"},{"n":141,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"Quadrate lobe of liver is present between: (DPG 97)","options":[{"letter":"A","text":"Groove for ligamentum teres and gallbladder"},{"letter":"B","text":"Inferior vena cava and fissure for ligamentum venosum"},{"letter":"C","text":"Groove for inferior vena cava and fissure for ligamentum venosum"},{"letter":"D","text":"Porta hepatis and falciform ligament"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Groove for ligamentum teres and gallbladder","explanation":"Quadrate lobe of liver is present between groove for ligamentum teres and gallbladder.\nAnswer (book): Answer: A. Groove for ligamentum teres and gallbladder"},{"n":142,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"Boundary of Morrison’s pouch is formed by: (DPG 2008)","options":[{"letter":"A","text":"Kidney"},{"letter":"B","text":"Falciform ligament of liver"},{"letter":"C","text":"Spleen"},{"letter":"D","text":"Pancreas"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Kidney","explanation":"Boundary of Morrison’s pouch is formed by kidney. Boundaries of Morrison’s pouch (Hepatorenal\npouch) Anteriorly\nPosteriorly\n• Inferior surface of right lobe of the liver\n• Right suprarenal gland\n• Gall bladder\n• 2nd part of duodenum\n• Upper part of right kidney\nSuperiorly\n• Inferior layer of coronary ligament\nInferiorly\n• Opens into general peritoneal cavity\n• Hepatic flexure of colon\n• Transverse mesocolon\n• Part of head of pancreas\nAnswer (book): Answer: A. Kidney\nReference: Gray’s 40/e p1101, 1108"},{"n":143,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"The right lobe of liver consists of which of the following segments: (AIIMS 2004)","options":[{"letter":"A","text":"V, VI, VII and VIII"},{"letter":"B","text":"IV, V, Vi, VII and VIII"},{"letter":"C","text":"I, V, VI, VII and VIII"},{"letter":"D","text":"I, IV, V, VI, VII and VIII"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"V, VI, VII and VIII","explanation":"Couinaud’s Classification\n• Caudate lobe: IQ\n• Left lobe: II, III, IVQ\n• Right lobe: V, VI, VII, VIIIQ\nAnswer (book): Answer: A. V, VI, VII and VIII"},{"n":144,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"Liver is divided in 2 halves by all except: (AIIMS 2004)","options":[{"letter":"A","text":"Right hepatic vein"},{"letter":"B","text":"Portal vein"},{"letter":"C","text":"Hepatic artery"},{"letter":"D","text":"Common bile duct"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Right hepatic vein","explanation":"a. Right hepatic vein"},{"n":145,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 239","pdfPage":226,"stem":"Which of the following is not a capsular plate? (AIIMS Nov 2011)","options":[{"letter":"A","text":"Portal plate"},{"letter":"B","text":"Hilar plate"},{"letter":"C","text":"Umbilical plate"},{"letter":"D","text":"Cystic plate"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Portal plate","explanation":"Fascial Plates of Liver Hilus\n• Fascial plates of liver hilus, represents a fusion of endoabdominal fascia around the portal structures\n• Fascial plate is formed by: cystic, hilar & umbilical plate Q\n• Hepatic veins lack endoabdominal fascial investment Q.\nAnswer (book): Answer: A. Portal plate\nReference: Sabiston 20/e p1423; Bailey 27/e p1154; Blumgart 6/e p574, 5/e p41; Shackelford 8/e p2077, 7/e p1430"},{"n":146,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 240","pdfPage":226,"stem":"Right hepatic duct drains all, except: (AIIMS May 2009)","options":[{"letter":"A","text":"Segment I"},{"letter":"B","text":"Segment III"},{"letter":"C","text":"Segment V"},{"letter":"D","text":"Segment VI"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Segment III","explanation":"b. Segment"},{"n":147,"chapter":"Liver","src":"question on PDF p. 226 · answer on PDF p. 240","pdfPage":226,"stem":"A patient has a surgical cause of obstructive jaundice. USG can tell all of the following except: (AIIMS Nov 2012)","options":[{"letter":"A","text":"Biliary tree obstruction"},{"letter":"B","text":"Peritoneal deposits"},{"letter":"C","text":"Gall bladder stones"},{"letter":"D","text":"Ascites"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Peritoneal deposits","explanation":"• Peritoneal deposits are not detected by ultrasound. Even CECT can miss the peritoneal deposits.\n• Best investigation for diagnosis of peritoneal deposits is Diagnostic laparoscopy.\nAnswer (book): Answer: B. Peritoneal deposits\nReference: Sabiston 20/e p1081; Schwartz 9/e p1140"},{"n":148,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 240","pdfPage":227,"stem":"Cholecystocaval line: (Recent Question 2019, 2018)","options":[{"letter":"A","text":"Separate right and left hepatic lobes"},{"letter":"B","text":"Separate gallbladder from portal vein"},{"letter":"C","text":"Separate right anterior and right posterior sectors"},{"letter":"D","text":"Separate left medial and left lateral sectors"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Separate right and left hepatic lobes","explanation":"a. Separate right and left hepatic lobes"},{"n":149,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 240","pdfPage":227,"stem":"Which is wrong about Crigler-Najjar syndrome Type-I? (Orissa 2011)","options":[{"letter":"A","text":"Very high level of unconjugated bilirubin occurs in neonatal period"},{"letter":"B","text":"Kernicterus is usual"},{"letter":"C","text":"It responds well to phenobarbitone"},{"letter":"D","text":"Hepatic histology is normal"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"It responds well to phenobarbitone","explanation":"Feature Total serum bilirubin (mg/dL) Routine liver tests Response to Phenobarbital Kernicterus\nHepatic histology Bile characteristics Color Bilirubin fractions Bilirubin UDP-glucuronosyl transferase activity\nInheritance (all autosomal)\nCrigler-Najjar Syndromes Type I 18-45 (usually >20)Q NormalQ NoneQ UsualQ NormalQ\nType II 6-25 (usually 20Q) Normal Decreases bilirubin by >25%Q RareQ NormalQ\nPale or colorless >90% unconjugatedQ Typically absentQ; traces in some patients\nPigmented Largest fraction (mean: 57%) monoconjugatesQ Markedly reduced: 0-10% of normal\nRecessiveQ\nPredominantly recessive (AR>AD)Q\nAnswer (book): Answer: C. It responds well to phenobarbitone\nReference: Harrison 20/e p2344, 19/e p2001"},{"n":150,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 240","pdfPage":227,"stem":"Conjugated hyperbilirubinemia is seen in: (COMEDK 2011)","options":[{"letter":"A","text":"Dubin-Johnson syndrome"},{"letter":"B","text":"Criggler-Najjar syndrome"},{"letter":"C","text":"Criggler-Najjar syndrome- II"},{"letter":"D","text":"Gilbert syndrome"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Dubin-Johnson syndrome","explanation":"Causes of Hyperbilirubinemia\nIndirect (unconjugated) Hyperbilirubinemia Hemolytic disorders\nInherited SpherocytosisQ Elliptocytosis G-6-PD and pyruvate kinase deficienciesQ Sickle cell anemiaQ\nAcquired\n• Microangiopathic hemolytic anemia\n• PNHQ\n• Immune hemolysis\n• Ineffective erythropoesis in cases of vitamin B and iron deficiencies\n• Drugs: Rifampicin, ribavarinQ, probenicid Inherited conditions:\n• Criggler-Najjar and Gilbert’s syndromeQ\nDirect (conjugated) Hyperbilirubinemia Inherited Conditions:\n1. Dubin-Johnson syndromeQ\n2. Rotor’s syndromeQ\nAnswer (book): Answer: A. Dubin-Johnson syndrome\nReference: Harrison 20/e p2345, 19/e p2003"},{"n":151,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Most common surgical cause of obstructive jaundice: (NEET 2013, Punjab 2007)","options":[{"letter":"A","text":"Periampullary carcinoma"},{"letter":"B","text":"Carcinoma gallbladder"},{"letter":"C","text":"Carcinoma head of pancreas"},{"letter":"D","text":"CBD stones"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"CBD Stones","explanation":"d. CBD Stones"},{"n":152,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"True about Criggler-Najjar syndrome II: (PGI Nov 2011)","options":[{"letter":"A","text":"Autosomal dominant"},{"letter":"B","text":"Kernicterus is frequently present"},{"letter":"C","text":"Child may alive to adolescence"},{"letter":"D","text":"Cause unconjugated hyperbilirubinemia"},{"letter":"E","text":"Phenobarbitone therapy is ineffective"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Autosomal dominant, C. Child may alive to adolescence, D. Cause unconjugated hyperbilirubinemia","explanation":"a. Autosomal dominant, c. Child may alive to adolescence, d. Cause unconjugated hyperbilirubinemia"},{"n":153,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"True about obstructive jaundice: (PGI May 2011)","options":[{"letter":"A","text":"Unconjugated bilirubin"},{"letter":"B","text":"Positive indirect Vanden Bergh test"},{"letter":"C","text":"Pruritus"},{"letter":"D","text":"Pale stools"},{"letter":"E","text":"Icterus"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pruritus, D. Pale stools, E. Icterus","explanation":"Obstructive Jaundice\nMC surgical cause of obstructive jaundice is CBD stonesQ Characterized by dark urine, clay colored stools, icterus\nand pruritusQ. Presence of urobilinogen in urine rules out obstructive jaundiceQ. USG is the best test to differentiate\nmedical from surgical jaundice. Parameter Blood Hemoglobin (12-18 gm/dl) Unconjugated bilirubin (0.2-0.7 mg/dl)\nConjugated bilirubin (0.1-0.3 mg/dl) ALP (3-13 KAU; 30-120 IU/L) Aminotransferases Cholesterol Stool Colour of\nstool Fecal urobilinogen Urine Bilirubin Urobilinogen\nHemolytic | Hepatocellular | Obstructive | Decreased ↑ N N N N | N N or N or ↑ N | N N ↑ N ↑ | N Increased | N\nDecreased | Pale Trace to absent | Nil ↑ | ↑ | ↓\nAnswer (book): Answer: C. Pruritus, D. Pale stools, E. Icterus\nReference: Harrison 20/e p2343-2345, 19/e p1998"},{"n":154,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"In non hemolytic jaundice, urobilinogen is seen in: (PGI 99)","options":[{"letter":"A","text":"Obstructive jaundice"},{"letter":"B","text":"Hepatic fibrosis"},{"letter":"C","text":"Fatty liver"},{"letter":"D","text":"Infective hepatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Infective hepatitis","explanation":"d. Infective hepatitis"},{"n":155,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Courvoisier’s law is related to: (Recent Question 2016)","options":[{"letter":"A","text":"Jaundice"},{"letter":"B","text":"Ureteric calculi"},{"letter":"C","text":"Portal hypertension"},{"letter":"D","text":"The length of skin flap in skin grafting"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Jaundice","explanation":"a. Jaundice (Ref: Saiston 20/e p1544)"},{"n":156,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Which of the following is an exception of Courvoisier’s law? (Recent Question 2015)","options":[{"letter":"A","text":"Double impaction"},{"letter":"B","text":"Portal lymphadenopathy"},{"letter":"C","text":"Periampullary Carcinoma"},{"letter":"D","text":"None of above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Double impaction","explanation":"a. Double impaction"},{"n":157,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Which is not elevated in a child presenting with jaundice, icterus, pruritus and clay colored stools? (AIIMS Nov 2011, Nov 2006)","options":[{"letter":"A","text":"Gamma glutamyl transpeptidase"},{"letter":"B","text":"Alkaline phosphatase"},{"letter":"C","text":"5’-nucleotidase"},{"letter":"D","text":"Glutamate dehydrogenase"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Glutamate dehydrogenase","explanation":"Enzymes Elevated in Cholestasis\n• ALPQ\n• 5’-NucleotidaseQ\n• Gamma glutamyl transpeptidaseQ\nAnswer (book): Answer: D. Glutamate dehydrogenase\nReference: Harrison 19/e p1997, 18/e p2529"},{"n":158,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"One is not the feature of obstructive jaundice: (AIIMS Nov 95)","options":[{"letter":"A","text":"Pruritus"},{"letter":"B","text":"Elevated level of serum bilirubin"},{"letter":"C","text":"Raised alkaline phosphatase"},{"letter":"D","text":"Raised urinary urobilinogen"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Raised urinary urobilinogen","explanation":"d. Raised urinary urobilinogen"},{"n":159,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Vitamin to be corrected in obstructive jaundice: (DNB 2009)","options":[{"letter":"A","text":"Vitamin K"},{"letter":"B","text":"Vitamin C"},{"letter":"C","text":"Vitamin D"},{"letter":"D","text":"Vitamine B12"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Vitamin K","explanation":"a. Vitamin K"},{"n":160,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"A 50 years old patient presented with progressive jaundice. Liver function test was done in which conjugated serum bilirubin-4.8% and total bilirubin-6.7%, alkaline phosphatase-550 IU, SGOT-50, SGPT-65. Most probable diagnosis is: (AIIMS Nov 2013)","options":[{"letter":"A","text":"Jaundice due to choledocholithiasis"},{"letter":"B","text":"Dubin-Johnson syndrome"},{"letter":"C","text":"Viral hepatitis"},{"letter":"D","text":"Malignant obstructive jaundice"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Jaundice due to choledocholithiasis","explanation":"a. Jaundice due to choledocholithiasis (Ref: Sabiston 20/e p1495; Schwartz 9/e p1113; Blumgart 5/e p1129-1146; Schackelford 7/e p1599-\n1604; Harrison 20/e p2431, 19/e p1998)"},{"n":161,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"In a patient with obstructive jaundice, what is the possible explanation for a bilirubin level of 40 mg/dL? (AIIMS November 2016)","options":[{"letter":"A","text":"Malignant obstruction"},{"letter":"B","text":"Complete obstruction of common bile duct"},{"letter":"C","text":"Renal failure"},{"letter":"D","text":"Liver failure"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Renal failure","explanation":"All causes of cholestatic jaundice, i.e. malignant obstruction, complete CBD obstruction can cause high\njaundice but presence of concomitant renal failure leads to increase in bilirubin beyond 30 mg/dL. This is because\nconjugated bilirubin is soluble and can be excreted in urine. But in renal failure, this mechanism is absent and the\nserum bilirubin can rise up to very high levels. Usually even in the presence of total absence of bile flow the bilirubin\nlevels reach a plateau of around 25-30 mg/dl as there is continuous excretion of conjugated bilirubin the bile. When\nthere is such high bilirubin (>30/40 mg/dl) in obstructive jaundice, then suspect associated renal failure or ongoing\nhemolysis (Sepsis with DIC which may be the case in ascending cholangitis, sickle cell anemia, etc.)\nAnswer (book): Answer: C. Renal failure\nReference: Bailey 27/e p213; Textbook of hepatology 6/e p206"},{"n":162,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 241","pdfPage":227,"stem":"Liver biopsy is done through 8 th ICS midaxillary line to avoid: (All India 97)","options":[{"letter":"A","text":"Lung"},{"letter":"B","text":"Pleural cavity"},{"letter":"C","text":"Subdiaphragmatic space"},{"letter":"D","text":"Gallbladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lung","explanation":"• Liver biopsy is done through 8th ICS in midaxillary line to avoid Lung.\nLiver Biopsy\n• Needle biopsy has proved to be most usefulQ technique to obtain representative liver tissue for analysis.\n• For accurate and reliable grading and staging of chronic viral hepatitis; a biopsy specimen of 2 cm Q in length or\nlonger containing\nat least 11 complete portal tractsQ is needed.\n• Liver biopsy is done through 8th ICS in midaxillary line to avoid LungQ.\nAnswer (book): Answer: A. Lung\nReference: Shackelford 7/e p1491-1492"},{"n":163,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"“Crumbled egg appearance” in liver is seen in: (Recent Question 2016)","options":[{"letter":"A","text":"Hepatic adenoma"},{"letter":"B","text":"Chronic amoebic liver abscess"},{"letter":"C","text":"Hydatid liver disease"},{"letter":"D","text":"Hemangioma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hydatid liver disease","explanation":"• Crumbled egg appearance in liver is seen in hydatid diseaseQ.\nAnswer (book): Answer: C. Hydatid liver disease"},{"n":164,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"“Honey-comb liver is seen in: (Recent Question 2016)","options":[{"letter":"A","text":"Micronodular cirrhosis"},{"letter":"B","text":"Dubin Johnson’s syndrome"},{"letter":"C","text":"Actinomycosis"},{"letter":"D","text":"Hydatidosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Actinomycosis","explanation":"c. Actinomycosis (Ref: Harrison 20/e p1221, 19/e p1089)"},{"n":165,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"Primary sinusoidal dilatation of liver is also known as: (COMEDK 2010)","options":[{"letter":"A","text":"Hepar lobatum"},{"letter":"B","text":"Peliosis hepatic"},{"letter":"C","text":"Von-Meyerburg complex"},{"letter":"D","text":"Caroli’s disease"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Peliosis hepatic","explanation":"b. Peliosis hepatic (Ref: Shackelford 7/e p1556-1557)"},{"n":166,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"Obstruction of IVC leads to: (Punjab 2008)","options":[{"letter":"A","text":"Dilatation of thoracoepigastric veins"},{"letter":"B","text":"Caput medusae"},{"letter":"C","text":"Hemorrhoids"},{"letter":"D","text":"Esophageal varices"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Dilatation of thoracoepigastric veins","explanation":"• IVC obstruction can lead to dilatation of thoracoepigastric veins.\nAnswer (book): Answer: A. Dilatation of thoracoepigastric veins"},{"n":167,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"Middle aged man presents with complaints of weakness, fatigue and hyperpigmentation. On examination hepatomegaly and hypoglycemia are present. Diagnosis: (JIPMER 2011)","options":[{"letter":"A","text":"Addison’s disease"},{"letter":"B","text":"Hemochromatosis"},{"letter":"C","text":"IDDM"},{"letter":"D","text":"Cushing’s syndrome"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hemochromatosis","explanation":"Manifestation of Hemochromatosis\n• Liver: Hepatomegaly, cirrhosis, HCCQ\n• Pancreas: Diabetes mellitusQ\n• Heart: CHF, cardiomyopathyQ\n• Skin: HyperpigmentationQ (bronzing of skin)\n• Joints: ArthropathyQ\n• HypogonadismQ\nAnswer (book): Answer: B. Hemochromatosis\nReference: Harrison 20/e p2980, 19/e p2516"},{"n":168,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"A 20 years old male presents with extrapyramidal symptoms and liver damage. Diagnosis:","options":[{"letter":"A","text":"Wilson’s disease"},{"letter":"B","text":"Huntington’s disease"},{"letter":"C","text":"Parkinson’s disease"},{"letter":"D","text":"Hemochromatosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Wilson’s disease","explanation":"a. Wilson’s disease (Ref: Harrison 20/e p2982, 19/e p2519)"},{"n":169,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"Risk factor for angiosarcoma of liver: (MHSSMCET 2008)","options":[{"letter":"A","text":"OCPs"},{"letter":"B","text":"Phenacetin"},{"letter":"C","text":"Vinyl chloride"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Vinyl chloride","explanation":"• Vinyl chloride is a risk factor for hepatic angiosarcoma.\nAnswer (book): Answer: C. Vinyl chloride"},{"n":170,"chapter":"Liver","src":"question on PDF p. 227 · answer on PDF p. 242","pdfPage":227,"stem":"Focal lesion of liver is best detected by: (AIIMS GIS 2003)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"CT"},{"letter":"C","text":"USG"},{"letter":"D","text":"PET scan"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MRI","explanation":"MRI in Liver Lesions\n• MRI gas emerged as the best imaging test for liver lesion detection and characterizationQ\n• MRI provides high lesion-to-liver contrast and does not use radiationQ.\n• Liver-specific contrast media, such as mangofodipir trisodiumQ (taken up by hepatocytes) and ferrumoxides\n(taken up by Kupffer cells)Q demonstrate selective uptake in the liver and are primarily used for lesion detection.\n• These two contrast agents are also useful in characterizing specific liver tumors, such as FNH, hepatic adenoma\nand HCCQ.\n70 MCQs · questions on PDF pp. 255–258 · answers and explanations on PDF pp. 259–264\nAnswer (book): Answer: A. MRI\nReference: Shackelford 8/e p1545, 7/e p1560, 1571"},{"n":1,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"Which of the following is not associated with left sided portal hypertension? (COMEDK 2006)","options":[{"letter":"A","text":"Secondary to pancreatic inflammation or neoplasm"},{"letter":"B","text":"Normal superior mesenteric and portal venous pressure"},{"letter":"C","text":"Easily reversed by splenectomy"},{"letter":"D","text":"Isolated esophageal varices present"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Isolated esophageal varices present","explanation":"d. Isolated esophageal varices present (Ref: Sabiston 20/e p1436-1437; Schwartz 10/e p1281; Harrison 20/e p2411, 19/e p2063)"},{"n":2,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"Normal portal vein pressure is: (Recent Question 2016, COMEDK 2008)","options":[{"letter":"A","text":"< 3 mm Hg"},{"letter":"B","text":"3–5 mm Hg"},{"letter":"C","text":"5–10 mm Hg"},{"letter":"D","text":"10–12 mm Hg"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"5–10 mm Hg","explanation":"c. 5–10 mm Hg (Ref: Sabiston 20/e p1436-1437; Schwartz 10/e p1280-1281; Harrison 20/e p2410, 19/e p2062)"},{"n":3,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"Which of the following causes minimal porto-hepatic compromise? (JIPMER GIS 2011)","options":[{"letter":"A","text":"Non-selective shunts"},{"letter":"B","text":"TIPSS"},{"letter":"C","text":"Distal splenorenal shunt"},{"letter":"D","text":"Sclerotherapy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Sclerotherapy","explanation":"d. Sclerotherapy"},{"n":4,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"Most common metabolic disturbance of cirrhosis is: (ILBS 2012, JIPMER GIS 2011)","options":[{"letter":"A","text":"Metabolic acidosis"},{"letter":"B","text":"Metabolic alkalosis"},{"letter":"C","text":"Respiratory acidosis"},{"letter":"D","text":"Respiratory alkalosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Metabolic alkalosis","explanation":"Electrolyte Abnormalities in Cirrhosis\n• Hyponatremia, hypokalemia and metabolic alkalosisQ (↓PNH)\nAnswer (book): Answer: B. Metabolic alkalosis\nReference: Sabiston 20/e p565; Harrison 20/e p2410, 19/e p2064"},{"n":5,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"All are true about hepatopulmonary syndrome except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Frequency in ESLD is between 8–29%"},{"letter":"B","text":"Characterized by hypoxemia and anatomical shunting of blood"},{"letter":"C","text":"Only established treatment at present is OLT"},{"letter":"D","text":"A pre-operative oxygen tension of < 30 mmHg alone is a predictor of disease"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"A preoperative oxygen tension of < 30 mm Hg alone is a predictor of disease","explanation":"Severity in HPS depends upon liver disease, oxygenation defect and pulmonary vascular dilatationQ.\nAnswer (book): Answer: D. A preoperative oxygen tension of < 30 mm Hg alone is a predictor of disease\nReference: Shackelford 8/e p1588, 7/e p1606-1608; Sabiston 20/e p639"},{"n":6,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"Metabolic complication of cirrhosis are all except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Hypokalemia"},{"letter":"B","text":"Hyponatremia"},{"letter":"C","text":"Hypoglycemia"},{"letter":"D","text":"Hypoammonemia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypoammonemia","explanation":"• In cirrhosis, there is hyperammonemia.\nAnswer (book): Answer: D. Hypoammonemia"},{"n":7,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 259","pdfPage":255,"stem":"In a patient with compensated liver cirrhosis presented with history of variceal bleed. The treatment of choice in this patient is: (AIIMS June 2002)","options":[{"letter":"A","text":"Propranolol"},{"letter":"B","text":"Liver transplantation"},{"letter":"C","text":"TIPS (Transjugular intrahepatic portal shunt)"},{"letter":"D","text":"Endoscopic sclerotherapy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Endoscopic sclerotherapy","explanation":"20/e p2411, 19/e p2064\nManagement of Variceal Bleeding\nVariceal Bleeding\n• In addition to pharmacologic therapy endoscopy should be carried out as soon as possible\n• If varices are found they are treated with either endoscopic variceal ligation or sclerotherapyQ.\n• EVL is the treatment of choice for variceal bleedingQ.\nAnswer (book): Answer: D. Endoscopic sclerotherapy\nReference: Sabiston 20/e p1444; Blumgart 6/e p1201, 5/e p1129-1134; Shackelford 8/e p1582, 7/e p1597, 1599-1601; Harrison"},{"n":8,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Left sided portal hypertension is best treated by: (Recent Question 2016, AIIMS June 2001)","options":[{"letter":"A","text":"Splenectomy"},{"letter":"B","text":"Portocaval shunt"},{"letter":"C","text":"Lieno-renal shunt"},{"letter":"D","text":"Spleno-renal shunt"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Splenectomy","explanation":"a. Splenectomy"},{"n":9,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Portal hypertension following portal vein thrombosis are guided by: (PGI Dec 2003)","options":[{"letter":"A","text":"↑ in splenic pulp pressure"},{"letter":"B","text":"↑ in portal vein pressure"},{"letter":"C","text":"↑ in hepatic vein pressure"},{"letter":"D","text":"Portal vein Doppler study"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"↑ in splenic pulp pressure, B. ↑ in portal vein pressure, D. Portal vein Doppler study","explanation":"• Splenic pulp pressure gives a measure of the portal vein pressure; it can be measured by inserting a needle\npercutaneouslyQ.\n• Portal vein Doppler study is the most useful non-invasive investigation for assessing thrombosis of the main\nportal vein branchesQ.\nAnswer (book): Answer: A. ↑ in splenic pulp pressure, B. ↑ in portal vein pressure, D. Portal vein Doppler study"},{"n":10,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Child criteria include all except: (PGI May 2011)","options":[{"letter":"A","text":"Nutritional status"},{"letter":"B","text":"S. Bilirubin"},{"letter":"C","text":"S. Creatinine"},{"letter":"D","text":"Acid phosphate"},{"letter":"E","text":"Ascites"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nutritional status, C. S. Creatinine, D. Acid phosphate","explanation":"a. Nutritional status, c. S. Creatinine, d. Acid phosphate  (Ref: Sabiston 20/e p1436; Schwartz 10/e p1280; Harrison 20/e p2416,\n19/e 1995)"},{"n":11,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Child-Pugh criteria does not include: (Punjab 2010)","options":[{"letter":"A","text":"Encephalopathy"},{"letter":"B","text":"ALT"},{"letter":"C","text":"Ascites"},{"letter":"D","text":"Albumin"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ALT","explanation":"b. ALT"},{"n":12,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"According to Child-Pugh staging, child’s B is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"5–6"},{"letter":"B","text":"7–9"},{"letter":"C","text":"10–11"},{"letter":"D","text":"9–12"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"7–9","explanation":"b. 7–9"},{"n":13,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"According to Pughs classification moderate to severe hepatic insufficiency is managed by: (AIIMS Nov 2000)","options":[{"letter":"A","text":"Sclerotherapy"},{"letter":"B","text":"Conservative"},{"letter":"C","text":"Orthotopic liver transplantation"},{"letter":"D","text":"Shunt surgery"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Orthotopic liver transplantation","explanation":"• Patient of cirrhosis with variceal bleeding or ascites can be controlled by shunt surgery only if he falls in CTP class\nA or B.\n• Moderate to severe grade liver insufficiency can only be managed by liver transplantationQ.\nAnswer (book): Answer: C. Orthotopic liver transplantation"},{"n":14,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"The Sengstaken tube must maintain a pressure of ...... to stop bleeding from varices:","options":[{"letter":"A","text":"20 mm Hg"},{"letter":"B","text":"25 mm Hg"},{"letter":"C","text":"35 mm Hg"},{"letter":"D","text":"45 mm Hg"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"35 mm Hg","explanation":"• If bleeding does not stop promptly, the gastric balloon may be inflated to at least a volume of 300 mL, or the\nesophageal balloon may be inflated to a pressure of 40 mm HgQ.\nAnswer (book): Answer: C. 35 mm Hg\nReference: Sabiston 20/e p1438; Schwartz 9/e p1113; Blumgart 6/e p1172, 5/e p1136-1137; Harrison 20/e p2411, 19/e p2063"},{"n":15,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Drug induced portal hypertension is seen with:","options":[{"letter":"A","text":"Vitamin A toxicity"},{"letter":"B","text":"Methotrexate"},{"letter":"C","text":"Aldomet"},{"letter":"D","text":"Hydatid cyst"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Vitamin A toxicity","explanation":"Vitamin A Induced Hepatotoxicity\n• Normal doses of vitamin A are not associated with liver injury or liver test abnormalities, but higher doses can be\ntoxicQ. Mechanism of Injury\n• Excess vitamin A is stored in stellate cellsQ in the liver and accumulation can lead to their activation and\nhypertrophy, excess collagen production, fibrosisQ and liver injury.\n• Serum bilirubin is typically only mildly elevatedQ.\n• Liver biopsy is diagnosticQ\nAnswer (book): Answer: A. Vitamin A toxicity\nReference: livertox.nlm.nih.gov"},{"n":16,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"In Child’s criteria partial encephalopathy, bilirubin 2.5 mg/dL albumin 3 gm/dl, controlled ascites indicates: (PGI 96)","options":[{"letter":"A","text":"Grade A"},{"letter":"B","text":"Grade B"},{"letter":"C","text":"Grade C"},{"letter":"D","text":"More information needed"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Grade B, D. More information needed","explanation":"b. Grade B, d. More information needed"},{"n":17,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"Which one of the following is not a treatment of gastroesophageal variceal hemorrhage? (UPSC 2001)","options":[{"letter":"A","text":"Sclerotherapy"},{"letter":"B","text":"Sengstaken tube"},{"letter":"C","text":"Transjugular intrahepatic portacaval shunt"},{"letter":"D","text":"Gastric freezing"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Gastric freezing","explanation":"d. Gastric freezing"},{"n":18,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 260","pdfPage":255,"stem":"In portal hypertension the sites of portosystemic anastomosis includes: (DPG 2010)","options":[{"letter":"A","text":"Lower end of esophagus"},{"letter":"B","text":"Around umbilicus"},{"letter":"C","text":"Lower third of rectum and anal canal"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"In portal hypertension the sites of portosystemic anastomosis includes lower end of esophagus, around\numbilicus, lower third of rectum and anal canal, posterior abdominal wall, bare area of liver. Porto-Systemic\nAnastomosis\nLocation | Portal Component | Systemic Component | Esophagus (lower end) Esophageal varices | Left gastric vein |\nAzygous vein and accessory hemiazygous vein | Rectum and anal Canal Hemorrhoids | Superior rectal veinQ |\nMiddle and inferior rectal veinQ | Umbilicus Caput medusa\nLeft branch of portal vein (paraumblical branches)\nSuperficial (superior and inferior) epigastric veinsQ\nPosterior abdominal wall\nColic and omental veinsQ\nRetroperitoneal veinsQ of abdominal wall, renal capsule, splenic and hepatic flexure\nBare area of liver\nHepatic venulesQ Right branch of portal vein\nPhrenic and intercostal veins Retroperitoneal veins draining into lumbar, azygous and hemiazygous veins\nLiver (rarely)\nPatent ductus venosusQ Left branch of portal vein\nInferior vena cava | Q | Q\nAnswer (book): Answer: D. All of the above\nReference: Sabiston 20/e p1437"},{"n":19,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 261","pdfPage":255,"stem":"A 50-year-old male presented with history of hematemesis-500 mL of blood and on examination shows BP-90/60, PR- 110/min and splenomegaly 5cm below lower costal margin. Most probable diagnosis is: (All India 2012, AIIMS Nov 2006)","options":[{"letter":"A","text":"Mallory-Weiss tear"},{"letter":"B","text":"Duodenal ulcer"},{"letter":"C","text":"Gastritis"},{"letter":"D","text":"Portal hypertension"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Portal hypertension","explanation":"(80%)Q | Portal Hypertensive Bleeding | (20%)Q | Peptic ulcer disease (MC)Q | 30–50%Q |\nGastroesophageal varicesQ | >90%Q | Mallory-Weiss tears | 15–20% | Hypertensive portal gastropathy | <5% |\nGastritis or duodenitis | 10–15% | Isolated gastric varices | Rare | Esophagitis | 5–10% | Arteriovenous malformations |\n5% | Tumors | 2% | Other | 5%\nCommon Causes of Upper Gastrointestinal Hemorrhage Non-variceal Bleeding\n• Splenomegaly and massive bleeding leading to hypotension are in favor of portal hypertensionQ.\nAnswer (book): Answer: D. Portal hypertension\nReference: Sabiston 20/e p1142"},{"n":20,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 261","pdfPage":255,"stem":"MELD score doesn’t include: (Recent Question 2017, AIIMS GIS Dec 2011, Dec 2006)","options":[{"letter":"A","text":"INR"},{"letter":"B","text":"S. bilirubin"},{"letter":"C","text":"S. creatinine"},{"letter":"D","text":"Blood urea"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Blood urea","explanation":"MELD score (CBI) | Creatinine, Bilirubin, INRQ | PELD score (NABIA)\nNutritional status, Age, Bilirubin, INR, AlbuminQ\nAnswer (book): Answer: D. Blood urea\nReference: Sabiston 20/e p640; Schwartz 10/e p1280; Harrison 20/e p2416, 19/e p2069"},{"n":21,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 261","pdfPage":255,"stem":"A 40-year-old male presented with hematemesis. On examination his BP was 90/60 mm Hg and heart rate was 120/ min. Splenomegaly was also present. The most probable cause of his bleeding is: (AIIMS May 2012)","options":[{"letter":"A","text":"Portal hypertension"},{"letter":"B","text":"Gastric ulcer"},{"letter":"C","text":"Duodenal ulcer"},{"letter":"D","text":"Drug induced GI injury"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Portal hypertension","explanation":"a. Portal hypertension"},{"n":22,"chapter":"Portal Hypertension","src":"question on PDF p. 255 · answer on PDF p. 261","pdfPage":255,"stem":"Child’s Criteria is used in: (DNB 2005, 2001, 2000)","options":[{"letter":"A","text":"Pancreatitis"},{"letter":"B","text":"Cirrhosis"},{"letter":"C","text":"Multiple myeloma"},{"letter":"D","text":"AIDS"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cirrhosis","explanation":"b. Cirrhosis"},{"n":23,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"Child-Pugh score is used for: (Recent Question 2017)","options":[{"letter":"A","text":"Hepatic encephalopathy"},{"letter":"B","text":"Uremic encephalopathy"},{"letter":"C","text":"Chronic liver disease"},{"letter":"D","text":"Head injury"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Chronic liver disease","explanation":"c. Chronic liver disease (Ref: Sabiston 20/e p1436; Schwartz 10/e p1280; Bailey 27/e p1156)"},{"n":24,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"All of the following are true in case of chronic liver disease except: (Recent Question 2019)","options":[{"letter":"A","text":"MELD score is used frequently to see whom needs liver transplant early"},{"letter":"B","text":"MELD score includes serum albumin, creatinine, and INR"},{"letter":"C","text":"Child Pugh score includes PT-INR, albumin and bilirubin"},{"letter":"D","text":"Child Pugh score has class A, B, C"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"MELD score includes serum albumin, creatinine, and INR","explanation":"b. MELD score includes serum albumin, creatinine, and"},{"n":25,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"Worm-like filling defect is seen in: (MHCET 2016, COMEDK 2005)","options":[{"letter":"A","text":"Erosive gastritis"},{"letter":"B","text":"Esophageal varices"},{"letter":"C","text":"CA esophagus"},{"letter":"D","text":"Schatzki’s ring"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Esophageal varices","explanation":"• On USG:\n– Thickened sinus, interrupted mucosal folds (earliest sign)Q\n– Tortuous radiolucencies of variable size\n– The “worm-eaten” smooth lobulated filling defectsQ\nAnswer (book): Answer: B. Esophageal varices\nReference: Wolfgang Radiology 2/e p509"},{"n":26,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"What is the most probable diagnosis on the basis of given endoscopy image? (Recent Question 2016)","options":[{"letter":"A","text":"GAVE"},{"letter":"B","text":"Schatzki ring"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"Esophageal varices"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Esophageal varices","explanation":"Esophageal Varices\n• Most significant clinical finding associated with PHT is development of GE varicesQ.\n• Major blood supply to GE varices is anterior branch of left gastric or coronary veinQ.\n• Variceal bleeding is leading cause of morbidity and mortality associated with PHTQ\n• Approximately 30% of patients with compensated cirrhosis and 60% of patients with decompensated cirrhosis\nhave esophageal varicesQ.\nImage-based question: the picture / video this question refers to is on PDF p. 256 of the source and is not reproduced here.\nAnswer (book): Answer: D. Esophageal varices\nReference: Sabiston 20/e p1437; Schwartz 10/e p1281; Bailey 27/e p1126; Harrison 20/e p2411, 19/e p1890"},{"n":27,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"Which one of the following treatment modalities is not used for management of acute blood loss due to ruptured esophageal varices? (UPSC 2004)","options":[{"letter":"A","text":"Endoscopic sclerotherapy"},{"letter":"B","text":"Endoscopic band ligation"},{"letter":"C","text":"Octreotide"},{"letter":"D","text":"Propranolol"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Propranolol","explanation":"d. Propranolol (Ref: Sabiston 20/e p1437-1440; Blumgart 6/e p1200, 5/e p1129-1146; Shackelford 8/e p1581, 7/e p1599-1604; Harrison 20/e\np2411, 19/e p2063-2064)"},{"n":28,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 261","pdfPage":256,"stem":"On barium swallow the grade IV esophageal varices appear as: (AIIMS June 2001)","options":[{"letter":"A","text":"Mucosal folds above the carina"},{"letter":"B","text":"Mucosal folds below the carina"},{"letter":"C","text":"Mucosal folds at the carina"},{"letter":"D","text":"A thick band"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mucosal folds below the carina","explanation":"• Esophageal varices presents as serpiginous filling defectsQ (arrows) in the esophagus below the level of the\ncarinaQ. Radiological Grading of Varices Grade I\nStraight varices seen only on inspiration\nGrade II\nStraight varices seen in all phases of respiration\nGrade III | Tortuous varices in lower half of esophagus | Grade IV | Tortuous varices in entire esophagus |\nEsophageal Varices\nAnswer (book): Answer: B. Mucosal folds below the carina\nReference: Surgical Diseases in Tropical countries/130"},{"n":29,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Best test for esophageal varices is: (UPPG 2009)","options":[{"letter":"A","text":"CT-scan"},{"letter":"B","text":"Gastro-esophagoscopy"},{"letter":"C","text":"Tomography"},{"letter":"D","text":"Ultrasound"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gastro-esophagoscopy","explanation":"• The balloons should be temporarily deflated after 12 hoursQ to prevent pressure necrosis of the esophagus.\nSengstaken-Blakemore Tube\n• If the rate of blood loss prohibits endoscopic evaluation, a Sengstaken–Blakemore tube may be inserted to\nprovide temporary hemostasisQ.\n• Once inserted, the gastric balloon is inflated with 300 mL of airQ and retracted to the gastric fundus, where the\nvarices at the esophagogastric junction are tamponaded by the subsequent inflation of the esophageal balloon to\na pressure of 40 mmHgQ.\n• The two remaining channels allow gastric and esophageal aspirationQ.\n• A radiograph is used to confirm the position of the tubeQ.\n• The balloons should be temporarily deflated after 12 hours to prevent pressure necrosis of the esophagusQ.\nAnswer (book): Answer: B. Gastro-esophagoscopy"},{"n":30,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"The balloons of Sengstaken-Blakemore tube should be temporarily deflated after how many hours to prevent pre-necrosis of the oesophagus? (MHSSMCET 2011)","options":[{"letter":"A","text":"12 hours"},{"letter":"B","text":"24 hours"},{"letter":"C","text":"36 hours"},{"letter":"D","text":"48 hours"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"12 hours","explanation":"a. 12 hours (Ref: Bailey 27/e p1164)\n•\t The balloons should be temporarily deflated after 12 hoursQ to prevent pressure necrosis of the esophagus.\n\nsengstaken-blakemore tube\n•\t If the rate of blood loss prohibits endoscopic evaluation, a Sengstaken–Blakemore tube may be inserted to provide temporary\nhemostasisQ.\n•\t Once inserted, the gastric balloon is inflated with 300 mL of airQ and retracted to the gastric fundus, where the varices at the\nesophagogastric junction are tamponaded by the subsequent inflation of the esophageal balloon to a pressure of 40 mmHgQ.\n•\t The two remaining channels allow gastric and esophageal aspirationQ.\n•\t A radiograph is used to confirm the position of the tubeQ.\n•\t The balloons should be temporarily deflated after 12 hours to prevent pressure necrosis of the esophagusQ."},{"n":31,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"To stop variceal bleeding pressure in Sengstaken B lackmore tube should be: (MHSSMCET 2007)","options":[{"letter":"A","text":"40 mm"},{"letter":"B","text":"50 mm"},{"letter":"C","text":"60 mm"},{"letter":"D","text":"70 mm"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"40 mm","explanation":"a. 40 mm"},{"n":32,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Treatment of choice for bleeding esophageal and gastric varices: (MHSSMCET 2007)","options":[{"letter":"A","text":"Injection sclerotherapy"},{"letter":"B","text":"Banding (Endoscopic)"},{"letter":"C","text":"Shunt surgery"},{"letter":"D","text":"Devascularization"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Banding (Endoscopic)","explanation":"20/e p2411, 19/e p2063-2064\nInjection Sclerotherapy\nEndoscopic Variceal Ligation\n• Tetradecyl sodium (1–3%), sodium morrhuate (5%), ethanolamine oleate (5%) and 3% phenol are most common\nsclerosing agentsQ.\n• A combined para and intravariceal technique is used for the management of acute variceal bleeding and a\npredominantly intravariceal technique for long term managementQ.\n• Variceal eradication is considered the end point of ESTQ\n• Variceal obliteration can be achieved in 80–95% patients with a mean of 4–6.8 sessionsQ.\n• Esophageal strictureQ is a common complication\n• For control of acute variceal bleeding EVL has been found to be as effective as ESTQ\n• Technically more difficult than ESTQ in presence of massive bleeding due to reduction in field of view\n• Variceal recurrence rate is higher in EVL since, paraoesophageal varicesQ (perforating veins) are not obliterated.\n• Not suitable for small varices (grade I, II)\n• EVL is associated with lesser complications and rebleedingQ\n• Variceal eradication in fewer sessions but higher recurrence of varicesQ.\nAnswer (book): Answer: B. Banding (Endoscopic)\nReference: Sabiston 20/e p1439; Blumgart 6/e p1201, 5/e p1135-1138; Shackelford 8/e p1581-1582, 7/e p1600-1601; Harrison"},{"n":33,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Variceal banding was invented by: (MHSSMCET 2006)","options":[{"letter":"A","text":"Borema and Crile"},{"letter":"B","text":"Stiegmann and Goff"},{"letter":"C","text":"Sugiura and Futagawa"},{"letter":"D","text":"Crafoord and Frenckner"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Stiegmann and Goff","explanation":"Van Steigmann and Goff | Endoscopic esophageal variceal ligationQ | Crile and Borema\nTransesophageal ligation of bleeding esophageal varicesQ\nSuguira and Futagawa\nEsophageal transections with paraesophago-gastric devascularization in the treatment of esophageal varicesQ\nCrafoord and Freckner\nEndoscopic sclerotherapyQ\nAnswer (book): Answer: B. Stiegmann and Goff\nReference: Bailey 24/e p1071"},{"n":34,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Which of the following agents is recommended for medical treatment of variceal bleed? (All India 2011)","options":[{"letter":"A","text":"Octreotide"},{"letter":"B","text":"Desmopressin"},{"letter":"C","text":"Vasopressin"},{"letter":"D","text":"Nitroglycerine"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Octreotide","explanation":"• Somatostatin and/or its analog octreotide are the agents of choice for medical management of variceal bleedQ.\n• Octreotide and Somatostatin have been found to be effective in achieving hemostasis and preventing early\nrebleedingQ.\n• Terlipressin is released in sustained and slow manner. It does not share several systemic side effects of\nvasopressin and may be used to control variceal bleedingQ. Drugs used in Portal Hypertension\nDrugs Decreasing portal blood flow\nDrugs decreasing intrahepatic resistance\n• Non-selective beta blockers\n• Vasopressin and Terlipressin\n• Somatostatin and Octreotide (DOC)Q\n• Nitrates\n• Alpha1-blockers (Prazosin)\n• Angiotensin receptor blockers\nAnswer (book): Answer: A. Octreotide\nReference: Harrison 20/e p2411, 19/e p2063-2064"},{"n":35,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Sclerotherapy failure is defined as: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Unresponsiveness to consecutive 2 energy sclerotherapies"},{"letter":"B","text":"Unresponsiveness to consecutive 3 energy sclerotherapies"},{"letter":"C","text":"Remnant bleeding even after sclerotherapy for successive 2 hospital admissions"},{"letter":"D","text":"Failure to heal after a single treatment"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Unresponsiveness to consecutive 2 energy sclerotherapies","explanation":"• Failure of endoscopic treatment is declared when two sessions fail to control hemorrhageQ.\nAnswer (book): Answer: A. Unresponsiveness to consecutive 2 energy sclerotherapies"},{"n":36,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 262","pdfPage":256,"stem":"Most common cause of gastric varices is: (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Splenic vein thrombosis"},{"letter":"B","text":"Splenectomy"},{"letter":"C","text":"Cirrhosis"},{"letter":"D","text":"Mesenteric thrombosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cirrhosis","explanation":"• MC cause of gastric varices: CirrhosisQ\n• MC cause of isolated gastric varices: Splenic vein thrombosisQ\nAnswer (book): Answer: C. Cirrhosis\nReference: Sabiston 20/e p1232; Schwartz 10/e p1088"},{"n":37,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"Isolated gastric varices: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Profuse bleeding"},{"letter":"B","text":"Most commonly due to splenic vein thrombosis"},{"letter":"C","text":"EUS is better than endoscopy"},{"letter":"D","text":"Single treatment can lead to eradication"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Most commonly due to splenic vein thrombosis","explanation":"b. Most commonly due to splenic vein thrombosis"},{"n":38,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"Veins involve in stomach varices are: (PGI Dec 2008)  [Multiple statements may be correct — mark all true options]","options":[{"letter":"A","text":"Coronary vein"},{"letter":"B","text":"Short gastric vein"},{"letter":"C","text":"Right gastroepiploic vein"},{"letter":"D","text":"Left gastroepiploic vein"},{"letter":"E","text":"Left gastric vein"}],"multi":["A","B","C","D","E"],"correctSet":["A","B","C","D","E"],"answerIdx":0,"answerLetter":"A, B, C, D, E","answerText":"Correct statements: A, B, C, D, E","explanation":"• Gastric varices can develop secondary to portal hypertension, in conjunction with esophageal varicesQ, or\nsecondary to sinistral hypertension from splenic vein thrombosisQ.\n• In generalized portal hypertension, the increased portal pressure is transmitted by the left gastric veinQ to\nesophageal varices and by the short and posterior gastric veinsQ to the fundic plexus and cardia veins.\n• Isolated gastric varices tend to occur secondary to splenic vein thrombosis.\n• Splenic blood flows retrograde through the short and posterior gastric veins into the varices, then hepatopetally\nthrough the coronary veinQ into the portal vein.\n• Left-to-right retrograde flow through the gastroepiploic veinQ to the superior mesenteric vein can explain the\ndevelopment of ectopic varices in the stomach.\nGastric Varices\nAnswer (book): Answer: All\nReference: Sabiston 20/e p1232"},{"n":39,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"Contraindications of TIPS: (ILBS 2012)","options":[{"letter":"A","text":"HPS"},{"letter":"B","text":"HRS"},{"letter":"C","text":"VOD"},{"letter":"D","text":"BCS"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"HPS","explanation":"a. HPS (Ref: Sabiston 20/e p1439; Schwartz 10/e p347; Blumgart 6/e p439, 5/e p1180-1188; Shackelford 8/e p1584, 7/e p1602-1603; Harrison\n20/e p2412, 19/e p2064-2065)"},{"n":40,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"False about TIPS: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Shunt thrombosis is more common than stenosis"},{"letter":"B","text":"Encephalopathy is more common"},{"letter":"C","text":"Improves ascites and hydrothorax"},{"letter":"D","text":"Much better control of bleeding than variceal ligation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Shunt thrombosis is more common than stenosis","explanation":"• Shunt stenosis is usually secondary to neointimal hyperplasia and is more common than thrombosisQ.\nAnswer (book): Answer: A. Shunt thrombosis is more common than stenosis"},{"n":41,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"TIPS means creating anastomosis between which of the following? (WB PG 2015, MHSSMCET 2009, Karnataka 2006)","options":[{"letter":"A","text":"Portal vein and hepatic artery"},{"letter":"B","text":"Portal vein and IVC"},{"letter":"C","text":"Portal vein and hepatic vein"},{"letter":"D","text":"Hepatic vein and hepatic artery"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Portal vein and hepatic vein","explanation":"c. Portal vein and hepatic vein"},{"n":42,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"TIPS is a type of: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Non-selective shunt"},{"letter":"B","text":"Selective shunt"},{"letter":"C","text":"Both selective and non-selective shunt"},{"letter":"D","text":"Systemic shunt"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Non-selective shunt","explanation":"• TIPS is a non-selective shunt, created between portal and hepatic veinQ\n• TIPS is portahepatic or intrahepatic shuntQ\nAnswer (book): Answer: A. Non-selective shunt"},{"n":43,"chapter":"Portal Hypertension","src":"question on PDF p. 256 · answer on PDF p. 263","pdfPage":256,"stem":"True about TIPS: (PGI June 98)","options":[{"letter":"A","text":"It is a type of portocaval shunt"},{"letter":"B","text":"It is intrahepatic shunt"},{"letter":"C","text":"Performed by passing endoscopes"},{"letter":"D","text":"Most suitable for patient going for liver transplant"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"It is intrahepatic shunt, D. Most suitable for patient going for liver transplant","explanation":"b. It is intrahepatic shunt, d. Most suitable for patient going for liver transplant"},{"n":44,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"TIPS is used in all except: (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Refractory ascites"},{"letter":"B","text":"BCS"},{"letter":"C","text":"Hepatopulmonary syndrome"},{"letter":"D","text":"Refractory hepatic hydrothorax"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hepatopulmonary syndrome","explanation":"c. Hepatopulmonary syndrome"},{"n":45,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Early complication of TIPS procedure: (JIPMER November 2017)","options":[{"letter":"A","text":"Shunt stenosis and blockage"},{"letter":"B","text":"Capsular haemorrhage"},{"letter":"C","text":"Metabolic encephalopathy"},{"letter":"D","text":"Recurrent variceal bleed"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Metabolic encephalopathy","explanation":"c. Metabolic encephalopathy (Ref: Schwartz 10/e p1282; Sabiston 20/e p1440; Bailey 27/e p1164)"},{"n":46,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Coronary-Caval fistula is: (ILBS 2011)","options":[{"letter":"A","text":"Inokuchi"},{"letter":"B","text":"Warren’s"},{"letter":"C","text":"Eck’s fistula"},{"letter":"D","text":"Shamik"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Inokuchi","explanation":"Inokuchi Shunt\n• Interposition of a vein graft between the left gastric (Coronary) vein and the IVCQ.\n• Also known as coronary-caval fistulaQ\n• Choice (TIPS or shunt) is based on the predicted time to transplantation:\nAnswer (book): Answer: A. Inokuchi\nReference: Sabiston 20/e p1440; Shackelford 8/e p1575, 7/e p1603-1604"},{"n":47,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Mesocaval shunt what incision approach is used? (MHSSMCET 2009)","options":[{"letter":"A","text":"Midline"},{"letter":"B","text":"Paramedian"},{"letter":"C","text":"Subcoastal"},{"letter":"D","text":"Chevron"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Midline","explanation":"Mesocaval Shunt\n• A mesocaval shunt can be performed through either a bilateral subcostal or midline incision.\n• Midline incision is preferredQ.\nAnswer (book): Answer: A. Midline\nReference: Mastery of Surgery 2007/1352; Atlas of GI Surgery by John L. Cameron 2007/194"},{"n":48,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Which is a non-selective shunt? (AIIMS GIS May 2008)","options":[{"letter":"A","text":"DSRS"},{"letter":"B","text":"Inokuchi shunt"},{"letter":"C","text":"12 mm interposition shunt"},{"letter":"D","text":"8 mm interposition shunt"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"12 mm interposition shunt","explanation":"c. 12 mm interposition shunt"},{"n":49,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"What is the type of this shunt?","options":[{"letter":"A","text":"Non-selective shunt"},{"letter":"B","text":"Selective shunt"},{"letter":"C","text":"Partial shunt"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Selective shunt","explanation":"The given shunt is distal splenorenal shunt, which is a selective shunt.\nAnswer (book): Answer: B. Selective shunt\nReference: Sabiston 20/e p1442; Schwartz 10/e p1283"},{"n":50,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"For bleeding varices of the esophagus, the common operation operations is/are:","options":[{"letter":"A","text":"Portocaval shunt"},{"letter":"B","text":"Gastrectomy"},{"letter":"C","text":"Splenectomy"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Portocaval shunt","explanation":"a. Portocaval shunt"},{"n":51,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Prognosis of portocaval shunt depends on all except: (AIIMS Sept 96)","options":[{"letter":"A","text":"Serum bilirubin"},{"letter":"B","text":"Serum albumin"},{"letter":"C","text":"Refractory ascitis"},{"letter":"D","text":"Type of shunt"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Type of shunt","explanation":"• Prognosis of portacaval shunt depend on Child’s criteria (Bilirubin, albumin, ascites, PT, encephalopathy)Q.\nAnswer (book): Answer: D. Type of shunt"},{"n":52,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Contraindications of portal systemic shunting include:","options":[{"letter":"A","text":"Serum albumin less than 3 mg%"},{"letter":"B","text":"Massive ascites"},{"letter":"C","text":"Significant jaundice"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Porto-systemic shunting is avoided in CTP class C. All the options belong to Class C.\nAnswer (book): Answer: D. All of the above"},{"n":53,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"Denver shunt is used in: (DNB 2012)","options":[{"letter":"A","text":"Ascites"},{"letter":"B","text":"Dialysis"},{"letter":"C","text":"Raised ICT"},{"letter":"D","text":"Raised IOP"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ascites","explanation":"a. Ascites (Ref: Textbook of Hepatology by Erwin Kuntz/317)"},{"n":54,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 263","pdfPage":257,"stem":"The Le-Veen shunt in ascites is done between peritoneum and: (Recent Question 2016, AIIMS November 2014)","options":[{"letter":"A","text":"Cisterna chyli"},{"letter":"B","text":"Renal pelvis"},{"letter":"C","text":"Superior vena cava"},{"letter":"D","text":"Gall bladder"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Superior vena cava","explanation":"The Le-Veen shunt in ascites is done between peritoneum and superior vena cava.\n“The Le-Veen shunt is designed for the relief of ascites due to chronic liver disease. One end of the silastic tube is\ninserted into the ascites within the peritoneal cavity and the other end is tunneled subcutaneously to the neck,\nwhere it is inserted under direct vision into the internal jugular vein and fed into the SVC.”- Bailey 26/e p1077\nAnswer (book): Answer: C. Superior vena cava\nReference: Bailey 26/e p1077; Textbook of Hepatology by Erwin Kuntz/317"},{"n":55,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"The operation that precipitates portosystemic encephalopathy is: (MAHE 2005)","options":[{"letter":"A","text":"Splenorenal shunt"},{"letter":"B","text":"Suguira operation"},{"letter":"C","text":"Talmal-marison operation"},{"letter":"D","text":"Portacaval anastomosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Portacaval anastomosis","explanation":"d. Portacaval anastomosis (Ref: Blumgart 5/e p1110; Harrison 20/e p2420, 19/e p 2066, 1773)"},{"n":56,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"Which of the following is a selective shunt? (Recent Question 2017)","options":[{"letter":"A","text":"Proximal splenorenal shunt"},{"letter":"B","text":"Warren shunt"},{"letter":"C","text":"Side-to-side portocaval shunt"},{"letter":"D","text":"Mesocaval shunt"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Warren shunt","explanation":"b. Warren shunt (Ref: Sabiston 20/e p1442; Schwartz 10/e p1283)"},{"n":57,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"A 20-year-old male presented with repeated episodes of hematemesis. There is no history of jaundice or liver decompensation. On examination the significant findings include splenomegaly (8 cms below costal margin), and presence of esophageal varices. There is no ascites or peptic ulceration. The liver function tests are normal. The most likely diagnosis is: (AIIMS Nov 2004)","options":[{"letter":"A","text":"Extrahepatic portal venous obstruction"},{"letter":"B","text":"Non-cirrhotic portal fibrosis"},{"letter":"C","text":"Cirrhosis"},{"letter":"D","text":"Hepatic venous outflow tract obstruction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Non-cirrhotic portal fibrosis","explanation":"b. Non-cirrhotic portal fibrosis (Ref: Blumgart 6/e p1216, 5/e p1099-1105)"},{"n":58,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"A 12-year-old boy presents with hematemesis, melena and mild splenomegaly. There is no obvious jaundice or ascites. The most likely diagnosis is: (All India 2011)","options":[{"letter":"A","text":"EHPVO"},{"letter":"B","text":"NCPF"},{"letter":"C","text":"Cirrhosis"},{"letter":"D","text":"Malaria with DIC"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"EHPVO","explanation":"a. EHPVO (Ref: Blumgart 6/e p1216, 5/e p1099-1105)"},{"n":59,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"Treatment of choice for extrahepatic portal thrombosis: (MHSSMCET 2009)","options":[{"letter":"A","text":"Mesocaval shunt"},{"letter":"B","text":"Porto caval shunt"},{"letter":"C","text":"Mesorenal shunt"},{"letter":"D","text":"Splenorenal shunt"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"> d. Mesocaval shunt > Splenorenal shunt","explanation":"• Since obstruction is in the portal vein, to bypass the obstruction the shunt should be preferably Rex shunt\n(mesenterico-left portal shunt)Q or a mesocaval shunt.\n• Splenorenal shunt is also done in EHPVO but in 50% of patients of EHPVO, splenic vein is thrombosed, not\navailable for splenorenal shuntQ.\nAnswer (book): Answer: A. > d. Mesocaval shunt > Splenorenal shunt"},{"n":60,"chapter":"Portal Hypertension","src":"question on PDF p. 257 · answer on PDF p. 264","pdfPage":257,"stem":"This shunt is used in which condition?","options":[{"letter":"A","text":"NCPF"},{"letter":"B","text":"EHPVO"},{"letter":"C","text":"Budd-Chiari syndrome"},{"letter":"D","text":"Veno-occlusive disease"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"EHPVO","explanation":"The name of the given shunt is Rex shunt (between superior mesenteric vein and left branch of portal\nvein). This is used for EHPVO.\n“In the subset of patient with EHPVO, PHT, and recurrent variceal bleeding, the treatment of choice is the meso-Rex\nbypass (MRB).” -Fundamentals of Pediatric Surgery by Peter Mattei 2/e p655\nAnswer (book): Answer: B. EHPVO\nReference: Fundamentals of Pediatric Surgery by Peter Mattei 2/e p655"},{"n":61,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Which of the following is the most common presenting symptom of non-cirrhotic portal hypertension? (All India 2006)","options":[{"letter":"A","text":"Chronic liver disease"},{"letter":"B","text":"Ascites"},{"letter":"C","text":"Upper gastrointestinal bleeding"},{"letter":"D","text":"Encephalopathy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Upper gastrointestinal bleeding","explanation":"c. Upper gastrointestinal bleeding (Ref: Blumgart 6/e p1216, 5/e p1088)"},{"n":62,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"NCPF is due to: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Extrahepatic obstruction"},{"letter":"B","text":"Intrahepatic pre-sinusoidal obstruction"},{"letter":"C","text":"Intrahepatic sinusoidal obstruction"},{"letter":"D","text":"Intrahepatic post-sinusoidal obstruction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Intrahepatic pre-sinusoidal obstruction","explanation":"b. Intrahepatic pre-sinusoidal obstruction"},{"n":63,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"True about Budd-Chiari syndrome is the following except: (MHPGMET 2005)","options":[{"letter":"A","text":"Can occur due to web in IVC"},{"letter":"B","text":"Thrombosis of hepatic veins"},{"letter":"C","text":"Causes prehepatic portal hypertension"},{"letter":"D","text":"Intractable ascites"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Causes prehepatic portal hypertension","explanation":"c. Causes prehepatic portal hypertension  (Ref: Schwartz 10/e p1283-1284; Bailey 27/e p1166; Blumgart 6/e p1248, 5/e p1189-1198;\nShackelford 8/e p1521, 7/e p1547-1548)"},{"n":64,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"The obstruction of two or more major hepatic veins is seen in: (MHCET 2016)","options":[{"letter":"A","text":"Budd-Chiari syndrome"},{"letter":"B","text":"Reye’s syndrome"},{"letter":"C","text":"Rotor syndrome"},{"letter":"D","text":"Crigler-Najjar syndrome"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Budd-Chiari syndrome","explanation":"a. Budd-Chiari syndrome"},{"n":65,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Budd-Chiari syndrome is due to thrombosis of: (Orissa 2011)","options":[{"letter":"A","text":"Infra renal IVC"},{"letter":"B","text":"Renal part of IVC"},{"letter":"C","text":"Superior mesenteric vein thrombosis"},{"letter":"D","text":"Hepatic veins"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hepatic veins","explanation":"d. Hepatic veins"},{"n":66,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Classical triad of Budd-Chiari syndrome: (Recent Question 2016)","options":[{"letter":"A","text":"Fever, jaundice, abdominal pain"},{"letter":"B","text":"Fever, ascites, jaundice"},{"letter":"C","text":"Hepatomegaly, abdominal pain, ascites"},{"letter":"D","text":"Abdominal pain, jaundice, hepatomegaly"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hepatomegaly, abdominal pain, ascites","explanation":"c. Hepatomegaly, abdominal pain, ascites"},{"n":67,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Most commonly performed hepatobiliary shunt in Budd- Chiari syndrome: (Recent Question 2016)","options":[{"letter":"A","text":"Rex shunt"},{"letter":"B","text":"Lienorenal shunt"},{"letter":"C","text":"Mesocaval shunt"},{"letter":"D","text":"Side to side portocaval shunt"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Side to side portocaval shunt","explanation":"d. Side to side portocaval shunt"},{"n":68,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"In a patient of portal hypertension, venography was performed and the image is given below. What is the most probable diagnosis?","options":[{"letter":"A","text":"Veno-occlusive disease"},{"letter":"B","text":"NCPF"},{"letter":"C","text":"Budd Chiari syndrome"},{"letter":"D","text":"EHPVO"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Budd Chiari syndrome","explanation":"Spider web collaterals on venography are seen in Budd Chiari syndrome. Budd Chiari syndrome\nBuerger disease | Spider web collaterals on VenographyQ | Corkscrew collaterals on ArteriographyQ\nImage-based question: the picture / video this question refers to is on PDF p. 258 of the source and is not reproduced here.\nAnswer (book): Answer: C. Budd Chiari syndrome\nReference: Sabiston 20/e p1780; Schwartz 10/e p1083, 1822; Harrison 20/e p2415, 19/e p1645"},{"n":69,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Veno-occlusive disease in hepatic vein is characterized by: (PGI Dec 2007)","options":[{"letter":"A","text":"Central venous congestion"},{"letter":"B","text":"Hepatomegaly"},{"letter":"C","text":"Portal vein obstruction"},{"letter":"D","text":"Budd-Chiari syndrome"},{"letter":"E","text":"Hepatic fibrosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hepatomegaly, E. Hepatic fibrosis","explanation":"b. Hepatomegaly, e. Hepatic fibrosis (Ref: Blumgart 6/e p1268, 5/e p1189-1198; Shackelford 8/e p1528, 7/e p1556)"},{"n":70,"chapter":"Portal Hypertension","src":"question on PDF p. 258 · answer on PDF p. 264","pdfPage":258,"stem":"Veno-occlusive disease is seen in all except: (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Bone marrow transplant"},{"letter":"B","text":"Bush teas"},{"letter":"C","text":"Mushroom poisoning"},{"letter":"D","text":"Cytosine arabinoside"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mushroom poisoning","explanation":"c. Mushroom poisoning"},{"n":1,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"All of the following are essential for formation of gallstones except: (MHSSMCET 2008)","options":[{"letter":"A","text":"Bile stasis"},{"letter":"B","text":"Nucleation"},{"letter":"C","text":"Crystallization"},{"letter":"D","text":"Lithogenic bile"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Crystallization","explanation":"c. Crystallization (Ref: Sabiston 20/e p1492; Schwartz 10/e p1318-1319; Bailey 27/e p1198; Blumgart 6/e p551, 5/e p483-487; Shackelford 8/e\np1262, 7/e p1298-1299)"},{"n":2,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Cholesterol gallstones are made up of: (Recent Question 2019)","options":[{"letter":"A","text":"Crystalline cholesterol monohydrate"},{"letter":"B","text":"Crystalline cholesterol dihydrate"},{"letter":"C","text":"Amorphous cholesterol monohydrate"},{"letter":"D","text":"Amorphous cholesterol dihydrate"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Crystalline cholesterol monohydrate","explanation":"“There are two general classes of gallstones: cholesterol stones, containing more than 50% of\ncrystalline cholesterol monohydrate, and pigment stones composed predominantly of bilirubin calcium\nsalts.”(Robbins 9/e p876)\nAnswer (book): Answer: A. Crystalline cholesterol monohydrate\nReference: Robbins 9/e p876; Sleisenger & Fordtran 9/e p1098"},{"n":3,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"All are true about pigmented stones except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Seen in cholangiohepatitis"},{"letter":"B","text":"Secondary CBD stones"},{"letter":"C","text":"Primary CBD stones"},{"letter":"D","text":"More common in Asians"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Secondary CBD stones","explanation":"b. Secondary CBD stones (Ref: Sabiston 20/e p2078, 19/e p1485-1486; Schwartz 10/e p1318-1319; Bailey 27/e p1198; Blumgart 6/e p551-553,\n5/e p483-487)"},{"n":4,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"False about brown pigmented stones: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Associated with disorders of biliary motility and associated bacterial infection"},{"letter":"B","text":"More common in Caucasians"},{"letter":"C","text":"Soft and earthy in texture"},{"letter":"D","text":"High content of cholesterol and calcium palmitate"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"More common in Caucasians","explanation":"Brown pigment stones are common in AsiansQ, not the caucasians.\nAnswer (book): Answer: B. More common in Caucasians"},{"n":5,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Lithogenic bile has the following properties: (All India 96)","options":[{"letter":"A","text":"↑ Bile and cholesterol ratio"},{"letter":"B","text":"↓ Bile and cholesterol ratio"},{"letter":"C","text":"Equal bile and cholesterol ratio"},{"letter":"D","text":"↓ Cholesterol only"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"(↓Bile and cholesterol ratio)","explanation":"b. (↓Bile and cholesterol ratio)"},{"n":6,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Stone formation in gallbladder is enhanced by all except: (All India 96)","options":[{"letter":"A","text":"Clofibrate therapy"},{"letter":"B","text":"Ileal resection"},{"letter":"C","text":"Cholestyramine therapy"},{"letter":"D","text":"Vagal stimulation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Vagal stimulation","explanation":"• Vagal stimulation increases GB motility and prevents Gallstone formationQ.\nAnswer (book): Answer: D. Vagal stimulation\nReference: Sabiston 20/e p1491; Bailey 26/e p1107; Harrison 20/e p2424, 19/e p2077"},{"n":7,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Gallbladder stone formation is influenced by all except: (All India 98)","options":[{"letter":"A","text":"Clofibrate therapy"},{"letter":"B","text":"Hyper alimentation"},{"letter":"C","text":"Primary biliary cirrhosis"},{"letter":"D","text":"Hypercholesterolemia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypercholesterolemia","explanation":"• Hyperalimentation decreases GB motility promotes stasis and Gallstone formation.\n• Primary biliary cirrhosis decreases bile salt secretion in bile.\n• Clofibrate therapy increases biliary cholesterol.\nAnswer (book): Answer: D. Hypercholesterolemia"},{"n":8,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Incidence of gallstone is high in: (AIIMS Nov 93)","options":[{"letter":"A","text":"Partial hepatectomy"},{"letter":"B","text":"Ileal resection"},{"letter":"C","text":"Jejunal resection"},{"letter":"D","text":"Subtotal gastrectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Ileal resection","explanation":"b. Ileal resection"},{"n":9,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"True statement about gallstones are all except: (AIIMS Nov 99)","options":[{"letter":"A","text":"Lithogenic bile is required for stone formation"},{"letter":"B","text":"May be associated with carcinoma gallbladder"},{"letter":"C","text":"Associated with diabetes mellitus"},{"letter":"D","text":"More common in males between 30–40 years of age"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"More common in males between 30–40 years of age","explanation":"d. More common in males between 30–40 years of age"},{"n":10,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Which among the following does not lead to pigment gallstones? (PGI June 99)","options":[{"letter":"A","text":"TPN"},{"letter":"B","text":"Clonorchis sinensis"},{"letter":"C","text":"Hemolytic anemia"},{"letter":"D","text":"Alcoholic cirrhosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"TPN","explanation":"a. TPN"},{"n":11,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"True about gallstones: (PGI Dec 2002)","options":[{"letter":"A","text":"More common in females"},{"letter":"B","text":"Gallstones, hiatus hernia, CBD stones form Saints triad"},{"letter":"C","text":"Limey bile precipitated"},{"letter":"D","text":"Lithotripsy always done"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"More common in females","explanation":"Mixed Gallstones\n• Most common gallstones, account for 90% calculiQ\nAnswer (book): Answer: A. More common in females"},{"n":12,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"All are component of Saint’s triad except: (AIIMS Nov 95)","options":[{"letter":"A","text":"Renal stones"},{"letter":"B","text":"Hiatus hernia"},{"letter":"C","text":"Diverticulosis of colon"},{"letter":"D","text":"Gallstones"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Renal stones","explanation":"a. Renal stones"},{"n":13,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Commonest type of gallstone is: (DNB 2011)","options":[{"letter":"A","text":"Cholesterol stone"},{"letter":"B","text":"Pigment"},{"letter":"C","text":"Mixed"},{"letter":"D","text":"All are equally common"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mixed","explanation":"c. Mixed (Ref: Bailey 27/e p1198)\nmiXed gallstones\n•\t Most common gallstones, account for 90% calculiQ"},{"n":14,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Percentage of gallstones which are radiopaque: (NEET 2013, JIPMER 86)","options":[{"letter":"A","text":"10%"},{"letter":"B","text":"20%"},{"letter":"C","text":"30%"},{"letter":"D","text":"40%"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"10%","explanation":"• Most (90%) gallstones are radioluscentQ.\n• Most (90%) kidney stones are radiopaqueQ.\nAnswer (book): Answer: A. 10%"},{"n":15,"chapter":"Gallbladder","src":"question on PDF p. 276 · answer on PDF p. 284","pdfPage":276,"stem":"Which of the following statement is correct about gallstones?","options":[{"letter":"A","text":"1-Cholesterol, 2-Black, 3-Brown"},{"letter":"B","text":"1-Cholesterol, 2- Brown, 3- Black"},{"letter":"C","text":"1- Brown, 2-Black, 3- Cholesterol"},{"letter":"D","text":"1- Black, 2- Brown, 3- Cholesterol"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"1- Black, 2- Brown, 3- Cholesterol","explanation":"d. 1- Black, 2- Brown, 3- Cholesterol (Ref: Sabiston 20/e p1491-1492; Schwartz 10/e p1318-1319; Bailey 27/e p1198)"},{"n":16,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"A gallstone gets impacted most commonly in which part of common bile duct? (JIPMER 87)","options":[{"letter":"A","text":"Supraduodenal"},{"letter":"B","text":"Retroduodenal"},{"letter":"C","text":"Ampulla of Vater"},{"letter":"D","text":"Common hepatic duct"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Ampulla of Vater","explanation":"• Most gallstones pass out of the body unnoticed, but some become lodged in the common bile duct, causing\njaundiceQ.\n• A frequent site of gallstone impaction is the ampulla of VaterQ, where the common channel meets the small\nintestine.\n• Blockage of the common channel by a gallstone can induce acute pancreatitisQ.\nAnswer (book): Answer: C. Ampulla of Vater\nReference: digestive.niddk.nih.gov"},{"n":17,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"Gallstones do not contain: (Recent Question 2014)","options":[{"letter":"A","text":"Oxalate"},{"letter":"B","text":"Cholesterol"},{"letter":"C","text":"Phosphate"},{"letter":"D","text":"Carbonate"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Oxalate","explanation":"a. Oxalate"},{"n":18,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"Cholesterol gallstones are due to: (JIPMER 95)","options":[{"letter":"A","text":"Decreased motility of gallbladder"},{"letter":"B","text":"Hyposecretion of bile salts"},{"letter":"C","text":"Hypercholesterolemia"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above"},{"n":19,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"True color of cholesterol stone is: (DNB 2012)","options":[{"letter":"A","text":"Black"},{"letter":"B","text":"Brown"},{"letter":"C","text":"Dark yellow"},{"letter":"D","text":"Pale yellow"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pale yellow","explanation":"• Cholesterol stones contain almost entirely cholesterol and are often solitary, pale yellow in colorQ.\nAnswer (book): Answer: D. Pale yellow"},{"n":20,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"The predominant constituent of the pale yellow gallstones in the gallbladder is: (COMEDK 2007)","options":[{"letter":"A","text":"Mucin glycoprotein"},{"letter":"B","text":"Calcium carbonate"},{"letter":"C","text":"Cholesterol"},{"letter":"D","text":"Calcium phosphate"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cholesterol","explanation":"c. Cholesterol\n•\t Cholesterol stones contain almost entirely cholesterol and are often solitary, pale yellow in colorQ."},{"n":21,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"Most common type of gallstone in India is: (MCI March 2009)","options":[{"letter":"A","text":"Cholesterol"},{"letter":"B","text":"Pigment"},{"letter":"C","text":"Mixed"},{"letter":"D","text":"Both A and C"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pigment","explanation":"• In the USA and Europe, 80% are cholesterol or mixed stones, whereas in Asia, 80% are pigment stonesQ.\n• MC gallstone: Mixed (90%)Q\n• MC gallstones in USA and Europe: Cholesterol stonesQ (Mixed, if given in the option)\n• MC gallstones in India (Asia): Pigment stones (80%)Q\nAnswer (book): Answer: B. Pigment\nReference: Bailey 27/e p1198"},{"n":22,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 284","pdfPage":277,"stem":"Calculous cholecystitis is associated with all of the following except: (MCI March 2005)","options":[{"letter":"A","text":"Oral contraceptives"},{"letter":"B","text":"Estrogen"},{"letter":"C","text":"Obesity"},{"letter":"D","text":"Diabetes"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Diabetes","explanation":"d. Diabetes\nExplanations"},{"n":23,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"Which is true about gallstones? (Punjab 2010)","options":[{"letter":"A","text":"Pigment stones are most common"},{"letter":"B","text":"Bacterial nidus of infection may be seen"},{"letter":"C","text":"Even if asymptomatic gallbladder should be removed"},{"letter":"D","text":"They are mostly solitary"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bacterial nidus of infection may be seen","explanation":"b. Bacterial nidus of infection may be seen (Ref: www.ncbi.nlm.nih.gov/pubmed/2213913)\n•\t Recently, bacterial infection has been shown to play the role in pathogenesis of gallstone , this adds to the growing pool of\nstudies finding an infectious nidus in these gallstonesQ."},{"n":24,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"By definition pigment stone contain how much % of cholesterol? (MHSSMCET 2005)","options":[{"letter":"A","text":"<10"},{"letter":"B","text":"<20"},{"letter":"C","text":"<30"},{"letter":"D","text":"<60"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"<30","explanation":"• Pigment stone is the name used for stones containing <30% cholesterolQ.\nLocation Major constituent Consistency % Radiopaque\nClassification of Gallstones Cholesterol Black pigment Gallbladder and bile duct Gallbladder and bile duct\nCholesterol Bilirubin pigment polymerQ Crystalline with nucleus HardQ 15% 60%Q\nBrown pigment Bile ductsQ Calcium bilirubinateQ Soft, friableQ 0%Q\n• Recently, bacterial infection has been shown to play the role in pathogenesis of gallstone, this adds to the\ngrowing pool of studies finding an infectious nidus in these gallstonesQ.\nAnswer (book): Answer: C. <30\nReference: Bailey 26/e p1106"},{"n":25,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"80% of gallstones contain: (Recent Question 2015)","options":[{"letter":"A","text":"Bile pigments"},{"letter":"B","text":"Cholesterol"},{"letter":"C","text":"Calcium salts"},{"letter":"D","text":"Phospholipids"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cholesterol","explanation":"b. Cholesterol\nGALLSTONES: INVESTIGATIONS"},{"n":26,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"Investigation of choice in acute cholecystitis: (PGI Dec 2005)","options":[{"letter":"A","text":"OCG"},{"letter":"B","text":"HIDA scan"},{"letter":"C","text":"USG"},{"letter":"D","text":"CT"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"USG","explanation":"• IOC for acute cholecystitis: USGQ\n• Gold standard for diagnosis of acute cholecystitis: HIDA scanQ\n• USG is IOC for acute calculous cholecystitis, chronic cholecystitis and cholelithiasisQ.\nAnswer (book): Answer: C. USG\nReference: Sabiston 20/e p1493; Schwartz 10/e p1319; Bailey 27/e p1199; Shackelford 8/e p1269-1270, 7/e p1303, 1306"},{"n":27,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"The given image is suggestive of:","options":[{"letter":"A","text":"Gallstone"},{"letter":"B","text":"Renal stone"},{"letter":"C","text":"Ureteric stone"},{"letter":"D","text":"Pancreatic stone"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gallstone","explanation":"“Stones can also become trapped in the neck of the gallbladder or cystic duct. Although infrequently\nseen, a characteristic finding of gallstones is the “Mercedes Benz” sign. Stellate radiolucencies reflecting gas\ncontaining fissures or faults within the gallstone produce a triradiate pattern similar to that of the German automobile\ntrademark.” (Gastrointestinal Radiology By Ronald L. Eisenberg 4/e p785)\nImage-based question: the picture / video this question refers to is on PDF p. 277 of the source and is not reproduced here.\nAnswer (book): Answer: A. Gallstone\nReference: Gastrointestinal Radiology By Ronald L. Eisenberg 4/e p785"},{"n":28,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"Mercedes Benz sign or Seagull sign is seen in: (Recent Quetion 2015 MHSSMCET 2006)","options":[{"letter":"A","text":"Gallstones"},{"letter":"B","text":"Renal stones"},{"letter":"C","text":"CBD stones"},{"letter":"D","text":"Hydatid cyst"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gallstones","explanation":"a. Gallstones (Ref: Bailey 27/e p1199)"},{"n":29,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"Which is not required for visualization of gallbladder in oral cholecystograph? (AIIMS Nov 95, All India 97)","options":[{"letter":"A","text":"Functioning liver"},{"letter":"B","text":"Motor mechanisms of gallbladder"},{"letter":"C","text":"Patency of cystic duct"},{"letter":"D","text":"Ability to absorb water"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Motor mechanisms of gallbladder","explanation":"• Motor mechanism of GB is a requirement for medical treatment of gallstones, not for oral cholecystography.\nAnswer (book): Answer: B. Motor mechanisms of gallbladder\nReference: Schwartz 9/e p1141; Bailey 27/e p1200"},{"n":30,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 285","pdfPage":277,"stem":"What is the diagnosis based on the given HIDA-scan?","options":[{"letter":"A","text":"Chronic cholecystitis"},{"letter":"B","text":"Mucocele"},{"letter":"C","text":"Acute cholecystitis"},{"letter":"D","text":"Normal scan"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Acute cholecystitis","explanation":"Non-visualization of gallbladder in hepatic scintigraphy is suggestive of acute cholecystitis.\n“Ultrasonography is the most useful radiologic test for diagnosing acute cholecystitis. It has a sensitivity and\nspecificity of 95%. In addition to being a sensitive test for documenting the presence or absence of stones, it will\nshow the thickening of the gallbladder wall and the pericholecystic fluid. Focal tenderness over the gallbladder\nwhen compressed by the sonographic probe (sonographic Murphy’s sign) also is suggestive of acute cholecystitis.\nBiliary radionuclide scanning (HIDA scan) may be of help in the atypical case. Lack of filling of the gallbladder after\n4 hours indicates an obstructed cystic duct and, in the clinical setting of acute cholecystitis, is highly sensitive and\nspecific for acute cholecystitis. A normal HIDA scan excludes acute cholecystitis.” (Schwartz 10/e p1320) Normal\nHIDA Scan Tracer in GB, in CBD & small bowel\nHIDA Scan HIDA Scan in Acute Cholecystitis Non-filling of GB, Tracer in CBD & small bowel\nIn this X-ray, triradiate fissure (Mercedes-Benz sign) is seen, which is present in gallstones. Triradiate fissure on\nX-ray give rise to Mercedes-Benz sign and biradiate fissure give rise to seagull sign.\nAnswer (book): Answer: C. Acute cholecystitis\nReference: Sabiston 20/e p1488; Schwartz 10/e p1315, 1320; Bailey 27/e p1192"},{"n":31,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Best investigative modality for gallbladder:","options":[{"letter":"A","text":"OCG"},{"letter":"B","text":"PTC"},{"letter":"C","text":"Ultrasound"},{"letter":"D","text":"Intravenous cholangiogram"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Ultrasound","explanation":"• USG is IOC for acute calculous cholecystitis, chronic cholecystitis and cholilithiasis.\nAnswer (book): Answer: C. Ultrasound\nReference: Sabiston 20/e p1487; Schwartz 10/e p1319; Bailey 26/e p1100; Blumgart 5/e p223; Shackelford 7/e p1303"},{"n":32,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Graham Cole test refers to:","options":[{"letter":"A","text":"Oral cholecystography"},{"letter":"B","text":"Intravenous cholangiography"},{"letter":"C","text":"Pre-operative cholangiography"},{"letter":"D","text":"Post-operative cholangiography"},{"letter":"E","text":"Tomography"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Oral cholecystography","explanation":"a. Oral cholecystography"},{"n":33,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Initial investigation of choice for biliary obstruction: (JIPMER 2013)","options":[{"letter":"A","text":"CT Abdomen"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"MRCP"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"USG","explanation":"• Iopanoic acid is used in oral cholecystography . Q\nAnswer (book): Answer: D. USG"},{"n":34,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"The substance used in OCG is:","options":[{"letter":"A","text":"Iopanoic acid"},{"letter":"B","text":"Sodium diatrozite"},{"letter":"C","text":"Meglumine iodothalamate"},{"letter":"D","text":"Biligraffin"},{"letter":"E","text":"Dianosil"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Iopanoic acid","explanation":"• Biligraffin is used in IV cholangiographyQ.\nAnswer (book): Answer: A. Iopanoic acid"},{"n":35,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Dye used in IV cholangiography is: (Recent Question 2016)","options":[{"letter":"A","text":"Diansoil"},{"letter":"B","text":"Conray"},{"letter":"C","text":"Biligraffin"},{"letter":"D","text":"Myodil"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Biligraffin","explanation":"c. Biligraffin"},{"n":36,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Investigation of choice in suspected gallbladder stone is: (Recent Question 2017, UPPG 2010, MCI March 2010)","options":[{"letter":"A","text":"Ultrasound"},{"letter":"B","text":"X-ray"},{"letter":"C","text":"Barium study"},{"letter":"D","text":"Oral cholecystography"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ultrasound","explanation":"a. Ultrasound"},{"n":37,"chapter":"Gallbladder","src":"question on PDF p. 277 · answer on PDF p. 286","pdfPage":277,"stem":"Investigation for assessing proper functioning of biliary system: (MCI March 2007)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"CT scan"},{"letter":"C","text":"HIDA scan"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"HIDA scan (Ref: Sabiston 20/e p1488; Schwartz 10/e p1320; Bailey 27/e p1199; Blumgart 5/e","explanation":"c. HIDA scan (Ref: Sabiston 20/e p1488; Schwartz 10/e p1320; Bailey 27/e p1199; Blumgart 5/e p254-270; Shackelford 7/e p1306"},{"n":38,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"What is the diagnosis based on this ultrasound image?","options":[{"letter":"A","text":"Gallstone"},{"letter":"B","text":"Gallbladder polyp"},{"letter":"C","text":"Porcelain gallbladder"},{"letter":"D","text":"Adenomyomatosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gallstone","explanation":"• USG in Gallstone: Posterior acoustic shadow\nImage-based question: the picture / video this question refers to is on PDF p. 278 of the source and is not reproduced here.\nAnswer (book): Answer: A. Gallstone"},{"n":39,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Not a complication of gallstones: (JIPMER 2010)","options":[{"letter":"A","text":"Mucocele"},{"letter":"B","text":"Diverticulosis"},{"letter":"C","text":"Acute cholangitis"},{"letter":"D","text":"Empyema of the gallbladder"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Diverticulosis","explanation":"Effects and Complications of Gallstones\nIn gallbladder Silent stones\n• Acute cholecystitis\n• Chronic cholecystitis\n• Mucocele\nEmpyema Perforation Gangrene Carcinoma\nIn Bile duct\n• Obstructive jaundice\n• Cholangitis\n• Acute pancreatitis\nIn Intestine\n• Gallstone ileus\nAnswer (book): Answer: B. Diverticulosis\nReference: Sabiston 20/e p1492-1493; Bailey 27/e p1199; Blumgart 6/e p554, 5/e p483-487"},{"n":40,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"True about Gallstone disease: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Acute cholecystitis presents with GB perforation"},{"letter":"B","text":"Acute cholecystitis presents with mucosal ulceration of GB"},{"letter":"C","text":"80% cases of cholilithiasis are symptomatic"},{"letter":"D","text":"Mucocele of GB contains infected bile"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Acute cholecystitis presents with mucosal ulceration of GB","explanation":"b. Acute cholecystitis presents with mucosal ulceration of GB (Ref: Sabiston 20/e p1493-1494; Schwartz 10/e p1321; Bailey 27/e p1199;\nBlumgart 6/e p556, 5/e p487-494; Shackelford 7/e p1315-1317)"},{"n":41,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Ursodeoxycholic acid is a: (PGI June 95)","options":[{"letter":"A","text":"Urinary stone dissolving drug"},{"letter":"B","text":"Thrombolytic drug"},{"letter":"C","text":"Gallstone dissolving drug"},{"letter":"D","text":"Antifibrinolytic"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gallstone dissolving drug","explanation":"c. Gallstone dissolving drug (Ref: Sabiston 20/e p1494)"},{"n":42,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"In which condition, medical treatment of Gallstone is indicated? (AIIMS Nov 96, All India 98)","options":[{"letter":"A","text":"Stone is < 15 mm size"},{"letter":"B","text":"Radiopaque stone"},{"letter":"C","text":"Calcium bilirubinate stone"},{"letter":"D","text":"Non functioning gallbladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stone is <15 mm size","explanation":"a. Stone is <15 mm size"},{"n":43,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Which one of the following statements is incorrect regarding gallbladder stones?","options":[{"letter":"A","text":"Pigment stones are due to increased excretion of conju gated bilirubin"},{"letter":"B","text":"Are considered a risk factor for the development of gall bladder carcinoma"},{"letter":"C","text":"10% gallstones are radiopaque"},{"letter":"D","text":"A mucocele of the gallbladder is caused by a stone impacted in Hartmann’s pouch"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pigment stones are due to increased excretion of conjugated bilirubin","explanation":"a. Pigment stones are due to increased excretion of conjugated bilirubin"},{"n":44,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Regarding stones in gallbladder the following are true except: (Kerala 2000)","options":[{"letter":"A","text":"Mixed stones are common in the west"},{"letter":"B","text":"In Saint’s triad diverticulosis of colon and hiatus hernia coexist"},{"letter":"C","text":"Is a risk factor in the development of GB carcinoma"},{"letter":"D","text":"90% of GB stones are radiopaque"},{"letter":"E","text":"A mucocele of GB is caused by a stone impacted in the Hartmann’s pouch"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"90% of GB stones are radiopaque","explanation":"d. 90% of GB stones are radiopaque"},{"n":45,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"About gallstone, false is: (DPG 2006)","options":[{"letter":"A","text":"Intervention should be done if gallstones are present in the bile duct irrespective of the duct diameter"},{"letter":"B","text":"Operation should be done in most cases"},{"letter":"C","text":"Can be caused due to parasitic infestation"},{"letter":"D","text":"Can lead to cholecystitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Operation should be done in most cases","explanation":"• Operation is not done in most cases of gallstones, done in symptomatic cases.\nAnswer (book): Answer: B. Operation should be done in most cases"},{"n":46,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Which of the following is a contraindication for medical management of gallstones? (Karnataka 2012)","options":[{"letter":"A","text":"Radiopaque stones"},{"letter":"B","text":"Radioluscent stones"},{"letter":"C","text":"Normal functioning gallbladder"},{"letter":"D","text":"Small stones"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Radiopaque stones","explanation":"a. Radiopaque stones"},{"n":47,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"In gallstone ileus, obstruction is seen at: (Recent Question 2014, AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"Jejunum"},{"letter":"B","text":"Proximal ileum"},{"letter":"C","text":"Distal ileum"},{"letter":"D","text":"Colon"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Distal ileum","explanation":"c. Distal ileum (Ref: Sabiston 20/e p1506-1507; Blumgart 6/e p563, 5/e p649-655; Shackelford 8/e p844, 7/e p865)"},{"n":48,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"All are true about gallstone ileus except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"May be diagnosed with abdominal X-ray"},{"letter":"B","text":"Most common fistula is to duodenum"},{"letter":"C","text":"Tumbling obstruction"},{"letter":"D","text":"Cholecystectomy should be done in same episode"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cholecystectomy should be done in same episode","explanation":"• Most patients in Gallstone ileus are unstable to withstand a prolonged operative procedure, so cholecystectomy\nshould not be done in same episode.\n• Fistula can be addressed at a second laparotomyQ\nAnswer (book): Answer: D. Cholecystectomy should be done in same episode"},{"n":49,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"False about gallstone ileus: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"90% patients give history of biliary disease"},{"letter":"B","text":"Causes 1% of all SBO; around 25% cases in >70 years"},{"letter":"C","text":"Tumbling obstruction"},{"letter":"D","text":"Fistula is mostly formed between duodenum and gallbladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"90% patients give history of biliary disease","explanation":"a. 90% patients give history of biliary disease"},{"n":50,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Most common site of fistula in fallstone ileus is between: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"GB and duodenum"},{"letter":"B","text":"GB and transverse colon"},{"letter":"C","text":"GB and stomach"},{"letter":"D","text":"GB and ileum"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"GB and duodenum","explanation":"a. GB and duodenum"},{"n":51,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Rigler’s triad consists of: (PGI May 2011, Nov 2009)","options":[{"letter":"A","text":"Intestinal obstruction"},{"letter":"B","text":"Gas in bile duct"},{"letter":"C","text":"Cholangitis"},{"letter":"D","text":"Ectopic gallstone"},{"letter":"E","text":"Biliary stenosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Intestinal obstruction, B. Gas in bile duct, D. Ectopic gallstone","explanation":"a. Intestinal obstruction, b. Gas in bile duct, d. Ectopic gallstone"},{"n":52,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"The treatment of fallstone ileus is: (PGI June 99, UPSC 2008)","options":[{"letter":"A","text":"Cholecystectomy alone"},{"letter":"B","text":"Removal of obstruction"},{"letter":"C","text":"Cholecystectomy, closure of fistula and removal of stone by enterotomy"},{"letter":"D","text":"Cholecystectomy with closure of fistula"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Removal of obstruction","explanation":"b. Removal of obstruction\nMUCOCELE"},{"n":53,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"The treatment of choice for a mucocele of gallbladder is: (AIIMS June 2004)","options":[{"letter":"A","text":"Aspiration of mucous"},{"letter":"B","text":"Cholecystectomy"},{"letter":"C","text":"Cholecystostomy"},{"letter":"D","text":"Antibiotics and observation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cholecystectomy","explanation":"b. Cholecystectomy (Ref: Bailey 27/e p1199; Harrison 20/e p2428, 19/e p2081)"},{"n":54,"chapter":"Gallbladder","src":"question on PDF p. 278 · answer on PDF p. 286","pdfPage":278,"stem":"Which of the following is false about mucocele of gallbladder? (Recent Question 2015)","options":[{"letter":"A","text":"Complication of gallstones"},{"letter":"B","text":"Treatment is early cholecystectomy"},{"letter":"C","text":"Obstruction at neck of gallbladder"},{"letter":"D","text":"Gallbladder is never palpable"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Gallbladder is never palpable","explanation":"d. Gallbladder is never palpable"},{"n":55,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 286","pdfPage":279,"stem":"Indications of prophylactic cholecystectomy are all except: (ILBS 2012)","options":[{"letter":"A","text":"Diabetes"},{"letter":"B","text":"Hemoglobinopathy"},{"letter":"C","text":"Gallstone size >3 cm"},{"letter":"D","text":"Porcelain GB"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diabetes","explanation":"Diabetes Mellitus (Blumgart 6/e p623)\n• Patients with diabetes may have a higher incidence of gallstonesQ from the indirect effects of the metabolic\nsyndrome, obesity, and a family history of gallstonesQ.\n• No data show worse evolution of asymptomatic cholelithiasis in diabeticsQ, and prophylactic cholecystectomy in\nasymptomatic gallstones carriers with diabetes is not recommendedQ\nAnswer (book): Answer: A. Diabetes\nReference: Blumgart 6/e p623, 5/e p486, 513; Shackelford 8/e p1281, 7/e p1316"},{"n":56,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Which of the following is not an indication for cholecy stectomy? (ILBS 2011)","options":[{"letter":"A","text":"GB polyp with stone"},{"letter":"B","text":"Asymptomatic polyp >1 cm"},{"letter":"C","text":"Multiple GB polyps"},{"letter":"D","text":"Symptomatic GB polyps"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Multiple GB polyps","explanation":"c. Multiple GB polyps (Ref: Sabiston 20/e p1511; Bailey 27/e p1203)"},{"n":57,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Not an indication for cholecystectomy for asymptomatic gallstones: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Diabetes"},{"letter":"B","text":"Sickle cell anemia"},{"letter":"C","text":"Porcelain GB"},{"letter":"D","text":"In high prevalence area of CA GB"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diabetes","explanation":"a. Diabetes"},{"n":58,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"The indications of cholecystectomy are: (PGI Dec 2007, Dec 2006)","options":[{"letter":"A","text":"Strawberry gallbladder"},{"letter":"B","text":"Mucocele of the gallbladder"},{"letter":"C","text":"Gallbladder polyp"},{"letter":"D","text":"Asymptomatic Gallstone disease"},{"letter":"E","text":"Symptomatic cholelithiasis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mucocele of the gallbladder, E. Symptomatic cholelithiasis","explanation":"b. Mucocele of the gallbladder, e. Symptomatic cholelithiasis"},{"n":59,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"The technique of laparoscopic cholecystectomy was first described by? (AIIMS May 2011)","options":[{"letter":"A","text":"Erich Muhe"},{"letter":"B","text":"Phillip Moure"},{"letter":"C","text":"Kurt Semm"},{"letter":"D","text":"Eddie Reddick"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Erich Muhe","explanation":"History of Laparoscopic Cholecystectomy\n• Dr. Kurt Semm, the father of “pelviscopy,” performed the first laparoscopic appendectomy in 1980Q.\n• Eric MuheQ performed the first laparoscopic cholecystectomy in 1982. He used a modified operating laparoscope\nplaced at the umbilicus after establishing pneumoperitoneum.\n• In 1987, Phillipe Mouret performed the first video laparoscopic cholecystectomy by using a camera attached to\nthe laparoscopeQ.\nAnswer (book): Answer: A. Erich Muhe\nReference: Blumgart 6/e p6,551, 5/e p512"},{"n":60,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"All are indications for cholecystectomy except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Emphysematous cholecystitis"},{"letter":"B","text":"Biliary dyskinesia"},{"letter":"C","text":"Perforation of gallbladder"},{"letter":"D","text":"Adenomyomatosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Adenomyomatosis","explanation":"• Cholecystectomy is indicated in symptomatic adenomyomatosis or when cholelithiasis is presentQ.\nAnswer (book): Answer: D. Adenomyomatosis"},{"n":61,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Prophylactic cholecystectomy is done in: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Calcified GB"},{"letter":"B","text":"Diabetes"},{"letter":"C","text":"Asymptomatic gallstones"},{"letter":"D","text":"Family history of gallstones"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Calcified GB","explanation":"a. Calcified GB"},{"n":62,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"After surgery, there was 50 ml bile output from abdominal drain on 1st postoperative day. Management is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Intrabiliary stent"},{"letter":"B","text":"Immediate exploration"},{"letter":"C","text":"T-tube drainage"},{"letter":"D","text":"Observation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Observation","explanation":"• “A small amount of biliary drainage following cholecystectomy should cause no alarm because it usually\ndisappears within 1 or 2 daysQ. However, excessive biliary drainage through the wound or drain site, jaundice,\nsepsis or a combination of these events early in the post-operative period should suggest a bile duct injury, as\nshould copious biliary drainage for more than few post-op daysQ.”\nAnswer (book): Answer: D. Observation\nReference: Blumgart 5/e p524-525"},{"n":63,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Indication of cholecystectomy for gallstones disease is/are: (PGI Nov 2011)","options":[{"letter":"A","text":"Asymptomatic gallstones with DM"},{"letter":"B","text":"Porcelain gallbladder"},{"letter":"C","text":"Asymptomatic with history of single attack of acute pancreatitis"},{"letter":"D","text":"Asymptomatic Gallstone disease"},{"letter":"E","text":"Symptomatic cholecystitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Porcelain gallbladder, C. Asymptomatic with history of single attack of acute pancreatitis, E.","explanation":"Symptomatic cholecystitis\nContraindications to Laparoscopic Cholecystectomy\nAbsolute\nRelative\n• Unable to tolerate general anesthesiaQ\n• Refractory coagulopathyQ\n• Suspicion of carcinomaQ\nPrevious upper abdominal surgeryQ CholangitisQ Diffuse peritonitisQ Cirrhosis or portal hypertensionQ Chronic\nobstructive pulmonary disease Cholecystenteric fistulaQ Morbid obesityQ PregnancyQ\nIndications of Open Cholecystectomy\n• Poor pulmonary or cardiac reserveQ\n• Suspected or known gallbladder cancerQ\n• Cirrhosis and portal hypertensionQ\n• Third-trimester pregnancyQ\n• Combined procedure\nAnswer (book): Answer: B. Porcelain gallbladder, C. Asymptomatic with history of single attack of acute pancreatitis, E."},{"n":64,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Which of the following is the absolute contraindication for laparoscopic cholecystectomy? (NEET 2013, MHSSMCET 2005)","options":[{"letter":"A","text":"Clotting factor deficiency"},{"letter":"B","text":"Perforation peritonitis"},{"letter":"C","text":"Empyema of the gallbladder"},{"letter":"D","text":"Adhesions"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Clotting factor deficiency","explanation":"Types of Cholecystectomy Retrograde\nAntegrade or Fundus-first or Top-down\n• Hilar structure dissection occurs first followed by the removal of gallbladder in the triangle of Callot’sQ.\n• Separates GB from the liver before the cystic duct and artery are ligatedQ\n• Considered safer because it allows for the progressive demonstration of the anatomy down to the\ninfundibulocystic junctionQ.\nAnswer (book): Answer: A. Clotting factor deficiency\nReference: Blumgart 6/e p575, 5/e p514"},{"n":65,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Contraindications of laparoscopic cholecystectomy is: (Recent Question 2015, DNB 2011)","options":[{"letter":"A","text":"Coagulopathy"},{"letter":"B","text":"Obstructive pulmonary disease"},{"letter":"C","text":"End stage liver disease"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above"},{"n":66,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Which of the following is not an indication for cholecy stectomy? (AIIMS May 2005)","options":[{"letter":"A","text":"A 70 years old male with symptomatic gallstones"},{"letter":"B","text":"A 20 years old male with sickle cell anemia and sympto matic gallstones"},{"letter":"C","text":"A 65 years old female with a large gallbladder polyp"},{"letter":"D","text":"A 55 years old with an asymptomatic gallstone"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"A 55 years old with an asymptomatic gallstone","explanation":"Boundaries of Callot’s Triangle\n• Superiorly cystic artery\n• Medially, common hepatic ductQ\n• Laterally, cystic ductQ Q\nBoundaries of Hepatocystic Triangle\n• Superiorly, inferior surface of liverQ\n• Medially, common hepatic ductQ\n• Laterally, cystic ductQ\nAnswer (book): Answer: D. A 55 years old with an asymptomatic gallstone"},{"n":67,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"A 45 years old female presents with symptoms of acute cholecystitis. On USG there is a solitary gallstone of size 1.5 cm. Symptoms are controlled with medical management. Which of the following is the next most appropriate step in the management of this patient? (All India 2008)","options":[{"letter":"A","text":"Regular follow up"},{"letter":"B","text":"IV Antibiotics"},{"letter":"C","text":"Laparoscopic cholecystectomy immediately"},{"letter":"D","text":"Open cholecystectomy immediately"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Laparoscopic cholecystectomy immediately","explanation":"p1282, 7/e p1316\nTreatment of Acute Cholecystitis\n• Early cholecystectomy performed within 2 to 3 days (within 72 hours) Q of presentation is preferred over interval\nor delayed cholecystectomy that is performed 6 to 10 weeks after initial medical therapy.\n• Laparoscopic cholecystectomy is the preferred approach to patients with acute cholecystitisQ.\nAnswer (book): Answer: C. Laparoscopic cholecystectomy immediately\nReference: Sabiston 20/e p1494; Schwartz, 10/e p1325; Bailey 25/e p1121; Blumgart 6/e p557-558, 5/e p488-489; Shackelford 8/e"},{"n":68,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 287","pdfPage":279,"stem":"Antegrade cholecstectomy: (PGI Dec 2000)","options":[{"letter":"A","text":"Starts from fundus"},{"letter":"B","text":"Starts from cystic duct identification"},{"letter":"C","text":"Starts from hilar dissection"},{"letter":"D","text":"Considered unsafe"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Starts from fundus","explanation":"a. Starts from fundus (Ref: Mastery of Surgery 5/e p1128)"},{"n":69,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"A 69 years old male patient having coronary artery disease was found to have gallbladder stones while undergoing a routine ultrasound of the abdomen. There was no history of biliary colic or jaundice at any time. What is the best treatment advice for such a patient for his gallbladder stones? (AIIMS Nov 2003, All India 2003)","options":[{"letter":"A","text":"Open cholecystectomy"},{"letter":"B","text":"Laparoscopic cholecystectomy"},{"letter":"C","text":"No surgery for gallbladder stones"},{"letter":"D","text":"ERCP and removal of gallbladder stones"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"No surgery for gallbladder stones","explanation":"• “There was no clear cost benefit and no life-years were gained from prophylactic cholecystectomy, indicating no\nclearcut advantages of prophylactic cholecystectomy in asymptomatic cholelithiasis. As a result, in patients with\nasymptomatic gallstones, expectant management is recommendedQ.”\nAnswer (book): Answer: C. No surgery for gallbladder stones\nReference: Blumgart 6/e p623, 5/e p486"},{"n":70,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"The treatment of choice for silent gallbladder stones is: (All India 97)","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Chenodeoxycholic acid"},{"letter":"C","text":"Cholecystectomy"},{"letter":"D","text":"Lithotripsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Observation","explanation":"a. Observation"},{"n":71,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"Features of healthy gallbladder on laparotomy are: (PGI Dec 2000)","options":[{"letter":"A","text":"Typical “sea-green” colored"},{"letter":"B","text":"Wall is thin and elastic"},{"letter":"C","text":"Cannot be emptied"},{"letter":"D","text":"Not easily visible"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Typical “sea-green” colored, B. Wall is thin and elastic","explanation":"Healthy Gallbladder\n• Greenish blue or sea green colorQ\n• Thin and elastic wallQ\nCan be emptied by squeezingQ\nAnswer (book): Answer: A. Typical “sea-green” colored, B. Wall is thin and elastic"},{"n":72,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"Contraindication for laparoscopic cholecystectomy is all except: (Kerala 95)","options":[{"letter":"A","text":"Shrunken liver"},{"letter":"B","text":"Previous laparotomy"},{"letter":"C","text":"Emphysema"},{"letter":"D","text":"Obese individual"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Shrunken liver","explanation":"a. Shrunken liver"},{"n":73,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"Most common malignancy after cholecystectomy is of: (PGI SS Dec 2005)","options":[{"letter":"A","text":"Colon"},{"letter":"B","text":"Stomach"},{"letter":"C","text":"Pancreas"},{"letter":"D","text":"Ileum"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Colon","explanation":"• Bile acids can induce hyperproliferation of the intestinal mucosaQ via a number of intracellular mechanisms.\n• Cholecystectomy, which alters the enterohepatic cycle of bile acids, has been associated with a moderately\nincreased risk of proximal colon cancersQ.\n• It cannot be ruled out, however, that it is less the effect of the cholecystectomy than the impact of other, not yet\nidentified factors in the lithogenic bile of such patients.\n• A number of cofactors have been identified that may enhance or neutralize the carcinogenic effects of bile acids,\ne.g. the amount of dietary fat, fiber, or calciumQ.\n• Calcium, in fact, binds bile acids and thus may reduce their negative impactQ.\nAnswer (book): Answer: A. Colon\nReference: Maingot 11/e p628"},{"n":74,"chapter":"Gallbladder","src":"question on PDF p. 279 · answer on PDF p. 288","pdfPage":279,"stem":"Laparoscopic cholecystectomy is largely preferred for all of the following reasons to conventional laparotomy except: (SGPGI 2004)","options":[{"letter":"A","text":"Decrease pain"},{"letter":"B","text":"Decreased incidence of bile duct injuries"},{"letter":"C","text":"Smaller scar"},{"letter":"D","text":"Decreased stay in hospital"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Decreased incidence of bile duct injuries","explanation":"Bile Duct Injury\nMost benign strictures follow iatrogenic bile duct injuryQ Most commonly during laparoscopic cholecystectomyQ\nIncidence of bile duct injury during open cholecystectomy is 0.1–0.2%Q Incidence of bile duct injury during\nlaparoscopic cholecystectomy is 0.3–0.85%Q\n• Morbidity rate, hospital stay, and time to return to work are lower in patients undergoing laparoscopic\ncholecystectomy than open cholecystectomyQ.\nAnswer (book): Answer: B. Decreased incidence of bile duct injuries"},{"n":75,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 288","pdfPage":280,"stem":"A 50-year-old with history of jaundice in the past has presented with right upper quadrant abdominal pain. Examination and investigations reveal chronic calculous cholecystitis. The liver functions tests are within normal limits and on ultrasound examination, the common bile ducts is not dilated. Which of the following will be the procedure of choice in her? (J and K 2005)","options":[{"letter":"A","text":"Laparoscopic cholecystectomy"},{"letter":"B","text":"Open choledocholithotomy with CBD exploration"},{"letter":"C","text":"ERCP + choledocholithotomy followed by laparoscopic cholecystectomy"},{"letter":"D","text":"Laparoscopic cholecystectomy followed by ERCP + choledocholithotomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Laparoscopic cholecystectomy","explanation":"In the given question, there was an episode of jaundice, but at present, LFT is normal and CBD is not\ndilated. The best option is laparoscopic cholecystectomy only.\nManagement of CBD Stones Associated with GB Stones\n• Pre-operatively Detected Stones\n• Unsuspected stones found at the time of Cholecystectomy\nExperienced Laparoscopic Surgeon\nExperienced Laparoscopic Surgeon\n• Cholecystectomy and choledochotomy in same sittingQ\n• Laparoscopic CBD exploration and stone retrieval through the cystic ductQ\n• Laparoscopic choledochotomy and stone extractionQ\nInexperienced Laparoscopic Surgeon\n• Pre-op ERCP with stone removal and laparoscopic cholecystectomy laterQ.\nInexperienced Laparoscopic Surgeon\n• Convert to open procedure and remove CBD stoneQ\n• Complete the cholecystectomy and refer the patient for ERCPQ Conversion to an open procedure is preferred\nover ERCPQ, because the success rate of ERCP is not 100%Q.\nAnswer (book): Answer: A. Laparoscopic cholecystectomy"},{"n":76,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"A 88 years old male patient presented with end stage renal disease with coronary artery block and metastasis in the lungs. Now presents with acute cholecystitis, patient’s relatives need treatment to do something: (UPPG 2008)","options":[{"letter":"A","text":"Open cholecystectomy"},{"letter":"B","text":"Tube cholecystostomy"},{"letter":"C","text":"Laparoscopic cholecystectomy"},{"letter":"D","text":"Antibiotics then elective cholecystectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tube cholecystostomy","explanation":"b. Tube cholecystostomy\n•\t If patients are unfit for surgery, percutaneous, ultrasound guided, or CT guided cholecystostomy is the treatment of choiceQ."},{"n":77,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"An otherwise normal female presents with symptoms of flatulent dyspepsia. She was started on proton pump inhibitors, which controlled her symptoms. The next step in management of this condition should be: (All India 2008)","options":[{"letter":"A","text":"Immediate laparoscopic cholecystectomy"},{"letter":"B","text":"Laparotomy after 1 or 2 months"},{"letter":"C","text":"Wait and watch"},{"letter":"D","text":"ERCP"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Wait and Watch","explanation":"Flatulent Dyspepsia\n• Flatulent dyspepsia is usually described as symptom of Gallstone diseaseQ.\n• However, flatulent dyspepsia (in an otherwise normal female), that responds to PPI is more likely to result from\nreflux or peptic ulcer disease (rather than Gallstone disease) and does not require surgical management or\ninvasive investigationsQ for gallbladder disease.\n• Patients with these symptoms should be observed (wait and watch)Q or investigated by endoscopy to exclude\nreflux or peptic ulcer diseaseQ.\n• If patients are unfit for surgery, percutaneous, ultrasound guided, or CT guided cholecystostomy is the treatment\nof choiceQ.\nAnswer (book): Answer: C. Wait and Watch"},{"n":78,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"In cholecystectomy, fresh plasma should be given: (UPPG 2008)","options":[{"letter":"A","text":"Just before operation"},{"letter":"B","text":"At the time of operation"},{"letter":"C","text":"6 hours before operation"},{"letter":"D","text":"12 hours after operation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Just before operation","explanation":"The question is incomplete. It should be “A cirrhotic patient with abnormal coagulation needs\ncholecystectomy, FFP should be given:”\nFresh Frozen Plasma\nTransfusions with FFP are given to replenish clotting factorsQ. The effectiveness of the transfusion in maintaining\nhemostasis is dependent on the quantity of each factor delivered and its half-life. The half-life on the most stable\nclotting factor, factor VII, is 4 to 6 hoursQ. A reasonable transfusion scheme would be to give FFP on call to the\noperating room. This way the transfusion is complete prior to the incision, with circulating factors to cover the\noperative and immediate postoperative periodQ.\nAnswer (book): Answer: A. Just before operation"},{"n":79,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"A patient underwent laparoscopic cholecystectomy and was discharged on the same day. On postoperative day 3, he presented to the hospital with fever. Ultrasonography showed a 5 × 5 cm collection in the right subdiaphragmatic region. What will be the management? (AIIMS May 2017)","options":[{"letter":"A","text":"Observe with antibiotic cover"},{"letter":"B","text":"Re-explore the wound with T-tube insertion"},{"letter":"C","text":"Pigtail insertion and drainage"},{"letter":"D","text":"ERCP and proceed"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pigtail insertion and drainage","explanation":"c. Pigtail insertion and drainage (Ref: Sabiston 20/e p1506; Schwartz 10/e p1332; Bailey 27/e p1203)"},{"n":80,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"Referred pain to inferior angle of right scapula in acute cholecystitis is known as: (Recent Question 2017)","options":[{"letter":"A","text":"Murphy’s sign"},{"letter":"B","text":"Naunyn’s sign"},{"letter":"C","text":"Boa’s sign"},{"letter":"D","text":"Cullen’s sign"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Boa’s sign","explanation":"c. Boa’s sign"},{"n":81,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"All are true about acute acalculous cholecystitis except: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Distended GB is seen in scintigraphy"},{"letter":"B","text":"Vascular cause"},{"letter":"C","text":"Seen in bed ridden patients"},{"letter":"D","text":"Rapid course"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Distended GB is seen in scintigraphy","explanation":"8/e p1281, 7/e p1315-1316\n\n• Cholescintigraphy demonstrates absent gallbladder filling in acalculous cholecystitisQ.\nAnswer (book): Answer: A. Distended GB is seen in scintigraphy\nReference: Sabiston 20/e p1508; Schwartz, 10/e p1327-1330; Bailey 27/e p1200; Blumgart 6/e p561, 5/e p491-492; Shackelford"},{"n":82,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"Acalculous cholecystitis can be seen in all except: (Punjab 2008, AIIMS Nov 2005)","options":[{"letter":"A","text":"Dengue hemorrhagic fever"},{"letter":"B","text":"Malaria"},{"letter":"C","text":"Leptospirosis"},{"letter":"D","text":"Enteric fever"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Malaria","explanation":"• Both malaria and dengue are uncommon causes of acalculous cholecystitis.\n• MalariaQ seems to be more common between the two.\nAnswer (book): Answer: B. Malaria"},{"n":83,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"Acalculous cholecystitis are caused by: (PGI Dec 2006, Dec 2001)","options":[{"letter":"A","text":"DM"},{"letter":"B","text":"TPN"},{"letter":"C","text":"Leptospirosis"},{"letter":"D","text":"Estrogen therapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"DM, B. TPN, C. Leptospirosis","explanation":"Causes of Acalculous Cholecystitis Common Causes Elderly and critically ill patients after traumaQ\nBurnsQ Longterm TPNQ Major operations (abdominal aneurysm repair and cardiopulmonary bypassQ)\n• Diabetes mellitus\nAnswer (book): Answer: A. DM, B. TPN, C. Leptospirosis\nReference: Harrison 20/e p2428, 19/e p2081"},{"n":84,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"Acalculous cholecystitis is caused by: (PGI Dec 2001)","options":[{"letter":"A","text":"Diabetes mellitus"},{"letter":"B","text":"Total parenteral nutrition"},{"letter":"C","text":"Tuberculosis"},{"letter":"D","text":"Anemia"},{"letter":"E","text":"Malignancy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Diabetes mellitus, B. Total parenteral nutrition","explanation":"a. Diabetes mellitus, b. Total parenteral nutrition"},{"n":85,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"Which of the following statements about acalculous cholecystitis is incorrect? (DPG 2009 March)","options":[{"letter":"A","text":"Manifestation of disturbed microcirculation in critically ill patient"},{"letter":"B","text":"Prolonged parenteral nutrition can be causative"},{"letter":"C","text":"It is life threatening condition"},{"letter":"D","text":"Cholecystectomy is not indicated"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cholecystectomy is not indicated","explanation":"d. Cholecystectomy is not indicated"},{"n":86,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 289","pdfPage":280,"stem":"All of the following are causes of acalculous cholecystitis except: (Recent Question 2013)","options":[{"letter":"A","text":"Bile duct stricture"},{"letter":"B","text":"Schistostoma"},{"letter":"C","text":"Prolonged TPN"},{"letter":"D","text":"Major operations"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Schistostoma","explanation":"Uncommon Causes\nVasculitis Obstructing GB adenocarcinoma GB torsion Parasitic infestation Unusual bacterial infection:\n– LeptospiraQ\n– Streptococcus\n– Salmonella\n– Vibrio cholera\nAnswer (book): Answer: B. Schistostoma"},{"n":87,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 290","pdfPage":280,"stem":"All of the following statements about Xanthogranulomatous inflammation are true except: (NEET Pattern)","options":[{"letter":"A","text":"Foam cells are seen"},{"letter":"B","text":"Yellow nodules are seen"},{"letter":"C","text":"Multinucleated giant cells are seen"},{"letter":"D","text":"Associated with tuberculosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Associated with tuberculosis","explanation":"d. Associated with tuberculosis (Ref: www.medscape.com/viewarticle/449665)"},{"n":88,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 290","pdfPage":280,"stem":"Acute emphysematous cholecystitis is caused by: (JIPMER 2012, 2010)","options":[{"letter":"A","text":"Pseudomonas aeuroginosa"},{"letter":"B","text":"Staphylococcus"},{"letter":"C","text":"Clostridium perfringens"},{"letter":"D","text":"Streptococcus pyogenes"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Clostridium perfringens","explanation":"c. Clostridium perfringens (Ref: Sabiston 20/e p1493; Blumgart 6/e p562, 5/e p492)"},{"n":89,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 290","pdfPage":280,"stem":"All of the following are correct regarding emphysematous cholecystitis except: (NEET Pattern, DNB 2010)","options":[{"letter":"A","text":"More common in males"},{"letter":"B","text":"More common in diabetics"},{"letter":"C","text":"In many cases the gallbladder does not contain stone"},{"letter":"D","text":"It is caused most commonly by Pseudomonas"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"It is caused most commonly by Pseudomonas","explanation":"d. It is caused most commonly by Pseudomonas"},{"n":90,"chapter":"Gallbladder","src":"question on PDF p. 280 · answer on PDF p. 290","pdfPage":280,"stem":"What is the most probable diagnosis based on the given X-ray finding?","options":[{"letter":"A","text":"Emphysematous cholecystitis"},{"letter":"B","text":"Emphysematous pyelonephritis"},{"letter":"C","text":"Xanthgranulomatous cholecystitis"},{"letter":"D","text":"Xanthgranulomatous pyelonephritis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Emphysematous cholecystitis","explanation":"In the given X-ray, there is ring of air around gallbladder suggestive of emphysematous cholecystitis.\nAnswer (book): Answer: A. Emphysematous cholecystitis\nReference: Sabiston 20/e p1493; Schwartz 10/e p1320; Bailey 27/e p1190-1191"},{"n":91,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Type II Mirizzi’s syndrome:","options":[{"letter":"A","text":"Obstruction of common duct by external compression only (no erosion)"},{"letter":"B","text":"Erosion of one-thirds circumference of common duct"},{"letter":"C","text":"Erosion of up to two-third circumference of common duct"},{"letter":"D","text":"Total/near total circumferential destruction of common duct"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Erosion of one-thirds circumference of common duct","explanation":"b. Erosion of one-thirds circumference of common duct  (Ref: Sabiston 20/e p1510; Schwartz; 10/e p1320-1331; Blumgart 6/e p562,\n5/e p493; Shackelford 8/e p1328, 7/e p1370)"},{"n":92,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Mirizzi syndrome is: (Recent Question 2015, 2014, DNB 2011)","options":[{"letter":"A","text":"GB stone compressing common hepatic duct"},{"letter":"B","text":"GB carcinoma invading IVC"},{"letter":"C","text":"GB stone causing cholecystitis"},{"letter":"D","text":"Pancreatic carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"GB stone compressing common hepatic duct","explanation":"a. GB stone compressing common hepatic duct"},{"n":93,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Cholesterolosis is: (Karnataka 94)","options":[{"letter":"A","text":"Disease of defective metabolism of choline"},{"letter":"B","text":"Concerned with epithelial tumors of brain"},{"letter":"C","text":"Diffuse deposition of cholesterol in mucosa of gallbladder"},{"letter":"D","text":"Disease concerned with obstructive jaundice"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Diffuse deposition of cholesterol in mucosa of gallbladder","explanation":"c. Diffuse deposition of cholesterol in mucosa of gallbladder (Ref: Bailey 27/e p1201)"},{"n":94,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Gross appearance of gallbladder specimen is suggestive of:","options":[{"letter":"A","text":"Emphysematous cholecystitis"},{"letter":"B","text":"Xanthogranulomatous cholecystitis"},{"letter":"C","text":"Gallbladder cholesterolosis"},{"letter":"D","text":"Adenomyomatosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gallbladder cholesterolosis","explanation":"c. Gallbladder cholesterolosis (Ref: Bailey 27/e p1201)"},{"n":95,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Indications of cholecystectomy in GB polyp removal are all except: (ILBS 2012)","options":[{"letter":"A","text":"Size >1 cm"},{"letter":"B","text":"With stone"},{"letter":"C","text":">3 in number"},{"letter":"D","text":"Locally invasive"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":">3 in number","explanation":"c. >3 in number (Ref: Sabiston 20/e p1511; Bailey 27/e p1201; Blumgart 6/e p266, 5/e p751)"},{"n":96,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Risk factors for malignant change in an asymptomatic patient with a gallbladder polyp on ultrasound include all of the following, except: (AIIMS May 2011, All India 2009)","options":[{"letter":"A","text":"Age > 60 years"},{"letter":"B","text":"Rapid increase in size of polyp"},{"letter":"C","text":"Size of polyp > 5 mm"},{"letter":"D","text":"Associated gallstones"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Size of polyp > 5 mm","explanation":"c. Size of polyp > 5 mm"},{"n":97,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Identify the diagnosis of the given gross specimen: (AIIMS November 2017)","options":[{"letter":"A","text":"Cancer gallbladder"},{"letter":"B","text":"Cholesterolosis"},{"letter":"C","text":"Strawberry gallbladder"},{"letter":"D","text":"Polyps in gallbladder"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Polyps in gallbladder","explanation":"d. Polyps in gallbladder (Ref: Sabiston 20/e p1511; Bailey 27/e p1210)"},{"n":98,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"False about GB polyps: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Adenomyomatosis < 1 cm, pedunculated"},{"letter":"B","text":"Cholesterol polyps are most common"},{"letter":"C","text":"Symptomatic polyps are indication for cholecystectomy"},{"letter":"D","text":"Polyp with stone is an increased risk of malignancy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenomyomatosis < 1 cm, pedunculated","explanation":"a. Adenomyomatosis < 1 cm, pedunculated"},{"n":99,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"On abdominal ultrasound gallbladder shows diffuse wall thickening with hyperechoic nodules at neck and comet tail artifacts. The most likely diagnosis will be: (AIIMS May 2011)","options":[{"letter":"A","text":"Adenomyomatosis"},{"letter":"B","text":"Adenocarcinoma of gallbladder"},{"letter":"C","text":"Xanthogranulomatous cholecystitis"},{"letter":"D","text":"Cholesterol crystals"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenomyomatosis","explanation":"a. Adenomyomatosis (Ref: Sabiston 19/e p1505; Bailey 27/e p1201)"},{"n":100,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"All of the following are risk factors for CA GB except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Gallstones"},{"letter":"B","text":"Adenomyomatosis"},{"letter":"C","text":"Porcelain gallbladder"},{"letter":"D","text":"Choledochal cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Adenomyomatosis","explanation":"b. Adenomyomatosis"},{"n":101,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"This incidental finding on ultrasound abdomen is suggestive of:","options":[{"letter":"A","text":"Gallbladder stone"},{"letter":"B","text":"Gallbladder polyp"},{"letter":"C","text":"Adenomyomatosis"},{"letter":"D","text":"Xanthogranulomatons cholecystitis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Adenomyomatosis","explanation":"• The presence of cholesterol crystals in these sinuses in adenomyomatosis can result in “diamond ring sign”Q,\n“V-shaped”Q, or\n“comet-tail” artifactsQ on USG.\nAnswer (book): Answer: C. Adenomyomatosis\nReference: Sabiston 20/e p1511"},{"n":102,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"True about CA GB and gallstones: (GB Pant 2011)","options":[{"letter":"A","text":"3% association"},{"letter":"B","text":"30% association"},{"letter":"C","text":"50% association"},{"letter":"D","text":"90% association"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"90% association","explanation":"• Cholelithiasis is seen in 75–98% of all patients with CA GBQ.\n• The incidence of CA GB in a population of patients with gallstones is from 0.3–3%Q.\nAnswer (book): Answer: D. 90% association\nReference: Blumgart 6/e p787, 5/e p742"},{"n":103,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Precancerous lesions of GB are all except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Porcelain GB"},{"letter":"B","text":"Typhoid carrier"},{"letter":"C","text":"ABPDJ"},{"letter":"D","text":"Biliary ascariasis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Biliary ascariasis","explanation":"d. Biliary ascariasis (Ref: Blumgart 6/e p787, 5/e p742)"},{"n":104,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Organism associated with fish consumption and also causes carcinoma gallbladder: (AIIMS Nov 2012, AIIMS Nov 2010)","options":[{"letter":"A","text":"Gnathostoma"},{"letter":"B","text":"Anglostrongyloidosis cantonensis"},{"letter":"C","text":"Clonorchis sinensis"},{"letter":"D","text":"H. dimunata"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Clonorchis sinensis","explanation":"Clonorchis Sinensis\n• Clonorchis sinensis is a liver fluke, acquired by ingestion of raw or inadequately cooked freshwater fishesQ.\n• In human body, it lives within bile ducts and causes inflammatory reaction leading to cholangiohepatitis and\nbiliary obstructionQ.\n• It is a well known risk factor for cholangiocarcinomaQ.\n• It is a rare, but mentioned risk factor for carcinoma gallbladderQ.\nAnswer (book): Answer: C. Clonorchis sinensis\nReference: www.ncbi.nlm.gov/pubmed/3993073"},{"n":105,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"Risk factor for carcinoma gallbladder: (PGI Nov 2011)","options":[{"letter":"A","text":"Female sex"},{"letter":"B","text":"Choledochal cysts"},{"letter":"C","text":"Xanthogranulomatous cholecystitis"},{"letter":"D","text":"Calcification of gallbladder"},{"letter":"E","text":"Gallstone"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Choledochal cysts, D. Calcification of gallbladder, E. Gallstone","explanation":"b. Choledochal cysts, d. Calcification of gallbladder, e. Gallstone"},{"n":106,"chapter":"Gallbladder","src":"question on PDF p. 281 · answer on PDF p. 290","pdfPage":281,"stem":"All are risk factors for CA GB except: (GB Pant 2011)","options":[{"letter":"A","text":"Adenomyosis"},{"letter":"B","text":"ABPDJ"},{"letter":"C","text":"Gallstones"},{"letter":"D","text":"Adenomatous polyps"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenomyosis","explanation":"a. Adenomyosis"},{"n":107,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 290","pdfPage":282,"stem":"All of the following are risk factors for carcinoma gallbladder, except: (AIIMS June 2004)","options":[{"letter":"A","text":"Typhoid carriers"},{"letter":"B","text":"Adenomatous gallbladder polyps"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"Oral contraceptives"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Oral contraceptives","explanation":"d. Oral contraceptives"},{"n":108,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 290","pdfPage":282,"stem":"Precancerous lesion of gallbladder is: (AIIMS June 98)","options":[{"letter":"A","text":"Porcelain gallbladder"},{"letter":"B","text":"Mirizzi’s syndrome"},{"letter":"C","text":"Cholesterosis"},{"letter":"D","text":"Acalculous Cholecystitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Porcelain gallbladder","explanation":"a. Porcelain gallbladder (Ref: Sabiston 20/e p1512; Schwartz 10/e p1317-1318; Blumgart 6/e p787, 5/e p742)"},{"n":109,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 290","pdfPage":282,"stem":"All of the following are the risk factors for carcinoma gallbladder except: (Recent Question 2017)","options":[{"letter":"A","text":"Primary sclerosing cholangitis"},{"letter":"B","text":"Porcelain gallbladder"},{"letter":"C","text":"Multiple 2 cm gallstones"},{"letter":"D","text":"Choledochal cyst"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Multiple 2 cm gallstones","explanation":"c. Multiple 2 cm gallstones (Ref: Sabiston 20/e p1512; Schwartz 10/e p1334; Bailey 27/e p1210)"},{"n":110,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"All of the following are true about porcelain gallbladder except: (Kerala PG 2015)","options":[{"letter":"A","text":"May be seen on plain X-ray"},{"letter":"B","text":"More commonly diagnosed on CT"},{"letter":"C","text":"It is an indication for cholecystectomy"},{"letter":"D","text":"Always denotes benign etiology"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Always denotes benign etiology","explanation":"d. Always denotes benign etiology"},{"n":111,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Incidental finding in a female patient of age 56 years who underwent the CECT abdomen is suggestive of:","options":[{"letter":"A","text":"Carcinoma gallbladder"},{"letter":"B","text":"Gallbladder polyp"},{"letter":"C","text":"Porcelain gallbladder"},{"letter":"D","text":"Gallstone"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Porcelain gallbladder","explanation":"c. Porcelain gallbladder (Ref: Sabiston 20/e p1512; Schwartz 10/e p1317; Bailey 27/e p1190)"},{"n":112,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"In a male after laparoscopic cholecystectomy, specimen is sent for histopathology which shows carcinoma gallbladder stage T1a. Appropriate management is: (AIIMS May 2011)","options":[{"letter":"A","text":"Conservative and follow up"},{"letter":"B","text":"Extended cholecystectomy"},{"letter":"C","text":"Excision of all port sites"},{"letter":"D","text":"Radiotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Conservative and follow up","explanation":"a. Conservative and follow up (Ref: Sabiston 20/e p1512-1514; Schwartz 10/e p1334-1335; Bailey 27/e p1211; Blumgart 6/e p797, 5/e p748-754;\nShackelford 8/e p1323, 7/e p1364-1370)"},{"n":113,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"After laparoscopic cholecystectomy, if biopsy reveals in-situ cancer of gallbladder (Stage-I), then the appropriate management is: (Orissa 2011)","options":[{"letter":"A","text":"Follow-up"},{"letter":"B","text":"Extended cholecystectomy"},{"letter":"C","text":"Excision of all port sites"},{"letter":"D","text":"Radiotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Follow-up","explanation":"a. Follow-up"},{"n":114,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Survival in unresectable GB carcinoma is? (AIIMS May 2011)","options":[{"letter":"A","text":"4–6 months"},{"letter":"B","text":"8–10 months"},{"letter":"C","text":"1 year"},{"letter":"D","text":"12–24 months"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"4–6 months","explanation":"a. 4–6 months"},{"n":115,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"T2N1 of CA GB represents which stage? (KGMC 2011)","options":[{"letter":"A","text":"IA"},{"letter":"B","text":"IB"},{"letter":"C","text":"II"},{"letter":"D","text":"III"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"III","explanation":"d. III"},{"n":116,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"True about CA GB: (ILBS 2012)","options":[{"letter":"A","text":"T1a can be treated and cured by laparoscopic cholecys tectomy"},{"letter":"B","text":"T1b needs radical operation in all cases"},{"letter":"C","text":"Port site metastasis is localized disease"},{"letter":"D","text":"Pre-operative diagnosis of CA GB has different survival according to stage"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"T1a can be treated and cured by laparoscopic cholecystectomy","explanation":"a. T1a can be treated and cured by laparoscopic cholecystectomy"},{"n":117,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Most common gallbladder malignancy? (MHSSMCET 2008)","options":[{"letter":"A","text":"Adenocarcinoma"},{"letter":"B","text":"Squamous cell carcinoma"},{"letter":"C","text":"Mucinous cystadenocarcinoma"},{"letter":"D","text":"Serous cystadenocarcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenocarcinoma","explanation":"a. Adenocarcinoma"},{"n":118,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"All are true about CA GB except: (GB Pant 2011)","options":[{"letter":"A","text":"Redo surgery is radical or extended cholecystectomy increases significant survival advantage"},{"letter":"B","text":"Inter-aortocaval node involvement potentially rule out cure"},{"letter":"C","text":"<25% 5-year survival for all stages"},{"letter":"D","text":"Pancreaticoduodenectomy has 5-year survival of 25%"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pancreaticoduodenectomy has 5 year survival of 25%","explanation":"d. Pancreaticoduodenectomy has 5 year survival of 25%"},{"n":119,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"True about CA GB: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Most commonly presents with obstructive jaundice"},{"letter":"B","text":"90% are associated with gallstones"},{"letter":"C","text":"5-year survival is 35%"},{"letter":"D","text":"30% are squamous cell carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"90% are associated with gallstones","explanation":"b. 90% are associated with gallstones"},{"n":120,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Best prognosis in CA GB is seen in: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Papillary"},{"letter":"B","text":"Adenocarcinoma"},{"letter":"C","text":"Squamous"},{"letter":"D","text":"Melanoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Papillary","explanation":"a. Papillary"},{"n":121,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"False regarding CA GB: (PGI SS Dec 2010)","options":[{"letter":"A","text":"T1a: simple cholecystectomy"},{"letter":"B","text":"T1b: extended cholecystectomy"},{"letter":"C","text":"T1a: extended cholecystectomy if carcinoma in neck of gallbladder"},{"letter":"D","text":"Excision of port sites improves survival"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Excision of port sites improves survival","explanation":"• Port site excision is done for staging purposes to identify M1 diseaseQ\n• Port site excision is not having any potential therapeutic benefitQ.\nAnswer (book): Answer: D. Excision of port sites improves survival"},{"n":122,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Laparoscopic cholecystectomy was done, on histopathology, stage was T2. Next line of treatment: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Extended cholecystectomy"},{"letter":"C","text":"Port site excision"},{"letter":"D","text":"Chemotherapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Extended cholecystectomy","explanation":"• T1b, T2, T3 tumor with no evidence of metastasis: Re-resection, extended cholecystectomy (possible CBD or\nextended hepatic resection)Q\nPort Site Recurrences (Blumgart 6/e p799)\n• There is a theoretical risk of port site seeding after laparoscopic cholecystectomy for what is eventually\ndiagnosed as gallbladder cancer. This problem may be exacerbated by spillage of bile or stones inside the\nperitoneal cavity.\n• One study looked at 409 patients who underwent laparoscopic cholecystectomy for presumed benign gallbladder\ndisease but were diagnosed with gallbladder cancer on final pathology. Seventeen percent of patients at a\nmedian of 180 days were diagnosed with laparoscopic port site recurrences. As a result of this high percentage,\nsome surgeons recommend port site excision during reoperation for gallbladder cancer.\n• It is important to note, however, that it is rare for port site recurrences to occur as the sole site of disease.\n• Given that it is more a marker of aggressive disease than a single site of resectable disease, our general practice\ndoes not include empirically resecting prior port sites during reexploration for gallbladder cancer.\nAnswer (book): Answer: B. Extended cholecystectomy\nReference: Blumgart 6/e p797, 5/e p754"},{"n":123,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Commonest type of carcinoma gallbladder with gallstones is: (AIIMS Nov 95)","options":[{"letter":"A","text":"Adenocarcinoma"},{"letter":"B","text":"Anaplastic carcinoma"},{"letter":"C","text":"Squamous cell carcinoma"},{"letter":"D","text":"Transitional cell carcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenocarcinoma `","explanation":"a. Adenocarcinoma    `"},{"n":124,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"A 40-year-old woman has undergone a cholecystectomy. The histopathology reveals that she has a 3 cm adenocarcinoma in the body of the gallbladder infiltrating up to the serosa. Which of the following further management would you advise her? (AIIMS Nov 2004)","options":[{"letter":"A","text":"Chemotherapy"},{"letter":"B","text":"Radiotherapy"},{"letter":"C","text":"Radical cholecystectomy"},{"letter":"D","text":"Follow up with regular ultrasound examinations"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Radical cholecystectomy","explanation":"c. Radical cholecystectomy"},{"n":125,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Regarding carcinoma gallbladder: (PGI June 2002)","options":[{"letter":"A","text":"Squamous cell carcinoma is the most common"},{"letter":"B","text":"Present with jaundice"},{"letter":"C","text":"Good prognosis"},{"letter":"D","text":"Gallstones predispose"},{"letter":"E","text":"65% survival after surgery"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Present with jaundice, D. Gallstones predispose","explanation":"b. Present with jaundice, d. Gallstones predispose"},{"n":126,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Commonest association seen in carcinoma gallbladder: (AIIMS 91)","options":[{"letter":"A","text":"Peritoneal deposits"},{"letter":"B","text":"Duodenal infiltration"},{"letter":"C","text":"Secondaries to liver"},{"letter":"D","text":"Cystic node involvement"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Secondaries to liver","explanation":"Metastasis in Carcinoma Gallbladder\n• Direct hepatic invasion in 59% , LN metastasis in 45%, perineural invasion in 42% cases. Q\nAnswer (book): Answer: C. Secondaries to liver"},{"n":127,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Most common type of cancer gallbladder in a patient with gallstone: (APPG 2005)","options":[{"letter":"A","text":"Adenocarcinoma"},{"letter":"B","text":"Squamous carcinoma"},{"letter":"C","text":"Sarcoma"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Adenocarcinoma","explanation":"a. Adenocarcinoma"},{"n":128,"chapter":"Gallbladder","src":"question on PDF p. 282 · answer on PDF p. 291","pdfPage":282,"stem":"Most appropriate treatment option for the carcinoma gallbladder with invasion of perimuscular connective tissue, diagnosed after laparoscopic cholecystectomy: (Recent Question 2017)","options":[{"letter":"A","text":"Resection of segment IVb & V of liver with nodal clearance"},{"letter":"B","text":"Resection of segment IVb & V of liver with nodal clearance with port site excision"},{"letter":"C","text":"Wedge excision of liver with lymphadenectomy"},{"letter":"D","text":"Wedge excision of liver with lymphadenectomy and port-site excision"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Resection of segment IVb & V of liver with nodal clearance with port site excision","explanation":"b. Resection of segment IVb & V of liver with nodal clearance with port site excision (Ref: Sabiston 20/e p1514; Schwartz 10/e p1335;\nBailey 27/e p1211)"},{"n":129,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 291","pdfPage":283,"stem":"In a male after laparoscopic cholecystectomy, specimen is sent for histopathology which shows carcinoma gallbladder stage IB. Appropriate management is: (AIIMS Nov 2008)","options":[{"letter":"A","text":"Conservative and follow up"},{"letter":"B","text":"Extended cholecystectomy"},{"letter":"C","text":"Excision of all port sites"},{"letter":"D","text":"Radiotherapy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Extended cholecystectomy","explanation":"• T1b, T2, T3 tumor with no evidence of metastasis: Re-resection, extended cholecystectomy (possible CBD or\nextended hepatic resection)Q\nAnswer (book): Answer: B. Extended cholecystectomy"},{"n":130,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 291","pdfPage":283,"stem":"Bile is concentrated in the gallbladder to ………. times: (PGI Dec 2006, Dec 2001)","options":[{"letter":"A","text":"5"},{"letter":"B","text":"10"},{"letter":"C","text":"20"},{"letter":"D","text":"50"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"5, B. 10","explanation":"a. 5, b. 10 (Ref: Sabiston 20/e p1482; Schwartz 10/e p1309-1310; Bailey 26/e p1097-1098)"},{"n":131,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 291","pdfPage":283,"stem":"The gallbladder is capable of distending… mL: (Recent Question 2016)","options":[{"letter":"A","text":"10"},{"letter":"B","text":"20"},{"letter":"C","text":"40"},{"letter":"D","text":"50"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"50","explanation":"d. 50"},{"n":132,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 291","pdfPage":283,"stem":"Sentinel node of gallbladder is: (MAHE 2006)","options":[{"letter":"A","text":"Virchow’s nodes"},{"letter":"B","text":"Iris nodes"},{"letter":"C","text":"Clouquet node"},{"letter":"D","text":"Lymph node of Lund"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Lymph node of Lund","explanation":"• Extended cholecystectomy consists of cholecystectomy with en-bloc resection of segments IVB and V; including\nlymphadenectomy of the cystic duct, pericholedochal, periportal, and posterior pancreaticoduodenal and local\ninteraortocaval lymph nodes.\nAnswer (book): Answer: D. Lymph node of Lund"},{"n":133,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 292","pdfPage":283,"stem":"Sump syndrome occurs most commonly after: (COMEDK 2008)","options":[{"letter":"A","text":"Cholecystojejujunostomy"},{"letter":"B","text":"Choledochoduodenostomy"},{"letter":"C","text":"Mirizzi’s syndrome"},{"letter":"D","text":"Choledochojejunostomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Choledochoduodenostomy","explanation":"Sump Syndrome\n• Sump syndrome: Particulate matter, stones, and food debris accumulate and stagnate in the distal, “blind” end of\nthe common ductQ\n• Sump syndrome occurs after choledochoduodenostomyQ\n• Occasional cause of recurrent cholangitis that can result in anastomotic stricture Management\n• Endoscopic management, consisting of sphincterotomy with or without balloon dilation of the anastomosisQ\n• End-to-side hepaticojejunostomy, Roux-en-Y, to prevent persistent regurgitation of intestinal contents and to\nremove the “sump” permanently, is preferred surgical procedureQ.\nAnswer (book): Answer: B. Choledochoduodenostomy\nReference: Blumgart 6/e p711, 5/e p632; Shackelford 8/e p1356, 7/e p1355"},{"n":134,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 292","pdfPage":283,"stem":"True about cystic duct stump stone are all except: (PGI Nov 2009)","options":[{"letter":"A","text":"Stone cause of postoperative pain"},{"letter":"B","text":"Re-cholecystectomy is the definite treatment of choice"},{"letter":"C","text":"ERCP is the investigation of choice to diagnose"},{"letter":"D","text":"Basket extraction is the treatment of choice"},{"letter":"E","text":"Oral ursodeoxycholic acid relieves symptoms remarkably"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Re-cholecystectomy is the definite treatment of choice, E. Oral ursodeoxycholic acid relieves","explanation":"symptoms remarkably\nReference: Sabiston 20/e p1501-1504\nPostcholecystectomy Syndrome\n• The remnant of the cystic duct or gallbladder (in subtotal cholecystectomy) has historically been implicated as\nthe source of pain, nausea, and vomiting in postcholecystectomy patientsQ\n• An increase in choledochal pressure resulting in cystic stump distension, inflammation or stone obstruction within\nthe remnant of the cystic duct or gallbladderQ, and an increase in the sphincter of Oddi pressure have all served\nas causes of postcholecystectomy problems\n• However, various studies have confirmed that symptomatic improvement only occurs when a stone is present in\nthe CBD or cystic duct and is subsequently removed endoscopically or via operative reinterventionQ.\n• In general, persistent symptoms following a cholecystectomy in which no cholangiogram was performed warrants\nanalysis of the liver function profile and/or noninvasive imaging with either ultrasound or MRCP to assess for\nretained stone\n• If CBD stone are present, therapeutic ERCP is suggestedQ.\nAnswer (book): Answer: B. Re-cholecystectomy is the definite treatment of choice, E. Oral ursodeoxycholic acid relieves"},{"n":135,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 292","pdfPage":283,"stem":"Sphincter of Oddi consists of: (AIIMS May 2011)","options":[{"letter":"A","text":"2 sphincters"},{"letter":"B","text":"3 sphincters"},{"letter":"C","text":"4 sphincters"},{"letter":"D","text":"5 sphincter"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"4 sphincters","explanation":"• The entire sphincter mechanism is actually composed of four sphinctersQ containing both circular and\nlongitudinal smooth muscle fibers.\nSphincter of Oddi\n• The entire sphincteric system of the distal bile duct and the pancreatic duct is commonly referred to as the\nsphincter of Oddi.\n• The sphincter mechanism functions independently from the surrounding duodenal musculature and has separate\nsphincters for the distal bile duct, the pancreatic duct, and the ampulla.\n• In more than 90% of the population, the common channel, where the biliary and pancreatic ducts join, is <1.0 cm\nin length and lies within the ampulla. The four sphincters are\n1. Superior sphincter choledochusQ | 2. Inferior sphincter choledochusQ | 3. Sphincter pancreaticusQ | 4. Sphincter of\nthe ampullaQ\nAnswer (book): Answer: C. 4 sphincters\nReference: Shackelford 8/e p1253, 7/e p1290; Bailey 27/e p1214"},{"n":136,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 292","pdfPage":283,"stem":"Bleeding adjacent to the “Triangle of Calot” should be controlled by: (MHPGMCET 2009)","options":[{"letter":"A","text":"Pressing the artery manually"},{"letter":"B","text":"Blind clipping"},{"letter":"C","text":"Kocher’s artery forceps"},{"letter":"D","text":"Stitching"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pressing the artery manually","explanation":"Golden Rules to be Followed in Case of Difficult Cholecystectomy\n• When the anatomy of Callot’s triangle is not clear, blind dissection should not be doneQ\n• Bleeding adjacent to the Callot’s triangle should be controlled by pressure and not by clipping or clampingQ\n• When there is doubt about the anatomy, a fundus first cholecystectomy dissecting on gallbladder wall down to\nthe cystic duct can be helpfulQ.\n• If the cystic duct is densely adherent to CBD and there is possibility of Mirizzi’s syndrome, the infundibulum of the\nGB should be opened, the stone removed and infundibulum oversewnQ.\nAnswer (book): Answer: A. Pressing the artery manually\nReference: Blumgart 6/e p574, 5/e p525"},{"n":137,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 293","pdfPage":283,"stem":"“Limey bile” is: (Karnataka 94)","options":[{"letter":"A","text":"Present in the CBD"},{"letter":"B","text":"Thin and clear"},{"letter":"C","text":"Like toothpaste emulsion in the gallbladder"},{"letter":"D","text":"Bacteria rich"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Like toothpaste emulsion in the gallbladder","explanation":"c. Like toothpaste emulsion in the gallbladder (Ref: Harrison 20/e p2428, 19/e p2082)"},{"n":138,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 293","pdfPage":283,"stem":"Pain at the tip of shoulder is due to all except: (DNB 2008)","options":[{"letter":"A","text":"Peptic ulcer"},{"letter":"B","text":"Pancreatitis"},{"letter":"C","text":"Cholecystitis"},{"letter":"D","text":"Appendicitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Appendicitis","explanation":"Right Shoulder\nLeft Shoulder\nPeptic ulcer Myocardial ischemia Acute cholecystitis Liver disease (Abscess, cirrhosis, hepatitis) Pulmonary\n(Pleurisy, pneumothorax, Pancoast tumor) Kidney diseases\nRuptured spleen Myocardial ischemia Pancreatic diseases Ruptured ectopic Pulmonary (Pleurisy, pneumothorax,\nPancoast tumor) Kidney diseases Postoperative laparoscopy\nReferred Shoulder Pain\nAnswer (book): Answer: D. Appendicitis\nReference: Examination of Shoulder by Tae Kyun Kim/4"},{"n":139,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 293","pdfPage":283,"stem":"A middle aged patients presents with the complained of right hypochondrial pain. On X-ray, elevated right hemidiaphragm was seen. All of the following are the possible diagnoses except: (AIIMS Nov 2012)","options":[{"letter":"A","text":"Subphrenic abscess"},{"letter":"B","text":"Acute cholecystitis"},{"letter":"C","text":"Pyogenic liver abscess"},{"letter":"D","text":"Amoebic liver abscess in right lobe"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Acute cholecystitis","explanation":"Causes of Elevated Hemidiaphragm Above the diaphragm\nDiaphragm\nDecreased lung volume:\n• Atelectasis / collapse\n• Lobectomy / pneumonectomy\n• Pulmonary hypoplasia\n• Phrenic nerve palsy\n• Diaphragmatic eventration\n• Contralateral CVA: usually MCA distribution\nPhrygian cap\n• MC anomaly of the gallbladder\n• Created by an infolding of a septum between the body & fundusQ\n• GB functions normally\n• This anomaly is not an indication for cholecystectomyQ.\nQ\nAnswer (book): Answer: B. Acute cholecystitis\nReference: Sabiston 20/e p1493; Schwartz 9/e p1115-1116; http://radiopaedia.org/articles/elevated-hemidiaphragm"},{"n":140,"chapter":"Gallbladder","src":"question on PDF p. 283 · answer on PDF p. 293","pdfPage":283,"stem":"What is the name of this congenital anomaly seen on ultrasound?","options":[{"letter":"A","text":"Moynihan’s hump"},{"letter":"B","text":"Phrygian cap"},{"letter":"C","text":"Duplication"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Phrygian cap","explanation":"Below the Diaphragm\n• Abdominal tumour\n• Subphrenic abscess\n• Liver abscess (Amebic and pyogenic)\n151 MCQs · questions on PDF pp. 309–316 · answers and explanations on PDF pp. 317–325\nAnswer (book): Answer: B. Phrygian cap\nReference: Bailey 27/e p1195"},{"n":1,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Choledochal cyst in intrahepatic biliary tree: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"I"},{"letter":"B","text":"II"},{"letter":"C","text":"IVa"},{"letter":"D","text":"IVb"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"IVa","explanation":"c. IVa (Ref: Sabiston 20/e p1510-1511; Schwartz 10/e p1630; Bailey 27/e p1198; Blumgart 6/e p753, 5/e p707-719; Shackelford 8/e p1368, 7/e\np1397-1403)"},{"n":2,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Caroli’s disease is: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Type I choledochal cyst"},{"letter":"B","text":"Type III choledochal cyst"},{"letter":"C","text":"Type IV choledochal cyst"},{"letter":"D","text":"Type V choledochal cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Type V choledochal cyst","explanation":"p1374, 7/e p1402-1403\nCaroli's Disease (Type V Choledochal Cyst)\nCongenital malformation, consists of multiple sacular dilatations limited to the intrahepaticQ bile ducts (segmental\nbile ducts). About half the cases are associated with congenital hepatic fibrosisQ (affect interlobular bile ducts). Cyst\nwith congenital hepatic fibrosis is known as Grumbach’s diseaseQ. Portal hypertension is present in Caroli’s disease\nassociated with congenital hepatic fibrosisQ.\nClinical Features Symptoms include cholangitis (64%)Q, portal hypertension (22%), and abdominal pain (18%) More\ncommon in males Septa containing portal veins protrude into the lumen of the ectatic bile ducts (central dot sign)Q.\nThe main and often the only symptom of bacterial cholangitis secondary to Caroli’s disease is fever without\nabdominal pain and jaundice.\n• Frequent episodes of cholangitis indicates poor prognosisQ.\n• Most stones are pigmented in Caroli’s disease.\nDiagnosis\n• CT findings: Portal vein radicals can be seen after enhancement within dilated intra-hepatic bile ducts (central dot\nsign)Q. Treatment\n• Hepatic resection for localized diseaseQ\n• Liver transplantation for diffuse diseaseQ.\nAnswer (book): Answer: D. Type V choledochal cyst\nReference: Sabiston 20/e p 1511; Schwartz 10/e p1289, 1630; Bailey 27/e p1197; Blumgart 6/e p762, 5/e p717; Shackelford 8/e"},{"n":3,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"According to to Alonso-Lej classification, type IVb is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Both extra and intra-hepatic duct dilatation"},{"letter":"B","text":"Extra-hepatic duct dilatation"},{"letter":"C","text":"Intra-hepatic duct dilatation"},{"letter":"D","text":"Sub-hepatic duct dilatation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Extra hepatic-duct dilatation","explanation":"b. Extra hepatic-duct dilatation"},{"n":4,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"True about Todani’s modification of Alonso-Lej classification include the following except: (MHSSMCET 2008)","options":[{"letter":"A","text":"Type I = saccular dilation of common bile duct"},{"letter":"B","text":"Type II = diverticulum of supraduodenal bile duct"},{"letter":"C","text":"Type IVa = choledochocele"},{"letter":"D","text":"Type IVb = multiple saccular dilatations of extrahepatic ducts only"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Type IVa = choledochocele","explanation":"c. Type IVa = choledochocele"},{"n":5,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Most commonly seen choledochal cyst: (PGI May 2011)","options":[{"letter":"A","text":"Type I"},{"letter":"B","text":"Type II"},{"letter":"C","text":"Type III"},{"letter":"D","text":"Type IVa"},{"letter":"E","text":"Type V"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Type I","explanation":"a. Type I"},{"n":6,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Saccular diverticulum of extrahepatic bile duct in choledochal cyst is classified as: (COMEDK 2009)","options":[{"letter":"A","text":"Type I"},{"letter":"B","text":"Type II"},{"letter":"C","text":"Type III"},{"letter":"D","text":"Type IV"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Type II","explanation":"b. Type II"},{"n":7,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Reconstructive surgery for choledochal cyst is not done in: (MHSSMCET 2009)","options":[{"letter":"A","text":"Type I"},{"letter":"B","text":"Type II"},{"letter":"C","text":"Type III"},{"letter":"D","text":"Type IV"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Type III","explanation":"c. Type III"},{"n":8,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Choledochal cyst: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Resection decreases the incidence of malignancy but risk persists"},{"letter":"B","text":"80% cases have stones"},{"letter":"C","text":"Treated by Roux-en-Y cystojejunostomy"},{"letter":"D","text":"Type IV is most common"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Resection decreases the incidence of malignancy but risk persists","explanation":"Carcinoma in Choledochal Cyst\nMore than half tumors occur within the cyst itself (intracystic) and may recur after cyst excisionQ. Risk of\nmalignancy is decreased after cyst excision, but risk persist even after cyst excision (life long surveillance is\nrequired) Type I and IV cysts have the highest risk of cancer. When malignancy is present it is most commonly\nfound along the posterior cyst wallQ. Incidence of cyst malignancy is age relatedQ. Increased risk of following\ncancers\nBiliary tree (MC)Q\nPancreasQ\n• DuodenumQ\n• GallbladderQ\n• LiverQ\n• Cholangiocarcinoma is the MC malignancyQ associated with bile duct cysts.\nAnswer (book): Answer: A. Resection decreases the incidence of malignancy but risk persists\nReference: Sabiston 20/e p1511; Bailey 27/e p1197; Blumgart 6/e p758, 5/e p713; Shackelford 7/e p1399"},{"n":9,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Treatment of choice in choledochal cyst: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Roux-en-Y hepaticojejunostomy"},{"letter":"B","text":"Cystojejunostomy"},{"letter":"C","text":"Choledochoduodenostomy"},{"letter":"D","text":"Choledochojejunostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Roux-en-Y hepaticojejunostomy","explanation":"a. Roux-en-Y hepaticojejunostomy"},{"n":10,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"A 10-year-female presents with pain in the right hypochondrium, fever, jaundice and a palpable mass in the right hypochondrium. The probable diagnosis is: (COMEDK 2011)","options":[{"letter":"A","text":"Hepatitis"},{"letter":"B","text":"Hepatoma"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"Mucocele gallbladder"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Choledochal cyst","explanation":"c. Choledochal cyst"},{"n":11,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"A 10 years old female presented with recurrent attacks of cholangitis. CECT was done, the diagnosis on the basis of CECT is: (Recent Question 2017)","options":[{"letter":"A","text":"Type 1 choledochal cyst"},{"letter":"B","text":"Type 3 choledochal cyst"},{"letter":"C","text":"Type 4 choledochal cyst"},{"letter":"D","text":"Type 5 choledochal cyst"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Type 5 choledochal cyst","explanation":"p1402-1403\n\n• Central dot sign is seen in Caroli’s disease (Type V Choledochal cyst).\nAnswer (book): Answer: D. Type 5 choledochal cyst\nReference: Sabiston 20/e p15; Schwartz 10/e p1289; Bailey 27/e p1168; Blumgart 6/e p762, 5/e p717; Shackelford 8/e p1374, 7/e"},{"n":12,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Central dot sign is seen in: (Recent Question 2016, AIIMS May 2011, Nov 2008, ILBS 2012)","options":[{"letter":"A","text":"Primary sclerosing cholangitis"},{"letter":"B","text":"Liver Hamartoma"},{"letter":"C","text":"Caroli’s disease"},{"letter":"D","text":"Polycystic liver disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Caroli’s disease","explanation":"c. Caroli’s disease"},{"n":13,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"True about choledochal cyst is: (WBPG 2015, AIIMS Sep 96)","options":[{"letter":"A","text":"Always extrahepatic"},{"letter":"B","text":"Treatment is cystojejunostomy"},{"letter":"C","text":"Excision is ideal treatment"},{"letter":"D","text":"Drainage is treatment of choice"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Excision is ideal treatment","explanation":"c. Excision is ideal treatment"},{"n":14,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 317","pdfPage":309,"stem":"Not true regarding choledochal cyst: (AIIMS Nov 95)","options":[{"letter":"A","text":"Epigastric mass"},{"letter":"B","text":"Jaundice"},{"letter":"C","text":"Pain in abdomen"},{"letter":"D","text":"Cystojejunostomy is treatment of choice"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cystojejunostomy is treatment of choice","explanation":"d. Cystojejunostomy is treatment of choice\nExplanations"},{"n":15,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 318","pdfPage":309,"stem":"In case of choledochal cyst, bile diversion into the small intestine is not done because of the risk of:","options":[{"letter":"A","text":"Malignancy"},{"letter":"B","text":"Pancreatitis"},{"letter":"C","text":"Recurrent cholangitis"},{"letter":"D","text":"Gallstones"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Recurrent cholangitis","explanation":"c. Recurrent cholangitis"},{"n":16,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 318","pdfPage":309,"stem":"Clinical features of choledochal cyst in adult are: (UPSC 2004)","options":[{"letter":"A","text":"Pain, lump and intermittent jaundice"},{"letter":"B","text":"Pain, fever and intermittent jaundice"},{"letter":"C","text":"Pain, lump and progressive jaundice"},{"letter":"D","text":"Pain, fever and progressive jaundice"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pain, lump and intermittent jaundice","explanation":"Choledochal Cyst\n• Classic triad: Pain, jaundice (intermittent) and abdominal mass (10%)Q.\nAnswer (book): Answer: A. Pain, lump and intermittent jaundice"},{"n":17,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 318","pdfPage":309,"stem":"Choledochal cyst develops due to: (DNB 2006)","options":[{"letter":"A","text":"Stenosis of sphincter"},{"letter":"B","text":"Dysfunction of long circular fibre"},{"letter":"C","text":"Congenital"},{"letter":"D","text":"Iatrogenic"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Congenital","explanation":"c. Congenital"},{"n":18,"chapter":"Bile Duct","src":"question on PDF p. 309 · answer on PDF p. 318","pdfPage":309,"stem":"Choledochal cyst: (DPG 2006)","options":[{"letter":"A","text":"Mostly presents in adulthood"},{"letter":"B","text":"Excision is infrequently done"},{"letter":"C","text":"Presents as slowly progressive jaundice"},{"letter":"D","text":"Can lead to carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Can lead to carcinoma","explanation":"d. Can lead to carcinoma"},{"n":19,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Not true about choledochal cyst is: (AIIMS May 2009)","options":[{"letter":"A","text":"Associated with anomalous junction of the pancreatic and biliary duct"},{"letter":"B","text":"Type II is most common"},{"letter":"C","text":"Surgical removal is the treatment of choice"},{"letter":"D","text":"If ruptures can cause biliary peritonitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Type II is most common","explanation":"b. Type II is most common"},{"n":20,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Multiple intrahepatic bile duct dilation with bile lakes and concurrent sepsis is suggestive of: (MHSSMCET 2006)","options":[{"letter":"A","text":"Caroli’s disease"},{"letter":"B","text":"Watson Algali syndrome"},{"letter":"C","text":"Primary sclerosing cholangitis"},{"letter":"D","text":"Klatskin tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Caroli’s disease","explanation":"a. Caroli’s disease"},{"n":21,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"All of the following are true about choledochal disease except: (Recent Question 2017)","options":[{"letter":"A","text":"Type IV is Caroli’s disease"},{"letter":"B","text":"Type I is most common"},{"letter":"C","text":"Type III is also called choledochocele"},{"letter":"D","text":"Type II is diverticular disease"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Type IV is Caroli’s disease","explanation":"a. Type IV is Caroli’s disease (Ref: Sabiston 20/e p1510; Schwartz 10/e p1289; Bailey 27/e p1168)"},{"n":22,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Choledochocele is which type of choledochal cyst? (Recent Question 2017)","options":[{"letter":"A","text":"II"},{"letter":"B","text":"III"},{"letter":"C","text":"IV"},{"letter":"D","text":"V"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"III","explanation":"b. III (Ref: Sabiston 20/e p1510; Schwartz 10/e p1330; Bailey 27/e p1198)"},{"n":23,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Both intra and extrahepatic choledochal cyst is seen in: (Recent Question 2017)","options":[{"letter":"A","text":"II"},{"letter":"B","text":"III"},{"letter":"C","text":"IV"},{"letter":"D","text":"V"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"IV","explanation":"c. IV (Ref: Sabiston 20/e p1510; Schwartz 10/e p1330; Bailey 27/e p1198)"},{"n":24,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"The procedure of choice for elective removal of CBD stones for most patients is: (COMEDK 2006)","options":[{"letter":"A","text":"Open choledocholithotomy"},{"letter":"B","text":"Endoscopic papillotomy"},{"letter":"C","text":"Laparoscopic choledocholithotomy"},{"letter":"D","text":"Percutaneous choledocholithotomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endoscopic papillotomy","explanation":"• ERCP: Diagnostic and therapeutic test of choice for patients with suspected CBD stonesQ.`\nAnswer (book): Answer: B. Endoscopic papillotomy\nReference: Sabiston 20/e p1494-1496; Schwartz 10/e p1321-1322; Bailey 27/e p1205"},{"n":25,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"The Reynold’s pentad of fever, jaundice, right upper quadrant pain, septic shock and mental status change is typical of: (COMEDK 2008)","options":[{"letter":"A","text":"Cholangitis"},{"letter":"B","text":"Hepatitis"},{"letter":"C","text":"Cholecystitis"},{"letter":"D","text":"Pancreatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cholangitis","explanation":"a. Cholangitis (Ref: Sabiston 20/e p1507; Schwartz 10/e p1322-1323; Bailey 27/e p1205)"},{"n":26,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Association of choledocholithiasis in cholilithiasis: (GB Pant 2011)","options":[{"letter":"A","text":"< 5%"},{"letter":"B","text":"15%"},{"letter":"C","text":"20–35%"},{"letter":"D","text":"50%"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"15%","explanation":"b. 15% (Ref: Sabiston 20/e p1494; Schwartz 10/e p1321-1322; Bailey 27/e p1205)"},{"n":27,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"All are true about CBD stones except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Associated with GB stones in 10% cases"},{"letter":"B","text":"Primary stones are usually brown"},{"letter":"C","text":"Laboratory values may be normal in one third cases of choledocholithiasis"},{"letter":"D","text":"Retained stones are discovered after 2 years of cholecystectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Retained stones are discovered after 2 years of cholecystectomy","explanation":"d. Retained stones are discovered after 2 years of cholecystectomy"},{"n":28,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Which of the following calculi are rare in gallbladder, but common in common bile duct? (MHPGMCET 2008)","options":[{"letter":"A","text":"Cholesterol stone"},{"letter":"B","text":"Brown stone"},{"letter":"C","text":"Black stone"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Brown stone","explanation":"b. Brown stone"},{"n":29,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"What is the treatment of choice for recurrent CBD stones with multiple strictures in common bile duct?","options":[{"letter":"A","text":"Hepaticojejunostomy"},{"letter":"B","text":"Cutaneous hepaticojejunostomy"},{"letter":"C","text":"Cholecystectomy"},{"letter":"D","text":"ERCP and sphincterotomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cutaneous hepaticojejunostomy","explanation":"This is a case of recurrent pyogenic cholangitis. Cutaneous hepaticojejunostomy is preferred treatment\nmodality.\nTreatment of Recurrent Pyogenic Cholangitis\n• Treated with a multidisciplinary approach (endoscopy, interventional radiology, and surgery)\n• The long-term goal of therapy is to extract stones, remove debris, and relieve strictures.\n• Roux-en-Y hepaticojejunostomy with a subcutaneous afferent limb (Hudson loopQ) is a safe and effective way to\nprovide access to the biliary tree for stone extractionsQ.\nAnswer (book): Answer: B. Cutaneous hepaticojejunostomy"},{"n":30,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Treatment of CBD stone includes: (PGI May 2010)","options":[{"letter":"A","text":"Endoscopic papillotomy"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"Ursodeoxycholic acid"},{"letter":"D","text":"Hepaticojejunostomy"},{"letter":"E","text":"Choledochotomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Endoscopic papillotomy, B. ERCP, E. Choledochotomy","explanation":"a. Endoscopic papillotomy , b. ERCP, e. Choledochotomy"},{"n":31,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Charcot’s triad: (Recent Question 2014, JIPMER 2010, All India 96, 95)","options":[{"letter":"A","text":"Fever, abdominal pain, jaundice"},{"letter":"B","text":"Fever, vomiting, jaundice"},{"letter":"C","text":"Fever, jaundice, abdominal distension"},{"letter":"D","text":"Fever, diarrhea, jaundice"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Fever, abdominal pain, jaundice","explanation":"Charcot’s triadQ: Abdominal pain + jaundice + feverQ\n• Reynold’s pentadQ: Charcot’s triad + altered mental status + shock (hypotension)Q\nAnswer (book): Answer: A. Fever, abdominal pain, jaundice"},{"n":32,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Sphincterotomy of sphincter of Oddi is performed at: (DNB 2006)","options":[{"letter":"A","text":"3 O’clock position"},{"letter":"B","text":"6 O’clock position"},{"letter":"C","text":"9 O’clock position"},{"letter":"D","text":"11 O’clock position"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"11 O’clock position","explanation":"Transduodenal Sphincteroplasty\n• This cut is made superiorly (at the 11 o’clock position)Q for 4 to 5 mm.\n• The sphincter is incised at the 11–O’clock position to avoid injury to the pancreatic ductQ.\nAnswer (book): Answer: D. 11 O’clock position\nReference: Sabiston 20/e p1496; Schwartz 10/e p1327"},{"n":33,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Most common cause of cholangitis: (AIIMS June 94)","options":[{"letter":"A","text":"Viral infection"},{"letter":"B","text":"CBD stone"},{"letter":"C","text":"Surgery"},{"letter":"D","text":"Amebic infection"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CBD stone","explanation":"b. CBD stone"},{"n":34,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"A patient of post-cholecystectomy biliary stricture has undergone an ERCP three days ago. Following this, she has developed acute cholangitis. The most likely organism is: (All India 2006)","options":[{"letter":"A","text":"Escherichia coli"},{"letter":"B","text":"Bacillus fragilis"},{"letter":"C","text":"Streptococcus viridians"},{"letter":"D","text":"Pseudomonas aeruginosa"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Escherichia coli","explanation":"a. Escherichia coli"},{"n":35,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Which of the following statements is true regarding cholangitis? (PGI Dec 2001)","options":[{"letter":"A","text":"Increased leucocyte count"},{"letter":"B","text":"Increased transaminases"},{"letter":"C","text":"Increased alkaline phosphatase"},{"letter":"D","text":"Association with fever and chills"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Increased leucocyte count, B. Increased transaminases, C. Increased alkaline phosphatase, D.","explanation":"a. Increased leucocyte count, b. Increased transaminases, c. Increased alkaline phosphatase, d. Association with fever and chills"},{"n":36,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Not a feature of CBD stone: (AIIMS June 98)","options":[{"letter":"A","text":"Pain"},{"letter":"B","text":"Fever"},{"letter":"C","text":"Jaundice"},{"letter":"D","text":"Septic shock"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Septic shock","explanation":"d. Septic shock"},{"n":37,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"A 50-year-old woman presented with history of recurrent episodes of right upper abdominal pain for the last one year. She presented to casualty with history of jaundice and fever for 4 days. On examination, the patient appeared toxic and a blood pressure of 90/60 mmHg. She was started on intravenous antibiotics. Ultrasound of the abdomen showed presence of stones in the common bile duct. What would be the best treatment option for her? (AIIMS Nov 2003)","options":[{"letter":"A","text":"ERCP and bile duct stone extraction"},{"letter":"B","text":"Laparoscopic cholecystectomy"},{"letter":"C","text":"Open surgery and bile duct stone extraction"},{"letter":"D","text":"Lithotripsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"ERCP and bile duct stone extraction","explanation":"a. ERCP and bile duct stone extraction (Ref: Sabiston 20/e p1496, 1489; Schwartz 10/e p1321; Bailey 27/e p1205)"},{"n":38,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"What is more appropriate for diagnosis of CBD stones? (PGI June 97)","options":[{"letter":"A","text":"Ultrasonography"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"OCG"},{"letter":"D","text":"IV cholangiography"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ERCP","explanation":"b. ERCP"},{"n":39,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"A patient having multiple gallstones and shows 8 mm dilation and 4 stones in CBD. Best treatment modalities are: (PGI Dec 2002)","options":[{"letter":"A","text":"Cholecystectomy with choledocholithotomy at same setting"},{"letter":"B","text":"ESWL"},{"letter":"C","text":"Cholecystectomy and wait for ERCP"},{"letter":"D","text":"Sphincterotomy and then cholecystectomy"},{"letter":"E","text":"Cholecystectomy and after 14 days sphincterotomy done"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Sphincterotomy and then cholecystectomy","explanation":"Cholecystectomy with choledocholithotomy at same setting should not be done, as diameter of CBD is\n< 1 cm.\nAnswer (book): Answer: D. Sphincterotomy and then cholecystectomy"},{"n":40,"chapter":"Bile Duct","src":"question on PDF p. 310 · answer on PDF p. 318","pdfPage":310,"stem":"Best treatment modality for common bile duct stone is: (AIIMS Nov 94)","options":[{"letter":"A","text":"Endoscopic sphincterotomy"},{"letter":"B","text":"Observation"},{"letter":"C","text":"Chenodeoxycholic acid"},{"letter":"D","text":"Percutaneous removal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Endoscopic sphincterotomy","explanation":"a. Endoscopic sphincterotomy"},{"n":41,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 318","pdfPage":311,"stem":"The treatment of choice for an 8 mm retained common bile duct (CBD) stone is: (DNB 2011, AIIMS May 2005, Nov 2003)","options":[{"letter":"A","text":"Laparoscopic CBD exploration"},{"letter":"B","text":"Percutaneous stone extraction"},{"letter":"C","text":"Endoscopic stone extraction"},{"letter":"D","text":"Extracorporeal shock wave lithotripsy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Endoscopic stone extraction","explanation":"c. Endoscopic stone extraction"},{"n":42,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 318","pdfPage":311,"stem":"A patient presented 1 year after cholecystectomy with a CBD stone of 2.5 cm in size. Treatment of choice is: (KGMC 2011, AIIMS Nov 97, All India 99)","options":[{"letter":"A","text":"Supraduodenal choledochotomy with exploration"},{"letter":"B","text":"Transduodenal choledochojejunostomy"},{"letter":"C","text":"Transduodenal sphincterotomy"},{"letter":"D","text":"Endoscopic sphincterotomy with stone extraction"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Supraduodenal choledochotomy with exploration","explanation":"a. Supraduodenal choledochotomy with exploration"},{"n":43,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 318","pdfPage":311,"stem":"Which one of the following statement is incorrect regarding stone in the common bile duct? (All India 2006)","options":[{"letter":"A","text":"Can present with Charcot’s triad"},{"letter":"B","text":"Are suggested by a bile duct diameter >6 mm of ultrasound"},{"letter":"C","text":"ERCP, sphincterotomy and balloon clearance is now the standard treatment."},{"letter":"D","text":"When removed by exploration of the common bile duct the T-tube can be removed after 3 days"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"When removed by exploration of the common bile duct the T-tube can be removed after 3 days","explanation":"d. When removed by exploration of the common bile duct the T-tube can be removed after 3 days"},{"n":44,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 318","pdfPage":311,"stem":"Treatment for common bile duct stone is by: (PGI Dec 2001)","options":[{"letter":"A","text":"ESWL"},{"letter":"B","text":"Exploration of bile duct and recovery of stones"},{"letter":"C","text":"Bile duct stenting"},{"letter":"D","text":"Nasobiliary drainage"},{"letter":"E","text":"Percutaneous drainage"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"ESWL, B. Exploration of bile duct and recovery of stones, C. Bile duct stenting, D. Nasobiliary","explanation":"drainage, E. Percutaneous drainage\nReference: Shackelford 8/e p1287-1290, 7/e p1326-1331\nCholedocholithiasis: Treatment Options\n• ERCP stone extraction is successful 80–90% of the time using the techniques of sphincterotomy and balloon\ncatheter or Dormia basket stone retrieval. The addition of mechanical, electrohydraulic, laser, or extracorporeal\nshockwave lithotripsy for large stones increases the success rate to over 95%Q.\n• The placement of pancreatic stents has been found to reduce the incidence of postbiliary sphincterotomy\npancreatitisQ in patient suspected of sphincter of Oddi dysfunction.\n• In patients for whom ERCP is not available, not possible secondary to anatomic considerations, or not successful,\nan alternative method of cholangiography and nonsurgical therapy is percutaneous transhepatic cholangiography\n(PTC) followed by transhepatic methods of stone removal.\nAnswer (book): Answer: A. ESWL, B. Exploration of bile duct and recovery of stones, C. Bile duct stenting, D. Nasobiliary"},{"n":45,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Absolute indication for choledochotomy: (PGI June 2006)","options":[{"letter":"A","text":"Gallstone ileus"},{"letter":"B","text":"Gallstone pancreatitis"},{"letter":"C","text":"Fever"},{"letter":"D","text":"Jaundice"},{"letter":"E","text":"Palpable CBD stone"}],"multi":null,"correctSet":["E"],"answerIdx":4,"answerLetter":"E","answerText":"Palpable CBD stone","explanation":"Choledochotomy Absolute Indications (High suspicion of CBD calculi) Relative Indications (Low suspicion of CBD\ncalculi) Palpable CBD stonesQ\n• Jaundice without cholangitis Jaundice with cholangitisQ\n• History of pancreatitis Demonstration of stone on intra-operative\n• Dilated CBD cholangiographyQ\n• White bile on aspiration CBD diameter >12 mmQ\n• Dilated cystic duct\nAnswer (book): Answer: E. Palpable CBD stone\nReference: Shackelford 8/e p1290, 7/e p1326-1331"},{"n":46,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Ramu presents with recurrent attacks of cholelithiasis, USG examination shows a dilated CBD of 1 cm. The next line of management is: (AIIMS June 2001)","options":[{"letter":"A","text":"ERCP"},{"letter":"B","text":"PTC"},{"letter":"C","text":"Cholecystostomy"},{"letter":"D","text":"Intravenous cholangiogram"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"ERCP","explanation":"a. ERCP"},{"n":47,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Most common surgical cause of obstructive jaundice: (AIIMS Nov 94, AIIMS Nov 96, All India 98, 2000)","options":[{"letter":"A","text":"Periampullary carcinoma"},{"letter":"B","text":"Carcinoma gallbladder"},{"letter":"C","text":"Carcinoma head of pancreas"},{"letter":"D","text":"CBD stones"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"CBD stones 48.","explanation":"d. CBD stones"},{"n":48,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"What is more appropriate for diagnosis of CBD stones? (PGI 97)","options":[{"letter":"A","text":"Ultrasonography"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"OCG"},{"letter":"D","text":"IV cholangiography"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ERCP","explanation":"b. ERCP"},{"n":49,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"In cholangiography CBD stone appears as: (AIIMS June 98)","options":[{"letter":"A","text":"Meniscus sign"},{"letter":"B","text":"Cut off sign"},{"letter":"C","text":"Slight flow of dye from the sides"},{"letter":"D","text":"Ability to absorb water"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Meniscus sign","explanation":"• MR cholangiography: Typical “meniscus sign” is seen when CBD stoneQ is wedged at the level of the papilla.\nAnswer (book): Answer: A. Meniscus sign\nReference: Sutton 6/e p971"},{"n":50,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Common bile duct stones will manifest all except: (MCI March 2008, All India 89)","options":[{"letter":"A","text":"Distended gallbladder"},{"letter":"B","text":"Jaundice"},{"letter":"C","text":"Itching"},{"letter":"D","text":"Clay colored stools"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Distended gallbladder","explanation":"a. Distended gallbladder"},{"n":51,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"In cholangitis, the organism mostly responsible is: (Recent Questions 2016)","options":[{"letter":"A","text":"E. coli"},{"letter":"B","text":"Streptococcus"},{"letter":"C","text":"E. histolytica"},{"letter":"D","text":"Clostridium"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"E. coli","explanation":"• In obstruction of the CBD due to a stone, distention of gallbladder seldom occurs; the organ usually is shriveledQ.\nAnswer (book): Answer: A. E. coli"},{"n":52,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"An ultrasound examination shows dilated intrahepatic biliary channels with a small gallbladder. The most likely possibility is: (DPG 2010, Karnataka 94)","options":[{"letter":"A","text":"Gallbladder stone"},{"letter":"B","text":"Pancreatic calculus"},{"letter":"C","text":"Common bile duct stone"},{"letter":"D","text":"Carcinoma of the head of the pancreas"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Common bile duct stone","explanation":"Inexperienced Laparoscopic Surgeon\n• Pre-op ERCP with stone removal and laparoscopic cholecystectomy laterQ.\nInexperienced Laparoscopic Surgeon\n• Convert to open procedure and remove CBD stoneQ\n• Complete the cholecystectomy and refer the patient for ERCPQ\n• Conversion to an open procedure is preferred over ERCPQ, because the success rate of ERCP is not 100%Q.\nAnswer (book): Answer: C. Common bile duct stone\nReference: Bailey 27/e p1234"},{"n":53,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"The most common cause of suppurative cholangitis is: (UPPG 97)","options":[{"letter":"A","text":"Stone in common bile duct"},{"letter":"B","text":"Cancer of the ampulla of vater"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"Empyema of gallbladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stone in common bile duct","explanation":"a. Stone in common bile duct"},{"n":54,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"The procedure of choice for elective removal of CBD stones for most patients is: (Karnataka 2006)","options":[{"letter":"A","text":"Open choledocholithotomy"},{"letter":"B","text":"Endoscopic choledocholithotomy"},{"letter":"C","text":"Laparoscopic choledocholithotomy"},{"letter":"D","text":"Percutaneous choledocholithotomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endoscopic choledocholithotomy","explanation":"b. Endoscopic choledocholithotomy"},{"n":55,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Which of the following is not a component of Reynolds’ Pentad in toxic cholangitis? (DPG 2009 March)","options":[{"letter":"A","text":"Right upper quadrant pain"},{"letter":"B","text":"Confusion"},{"letter":"C","text":"Septic shock"},{"letter":"D","text":"Markedly elevated transaminases"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Markedly elevated transaminases","explanation":"d. Markedly elevated transaminases"},{"n":56,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Best treatment of acute suppurative cholangitis is: (DPG 2006)","options":[{"letter":"A","text":"Laparoscopic cholecystectomy"},{"letter":"B","text":"Open cholecystectomy"},{"letter":"C","text":"Endoscopic papillotomy"},{"letter":"D","text":"Choledochotomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Endoscopic papillotomy","explanation":"c. Endoscopic papillotomy"},{"n":57,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Leucine aminopeptidase is elevated in obstruction of: (BHU 88)","options":[{"letter":"A","text":"Ureter"},{"letter":"B","text":"Urethra"},{"letter":"C","text":"Common bile duct"},{"letter":"D","text":"Spermatic cord"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Common bile duct","explanation":"Leucine Aminopeptidase\n• Increased Leucine aminopeptidase (LAP) activity is seen in:\n– Carcinoma of the pancreas, choledocholithiasis, acute pancreatitisQ\n– Viral hepatitis, cirrhosis, carcinoma with liver metastasesQ\n• In common bile duct obstruction, whether due to carcinoma pancreas or choledocholithiasis, the elevated serum\nLAP levels returned to normal following relief of the obstruction. This is in agreement with the hypothesis that the\nincreased serum LAP activity in these conditions is the result of bile duct obstruction.\nAnswer (book): Answer: C. Common bile duct\nReference: American Journal of Gastroenterology; Dec 1963, Vol. 41 Issue 6, p620"},{"n":58,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"All of the following are seen with bile duct stone except: (MCI March 2008)","options":[{"letter":"A","text":"Obstructive jaundice"},{"letter":"B","text":"Distended and palpable gallbladder"},{"letter":"C","text":"Pruritus"},{"letter":"D","text":"Clay colored stools"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Distended and palpable gallbladder","explanation":"b. Distended and palpable gallbladder"},{"n":59,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"Management of stone in CBD includes following except: (PGI Nov 2011)","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Laparoscopic CBD exploration"},{"letter":"C","text":"Medical dissolution of stone"},{"letter":"D","text":"Endosphincteric removal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Observation, C. Medical dissolution of stone","explanation":"• Medical dissolution is used for Gallstones, not the CBD stones.\n• CBD stones are rarely asymptomatic, often present with complications. CBD stones should be treated, if\ndiagnosed. Treatment options are ERCP, laparoscopic or open CBD exploration.\nAnswer (book): Answer: A. Observation, C. Medical dissolution of stone\nReference: Bailey 27/e p1200; CSDT 11/e p1163"},{"n":60,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 319","pdfPage":311,"stem":"A surgeon with less experience of laparoscopic cholecystectomy while doing laparoscopic surgery found some stone in CBD. What should he ideally do? (AIIMS Nov 2011, AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Open cholecystectomy with choledochoduodeno-stomy"},{"letter":"B","text":"Lap CBD exploration and stone removal"},{"letter":"C","text":"Lap CBD exteraction through the cystic duct"},{"letter":"D","text":"Convert to open cholecystectomy and CBD stone removal"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Convert to open cholecystectomy and CBD stone removal","explanation":"Management of CBD Stones Associated with GB Stones Pre-operatively Detected Stones Unsuspected\nstones found at the time of Cholecystectomy Experienced Laparoscopic Surgeon Experienced Laparoscopic Surgeon\n• Cholecystectomy and choledochotomy in same • Laparoscopic CBD exploration and stone retrieval through the\ncystic sittingQ ductQ\n• Laparoscopic choledochotomy and stone extractionQ\nAnswer (book): Answer: D. Convert to open cholecystectomy and CBD stone removal\nReference: Shackelford 8/e p1290-1291, 7/e p1326-1331"},{"n":61,"chapter":"Bile Duct","src":"question on PDF p. 311 · answer on PDF p. 320","pdfPage":311,"stem":"Choledochotomy is indicated in all of the following except in patients with: (COMEDK 2010)","options":[{"letter":"A","text":"Palpable CBD stones"},{"letter":"B","text":"History of jaundice or cholangitis"},{"letter":"C","text":"Abnormal alkaline phosphatase"},{"letter":"D","text":"Abnormal gamma glutamyl transferase"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Abnormal gamma glutamyl transferase","explanation":"d. Abnormal gamma glutamyl transferase"},{"n":62,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"Best suture for common bile duct is: (JIPMER 95)","options":[{"letter":"A","text":"Synthetic absorbable"},{"letter":"B","text":"Synthetic non-absorbable"},{"letter":"C","text":"Non-synthetic absorbable"},{"letter":"D","text":"Non-synthetic non-absorbable"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Synthetic absorbable","explanation":"• Synthetic absorbable suture such as Vicryl is preferred for CBDQ.\n• Vicryl sutures are used in general soft tissue approximation and vessel ligationQ.\n• Non absorbable sutures ordinarily remain where they are buried within the tissues. This can cause late\ncomplications such as the development of Gallstones around non-absorbable sutures in the common bile duct or\nbladder stones in the urinary bladder. In these situations it is best to use absorbable materialsQ.\nAnswer (book): Answer: A. Synthetic absorbable\nReference: Shackelford 8/e p1290-1291, 7/e p2222-2224"},{"n":63,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"After exploration of common bile duct, the T-tube is removed on which of the following days? (Karnataka 96)","options":[{"letter":"A","text":"3rd postoperative day"},{"letter":"B","text":"4th postoperative day"},{"letter":"C","text":"12th postoperative day"},{"letter":"D","text":"6th postoperative day"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"12th postoperative day","explanation":"c. 12th postoperative day"},{"n":64,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"What is the name of this investigation?","options":[{"letter":"A","text":"ERCP"},{"letter":"B","text":"MRCP"},{"letter":"C","text":"T-tube cholangiogram"},{"letter":"D","text":"PTC"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T-tube cholangiogram","explanation":"c. T-tube cholangiogram (Ref: Sabiston 20/e p1501; Schwartz 10/e p1322)"},{"n":65,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"Cholangiography via T-tube done after how many days of cholecystectomy: (TN 99)","options":[{"letter":"A","text":"1–5 days"},{"letter":"B","text":"5–9 days"},{"letter":"C","text":"10–14 days"},{"letter":"D","text":"15–20 days"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"5–9 days","explanation":"b. 5–9 days"},{"n":66,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"After cholecystectomy a 2.5 cm calculus was found in CBD, treatment for this should be: (MHSSMCET 2006)","options":[{"letter":"A","text":"Supraduodenal choledochotomy"},{"letter":"B","text":"Transduodenal choledochotomy"},{"letter":"C","text":"Dormia basket removal"},{"letter":"D","text":"Choledochotomy and T tube"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Supraduodenal choledochotomy","explanation":"a. Supraduodenal choledochotomy"},{"n":67,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"A retained stone impacted in distal common bile duct is seen on T- tube cholangiogram. What is the best management of stone? (UPSC 2004)","options":[{"letter":"A","text":"Dissolution therapy"},{"letter":"B","text":"Operative removal"},{"letter":"C","text":"Endoscopic sphincterotomy and stone extraction"},{"letter":"D","text":"No active treatment is required"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Endoscopic sphincterotomy and stone extraction","explanation":"c. Endoscopic sphincterotomy and stone extraction"},{"n":68,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"Most common complication of common bile duct exploration: (DPG 2008)","options":[{"letter":"A","text":"Retained stone"},{"letter":"B","text":"Pancreatitis"},{"letter":"C","text":"Stricture of common bile duct"},{"letter":"D","text":"T-tube displacement"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Retained stone","explanation":"Most common complication of common bile duct exploration retained stone.\n• Clearance of all common bile duct stones is achieved in 75–95% of patients with laparoscopic CBD explorationQ.\n• The rate of retained CBD stone is <5%.\n• MC complication of laparoscopic CBD explorationQ is retained stone.\nLaparoscopic CBD Exploration (LCBDE)\n• An intraoperative cholangiogram at the time of cholecystectomy will also document the presence of CBD stonesQ.\n• LCBDE through the cystic duct or with formal choledochotomy allows the stones to be retrieved during the same\nprocedure.\n• If the expertise and instrumentation for laparoscopic CBD exploration are not available, a drain should be placed\nand left adjacent next to the cystic duct and an endoscopic cholangiogram performed the following day.\n• An open CBD exploration should be performed if endoscopic intervention is not available or not feasible because\nof anatomic restrictions or expertise.\n• If a choledochotomy is performed, a T tube is left in place.\n• The purpose of the T tube is to provide access to the biliary system for postoperative radiologic stone extractionQ\nand allow spasm or edema of sphincter to settle.\n• The size of the tube is therefore of importance, in that tubes <16 French do not allow for postoperative radiologic\ninstrumentation without dilation of the tract; a minimum of 4 to 6 weeks should pass for the tract to matureQ\nbefore instrumentation.\nAnswer (book): Answer: A. Retained stone\nReference: Sabiston 20/e p1496"},{"n":69,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"Endoscopic sphincterotomy is not successful in the following except: (MHSSMCET 2008)","options":[{"letter":"A","text":"Multiple duodenal diverticuli"},{"letter":"B","text":"Choledocholithiasis"},{"letter":"C","text":"Billroth type II Gastrostomy"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Choledocholithiasis","explanation":"b. Choledocholithiasis"},{"n":70,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"ERCP failure occurs in following except: (MHSSMCET 2008)","options":[{"letter":"A","text":"Smaller stone in CHD"},{"letter":"B","text":"Stenosis of papilla"},{"letter":"C","text":"High stricture"},{"letter":"D","text":"Malignant obstruction"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Smaller stone in CHD","explanation":"a. Smaller stone in"},{"n":71,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"All are true about bile duct injury except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Incidence is equal in laparoscopic and open cholecystectomy"},{"letter":"B","text":"After experience of 20 cases, bile duct injury rate decreases"},{"letter":"C","text":"Errors leading to laparoscopic bile duct injuries stem from misperception, not errors of skill, knowledge or judgment"},{"letter":"D","text":"Primary cause of error in most of the cases is visual perceptual illusion"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Incidence is equal in laparoscopic and open cholecystectomy","explanation":"a. Incidence is equal in laparoscopic and open cholecystectomy  (Ref: Sabiston 20/e p1501-1504; Schwartz 10/e p1332; Bailey 27/e\np1204)"},{"n":72,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"False about CBD injury: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Incidence in open cholecystectomy is 0.1-0.2%"},{"letter":"B","text":"Incidence in laparoscopic cholecystectomy is 0.5-0.8%"},{"letter":"C","text":"After 20 cases of laparoscopic cholecystectomy incidence of bile duct injury decreases"},{"letter":"D","text":"Most common reason for bile duct injury is lack of techniques and errors of judgment"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Most common reason for bile duct injury is lack of techniques and errors of judgment","explanation":"• As surgeon experience increases beyond 20 cases, the bile duct injury rate decreasesQ.\n• Errors leading to laparoscopic bile duct injuries stem from ‘misperception’Q, not erorrs of skill, knowledge or\njudgment.\n• The primary cause of error in 97% cases was a ‘visual perceptual illusion’Q, whereas only 3% injuries were due to\nfaults of technical skillsQ.\nAnswer (book): Answer: D. Most common reason for bile duct injury is lack of techniques and errors of judgment\nReference: Sabiston 19/e p1495"},{"n":73,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 320","pdfPage":312,"stem":"Biliary stricture developing after laparoscopic cholecystectomy usually occurs at which part of common bile duct? (Punjab 2008, All India 2006)","options":[{"letter":"A","text":"Upper"},{"letter":"B","text":"Middle"},{"letter":"C","text":"Lower"},{"letter":"D","text":"All with equal frequency"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Upper (Ref: Sabiston 20/e p1502","explanation":"• Most common duct injuries occur during attempted dissection of the cystic duct when the CBD is mistaken for\ncystic ductQ.\n• These injuries involve transection of the upper part of the CBDQ and excision of a variable portion of the CBD\nproximal to first transection, including cystic duct-common duct junction.\nThe Stewart-Way Classification of Laparoscopic Bile Duct Injury\nThe Stewart-Way classification of laparoscopic bile duct injury Class\nCriteria\nI.\nCBD mistaken for cystic duct but recognized; cholangiogram incision of cystic duct extended into CBD\nII.\nLateral damage to common hepatic duct from cautery or clips placed on duct; associated bleeding, poor visibility\nIII.\nCBD mistaken for cystic duct, not recognized; CBD, CHD, RHD, LHD transected or resected\nIV.\nRHD mistaken for cystic duct, RHA mistaken for cystic artery, RHD and RHA transected; lateral damage to the RHD\nfrom cautery or clips placed on ducts\n• The Stewart-Way classification is based primarily on the anatomic pattern and mechanism of a particular injury\nand the presence of associated vascular injury.\nAnswer (book): Answer: A. Upper (Ref: Sabiston 20/e p1502"},{"n":74,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"According to Strasberg classification, lateral CBD injuries are classified as: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Type B"},{"letter":"B","text":"Type C"},{"letter":"C","text":"Type D"},{"letter":"D","text":"Type E"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Type D","explanation":"c. Type D (Ref: Sabiston 20/e p1502; Shackelford 8/e p1355, 7/e p1381-1382)"},{"n":75,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"According to Bismuth Strasberg classification of bile duct injury, causing occlusion of a branch of biliary tree would be which type? (MHSSMCET 2010)","options":[{"letter":"A","text":"Type A"},{"letter":"B","text":"Type B"},{"letter":"C","text":"Type C"},{"letter":"D","text":"Type D"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Type B","explanation":"b. Type B"},{"n":76,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"Strasburg’s class ‘B’ bile injury means: (MHSSMCET 2010)","options":[{"letter":"A","text":"Bile leak from a minor duct"},{"letter":"B","text":"Occlusion of a branch of biliary tree"},{"letter":"C","text":"Injury of bile duct not in communication with CBD"},{"letter":"D","text":"Circumferential injury to major bile ducts"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Occlusion of a branch of biliary tree","explanation":"b. Occlusion of a branch of biliary tree"},{"n":77,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"In Strasberg Classification of bile duct injury, type C is: (MHSSMCET 2008)","options":[{"letter":"A","text":"Bile leak form a minor duct still in continuity with CBD"},{"letter":"B","text":"Injury form bile duct not in communication with CBD"},{"letter":"C","text":"Sectoral duct injury with consequent leak"},{"letter":"D","text":"Circumferential injury to major bile ducts"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Sectoral duct injury with consequent leak","explanation":"c. Sectoral duct injury with consequent leak"},{"n":78,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"Bile duct strictures are seen in: (PGI Dec 2008)","options":[{"letter":"A","text":"CBD stone"},{"letter":"B","text":"Cholangiocarcinoma"},{"letter":"C","text":"Chronic pancreatitis"},{"letter":"D","text":"Trauma"},{"letter":"E","text":"Acute pancreatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CBD stone, B. Cholangiocarcinoma, C. Chronic pancreatitis, D. Trauma","explanation":"Causes of Biliary Strictures Benign\n• Inflammatory:\n– StonesQ\n– Cholangitis\n– Parasitic\n– PancreatitisQ\n– Sclerosing cholangitisQ\n– Radiotherapy\n• Trauma\n• Idiopathic\nMalignant\nCholangiocarcinomaQ CA head of pancreas Ampullary carcinoma Metastasis to liver or biliary tract\n• MC cause of benign biliary stricture is laparoscopic cholecystectomy.\nAnswer (book): Answer: A. CBD stone, B. Cholangiocarcinoma, C. Chronic pancreatitis, D. Trauma\nReference: Sabiston 20/e p 1509-1510"},{"n":79,"chapter":"Bile Duct","src":"question on PDF p. 312 · answer on PDF p. 321","pdfPage":312,"stem":"A 40-year-old patient has undergone an open cholecystectomy. The procedure was reported as uneventful by the operating surgeon. She has 100 ml of bile output from the drain kept in the gallbladder bed on the first post operative day. On examination she is afebrile and anicteric. The abdomen is soft and bowel sounds are normally heard. As an attending physician, what should be your best possible advice: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Order an urgent endoscopic retrograde cholangiography and biliary stenting"},{"letter":"B","text":"Urgent laparotomy"},{"letter":"C","text":"Order an urgent hepatic imino diacetic acid scintigraphy (HIDA)"},{"letter":"D","text":"Clinical observation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Clinical observation","explanation":"• “A small amount of biliary drainage following cholecystectomy should cause no alarm because it usually\ndisappears within 1 or 2 daysQ. However, excessive biliary drainage through the wound or drain site, jaundice,\nsepsis or a combination of these events early in the post-operative period should suggest a bile duct injury, as\nshould copious biliary drainage for more than few post-op daysQ.”\nAnswer (book): Answer: D. Clinical observation\nReference: Sabiston 20/e p1503; Schwartz 10/e p1333; Bailey 27/e p1204"},{"n":80,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 321","pdfPage":313,"stem":"On 7th postoperative day after laparoscopic cholecystectomy, patient developed right upper abdominal pain and 10 cm × 8 cm collection. Treatment consists of: (PGI Dec 2003)","options":[{"letter":"A","text":"Immediate laparotomy"},{"letter":"B","text":"Percutaneous drainage"},{"letter":"C","text":"Laparotomy and surgical exploration of bile duct and T-tube insertion"},{"letter":"D","text":"Laparoscopic cystic duct ligation and percutaneous drainage"},{"letter":"E","text":"Roux-en-Y loop hepaticojejunostomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Percutaneous drainage","explanation":"b. Percutaneous drainage (Ref: Sabiston 20/e p1502-1503; Schwartz 10/e p1333; Bailey 27/e p1204)"},{"n":81,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 321","pdfPage":313,"stem":"On 5th postoperative day after laparoscopic cholecystectomy, a 50-year-old lady presented with right upper quadrant pain with fever and 12 cm subhepatic collection on CT and ERCP shows cystic duct leak. The best management is: (PGI June 2003)","options":[{"letter":"A","text":"Immediate laparotomy"},{"letter":"B","text":"Percutaneous drainage of fluid"},{"letter":"C","text":"Laparotomy and surgical exploration of bile duct and T-tube insertion"},{"letter":"D","text":"Laparoscopic cystic duct ligation and percutaneous drainage"},{"letter":"E","text":"Roux-en-Y loop hepaticojejunostomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Percutaneous drainage of fluid","explanation":"b. Percutaneous drainage of fluid (Ref: Sabiston 20/e p1503; Schwartz 10/e p1333; Bailey 27/e p1204)"},{"n":82,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 321","pdfPage":313,"stem":"5 days after CBD surgery there is a small leak. What will be the best treatment? (AIIMS June 98)","options":[{"letter":"A","text":"Ultrasound guided aspiration"},{"letter":"B","text":"ERCP and stenting"},{"letter":"C","text":"Re-exploration and hepaticojejunostomy"},{"letter":"D","text":"Re-exploration and primary repair"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ultrasound guided aspiration","explanation":"• Many bile leaks resolve with percutaneous drainage alone, and ERCP is probably unnecessary in the absence of\nradiographic or clinical evidence of ongoing bile drainage.\nAnswer (book): Answer: A. Ultrasound guided aspiration\nReference: Blumgart 6/e p701, 5/e p627"},{"n":83,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 321","pdfPage":313,"stem":"The initial investigation of choice for a post cholecystectomy biliary stricture is: (AIIMS May 2005)","options":[{"letter":"A","text":"Ultrasound scan of the abdomen"},{"letter":"B","text":"Endoscopic cholangiography"},{"letter":"C","text":"Computed tomography"},{"letter":"D","text":"Magnetic resonance cholangiography"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Computed tomography","explanation":"CT is probably the best initial study, the results of which help direct further investigations.\nRadiological Investigations in Post-Cholecystectomy Bile Duct Injury Duplex ultrasonography\n• Excellent, noninvasive means of showing intrahepatic ductal dilation and may reveal a subhepatic fluid collection\nor evidence of vascular damage.\n• May provide valuable information regarding the level of biliary injury, it is of little value in assessing the extent of\na stricture and is of no value if the biliary tree is decompressed.\n• Congenital:\n– Biliary atresiaQ\n• Operative injury:\n– CholecystectomyQ\n– CholedochotomyQ\n– Gastrectomy\n– Hepatic resection\n– Transplantation\nComputed tomography\n• CT is probably the best initial studyQ, the results of which help direct further investigations.\n• A good quality CT scan shows a dilated biliary tree and helps localize the level of ductal obstruction in patients\nwith strictures.\n• CT identifies fluid collections or ascites, which may suggest the possibility of vascular damage, and it reveals\nlobar atrophyQ. Percutaneous transhepatic cholangiography\n• PTC is much more likely than ERCP to provide this information, and PTC remains the standard investigation in this\nsettingQ. Magnetic resonance cholangiopancreatography\n• MRCP has emerged as a valuable tool in evaluating proximal bile duct injuries\n• This noninvasive modality provides striking images of the biliary tree and yields anatomic information in a single\nstudy that was previously obtainable only with CT and PTC ERCP\n• ERCP is seldom of value in the precise diagnosis of complete proximal bile duct strictures because there is often\ndiscontinuity of the CBD preventing visualization of the intrahepatic ductal systemQ.\n• ERCP may be more helpful for incomplete strictures (stenoses)Q\n• ERCP also has a role in the diagnosis and treatment of patients with bile leakage from the cystic duct stump or\nfrom a laceration of the common ductQ Isotopic scanning techniques\n• HIDA scanning offers a dynamic and quantitative assessment of liver function and of the clearance of bile across\nanastomosis and stenosis.\n• In patients with hepatocellular disease, HIDA scanning may be valuable in distinguishing the contribution of the\nbiliary obstruction from that of the intrinsic liver disease to the overall biochemical of isotope from a portion of\nthe liver. Arteriography and delayed-phase portography\n• Can be obtained to confirm vascular injury on the initial studies, a suspicion of portal hypertension from the\nhistory and physical examination, or a history of excessive bleeding at the time of cholecystectomy.\nAnswer (book): Answer: C. Computed tomography\nReference: Blumgart 6/e p701, 5/e p627"},{"n":84,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Regarding bile duct injuries following cholecystectomy which of the following statement is false? (AIIMS Nov 2005)","options":[{"letter":"A","text":"The incidences following open cholecystectomy is in the range of 0.2 to 0.3%"},{"letter":"B","text":"The incidence rate following laparoscopic cholecystectomy is three times higher than the rates following open cholecystectomy"},{"letter":"C","text":"Untreated cases may develop secondary biliary cirrhosis"},{"letter":"D","text":"Routine use of ‘open’ technique of laparoscopic port insertion has resulted in a decline in the incidence of post laparoscopic cholecystectomy bile duct injuries"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Routine use of ‘open’ technique of laparoscopic port insertion has resulted in a decline in the","explanation":"incidence of post laparoscopic cholecystectomy bile duct injuries\nReference: Sabiston 20/e p1498; Bailey 27/e p1203\n\n• Pneumoperitoneum is created by use of Hasson’s canula in open technique of laparoscopic port insertion.\n• Open technique has resulted in reduction of trocar induced vascular and bowel injuries, not the incidence of post\nlaparoscopic cholecystectomy bile duct injuries.\n• Open cholecystectomy is associated with reduced incidence of post laparoscopic cholecystectomy bile duct\ninjuries as compared to laparoscopic cholecystectomy.\nAnswer (book): Answer: D. Routine use of ‘open’ technique of laparoscopic port insertion has resulted in a decline in the"},{"n":85,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Common bile duct injuries are most commonly seen in: (UPSC 2008)","options":[{"letter":"A","text":"Radical gastrectomy"},{"letter":"B","text":"Penetrating injuries of abdomen"},{"letter":"C","text":"ERCP and sphincterotomy"},{"letter":"D","text":"Laparoscopic cholecystectomy operation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Laparoscopic cholecystectomy operation","explanation":"d. Laparoscopic cholecystectomy operation"},{"n":86,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Most common cause of biliary stricture is: (AIIMS June 94)","options":[{"letter":"A","text":"CBD stone"},{"letter":"B","text":"Trauma"},{"letter":"C","text":"Asiatic cholangitis"},{"letter":"D","text":"Congenital"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Trauma","explanation":"• MC cause of benign biliary stricture is laparoscopic cholecystectomy (operative trauma)Q.\nAnswer (book): Answer: B. Trauma"},{"n":87,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Most common cause of gallbladder fistula is: (DPG 2008)","options":[{"letter":"A","text":"Liver abscess aspiration"},{"letter":"B","text":"Laparoscopic surgery"},{"letter":"C","text":"Gallstones"},{"letter":"D","text":"Trauma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gallstones","explanation":"c. Gallstones (Ref: Blumgart 6/e p682, 5/e p645-669; Shackelford 8/e p1309, 7/e p1385)"},{"n":88,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Which does not contribute to enterobiliary fistula? (Punjab 2008)","options":[{"letter":"A","text":"Gastric ulcer"},{"letter":"B","text":"Duodenal ulcer"},{"letter":"C","text":"Carcinoma gallbladder"},{"letter":"D","text":"Gallstones"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gastric ulcer","explanation":"a. Gastric ulcer (Ref: Blumgart 6/e p685, 5/e p644-657)"},{"n":89,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"The ideal treatment of stenosis of sphincter of Oddi is: (SGPGI 2004)","options":[{"letter":"A","text":"Transduodenal sphincteroplasty"},{"letter":"B","text":"Endoscopic sphincteroplasty"},{"letter":"C","text":"Choledochojejunostomy"},{"letter":"D","text":"Choledochoduodenostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Transduodenal sphincteroplasty","explanation":"a. Transduodenal sphincteroplasty (Ref: Sabiston 20/e p1497; Shackelford 8/e p1297, 7/e p1333-1336)"},{"n":90,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Milwakukee classification is used for: (Recent Question 2016)","options":[{"letter":"A","text":"Sphincter of Oddi dysfunction"},{"letter":"B","text":"Abnormal pancreaticobiliary duct junction"},{"letter":"C","text":"Acute pancreatitis"},{"letter":"D","text":"Chronic pancreatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Sphincter of Oddi dysfunction","explanation":"a. Sphincter of Oddi dysfunction"},{"n":91,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Vanishing bile duct syndrome is seen in: (PGI June 2003)","options":[{"letter":"A","text":"Chronic viral hepatitis"},{"letter":"B","text":"Sarcoidosis"},{"letter":"C","text":"Lymphoma"},{"letter":"D","text":"Non-cirrhotic portal fibrosis"},{"letter":"E","text":"Alcoholism"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Sarcoidosis","explanation":"Vanishing Bile Duct Syndrome\n• Rare condition characterized by decreased number of bile ducts seen in liver biopsy specimensQ Causes of\nVanishing Bile Duct Syndrome\n• Chronic rejectionQ after liver transplantation\n• SarcoidosisQ\n• Graft-versus-host diseaseQ after BM transplantation • Drugs: ChlorpromazineQ\n• IdiopathicQ\nAnswer (book): Answer: B. Sarcoidosis\nReference: Harrison 20/e p280,1305, 19/e p2027-2028"},{"n":92,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 322","pdfPage":313,"stem":"Bile ductopenia seen in: (PGI Dec 2003)","options":[{"letter":"A","text":"GVHD"},{"letter":"B","text":"Alcoholic hepatitis"},{"letter":"C","text":"Autoimmune hepatitis"},{"letter":"D","text":"Cirrhosis"},{"letter":"E","text":"Sclerosing cholangitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"GVHD","explanation":"a. GVHD"},{"n":93,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 323","pdfPage":313,"stem":"Which of the following are histopathological features of Extra hepatic biliary atresia? (PGI June 2001)","options":[{"letter":"A","text":"Bile lakes"},{"letter":"B","text":"Hepatocyte ballooning degeneration"},{"letter":"C","text":"Marked bile duct degeneration"},{"letter":"D","text":"Fibrosis of hepatic duct"},{"letter":"E","text":"Parenchymal cholestasis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Marked bile duct degeneration, D. Fibrosis of hepatic duct, E. Parenchymal cholestasis","explanation":"c. Marked bile duct degeneration, d. Fibrosis of hepatic duct, e. Parenchymal cholestasis (Ref: Sabiston 20/e p639, 1880; Schwartz;\n10/e p1628-1630; Bailey 27/e p1196; Blumgart 6/e p656, 5/e p595-603; Shackelford 8/e p1361, 7/e p1390-1396)"},{"n":94,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 323","pdfPage":313,"stem":"The gold standard for the definitive diagnosis of the extrahepatic biliary atresia is: (Recent Question 2016, AIIMS, Nov 2002)","options":[{"letter":"A","text":"Per-operative cholangiography"},{"letter":"B","text":"Hepatobiliary scintigraphy"},{"letter":"C","text":"Alkaline phosphatase level"},{"letter":"D","text":"Liver biopsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Per-operative cholangiography","explanation":"“Despite these advancements in noninvasive imaging of hepatobiliary anatomy, intraoperative\ncholangiography remains the gold standard for diagnosing biliary atresia. Although endoscopic retrograde\ncholangiopancreatography (ERCP) may be possible, equipment and expertise in performing ERCP in infants is limited.\nPreoperative liver biopsy has become an increasingly safe and used method to help exclude other causes of neonatal\njaundice. Although percutaneous liver biopsy is highly accurate, there are no histologic findings that are\npathognomonic for BA. Findings suggestive of BA include portal or bridging fibrosis, bile duct proliferation,\ninflammation, or giant cell hepatitis, some of which may not be evident on samples taken from very young infants,\nthereby necessitating repeat biopsy at a later date.”- Blumgart 6/e p658\nAnswer (book): Answer: A. Per-operative cholangiography\nReference: Blumgart 6/e p658"},{"n":95,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 323","pdfPage":313,"stem":"Better prognostic factor for operation of biliary duct obstruction in newborn are: (PGI June 2001)","options":[{"letter":"A","text":"No passage of bile"},{"letter":"B","text":"Size of ductule >200 micron"},{"letter":"C","text":"Weight of baby >3 kg"},{"letter":"D","text":"Preterm baby"},{"letter":"E","text":"Age of 8 weeks"}],"multi":null,"correctSet":["E"],"answerIdx":4,"answerLetter":"E","answerText":"Age of 8 weeks","explanation":"Major Factors in Successful Outcome after Portoentreostomy\nAge in days at diagnosis and initial surgery (30–60 days)Q Length of time jaundice was present before surgeryQ\nSuccessful and persistent bile flow postoperativelyQ Size and nature of the microscopic ducts (>150 μm)Q\nDegree and extent of fibrotic changes in the liverQ Need for phototherapy as a neonateQ Technical aspects of the\nportoenterostomy and anastomosisQ Presence of bile in hepatic lobular zone 1\nAnswer (book): Answer: E. Age of 8 weeks\nReference: Blumgart 6/e p659, 5/e p600; Shackelford 8/e p1365, 7/e p1394"},{"n":96,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 323","pdfPage":313,"stem":"Kasai’s procedure is the treatment of choice for: (Recent Question 2017, Recent Question 2013, Orissa 2011)","options":[{"letter":"A","text":"Congenital hypertrophic pyloric stenosis"},{"letter":"B","text":"Duodenal atresia"},{"letter":"C","text":"Biliary atresia"},{"letter":"D","text":"Hirschprung’s disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Biliary atresia","explanation":"PRIMARY SCLEROSING CHOLANGITIS\nDiseases Associated with PSC Chronic ulcerative colitisQ\n• Crohn's diseaseQ\n• Autoimmune hepatitis\n• Chronic pancreatitis\nHypereosinophilia Riedel's thyroiditisQ Celiac disease Autoimmune hemolytic anemia Sicca syndrome\n• Smoking is protective in: PSC and UCQ\n• PBC is more common in femalesQ.\nAnswer (book): Answer: C. Biliary atresia"},{"n":97,"chapter":"Bile Duct","src":"question on PDF p. 313 · answer on PDF p. 323","pdfPage":313,"stem":"Association of PSC with all except: (ILBS 2012)","options":[{"letter":"A","text":"UC"},{"letter":"B","text":"ITP"},{"letter":"C","text":"Sarcoidosis"},{"letter":"D","text":"Retroperitoneal fibrosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ITP","explanation":"b. ITP (Ref: Sabiston 20/e p1508-1509; Schwartz 10/e p1331; Bailey 27/e p1206; Blumgart 6/e p663, 5/e p603-615; Shackelford 8/e p1378, 7/e\np1405-1414)\nDiseases Associated with PSC\n• Chronic ulcerative colitisQ\n• Crohn's diseaseQ\n• Autoimmune hepatitis\n• Chronic pancreatitis\n• Hypereosinophilia\n• Riedel's thyroiditisQ\n• Celiac disease\n• Autoimmune hemolytic anemia\n• Sicca syndrome\n• SarcoidosisQ\n• Glomerulonephritis\n• Retroperitoneal fibrosisQ\n• Systemic sclerosis\n•\t Smoking is protective in: PSC and UCQ  •\t PSC and Cholangiocarcinoma is more common in malesQ.\n•\t PBC is more common in femalesQ.   •\t Colectomy has no effect on the course of PSCQ."},{"n":98,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"False about PSC: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"PSC in UC, the association is 30%"},{"letter":"B","text":"Low incidence of cholangitis"},{"letter":"C","text":"Increased incidence of colonic carcinoma in PSC + UC"},{"letter":"D","text":"Despite the presence of diffuse disease, hepatic duct bifurcation is most severely strictured segment"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"PSC in UC, the association is 30%","explanation":"SarcoidosisQ Glomerulonephritis Retroperitoneal fibrosisQ Systemic sclerosis\n• PSC and Cholangiocarcinoma is more common in malesQ.\n• Colectomy has no effect on the course of PSCQ.\nAnswer (book): Answer: A. PSC in UC, the association is 30%"},{"n":99,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"A 50-year-old male presents with pain upper abdomen, pruritus, jaundice and weight loss, elevated ANA, the likely diagnosis is: (COMEDK 2011)","options":[{"letter":"A","text":"Primary sclerosing cholangitis"},{"letter":"B","text":"Klatskin tumor"},{"letter":"C","text":"Secondary sclerosing cholangitis"},{"letter":"D","text":"Choledocholithiasis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Primary sclerosing cholangitis","explanation":"a. Primary sclerosing cholangitis"},{"n":100,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"A 45 years old male presented with recurrent attacks of cholangitis. MRCP and ERCP findings are given below. What is the most probable diagnosis?","options":[{"letter":"A","text":"Primary biliary cirrhosis"},{"letter":"B","text":"Primary sclerosing cholangitis"},{"letter":"C","text":"Oriental cholangiohepatitis"},{"letter":"D","text":"Caroli’s disease"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Primary sclerosing cholangitis","explanation":"In the MRCP and ERCP image, there is presence of multiple strictures involving both intrahepatic and\nextrahepatic bile duct and history of repeated attacks of cholangitis is highly suggestive of primary sclerosing\ncholangitis.\nImage-based question: the picture / video this question refers to is on PDF p. 314 of the source and is not reproduced here.\nAnswer (book): Answer: B. Primary sclerosing cholangitis\nReference: Sabiston 20/e p1508-1509; Schwartz 10/e p1292; Bailey 27/e p1206"},{"n":101,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Primary sclerosing cholangitis is likely to be associated with: (JIPMER 2012, 2011)","options":[{"letter":"A","text":"Adenocarcinoma of pancreas"},{"letter":"B","text":"Cholangiocarcinoma"},{"letter":"C","text":"Hepatocellular carcinoma"},{"letter":"D","text":"Adenocarcinoma of gallbladder"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cholangiocarcinoma","explanation":"b. Cholangiocarcinoma"},{"n":102,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"“Onion skin” fibrosis of bile duct is seen in: (COMEDK 2009)","options":[{"letter":"A","text":"Primary biliary cirrhosis"},{"letter":"B","text":"Primary sclerosing cholangitis"},{"letter":"C","text":"Extrahepatic biliary fibrosis"},{"letter":"D","text":"Congenital hepatic fibrosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Primary sclerosing cholangitis","explanation":"b. Primary sclerosing cholangitis"},{"n":103,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Regarding PSC, all are true except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Cholangiocarcinoma is always intrahepatic"},{"letter":"B","text":"Management of PSC/UC does not alter the course of either disease"},{"letter":"C","text":"Patients with PSC or UC have pancolitis on majority"},{"letter":"D","text":"Patients with PSC or UC have more chances of CRC than UC alone"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cholangiocarcinoma is always intrahepatic","explanation":"a. Cholangiocarcinoma is always intrahepatic"},{"n":104,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"All are true about PSC except: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Commonly affect 40-45 years of age"},{"letter":"B","text":"More common in males"},{"letter":"C","text":"Most patients presents with advanced disease"},{"letter":"D","text":"Survival after diagnosis is 10–15 years"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Most patients presents with advanced disease","explanation":"c. Most patients presents with advanced disease"},{"n":105,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"True about primary sclerosing cholangitis are all except: (PGI June 2005)","options":[{"letter":"A","text":"Fibrosing cholestasis of bile duct"},{"letter":"B","text":"Periductal onion skin fibrosis"},{"letter":"C","text":"Cirrhosis never occurs"},{"letter":"D","text":"Jaundice is seen"},{"letter":"E","text":"Associated with UC"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cirrhosis never occurs","explanation":"c. Cirrhosis never occurs"},{"n":106,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"All of the following are true for patients of ulcerative colitis associated with primary sclerosing cholangitis, except: (All India 2005)","options":[{"letter":"A","text":"They may develop biliary cirrhosis"},{"letter":"B","text":"May have raised alkaline phosphatase"},{"letter":"C","text":"Increased risk of hilar cholangiocarcinoma"},{"letter":"D","text":"PSC reverts after a total colectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"PSC reverts after a total colectomy","explanation":"• Patients with PSC and ulcerative colitis typically have a more quiescent disease courseQ\n• The risk for colon cancer in these patients is up to five times greater than in patients with ulcerative colitis alone.\nThese tumors are more likely to arise proximal to the splenic flexure.\n• PSC is progressive and ultimately fatal unless liver transplantation is undertakenQ. Colectomy has no effect on\nthe course of\nAnswer (book): Answer: D. PSC reverts after a total colectomy"},{"n":107,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"A patient presenting with history of diarrhea for several years with recent onset pruritus and raised alkaline phosphatase, normal SGOT/PT and USG shows no gallstones and biliary tract abnormality, the diagnosis is: (PGI June 2004)","options":[{"letter":"A","text":"Hodgkin’s Lymphoma"},{"letter":"B","text":"Sclerosing cholangitis"},{"letter":"C","text":"Autoimmune Hepatitis"},{"letter":"D","text":"Viral Hepatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Sclerosing cholangitis","explanation":"b. Sclerosing cholangitis"},{"n":108,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"True regarding primary sclerosing cholangitis associated with ulcerative colitis are all of the following except: (MCI March 2007)","options":[{"letter":"A","text":"Biliary cirrhosis is a known complication"},{"letter":"B","text":"Increased risk of hilar cholangiocarcinoma"},{"letter":"C","text":"May have raised levels of alkaline phoshphatase"},{"letter":"D","text":"Primary sclerosing cholangitis resolves after total colectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Primary sclerosing cholangitis resolves after total colectomy","explanation":"d. Primary sclerosing cholangitis resolves after total colectomy"},{"n":109,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Pruritus precedes jaundice in: (ILBS 2011)","options":[{"letter":"A","text":"Primary biliary cirrhosis"},{"letter":"B","text":"Secondary biliary cirrhosis"},{"letter":"C","text":"Primary sclerosing cholangitis"},{"letter":"D","text":"CBD stone"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Primary biliary cirrhosis","explanation":"a. Primary biliary cirrhosis (Ref: Sabiston 20/e p639; Blumgart 6/e p1155, 5/e p1085-1086; Shackelford 8/e p1406, 7/e p1441)"},{"n":110,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"The earliest symptom in primary biliary cirrhosis is: (COMEDK 2008, 2007)","options":[{"letter":"A","text":"Jaundice"},{"letter":"B","text":"Pruritus"},{"letter":"C","text":"Melanosis"},{"letter":"D","text":"Vomiting"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pruritus","explanation":"b. Pruritus"},{"n":111,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Two most important clinical features of primary biliary cirrhosis: (PGI June 2003)","options":[{"letter":"A","text":"Generalized pruritus"},{"letter":"B","text":"Jaundice"},{"letter":"C","text":"Fatigue"},{"letter":"D","text":"Clubbing"},{"letter":"E","text":"Hematemesis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Generalized pruritus, C. Fatigue","explanation":"a. Generalized pruritus, c. Fatigue"},{"n":112,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Which is not true about PBC? (APPG 2008)","options":[{"letter":"A","text":"No increase in risk of hepatocellular carcinoma"},{"letter":"B","text":"Often asymptomatic"},{"letter":"C","text":"Elevated IgM"},{"letter":"D","text":"Positive anti-mitochondrial antibody"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"No increase in risk of hepatocellular carcinoma","explanation":"a. No increase in risk of hepatocellular carcinoma"},{"n":113,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 323","pdfPage":314,"stem":"Commonest presentation of primary biliary cirrhosis: (All India 98)","options":[{"letter":"A","text":"Pruritus"},{"letter":"B","text":"Pain"},{"letter":"C","text":"Jaundice"},{"letter":"D","text":"Fever"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pruritus","explanation":"a. Pruritus"},{"n":114,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 324","pdfPage":314,"stem":"All of the following are true regarding RPC except: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Equal incidence in males and females"},{"letter":"B","text":"More common in left lobe of liver"},{"letter":"C","text":"All are pigmented stones"},{"letter":"D","text":"GB stones are present in >50% cases"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"GB stones are present in >50% cases","explanation":"GB stones are present in <50% casesQ.\nAnswer (book): Answer: D. GB stones are present in >50% cases\nReference: Sabiston 20/e p1507-1508; Blumgart 6/e p727, 5/e p680-697"},{"n":115,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 324","pdfPage":314,"stem":"Which of the following is not a risk factor for cholangiocarcinoma? (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Thorotrast"},{"letter":"B","text":"Radon"},{"letter":"C","text":"Dioxin"},{"letter":"D","text":"Aflatoxin"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Aflatoxin","explanation":"d. Aflatoxin (Ref: Sabiston 20/e p1514; Schwartz 10/e p1335-1338; Bailey 27/e p1205; Shackelford 8/e p1328, 7/e p1370)"},{"n":116,"chapter":"Bile Duct","src":"question on PDF p. 314 · answer on PDF p. 324","pdfPage":314,"stem":"Not a predisposing factor for cholangiocarcinoma: (Punjab 2007)","options":[{"letter":"A","text":"Asiatic cholangio-hepatitis"},{"letter":"B","text":"Cholelithiasis"},{"letter":"C","text":"Ulcerative colitis"},{"letter":"D","text":"Choledochal cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cholelithiasis","explanation":"• Choledocholithiasis, not the cholelithiasis is a risk factor for cholangiocarcinomaQ.\nAnswer (book): Answer: B. Cholelithiasis"},{"n":117,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"APBDJ is associated with: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Cholangiocarcinoma"},{"letter":"B","text":"CA GB"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"Anomalous Pancreaticobiliary Duct Junction (APBDJ)\n• An anomalous pancreaticobiliary union is considered to be present when the common channel is longer than 15\nmm. Three Types of APBDJ\n• Bp Type or Type 2: Insertion of the bile duct is in the pancreatic duct\n• Pb Type or Type 1: Pancreatic duct appears to join the common bile duct\n• Y type: Long common channel\n• Choledochal cyst is the MC associated abnormalityQ.\n• APBDJ is seen gallbladder cancer; gallbladder adenomyomatosis; cholangiocarcinoma; and pancreatitisQ.\nAnswer (book): Answer: D. All of the above\nReference: Sabiston 20/e p1514"},{"n":118,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Predisposing factor for cholangiocarcinoma: (MHSSMCET 2009)","options":[{"letter":"A","text":"PSC"},{"letter":"B","text":"Gallstones"},{"letter":"C","text":"Ankylostomiasis"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"PSC","explanation":"a. PSC"},{"n":119,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Cholangiocarcinoma has been associated with infection by: (Recent Question 2016, 2015, COMEDK 2004)","options":[{"letter":"A","text":"Paragonimus westermani"},{"letter":"B","text":"Clonorchis sinensis"},{"letter":"C","text":"Loa Loa"},{"letter":"D","text":"\u0000Schistosoma haematobium"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Clonorchis sinensis","explanation":"b. Clonorchis sinensis"},{"n":120,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Which of the following does not predispose to cholangiocarcinoma? (All India 96, AIIMS Feb 97)","options":[{"letter":"A","text":"Ulcerative colitis"},{"letter":"B","text":"Clonorchis sinensis"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"Chronic pancreatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Chronic pancreatitis","explanation":"d. Chronic pancreatitis"},{"n":123,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Non-resectability criteria in hilar cholangiocarcinoma are all except: (ILBS 2012)","options":[{"letter":"A","text":"Involvement of secondary biliary radicals bilaterally"},{"letter":"B","text":"Metastasis to celiac nodes"},{"letter":"C","text":"Involvement of right branch of portal vein"},{"letter":"D","text":"Contralateral involvement of bile duct"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Involvement of right branch of portal vein","explanation":"c. Involvement of right branch of portal vein (Ref: Sabiston 20/e p1514-1518; Schwartz 10/e p1335-1338; Bailey 27/e p1208; Blumgart 6/e\np826, 5/e p771-788; Shackelford 8/e p1331, 7/e p1370-1378)"},{"n":124,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Type II cholangiocarcinoma involve: (DNB 2011)","options":[{"letter":"A","text":"Division of both ducts and not extending outside"},{"letter":"B","text":"Common hepatic duct only"},{"letter":"C","text":"Secondary hepatic duct"},{"letter":"D","text":"Extending beyond hilum"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Division of both ducts and not extending outside","explanation":"a. Division of both ducts and not extending outside"},{"n":125,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"All are true about prognosis of cholangiocarcinoma except: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Scirrhous type has better prognosis than papillary"},{"letter":"B","text":"Major prognostic factors are margin status and tumor stage"},{"letter":"C","text":"Bile duct resection alone is associated with high chances of recurrence"},{"letter":"D","text":"Curative resection includes hepatic resection + bile duct resection + lymphadenectomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Scirrhous type has better prognosis than papillary","explanation":"a. Scirrhous type has better prognosis than papillary"},{"n":126,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Klatskin tumor is: (JIPMER 2010)","options":[{"letter":"A","text":"Merkel cell carcinoma of skin"},{"letter":"B","text":"Primitive neuroectodermal tumor of chest wall"},{"letter":"C","text":"Common hepatic duct tumor"},{"letter":"D","text":"Adenocarcinoma of anal canal"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Common hepatic duct tumor","explanation":"c. Common hepatic duct tumor"},{"n":127,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Most common site of cholangiocarcinoma: (AIIMS Nov 2011, May 2011, Nov 2008)","options":[{"letter":"A","text":"Distal biliary duct"},{"letter":"B","text":"Hilum"},{"letter":"C","text":"Intrahepatic duct"},{"letter":"D","text":"Multifocal"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hilum","explanation":"b. Hilum"},{"n":128,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"True regarding cholangiocarcinoma: (PGI SS Dec 2010)","options":[{"letter":"A","text":"Sclerosing variety is most common"},{"letter":"B","text":"Multifocal in 40%"},{"letter":"C","text":"Jaundice typically precedes pruritus"},{"letter":"D","text":"Adjuvant therapy improves survival"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Sclerosing variety is most common","explanation":"a. Sclerosing variety is most common"},{"n":129,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Cholangiocarcinoma histologically resembles:","options":[{"letter":"A","text":"Squamous cell type"},{"letter":"B","text":"Colloid cell type"},{"letter":"C","text":"Schirrhous type"},{"letter":"D","text":"Columnar cell type"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Schirrhous type","explanation":"c. Schirrhous type"},{"n":130,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"All are criteria of non-resectability in patients with hilar cholangiocarcinoma except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Hepatic duct involvement upto secondary radicals bilaterally"},{"letter":"B","text":"Encasement or occlusion of main portal vein proximal to its bifurcation"},{"letter":"C","text":"Atrophy of one lobe with encasement of contralateral portal vein branch"},{"letter":"D","text":"Atrophy of one lobe with ipsilateral involvement of secondary biliary radicals"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Atrophy of one lobe with ipsilateral involvement of secondary biliary radicals","explanation":"d. Atrophy of one lobe with ipsilateral involvement of secondary biliary radicals"},{"n":131,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Contraindication of resection in cholangiocarcinoma are all except: (ILBS 2011)","options":[{"letter":"A","text":"Involvement of main trunk of portal vein"},{"letter":"B","text":"Hepatic atrophy with contralateral bile duct encasement"},{"letter":"C","text":"Hepatic atrophy with contralateral portal vein encasement"},{"letter":"D","text":"Hepatic atrophy with ipsilateral bile duct involvement"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hepatic atrophy with ipsilateral bile duct involvement","explanation":"d. Hepatic atrophy with ipsilateral bile duct involvement"},{"n":132,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"ERCP is indicated for the following except: (Recent Question 2013)","options":[{"letter":"A","text":"Distal CBD tumor"},{"letter":"B","text":"Hepatic porta tumor"},{"letter":"C","text":"Proximal cholangiocarcinoma"},{"letter":"D","text":"Gallstone pancreatitis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Proximal cholangiocarcinoma","explanation":"c. Proximal cholangiocarcinoma"},{"n":133,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"According to Bismuth classification, type IV cholangiocarcinoma involves: (Recent Question 2015)","options":[{"letter":"A","text":"Common hepatic duct"},{"letter":"B","text":"Bifurcation only"},{"letter":"C","text":"Bifurcation and bilateral secondary intrahepatic ducts"},{"letter":"D","text":"Bifurcation and unilateral secondary intrahepatic ducts"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Bifurcation and bilateral secondary intrahepatic ducts","explanation":"c. Bifurcation and bilateral secondary intrahepatic ducts"},{"n":134,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"Most common site of metastasis in cholangiocarcinoma: (Recent Question 2016)","options":[{"letter":"A","text":"Liver"},{"letter":"B","text":"Bones"},{"letter":"C","text":"Lung"},{"letter":"D","text":"Pancreas"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Liver","explanation":"a. Liver"},{"n":135,"chapter":"Bile Duct","src":"question on PDF p. 315 · answer on PDF p. 324","pdfPage":315,"stem":"A 60-year-old male Shambhu presented with painless progressive jaundice. On examination, gallbladder was palpable. MRCP image is given. On the basis of findings of MRCP, most probable diagnosis is:","options":[{"letter":"A","text":"Hilar cholangiocarcinoma"},{"letter":"B","text":"Distal cholangiocarcinoma"},{"letter":"C","text":"Carcinoma gallbladder"},{"letter":"D","text":"Carcinoma pancreas"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Distal cholangiocarcinoma","explanation":"b. Distal cholangiocarcinoma (Ref: Sabiston 20/e p1514-1518; Schwartz 10/e p1335; Bailey 27/e p1208)\nHEMOBILIA"},{"n":136,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"Most common cause of hemobilia: (DNB 2005, 2000, AIIMS GIS 2003)","options":[{"letter":"A","text":"Trauma"},{"letter":"B","text":"Iatrogenic"},{"letter":"C","text":"Parasites"},{"letter":"D","text":"Tumors"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Iatrogenic","explanation":"b. Iatrogenic (Ref: Sabiston 20/e p1472-1474; Blumgart 6/e p1915, 5/e p1832-1843; Shackelford 8/e p1275, 7/e p1487)"},{"n":137,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"Not true of hemobilia: (DNB 2010, Punjab 2009, ComedK 2007)","options":[{"letter":"A","text":"GI bleeding"},{"letter":"B","text":"Fever"},{"letter":"C","text":"Jaundice"},{"letter":"D","text":"Colicky RUQ pain"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Fever","explanation":"b. Fever"},{"n":138,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"A patient presents with abdominal pain, jaundice and melena. The diagnosis is: (All India 2000)","options":[{"letter":"A","text":"Hemobilia"},{"letter":"B","text":"Acute cholangitis"},{"letter":"C","text":"Carcinoma gallbladder"},{"letter":"D","text":"Acute pancreatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hemobilia","explanation":"a. Hemobilia"},{"n":139,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"Cause of hemobilia are all except: (AIIMS June 2000)","options":[{"letter":"A","text":"Trauma to abdomen"},{"letter":"B","text":"Malignancy"},{"letter":"C","text":"Rupture of hepatic artery aneurysm"},{"letter":"D","text":"Hepatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hepatitis","explanation":"d. Hepatitis"},{"n":140,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"True regarding hemobilia: (DPG 2007)","options":[{"letter":"A","text":"Triad of jaundice, pain, melena"},{"letter":"B","text":"MC cause-rupture of portal vein into biliary system"},{"letter":"C","text":"MR angiography is the IOC"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Triad of jaundice, pain, melena","explanation":"a. Triad of jaundice, pain, melena\nBILHEMIA"},{"n":141,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"Best investigation for bilhemia is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"ERCP"},{"letter":"B","text":"MRCP"},{"letter":"C","text":"CT"},{"letter":"D","text":"EUS"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"ERCP","explanation":"a. ERCP (Ref: Sabiston 20/e p1473-1474; Blumgart 6/e p1926, 5/e p1843-1844; Shackelford 8/e p1453, 7/e p1488)"},{"n":142,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 324","pdfPage":316,"stem":"All are true about bilhemia except: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Biliary pressure > portal pressure"},{"letter":"B","text":"Diagnosed by ERCP"},{"letter":"C","text":"Death due to embolism of bile in lungs"},{"letter":"D","text":"Patient has hyperbilirubinemia with raised enzymes"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Patient has hyperbilirubinemia with raised enzymes","explanation":"d. Patient has hyperbilirubinemia with raised enzymes"},{"n":143,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"False statement about common bile duct: (PGI May 2011)","options":[{"letter":"A","text":"Lies in free margin of lesser omentum"},{"letter":"B","text":"Anterior to first part of duodenum"},{"letter":"C","text":"Right to hepatic artery"},{"letter":"D","text":"Anterior to portal vein"},{"letter":"E","text":"Open in second part of duodenum"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Anterior to first part of duodenum","explanation":"Choledochoduodenal or cholecystocolic fistula Tracheobiliary fistula Suppurative cholangitis Mirizzi’s\nsyndrome (due to cholecystoenteric fistula)\nAnswer (book): Answer: B. Anterior to first part of duodenum\nReference: Sabiston 20/e p1482-1484; Schwartz 10/e p1268, 1310-1311; Bailey 27/e p1188"},{"n":144,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"True regarding common bile duct is all except: (All India 2000)","options":[{"letter":"A","text":"Opens 10 cm distal to the pylorus"},{"letter":"B","text":"Lies anterior to IVC"},{"letter":"C","text":"Portal vein lies posterior to it"},{"letter":"D","text":"Usually opens into duodenum separate from the main pancreatic duct"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Usually opens into duodenum separate from the main pancreatic duct","explanation":"d. Usually opens into duodenum separate from the main pancreatic duct"},{"n":145,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Which of the following statements is true regarding the relation of bile duct? (PGI Dec 2005)","options":[{"letter":"A","text":"Posteriorly related to 1st part of duodenum"},{"letter":"B","text":"Related posteriorly to the tunnel of pancreatic head"},{"letter":"C","text":"Anteriorly related to 1st part of duodenum"},{"letter":"D","text":"Related to IVC posteriorly"},{"letter":"E","text":"It lies left to hepatic artery in the free border of lesser omentum"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Anteriorly related to 1st part of duodenum","explanation":"c. Anteriorly related to 1st part of duodenum (Ref: Sabiston 20/e p1482-1484)"},{"n":146,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Predominant blood supply to the supraduodenal bile duct is derived from: (All India 2012)","options":[{"letter":"A","text":"Vessels that run upward along the bile duct from the duodenal end of the duct such as the retroduodenal and gastroduodenal arteries"},{"letter":"B","text":"Vessels that run downward along the bile duct from the hepatic end of the duct such as the right hepatic artery"},{"letter":"C","text":"Vessels that arise from the hepatic artery proper run up along the CBD and supplies it with twigs in non-axial distribution"},{"letter":"D","text":"Vessels that arise from the cystic artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Vessels that run upward along the bile duct from the duodenal end of the duct such as the","explanation":"a. Vessels that run upward along the bile duct from the duodenal end of the duct such as the retroduodenal and gastroduodenal\narteries (Ref: Sabiston 20/e p1482-1483)"},{"n":147,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"All of the following conditions are associated with pneumobilia except:","options":[{"letter":"A","text":"Sphincterotomy"},{"letter":"B","text":"Rupture of hydatid cyst"},{"letter":"C","text":"Mirizzi’s syndrome"},{"letter":"D","text":"Gallstone ileus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Rupture of hydatid cyst","explanation":"Causes of Pneumobilia\n• Previous surgery (Papillotomy, choledochojejunostomy, ERCP with sphincterotomy)\n• Gallstone ileus\n• Emphysematous cholecystitis\nAnswer (book): Answer: B. Rupture of hydatid cyst\nReference: Sabiston 18/e p1570"},{"n":148,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Pneumobilia is seen in: (DNB 2001)","options":[{"letter":"A","text":"Gallstone ileus"},{"letter":"B","text":"Mirizzi’s syndrome"},{"letter":"C","text":"TPN"},{"letter":"D","text":"Volvulus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gallstone ileus > b. Mirizzi’s syndrome","explanation":"a. Gallstone ileus > b. Mirizzi’s syndrome"},{"n":149,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Normal length of CBD is: (DNB 2001)","options":[{"letter":"A","text":"7 cm"},{"letter":"B","text":"5 cm"},{"letter":"C","text":"3 cm"},{"letter":"D","text":"2 cm"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"7 cm","explanation":"a. 7 cm (Ref: Grays 39/e p1228)"},{"n":150,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Which of the following is true regarding the principle of use of MRCP? (AIIMS Nov 2012)","options":[{"letter":"A","text":"Intraluminal dye is used to create the three dimension view of the structures"},{"letter":"B","text":"Dye is instilled percutaneously first then MRI is used"},{"letter":"C","text":"Use of heavily T2-weighted image without contrast to create the three dimensional image of the biliary tree using MIP algorithm"},{"letter":"D","text":"Use of systemic Gadolinium as a contrast agent to create the three dimensional image of the biliary tree"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Use of heavily T2-weighted image without contrast to create the three dimensional image of the","explanation":"biliary tree using MIP algorithm\nReference: Blumgart 6/e p359-361, 5/e p315-315\nMRI cholangiography and MRI cholangiopancreatography (MRCP) are imaging techniques used to\nevaluate the biliary system. Heavily T2-weighted images are used to provide an overview of the biliary system and\npancreatic duct. Excellent diagnostic-quality images are obtainable, with high sensitivity and specificity for evaluation\nof biliary duct dilation, strictures, and intraductal abnormalities.\nMagnetic Resonance Cholangiopancreatography\nMIP (Maximum Intensity Projection) Algorithm\n• CE FAST (Fourier-acquired steady state) or FSE (Fat spinal echo) require image processing with a maximum\nintensity projection (MIP) algorithm, allowing rotation of summed image and display of the cholangiogram to best\nadvantage.\nAnswer (book): Answer: C. Use of heavily T2-weighted image without contrast to create the three dimensional image of the"},{"n":151,"chapter":"Bile Duct","src":"question on PDF p. 316 · answer on PDF p. 325","pdfPage":316,"stem":"Best method to visualize the proximal bile duct is by: (JIPMER November 2017)","options":[{"letter":"A","text":"Percutaneous transhepatic cholangiogram"},{"letter":"B","text":"EsUS"},{"letter":"C","text":"ERCP"},{"letter":"D","text":"Transabdominal USG"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Percutaneous transhepatic cholangiogram","explanation":"• The basic principle of MRCP is to use T2-weighted images, in which stationary or slowly moving fluid, including\nbile, is high in signal intensity; all the surrounding tissues, including retroperitoneal fat and the solid visceral\norgans, are lower in signal.\n• MR-specific techniques for obtaining cholangiographic images include two-dimensional and three-dimensional\nsequences, breathhold or non–breath-hold techniques, and respiratory gated techniques.\n• MRCP plays an important role in imaging benign disorders of the biliary and pancreatic system, and it is part of a\ncomprehensive imaging evaluation of malignancies of the biliary system.\n• MRCP is noninvasive, eliminating the morbidity associated with ERCP or PTC.\n• An additional advantage of MRCP includes visualization of the extrabiliary anatomy, allowing for exclusion or\ninclusion of alternative diagnoses.\n• Surgical clips may create an artifact known as susceptibility, which may obscure the region of interest by\nproducing areas of signal void. This artifact may mimic a stone, so caution must be used in evaluating MRCP\nimages in postoperative patients to avoid a false-positive diagnosis.\n250 MCQs · questions on PDF pp. 345–357 · answers and explanations on PDF pp. 358–371\nAnswer (book): Answer: A. Percutaneous transhepatic cholangiogram\nReference: Schwartz 10/e p1315; Sabiston 20/e p1489; Bailey 27/e p1193"},{"n":1,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following is the most common non-alcoholic cause of acute pancreatitis? (COMEDK 2008, 2007)","options":[{"letter":"A","text":"Thiazides"},{"letter":"B","text":"Hypercalcemia"},{"letter":"C","text":"Hyperlipidemia"},{"letter":"D","text":"Gallstones"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Gallstones","explanation":"d. Gallstones (Ref: Sabiston 20/e p1525-1526; Schwartz 10/e p1351-1360; Bailey 27/e p1222; Blumgart 6/e p883, 5/e p836-845; Shackelford\n8/e p1128, 7/e p1123; Harrison 20/e p2438, 19/e p2091)"},{"n":2,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"The commonest cause of acute pancreatitis is: (COMEDK 2008)","options":[{"letter":"A","text":"Biliary calculi"},{"letter":"B","text":"Alcohol abuse"},{"letter":"C","text":"Infective"},{"letter":"D","text":"Idiopathic"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Biliary calculi","explanation":"a. Biliary calculi"},{"n":3,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Pancreatitis may be produced by following drug: (PGI Dec 96)","options":[{"letter":"A","text":"Colchicine"},{"letter":"B","text":"L-Asperaginase"},{"letter":"C","text":"Ciprofloxacin"},{"letter":"D","text":"Nalidixic acid"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"L-Asparaginase","explanation":"b. L-Asparaginase (Ref: Sabiston 20/e p1526; Schwartz 10/e p1351-1360; Bailey 27/e p1222)"},{"n":4,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Most common complication after ERCP is: (AIIMS May 2007)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Acute cholangitis"},{"letter":"C","text":"Acute cholecystitis"},{"letter":"D","text":"Duodenal perforation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute pancreatitis","explanation":"Complications of ERCP\n• Complications: Pancreatitis, hemorrhage, cholangitis and perforation.\n• MC complication is acute pancreatitis (5%)Q\n• Hemorrhage requires surgical intervention most commonly, sphincterotomy usually is converted into formal\nsurgical sphincteroplasty, which includes the bleeding artery Q.\n• Cholangitis is confined to patients in whom CBD clearance has not been achieved, and measures should be\ndirected at providing adequate bile drainage and administering parenteral antibiotics. Emergency surgery for\ncholangitis carries high risk, but is indicated in patients who do not improve within 24 hours Q.\n• Perforation may be asymptomatic and noticed only as retroperitoneal gas or extravasation of radiographic\ncontrast material, but even in symptomatic patient, conservative treatment is often effective with spontaneous\nresolution and avoidance of potentially difficult surgeryQ.\nAnswer (book): Answer: A. Acute pancreatitis\nReference: Sabiston 20/e p1526; Bailey 27/e p1222; Blumgart 6/e p889, 5/e p840; Shackelford 8/e p1076, 7/e p1123"},{"n":5,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Post-operative pancreatitis is seen in which type of surgery? (MHSSMCET 2005)","options":[{"letter":"A","text":"Billroth type I"},{"letter":"B","text":"Splenectomy"},{"letter":"C","text":"Nephrectomy"},{"letter":"D","text":"Cardiopulmonary bypass"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Splenectomy, D. Cardiopulmonary bypass","explanation":"Iatrogenic Pancreatitis\n• Acute pancreatitis can be associated with a number of surgical procedures, most commonly those performed on\nor close to the pancreas, such as pancreatic biopsy, biliary duct exploration, distal gastrectomy, and\nsplenectomy.\n• Acute pancreatitis is associated postoperatively with Billroth II gastrectomy and jejunostomy, in which increased\nintraduodenal pressure can cause backflow of activated enzymes into the pancreas.\n• Pancreatitis also can occur in association with surgery that uses low systemic perfusion, such as cardiopulmonary\nbypass and cardiac transplantation.\nAnswer (book): Answer: B. Splenectomy, D. Cardiopulmonary bypass\nReference: Schwartz 10/e p1352"},{"n":6,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following is not an etiological factor for pancreatitis? (AIIMS May 2014)","options":[{"letter":"A","text":"Abdominal trauma"},{"letter":"B","text":"Hyperlipidemia"},{"letter":"C","text":"Islet cell hyperplasia"},{"letter":"D","text":"Germline mutations in the cationic trypsinogen gene"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Islet cell hyperplasia","explanation":"c. Islet cell hyperplasia"},{"n":7,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following drug causes acute pancreatitis? (Recent Question 2017)","options":[{"letter":"A","text":"L-Asparaginase"},{"letter":"B","text":"Metronidazole"},{"letter":"C","text":"Ciprofloxacin"},{"letter":"D","text":"Penicillin"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Metronidazole","explanation":"b. Metronidazole (Ref: Sabiston 20/e p1526; Schwartz 10/e p1353; Bailey 27/e p1222)"},{"n":8,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following does not cause an increase in serum amylase? (COMEDK 2008)","options":[{"letter":"A","text":"Pancreatitis"},{"letter":"B","text":"Carcinoma lung"},{"letter":"C","text":"Renal failure"},{"letter":"D","text":"Cardiac failure"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cardiac failure","explanation":"Non-Pancreatic Causes of Hyperamylasemia\nBurns Pregnancy CholecystitisQ Aortic aneurysmQ Ruptured ectopic Diabetic ketoacidosis\nRenal transplantationQ Perforated Ulcer Chronic liver diseaseQ Intestinal obstructionQ Renal failureQ Drugs:\nMorphineQ\n• Salivary Gland Disorders: Mumps, Calculus, Maxillofacial surgeryQ\n• Tumors: Carcinoma of the Lung, Esophagus, Breast, Ovary (LEBO)Q\nAnswer (book): Answer: D. Cardiac failure\nReference: Sabiston 20/e p1524-1528; Schwartz 10/e p1351-1360; Bailey 27/e p1223"},{"n":9,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Poor prognostic factor in a patient with acute pancreatitis: (NEET Pattern, JIPMER 2011)","options":[{"letter":"A","text":"Leucocytosis >20,000/μL"},{"letter":"B","text":"↓ serum amylase"},{"letter":"C","text":"↓ serum lipase"},{"letter":"D","text":"Diastolic BP >90 mm Hg"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Leucocytosis >20,000/μL","explanation":"a. Leucocytosis >20,000/µL (Ref: Sabiston 20/e p1527-1528; Schwartz 10/e p1351-1360; Bailey 27/e p1223)"},{"n":10,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"A lady presents with three day history of epigastric pain radiating to back serum amylase levels were observed to be normal while USG abdomen reveals gallbladder stones and an enlarged pancreas. CT scan was done which clinched the diagnosis. Which of the following is the most likely diagnosis? (All India 2011)","options":[{"letter":"A","text":"Acute cholecystitis"},{"letter":"B","text":"Acute pancreatitis"},{"letter":"C","text":"Acute appendicitis"},{"letter":"D","text":"Acute peritonitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Acute pancreatitis","explanation":"b. Acute pancreatitis"},{"n":11,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Medical treatment of acute pancreatitis includes: (PGI Nov 2011)","options":[{"letter":"A","text":"Calcium"},{"letter":"B","text":"Glucagon"},{"letter":"C","text":"Aprotinin"},{"letter":"D","text":"Cholestyramine"},{"letter":"E","text":"Antibiotics"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Calcium, E. Antibiotics","explanation":"a. Calcium, e. Antibiotics (Ref: Harrison 20/e p2443 19, p2095-2096)"},{"n":12,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following criteria is/are not included in Ranson’s scoring? (PGI Nov 2011)","options":[{"letter":"A","text":"WBC >16,000/μl"},{"letter":"B","text":"Serum amylase >350 IU"},{"letter":"C","text":"Age > 55 years"},{"letter":"D","text":"Serum LDH >700 IU"},{"letter":"E","text":"Serum AST >250 U/dL"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Serum amylase >350 IU, D. Serum LDH >700 IU","explanation":"b. Serum amylase >350 IU, d. Serum LDH >700 IU"},{"n":14,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Ranson’s scoring for acute pancreatitis includes: (PGI May 2011)","options":[{"letter":"A","text":"Age >55 years"},{"letter":"B","text":"WBC >16,000/μL"},{"letter":"C","text":"Sequestration of fluid >6L"},{"letter":"D","text":"BUN >10 mg/dl"},{"letter":"E","text":"LDH >700 IU"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Age >55 years, B. WBC >16000/μL, C. Sequestration of fluid >6L","explanation":"a. Age >55 years, b. WBC >16000/µL, c. Sequestration of fluid >6L"},{"n":15,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following is most diagnostic investigation for acute pancreatitis? (MHPGMCET 2003)","options":[{"letter":"A","text":"Serum amylase"},{"letter":"B","text":"Serum lipase"},{"letter":"C","text":"Serum P-isoamylase"},{"letter":"D","text":"Serum LDH"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Serum lipase","explanation":"b. Serum lipase"},{"n":16,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 358","pdfPage":345,"stem":"Which of the following is not a feature of acute pancreatitis? (DNB 2011, Orissa 2011)","options":[{"letter":"A","text":"Hyperbilirubinemia"},{"letter":"B","text":"Hypercalcemia"},{"letter":"C","text":"Hyperglycemia"},{"letter":"D","text":"Increased serum LDH level"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hypercalcemia","explanation":"b. Hypercalcemia\nExplanations"},{"n":17,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 359","pdfPage":345,"stem":"Which of the following types of pancreatitis has the best prognosis? (APPG 2005, All India 2004)","options":[{"letter":"A","text":"Alcoholic pancreatitis"},{"letter":"B","text":"Gallstone induced pancreatitis"},{"letter":"C","text":"Post operative pancreatitis"},{"letter":"D","text":"Idiopathic pancreatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gallstone induced pancreatitis","explanation":"b. Gallstone induced pancreatitis (Ref: Oxford textbook of surgery 2/e p1766)\n•\t The prognosis is best in patients where pancreatitis is caused by a remediable cause such as cholelithiasisQ.\n•\t Eradication of gallstones prevents further attacks of pancreatitisQ."},{"n":18,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 359","pdfPage":345,"stem":"Which one is not the bad prognostic sign for pancreatitis? (AIIMS June 2000)","options":[{"letter":"A","text":"TLC >16,000/μL"},{"letter":"B","text":"Calcium <8 mmol/L"},{"letter":"C","text":"Glucose >200 mg%"},{"letter":"D","text":"Prothrombin >2 times the control"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Prothrombin >2 times the control","explanation":"d. Prothrombin >2 times the control"},{"n":19,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 359","pdfPage":345,"stem":"Which one is not poor prognostic factor for acute pancreatitis? (AIIMS Nov 99)","options":[{"letter":"A","text":"Hyperglycemia"},{"letter":"B","text":"Hypocalcemia"},{"letter":"C","text":"Raised LDH level in blood"},{"letter":"D","text":"Hyperamylasemia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hyperamylasemia","explanation":"d. Hyperamylasemia"},{"n":20,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 359","pdfPage":345,"stem":"Poor prognostic factor in acute pancreatitis is: (PGI Dec 96)","options":[{"letter":"A","text":"Increased serum amylase"},{"letter":"B","text":"Decreased calcium"},{"letter":"C","text":"Decreased blood sugar"},{"letter":"D","text":"Decreased PaO 2"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Decreased calcium, D. Decreased PaO2","explanation":"b. Decreased calcium, d. Decreased PaO2"},{"n":21,"chapter":"Pancreas","src":"question on PDF p. 345 · answer on PDF p. 359","pdfPage":345,"stem":"Destruction of fat in acute pancreatitis is due to: (MHCET 2016)","options":[{"letter":"A","text":"Lipase and trypsin"},{"letter":"B","text":"Secretin"},{"letter":"C","text":"Lipase and elastase"},{"letter":"D","text":"Cholecystokinin and trypsin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lipase and trypsin","explanation":"a. Lipase and trypsin"},{"n":22,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"All the following can be used to predict severe acute pancreatitis except:","options":[{"letter":"A","text":"Glasgow score > 3"},{"letter":"B","text":"APACHE II score > 8"},{"letter":"C","text":"CT severity score > 6"},{"letter":"D","text":"C-reactive protein <100"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"C-reactive protein <100","explanation":"Tools for Predicting Severity in Acute Pancreatitis Ready for Clinical Use On Admission\nAt 24 Hours\n• APACHE-II Score ≥8Q\n• IL-6\n• Urea >60 mmol/L\nAt 48 Hours\n• Polymorphonuclear elastase\n• Urinary trypsinogen 2\n• Urinary trypsinogen activation peptide\nAnswer (book): Answer: D. C-reactive protein <100\nReference: Sabiston 20/e p1527; Bailey 27/e p1223"},{"n":23,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Monu, a 30-years old male, a chronic alcoholic presents with sudden onset of epigastric pain that radiates to the back. All are seen except: (AIIMS June 2001)","options":[{"letter":"A","text":"Low serum lipase"},{"letter":"B","text":"Increased LDH"},{"letter":"C","text":"Hypocalcemia"},{"letter":"D","text":"Increased serum amylase"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Low serum lipase","explanation":"• The prognosis is best in patients where pancreatitis is caused by a remediable cause such as cholelithiasisQ.\n• Eradication of gallstones prevents further attacks of pancreatitisQ.\n• Ranson/Glasgow score ≥ 3Q\n• CRP ≥130Q mg/mL\nAnswer (book): Answer: A. Low serum lipase"},{"n":24,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"A 21-years old patient attended a party the previous night and gives the following symptoms, pain in abdomen radiating to back, pulse 100/min, BP 100/76; Temp 39°C and vomiting before coming. Most probable diagnosis is: (AIIMS Nov 99)","options":[{"letter":"A","text":"Acute appendicitis"},{"letter":"B","text":"Acute cholecystitis"},{"letter":"C","text":"Acute diverticulitis"},{"letter":"D","text":"Acute pancreatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Acute pancreatitis","explanation":"d. Acute pancreatitis"},{"n":25,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"The following conditions are indications of surgery in acute pancreatitis, except: (UPSC 2004)","options":[{"letter":"A","text":"Acute fluid collection"},{"letter":"B","text":"Persistent pseudocyst pancreas"},{"letter":"C","text":"Pancreatic abscess"},{"letter":"D","text":"Infective pancreatic necrosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute fluid collection","explanation":"Indications for Operative Treatment in Acute Pancreatitis\nFailure of non-operative management with at least 48 hours of maximal ICU supportQ Infected necrosisQ\nExtravisceral airQ Hemorrhage uncontrolled by interventional techniqueQ Colonic complicationsQ Operation is\nindicated for documented infection or for sterile pancreatic necrosisQ with persistent systemic illness.\n• All of the following patients presenting with abdominal pain and shock need immediate laparotomy except\nhemorrhagic pancreatitis. Bailey says “In peritonitis due to pancreatitis or salpingitis, or in cases of primary\nperitonitis of streptococcal or pneumococcal origin, non-operative treatment is preferredQ (if diagnosis can be\nmade with certainity).” Sabiston says “Ruptured ectopic is a surgical emergencyQ.” Definitive treatment of\nruptured aortic aneurysm is operation, not monitoring and rescuscitationQ Maingot’s says regarding liver\nhemangioma “Intra-abdominal hemorrhage is extremely uncommon, but when does it occur, it should be\nconsidered as a life threatening emergency and treated with combination of angiography with embolization and\nsurgeryQ.”\nAnswer (book): Answer: A. Acute fluid collection\nReference: Sabiston 20/e p1528-1529"},{"n":26,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"All of the following patients presenting with abdominal pain and shock need immediate laparotomy except: (DPG 2009 March)","options":[{"letter":"A","text":"Ruptured ectopic pregnancy"},{"letter":"B","text":"Hemorrhagic pancreatitis"},{"letter":"C","text":"Rupture abdominal aortic aneurysm"},{"letter":"D","text":"Ruptured liver hemangioma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hemorrhagic pancreatitis","explanation":"b. Hemorrhagic pancreatitis (Ref: Bailey 25/e p1144; Sabiston 20/e p1528; Maingot’s 11/e p786,977)\n•\t All of the following patients presenting with abdominal pain and shock need immediate laparotomy except hemorrhagic pancreatitis.\nBailey says “In peritonitis due to pancreatitis or salpingitis, or in cases of primary peritonitis of streptococcal or pneumococcal\norigin, non-operative treatment is preferredQ (if diagnosis can be made with certainity).”\nSabiston says “Ruptured ectopic is a surgical emergencyQ.”\nDefinitive treatment of ruptured aortic aneurysm is operation, not monitoring and rescuscitationQ\nMaingot’s says regarding liver hemangioma  “ Intra-abdominal hemorrhage  is extremely uncommon, but when does it occur,\nit should be considered as a life threatening emergency  and treated with combination of angiography with embolization and\nsurgeryQ.”"},{"n":27,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Acute pancreatitis is associated with all except: (DPG 2005)","options":[{"letter":"A","text":"Steatorrhoea"},{"letter":"B","text":"Epigastric tenderness"},{"letter":"C","text":"Upper abdominal pain"},{"letter":"D","text":"Cullen’s sign"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Steatorrhoea","explanation":"• Steatorrhoea is seen in chronic pancreatitis, not in acute pancreatitis.\nAnswer (book): Answer: A. Steatorrhoea"},{"n":28,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"A patient is admitted with severe pain in the abdomen, nausea, vomiting and fever. The most likely diagnosis is: (UPSC 97)","options":[{"letter":"A","text":"Perforated peptic ulcer"},{"letter":"B","text":"Intestinal obstruction"},{"letter":"C","text":"Acute pancreatitis"},{"letter":"D","text":"Acute cholecystitis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Acute pancreatitis","explanation":"c. Acute pancreatitis"},{"n":29,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"A 40-years-old male was brought to the hospital with acute pain in the upper abdomen. Patient was in shock with feeble pulse and tachycardia. There was tenderness present in the epigastrium. There is no blood in the gastric aspirate and the patient felt better after aspiration. X-ray abdomen showed no free gas under the diaphragm. Investigations revealed TLC 13500 serum bilirubin 2.0 mg and serum amylase 800 I.U. The most likely diagnosis is:","options":[{"letter":"A","text":"Acute cholecystitis"},{"letter":"B","text":"Acute pancreatitis"},{"letter":"C","text":"Acute appendicitis"},{"letter":"D","text":"Acute hepatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Acute pancreatitis","explanation":"b. Acute pancreatitis"},{"n":30,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Gasless abdomen in X-ray is a sign of: (Recent Question 2019)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Necrotizing enterocolitis"},{"letter":"C","text":"Ulcerative colitis"},{"letter":"D","text":"Intussusception"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute pancreatitis","explanation":"Radiological Appearance Acute Pancreatitis\n• Renal halo signQ\n• Gasless abdomenQ\n• Ground glass appearanceQ\n• Colon cut off signQ\n• Sentinel loopQ\nChronic Pancreatitis\nChain of lakes appearanceQ String of pearl appearanceQ Beaded appearanceQ Numerous irregular calcificationsQ\nare pathognomonic (on X-ray)\nCA Pancreas Double contour of medial border of duodenal C loop Double duct signQ Dilated / widening of duodenal\nC loopQ Mucosal irregularityQ Scrambled egg appearance Inverted / reverse 3 sign of FrostbergQ: Seening CA head\nof pancreas\n• Rose thorning of medial wall of 2nd part of duodenumQ\nAnswer (book): Answer: A. Acute pancreatitis\nReference: Sabiston 20/e p1527; Schwartz 10/e p1351-1360; Bailey 26/e p1128, 1135, 1138"},{"n":31,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Which of the following is not a component of APACHE score? (DNB 2012)","options":[{"letter":"A","text":"Serum potassium"},{"letter":"B","text":"Serum sodium"},{"letter":"C","text":"Serum calcium"},{"letter":"D","text":"Creatinine"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Serum calcium","explanation":"c. Serum calcium"},{"n":32,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Acute pancreatitis causes all except: (DNB 2007)","options":[{"letter":"A","text":"Pleural effusion"},{"letter":"B","text":"Pseudocyst"},{"letter":"C","text":"Gallbladder stone"},{"letter":"D","text":"Pancreatic necrosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gallbladder stone","explanation":"c. Gallbladder stone"},{"n":33,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Most common causes of death due to acute pancreatitis: (DNB 2001)","options":[{"letter":"A","text":"Shock"},{"letter":"B","text":"Infection"},{"letter":"C","text":"Hypocalcemia"},{"letter":"D","text":"Diabetes"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Infection","explanation":"b. Infection"},{"n":34,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"Which of the following does not correlate with severity of acute pancreatitis? (AIIMS Nov 2011, GB Pant 2010)","options":[{"letter":"A","text":"Serum glucose"},{"letter":"B","text":"Serum amylase"},{"letter":"C","text":"Serum calcium"},{"letter":"D","text":"AST"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Serum amylase","explanation":"b. Serum amylase"},{"n":35,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 359","pdfPage":346,"stem":"A 76-year-old male presents to the emergency with abdominal pain and an episode of binge drinking in shock with a BP of 70/50 mm Hg and HR of 115/min. The oxygen saturation of the patient is 70 mm Hg. Serum creatinine levels was 2.4 mg/dl. The patient had raised transaminases. What is the likely diagnosis based on the CT image shown below? (AIIMS May 2016)","options":[{"letter":"A","text":"Liver abscess"},{"letter":"B","text":"Acute pancreatitis"},{"letter":"C","text":"Acute pyelonephritis"},{"letter":"D","text":"Severe acute pancreatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Severe acute pancreatitis","explanation":"The CT image showing extensive pancreatic necrosis in combination with the acute clinical\npresentation is typical of severe acute pancreatitis.\nImage-based question: the picture / video this question refers to is on PDF p. 346 of the source and is not reproduced here.\nAnswer (book): Answer: D. Severe acute pancreatitis\nReference: Sabiston 19/1522-1523; Bailey 27/e p1223"},{"n":36,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 360","pdfPage":346,"stem":"Which of the following is not associated with Pancreatitis? (JIPMER 2014, 2011)","options":[{"letter":"A","text":"Raised serum amylase"},{"letter":"B","text":"Raised serum lipase"},{"letter":"C","text":"Hypocalcemia"},{"letter":"D","text":"Hypoglycemia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypoglycemia","explanation":"d. Hypoglycemia"},{"n":37,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 360","pdfPage":346,"stem":"CT severity index is a measure for: (Recent Question 2013)","options":[{"letter":"A","text":"Hepatitis"},{"letter":"B","text":"Pancreatitis"},{"letter":"C","text":"Cerebral trauma"},{"letter":"D","text":"Meningitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pancreatitis","explanation":"b. Pancreatitis"},{"n":38,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 360","pdfPage":346,"stem":"Balthazar scoring system is used for: (DNB 2014)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Acute appendicitis"},{"letter":"C","text":"Acute cholecystitis"},{"letter":"D","text":"Cholangitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute pancreatitis","explanation":"a. Acute pancreatitis"},{"n":39,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 360","pdfPage":346,"stem":"Ideal fluid of choice in a 35 years old man presenting with acute pancreatitis: (Recent Question 2018)","options":[{"letter":"A","text":"Isotonic crystalloid by IV line"},{"letter":"B","text":"Hypertonic saline by IV line"},{"letter":"C","text":"Hypotonic saline by central line"},{"letter":"D","text":"Vasopressin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Isotonic crystalloid by IV line","explanation":"“While there are proponents for aggressive fluid therapy and for specific resuscitation goals, it is\nprobably best to resuscitate with a balanced crystalloid and to restore normal blood volume, blood pressure, and\nurine output. On the basis of recent data it appears that lactated Ringer’s solution may be superior to normal saline in\nreducing the systemic inflammatory response.” —Schwartz 10/e p1358\nAnswer (book): Answer: A. Isotonic crystalloid by IV line\nReference: Sabiston 20/e p1528; Schwartz 10/e p1358; Bailey 27/e p1225"},{"n":40,"chapter":"Pancreas","src":"question on PDF p. 346 · answer on PDF p. 360","pdfPage":346,"stem":"A patient presented to the emergency with pain in epigastrium radiating to left back. X-ray abdomen was done. The finding seen in the X-ray is:","options":[{"letter":"A","text":"Sentinel loop"},{"letter":"B","text":"Colon cut off sign"},{"letter":"C","text":"Renal Halo sign"},{"letter":"D","text":"Ground glass appearance"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Colon cut off sign","explanation":"b. Colon cut off sign\nACUTE PANCREATITIS: COMPLICATIONS"},{"n":41,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 360","pdfPage":347,"stem":"Grey Turner’s sign (flank discoloration) is seen in: (MCI June 2018, COMEDK 2008)","options":[{"letter":"A","text":"Acute pyelonephritis"},{"letter":"B","text":"Acute cholecystitis"},{"letter":"C","text":"Acute pancreatitis"},{"letter":"D","text":"Acute peritonitis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Acute pancreatitis","explanation":"c. Acute pancreatitis"},{"n":42,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 360","pdfPage":347,"stem":"The given signs are seen in which of the following condition?","options":[{"letter":"A","text":"Mild acute pancreatitis"},{"letter":"B","text":"Severe acute pancreatitis"},{"letter":"C","text":"Mild chronic pancreatitis"},{"letter":"D","text":"Severe chronic pancreatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Severe acute pancreatitis","explanation":"Signs seen in Retroperitoneal bleeding associated with Severe Pancreatitis Grey Turner Sign\nEcchymosis in flank\nCullen’s sign Periumbilical ecchymosis\nFox sign Ecchymosis in inguinal region\nAnswer (book): Answer: B. Severe acute pancreatitis\nReference: Sabiston 20/e p1526; Schwartz 10/e p1356; Bailey 27/e p1019"},{"n":43,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 360","pdfPage":347,"stem":"Management of pancreatic abscess is: (UPSC 2008, AIIMS Nov 93)","options":[{"letter":"A","text":"Needle aspiration"},{"letter":"B","text":"Cystogastrostomy"},{"letter":"C","text":"External drainage"},{"letter":"D","text":"Cystojejunostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Needle aspiration, C. External drainage","explanation":"7/e p1127-1128\nSterile and Infected Peripancreatic Fluid Collections (Pancreatic Abscess)\n• The presence of acute abdominal fluid during an episode of AP has been described in 30-57% of patientsQ.\n• In contrast to pseudocysts and cystic neoplasias of the pancreas, fluid collections are not surrounded or encased\nby epithelium or fibrotic capsuleQ.\n• Treatment is supportive because most fluid collections will be spontaneously reabsorbedQ by the peritoneum.\n• Pancreatic abscess: The presence of fever, elevated WBC count, and abdominal pain suggest infection of this\nfluid and percutaneous aspiration is confirmatoryQ\n• Percutaneous drainage and IV administration of antibiotics should be instituted if infection (pancreatic abscess) Q\nis present\nAnswer (book): Answer: A. Needle aspiration, C. External drainage\nReference: Sabiston 20/e p1529; Schwartz 10/e p150-151; Bailey 27/e p1227; Blumgart 6/e p902 5/e p858; Shackelford 8/e p1079"},{"n":44,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 360","pdfPage":347,"stem":"Which is not a feature of pancreatic ascites? (PGI June 99)","options":[{"letter":"A","text":"Low protein"},{"letter":"B","text":"Somatostatin is the drug of choice"},{"letter":"C","text":"Communication with pancreatic duct in 80%"},{"letter":"D","text":"Raised amylase levels"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Low protein","explanation":"Pancreatic Ascites: Management\n• Pancreatic ascites occurs from a pancreatic duct disruption or from a leaking pseudocyst.\n• High amylase levels are found in the ascitic fluidQ.\n• Initial treatment: Non-operative (elimination of enteral feeding, institution of nasogastric drainage, and\nadministration of somatostatin) Q\n• Repeat paracentesis may also be helpful.\n• Roughly 50% to 60% of patients can be expected to respond to this treatment with resolution of pancreatic\nascites within 2 to 3 weeksQ. Persistent or recurrent ascites: endoscopic or surgical treatment\n• Endoscopic pancreatic sphincterotomy with or without placement of a transpapillary pancreatic duct stentQ.\n• Resection (for leaks in the pancreatic tail) or internal Roux-en-Y drainage (for leaks in the head and neck region)Q\nAnswer (book): Answer: A. Low protein\nReference: Schwartz 9/e p1204; Bailey 27/e p1228; Shackelford 7/e p1128"},{"n":45,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"When to do surgery in pancreatic ascites? (JIPMER May 2018)","options":[{"letter":"A","text":"Symptomatic"},{"letter":"B","text":"Recurrent ascites following abdominal drainage"},{"letter":"C","text":"Not responding to medical therapy"},{"letter":"D","text":"Leak from the stented duct"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Leak from the stented duct","explanation":"d. Leak from the stented duct (Ref: Schwartz 10/e p1378; Sabiston 20/e p1531; Bailey 27/e p1228)"},{"n":46,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Cullen’s sign: (UPPG 2007)","options":[{"letter":"A","text":"Bluish discoloration of the flanks"},{"letter":"B","text":"Bluish discoloration around umbilicus"},{"letter":"C","text":"Migratory thrombophlebitis"},{"letter":"D","text":"Subcutaneous fat necrosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bluish discoloration around umbilicus","explanation":"b. Bluish discoloration around umbilicus"},{"n":47,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Vascular complications of acute pancreatitis include the following except: (UPSC 2007)","options":[{"letter":"A","text":"Splenic vein thrombosis"},{"letter":"B","text":"Splenic artery aneurysm"},{"letter":"C","text":"Gastroduodenal artery aneurysm"},{"letter":"D","text":"Middle colic artery thrombosis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Middle colic artery thrombosis","explanation":"d. Middle colic artery thrombosis (Ref: Sabiston 20/e p1531; Schwartz 10/e p1351-1360; Bailey 27/e p1228)"},{"n":48,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Cullen’s sign is seen in: (Bihar PG 2014, Kerala 94)","options":[{"letter":"A","text":"Acute cholecystitis"},{"letter":"B","text":"Acute pancreatitis"},{"letter":"C","text":"Acute hemorrhagic pancreatitis"},{"letter":"D","text":"Blunt injury abdomen"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Acute hemorrhagic pancreatitis","explanation":"c. Acute hemorrhagic pancreatitis"},{"n":49,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"All are true about acute fluid collection except: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Not associated with fibrous wall"},{"letter":"B","text":"Most are extra-pancreatic"},{"letter":"C","text":"Commonly associated with hemosuccus pancreaticus"},{"letter":"D","text":"Most resolve spontaneously"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Commonly associated with hemosuccus pancreaticus","explanation":"c. Commonly associated with hemosuccus pancreaticus"},{"n":50,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Most common metabolic complication of acute pancreatitis: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Hyperglycemia"},{"letter":"B","text":"Hypocalcemia"},{"letter":"C","text":"Hypomagnesemia"},{"letter":"D","text":"Hyponatremia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Hypocalcemia","explanation":"• Most common metabolic complication of acute pancreatitis is hypocalcemiaQ.\nAnswer (book): Answer: B. Hypocalcemia"},{"n":51,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Hemorrhagic pancreatitis, bluish discoloration of flank: (Recent Question 2013)","options":[{"letter":"A","text":"Grey Turner sign"},{"letter":"B","text":"Cullen sign"},{"letter":"C","text":"Trousseau sign"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Grey Turner sign","explanation":"a. Grey Turner sign"},{"n":52,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"An infected necrosis is treated with: (Recent Question 2017)","options":[{"letter":"A","text":"IV antibiotics"},{"letter":"B","text":"Laparotomy and surgical debridement"},{"letter":"C","text":"USG guided drainage"},{"letter":"D","text":"TPN"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Laparotomy and surgical debridement","explanation":"b. Laparotomy and surgical debridement\nCHRONIC PANCREATITIS: ETIOLOGY ,"},{"n":53,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Hereditary chronic pancreatitis is caused by mutation of: (GB PANT 2010)","options":[{"letter":"A","text":"Cationic trypsinogen or PRSS1"},{"letter":"B","text":"CFTR"},{"letter":"C","text":"PTSI"},{"letter":"D","text":"SPINK1"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cationic trypsinogen or PRSS1","explanation":"a. Cationic trypsinogen or PRSS1  (Ref: Sabiston 20/e p1532; Schwartz 10/e p1362; Bailey 27/e p1230; Blumgart 6/e p915 5/e p861;\nShackelford 8/e p1087, 7/e p1134)"},{"n":54,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"All are true about chronic pancreatitis except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Characterized by irregularities of pancreatic ducts, duct strictures and areas of dilatation"},{"letter":"B","text":"60–80% will give history of acute episodes"},{"letter":"C","text":"CT scan showing pancreatic calcification is diagnostic of chronic pancreatitis"},{"letter":"D","text":"Serum amylase is always raised"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Serum amylase is always raised","explanation":"• Amylase and lipase levels are not always elevated in chronic pancreatitis, making the diagnosis often clinical.\nAnswer (book): Answer: D. Serum amylase is always raised\nReference: Sabiston 20/e p1531-1536; Schwartz 10/e p1360-1390; Bailey 27/e p1231"},{"n":55,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"True regarding chronic pancreatitis is/are: (PGI May 2018)","options":[{"letter":"A","text":"Can present with steatorrhea and malabsorption"},{"letter":"B","text":"Present with mid epigastric pain radiating to back"},{"letter":"C","text":"Markedly raised level of amylase & lipase"},{"letter":"D","text":"Predisposes to carcinoma"},{"letter":"E","text":"Complete pancreatectomy relieves pain in majority of patients"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Can present with steatorrhea, B. Present with mid epigastric pain radiating to back, D. Predisposes","explanation":"a. Can present with steatorrhea, b. Present with mid epigastric pain radiating to back, d. Predisposes to carinoma, e. Complete\npancreatectomy relieves pain in majority of patients (Ref: Schwartz 10/e p1371-1382; Sabiston 20/e p1531-1535; Bailey 27/e p1230-1233)"},{"n":56,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Most common symptom of chronic pancreatitis is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Abdominal pain"},{"letter":"B","text":"Cachexia"},{"letter":"C","text":"Weight loss"},{"letter":"D","text":"Steatorrhea"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Abdominal pain","explanation":"• Abdominal pain is the primary manifestation and MC symptom of chronic pancreatitisQ.\nAnswer (book): Answer: A. Abdominal pain"},{"n":57,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"All are seen in chronic calcific pancreatitis except: (Kerala 96)","options":[{"letter":"A","text":"Diabetes mellitus"},{"letter":"B","text":"Fat malabsorption"},{"letter":"C","text":"Hypercalcemia"},{"letter":"D","text":"Recurrent abdominal pain"},{"letter":"E","text":"Increased incidence of pancreatic carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hypercalcemia","explanation":"c. Hypercalcemia (Ref: Sabiston 20/e p1532; Schwartz 10/e p1360, 1366-1367; Bailey 27/e p1230; Harrison 20/e p2445, 19/e p2098)"},{"n":58,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Causes of chronic tropical pancreatitis is:","options":[{"letter":"A","text":"Parasitic infection"},{"letter":"B","text":"Cassava ingestion"},{"letter":"C","text":"Idiopathic"},{"letter":"D","text":"Genetic"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cassava ingestion","explanation":"b. Cassava ingestion"},{"n":59,"chapter":"Pancreas","src":"question on PDF p. 347 · answer on PDF p. 361","pdfPage":347,"stem":"Below mentioned ERCP is highly suggestive of:","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Chronic pancreatitis"},{"letter":"C","text":"Carcinoma pancreas"},{"letter":"D","text":"Cholangiocarcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chronic pancreatitis","explanation":"• Chain of lakes appearanceQ or String of pearl appearanceQ or Beaded appearanceQ is characteristic of chronic\npancreatitis.\nAnswer (book): Answer: B. Chronic pancreatitis\nReference: Sabiston 20/e p1535, 19/e p1521; Schwartz 10/e p1383; Bailey 27/e p1231"},{"n":60,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"“Chain of lakes” appearance seen in: (MHCET 2016, UPPG 2007, 2005)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Chronic pancreatitis"},{"letter":"C","text":"Carcinoma pancreas"},{"letter":"D","text":"Strawberry gallbladder"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chronic pancreatitis","explanation":"b. Chronic pancreatitis"},{"n":61,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Chronic calcific pancreatitis is associated with all of the following except: (MCI Sept 2005)","options":[{"letter":"A","text":"Hypercalcemia"},{"letter":"B","text":"Diabetes mellitus"},{"letter":"C","text":"Malabsorption of fat"},{"letter":"D","text":"Diabetes associated complications are uncommon"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hypercalcemia","explanation":"• Chronic pancreatitis is seen in all the given conditions\nAnswer (book): Answer: A. Hypercalcemia"},{"n":63,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"What is the most probable diagnosis based on the given X-ray? (Recent Question 2017)","options":[{"letter":"A","text":"Chronic pancreatitis"},{"letter":"B","text":"Acute pancreatitis"},{"letter":"C","text":"Trichobezoar"},{"letter":"D","text":"Phytobezoar"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Chronic pancreatitis","explanation":"In this X-ray, calcification is seen in epigastric region mainly towards left, along the course of\npancreatic duct, seen in chronic pancreatitis.\nAnswer (book): Answer: A. Chronic pancreatitis\nReference: Sabiston 20/e p1533; Schwartz 10/e p1369; Bailey 27/e p1231"},{"n":64,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Feature of chronic pancreatitis w.r.t. pancreatic cancer: (PGI May 2011)","options":[{"letter":"A","text":"Smooth pancreatic duct dilation with an abrupt interrup-tion"},{"letter":"B","text":"Calcification"},{"letter":"C","text":"Duct penetrating sign"},{"letter":"D","text":"Duct/gland width ration <0.5"},{"letter":"E","text":"Dilation of bile and pancreatic duct"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Calcification, C. Duct penetrating sign, E. Dilation of bile and pancreatic duct","explanation":"• Irregularity of the pancreatic duct, intraductal or parenchymal calcifications, diffuse pancreatic involvement, and\nnormal or smoothly stenotic pancreatic duct penetrating through the mass (duct penetrating sign) Q favor the\ndiagnosis of chronic pancreatitis over cancer.\nAnswer (book): Answer: B. Calcification, C. Duct penetrating sign, E. Dilation of bile and pancreatic duct\nReference: Bailey 25/e p1157; Sabiston 20/e p1533"},{"n":65,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"TIGAR-O classification is for: (MHSSMCET 2008)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Chronic pancreatitis"},{"letter":"C","text":"Pancreatic cancer"},{"letter":"D","text":"Pancreatic injuries"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chronic pancreatitis","explanation":"b. Chronic pancreatitis"},{"n":66,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Most common cause of chronic pancreatitis: (Recent Question 2018)","options":[{"letter":"A","text":"Gallstones"},{"letter":"B","text":"Alcohol"},{"letter":"C","text":"Hereditary"},{"letter":"D","text":"ERCP"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Alcohol","explanation":"b. Alcohol (Ref: Sabiston 20/e p1531; Schwartz 10/e p1362; Bailey 27/e p1230)"},{"n":67,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"All of the following are true about tropical pancreatitis except: (Recent Question 2017)","options":[{"letter":"A","text":"Caused by tapioca ingestion"},{"letter":"B","text":"Dilatation of pancreatic ducts with large stones with fibrosis"},{"letter":"C","text":"Increase the risk of pancreatic cancer"},{"letter":"D","text":"Treatment is mainly surgical"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Treatment is mainly surgical","explanation":"d. Treatment is mainly surgical (Ref: Sabiston 20/e p1532; Schwartz 10/e p1366; Bailey 27/e p1230)"},{"n":68,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Gold standard investigation for chronic pancreatitis: (DNB 2014)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"Pancreatic function tests"},{"letter":"D","text":"Fecal fat estimation"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"ERCP","explanation":"b. ERCP"},{"n":69,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Hereditary pancreatitis is characterized by all except: (JIPMER November 2017)","options":[{"letter":"A","text":"80% penetrance"},{"letter":"B","text":"30% leads to chronic pancreatitis"},{"letter":"C","text":"Autosomal recessive inheritance"},{"letter":"D","text":"Pancreatic cancer risk is high"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Autosomal recessive inheritance","explanation":"c. Autosomal recessive inheritance (Ref: Schwartz 10/e p1352; Sabiston 20/e p1882; Bailey 27/e p1230)"},{"n":70,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"All are true about pancreatic fistula in chronic pancreatitis except: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Most caseas resolve spontaneously by conservative treatment"},{"letter":"B","text":"Somatostatin is effective in fistula closure"},{"letter":"C","text":"In prevention of fistula, adherence to standardized and meticulous technique is more important than the pancreatic texture or the type of anastomosis used"},{"letter":"D","text":"Early intervention is required if associated with hemorrhage or sepsis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Somatostatin is effective in fistula closure","explanation":"• Trials have demonstrated the benefit of prophylactic octreotide in the prevention of pancreatic fistula; however\nthe role of octreotide, once fistula is established remains unclearQ. In such situations, the octreotide\nadministration is continued for upto 2 weeks, while in those who do not seem to respond, it is discontinued.\nAnswer (book): Answer: B. Somatostatin is effective in fistula closure\nReference: Blumgart 6/e p1010, 5/e p965; Shackelford 8/e p894, 7/e p1278-1280"},{"n":71,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 361","pdfPage":348,"stem":"Beger’s procedure: (Recent Question 2016, AIIMS GIS May 2008)","options":[{"letter":"A","text":"DPPHR"},{"letter":"B","text":"LRLPJ"},{"letter":"C","text":"Caudal pancreaticojejunostomy"},{"letter":"D","text":"Longitudinal pancreaticojejunostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"DPPHR","explanation":"p1138-1142\nResection Procedures in Chronic Pancreatitis\n• It is believed that inflammatory process in the pancreatic head controls both the severity of symptoms and\nfurther progression of disease in remainder of the gland\n• Pancreatic head is pacemaker of chronic pancreatitisQ.\n• Because of this resection of pancreatic head has been shown to completely relieve the pain of chronic\npancreatitis in 70-80%Q patients.\n• Distal pancreatectomy is the ideal procedure for patients whose chronic pancreatitis is confined to pancreatitis\ntailQ.\n• Usually, distal pancreatectomy is combined with splenectomy for technical reasons, but spleen can be preserved\nif its vascular supply is secure.\nAnswer (book): Answer: A. DPPHR\nReference: Sabiston 20/e p1535; Schwartz 10/e p1360-1390; Blumgart 6/e p934, 5/e p875-881; Shackelford 8/e p1198 7/e"},{"n":72,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 362","pdfPage":348,"stem":"Duval procedure in case of chronic pancreatitis involves: (AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"Distal resection of tail of pancreas with end to end pancreaticojejunostomy"},{"letter":"B","text":"Distal resection of tail of pancreas with longitudinal opening of duct and pancreaticojejunostomy"},{"letter":"C","text":"Duodenum preserving pancreatic head resection"},{"letter":"D","text":"Local section of pancreatic head with longitudinal pancreaticojejunostomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Distal resection of tail of pancreas with end to end pancreaticojejunostomy","explanation":"a. Distal resection of tail of pancreas with end to end pancreaticojejunostomy"},{"n":73,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 362","pdfPage":348,"stem":"A 50-year old lady presents with two years history of recurrent abdominal pain with radiation to her back. Pain is severe in intensity, and refractory to simple analgesics. Ultrasound and contrast enhanced CT scan (CECT) confirmed the diagnosis and showed a dilated pancreatic duct. Which of the following is the likely recommended surgical procedure of choice? (All India 2011)","options":[{"letter":"A","text":"Vagotomy with Antrectomy"},{"letter":"B","text":"Vagotomy with Gastrojejunostomy"},{"letter":"C","text":"Whipple’s Procedure"},{"letter":"D","text":"Longitudinal Pancreaticojejunostomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Longitudinal Pancreaticojejunostomy","explanation":"• Drainage procedure in the form of longitudinal pancreaticojejunostomy is the surgical treatment of choice for\nchronic pancreatitis with dilated ductsQ.\nAnswer (book): Answer: D. Longitudinal Pancreaticojejunostomy"},{"n":74,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 362","pdfPage":348,"stem":"A chronic alcoholic presents with abdominal pain radiating to the back that responds to analgesics. At evaluation the pancreatic duct was found to be dilated and stones were noted in the tail of pancreas. The most appropriate management is: (All India 2008)","options":[{"letter":"A","text":"Pancreatic tail resection"},{"letter":"B","text":"Pancreaticojejunostomy"},{"letter":"C","text":"Percutaneous removal of stone"},{"letter":"D","text":"Medical management"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Medical management","explanation":"• The patient has non-disabling pain that has responded to analgesia. Such patients should be best managed by\nnon-operative means. Medical management is the best option.\n• In the patients having severe pain, not relieved by analgesics with similar situation should be best managed with\nlongitudinal pancreaticojejunostomy.\nAnswer (book): Answer: D. Medical management"},{"n":75,"chapter":"Pancreas","src":"question on PDF p. 348 · answer on PDF p. 362","pdfPage":348,"stem":"Patient with chronic pancreatitis gives chain of lakes appearance in ERCP examination. Management is: (AIIMS Nov 2000)","options":[{"letter":"A","text":"Total pancreatectomy"},{"letter":"B","text":"Sphincteroplasty"},{"letter":"C","text":"Side to side pancreaticojejunostomy"},{"letter":"D","text":"Resecting the tail of pancreas and performing a pancreat ojejunostomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Side to side pancreaticojejunostomy","explanation":"c. Side to side pancreaticojejunostomy"},{"n":76,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Pain relief in chronic pancreatitis can be obtained by destruction of: (Recent Question 2016)","options":[{"letter":"A","text":"Celiac ganglia"},{"letter":"B","text":"Vagus nerve"},{"letter":"C","text":"Anterolateral column of spinal cord"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Celiac ganglia","explanation":"Chronic Pancreatitis\n• Pain from the pancreas is carried in sympathetic fibers that traverse the celiac ganglia, reach the sympathetic\nchain through the splanchnic nerves, and then ascend to the cortex\n• Celiac plexus nerve blocksQ performed either percutaneously or endoscopically have been employed to abolish\nthis pain with inconsistent results\nAnswer (book): Answer: A. Celiac ganglia\nReference: Sabiston 20/e p1534; Schwartz 10/e p1380; Bailey 27/e p1231"},{"n":77,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"In a patient with chronic pancreatitis limited to tail and body with MPD diameter 4 mm, ideal treatment would be: (MHSSMCET 2007)","options":[{"letter":"A","text":"Stenting"},{"letter":"B","text":"Puestow’s operation"},{"letter":"C","text":"Frey’s operation"},{"letter":"D","text":"Distal pancreatectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Distal pancreatectomy","explanation":"d. Distal pancreatectomy"},{"n":78,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Operation for chromic pancreatitis are the following except: (MHSSMCET 2009)","options":[{"letter":"A","text":"Beger’s procedure"},{"letter":"B","text":"Longitudinal pancreatojejunostomy"},{"letter":"C","text":"Frey procedure"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"None","explanation":"d. None"},{"n":79,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Complication of chronic pancreatitis include all except: (Recent Question 2013)","options":[{"letter":"A","text":"Renal artery stenosis"},{"letter":"B","text":"Pseudocyst"},{"letter":"C","text":"Splenic vein stenosis"},{"letter":"D","text":"Fistulae"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Renal artery stenosis","explanation":"a. Renal artery stenosis"},{"n":80,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"All of the following are true about chronic pancreatitis is except: (DNB 2014)","options":[{"letter":"A","text":"Damage to exocrine part with damage to endocrine part"},{"letter":"B","text":"Can lead to malignancy"},{"letter":"C","text":"Whipple’s procedure can be done"},{"letter":"D","text":"Gallbladder stone is the most common cause"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Gallbladder stone is the most common cause","explanation":"d. Gallbladder stone is the most common cause"},{"n":81,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Most common complication of both acute and chronic pancreatitis: (Recent Question 2017)","options":[{"letter":"A","text":"Portal vein thrombosis"},{"letter":"B","text":"Pancreatic abscess"},{"letter":"C","text":"Pseudocyst"},{"letter":"D","text":"Pancreatic necrosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pseudocyst","explanation":"c. Pseudocyst (Ref: Sabiston 20/e p1530)"},{"n":82,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"True about pseudocyst pancreas: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Cyst wall is lined by squamous epithelium"},{"letter":"B","text":"Endoscopic treatment may be curative"},{"letter":"C","text":"Always found in lesser sac"},{"letter":"D","text":"Always occur due to alcoholic pancreatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endoscopic treatment may be curative","explanation":"b. Endoscopic treatment may be curative (Ref: Sabiston 20/e p1530; Schwartz 10/e p1377; Bailey 27/e p1231; Shackelford 8/e p1100,\n7/e p1144-1148)"},{"n":83,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"A chronic alcoholic presented with repeated episodes of nonbilious vomiting after meals. On the basis of CECT findings, what is the diagnosis? (Recent Question 2016)","options":[{"letter":"A","text":"Gastric outlet obstruction"},{"letter":"B","text":"Pseudocyst"},{"letter":"C","text":"Carcinoma pancreas"},{"letter":"D","text":"Chronic pancreatitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pseudocyst","explanation":"b. Pseudocyst"},{"n":84,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Most common complication of pseudocyst: (DNB 2003, PGI SS Dec 2009)","options":[{"letter":"A","text":"Infection"},{"letter":"B","text":"Rupture"},{"letter":"C","text":"Hemorrhage"},{"letter":"D","text":"Compression"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Infection","explanation":"a. Infection"},{"n":85,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Major complication of cysto-gastrostomy for pseudopancreatic cyst is: (DPG 2011, COMEDK 2005)","options":[{"letter":"A","text":"Infection"},{"letter":"B","text":"Obstruction"},{"letter":"C","text":"Fistula"},{"letter":"D","text":"Hemorrhage"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hemorrhage","explanation":"• Serious post-op hemorrhage from cyst occurs from cystogastrostomyQ.\nAnswer (book): Answer: D. Hemorrhage\nReference: CSDT 11/e p638"},{"n":86,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Most common cause of pancreatic pseudocyst: (JIPMER 2010)","options":[{"letter":"A","text":"Blunt abdominal trauma"},{"letter":"B","text":"Pancreatic carcinoma"},{"letter":"C","text":"Pancreatitis"},{"letter":"D","text":"Post pancreatic surgery"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pancreatitis","explanation":"c. Pancreatitis"},{"n":87,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Most common artery involved in pancreatic pseudoaneurysm: (PGI Nov 2009)","options":[{"letter":"A","text":"Gastroduodenal artery"},{"letter":"B","text":"Inferior pancreatico-duodenal artery"},{"letter":"C","text":"Gastric artery"},{"letter":"D","text":"Splenic artery"},{"letter":"E","text":"Hepatic artery"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Splenic artery","explanation":"Artery Involved in Pseudoaneurysm associated with Pancreatic Pseudocyst\n• Splenic artery (30-50%): Most commonQ\n• Gastroduodenal artery (10-15%)\n• Inferior and superior pancreaticoduodenal artery (10%)\nAnswer (book): Answer: D. Splenic artery\nReference: Maingot 11/e p977"},{"n":88,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Pseudocyst of pancreas is: (MHPGMCET 2003)","options":[{"letter":"A","text":"Post traumatic cyst"},{"letter":"B","text":"Post inflammatory cyst"},{"letter":"C","text":"Congenital cyst"},{"letter":"D","text":"Neoplastic cyst"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Post inflammatory cyst","explanation":"b. Post inflammatory cyst"},{"n":89,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Most common cause of pseudopancreatic cyst in children is: (All India 99)","options":[{"letter":"A","text":"Choledochal cyst"},{"letter":"B","text":"Annular pancreas"},{"letter":"C","text":"Drug induced pancreatitis"},{"letter":"D","text":"Traumatic pancreatitis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Traumatic pancreatitis","explanation":"• Trauma is the most common cause of acute pancreatitis in children.\nPancreatic Trauma in Children\n• MC mechanism in children is abdominal blunt traumaQ.\n• Direct compression of the epigastrium against the vertebral column and a blunt object (handlebar) is typically\nseen after bicycle injuriesQ.\n• MC segment of the pancreas affected is the bodyQ.\nAnswer (book): Answer: D. Traumatic pancreatitis"},{"n":90,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"After 3 weeks of duration pancreatic pseudocyst 5 cm in size should be managed by which method? (AIIMS Nov 2000)","options":[{"letter":"A","text":"Cystogastrostomy"},{"letter":"B","text":"Needle aspiration"},{"letter":"C","text":"External drainage"},{"letter":"D","text":"USG and follow up"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"USG and follow up","explanation":"d. USG and follow up"},{"n":91,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Which one is not true regarding pseudocyst of pancreas? (AIIMS Nov 95)","options":[{"letter":"A","text":"Epigastric mass"},{"letter":"B","text":"Increase level of amylase"},{"letter":"C","text":"Cystogastrostomy is the ideal treatment"},{"letter":"D","text":"Percutaneous aspiration is the treatment"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Percutaneous aspiration is the treatment","explanation":"d. Percutaneous aspiration is the treatment"},{"n":92,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"All of the following statements about pseudopan-creatic cysts are true except: (All India 97)","options":[{"letter":"A","text":"Percutaneous aspiration is treatment of choice"},{"letter":"B","text":"Cystojejunostomy is treatment of choice"},{"letter":"C","text":"Serum amylase levels are increased"},{"letter":"D","text":"Presents as an epigastric mass"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Percutaneous aspiration is treatment of choice","explanation":"a. Percutaneous aspiration is treatment of choice"},{"n":93,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"All of the following are true about pseudopancreatic cyst of pancreas except: (All India 98)","options":[{"letter":"A","text":"Common after acute pancreatitis"},{"letter":"B","text":"Presents as an abdominal mass"},{"letter":"C","text":"Serum amylase is increased"},{"letter":"D","text":"Most common site is in head of pancreas"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Most common site is in head of pancreas","explanation":"• Most common site of pancreatic pseudocyst is lesser sacQ\nAnswer (book): Answer: D. Most common site is in head of pancreas"},{"n":94,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"Treatment of choice for asymptomatic pseudocyst pancreas is: (DNB 2010)","options":[{"letter":"A","text":"Marsupialization"},{"letter":"B","text":"Conservative"},{"letter":"C","text":"Drainage"},{"letter":"D","text":"Cystogastrostomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Conservative","explanation":"b. Conservative"},{"n":95,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 362","pdfPage":349,"stem":"The complication least likely to occur in a pseudocyst of the pancreas is: (Kerala 90)","options":[{"letter":"A","text":"Hemorrhage"},{"letter":"B","text":"Torsion"},{"letter":"C","text":"Infection"},{"letter":"D","text":"Carcinomatous change"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Carcinomatous change","explanation":"d. Carcinomatous change"},{"n":96,"chapter":"Pancreas","src":"question on PDF p. 349 · answer on PDF p. 363","pdfPage":349,"stem":"All are features of pseudopancreatic cyst, except: (All India 97)","options":[{"letter":"A","text":"Follows acute pancreatitis"},{"letter":"B","text":"Lined by false epithelium"},{"letter":"C","text":"May regress spontaneously"},{"letter":"D","text":"Treatment of choice is percutaneous aspiration"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Treatment of choice is percutaneous aspiration","explanation":"d. Treatment of choice is percutaneous aspiration"},{"n":97,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Serious complication in pancreatic pseudocyst include all of the following except: (UPSC 97)","options":[{"letter":"A","text":"Intracystic hemorrhage"},{"letter":"B","text":"Secondary infection"},{"letter":"C","text":"Calcification in the cyst wall"},{"letter":"D","text":"Rupture of the cyst"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Calcification in the cyst wall","explanation":"c. Calcification in the cyst wall"},{"n":98,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Commonest complication of pseudocyst of the pancreas is: (DPG 2009 Feb)","options":[{"letter":"A","text":"Commonest into peritoneum"},{"letter":"B","text":"Rupture into colon"},{"letter":"C","text":"Hemorrhage"},{"letter":"D","text":"Infection"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Infection","explanation":"d. Infection"},{"n":99,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"A 20-year old football player received a hard kick in the epigastrium. A large cystic swelling appeared in the epigastrium two weeks later. The most likely diagnosis is: (UPSC 96)","options":[{"letter":"A","text":"Hydatid cyst of liver"},{"letter":"B","text":"Amoebic liver abscess"},{"letter":"C","text":"Pseudopancreatic cyst"},{"letter":"D","text":"Hematoma of rectus sheath"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pseudopancreatic cyst","explanation":"c. Pseudopancreatic cyst"},{"n":100,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Increased amylase, mucin and CEA is seen in: (ILBS 2012)","options":[{"letter":"A","text":"IPMN"},{"letter":"B","text":"Mucinous cystadenoma"},{"letter":"C","text":"Serous cystadenoma"},{"letter":"D","text":"Solid pseudopaillary tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"IPMN","explanation":"a. IPMN (Ref: Sabiston 20/e p1538-1539; Schwartz 9/e p1234; Blumgart 6/e p960, 5/e p903-905; Shackelford 8/e p1162 7/e p1220-1222)"},{"n":101,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Not true about mucinous cystadenoma pancreas: (AIIMS May 2011)","options":[{"letter":"A","text":"Microcystic adenoma"},{"letter":"B","text":"Lined by columnar epithelium"},{"letter":"C","text":"Premalignant"},{"letter":"D","text":"Focus of ovarian stroma in it"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Microcystic adenoma","explanation":"• Mucinous cystadenoma is macrocystic, not the microcystic adenoma.\nAnswer (book): Answer: A. Microcystic adenoma\nReference: Sabiston 20/e p1537; Schwartz 10/e p 1410-1413; Blumgart 5/e p902-903; Shackelford 7/e p1218-1220"},{"n":102,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"A 60-year old female present with history of recurrent abdominal pain. Imaging shows multiple small cystic lesions like bunch of grapes in the head of pancreas with a grossly dilated main pancreatic duct. The most likely diagnosis is: (All India 2012)","options":[{"letter":"A","text":"SCN"},{"letter":"B","text":"MCN"},{"letter":"C","text":"IPMN"},{"letter":"D","text":"Pancreatic pseudocyst"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Intraductal papillary mucinous neoplasm","explanation":"c. Intraductal papillary mucinous neoplasm"},{"n":103,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Regarding IPMN, all are true except: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Treatment is enucleation"},{"letter":"B","text":"Can involve either main or branch duct"},{"letter":"C","text":"Mostly involve pancreatic head"},{"letter":"D","text":"Men and women are equally affected"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Treatment is enucleation","explanation":"a. Treatment is enucleation"},{"n":104,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"All of the following are true about mucinous cystic neoplasm except: (Recent Question 2017)","options":[{"letter":"A","text":"Less amylase in fluid"},{"letter":"B","text":"Enucleation is performed"},{"letter":"C","text":"Estrogens receptors are positive"},{"letter":"D","text":"More common in females"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Enucleation is performed","explanation":"b. Enucleation is performed (Ref: Sabiston 20/e p1537; Schwartz 10/e p1410; Bailey 27/e p1234)"},{"n":105,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Serous cystadenoma, all are true except: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"30% are associated with malignancy"},{"letter":"B","text":"Mainly microcystic"},{"letter":"C","text":"More commonly located in the head"},{"letter":"D","text":"Glycogen rich cells on cytologic examination with central calcified stellate scar"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"30% are associated with malignancy","explanation":"a. 30% are associated with malignancy (Ref: Sabiston 20/e p1538; Schwartz 10/e p 1409-1410)"},{"n":106,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"A 60-year-old female presented with dull aching pain in central abdomen. On laboratory evaluation, amylase and CEA was normal. The image of CECT abdomen and tumor cut section after surgery is given below. What is the most probable diagnosis?","options":[{"letter":"A","text":"Mucinous cystadenoma"},{"letter":"B","text":"Serous cystadenoma"},{"letter":"C","text":"IPMN"},{"letter":"D","text":"Pseudocyst pancreas"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Serous cystadenoma","explanation":"b. Serous cystadenoma (Ref: Sabiston 20/e p1538; Schwartz 10/e p1409)"},{"n":107,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"All are true about IPMN except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Always involves main pancreatic duct"},{"letter":"B","text":"Involvement of head is most common form"},{"letter":"C","text":"Men and women are equally affected"},{"letter":"D","text":"Patients can experience acute pancreatitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Always involves main pancreatic duct","explanation":"Cystic Neoplasm of Pancreas SCN | Characteristics | MCN | IPMN | F >> MQ (4 : 1) | F >>> MQ (10 : 1) |\nF = MQ | Age (years) | 60-70 | 50-60 | 60-70 | MC site | Head | Body and tail | HeadQ | Pathology\nMultiple small cysts (microcyst) separated by internal septations\nThick-walled, septated macrocystQ with smooth contour; ± solid component\nPoorly demarcated, lobulated, polycystic mass with dilation of main or branch ductsQ\nRadiology/Investigations\nCentral sunburst calcificationsQ Egg-shell calcificationsQ on on CECT CECT\nMucin protruding from fish mouth opening on endoscopy\nCytology\nScant glycogen-rich cells, with positive Periodic Acid Schiff stainQ\nSheets and clusters of columnar, mucin-containing cells\nTall, columnar mucin-containing cells | Communication with ducts | No | No | YesQ | Amylase level | Low | Low |\nHighQ | CEA level | Low | HighQ | Mucin stain | Negative | Positive | Q | Q | HighQ Q | PositiveQ\nAnswer (book): Answer: A. Always involves main pancreatic duct\nReference: Sabiston 20/e p1538"},{"n":108,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Earliest genetic change in carcinoma pancreas: (ILBS 2012)","options":[{"letter":"A","text":"Her-2-neu"},{"letter":"B","text":"p53"},{"letter":"C","text":"p16"},{"letter":"D","text":"DCC"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Her-2-neu","explanation":"• K-ras mutations and HER2/neu over expression are the earliest changes to occur in pancreatic carcinomaQ\nAnswer (book): Answer: A. Her-2-neu\nReference: Sabiston 20/e p1541-1542; Schwartz 10/e p1395; Bailey 27/e p1234"},{"n":109,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Not a risk factor for carcinoma pancreas: (ILBS 2012)","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Diabetes"},{"letter":"C","text":"Smoking"},{"letter":"D","text":"Obesity"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Acute pancreatitis","explanation":"a. Acute pancreatitis (Ref: Sabiston 20/e p1541-1542; Schwartz 10/e p1395; Bailey 27/e p1234)"},{"n":110,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Most common mutation in pancreatic adenocarcinoma: (GB PANT 2010)","options":[{"letter":"A","text":"K-ras"},{"letter":"B","text":"p16"},{"letter":"C","text":"p53"},{"letter":"D","text":"BRAF"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"K-ras","explanation":"a. K-ras (Ref: Sabiston 20/e p1542; Schwartz 10/e p1395; Bailey 27/e p1234)"},{"n":111,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Which of the following does not predispose to CA pancreas? (Recent Question 2017, AIIMS GIS May 2008)","options":[{"letter":"A","text":"Familial breast cancer"},{"letter":"B","text":"HNPCC"},{"letter":"C","text":"PJS"},{"letter":"D","text":"\u0000Cronkhite-Canada syndrome"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Cronkhite-Canada syndrome","explanation":"d. Cronkhite-Canada syndrome"},{"n":112,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Hereditary pancreatic carcinoma is associated with all except: (AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"Ataxia Telengiectasia"},{"letter":"B","text":"Peutz-Jegher’s syndrome"},{"letter":"C","text":"Hereditary pancreatitis"},{"letter":"D","text":"FAP"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"FAP","explanation":"d. FAP"},{"n":113,"chapter":"Pancreas","src":"question on PDF p. 350 · answer on PDF p. 363","pdfPage":350,"stem":"Most common oncogene involved in pancreatic carcinoma is: (AIIMS GIS Dec 2009)","options":[{"letter":"A","text":"p53"},{"letter":"B","text":"K-ras"},{"letter":"C","text":"APC"},{"letter":"D","text":"DCC"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"K-ras","explanation":"b. K-ras"},{"n":114,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"Risk factors for carcinoma of pancreas include the following except: (MHSSMCET 2006)","options":[{"letter":"A","text":"Obesity"},{"letter":"B","text":"Alcohol abuse"},{"letter":"C","text":"Peutz-Jegher’s syndrome"},{"letter":"D","text":"History of partial gastrectomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"History of partial gastrectomy","explanation":"d. History of partial gastrectomy"},{"n":115,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"What will be your advice to a 60 years moderately obese patient with history of 4–6 cup of coffee per day, 4–6 glass of wine/day with 20 cigarettes per day. He is engaged as a salesman in a computer company. His brother died of pancreatic carcinoma: (PGI June 2004)","options":[{"letter":"A","text":"Urgent weight reduction"},{"letter":"B","text":"Strict vegetarian diet"},{"letter":"C","text":"Stop alcohol"},{"letter":"D","text":"Stop coffee"},{"letter":"E","text":"Stop cigarette smoking"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Urgent weight reduction, B. Strict vegetarian diet, C. Stop alcohol, E. Stop cigarette smoking","explanation":"a. Urgent weight reduction, b. Strict vegetarian diet, c. Stop alcohol, e. Stop cigarette smoking"},{"n":116,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"False about pancreatic cancer association: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"p53 inactivated"},{"letter":"B","text":"K-ras activated"},{"letter":"C","text":"BRCA activated"},{"letter":"D","text":"EGF overexpression"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"BRCA activated","explanation":"c. BRCA activated"},{"n":117,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"Maximum risk of carcinoma pancreas is seen in which of these? (AIIMS May 2017)","options":[{"letter":"A","text":"Hereditary atypical multiple mole melanoma syndrome"},{"letter":"B","text":"Hereditary pancreatitis"},{"letter":"C","text":"Peutz-Jegher’s syndrome"},{"letter":"D","text":"Familial adenomatous polyposis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Peutz-Jegher’s syndrome","explanation":"c. Peutz-Jegher’s syndrome (Ref: Sabiston 20/e p1542)"},{"n":118,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"First gene mutated in pancreatic adenocarcinoma is: (Recent Question 2017)","options":[{"letter":"A","text":"K-ras"},{"letter":"B","text":"p53"},{"letter":"C","text":"p16"},{"letter":"D","text":"BRAF"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"K-ras","explanation":"a. K-ras (Ref: Sabiston 20/e p1543; Schwartz 10/e p1395; Bailey 27/e p1234)"},{"n":119,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"Most common oncogene mutated in CA head of pancreas: (AIIMS GIS 2003)","options":[{"letter":"A","text":"K-ras"},{"letter":"B","text":"p53"},{"letter":"C","text":"C-myc"},{"letter":"D","text":"BRCA 2"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"K-ras","explanation":"a. K-ras"},{"n":120,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"Which is not autosomal dominant? (AIIMS GIS May 2011)","options":[{"letter":"A","text":"HNPCC"},{"letter":"B","text":"FAMMM"},{"letter":"C","text":"PJS"},{"letter":"D","text":"Ataxia telangiectasia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ataxia-Telangiectasia","explanation":"d. Ataxia-Telangiectasia"},{"n":121,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 363","pdfPage":351,"stem":"Most common symptom of CA head of pancreas: (ILBS 2012, AIIMS GIS Dec 2011, Dec 2006)","options":[{"letter":"A","text":"Weight loss"},{"letter":"B","text":"Pain"},{"letter":"C","text":"Jaundice"},{"letter":"D","text":"Anorexia"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Jaundice","explanation":"p1138, 7/e p1190-1196\nSex\nAnswer (book): Answer: C. Jaundice\nReference: Sabiston 20/e p1544; Schwartz 10/e p 1394; Bailey 27/e p1234; Blumgart 6/e p979, 5/e p919-925; Shackelford 8/e"},{"n":122,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"In carcinoma head of pancreas, nausea and vomiting is due to: (JIPMER May 2018)","options":[{"letter":"A","text":"External compression of duodenum"},{"letter":"B","text":"Portal vein infiltration"},{"letter":"C","text":"Proliferation infiltration of tumor into duodenum"},{"letter":"D","text":"Chemotherapy related"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"External compression of duodenum","explanation":"a. External compression of duodenum (Ref: Schwartz 10/e p1395; Sabiston 20/e p1544; Bailey 27/e p1234)"},{"n":123,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Diagnostic investigation in carcinoma pancreas: (ILBS 2012)","options":[{"letter":"A","text":"MDCT"},{"letter":"B","text":"PET scan"},{"letter":"C","text":"ERCP"},{"letter":"D","text":"MRCP"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MDCT","explanation":"• Diagnostic investigation in carcinoma pancreas is MDCTQ\n• MDCT is investigation of choice for the evaluation of lesions arising in the pancreasQ\n• IOC for diagnosis, staging and follow-up in CA pancreas: MDCTQ\nAnswer (book): Answer: A. MDCT"},{"n":124,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"According to AJCC 8th edition, staging of 2 cm size pancreatic cancer if it involves portal vein in: (JIPMER May 2018)","options":[{"letter":"A","text":"T1"},{"letter":"B","text":"T2"},{"letter":"C","text":"T3"},{"letter":"D","text":"T4"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"T1","explanation":"a. T1"},{"n":125,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Not true about pancreatic ductal adenocarcinoma: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Most common site is body and tail"},{"letter":"B","text":"Associated with desmoplastic changes with scattering of neoplastic glands"},{"letter":"C","text":"Body tumors are larger"},{"letter":"D","text":"Perineural invasion is characteristic feature"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Most common site is body and tail","explanation":"a. Most common site is body and tail"},{"n":126,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Most appropriate initial method of investigation for carcinoma head of pancreas: (Recent Question 2018)","options":[{"letter":"A","text":"Laparoscopic guided biopsy"},{"letter":"B","text":"MRI guided biopsy"},{"letter":"C","text":"CECT guided biopsy"},{"letter":"D","text":"EUS guided transgastric biopsy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"EUS guided transgastric biopsy","explanation":"• “EUS is useful if CT fails to demonstrate a tumour, if tissue diagnosis is required prior to surgery (e.g. a mass has\ndeveloped on a background of chronic pancreatitis and a distinction needs to be made between inflammation and\nneoplasia), if vascular invasion needs to be confirmed, or in separating cystic tumours from pseudocysts.\nTransduodenal or transgastric FNA or Trucut biopsy performed under EUS guidance avoids spillage of tumour\ncells into the peritoneal cavity. Percutaneous transperitoneal biopsy of potentially resectable pancreatic tumours\nshould be avoided as far as possible. Histological confirmation of malignancy is desirable but not essential,\nparticularly if the imaging clearly demonstrates a resectable tumour. The lack of a tissue diagnosis should not\ndelay appropriate surgical therapy. In patients judged to have unresectable disease, tissue diagnosis should be\nobtained prior to starting palliative therapy.” —Bailey 27/e p1235\nAnswer (book): Answer: D. EUS guided transgastric biopsy\nReference: Schwartz 10/e p1397-1399; Sabiston 20/e p1544; Bailey 27/e p1235"},{"n":127,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Scrambled egg appearance is seen in: (COMEDK 2007)","options":[{"letter":"A","text":"Carcinoma stomach"},{"letter":"B","text":"Carcinoma gallbladder"},{"letter":"C","text":"Pancreatic carcinoma"},{"letter":"D","text":"Renal carcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pancreatic carcinoma","explanation":"c. Pancreatic carcinoma (Ref: Grainger 4/e p1356-64)"},{"n":128,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"The most likely cause of fluctuating jaundice in a middle aged or elderly man is: (COMEDK 2010)","options":[{"letter":"A","text":"Periampullary carcinoma"},{"letter":"B","text":"Liver fluke infestation"},{"letter":"C","text":"Choledochal cyst"},{"letter":"D","text":"Carcinoma head of pancreas"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Periampullary carcinoma","explanation":"a. Periampullary carcinoma"},{"n":129,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Migratory thrombophlebitis seen in: (PGI Dec 2006)","options":[{"letter":"A","text":"Pancreatic cancer"},{"letter":"B","text":"Bladder cancer"},{"letter":"C","text":"Stomach cancer"},{"letter":"D","text":"Breast cancer"},{"letter":"E","text":"Liver cancer"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pancreatic cancer, C. Stomach cancer","explanation":"Malignancies Associated with Migratory Thrombophlebitis\n• CA pancreas (MC)Q\n• Prostate cancerQ\n• CA lung\n• Ovarian cancerQ\n• GI malignanciesQ\n• LymphomaQ\nQ\n• Trousseau’s syndrome: Migratory thrombophlebitisQ\n• Trousseau’s sign: Carpopedal spasm in hypocalcemiaQ\n• Troisier’s sign: Palpable left supraclavicular LN (Virchow’s node)Q\nAnswer (book): Answer: A. Pancreatic cancer, C. Stomach cancer\nReference: Robbins 9/e p332, 126"},{"n":130,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"True about pancreatic carcinoma: (PGI Dec 2000)","options":[{"letter":"A","text":"Head is the most common site"},{"letter":"B","text":"Pain is the most common symptom"},{"letter":"C","text":"Obstruction of bile and pancreatic secretion is common"},{"letter":"D","text":"80% cases respond well to resection"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Head is the most common site, C. Obstruction of bile and pancreatic secretion is common","explanation":"a. Head is the most common site, c. Obstruction of bile and pancreatic secretion is common"},{"n":131,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Investigation to diagnose carcinoma head of pancreas are/is: (PGI Dec 2000, PGI Dec 2003)","options":[{"letter":"A","text":"Hypotonic duodenogram"},{"letter":"B","text":"X-ray abdomen"},{"letter":"C","text":"USG"},{"letter":"D","text":"Endoscopy"},{"letter":"E","text":"CT Scan"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hypotonic duodenogram, C. USG, D. Endoscopy, E. CT Scan","explanation":"a. Hypotonic duodenogram, c. USG, d. Endoscopy, e. CT Scan"},{"n":132,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"A 55-year-old male presents with features of obstructive jaundice. He also reports a weight loss of seven kilograms in last two months. On CT scan, the CBD is dilated till the lower end and the main pancreatic duct is also dilated. Pancreas is normal. The most likely diagnosis is: (AIIMS Nov 2004)","options":[{"letter":"A","text":"Choledocholithiasis"},{"letter":"B","text":"Carcinoma gallbladder"},{"letter":"C","text":"Hilar cholangiocarcinoma"},{"letter":"D","text":"Periampullary carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Periampullary carcinoma","explanation":"d. Periampullary carcinoma"},{"n":133,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"Inverted “3” sign seen in: (PGI Dec 97)","options":[{"letter":"A","text":"Ampullary carcinoma"},{"letter":"B","text":"Insulinoma"},{"letter":"C","text":"CA head pancreas"},{"letter":"D","text":"CA stomach"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"CA head of pancreas","explanation":"c. CA head of pancreas"},{"n":134,"chapter":"Pancreas","src":"question on PDF p. 351 · answer on PDF p. 364","pdfPage":351,"stem":"This characteristic appearance is seen in:","options":[{"letter":"A","text":"Duodenal adenocarcinoma"},{"letter":"B","text":"Distal cholangiocarcinoma"},{"letter":"C","text":"Ampullary carcinoma"},{"letter":"D","text":"Carcinoma head of pancreas"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Carcinoma head of pancreas","explanation":"• Frostburg inverted 3 sign is a sign seen on a barium examination where there is effacement and distortion of the\nmucosal pattern on the medial wall of the second part of the duodenum due to focal mass and local edema. It is\nmost commonly associated with carcinoma of the head of the pancreas.\nAnswer (book): Answer: D. Carcinoma head of pancreas\nReference: radiopaedia.org/articles/frostburg-inverted-3-sign-1"},{"n":135,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 364","pdfPage":352,"stem":"Most common tumor of pancreas is: (UPPG 2007)","options":[{"letter":"A","text":"Adenocarcinoma"},{"letter":"B","text":"Squamous cell carcinoma"},{"letter":"C","text":"Adeno-squamous cell carcinoma"},{"letter":"D","text":"Ductal adenocarcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ductal adenocarcinoma","explanation":"d. Ductal adenocarcinoma"},{"n":136,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 364","pdfPage":352,"stem":"The commonest pancreatic tumor is: (Recent Question 2016)","options":[{"letter":"A","text":"Ductal adenocarcinoma"},{"letter":"B","text":"Cystadenoma"},{"letter":"C","text":"Insulinoma"},{"letter":"D","text":"Non islet cell tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Ductal adenocarcinoma","explanation":"a. Ductal adenocarcinoma"},{"n":137,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 364","pdfPage":352,"stem":"Most sensitive investigation of pancreatic carcinoma is: (Recent Question 2016)","options":[{"letter":"A","text":"Angiography"},{"letter":"B","text":"ERCP"},{"letter":"C","text":"Ultrasound"},{"letter":"D","text":"CT scan"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"CT scan","explanation":"• Investigation of choice for carcinoma pancreas: MDCTQ\n• Currently CT is probably the single most versatile and cost effective tool for diagnosis of pancreatic cancer\nAnswer (book): Answer: D. CT scan\nReference: CSDT 11/e p645; Schwartz 10/e p1398"},{"n":138,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 364","pdfPage":352,"stem":"Carcinoma of pancreas is associated with: (UPPG 2008)","options":[{"letter":"A","text":"Hypoglycemia"},{"letter":"B","text":"Syndrome of inappropriate secretion of ADH"},{"letter":"C","text":"Erythropoiesis is due to erythropoietin"},{"letter":"D","text":"Hypercalcemia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Syndrome of inappropriate secretion of ADH","explanation":"Causes of Syndrome of Inappropriate Antidiuresis (SIADH) Neoplasms\nLungQ DuodenumQ, PancreasQ OvaryQ, BladderQ, ureterQ ThymomaQ, MesotheliomaQ Bronchial adenomaQ Carcinoid\nGangliocytoma, Ewing’s sarcoma\nInfections\nPneumoniaQ, bacterial or viral AbscessQ, lung or brain Cavitation (aspergillosis) Tuberculosis, lung or brain\nMeningitis, bacterial or viral EncephalitisQ, AIDSQ\nNeurologic\nGuillain-Barré syndromeQ Multiple sclerosisQ Delirium tremensQ Amyotrophic lateral sclerosisQ Hydrocephalus,\nPsychosis Peripheral neuropathyQ\nMetabolic | Vascular | Pulmonary\n• Asthma, PneumothoraxQ\n• Positive-pressure respiration Head trauma\n• Cerebrovascular occlusions, hemorrhage\n• Cavernous sinus thrombosisQ Congenital malformations\n• Agenesis corpus callosum\n• Cleft lip/palateQ\n• Other midline defects\n• Closed and penetratingQ\nDrugs\nVasopressinQ or desmopressin ChlorpropamideQ Oxytocin, high doseQ Vincristine, CarbamazepineQ Nicotine,\nPhenothiazinesQ CyclophosphamideQ Tricyclic antidepressantsQ Monoamine oxidase inhibitorsQ Serotonin reuptake\ninhibitorsQ\nAnswer (book): Answer: B. Syndrome of inappropriate secretion of ADH\nReference: Harrison 20/e p2690, 19/e p2280"},{"n":139,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Elderly male with icterus having large painless gallbladder lump, diagnosis is: (UPPG 2010)","options":[{"letter":"A","text":"Acute hepatitis"},{"letter":"B","text":"Carcinoma head of pancreas"},{"letter":"C","text":"CBD stone"},{"letter":"D","text":"Cholelithiasis"},{"letter":"E","text":"Hepatocellular carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Carcinoma head of pancreas","explanation":"• Acute intermittent porphyria\n265\nAnswer (book): Answer: B. Carcinoma head of pancreas"},{"n":140,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Most appropriate initial method of investigation for carcinoma head of pancreas: (Recent Question 2018)","options":[{"letter":"A","text":"EUS guided transgastric biopsy"},{"letter":"B","text":"CECT guided biopsy"},{"letter":"C","text":"MRI guided biopsy"},{"letter":"D","text":"Laparoscopic biopsy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"EUS guided transgastric biopsy","explanation":"a. EUS guided transgastric biopsy (Ref: Sabiston 20/e p1544; Schwartz 10/e p1399; Bailey 27/e p1235)"},{"n":141,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"A 60-year-old chronic smoker presented with jaundice, anorexia and weight loss. ERCP was done. The diagnosis on the basis of ERCP findings:","options":[{"letter":"A","text":"Choledochal cyst"},{"letter":"B","text":"Cholangiocarcinoma"},{"letter":"C","text":"Carcinoma pancreas"},{"letter":"D","text":"Chronic pancreatitis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Carcinoma pancreas","explanation":"• Double duct sign on ERCP is highly suggestive of pancreatic head cancerQ.\nAnswer (book): Answer: C. Carcinoma pancreas\nReference: Sabiston 20/e p1544; Schwartz 10/e p1397; Bailey 27/e p1235"},{"n":142,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Double duct sign is seen in: (Recent Question 2017)","options":[{"letter":"A","text":"Periampullary carcinoma"},{"letter":"B","text":"Chronic pancreatitis"},{"letter":"C","text":"HCC"},{"letter":"D","text":"Carcinoma gallbladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Periampullary carcinoma","explanation":"a. Periampullary carcinoma (Ref: Shackelford 7/e p1183)"},{"n":143,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Most common site for carcinoma pancreas is: (Recent Question 2013)","options":[{"letter":"A","text":"Head"},{"letter":"B","text":"Body"},{"letter":"C","text":"Tail"},{"letter":"D","text":"Neck"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Head","explanation":"a. Head"},{"n":144,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"A 60-year-old chronic smoker presented with progressive jaundice, pruritus and clay colored stools for 2 months. History of waxing and waning of jaundice was present. A CT scan revealed dilated main pancreatic duct and common bile duct. What is the likely diagnosis? (AIIMS November 2015)","options":[{"letter":"A","text":"Carcinoma head of pancreas"},{"letter":"B","text":"Periampullary carcinoma"},{"letter":"C","text":"Chronic pancreatitis"},{"letter":"D","text":"Hilar cholangiocarcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Periampullary carcinoma","explanation":"• “The waxing and waning nature of jaundice is due to sloughing of ampullary cancer, resulting in transient\nresolution of the jaundice.”\nAnswer (book): Answer: B Periampullary carcinoma\nReference: Sabiston 20/e p1544; Schwartz 10/e p1395; Bailey 27/e p1234"},{"n":145,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"What is the diagnosis based on the image given below?","options":[{"letter":"A","text":"Acute pancreatitis"},{"letter":"B","text":"Chronic pancreatitis"},{"letter":"C","text":"Cystic neoplasm of pancreas"},{"letter":"D","text":"Carcinoma head of pancreas"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Carcinoma head of pancreas","explanation":"d. Carcinoma head of pancreas"},{"n":146,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Most important predictor of post-operative survival in CA pancreas: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"R0 resection"},{"letter":"B","text":"DNA content"},{"letter":"C","text":"Tumor size"},{"letter":"D","text":"LN status"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"R0 resection","explanation":"• Can be performed in selected patients affected by tumors of the pancreatic neckQ\n• In experienced hands it is associated with no mortality but with high morbidty, even if the rate of “clinical”\npanareatic fistula is about 20%\n• Middle pancreatectomy is avoided in patients affected by main duct IPMN. Indications of Middle or Segmental\nPancreatectomy\n• Benign or low grade malignant tumor (Neuroendocrine tumors, serous cystadenoma, branch duct IPMNs) Q\n• Location in the neckQ or its contiguous portion\n• A distal pancreas stump of at least 5cm in lengthQ\nAnswer (book): Answer: A. R0 resection\nReference: Sabiston 20/e p1546; Schwartz 10/e p1394; Blumgart 6/e p 983, 5/e p819-825; Shackelford 8/e p1144, 7/e p1192-1202"},{"n":147,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Most common primary leading to secondaries in pancreas: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Lung"},{"letter":"B","text":"Breast"},{"letter":"C","text":"Colon"},{"letter":"D","text":"Stomach"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lung","explanation":"Metastatic Tumors to Pancreas\n• MC site of primary: RCCQ > Malignannt melanoma\n• On autopsy, MC site of primary: CA lungQ\nAnswer (book): Answer: A. Lung\nReference: Sabiston 20/e p1544"},{"n":148,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Most common complication of Whipple’s procedure is: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Delayed gastric emptying"},{"letter":"B","text":"Bleeding"},{"letter":"C","text":"Exocrine insufficiency"},{"letter":"D","text":"Anastomotic leak"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Delayed gastric emptying","explanation":"Morbidity Following Pancreaticoduodenectomy Delayed gastric emptying (18%)Q\n• Cardiac events (3%) Pancreas fistula (12%)\n• Bile leak (2%) Wound infection (7%)\n• Overall reoperation (3%) Intra-abdominal abscess (6%)\nAnswer (book): Answer: A. Delayed gastric emptying\nReference: Sabiston 20/e p1548; Schwartz 10/e p1406; Blumgart 6/e p464, 5/e p819-825; Shackelford 8/e p 1144, 7/e p1200"},{"n":149,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"A patient with obstructive jaundice due to pancreatic cancer might have all of the following clinical findings except: (COMEDK 2004)","options":[{"letter":"A","text":"A palpable gallbladder"},{"letter":"B","text":"Pain is early in the course of the disease"},{"letter":"C","text":"Pulmonary metastasis"},{"letter":"D","text":"Thrombocytopenia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pain is early in the course of the disease","explanation":"Carcinoma Pancreas\n• Symptoms include unexplained episodes of pancreatitisQ, painless jaundice, nausea, vomiting, steatorrhea, and\nunexplained weight loss\n• With further spread beyond the pancreas, these patients may note upper abdominal or back pain when\nperipancreatic nerve plexuses are involved and ascites when peritoneal carcinomatosis or portal vein occlusion\ndevelopsQ\nAnswer (book): Answer: B. Pain is early in the course of the disease\nReference: Sabiston 20/e p1544"},{"n":150,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Which of the following drugs has been found to increase the survival in locally advanced pancreatic cancer? (COMEDK 2006)","options":[{"letter":"A","text":"Doxorubicin"},{"letter":"B","text":"Streptozocin"},{"letter":"C","text":"Gemcitabine"},{"letter":"D","text":"Paclitaxel"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gemcitabine","explanation":"• GemcitabineQ is currently the standard of care for patients with metastatic pancreatic cancer.\nAnswer (book): Answer: C. Gemcitabine\nReference: Bailey 27/e p1237; Blumgart 6/e p 1040, 5/e p925; Shackelford 8/e p 1146, 7/e p1202"},{"n":151,"chapter":"Pancreas","src":"question on PDF p. 352 · answer on PDF p. 365","pdfPage":352,"stem":"Middle segment pancreatectomy avoided in: (PGI Nov 2009)","options":[{"letter":"A","text":"Cystadenoma"},{"letter":"B","text":"Tumors of head pancreas"},{"letter":"C","text":"Tumors of tail of pancreas"},{"letter":"D","text":"Tumor of neck of pancreas"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tumors of head pancreas","explanation":"Middle or Central or Segmental Pancreatectomy\n• Middle pancreatectomy is a safe, effective procedure for treatment of benign and low grade malignant neoplasms\nof the mid pancreasQ Advantages of Middle or Segmental Pancreatectomy\n• Preserves pancreatic parenchyma\n• Reduces the risk of exocrine and endocrine insufficiency\n• Consists of a limited resection of the mid portion of the pancreas\nAnswer (book): Answer: B. Tumors of head pancreas\nReference: Blumgart 6/e p 1020, 5/e p959-960"},{"n":152,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Which of the following statements is not true about pancreatic carcinoma? (AIIMS May 2011, All India 2009)","options":[{"letter":"A","text":"Mutation in p53 gene is associated in 75% of cases"},{"letter":"B","text":"Hereditary Pancreatitis significantly increase the risk"},{"letter":"C","text":"Median survival in locally advanced (stage III) disease is 3-6 months"},{"letter":"D","text":"Five year survival after curative pancreaticoduo-denecto-my is 20%"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Median survival in locally advanced (stage III) disease is 3-6 months","explanation":"c. Median survival in locally advanced (stage III) disease is 3-6 months  (Ref: Sabiston 20/e p1547; Blumgart 6/e p 963, 5/e p922;\nShackelford 8/e p 1144, 7/e p1195-1196)"},{"n":153,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Components of Whipple’s operation are following except: (MHSSMCET 2009)","options":[{"letter":"A","text":"Gastrojejunostomy"},{"letter":"B","text":"Duodenojejunostomy"},{"letter":"C","text":"Choledochojejunostomy"},{"letter":"D","text":"Pancreaticoduodenostomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Duodenojejunostomy","explanation":"• Duodenojejunostomy is done in PPPD, not in Whipple’s procedure.\n• Gastrojejunostomy is done in Whipple’s procedure.\nAnswer (book): Answer: B. Duodenojejunostomy\nReference: Sabiston 20/e p1546; Bailey 27/e p1237; Shackelford 8/e p1185, 7/e p1196"},{"n":154,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"All are resected in Whipple’s operation except: (AIIMS Nov 98, AIIMS Feb 97, All India 96)","options":[{"letter":"A","text":"Duodenum"},{"letter":"B","text":"Head of pancreas"},{"letter":"C","text":"Portal vein"},{"letter":"D","text":"Common bile duct"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Portal vein","explanation":"c. Portal vein"},{"n":155,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"The preferred bypass procedure in case of non resectable carcinoma of head of pancreas is: (MAHE 2005)","options":[{"letter":"A","text":"Cholecystojejunostomy"},{"letter":"B","text":"Cholecystogastrostomy"},{"letter":"C","text":"Choledochoduodenostomy"},{"letter":"D","text":"Choledochojejunostomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Choledochojejunostomy","explanation":"Palliative Surgery in Advanced, Non-resectable Pancreatic Adenocarcinoma\n• Surgery for advanced, non-resectable pancreatic adenocarcinoma can palliate obstruction of CBD or duodenum,\nas well as control visceral painQ\n• Hepaticojejunostomy, choledochojejunostomy or choledochoduodenostomy offers durable drainage of an\nobstructed bile duct.Q\n• Cholecystojejunostomy is less reliable but can be employed when tumor bulk precludes common duct procedure\n• Gastrojejunostomy (antecolic anastomosis) palliates gastric outlet obstructionQ\n• Antecolic anastomosisQ is done to avoid complications from an expanding lesser sac tumor\nAnswer (book): Answer: D. Choledochojejunostomy\nReference: Devita 9/e p979"},{"n":156,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Best prognosis for carcinoma of pancreas is in the region of: (UPPG 2007)","options":[{"letter":"A","text":"Head"},{"letter":"B","text":"Tail"},{"letter":"C","text":"Body"},{"letter":"D","text":"Periampullary"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Periampullary","explanation":"Periampullary Carcinoma\n1. Adenocarcinoma of head of the pancreas (40-60%)Q\n2. Adenocarcinoma of ampulla of vater (10-20%) | 3. Distal bile duct adenocarcinoma (10%) | 4. Duodenal\nadenocarcinoma (5-10%)\n• Patients with pancreas adenocarcinoma involving the body or tail of the gland are more likely to have weight loss\nand abdominal pain as their initial complaints.\n• These lesions can grow to a larger size before producing symptoms and are often diagnosed at a later stage with\na poorer prognosis.\n• Most body and tail cancers have already metastasized to distant sites or extended locally to involve nodes,\nnerves, or major vessels by the time of diagnosis.\n• Best prognosis: Duodenal adenocarcinoma >Ampullary carcinoma >Distal Bile duct adenocarcinoma >Head of\npancreas >Body and tail of Pancreas (DAD Head Body and Tail)Q\nAnswer (book): Answer: D. Periampullary\nReference: Shackelford 8/e p 1138, 7/e p1187-1206"},{"n":157,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"What is the most common surgical complication following Whipple’s procedure? (UPSC 2007)","options":[{"letter":"A","text":"Disruption of pancreatic anastomosis"},{"letter":"B","text":"Biliary peritonitis"},{"letter":"C","text":"Disruption of gastric anastomosis"},{"letter":"D","text":"GI bleeding"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Disruption of pancreatic anastomosis","explanation":"a. Disruption of pancreatic anastomosis"},{"n":158,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Treatment in periampullary carcinoma is by: (DPG 2008)","options":[{"letter":"A","text":"Endoscopic stent"},{"letter":"B","text":"Ampullectomy"},{"letter":"C","text":"Pancreaticoduodenectomy"},{"letter":"D","text":"Cholecystojejunostomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Pancreaticoduodenectomy","explanation":"c. Pancreaticoduodenectomy"},{"n":159,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Kocher’s maneuver means:","options":[{"letter":"A","text":"Mobilization of gallbladder during cholecystectomy"},{"letter":"B","text":"Mobilization of 2nd part of duodenum"},{"letter":"C","text":"Mobilization of pancreas during pancreatectomy"},{"letter":"D","text":"Mobilization of ascending colon"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Mobilization of 2nd part of duodenum","explanation":"• Kocher maneuver is a technique for mobilization of the duodenumQ.\nAnswer (book): Answer: B. Mobilization of 2nd part of duodenum"},{"n":160,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"Pancreaticoduodenectomy is the treatment of choice for:","options":[{"letter":"A","text":"Duodenal carcinoma"},{"letter":"B","text":"Pancreatic carcinoma"},{"letter":"C","text":"Gallbladder carcinoma"},{"letter":"D","text":"Gastric carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pancreatic carcinoma","explanation":"b. Pancreatic carcinoma"},{"n":161,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"5-FU is the chemotherapeutic agent of choice for all except:","options":[{"letter":"A","text":"CA breast"},{"letter":"B","text":"CA stomach"},{"letter":"C","text":"CA pancreas"},{"letter":"D","text":"CA colon"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"CA pancreas","explanation":"c. CA pancreas"},{"n":162,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"All are true about pancreatic carcinoma except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Ductal adenocarcinoma is the most common type"},{"letter":"B","text":"K-ras mutation and Her-2-neu overexpression are the earliest change"},{"letter":"C","text":"Good prognosis"},{"letter":"D","text":"Most cases present late"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Good prognosis","explanation":"c. Good prognosis"},{"n":163,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 366","pdfPage":353,"stem":"False about CA pancreas: (KGMC 2011)","options":[{"letter":"A","text":"Most common site is head and uncinate process"},{"letter":"B","text":"Pain suggests unresectability"},{"letter":"C","text":"Two third patients present with diabetes"},{"letter":"D","text":"Acute pancreatitis never occurs in CA pancreas"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Acute pancreatitis never occurs in CA pancreas","explanation":"Clinical Features of Carcinoma Pancreas\n• MC site is head and uncinate process\n• Patients with lesions that occur near the bile duct, such as those near the ampulla, head of the pancreas, and\nuncinate process, are much more likely to have obstructive jaundiceQ.\n• Those with lesions in the body or tail of the pancreas are more likely to complain of pain. Q\nPain suggests unresectabilityQ in carcinoma pancreas Two third (65%) patients present with diabetes in carcinoma\npancreasQ Patients may also have acute pancreatitis secondary to obstruction of the pancreatic ductQ. Elderly\npatients with acute pancreatitis but without a history of alcohol use or gallbladder stones should be screened for a\nneoplasmQ.\nAnswer (book): Answer: D. Acute pancreatitis never occurs in CA pancreas\nReference: Sabiston 20/e p1544"},{"n":164,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Best tumor marker for CA head of pancreas: (AIIMS GIS 2003)","options":[{"letter":"A","text":"CA 19-9"},{"letter":"B","text":"CEA"},{"letter":"C","text":"CA 125"},{"letter":"D","text":"AFP"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CA 19-9","explanation":"a. CA 19-9"},{"n":165,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Best prognosis after Whipple’s is seen in: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Cholangiocarcinoma"},{"letter":"B","text":"CA duodenum"},{"letter":"C","text":"CA pancreas"},{"letter":"D","text":"Ampullary carcinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CA duodenum","explanation":"• Best prognosis: Duodenal adenocarcinoma >Ampullary carcinoma >Distal Bile duct adenocarcinoma >Head of\npancreas >Body and tail of Pancreas (DAD Head Body and Tail)\nAnswer (book): Answer: B. CA duodenum\nReference: Shackelford 8/e p1138, 7/e p1201"},{"n":166,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Most important margin for pancreati-coduodenectomy: (PGI SS June 2001)","options":[{"letter":"A","text":"Retroperitoneal margin"},{"letter":"B","text":"CBD"},{"letter":"C","text":"Pancreatic duct"},{"letter":"D","text":"Intestinal margin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Retroperitoneal margin","explanation":"267\nAnswer (book): Answer: A. Retroperitoneal margin\nReference: Shackelford 7/e p1196-1200"},{"n":167,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Most common cause of death after Whipple’s procedure: (PGI SS 2004)","options":[{"letter":"A","text":"Pancreatic anastomotic leak"},{"letter":"B","text":"Biliary anastomotic leak"},{"letter":"C","text":"Cardiopulmonary complications"},{"letter":"D","text":"Gastric leak"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Cardiopulmonary complications","explanation":"c. Cardiopulmonary complications"},{"n":168,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Asymptomatic, solid 4 cm tumor of distal pancreas. Treatment: (PGI SS Dec 2010)","options":[{"letter":"A","text":"Observation"},{"letter":"B","text":"Distal pancreatectomy with splenectomy"},{"letter":"C","text":"Near total pancreatectomy with splenectomy"},{"letter":"D","text":"Distal pancreatectomy alone"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Distal pancreatectomy with splenectomy","explanation":"Resectional Surgery for Pancreatic Body and Tail Tumors\n• Most body and tail cancers have already metastasized to distant sites or extended locally to involve nodes,\nnerves, or major vessels by the time of diagnosis.\n• Splenic vein involvement or occlusion is not a sign of nonresectabilityQ.\n• Involvement of the splenic and SMV confluence generally precludes resection.\n• Resection involves a distal pancreatectomy either with or without concomitant splenectomyQ.\n• Splenectomy is usually performed with distal pancreatectomy in patients suspected of having carcinoma to\nobtain better margins, to remove the lymph nodes at the tip of the pancreas and the hilum of the spleen, and to\navoid tedious dissection of the splenic artery and vein.\nAnswer (book): Answer: B. Distal pancreatectomy with splenectomy\nReference: Sabiston 20/e p1547; Schwartz 9/e p1226; Bailey 27/e p1236; Shackelford 8/e p1186, 7/e p1198-199"},{"n":169,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Which of the following is not a contraindication for resection of head of pancreas: (Recent Question 2015)","options":[{"letter":"A","text":"Liver metastasis"},{"letter":"B","text":"Ascites"},{"letter":"C","text":"Peritoneal seedings"},{"letter":"D","text":"Involvement of major artery"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Ascites","explanation":"b. Ascites"},{"n":170,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Which of the following is not resected in pylorus preserving pancreaticoduodenectomy? (Recent Question 2016)","options":[{"letter":"A","text":"Pyloric antrum"},{"letter":"B","text":"CBD"},{"letter":"C","text":"Duodenum"},{"letter":"D","text":"Gall bladder"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pyloric antrum","explanation":"a. Pyloric antrum"},{"n":171,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Most common complication after Whipple’s procedure: (Recent Question 2017)","options":[{"letter":"A","text":"Delayed gastric emptying"},{"letter":"B","text":"Pancreatic fistula"},{"letter":"C","text":"Wound infection"},{"letter":"D","text":"Anastomotic leak"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Delayed gastric emptying","explanation":"a. Delayed gastric emptying (Ref: Sabiston 20/e p1548; Schwartz 10/e p1406; Bailey 27/e p1236)"},{"n":172,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Median survival in carcinoma pancreas after surgery and adjuvant therapy: (Recent Question 2017)","options":[{"letter":"A","text":"12 months"},{"letter":"B","text":"22 months"},{"letter":"C","text":"32 months"},{"letter":"D","text":"44 months"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"22 months","explanation":"“After surgical resection and adjuvant therapy for pancreatic cancer, the median survival is\napproximately 22 months, with 5-year survival of 15% to 20%. Most patients experience relapse of disease in the\nform of metastatic disease (85%) and, less commonly, local recurrence (40%). In the absence of surgical resection,\nthose with locally advanced disease who receive palliative chemotherapy may survive 10 to 12 months, whereas\nthose with metastases rarely survive beyond 6 months.”-Sabiston 20/e p1547\nAnswer (book): Answer: B. 22 months\nReference: Sabiston 20/e p1547"},{"n":173,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"Order of anastomosis in Whipple’s procedure: (Recent Question 2016, JIPMER SS 2016)","options":[{"letter":"A","text":"Pancreaticojejunostomy, gastrojejunostomy, hepaticojejunostomy,"},{"letter":"B","text":"Hepaticojejunostomy, pancreaticojejunostomy, gastrojejunostomy"},{"letter":"C","text":"Gastrojejunostomy, pancreaticojejunostomy, hepaticojejunostomy,"},{"letter":"D","text":"Pancreaticojejunostomy, hepaticojejunostomy, gastrojejunostomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pancreaticojejunostomy, hepaticojejunostomy, gastrojejunostomy","explanation":"d. Pancreaticojejunostomy, hepaticojejunostomy, gastrojejunostomy"},{"n":174,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"All are true about pseudopapillary tumors of pancreas except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Most commonly occurs in young women"},{"letter":"B","text":"Both benign and malignant varieties are seen"},{"letter":"C","text":"These are small tumors"},{"letter":"D","text":"Local resection is usually curative"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"These are small tumors","explanation":"c. These are small tumors (Ref: Blumgart 6/e p968, 5/e p908-909; Shackelford 8/e p1173, 7/e p1268)"},{"n":175,"chapter":"Pancreas","src":"question on PDF p. 353 · answer on PDF p. 367","pdfPage":353,"stem":"All are true about Frantz tumor except: (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Seen in young females"},{"letter":"B","text":"Vimentin and CD 56 is positive"},{"letter":"C","text":"Indolent tumor with <15% incidence of metastasis"},{"letter":"D","text":"Chromagranin is positive"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Chromagranin is positive","explanation":"d. Chromagranin is positive\nINSULINOMA"},{"n":176,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 367","pdfPage":354,"stem":"Best method of localization of insulinoma: (ILBS 2011)","options":[{"letter":"A","text":"EUS with intra-operative palpation"},{"letter":"B","text":"MRI with dynamic CT"},{"letter":"C","text":"SRS"},{"letter":"D","text":"CECT"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"EUS with intra-operative palpation","explanation":"p1150, 7/e p1206-1210\nLocalization of Insulinoma\n• A small portion of insulinomas remain unlocalizable despite extensive studies and are therefore considered\noccult.\n• When the diagnosis is certain based on the result of a 72-hour fast, surgical exploration with careful inspection,\npalpation, and intraoperative ultrasound (IOUS) is indicatedQ.\n• Studies have shown that the combination of surgical exploration with IOUS identifies almost all insulinomasQ.\nAnswer (book): Answer: A. EUS with intra-operative palpation\nReference: Sabiston 20/e p947, 952; Schwartz 10/e p1391; Bailey 27/e p849; Blumgart 6/e p 1001, 5/e p935-937; Shackelford 8/e"},{"n":177,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 367","pdfPage":354,"stem":"Localization in insulinoma is best with: (COMEDK 2011)","options":[{"letter":"A","text":"Contrast CT"},{"letter":"B","text":"Magnetic Resonance Imaging"},{"letter":"C","text":"Somatostatin Receptor Scintigraphy"},{"letter":"D","text":"Selective arteriography"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Selective arteriography","explanation":"• Portal venous sampling for insulin with or without arterial stimulation with calcium is the best pre-operative\nmethod of localizationQ.\n• EUS with intra-operative palpation is best localization technique for InsulinomaQ.\nAnswer (book): Answer: D. Selective arteriography"},{"n":178,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"A 55-year old male presents with tachycardia, sweating, palpitation, giddiness. Most probable diagnosis: (JIPMER 2011)","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Zollinger-Ellison syndrome"},{"letter":"C","text":"Carcinoma pancreas"},{"letter":"D","text":"Carcinoid"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma","explanation":"a. Insulinoma"},{"n":179,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All are true about insulinoma except: (PGI Nov 2009)","options":[{"letter":"A","text":"Usually asymptomatic and need no treatment"},{"letter":"B","text":"Usually small and multiple"},{"letter":"C","text":"Diazoxide and octreotide reduce insulin synthesis"},{"letter":"D","text":"Most common site is pancreas"},{"letter":"E","text":"90% tumors are benign"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Usually asymptomatic and need no treatment","explanation":"a. Usually asymptomatic and need no treatment"},{"n":180,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"True about insulinoma is all except: (MHPGMCET 2003)","options":[{"letter":"A","text":"Common equally in the pancreatic head, body and tail"},{"letter":"B","text":"Hypoglycemic attacks occur"},{"letter":"C","text":"Weight loss is important feature"},{"letter":"D","text":"Attacks respond to glucose infusion"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Weight loss is important feature","explanation":"c. Weight loss is important feature"},{"n":181,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Gold standard test for insulinoma: (AIIMS May 2011)","options":[{"letter":"A","text":"72-hours fasting test"},{"letter":"B","text":"Plasma insulin levels"},{"letter":"C","text":"C-peptide levels"},{"letter":"D","text":"Low glucose levels < 30 mg/dL"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"72-hours fasting test","explanation":"a. 72-hours fasting test"},{"n":182,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Which of the following tests is not used in the diagnosis of insulinoma? (All India 2011)","options":[{"letter":"A","text":"Fasting blood glucose"},{"letter":"B","text":"Xylose test"},{"letter":"C","text":"C-peptide levels"},{"letter":"D","text":"Insulin/Glucose Ratio"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Xylose test","explanation":"b. Xylose test"},{"n":183,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Best modality for diagnosis of insulinoma: (PGI SS June 2007)","options":[{"letter":"A","text":"Intra-operative USG"},{"letter":"B","text":"Scintigraphy"},{"letter":"C","text":"Arteriography"},{"letter":"D","text":"Venous sampling"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Intra-operative USG","explanation":"a. Intra-operative USG"},{"n":184,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"A lady presented with recurrent attacks of giddiness and abdominal pain since three months. Endoscopy was normal. Her fasting blood glucose was 40 mg% and insulin levels were elevated. CT abdomen showed a well defined 8 mm enhancing lesion in the head of pancreas, with no other abnormal findings. What should be the treatment plan for this patient? (All India 2010)","options":[{"letter":"A","text":"Whipple’s operation"},{"letter":"B","text":"Enucleation"},{"letter":"C","text":"Enucleation with radiotherapy"},{"letter":"D","text":"Administratiaon of streptozocin"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Enucleation","explanation":"b. Enucleation"},{"n":185,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Which of the following is the most common endocrine tumor of pancreas? (AIIMS June 2004, PGI June 2006)","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Gastrinoma"},{"letter":"C","text":"VIPoma"},{"letter":"D","text":"Glucagonoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma","explanation":"NET of Pancreas\n• MC NET of Pancreas: Non-functional (Mostly malignant) >InsulinomaQ\n• MC benign NET of Pancreas: InsulinomaQ\n• MC malignant functional NET of Pancreas: GastrinomaQ\nAnswer (book): Answer: A. Insulinoma"},{"n":186,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Insulinoma is most commonly located in which part of the pancreas? (AIIMS June 2002)","options":[{"letter":"A","text":"Head"},{"letter":"B","text":"Body"},{"letter":"C","text":"Tail"},{"letter":"D","text":"Equally distributed"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Equally distributed","explanation":"d. Equally distributed"},{"n":187,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Whipples triad is seen in: (APPG 2015, WBPG 2012, DNB 2011, AIIMS Feb 97)","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Somatostatinoma"},{"letter":"C","text":"Glucagonoma"},{"letter":"D","text":"CA pancreas"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma","explanation":"a. Insulinoma"},{"n":188,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Most common site of insulinoma: (Recent Question 2017)","options":[{"letter":"A","text":"Head"},{"letter":"B","text":"Body"},{"letter":"C","text":"Tail"},{"letter":"D","text":"Equally distributed in head, body and tail"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Equally distributed in head, body and tail","explanation":"d. Equally distributed in head, body and tail (Ref: Sabiston 20/e p952; Schwartz 10/e p1391; Bailey 27/e p849)"},{"n":189,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Which is not true regarding insulinoma? (AIIMS Nov 95)","options":[{"letter":"A","text":"Hypoglycemic attacks"},{"letter":"B","text":"Weight loss"},{"letter":"C","text":"Usually solitary tumor"},{"letter":"D","text":"Mostly benign tumor"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Weight loss","explanation":"b. Weight loss"},{"n":190,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"MC site of gastrinoma: (GB Pant 2011)","options":[{"letter":"A","text":"Duodenum"},{"letter":"B","text":"Pancreas"},{"letter":"C","text":"Stomach"},{"letter":"D","text":"Colon"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Duodenum","explanation":"a. Duodenum (Ref: Sabiston 20/e p954; Schwartz 10/e p1071-1073; Bailey 27/e p850; Blumgart 6/e p999, 5/e p937-941; Shackelford 8/e p702,\n7/e p749-756)"},{"n":191,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All are true about gastrinoma except: (GB Pant 2011)","options":[{"letter":"A","text":"Abnormal peptic ulcer location"},{"letter":"B","text":"Diarrhea"},{"letter":"C","text":"Decreased BAO and MAO"},{"letter":"D","text":"Best treatment is omeprazole"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Decreased BAO and MAO","explanation":"• Basal acid output is increased in GastrinomaQ.\nAnswer (book): Answer: C. Decreased BAO and MAO"},{"n":192,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Localization of gastrinoma is best done by: (GB Pant 2011)","options":[{"letter":"A","text":"USG"},{"letter":"B","text":"CT"},{"letter":"C","text":"MRI"},{"letter":"D","text":"SRS"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"SRS","explanation":"d. SRS"},{"n":193,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All are true about gastrinoma except: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Mostly found in gastrinoma triangle"},{"letter":"B","text":"Increases acid production"},{"letter":"C","text":"Most common site is pancreas"},{"letter":"D","text":"Lymphadenectomy is not required as there is no improvement in survival"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Most common site is pancreas","explanation":"c. Most common site is pancreas"},{"n":194,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Least common site of gastrinoma: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"1st part of duodenum"},{"letter":"B","text":"2nd part of duodenum"},{"letter":"C","text":"3rd part of duodenum"},{"letter":"D","text":"4th part of duodenum"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"4th part of duodenum","explanation":"d. 4th part of duodenum"},{"n":195,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All are true about Zollinger-Ellison syndrome except: (DNB 2007, AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Recurrent ulceration after acid reducing surgery"},{"letter":"B","text":"Raised gastrin levels in all cases"},{"letter":"C","text":"Decreased BAO/MAO"},{"letter":"D","text":"Diarrhea"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Decreased BAO/MAO","explanation":"c. Decreased BAO/MAO"},{"n":196,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All are true about gastrinoma except: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"50% are associated with adrenal malign ancy"},{"letter":"B","text":"Duodenum is the most common site"},{"letter":"C","text":"Diarrhea can be prevented by NG aspiration"},{"letter":"D","text":"Total gastrectomy should be avoided"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"50% are associated with adrenal malignancy","explanation":"a. 50% are associated with adrenal malignancy"},{"n":197,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"All of the following are features of Zollinger-Ellison syndrome except: (AIIMS Nov 2005)","options":[{"letter":"A","text":"Intractable peptic ulcers"},{"letter":"B","text":"Severe diarrhea"},{"letter":"C","text":"Beta cell tumors of the pancreas"},{"letter":"D","text":"Very high acid output"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Beta cell tumors of the pancreas","explanation":"c. Beta cell tumors of the pancreas"},{"n":198,"chapter":"Pancreas","src":"question on PDF p. 354 · answer on PDF p. 368","pdfPage":354,"stem":"Treatment of Zollinger-Ellison syndrome: (DNB 2004, All India 88)","options":[{"letter":"A","text":"Total gastrectomy with removal of tumor"},{"letter":"B","text":"Partial gastrectomy"},{"letter":"C","text":"Excision of tumor alone"},{"letter":"D","text":"H 2 receptor antagonist"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"H2 receptor antagonist","explanation":"d. H2 receptor antagonist"},{"n":199,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"The investigation of choice to detect gastrinoma <5mm size is: (COMEDK 2014)","options":[{"letter":"A","text":"Endoscopic vctrasound"},{"letter":"B","text":"Octreotide scan"},{"letter":"C","text":"CT scan"},{"letter":"D","text":"Portal venous sampling"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Endoscopic ultrasound","explanation":"a. Endoscopic ultrasound"},{"n":200,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"What is the name of this triangle? (Recent Question 2019)","options":[{"letter":"A","text":"Gastrinoma triangle"},{"letter":"B","text":"Calot’s triangle"},{"letter":"C","text":"Doom’s triangle"},{"letter":"D","text":"Cholecystohepatic triangle"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gastrinoma triangle","explanation":"a. Gastrinoma triangle (Ref: Schwartz 10/e p1392; Sabiston 20/e p954; Bailey 27/e p1141)"},{"n":201,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Not a boundary of gastrinoma triangle: (DNB 2011, DPG 2007)","options":[{"letter":"A","text":"Junction of 2 nd and 3 rd part of duodenum"},{"letter":"B","text":"Junction of 3 rd and 4 th part of duodenum"},{"letter":"C","text":"Junction of head with body of pancreas"},{"letter":"D","text":"Junction of cystic duct with common bile duct"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Junction of 3rd and 4th part of duodenum","explanation":"b. Junction of 3rd and 4th part of duodenum"},{"n":202,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Which of the following organs is the most common site of origin of the tumor associated with the Zollinger-Ellison syndrome? (COMEDK 2011 2008, 2007)","options":[{"letter":"A","text":"Duodenum"},{"letter":"B","text":"Lymph nodes"},{"letter":"C","text":"Spleen"},{"letter":"D","text":"Pancreas"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Duodenum","explanation":"a. Duodenum"},{"n":203,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"A 45-year-old gentleman has undergone truncal vagotomy and pyloroplasty for bleeding duodenal ulcer seven years ago. Now he has intractable recurrent symptoms of peptic ulcer. All of the following suggest the diagnosis of Zollinger Ellison syndrome, except: (AIIMS May 2006)","options":[{"letter":"A","text":"Basal acid output of 15 mEq/hour"},{"letter":"B","text":"Serum gastrin value of 500 pg/ml"},{"letter":"C","text":"Ulcers in proximal jejunum and lower end of esophagus"},{"letter":"D","text":"Serum gastrin value of 200 pg/ml with secretin stimulation"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Serum gastrin value of 200 pg/ml with secretin stimulation","explanation":"d. Serum gastrin value of 200 pg/ml with secretin stimulation"},{"n":204,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Zollinger-Ellison syndrome is characterized by all of the following except: (All India 94)","options":[{"letter":"A","text":"Post bulbar ulcer"},{"letter":"B","text":"Recurrent duodenal ulcer"},{"letter":"C","text":"Severe diarrhea"},{"letter":"D","text":"Massive HCl secretion in response to histamine injection"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Massive HCl in response to histamine injection","explanation":"d. Massive HCl in response to histamine injection"},{"n":205,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"True about ZES (gastrinoma): (PGI June 2001)","options":[{"letter":"A","text":"Gastrin levels >1000 pg/mL"},{"letter":"B","text":"BAO (Basal acid output) >15 mEq/hr"},{"letter":"C","text":"Somatostatin is inhibitor of HCL secretion"},{"letter":"D","text":"Omeprazole is helpful"},{"letter":"E","text":"Secretin increases gastrin secretion in Zollinger-Ellison syndrome"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gastrin levels >1000 pg/mL, B. BAO (Basal acid output) >15 meq/hr, C. Somatostatin is inhibitor of","explanation":"HCL secretion, D.\nOmeprazole is helpful, e. Secretin increases gastrin secretion in Zollinger-Ellison syndrome\nAnswer (book): Answer: A. Gastrin levels >1000 pg/mL, B. BAO (Basal acid output) >15 meq/hr, C. Somatostatin is inhibitor of"},{"n":206,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Zollinger-Ellison syndrome, all are true except: (PGI June 2008)","options":[{"letter":"A","text":"Surgery is to be done"},{"letter":"B","text":"Exocrine tumor"},{"letter":"C","text":"Endocrine disorder"},{"letter":"D","text":"Secretary diarrhea seen"},{"letter":"E","text":"Metastasis seen"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Exocrine tumor","explanation":"b. Exocrine tumor"},{"n":207,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Which of the following is not true for Zollinger-Ellison syndrome? (DNB 2002, MCI June 2018, Sept 2008)","options":[{"letter":"A","text":"Recurrence after operation"},{"letter":"B","text":"Reduced BAO: MAO ratio"},{"letter":"C","text":"Gastrin producing tumour"},{"letter":"D","text":"Diarrhea may be a presenting features"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Reduced BAO: MAO ratio","explanation":"b. Reduced BAO: MAO ratio"},{"n":208,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Diarrhoea with non-healing Gastric ulcer with PPI is due to: (DNB 2014)","options":[{"letter":"A","text":"MEN 1 syndrome"},{"letter":"B","text":"Zollinger-Ellison syndrome"},{"letter":"C","text":"H. pylori infection"},{"letter":"D","text":"VIPoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Zollinger-Ellison syndrome","explanation":"b. Zollinger-Ellison syndrome"},{"n":209,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Which of the following does not form the boundary of gastrinoma triangle? (Recent Question 2017)","options":[{"letter":"A","text":"Pylorus"},{"letter":"B","text":"Junction of neck and body of pancreas"},{"letter":"C","text":"Cystic duct and CBD junction"},{"letter":"D","text":"Junction of 2nd and 3rd part of duodenum"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pylorus","explanation":"a. Pylorus (Ref: Sabiston 20/e p1210; Schwartz 10/e p1392; Bailey 27/e p851)"},{"n":210,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"A patient presented with pain in left hypochondrium, vomiting, diarrhea, melena and weight loss. Most probable diagnosis is: (Recent Question 2015)","options":[{"letter":"A","text":"Cholangitis"},{"letter":"B","text":"Enterocolitis"},{"letter":"C","text":"Zollinger-Ellison syndrome"},{"letter":"D","text":"Amoebiasis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Zollinger-Ellison syndrome","explanation":"c. Zollinger-Ellison syndrome"},{"n":211,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Metastatic glucagonoma is best detected by: (AIIMS GIS 2003)","options":[{"letter":"A","text":"SRS"},{"letter":"B","text":"CT"},{"letter":"C","text":"MRI"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"SRS","explanation":"a. SRS (Ref: Sabiston 20/e p957; Schwartz 10/e p1393; Bailey 27/e p849; Blumgart 6/e p1001, 5/e p940-941; Shackelford 8/e p1150, 7/e p1211-1212)"},{"n":212,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Most common endocrine tumor of pancreas is: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Gastrinoma"},{"letter":"C","text":"Somatostatinoma"},{"letter":"D","text":"VIPoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma","explanation":"a. Insulinoma"},{"n":213,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Best investigation for neuroendocrine tumors of pancreas: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Portal venous sampling"},{"letter":"B","text":"CECT"},{"letter":"C","text":"EUS"},{"letter":"D","text":"SRS"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"SRS","explanation":"d. SRS (Ref: Sabiston 20/e p947)"},{"n":214,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Migratory skin necrosis in a diabetic patient is due to: (AIIMS GIS Dec 2006)","options":[{"letter":"A","text":"Somatostatinoma"},{"letter":"B","text":"Glucagonoma"},{"letter":"C","text":"Insulinoma"},{"letter":"D","text":"VIPoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Glucagonoma","explanation":"b. Glucagonoma"},{"n":215,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Which is not true about non-functioning NET of pancreas? (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Most PPomas are benign"},{"letter":"B","text":"Slow growing tumors"},{"letter":"C","text":"Constitute 30% of all pancreatic NET"},{"letter":"D","text":"Prognosis is better than other exocrine tumors"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Most PPomas are benign","explanation":"a. Most PPomas are benign (Ref: Sabiston 20/e p958; Schwartz 10/e p1393; Bailey 27/e p852; Shackelford 8/e p1155, 7/e p1213-1214)"},{"n":216,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"In VIPoma, not seen: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Watery diarrhea"},{"letter":"B","text":"Hypokalemia"},{"letter":"C","text":"Hypercalcemia and hyperglycemia"},{"letter":"D","text":"Increased acid secretion"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Increased acid secretion","explanation":"d. Increased acid secretion (Ref: Sabiston 19/e p954, 956, 960; Schwartz 10/e p1392-1393; Bailey 27/e p850)"},{"n":217,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"Gallstones are associated with which NET: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"VIPoma"},{"letter":"C","text":"Somatostatinoma"},{"letter":"D","text":"Glucagonoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Somatostatinoma","explanation":"c. Somatostatinoma (Ref: Sabiston 20/e p957; Schwartz 10/e p1393; Bailey 27/e p849)"},{"n":218,"chapter":"Pancreas","src":"question on PDF p. 355 · answer on PDF p. 368","pdfPage":355,"stem":"The given manifestation is the most common symptom of which of the following neuroendocrine tumor of pancreas?","options":[{"letter":"A","text":"Insulinoma"},{"letter":"B","text":"Glucagonoma"},{"letter":"C","text":"Gastrinoma"},{"letter":"D","text":"Somatostatinoma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Glucagonoma","explanation":"Necrolytic erythema migrans is the most common symptom of glucagonoma.\nAnswer (book): Answer: B. Glucagonoma\nReference: Sabiston 20/e p957; Schwartz 10/e p1393; Bailey 27/e p849"},{"n":219,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"Necrolytic migratory erythema is seen in: (Recnet Question 2016, AIIMS GIS May 2011)","options":[{"letter":"A","text":"Glucagonoma"},{"letter":"B","text":"Somatostatinoma"},{"letter":"C","text":"VIPoma"},{"letter":"D","text":"Insulinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Glucagonoma","explanation":"a. Glucagonoma"},{"n":220,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"The triad of diabetes, gallstones and steatorrhoea is associated with which one of the following tumors? (COMEDK 2014, 2009, 2007)","options":[{"letter":"A","text":"Gastrinomas"},{"letter":"B","text":"Somaststationomas"},{"letter":"C","text":"VIPomas"},{"letter":"D","text":"Glucagonomas"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Somaststationomas","explanation":"b. Somaststationomas"},{"n":221,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"Neurotensinoma causes: (COMEDK 2010)","options":[{"letter":"A","text":"Cyanosis"},{"letter":"B","text":"Hypertension"},{"letter":"C","text":"Hyperkalemia"},{"letter":"D","text":"Weight gain"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cyanosis","explanation":"a. Cyanosis (Ref: Sabiston 20/e p956)"},{"n":222,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"Most cases of neuroendocrine tumors are diagnosed by: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"SRS"},{"letter":"B","text":"Portal venous sampling"},{"letter":"C","text":"Arteriography"},{"letter":"D","text":"CT"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"SRS","explanation":"a. SRS"},{"n":223,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"WDHA syndrome is associated with: (Recent Question 2017)","options":[{"letter":"A","text":"VIPoma"},{"letter":"B","text":"Somatostatinoma"},{"letter":"C","text":"Glucagonoma"},{"letter":"D","text":"Gastrinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"VIPoma","explanation":"a. VIPoma (Ref: Sabiston 20/e p965; Schwartz 10/e p1392; Bailey 27/e p849)"},{"n":224,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"Which of the following is known as 4D (DVT, Depression, Dermatitis & Diarrhoea) syndrome: (Recent Question 2017)","options":[{"letter":"A","text":"Glucagonoma"},{"letter":"B","text":"VIPoma"},{"letter":"C","text":"Somatostatinoma"},{"letter":"D","text":"Gastrinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Glucagonoma","explanation":"a. Glucagonoma (Ref: Sabiston 20/e p957; Schwartz 10/e p1393; Bailey 27/e p849)"},{"n":225,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 368","pdfPage":356,"stem":"All are true about neuroendocrine tumor of pancreas: (PGI May 2011)","options":[{"letter":"A","text":"Insulinoma is MC"},{"letter":"B","text":"VIP cause diarrhea"},{"letter":"C","text":"Diarrhea is MC symptom of gastrinoma"},{"letter":"D","text":"Somatostatinoma cause gallstone formation"},{"letter":"E","text":"Gastrinoma has high chance of malignancy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Insulinoma is MC, B. VIP cause diarrhea, D. Somatostatinoma cause gallstone formation, E.","explanation":"Gastrinoma has high chance of malignancy\nNET of Pancreas\n• Gastrinoma\nMC site\n• Duodenum (1st part) >PancreasQ\n• Insulinoma\n• Equally distributedQ in head, body and tail\n• Glucagonoma\n• Body and TailQ\n• Somatostatinoma and PPoma\n• HeadQ\n• VIPoma\n• TailQ\nAll pancreatic cancers and neoplastic cysts are most common in pancreatic head except:\n• Mucinous cystic neoplasm and Glucagonoma: MC in body and tailQ\nTumor\n• VIPoma: MC in TailQ\n• Insulinoma: Equally distributedQ in head, body and tail\nAnswer (book): Answer: A. Insulinoma is MC, B. VIP cause diarrhea, D. Somatostatinoma cause gallstone formation, E."},{"n":226,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 369","pdfPage":356,"stem":"Pancreas divisum: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Most common congenital anomaly"},{"letter":"B","text":"Most are symptomatic"},{"letter":"C","text":"Failure of fusion of dorsal and ventral pancreas"},{"letter":"D","text":"Dorsal duct dilation at lesser papilla is curative"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Most common congenital anomaly","explanation":"a. Most common congenital anomaly  (Ref: Sabiston 20/e p1522; Schwartz 10/e p1365-1366; Bailey 27/e p1219; Blumgart 6/e p861,\n5/e p818-819; Shackelford 8/e p1127, 7/e p1134-1135)"},{"n":227,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 369","pdfPage":356,"stem":"What is the most probable diagnosis based on the given image?","options":[{"letter":"A","text":"Annular pancreas"},{"letter":"B","text":"Pancreas divisum"},{"letter":"C","text":"Chronic pancreatitis"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pancreas divisum","explanation":"In this ERCP, major part of pancreas is drained by accessory duct of Santorini via minor papilla and\nhead and uncinate process is drained by duct of Wirsung via ampulla suggestive of pancreas divisum. Pancreas\nDivisum\nImage-based question: the picture / video this question refers to is on PDF p. 356 of the source and is not reproduced here.\nAnswer (book): Answer: B. Pancreas divisum\nReference: Sabiston 20/e p1522; Schwartz 10/e p1366; Bailey 27/e p1219"},{"n":228,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 369","pdfPage":356,"stem":"All are true for annular pancreas except: (PGI Nov 2009)","options":[{"letter":"A","text":"Upper GI series is IOC"},{"letter":"B","text":"Duodenal obstruction present"},{"letter":"C","text":"ERCP is done"},{"letter":"D","text":"Non-rotation of gut"},{"letter":"E","text":"Treatment is division of ring"}],"multi":null,"correctSet":["E"],"answerIdx":4,"answerLetter":"E","answerText":"Treatment is division of ring","explanation":"e. Treatment is division of ring  (Ref: Sabiston 20/e p1522; Bailey 27/e p1219; Blumgart 6/e p870, 5/e p823-826; Shackelford 8/e p1215,\n7/e p1179-1180)"},{"n":229,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 369","pdfPage":356,"stem":"Treatment of choice for annular pancreas: (NEET Pattern, MHSSMCET 2006)","options":[{"letter":"A","text":"Duodenojejunostomy"},{"letter":"B","text":"Distal pancreatectomy"},{"letter":"C","text":"Proximal pancreatectomy"},{"letter":"D","text":"Duodenoduodenostomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Duodenoduodenostomy","explanation":"• Read the text from the latest edition of Blumgart, surgery of liver, biliary tract and pancreas. It clears that\nduodenoduodenostomy is the treatment of choice for annular pancreas, not the duodenojejunostomy given in\nHarrison or Maingot.\n• Duodenoduodenostomy has replaced duodenojejunostomy as the treatment of choiceQ because it has a lower\nincidence of postoperative complications, particularly obstruction and blind-loop syndromesQ.\nTreatment of Annular Pancreas\n• A review of the existing literature published in 1980 concluded that “while there is no single operative procedure\nof choice, experience militates against any direct attack on the offending annulus”. This conclusion stands, and\nany attempt to divide the annulus itself risks the formation of a pancreatic fistula.\n• Early pediatric series established duodenal bypass as the treatment of choice, although mortality rates remained\nhigh, likely related to the presence of other congenital malformations and the lack of supportive care.\n• Duodenoduodenostomy has replaced duodenojejunostomy as the treatment of choice because it has a lower\nincidence of postoperative complications, particularly obstruction and blind-loop syndromesQ.\nAnswer (book): Answer: D. Duodenoduodenostomy\nReference: Blumgart 6/e p860, 5/e p823-826"},{"n":230,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 369","pdfPage":356,"stem":"Treatment of choice for annular pancreas is: (All India 2010)","options":[{"letter":"A","text":"Division of pancreas"},{"letter":"B","text":"Duodenoduodenostomy"},{"letter":"C","text":"Doudenojejunostomy"},{"letter":"D","text":"Roux-en-Y loop"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Duodenoduodenostomy","explanation":"b. Duodenoduodenostomy"},{"n":231,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 370","pdfPage":356,"stem":"True about pancreatic trauma: (AIIMS GIS 2003)","options":[{"letter":"A","text":"Hyperamylasemia is not specific"},{"letter":"B","text":"Most common is type III and IV"},{"letter":"C","text":"Type II is MPD disruption"},{"letter":"D","text":"ERCP should be done in all patients"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hyperamylasemia is not specific","explanation":"a. Hyperamylasemia is not specific (Ref: Sabiston 20/e p440, 1552; Schwartz 9/e p179)"},{"n":232,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 370","pdfPage":356,"stem":"Which of the following is true about pancreatic injury? (Recent Question 2015)","options":[{"letter":"A","text":"Most cases are iatrogenic"},{"letter":"B","text":"Blunt trauma is the most common cause"},{"letter":"C","text":"Urine amylase is diagnostic"},{"letter":"D","text":"HRCT is investigation of choice"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"HRCT is investigation of choice","explanation":"d. HRCT is investigation of choice"},{"n":233,"chapter":"Pancreas","src":"question on PDF p. 356 · answer on PDF p. 370","pdfPage":356,"stem":"Regarding injury to pancreas, which is not true? (AIIMS Nov 94)","options":[{"letter":"A","text":"Majority of postoperative complications are due to missed duct injury"},{"letter":"B","text":"Fracture is common at the junction of head and body"},{"letter":"C","text":"Commonly associated with vascular injury"},{"letter":"D","text":"Peritoneal lavage is good for making the diagnosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Fracture is common at the junction of head and body, D. Peritoneal lavage is good for making the","explanation":"b. Fracture is common at the junction of head and body, d. Peritoneal lavage is good for making the diagnosis"},{"n":234,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"True in pancreatic trauma: (PGI June 2006)","options":[{"letter":"A","text":"Solitary involvement common"},{"letter":"B","text":"Blunt injury usual cause"},{"letter":"C","text":"Always surgery needed"},{"letter":"D","text":"Amylase increases in 90% cases"},{"letter":"E","text":"HRCT is investigation of choice"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Amylase increases in 90% cases, E. HRCT is investigation of choice","explanation":"d. Amylase increases in 90% cases, e. HRCT is investigation of choice"},{"n":235,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"The advantage of bladder drainage over enteric drainage after pancreatic transplantation is better monitoring of: (All India 2009)","options":[{"letter":"A","text":"HBA IC levels"},{"letter":"B","text":"Amylase levels"},{"letter":"C","text":"Glucose levels"},{"letter":"D","text":"Electrolyte levels"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Amylase levels","explanation":"Shackelford 8/e p1230, 7/e p1251-1260\n\n• Bailey 25/e p1425: ‘Urinary drainage of the pancreas has the advantage that urinary amylase levels can be used\nto monitor graft rejection’Q\nAnswer (book): Answer: B. Amylase levels\nReference: Sabiston 20/e p644-665; Schwartz 10/e p340-344; Bailey 27/e p1553; Blumgart 6/e p1881, 5/e p1796-1805;"},{"n":236,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Treatment of congenital cyst of head of pancreas:","options":[{"letter":"A","text":"Total excision"},{"letter":"B","text":"Partial excision"},{"letter":"C","text":"Marsupialization"},{"letter":"D","text":"Observe and medical treatment"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Observe and medical treatment","explanation":"d. Observe and medical treatment (Ref: Blumgart 6/e p873, 5/e p827; Bailey 27/e p120)"},{"n":237,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"In mucoviscidosis of the pancreas the commonest defect is in the:","options":[{"letter":"A","text":"Jejunum"},{"letter":"B","text":"Ileum"},{"letter":"C","text":"Ascending colon"},{"letter":"D","text":"Descending colon"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Ileum","explanation":"• Terminal ileum is filled with meconium in mucoviscidosis.\nAnswer (book): Answer: B. Ileum"},{"n":238,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Leukocytic infiltration in islet cells of pancreas is characteristically seen in some cases of:","options":[{"letter":"A","text":"Juvenile diabetes"},{"letter":"B","text":"Diabetic ketosis"},{"letter":"C","text":"Systemic mucoviscidosis"},{"letter":"D","text":"Hemorrhagic pancreatic necrosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Juvenile diabetes","explanation":"• Type 1 diabetes is a T cell-mediated autoimmune disease, characterized by lymphocytic infiltration of the\npancreatic isletsQ.\nAnswer (book): Answer: A. Juvenile diabetes"},{"n":239,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Ectopic pancreatic tissue is present in all except: (ILBS 2012)","options":[{"letter":"A","text":"Stomach"},{"letter":"B","text":"Meckel’s diverticulum"},{"letter":"C","text":"Mesentery"},{"letter":"D","text":"Umbilicus"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mesentery","explanation":"Ectopic Pancreas\nThe most common sites are in the walls of the stomachQ, duodenumQ, or ileum, in a Meckels diverticulumQ, or at\nthe umbilicusQ Less common sites include the colon, appendix, gallbladder, omentum, and mesentery. Most ectopic\npancreatic tissue is functionalQ. Islet tissue is frequently present when ectopic pancreas is located in the stomach\nand duodenum. Ectopic pancreatic tissue is a submucosal, irregular nodule of firm, yellow tissue that has a central\numbilicationQ; pancreatic secretions often exit through this umbilication.\nAnswer (book): Answer: C. Mesentery\nReference: Sabiston 20/e p1522; Bailey 27/e p1219; Blumgart 6/e p873, 5/e p827"},{"n":240,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"The neck of pancreas is related on its posterior surface to: (AIIMS May 2005)","options":[{"letter":"A","text":"Gastroduodenal artery"},{"letter":"B","text":"Superior mesenteric vein"},{"letter":"C","text":"Inferior vena cava"},{"letter":"D","text":"Bile duct"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Superior mesenteric vein","explanation":"• The posterior surface of neck of pancreas is related to the termination of superior mesenteric vein and beginning\nof portal veinQ.\nAnswer (book): Answer: B. Superior mesenteric vein\nReference: BDC 4/e pvol-II/284-285"},{"n":241,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Increased amylase levels in pleural fluid are seen in: (Bihar 2003)","options":[{"letter":"A","text":"Malignancy"},{"letter":"B","text":"Pancreatitis"},{"letter":"C","text":"Esophageal rupture"},{"letter":"D","text":"All"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All","explanation":"d. All"},{"n":242,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"True increase in islet cell: (PGI Dec 2002)","options":[{"letter":"A","text":"Nesidioblastoma"},{"letter":"B","text":"Type II DM"},{"letter":"C","text":"Insulinoma"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Insulinoma","explanation":"c. Insulinoma"},{"n":243,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"All of the following statements about Nesidioblastosis are true, except: (All India 2011)","options":[{"letter":"A","text":"Hypoglycemic episodes may be seen"},{"letter":"B","text":"Occurs in adults more than children"},{"letter":"C","text":"Histopathology shows hyperplasia of islet cells"},{"letter":"D","text":"Diazoxide may be used for treatment"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Occurs in adults more than children","explanation":"b. Occurs in adults more than children"},{"n":244,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"All of the following are true about diazoxide except: (AIIMS May 2011)","options":[{"letter":"A","text":"K+ channel opener"},{"letter":"B","text":"Can be used as antihypertensive agent"},{"letter":"C","text":"Causes severe hypoglycemia"},{"letter":"D","text":"Used in insulinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Causes severe hypoglycemia","explanation":"Diazoxide\n• K+ channel opener, causes arteriolar dilatationQ\n• Diazoxide produces hyperglycemia by decreasing insulinQ Used in insulinomaQ\n• When used as intravenous antihypertensive agentQ, it causes excessive hypotension\nAnswer (book): Answer: C. Causes severe hypoglycemia\nReference: Goodman Gilman 12/ep1271"},{"n":245,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Open sphincteroplasty is done at: (MHSSMCET 2009)","options":[{"letter":"A","text":"12 O’ clock position"},{"letter":"B","text":"11 O’ clock position"},{"letter":"C","text":"6 O’ clock position"},{"letter":"D","text":"2 O’ clock position"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"11 O’ clock position","explanation":"Transduodenal Sphincteroplasty\n• This cut is made superiorly (at the 11’ O clock position) Q for 4 to 5 mm.\n• The sphincter is incised at the 11’ O clock position to avoid injury to the pancreatic ductQ.\nAnswer (book): Answer: B. 11 O’ clock position\nReference: Sabiston 20/e p1396; Schwartz 10/e p1327"},{"n":246,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Ectopic pancreatic tissue with islet cells are seen in: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Stomach"},{"letter":"B","text":"Meckel’s diverticulum"},{"letter":"C","text":"Omentum"},{"letter":"D","text":"Appendix"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stomach","explanation":"a. Stomach"},{"n":247,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Which of the following is not true about polycystic disease of pancreas? (AIIMS GIS May 2008)","options":[{"letter":"A","text":"Associated with liver and renal cyst"},{"letter":"B","text":"50% associated with VHL syndrome"},{"letter":"C","text":"Surgical intervention is required in most because of features of chronic pancreatitis"},{"letter":"D","text":"Lining of cyst wall is cuboidal"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Surgical intervention is required in most because of features of chronic pancreatitis","explanation":"c. Surgical intervention is required in most because of features of chronic pancreatitis"},{"n":248,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 370","pdfPage":357,"stem":"Which of the following types of islet cells secrete amylin? (All India 2012)","options":[{"letter":"A","text":"Alpha cells"},{"letter":"B","text":"Beta cells"},{"letter":"C","text":"Delta cells"},{"letter":"D","text":"F cells"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Beta cells","explanation":"Islet Cells\nContent\n• Glucagon, glicentinQ, pancreastatinQ\n• Beta cells\n• Insulin, amylinQ, pancreastatinQ\n• D cells\n• Somatostatin\n• D2 cells\n• VIP\n• G cells\n• Gastrin\n• PP cells\n• Pancreatic polypeptide\nAnswer (book): Answer: B. Beta cells\nReference: Sabiston 20/e p943"},{"n":249,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 371","pdfPage":357,"stem":"Investigation of choice to visualise pancreas is: (DNB 2006)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"CT Scan"},{"letter":"C","text":"USG abdomen"},{"letter":"D","text":"ERCP"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"CT Scan","explanation":"• Alpha cells\n• CT is the mainstay of pancreatic imaging, able to demonstrate focal masses within the gland calcifications, duct\ndilatation, cysts, abscesses and associated abnormalities in upper abdominal organs (hepatic metastases), lymph\nnodes and peri-pancreatic vascular structures.\n• CT is a useful tool for guiding percutaneous pancreatic biopsy and cyst aspiration or drainage.\nAnswer (book): Answer: B. CT scan\nReference: Sutton 7/e p796"},{"n":250,"chapter":"Pancreas","src":"question on PDF p. 357 · answer on PDF p. 371","pdfPage":357,"stem":"Which structure is marked in the given ERCP image? (Recent Question 2016)","options":[{"letter":"A","text":"Gallbladder"},{"letter":"B","text":"Cystic duct"},{"letter":"C","text":"Common hepatic duct"},{"letter":"D","text":"Common bile duct"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cystic duct","explanation":"b. Cystic duct (Ref: Sabiston 20/e p1482)"},{"n":1,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Which of the following is the most important determinant of prognosis in neonatal congenital diaphragmatic hernia (CDH)? (All India 2011)","options":[{"letter":"A","text":"Pulmonary hypertension"},{"letter":"B","text":"Delay in surgery"},{"letter":"C","text":"Size of defect"},{"letter":"D","text":"Gestational age at diagnosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pulmonary hypertension","explanation":"a. Pulmonary hypertension (Ref: Sabiston 20/e p1863-1864; Schwartz 10/e p1603-1605; Bailey 27/e p938; Shackelford 7/e p506)"},{"n":2,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Which of the following is the least important prognostic factor in congenital diaphragmatic hernia? (All India 2011)","options":[{"letter":"A","text":"Pulmonary Hypertension"},{"letter":"B","text":"Delay in emergent surgery"},{"letter":"C","text":"Size of defect"},{"letter":"D","text":"Gestational age at diagnosis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Delay in emergent surgery","explanation":"Prognostic Factors in CDH | Primary Prognostic Factors | Secondary Prognostic Factors | Pulmonary\nhypoplasia (Most importantQ)\n• Pulmonary hypoplasia is the major determinant of survivalQ.\n• Degree of pulmonary hypoplasia closely correlates with degree of pulmonary hypertensionQ.\nAntenatal\nEarly gestational age (<24 weeks) Extradiaphragmatic anomaliesQ Stomach herniation Small lung to head\ncircumference ratio Small fetal abdominal circumference PolyhydramniosQ Size of defectQ Q\nPulmonary hypertension (Important)Q\nPostnatal\n• The combined effect of pulmonary hypoplasia and pulmonary hypertension is believed to be MC cause of\nmortality in CDHQ.\n• Early presentation (within 6 hours)\n• PO2 and PCO2 unresponsive to ventilation\n• Need for extra-corporeal membrane oxygenation (ECMO)Q Q\nSide of Defect\n• Right sided defects have poor prognosisQ\nAnswer (book): Answer: B. Delay in emergent surgery\nReference: Nelson 20/e p862; Fundamentals of Pediatric Surgery (Springer) 2011/535,536"},{"n":3,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"All are true about Bochdalek hernia except: (GB Pant 2011)","options":[{"letter":"A","text":"Posterolateral"},{"letter":"B","text":"Left side"},{"letter":"C","text":"Present in second decade"},{"letter":"D","text":"Congenital"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Present in second decade","explanation":"c. Present in second decade"},{"n":4,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Most common organ that herniates in Morgagni’s hernia: (MHSSMCET 2009)","options":[{"letter":"A","text":"Spleen"},{"letter":"B","text":"Liver"},{"letter":"C","text":"Stomach"},{"letter":"D","text":"Transverse colon"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Transverse colon","explanation":"d. Transverse colon (Ref: Sabiston 20/e p1863-1864; Schwartz 9/e p1416-1418; Bailey 27/e p938; Shackelford 7/e p506)"},{"n":5,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Which of the following is contraindication for Bag and mask ventilation? (AIIMS June 2000)","options":[{"letter":"A","text":"Septicemia"},{"letter":"B","text":"Tracheoesophageal fistula"},{"letter":"C","text":"Meconium aspiration"},{"letter":"D","text":"Diaphragmatic hernia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Diaphragmatic hernia","explanation":"d. Diaphragmatic hernia"},{"n":6,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"False regarding Bochdalek hernia is: (AIIMS Nov 93)","options":[{"letter":"A","text":"Spleen and kidney can herniate"},{"letter":"B","text":"Occurs posterolaterally"},{"letter":"C","text":"Always occurs on right side"},{"letter":"D","text":"Hernia may or may not have sac"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Always occurs on right side","explanation":"c. Always occurs on right side"},{"n":7,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Not true about Bochdalek hernia: (Recent Question 2015, AIIMS Nov 97)","options":[{"letter":"A","text":"Seen on right side"},{"letter":"B","text":"Associated with hypoplasia of lung"},{"letter":"C","text":"Associated with hiatus hernia"},{"letter":"D","text":"Pericardial cyst is a differential diagnosis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Seen on right side","explanation":"a. Seen on right side"},{"n":8,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"The diagnostic feature of congenital diaphragmatic hernia on prenatal ultrasonography is: (AIIMS June 2001)","options":[{"letter":"A","text":"A cyst behind the left atrium"},{"letter":"B","text":"Mediastinal shift with normal heart axis"},{"letter":"C","text":"Peristalsis in the thoracic cavity"},{"letter":"D","text":"Absence of gas bubble under the diaphragm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Peristalsis in the thoracic cavity","explanation":"c. Peristalsis in the thoracic cavity"},{"n":9,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Most common site of Morgagni hernia: (AIIMS Nov 2006)","options":[{"letter":"A","text":"Right anterior"},{"letter":"B","text":"Right posterior"},{"letter":"C","text":"Left anterior"},{"letter":"D","text":"Left posterior"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Right anterior","explanation":"a. Right anterior"},{"n":10,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"In congenital diaphragmatic hernia all are seen except: (JIPMER 99)","options":[{"letter":"A","text":"Common on left side"},{"letter":"B","text":"Abdominal distension"},{"letter":"C","text":"Can be detected antenatally"},{"letter":"D","text":"Heart beat shifted to right"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Abdominal distension","explanation":"b. Abdominal distension"},{"n":11,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Morgagni hernia: (APPG 98)","options":[{"letter":"A","text":"Hernia between the costal and sternal part of the diaphragm"},{"letter":"B","text":"Hernia through the pleuriperitoneal canal"},{"letter":"C","text":"Hernia through the lumbar triangle"},{"letter":"D","text":"Hernia through inguinal canal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hernia between the costal and sternal part of the diaphragm","explanation":"a. Hernia between the costal and sternal part of the diaphragm"},{"n":12,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"A neonate with a scaphoid abdomen and respiratory distress has: (All India 94)","options":[{"letter":"A","text":"Congenital pyloric stenosis"},{"letter":"B","text":"Diaphragmatic hernia"},{"letter":"C","text":"Volvulus"},{"letter":"D","text":"Wilm’s tumor"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Diaphragmatic hernia","explanation":"b. Diaphragmatic hernia"},{"n":13,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Most common content of Morgagni foramen: (Recent Question 2017)","options":[{"letter":"A","text":"Stomach"},{"letter":"B","text":"Small intestine"},{"letter":"C","text":"Transverse colon"},{"letter":"D","text":"Spleen"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Transverse colon","explanation":"“The foramen of Morgagni: A hernia in the anterior part of the diaphragm with a defect between the\nsternal and costal attachments. The most commonly involved viscus is the transverse colon.”-Bailey 27/e p938\nAnswer (book): Answer: C. Transverse colon\nReference: Sabiston 20/e p1863; Bailey 27/e p938"},{"n":14,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Most common diaphragmatic hernia in a newborn infant: (Recent Question 2017)","options":[{"letter":"A","text":"Bochdalek"},{"letter":"B","text":"Morgagni"},{"letter":"C","text":"Paraesophageal type I"},{"letter":"D","text":"Paraesophageal type III"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Bochdalek","explanation":"“Bochdalek hernias otherwise known as posterolateral hernias, make up 85% of congenital hernias.\nThey occur on the left side 80% of the time.”- Shackelford 7/e p506\nAnswer (book): Answer: A. Bochdalek\nReference: Shackelford 7/e p506; Sabiston 20/e p1863; Schwartz 10/e p1604"},{"n":15,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"True about hiatus hernia: (PGI June 2008)","options":[{"letter":"A","text":"Surgery is indicated in all symptomatic cases"},{"letter":"B","text":"Para-esophageal type is more complicated"},{"letter":"C","text":"Para-esophageal type is common type"},{"letter":"D","text":"Common in infants"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Surgery is indicated in all symptomatic cases, B. Para-esophageal type is more complicated","explanation":"a. Surgery is indicated in all symptomatic cases, b. Para-esophageal type is more complicated  (Ref: Sabiston 20/e p1059-1060;\nSchwartz 10/e p980-984; Bailey 27/e p1083; Shackelford 7/e p494-505)"},{"n":16,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"Select the TRUE statement regarding the picture depicted here: (APPG 2016)","options":[{"letter":"A","text":"A is known as sliding hernia"},{"letter":"B","text":"Part of upper stomach enters into thorax in both A and B"},{"letter":"C","text":"A is the more common form"},{"letter":"D","text":"A causes symptoms of gastroesophageal reflux"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Part of upper stomach enters into thorax in both A and B","explanation":"b. Part of upper stomach enters into thorax in both A and B (Ref: Sabiston 20/e p1059-1060; Schwartz 10/e p980; Bailey 27/e p1083-\n1084; Shackelford 7/e p494-505)"},{"n":17,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"The most common complication seen in hiatus hernia is: (DNB, 2011, All India 2005)","options":[{"letter":"A","text":"Esophagitis"},{"letter":"B","text":"Aspiration pneumonitis"},{"letter":"C","text":"Volvulus"},{"letter":"D","text":"Esophageal stricture"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Esophagitis","explanation":"a. Esophagitis"},{"n":18,"chapter":"Esophagus","src":"question on PDF p. 390 · answer on PDF p. 402","pdfPage":390,"stem":"A 55-year-old male had retrosternal discomfort unrelated to physical exertion. Pain gets worse after lying down there is partial relief with antacids. The most likely diagnosis is: (UPSC 96)","options":[{"letter":"A","text":"Ischemic heart disease"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"Hiatus hernia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hiatus hernia","explanation":"Diagnosis of Hiatus Hernia\nAnswer (book): Answer: D. Hiatus hernia"},{"n":19,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 402","pdfPage":391,"stem":"Most useful investigation in sliding hernia in female: (UPPG 2008)","options":[{"letter":"A","text":"Fluoroscopy"},{"letter":"B","text":"Barium meal"},{"letter":"C","text":"Palpation method"},{"letter":"D","text":"Ultrasound"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Barium meal","explanation":"b. Barium meal (Ref: Bailey 27/e p1084)\nExplanations"},{"n":20,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"For hiatal hernia, investigation of choice is: (DPG 2006, DPG 2005)","options":[{"letter":"A","text":"Barium meal follow through"},{"letter":"B","text":"Barium meal upper GI"},{"letter":"C","text":"Barium meal upper GI in Trendelenburg position"},{"letter":"D","text":"Barium meal double contrast"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Barium meal upper GI in Trendelenburg position","explanation":"Barium Studies in Hiatal Hernia\n• To facilitate visualization of the hernia, the patient may be placed in a Trendelenburg position during studies of\nbarium swallowingQ.\n• The hernia may be visible on a plain radiograph of the chest as a gas bubble, often with a fluid level behind the\nheartQ.\n• A barium meal is the best method of diagnosisQ.\n• The endoscopic appearances may be confusing, especially in large hernias when it is easy to become\ndisorientated.\nAnswer (book): Answer: C. Barium meal upper GI in Trendelenburg position\nReference: Bailey 27/e p1084"},{"n":21,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Rossetti modification of Nissen’s fundoplication means: (MHSSMCET 2006)","options":[{"letter":"A","text":"Excludes the stomach wall in the wrap"},{"letter":"B","text":"Include only the posterior stomach wall in the wrap"},{"letter":"C","text":"Include only the anterior stomach wall in the wrap"},{"letter":"D","text":"Include both the anterior and the posterior stomach wall in the wrap"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Include only the anterior stomach wall in the wrap","explanation":"Nissen’s fundoplication\n• Left crus approach to a 360-degree wrap (Nissen fundoplication), which is the procedure of choice for GERD.\n• Left crus approach: Direct and early view of the short gastric vessels and spleenQ.\nRosetti and Hell modification of • Include only anterior stomach wall in the wrapQ. Nissen’s fundoplication\n• The idea was to reduce dissection in the vicinity of vagus nerve.\nAnswer (book): Answer: C. Include only the anterior stomach wall in the wrap\nReference: www.ncbi.nlm.nih.gov/pubmed/8313128"},{"n":22,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Fundoplication is used in treatment of: (DNB 2012, MHPGMCET 2002)","options":[{"letter":"A","text":"Hiatus hernia"},{"letter":"B","text":"Achalasia cardia"},{"letter":"C","text":"CHPS"},{"letter":"D","text":"CA esophagus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hiatus hernia","explanation":"a. Hiatus hernia\n 23. None: (Ref: Sabiston 20/e p1051-1053; Schwartz 10/e p980-984; Bailey 27/e p1083; Shackelford 7/e p237-239)"},{"n":24,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Retrocardiac lucency with air fluid level is seen in: (Recent Question 2013)","options":[{"letter":"A","text":"Hiatus hernia"},{"letter":"B","text":"Distal end esophageal obstruction"},{"letter":"C","text":"Eventration of diaphragm"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Hiatus hernia","explanation":"a. Hiatus hernia"},{"n":25,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"What is the most probable diagnosis based on the given barium study image? (Recent Question 2016)","options":[{"letter":"A","text":"Type I hiatus hernia"},{"letter":"B","text":"Bochdalek hernia"},{"letter":"C","text":"Morgagni hernia"},{"letter":"D","text":"Type II hiatus hernia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bochdalek hernia","explanation":"Presence of gastric air bubble or loops of bowel within the chest in newborns are suggestive of\ncongenital diaphragmatic hernia (Bochdalek hernia).\nImage-based question: the picture / video this question refers to is on PDF p. 391 of the source and is not reproduced here.\nAnswer (book): Answer: B. Bochdalek hernia\nReference: Sabiston 20/e p1579; Schwartz 10/e p1604; Bailey 27/e p938"},{"n":26,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"LES pressure is decreased by all except: (GB Pant 2011)","options":[{"letter":"A","text":"Alcohol"},{"letter":"B","text":"Protein"},{"letter":"C","text":"Fat"},{"letter":"D","text":"Peppermint"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Protein","explanation":"b. Protein (Ref: Shackelford 7/e p56)"},{"n":27,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"The lower esophageal sphincter tone (pressure) is increased by: (COMEDK 2005)","options":[{"letter":"A","text":"Glucagon"},{"letter":"B","text":"Gastrin"},{"letter":"C","text":"Emptying of the stomach"},{"letter":"D","text":"Chocolate"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Gastrin","explanation":"b. Gastrin"},{"n":28,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"The gold standard for diagnosis of gastroesophageal reflux disease (GERD) is: (Recent Question 2017, MHCET 2016, JIPMER 2014, Orissa 2011, COMEDK 2008, 2007, PGI June 1998)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"Endoscopy"},{"letter":"C","text":"24-hours pH monitoring"},{"letter":"D","text":"Esophageal manometry"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"24-hours pH monitoring","explanation":"c. 24-hours pH monitoring (Ref: Sabiston 20/e p1043-1048; Schwartz 10/e p964-980; Bailey 27/e p1077; Shackelford 7/e p174-180, 215-237)"},{"n":29,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"A 35-year-old lady presented with dysphagia, nocturnal asthma and weight loss for 6 years. The most probable diagnosis is: (COMEDK 2010)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Lye stricture of esophagus"},{"letter":"C","text":"Gastroesophageal reflux disease"},{"letter":"D","text":"Cancer esophagus"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Gastroesophageal reflux disease","explanation":"c. Gastroesophageal reflux disease"},{"n":30,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Which of the following is the earliest indicator of pathological gastroesophageal reflux in infants (GERD)? (All India 2011)","options":[{"letter":"A","text":"Respiratory symptoms"},{"letter":"B","text":"Postprandial regurgitation"},{"letter":"C","text":"Upper GI bleed"},{"letter":"D","text":"Stricture esophagus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Respiratory symptoms","explanation":"Recurrent respiratory symptoms (Wheezing, stridor, chronic cough, apnea, aspiration) are the earliest\nindicators of pathological reflux among the options provided.\nGERD in Infants\nMost frequent complications of GERD in infants are failure to thrive and recurrent pulmonary symptomsQ.\nRegurgitation alone does not indicate pathological reflux. Presence of upper GI bleed is an uncommon marker for\npathological reflux or esophagitis. Presence of stricture esophagus is an uncommon and late complication of\nuntreated pathological GERD. Recurrent pulmonary symptoms are frequent and early indicators of pathological\nGERDQ.\nAnswer (book): Answer: A. Respiratory symptoms\nReference: Nelson 20/e p1791"},{"n":31,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Best test to diagnose gastroesophageal reflux disease and quantify acid output is: (AIIMS May 2011, Nov 2008)","options":[{"letter":"A","text":"Esophagogram"},{"letter":"B","text":"Endoscopy"},{"letter":"C","text":"Manometry"},{"letter":"D","text":"24-hours pH monitoring"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"24-hours pH monitoring","explanation":"d. 24-hours pH monitoring"},{"n":32,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Most important pathophysiological cause of GERD is: (AIIMS May 2012)","options":[{"letter":"A","text":"Hiatus hernia"},{"letter":"B","text":"Transient LES relaxation"},{"letter":"C","text":"LES hypotension"},{"letter":"D","text":"Inadequate esophageal clearance"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Transient Les relaxation","explanation":"• Harrison says “Transient LES relaxations account for at least 90% of reflux in normal subjects or GERD patients\nwithout hiatus herniaQ.”\nAnswer (book): Answer: B. Transient Les relaxation\nReference: Harrison 19/e p1906"},{"n":33,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"In GERD, what demonstrates the best anatomical picture? (MHSSMCET 2007)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"24-hours pH-monitoring"},{"letter":"C","text":"Endoscopy"},{"letter":"D","text":"Manometry"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barium swallow","explanation":"• IOC for anatomical disorders of esophagus: Barium swallowQ\n• IOC for motility disorders of esophagus: ManometryQ\nAnswer (book): Answer: A. Barium swallow"},{"n":34,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 403","pdfPage":391,"stem":"Most common complication after Nissen’s fundoplication: (AIIMS GIS Dec 2011, Dec 2006)","options":[{"letter":"A","text":"Esophageal injuries"},{"letter":"B","text":"Stomach injuries"},{"letter":"C","text":"Liver injuries"},{"letter":"D","text":"Pneumothorax"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Pneumothorax","explanation":"• Pneumothorax (1-5%) is usually self-limited but may cause immediate or delayed hemodynamic or respiratory\nconsequences. It is one of the most common complication of Nissen’s fundoplication.\nREFLUX ESOPHAGITIS\nComplications of Nissen’s Fundoplications\nIntraoperative Pneumothorax (MC)Q Esophageal perforation Splenic injury Bleeding Missed visceral injury\nPostoperative Slipped or misplaced fundoplication Dehiscence Transthoracic herniation Tight fundoplication\nAnswer (book): Answer: D. Pneumothorax\nReference: Shackelford 7/e p234"},{"n":35,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 404","pdfPage":391,"stem":"All are true about antireflux surgeries except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Nissen’s is 360 degree complete wrap"},{"letter":"B","text":"Watson is 90 degree posterior"},{"letter":"C","text":"Toupet is 270 degree posterior"},{"letter":"D","text":"Dor is a partial fundoplication"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Watson is 90 degree posterior","explanation":"b. Watson is 90 degree posterior"},{"n":36,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 404","pdfPage":391,"stem":"Reflux esophagitis is prevented by: (PGI Dec 2001)","options":[{"letter":"A","text":"Long intra-abdominal esophagus"},{"letter":"B","text":"Increased intra-abdominal pressure"},{"letter":"C","text":"Right crus of diaphragm"},{"letter":"D","text":"Increased intra-thoracic pressure"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Long intra-abdominal esophagus, B. Increased intra-abdominal pressure, C. Right crus of","explanation":"a. Long intra-abdominal esophagus, b. Increased intra-abdominal pressure, c. Right crus of diaphragm"},{"n":38,"chapter":"Esophagus","src":"question on PDF p. 391 · answer on PDF p. 404","pdfPage":391,"stem":"Which one of the following drugs exacerbate reflux esophagitis? (COMEDK 2004)","options":[{"letter":"A","text":"Chlorpropamide"},{"letter":"B","text":"Metoclopramide"},{"letter":"C","text":"Theophylline"},{"letter":"D","text":"Cisapride"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Theophylline","explanation":"c. Theophylline"},{"n":39,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"The aim of preventing reflux esophagitis by repairing hiatus hernia is achieved by: (AIIMS 79, Rohtak 87)","options":[{"letter":"A","text":"Bringing the stomach inferior to diaphragm"},{"letter":"B","text":"Reconstitution of the angle of hill"},{"letter":"C","text":"Repair of defect in diaphragm"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above"},{"n":41,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Complications of reflux esophagitis: (MAHE 2005)","options":[{"letter":"A","text":"Stricture"},{"letter":"B","text":"Schatzki’s ring"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"All of the above","explanation":"d. All of the above"},{"n":42,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Most common cause of esophagitis is: (AIIMS May 2009)","options":[{"letter":"A","text":"Alcohol"},{"letter":"B","text":"Smoking"},{"letter":"C","text":"Spicy and hot food"},{"letter":"D","text":"Esophageal reflux"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Esophageal reflux","explanation":"d. Esophageal reflux"},{"n":43,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"What is the name of this fundoplication?","options":[{"letter":"A","text":"Nissen’s fundoplication"},{"letter":"B","text":"Watson fundoplication"},{"letter":"C","text":"Dor fundoplication"},{"letter":"D","text":"Toupet fundoplication"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nissen’s fundoplication","explanation":"Types of Fundoplication Type of Fundoplication Watson Dor Toupet Belsey Mark IV Nissen’s\nDegree of Wrap 90o anterior fundoplicationQ 180o anterior fundoplicationQ 180o posterior fundoplication\nsubsequently modified to a 270o wrapQ 270o anterior fundoplicationQ 360o fundoplicationQ\nAnswer (book): Answer: A. Nissen’s fundoplication\nReference: Sabiston 20/e p1024; Schwartz 10/e p974-976; Bailey 27/e p1079-1080; Shackelford 7/e p237-239"},{"n":44,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"All are true about achalasia except: (GB Pant 2011, JIPMER GIS 2011)","options":[{"letter":"A","text":"It predisposes to malignancy"},{"letter":"B","text":"Body peristalsis is normal"},{"letter":"C","text":"LES pressure is increased"},{"letter":"D","text":"Dilatation of proximal segment"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Body peristalsis is normal (Ref: Sabiston 20/e p1016-1019; Schwartz 10/e p990-992; Bailey 26/e","explanation":"b. Body peristalsis is normal (Ref: Sabiston 20/e p1016-1019; Schwartz 10/e p990-992; Bailey 26/e p1014-1017; Shackelford 7/e p349-352,\n354-361)"},{"n":45,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"All of the following are true about achalasia cardia except: (Recent Question 2017)","options":[{"letter":"A","text":"Achalasia means absence of relaxation"},{"letter":"B","text":"Heller’s myotomy is the treatment choice"},{"letter":"C","text":"It is premalignant condition"},{"letter":"D","text":"Caused by selective loss of stimulatory myenteric neurons"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Caused by selective loss of stimulatory myenteric neurons","explanation":"d. Caused by selective loss of stimulatory myenteric neurons (Ref: Sabiston 20/e p1017; Schwartz 10/e p990; Bailey 27/e p1095-1097)"},{"n":46,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"All are manometric features of achalasia except: (JIPMER GIS 2011)","options":[{"letter":"A","text":"High LES pressure"},{"letter":"B","text":"Decreased LES relaxation"},{"letter":"C","text":"Segmental body peristalsis"},{"letter":"D","text":"Manometry helps in diagnosis"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Segmental body peristalsis","explanation":"c. Segmental body peristalsis"},{"n":47,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"A female patient has dysphagia, intermittent epigastric pain. On endoscopy, esophagus was dilated above and narrow at the bottom. Treatment is: (AIIMS May 2012)","options":[{"letter":"A","text":"PPI"},{"letter":"B","text":"Esophagectomy"},{"letter":"C","text":"Dilatation"},{"letter":"D","text":"Heller’s cardiomyotomy"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Heller’s cardiomyotomy","explanation":"d. Heller’s cardiomyotomy"},{"n":48,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Amyl nitrite inhalation test is used to detect: (COMEDK 2005)","options":[{"letter":"A","text":"CA esophagus"},{"letter":"B","text":"Achalasia cardia"},{"letter":"C","text":"Esophageal diverticulum"},{"letter":"D","text":"Tracheoesophageal fistula"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Achalasia cardia","explanation":"b. Achalasia cardia"},{"n":49,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Increasing difficulty in swallowing both for solids and liquids in a woman with bird’s beak appearance in X-ray seen in: (PGI June 2008)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Carcinoma"},{"letter":"C","text":"Reflux esophagitis"},{"letter":"D","text":"Barrett’s esophagus"},{"letter":"E","text":"Esophagitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Achalasia cardia","explanation":"a. Achalasia cardia"},{"n":50,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"A 30-year-old women comes with dysphagia for both solid and liquids and barium swallow shows parrot beak appearance. On esophageal manometry, LES pressure is increased. Management includes: (PGI June 2008)","options":[{"letter":"A","text":"Nitrates"},{"letter":"B","text":"Ca 2+ channel blockers"},{"letter":"C","text":"Botulinum toxin"},{"letter":"D","text":"Myotomy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Nitrates, B. Ca2+ channel blockers, C. Botulinum toxin, D. Myotomy","explanation":"a. Nitrates, b. Ca2+ channel blockers, c. Botulinum toxin, d. Myotomy"},{"n":51,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Hellers operation is done for: (Recent Question 2018, Recent Question 2016, 2014, DNB 2013, 2012)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Hiatus hernia"},{"letter":"C","text":"Diaphragmatic"},{"letter":"D","text":"Reflux esophagitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Achalasia cardia","explanation":"a. Achalasia cardia"},{"n":52,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"The defect in achalasia cardia is present in: (MAHE 2008)","options":[{"letter":"A","text":"Myenteric plexus of Auerbach"},{"letter":"B","text":"Meissner’s plexus"},{"letter":"C","text":"Kesselbach’s plexus"},{"letter":"D","text":"Mesenteric plexus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Myenteric plexus of Auerbach","explanation":"a. Myenteric plexus of Auerbach"},{"n":53,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"What is the diagnosis of barium esophagogram? (APPG 2015)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Hiatus hernia"},{"letter":"C","text":"Diffuse esophageal spasm"},{"letter":"D","text":"Reflux esophagitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Achalasia cardia","explanation":"• Massive esophageal dilation, tortuosity, and a sigmoidal esophagus (megaesophagus) is seen in advanced stageQ\nof achalasia cardia\nAnswer (book): Answer: A. Achalasia cardia\nReference: Sabiston 20/e p1016-1019; Schwartz 10/e p1002; Bailey 27/e p1097"},{"n":54,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"In achalasia cardia true is: (PGI June 2000)","options":[{"letter":"A","text":"Pressure at distal end increased with no peristalsis"},{"letter":"B","text":"Low pressure at LES with no peristalsis"},{"letter":"C","text":"Pressure >50mm Hg with peristalsis"},{"letter":"D","text":"Pressure at the distal end increased with normal relaxation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Pressure at distal end increased with no peristalsis","explanation":"a. Pressure at distal end increased with no peristalsis"},{"n":55,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"A young patient presents with history of dysphagia more to liquid than solids. The first investigation you will do is: (AIIMS June 2003)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"Esophagoscopy"},{"letter":"C","text":"Ultrasound of the chest"},{"letter":"D","text":"CT scan of the chest"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barium swallow","explanation":"a. Barium swallow"},{"n":56,"chapter":"Esophagus","src":"question on PDF p. 392 · answer on PDF p. 404","pdfPage":392,"stem":"Treatment for achalasia associated with high rate of recurrence: (All India 2002)","options":[{"letter":"A","text":"Pneumatic dilatation"},{"letter":"B","text":"Laparoscopic myotomy"},{"letter":"C","text":"Open surgical myotomy"},{"letter":"D","text":"Botulinum toxin"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Botulinum toxin","explanation":"d. Botulinum toxin"},{"n":57,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 404","pdfPage":393,"stem":"About achalasia cardia all are correct except: (APPG 84, Kerala 86, JIPMER 98)","options":[{"letter":"A","text":"Mostly in women"},{"letter":"B","text":"Dilated esophagus narrowing to a point"},{"letter":"C","text":"Heller’s operation treatment of choice"},{"letter":"D","text":"Not a premalignant condition"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Not a premalignant condition","explanation":"d. Not a premalignant condition"},{"n":58,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 404","pdfPage":393,"stem":"All are true of achalasia cardia except: (JIPMER 90)","options":[{"letter":"A","text":"Dysphagia"},{"letter":"B","text":"Aspiration pneumonitis"},{"letter":"C","text":"Mecholyl test is hyposensitive"},{"letter":"D","text":"X-ray finding of dilated esophagus with a narrow end"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mecholyl test is hyposensitive","explanation":"Mecholyl Test\n• Mecholyl test has been used as a means to demonstrate the “denervation supersensitivity” in patients with\nachalasiaQ.\n• It has not been reported in patients with the hypertensive LES.\nAnswer (book): Answer: C. Mecholyl test is hyposensitive\nReference: www.hon.ch/OESO/free/Vol_4_Prim_Motility/.../ART295.HTML"},{"n":59,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 404","pdfPage":393,"stem":"Following are radiological evidence of Achalasia cardia except: (Karnataka 98)","options":[{"letter":"A","text":"Smooth narrowing of esophagus"},{"letter":"B","text":"Dilated tortuous esophagus"},{"letter":"C","text":"Absence of air in the fundus"},{"letter":"D","text":"Exaggerated peristalsis"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Exaggerated peristalsis","explanation":"d. Exaggerated peristalsis"},{"n":60,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 404","pdfPage":393,"stem":"Bird’s beak appearance is seen in: (Recent Question 2017, Recent Question 2015, J and K 2001)","options":[{"letter":"A","text":"Volvulus"},{"letter":"B","text":"Intussusception"},{"letter":"C","text":"Achalasia"},{"letter":"D","text":"Ulcerative colitis"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Volvulus, C. Achalasia","explanation":"a. Volvulus, c. Achalasia"},{"n":61,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"This characteristic appearance is seen on barium swallow in: (Recent Question 2016)","options":[{"letter":"A","text":"Carcinoma esophagus"},{"letter":"B","text":"Achalasia cardia"},{"letter":"C","text":"Nutcrackers esophagus"},{"letter":"D","text":"Diffuse esophageal spasm"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Achalasia cardia","explanation":"• Dilated esophagus with a distal narrowingQ\n• “Bird’s beak”, “Pencil-tip” or “Rat’s tail” appearanceQ\nAnswer (book): Answer: B. Achalasia cardia\nReference: Sabiston 20/e p1016-1019; Schwartz 10/e p1017; Bailey 27/e p1097"},{"n":62,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"Achalasia cardia is characterized by all except: (UPPG 2009)","options":[{"letter":"A","text":"Most common in women"},{"letter":"B","text":"Dysphagia is most common symptom"},{"letter":"C","text":"Premalignant condition"},{"letter":"D","text":"Parrot beak’s appearance"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Most common in women","explanation":"a. Most common in women"},{"n":63,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"True about achalasia cardia is all except: (MHSSMCET 2009)","options":[{"letter":"A","text":"On repeated Botox injection, recurrence rate increase"},{"letter":"B","text":"More common in young women"},{"letter":"C","text":"Surgery is treatment of choice"},{"letter":"D","text":"Not a premalignant condition"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Not a premalignant condition","explanation":"d. Not a premalignant condition"},{"n":64,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"Corkscrew esophagus is seen in which of the following conditions? (Recent Question 2017, Recent Question 2015, Bihar PG 2014, NEET 2013, DNB 2008, 2005, 2001)","options":[{"letter":"A","text":"Carcinoma esophagus"},{"letter":"B","text":"Scleroderma"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"Diffuse esophageal spasm"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Diffuse esophagus spasm","explanation":"Achalasia Cardia Diagnosis\n• Barium swallow\nAnswer (book): Answer: D. Diffuse esophagus spasm\nReference: Sabiston 20/e p1015-1016; Schwartz 10/e p992; Bailey 27/e p1099; Shackelford 7/e p142-143"},{"n":65,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"This characteristic appearance is seen on barium swallow in: (Recent Question 2016)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Nutcrackers esophagus"},{"letter":"C","text":"Diffuse esophageal spasm"},{"letter":"D","text":"Hypertensive LES"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Diffuse esophageal spasm","explanation":"• Corkscrew or rosary-bead esophagus, segmental spasm or pseudodiverticulosis appearanceQ is characteristic of\ndiffuse esophageal spasm.\nAnswer (book): Answer: C. Diffuse esophageal spasm\nReference: Sabiston 20/e p1015-1016; Schwartz 10/e p992; Bailey 27/e p1099; Shackelford 7/e p142-143"},{"n":66,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"Motility in the upper third of the esophagus is decreased in all except:","options":[{"letter":"A","text":"Pseudo-bulbar palsy"},{"letter":"B","text":"Chagas disease"},{"letter":"C","text":"Myasthenia gravis"},{"letter":"D","text":"Scleroderma"},{"letter":"E","text":"Cricopharyngeal carcinoma"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Scleroderma, E. Cricopharyngeal carcinoma","explanation":"Classification of Esophageal Motility Disorders\n• Neurological: Stroke, motor neuron disease, multiple sclerosis, Parkinson’s disease\n• Myogenic: Myasthenia, muscular dystrophy\n• Pharyngo-esophageal (Zenker’s) diverticulum\nDisorders of the body of the esophagus\n• Diffuse esophageal spasm\n• Nutcracker esophagus\nAutoimmune disordersSystemic sclerosis (CREST)\nAllergic Disorders of the lower esophageal sphincter\nReflux associated Idiopathic Eosinophilic esophagitis Non-specific esophageal dysmotility Achalasia Incompetent\nlower sphincter (i.e. GERD)\nAnswer (book): Answer: D. Scleroderma, E. Cricopharyngeal carcinoma\nReference: Bailey 27/e p1096; Sabiston 20/e p1015"},{"n":67,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"Most common motility disorder leading to dysphagia: (JIPMER 2010)","options":[{"letter":"A","text":"Nut cracker esophagus"},{"letter":"B","text":"Esophageal web"},{"letter":"C","text":"Diffuse esophageal spasm"},{"letter":"D","text":"Achalasia cardia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Achalasia cardia","explanation":"d. Achalasia cardia\nZENKER’S DIVERTICULUM"},{"n":68,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"Best investigation for Zenker’s diverticulum is: (Recent Question 2014, AIIMS Nov 2011, AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"Endoscopy"},{"letter":"C","text":"CECT"},{"letter":"D","text":"EUS"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barium swallow","explanation":"a. Barium swallow (Ref: Sabiston 20/e p1019-1020; Schwartz 10/e p989; Bailey 27/e p1101; Shackelford 7/e p336-346)"},{"n":69,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"An elderly male present with history of dysphagia, regurgitation, foul breath and cough. Bilateral lung creps are noted on examination. The most likely diagnosis is: (All India 2012, AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Schatzki’s ring"},{"letter":"B","text":"Zenker’s diverticulum"},{"letter":"C","text":"Corkscrew esophagus"},{"letter":"D","text":"Plummer-Vinson syndrome"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Zenker’s diverticulum","explanation":"b. Zenker’s diverticulum"},{"n":70,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"True statement about Zenker’s diverticulum: (NEET Pattern, GB Pant 2011)","options":[{"letter":"A","text":"Congenital"},{"letter":"B","text":"Feeling of obstruction in esophagus"},{"letter":"C","text":"Traction diverticulum"},{"letter":"D","text":"Not present with recurrent aspiration pneumonitis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Feeling of obstruction in esophagus","explanation":"b. Feeling of obstruction in esophagus"},{"n":71,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"All of the following statements about Zenker’s diverticulum are true except: (All India 2009)","options":[{"letter":"A","text":"Acquired diverticulum"},{"letter":"B","text":"Lateral X-rays on barium swallow are often diagnostic"},{"letter":"C","text":"False diverticulum"},{"letter":"D","text":"Out pouching of the anterior pharyngeal wall just above the cricopharyngeus muscle"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Out pouching of the anterior pharyngeal wall just above the cricopharyngeus muscle","explanation":"d. Out pouching of the anterior pharyngeal wall just above the cricopharyngeus muscle"},{"n":72,"chapter":"Esophagus","src":"question on PDF p. 393 · answer on PDF p. 405","pdfPage":393,"stem":"A 50-year-old male Raju, presents with occasional dysphagia for solids, regurgitation of food and foul smelling breath. Probable diagnosis is: (Recent Question 2016, AIIMS June 99)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Zenker’s diverticulum"},{"letter":"C","text":"CA esophagus"},{"letter":"D","text":"Diabetic gastroparesis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Zenker’s diverticulum","explanation":"b. Zenker’s diverticulum"},{"n":73,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"A 60-year-old diabetic male patient presented to the OPD with halitosis and dysphagia. Barium swallow was done. What is the diagnosis based on the given findings?","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Zenker’s diverticulum"},{"letter":"D","text":"Leiomyoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Zenker’s diverticulum","explanation":"c. Zenker’s diverticulum"},{"n":74,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Which of the following is true about Zenker’s diverticulum? (PGI Dec 2007)","options":[{"letter":"A","text":"It is asymptomatic"},{"letter":"B","text":"Occurs in the mid-esophagus"},{"letter":"C","text":"Treatment is simple excision"},{"letter":"D","text":"It occurs in children"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Treatment is simple excision","explanation":"c. Treatment is simple excision"},{"n":75,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Commonest complication of Zenker’s diverticulum is: (AIIMS Nov 96)","options":[{"letter":"A","text":"Dysphonia"},{"letter":"B","text":"Gastroesophageal reflux"},{"letter":"C","text":"Lung abscess"},{"letter":"D","text":"Perforation"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lung abscess","explanation":"c. Lung abscess"},{"n":76,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"The pharyngeal diverticulum is a protrusion of mucosa between: (UPSC 2000)","options":[{"letter":"A","text":"The two parts of inferior constrictor muscle of the pharynx"},{"letter":"B","text":"The two parts of middle constrictor muscle of the pharynx"},{"letter":"C","text":"The two parts of the superior constrictor muscle of the pharynx"},{"letter":"D","text":"Cricopharyngeal and posterior part of suprahyoid membrane"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"The two parts of inferior constrictor muscle of the pharynx","explanation":"a. The two parts of inferior constrictor muscle of the pharynx"},{"n":77,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Dohlman’s procedure is used in: (Recent Question 2013)","options":[{"letter":"A","text":"Rectal prolapsed"},{"letter":"B","text":"Esophageal achalasia"},{"letter":"C","text":"CA esophagus"},{"letter":"D","text":"Zenker’s diverticulum"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Zenker’s diverticulum","explanation":"d. Zenker’s diverticulum"},{"n":78,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Dohlman surgery in Zenker’s diverticulum is: (Recent Question 2019)","options":[{"letter":"A","text":"Endoscopic stapling of septum"},{"letter":"B","text":"Endoscopic suturing of pouch"},{"letter":"C","text":"Resection of pouch"},{"letter":"D","text":"Laser excision"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Endoscopic stapling of septum","explanation":"• “An alternative to open surgical repair is the endoscopic Dohlman procedure, which has become more popular.\nEndoscopic division of the common wall between the esophagus and diverticulum using a laser, electrocautery,\nor stapler device has been similarly successful. Because of the configuration of the inline stapling device, this\napproach has been advocated for larger diverticula.”\n—Sabiston 20/e p1020\nAnswer (book): Answer: A. Endoscopic stapling of septum\nReference: Sabiston 20/e p1020"},{"n":79,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Which of the following is a true diverticulum of esophagus? (AIIMS November 2016)","options":[{"letter":"A","text":"Zenker’s diverticulum"},{"letter":"B","text":"Meckel’s diverticulum"},{"letter":"C","text":"Epiphrenic diverticulum"},{"letter":"D","text":"Parabronchial diverticulum"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Parabronchial diverticulum","explanation":"d. Parabronchial diverticulum\nSCLERODERMA"},{"n":80,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 405","pdfPage":394,"stem":"Not a component of POEMS syndrome: (JIPMER 2010)","options":[{"letter":"A","text":"Polyneuropathy"},{"letter":"B","text":"Esophageal atresia"},{"letter":"C","text":"Endocrinopathy"},{"letter":"D","text":"Multiple myeloma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Esophageal atresia","explanation":"Crow–Fukase Syndrome\n• The features of this syndrome are highlighted by an acronym: POEMSQ\n• POEMSQ: Polyneuropathy, Organomegaly, Endocrinopathy, M-protein, Skin changes.\nDisorders of the pharyngo-esophageal junction\nAnswer (book): Answer: B. Esophageal atresia\nReference: Harrison 19/e p718"},{"n":81,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"Acronym ‘POEMS’ stand for: (PGI May 2011)","options":[{"letter":"A","text":"Esophageal dysmotility"},{"letter":"B","text":"Polyneuropathy"},{"letter":"C","text":"Endocrinopathy"},{"letter":"D","text":"M-protein"},{"letter":"E","text":"Scleroderma"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Polyneuropathy, C. Endocrinopathy, D. M-protein","explanation":"b. Polyneuropathy, c. Endocrinopathy, d. M-protein"},{"n":82,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"Which part of esophagus is mainly affected in scleroderma? (MHPGMCET 2003)","options":[{"letter":"A","text":"Upper third"},{"letter":"B","text":"Middle third"},{"letter":"C","text":"Lower third"},{"letter":"D","text":"All the above"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Lower third","explanation":"c. Lower third (Ref: Harrison 19/e p2158; Schwartz 10/e p984-985)"},{"n":83,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"Connective tissue disorder which is associated with gastroesophageal reflux is: (PGI Dec 99)","options":[{"letter":"A","text":"SLE"},{"letter":"B","text":"Scleroderma"},{"letter":"C","text":"Behcet’s syndrome"},{"letter":"D","text":"Dermatomyositis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Scleroderma","explanation":"b. Scleroderma\nPLUMMER–VINSON SYNDROME"},{"n":84,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"Not true about Plummer-Vinson syndrome is: (AIIMS 97)","options":[{"letter":"A","text":"Occurs in elderly males"},{"letter":"B","text":"Postcricoid webs"},{"letter":"C","text":"Predispose to hypopharynx malignancy"},{"letter":"D","text":"Koilonychia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Occurs in elderly males","explanation":"a. Occurs in elderly males"},{"n":85,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"In Plummer–Vinson syndrome, obstruction is due to: (DPG 2006)","options":[{"letter":"A","text":"Esophageal dysmotility"},{"letter":"B","text":"Esophageal stenosis"},{"letter":"C","text":"Postcricoid webs"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Postcricoid webs","explanation":"c. Postcricoid webs"},{"n":86,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"All are features of Plummer-Vinson syndrome except: (COMEDK 2008)","options":[{"letter":"A","text":"Esophageal web"},{"letter":"B","text":"Iron deficiency"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"Dysphagia"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Achalasia cardia","explanation":"c. Achalasia cardia"},{"n":87,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"Not a feature of Plummer-Vinson syndrome: (Punjab 2008)","options":[{"letter":"A","text":"Web present in lower part of esophagus"},{"letter":"B","text":"Koilonychia"},{"letter":"C","text":"Premalignant"},{"letter":"D","text":"Common in edentulous females"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Web present in lower part of esophagus","explanation":"a. Web present in lower part of esophagus\nBARRETT’S ESOPHAGUS"},{"n":88,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"True about Barrett’s esophagus: (PGI Dec 2007)","options":[{"letter":"A","text":"Long esophageal segment involved"},{"letter":"B","text":"Metaplasia"},{"letter":"C","text":"Peptic ulcer"},{"letter":"D","text":"Para esophageal hernia"},{"letter":"E","text":"Leads to adenocarcinoma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Long esophageal segment involved, B. Metaplasia, C. Peptic ulcer, E. Leads to adenocarcinoma","explanation":"a. Long esophageal segment involved, b. Metaplasia, c. Peptic ulcer, e. Leads to adenocarcinoma (Ref: Sabiston 20/e p1050; Schwartz\n10/e p967,969,979; Bailey 27/e p1081; Shackelford 7/e p285, 294)"},{"n":89,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"All of the following are correct about Barrett’s esophagus except: (Recent Question 2019)","options":[{"letter":"A","text":"Predisposes to adenocarcinoma"},{"letter":"B","text":"Columnar to squamous metaplasia"},{"letter":"C","text":"Associated with GERD"},{"letter":"D","text":"Acquired condition"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Columnar to squamous metaplasia","explanation":"b. Columnar to squamous metaplasia (Ref: Schwartz 10/e p967; Sabiston 20/e p1050; Bailey 27/e p1081)"},{"n":90,"chapter":"Esophagus","src":"question on PDF p. 394 · answer on PDF p. 406","pdfPage":394,"stem":"A 55 years old patient presented with dysphagia. Identify the diagnosis from upper GI biopsy of esophagus showed in the following picture: (AIIMS May 2017)","options":[{"letter":"A","text":"Squamous cell carcinoma"},{"letter":"B","text":"Eosinophilic esophagitis"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"Adenocarcinoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Barrett’s esophagus","explanation":"• The histopathological image of esophagus is showing intestinal type epithelium with goblet cells, typical of\nBarrett’s esophagus.\nImage-based question: the picture / video this question refers to is on PDF p. 394 of the source and is not reproduced here.\nAnswer (book): Answer: C. Barrett’s esophagus\nReference: Robbins 9/e p757, 758"},{"n":91,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"A chronic alcoholic presents with regurgitation and ret-rosternmal pain. Endoscopic biopsy confirms Barretti’s esophagus. What is the most appropriate management in this case? (JIPMER 2013)","options":[{"letter":"A","text":"Endoscopic biopsy every 2 years"},{"letter":"B","text":"PPI"},{"letter":"C","text":"H. pylori treatment"},{"letter":"D","text":"Balloon dilatation"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Endoscopic biopsy every 2 years","explanation":"a. Endoscopic biopsy every 2 years"},{"n":92,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Barrett’s esophagus is: (All India 2002, AIIMS June 93)","options":[{"letter":"A","text":"Lower esophagus lined by columnar epithelium"},{"letter":"B","text":"Upper esophagus lined by columnar epithelium"},{"letter":"C","text":"Lower esophagus lined by ciliated epithelium"},{"letter":"D","text":"Lower esophagus lined by pseudostratified epithelium"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Lower esophagus lined by columnar epithelium","explanation":"a. Lower esophagus lined by columnar epithelium"},{"n":93,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Barrett’s esophagus is diagnosed by: (AIIMS May 2012, Nov 2007, DNB 2008)","options":[{"letter":"A","text":"Squamous metaplasia"},{"letter":"B","text":"Intestinal metaplasia"},{"letter":"C","text":"Squamous dysplasia"},{"letter":"D","text":"Intestinal dysplasia"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Intestinal metaplasia","explanation":"b. Intestinal metaplasia"},{"n":94,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Barrett’s esophagus can lead to: (AIIMS June 98)","options":[{"letter":"A","text":"Stricture"},{"letter":"B","text":"Reflux esophagitis"},{"letter":"C","text":"Peptic ulcer"},{"letter":"D","text":"Achalasia"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stricture, C. Peptic ulcer","explanation":"a. Stricture, c. Peptic ulcer"},{"n":95,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"True regarding Barrett’s esophagus is: (AIIMS Nov 95)","options":[{"letter":"A","text":"Benign course"},{"letter":"B","text":"Premalignant condition"},{"letter":"C","text":"Squamous metaplasia of lower esophagus"},{"letter":"D","text":"Medical treatment is not useful"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Premalignant condition","explanation":"b. Premalignant condition"},{"n":96,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"What is the most probable diagnosis on the basis of given endoscopy image? (Recent Question 2016)","options":[{"letter":"A","text":"GAVE"},{"letter":"B","text":"Schatzki ring"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"Esophageal varices"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Barrett’s esophagus","explanation":"c. Barrett’s esophagus (Ref: Sabiston 20/e p1050; Schwartz 10/e p967; Bailey 27/e p1081; Shackelford 7/e p285, 294)"},{"n":97,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"All are the predisposing factors for carcinoma esophagus except: (COMEDK 2011)","options":[{"letter":"A","text":"Achalasia"},{"letter":"B","text":"Paterson Brown Kelly Syndrome"},{"letter":"C","text":"Zenker’s diverticulum"},{"letter":"D","text":"Ectodermal dysplasia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Ectodermal dysplasia","explanation":"d. Ectodermal dysplasia (Ref: Sabiston 20/e p1027-1028; Schwartz 10/e p1003-1014; Bailey 27/e p1085; Shackelford 7/e p375-380)"},{"n":98,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"All are risk factors for epidermoid carcinoma except: (ILBS 2011)","options":[{"letter":"A","text":"Achalasia"},{"letter":"B","text":"Barrett’s esophagus"},{"letter":"C","text":"Nitrosamines"},{"letter":"D","text":"Corrosives"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Barrett’s esophagus","explanation":"b. Barrett’s esophagus"},{"n":99,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Premalignant lesion of carcinoma esophagus includes: (PGI Nov 2011, June 2007)","options":[{"letter":"A","text":"Tylosis"},{"letter":"B","text":"Plummer-Vinson syndrome"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"Achalasia cardia"},{"letter":"E","text":"Scleroderma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tylosis, B. Plummer-Vinson syndrome, C. Barrett’s esophagus, D. Achalasia cardia, E. Scleroderma","explanation":"a. Tylosis, b. Plummer-Vinson syndrome, c. Barrett’s esophagus, d. Achalasia cardia, e. Scleroderma"},{"n":100,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Squamous cell carcinoma of esophagus is caused by: (MHPGMCET 2009)","options":[{"letter":"A","text":"Tobacco/Alcohol"},{"letter":"B","text":"Alkalies"},{"letter":"C","text":"GERD"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Tobacco/Alcohol , B. Alkalies","explanation":"a. Tobacco/Alcohol , b. Alkalies"},{"n":101,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Which is not a predisposing factor for carcinoma esophagus? (Orissa 2011)","options":[{"letter":"A","text":"Esophageal diverticula"},{"letter":"B","text":"Plummer-Vinson syndrome"},{"letter":"C","text":"Mediastinal fibrosis"},{"letter":"D","text":"Caustic ingestion"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mediastinal fibrosis","explanation":"c. Mediastinal fibrosis"},{"n":102,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"The adenocarcinoma of esophagus develops in: (Recent Question 2017, Bihar PG 2014, COMEDK 2014, All India 2002, 98)","options":[{"letter":"A","text":"Barrett’s esophagus"},{"letter":"B","text":"Long standing achalasia"},{"letter":"C","text":"Corrosive stricture"},{"letter":"D","text":"Alcohol abuse"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barrett’s esophagus","explanation":"a. Barrett’s esophagus"},{"n":104,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Not a predisposing factor for carcinoma esophagus: (AIIMS May 2009)","options":[{"letter":"A","text":"Diverticula"},{"letter":"B","text":"Human papilloma virus"},{"letter":"C","text":"Mediastinal fibrosis"},{"letter":"D","text":"Caustic ingestion"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Mediastinal fibrosis","explanation":"c. Mediastinal fibrosis"},{"n":105,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Risk factor for adenocarcinoma of esophagus: (KGMC 2011)","options":[{"letter":"A","text":"Barrett’s esophagus"},{"letter":"B","text":"Corrosive injury"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"All of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barrett’s esophagus","explanation":"a. Barrett’s esophagus"},{"n":106,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Which of the following is best indicator of survival in CA esophagus? (AIIMS GIS May 2008)","options":[{"letter":"A","text":"TNM stage"},{"letter":"B","text":"Resection margin"},{"letter":"C","text":"Histology and location"},{"letter":"D","text":"Size of tumor"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"TNM stage","explanation":"Long-term survival following esophagectomy depends on a number of factors such as the depth of\ntumor invasion (T), the number of involved lymph nodes (N), and on the location of the tumor in the esophagus.\nAnswer (book): Answer: A. TNM stage\nReference: Sabiston 20/e p1027-1032; Schwartz 10/e p1003-1014; Bailey 27/e p1088; Shackelford 7/e p416-434"},{"n":107,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Best prognosis in CA esophagus: (AIIMS GIS Dec 2010)","options":[{"letter":"A","text":"Polypoidal"},{"letter":"B","text":"Fungating"},{"letter":"C","text":"Ulcerative"},{"letter":"D","text":"Infiltrative"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Polypoidal","explanation":"Carcinoma Esophagus\n• The 5-year survival rate varies but can be as good as 70% with polypoid lesions and as poor as 15% with\nadvanced tumors.\nAnswer (book): Answer: A. Polypoidal\nReference: Sabiston 20/e p1038"},{"n":108,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Sievert classification is for: (KGMC 2011)","options":[{"letter":"A","text":"Esophageal cancer"},{"letter":"B","text":"Stomach cancer"},{"letter":"C","text":"GE junction tumors"},{"letter":"D","text":"CA pancreas"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"GE junction tumors","explanation":"SiewertQ Classification GE Junction Tumors Type I\nCancer associated with Barrett’s esophagus or true esophageal carcinoma growing down to the GE junctionQ\nType II\nTumor at the true junctionQ (within 2 cm of the squamocolumnar junction)\nType III\nTumors of the subcardial regionQ\nAnswer (book): Answer: C. GE junction tumors\nReference: Shackelford 7/e p397"},{"n":109,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Characteristic features of LN involvement on EUS in CA esophagus are all except: (AIIMS GIS Dec 2011, May 2008)","options":[{"letter":"A","text":"Round contour"},{"letter":"B","text":"Sharp border"},{"letter":"C","text":"Hyperechogenic"},{"letter":"D","text":"Size >1 cm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Hyperechogenic","explanation":"Features of Malignant Lymph Nodes on EUS\n• Echo-poor (hypoechoic)Q structure •\n• Rounded contourQ •\nAnswer (book): Answer: C. Hyperechogenic\nReference: Shackelford 7/e p420-421"},{"n":110,"chapter":"Esophagus","src":"question on PDF p. 395 · answer on PDF p. 406","pdfPage":395,"stem":"Most commonly used chemotherapy regimen used in CA esophagus: (AIIMS GIS May 2008)","options":[{"letter":"A","text":"5-FU + Cisplatin"},{"letter":"B","text":"Cisplatin + Vinblastine"},{"letter":"C","text":"Cisplatin + Paclitaxel"},{"letter":"D","text":"Cisplatin + Epirubicin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"5-FU + Cisplatin","explanation":"Sharply demarcated bordersQ Size >1 cmQ\nAnswer (book): Answer: A. 5-FU + Cisplatin"},{"n":111,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 406","pdfPage":396,"stem":"Which is not used in palliation in CA esophagus? (AIIMS GIS May 2008)","options":[{"letter":"A","text":"EMR"},{"letter":"B","text":"Photodynamic therapy"},{"letter":"C","text":"Laser therapy"},{"letter":"D","text":"Self-expanding stents"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"EMR","explanation":"Palliation Therapy in Carcinoma Esophagus\n• Laser TherapyQ\n• Photodynamic TherapyQ\n• Radiation TherapyQ\n• SEMSQ\nAnswer (book): Answer: A. EMR\nReference: Shackelford 7/e p438-448"},{"n":112,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"T-staging of esophagus is best done by: (AIIMS GIS Dec 2011, DNB 2002)","options":[{"letter":"A","text":"EUS"},{"letter":"B","text":"CT"},{"letter":"C","text":"MRI"},{"letter":"D","text":"PET"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"EUS","explanation":"• MC site of SCC of esophagus: Middle 1/3rdQ\n• MC site of adenocarcinoma of esophagus: Lower 1/3rdQ\n• MC site of carcinoma esophagus: Middle 1/3rd (overall)Q\nAnswer (book): Answer: A. EUS"},{"n":113,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Commonest site of esophagus carcinoma is: (UPPG 2008)","options":[{"letter":"A","text":"Upper 2/3rd"},{"letter":"B","text":"Middle 1/3rd"},{"letter":"C","text":"Lower 1/3rd"},{"letter":"D","text":"Crico-esophageal junction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Middle 1/3rd","explanation":"• “Bird’s beak” , “Pencil-tip” or “Rat’s tail” appearance is seen in AchalasiaQ.\nAnswer (book): Answer: B. Middle 1/3rd\nReference: Shackelford 7/e p417"},{"n":114,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Barium esophagogram findings in carcinoma esophagus are all except: (UPPG 2009)","options":[{"letter":"A","text":"Rat-tail deformity"},{"letter":"B","text":"Pencil tip appearance"},{"letter":"C","text":"Apple-core appearance"},{"letter":"D","text":"Filling defect"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Pencil tip appearance","explanation":"Features of CA Esophagus on Barium Swallow\n• Mucosal irregularity and shoulderingQ\n• NarrowingQ of the lumen\n• Irregular “rat-tail” filling defectQ of the distal esophagus with shouldered edgeQ\n• Annular strictureQ\n• Sharp and clear cut edge of filling defectQ\n• Proximal dilatationQ of the esophagus\nAnswer (book): Answer: B. Pencil tip appearance\nReference: Surgical radiology Clinical Cases by Prabhakar Fajiah (2007)/113"},{"n":115,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"A 60-year-old chronic smoker presented with progressive dysphagia. Barium swallow was done, what is the name of sign? (Recent Question 2017)","options":[{"letter":"A","text":"Bird beak appearance"},{"letter":"B","text":"Pencil tip appearance"},{"letter":"C","text":"Apple core appearance"},{"letter":"D","text":"Rat tail appearance"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Apple core appearance","explanation":"• Barium swallow: First investigation doneQ in suspected case of Carcinoma esophagus (classic finding of an apple\ncore lesionQ).\nAnswer (book): Answer: C. Apple core appearance\nReference: Sabiston 20/e p1028"},{"n":116,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"MC site of CA esophagus is: (MCI Nov 2017, Recent Question 2015, AIIMS Feb 2007)","options":[{"letter":"A","text":"Middle 1/3rd"},{"letter":"B","text":"Upper 1/3rd"},{"letter":"C","text":"Lower 1/3rd"},{"letter":"D","text":"Lower end of esophagus"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Middle 1/3rd","explanation":"a. Middle 1/3rd"},{"n":117,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"The commonest site of carcinoma esophagus in India is: (AIIMS Nov 2003)","options":[{"letter":"A","text":"Upper 1/3rd"},{"letter":"B","text":"Middle 1/3rd"},{"letter":"C","text":"Lower 1/3rd"},{"letter":"D","text":"GE junction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Middle 1/3rd","explanation":"b. Middle 1/3rd"},{"n":118,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"A patient presents with dysphagia of 4 weeks duration. Now he is able to swallow liquid food only. Which of the following is the one investigation to be done? (DPG 2009 Feb)","options":[{"letter":"A","text":"Barium studies"},{"letter":"B","text":"Upper GI endoscopy"},{"letter":"C","text":"CT Scan"},{"letter":"D","text":"Esophageal manometry"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barium studies","explanation":"Carcinoma Esophagus\n• Barium swallow is the first investigation for an esophageal diseaseQ presenting with dysphagia (it can show\nirregular filling defect with or without proximal dilatation, annular lesion appear as constricting bands) Barium\nSwallow\n• Endoscopy and biopsy is the investigation of choice for CA esophagusQ.\n• For adequate assessment, both barium swallow and endoscopy are requiredQ.\nAnswer (book): Answer: A. Barium studies\nReference: Sabiston 20/e p1028; Schwartz 10/e p1003-1014; Bailey 27/e p1088; Shackelford 7/e p420"},{"n":119,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Treatment of choice for CA esophagus: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Esophagectomy"},{"letter":"B","text":"External radiotherapy"},{"letter":"C","text":"Internal radiotherapy"},{"letter":"D","text":"Chemotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Esophagectomy","explanation":"a. Esophagectomy"},{"n":120,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Stage of CA esophagus is best decided by: (PGI SS June 2009)","options":[{"letter":"A","text":"Depth of tumor"},{"letter":"B","text":"Size of tumor"},{"letter":"C","text":"Histopathological grade"},{"letter":"D","text":"Age of the patient"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Depth of tumor","explanation":"a. Depth of tumor"},{"n":121,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Esophageal carcinoma is adequately assessed by: (PGI SS Dec 2009)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"Barium swallow + endoscopy"},{"letter":"C","text":"Endoscopy"},{"letter":"D","text":"USG"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Barium swallow + endoscopy","explanation":"b. Barium swallow + endoscopy"},{"n":122,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Most common complication of placing stent in CA esophagus: (AIIMS GIS May 2011)","options":[{"letter":"A","text":"Migration"},{"letter":"B","text":"Chest pain"},{"letter":"C","text":"Perforation"},{"letter":"D","text":"Bleeding"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Chest pain","explanation":"Self-Expanding Metallic Stents (SEMS) in Malignant Tracheoesophageal Fistula\n• SEMS are relatively easy to insert under fluroscopic guidance with a technical success rate of 95% and efficacy of\n85-100% in relieving dysphagia.\n• The duration of response is 5-6 monthsQ and complications occur in 10-15% patients.\n• MC complication of SEMS insertion: Chest pain or odynophagia (13%) > Tumor ingrowth overgrowth (10%)>\nStent migration (9%)> Severe reflux (8%)\n• The use of stents coated with silicone or polyurethane may prevent or delay tumor ingrowth and subsequent\nesophageal obstruction.\n• Coated stents have been used with good success (>90%) for the treatment of tracheoesophageal fistulaQ.\nTumor ingrowth may be addressed by insertion of another stent or by tumor ablation. Placement of stents through\nproximally located tumors, especially those near the cricopharyngeus, is often not well tolerated. Stents placed\nacross GE junction have a greater tendency to migrate and may result in symptomatic acid refluxQ. Fixed diameter\nplastic endoluminal prostheses, associated with significant morbidity and mortality and low rate of dysphagia relief,\nhave largely been abandonedQ.\nAnswer (book): Answer: B. Chest pain\nReference: Sabiston 20/e p1040; Schwartz 10/e p1008; Bailey 27/e p1094; Shackelford 7/e p439-442"},{"n":123,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"What is the diagnosis based on the given findings?","options":[{"letter":"A","text":"Mallory Weiss syndrome"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Carcinoma stomach"},{"letter":"D","text":"Esophageal varices"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Carcinoma esophagus","explanation":"b. Carcinoma esophagus (Ref: Sabiston 20/e p1028; Schwartz 10/e p1005; Bailey 27/e p1088)"},{"n":124,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 407","pdfPage":396,"stem":"Lymph node metastasis in CA esophagus is best detected by: (JIPMER SS 2016, AIIMS GIS May 2011)","options":[{"letter":"A","text":"PET"},{"letter":"B","text":"EUS"},{"letter":"C","text":"CT"},{"letter":"D","text":"Thoracoscopy + laparoscopy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"EUS","explanation":"• A barium swallow is recommended for any patient presenting with dysphagia.\n• The esophagram gives an overview of anatomy and functionQ.\n• It is able to differentiate intraluminal from intramural lesions and to discriminate between intrinsic (from a mass\nprotruding into the lumen) and extrinsic (from compression of a structures outside the esophagus) compression.\n• The classic finding of an apple-core lesion in patients with esophageal cancer is recognized easilyQ\nCarcinoma Esophagus\n• EUS is superior to CT or PET for assessment of both T and N stage.\n• Endoscopic ultrasound (EUS) is the best diagnostic tool available to assess the locoregional extent of disease (T\nand N Staging)Q\n• The depth of tumor penetration of the esophageal wall and the presence of lymph node involvement can be\nassessed with an ultrasound probe attached to the tip of a flexible endoscopeQ.\n• CT is generally considered to be less accurate in determining lymph node involvement than other modalities such\nas EUSQ.\nAnswer (book): Answer: B. EUS\nReference: Sabiston 20/e p1028, 1031; Schwartz 10/e p1003-1014; Bailey 27/e p1090; Shackelford 7/e p420-421"},{"n":125,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 408","pdfPage":396,"stem":"Best palliation in CA esophagus: (GB Pant 2011)","options":[{"letter":"A","text":"Surgical bypass"},{"letter":"B","text":"Surgical placement of MB tube"},{"letter":"C","text":"Endoprosthesis"},{"letter":"D","text":"Feeding jejunostomy"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Endoprosthesis","explanation":"c. Endoprosthesis"},{"n":126,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 408","pdfPage":396,"stem":"Most common site for squamous cell CA esophagus is: (All India 2001)","options":[{"letter":"A","text":"Upper third"},{"letter":"B","text":"Middle third"},{"letter":"C","text":"Lower third"},{"letter":"D","text":"Gastro-esophageal junction"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Middle third","explanation":"b. Middle third"},{"n":127,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 408","pdfPage":396,"stem":"True about CA esophagus: (PGI Dec 2003)","options":[{"letter":"A","text":"MC in middle 1/3rd"},{"letter":"B","text":"Adenocarcinoma is common variety"},{"letter":"C","text":"Carcinoma develops at the achalasia segment"},{"letter":"D","text":"Smoking is a risk factor"},{"letter":"E","text":"Endoscopy is the investigation of choice"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MC in middle 1/3rd, B. Adenocarcinoma is common variety, C. Carcinoma develops at the achalasia","explanation":"a. MC in middle 1/3rd, b. Adenocarcinoma is common variety, c. Carcinoma develops at the achalasia segment, d. Smoking is a\nrisk factor, e. Endoscopy is the investigation of choice"},{"n":128,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 408","pdfPage":396,"stem":"Treatment of advanced esophageal cancer is: (DNB 2006)","options":[{"letter":"A","text":"Chemoradiation only"},{"letter":"B","text":"Curative en-bloc resection"},{"letter":"C","text":"Chemoradiation followed by curative enbloc resection"},{"letter":"D","text":"Chemoradiation followed by palliative enbloc resection"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Chemoradiation followed by palliative enbloc resection","explanation":"d. Chemoradiation followed by palliative enbloc resection"},{"n":129,"chapter":"Esophagus","src":"question on PDF p. 396 · answer on PDF p. 408","pdfPage":396,"stem":"Regarding esophagus malignancy-operation all are true except: (MHSSMCET 2009)","options":[{"letter":"A","text":"Thoracoscopic assisted surgery"},{"letter":"B","text":"Radiotherapy"},{"letter":"C","text":"Chemotherapy + surgery"},{"letter":"D","text":"Transhiatal esophagectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Radiotherapy","explanation":"b. Radiotherapy"},{"n":130,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Transhiatal esophagectomy was planned for adenocarcinoma of lower end of esophagus. The approach would be in the following order: (AIIMS Nov 2007)","options":[{"letter":"A","text":"Abdomen-Neck"},{"letter":"B","text":"Abdomen-Thorax-Neck"},{"letter":"C","text":"Neck-Thorax-Abdomen"},{"letter":"D","text":"Abdomen-Thorax"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Abdomen-Neck","explanation":"Orringer Transhiatal Esophagectomy\n• Double incision: Midline laparotomy followed by cervical incisionQ\n• Cervical anastomosis is doneQ\n• MC procedure done for carcinoma esophagusQ\nAnswer (book): Answer: A. Abdomen-Neck\nReference: Sabiston 20/e p1035; Schwartz 10/e p1009-1012, 1011-1012; Shackelford 7/e p429-430"},{"n":131,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"True about carcinoma esophagus is: (Kerala 94)","options":[{"letter":"A","text":"Most common site is lower end"},{"letter":"B","text":"Both adeno and squamous cell carcinoma occur"},{"letter":"C","text":"Commonest histology is adenocarcinoma"},{"letter":"D","text":"More common in females"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Both adeno and squamous cell carcinoma occur","explanation":"b. Both adeno and squamous cell carcinoma occur"},{"n":132,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Which is the most reliable diagnostic method for staging the esophageal cancer? (UPSC 2006)","options":[{"letter":"A","text":"MRI"},{"letter":"B","text":"Endoscopic ultrasound"},{"letter":"C","text":"CT scan"},{"letter":"D","text":"Thoracoscopy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endoscopic ultrasound","explanation":"b. Endoscopic ultrasound"},{"n":133,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Early stage of carcinoma esophagus is diagnosed by: (UPPG 2008)","options":[{"letter":"A","text":"Barium meal"},{"letter":"B","text":"Transesophageal USG"},{"letter":"C","text":"MRI"},{"letter":"D","text":"Endoscopy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Transesophageal USG","explanation":"b. Transesophageal USG"},{"n":135,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Which of the following should never be carried out as a treatment for carcinoma esophagus? (MHPGMCET 2008)","options":[{"letter":"A","text":"Gastrostomy for palliation"},{"letter":"B","text":"Radiotherapy alone"},{"letter":"C","text":"Radical esophagectomy"},{"letter":"D","text":"Radiotherapy and chemotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Gastrostomy for palliation","explanation":"• A gastric pull-up in the posterior mediastinal position has the best functional result, and every effort is made to\npreserve and use this successful combination.\nAnswer (book): Answer: A. Gastrostomy for palliation"},{"n":136,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Treatment of SCC of esophagus: (GB PANT 2011)","options":[{"letter":"A","text":"Cisplatin"},{"letter":"B","text":"Etoposide"},{"letter":"C","text":"Adriamycin"},{"letter":"D","text":"Bleomycin"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Cisplatin","explanation":"a. Cisplatin"},{"n":137,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"In Esophageal cancer prognosis is best determined by: (AIIMS May 2015)","options":[{"letter":"A","text":"Cellular differentiation"},{"letter":"B","text":"Age of patient"},{"letter":"C","text":"T stage"},{"letter":"D","text":"Length of involvement"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"T stage","explanation":"c. T stage"},{"n":138,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"True regarding esophageal squamous cell carcinoma is/are: (PGI May 2018)","options":[{"letter":"A","text":"Barrett’s esophagus is a risk factor"},{"letter":"B","text":"Common in middle third of esophagus"},{"letter":"C","text":"Stomach, jejunum or colon can be used for replacement after surgical removal"},{"letter":"D","text":"Chemoradiation has little role in inoperable patients"},{"letter":"E","text":"Staging is done by CECT"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Common in middle third of esophagus, C. Stomach, jejunum or colon can be used for replacement","explanation":"after surgical removal,\nd. Chemoradiation has little role in inoperable patients\nAnswer (book): Answer: B. Common in middle third of esophagus, C. Stomach, jejunum or colon can be used for replacement"},{"n":139,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Conduit in gastric pull up is based on: (AIIMS GIS Dec 2011, May 2008)","options":[{"letter":"A","text":"Right gastric and right gastroepiploic artery"},{"letter":"B","text":"Right gastric and left gastroepiploic artery"},{"letter":"C","text":"Left gastric and right gastroepiploic artery"},{"letter":"D","text":"Left gastric and left gastroepiploic artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Right gastric and right gastroepiploic artery","explanation":"a. Right gastric and right gastroepiploic artery  (Ref: Sabiston 20/e p1035-1036; Schwartz 10/e p1009; Bailey 27/e p1092; Shackelford\n7/e p518-520)"},{"n":140,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Which is the best substitute for esophagus? (MHSSMCET 2005, MP 99, All India 96, PGI Dec 95)","options":[{"letter":"A","text":"Stomach"},{"letter":"B","text":"Jejunum"},{"letter":"C","text":"Left sided colon"},{"letter":"D","text":"Right sided colon"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stomach","explanation":"a. Stomach"},{"n":141,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"First successful esophagectomy was done by: (AIIMS GIS Dec 2011)","options":[{"letter":"A","text":"Miculikz"},{"letter":"B","text":"Kaplan"},{"letter":"C","text":"Torek"},{"letter":"D","text":"Orringer"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Torek","explanation":"• First successful esophagectomy was done by Torek.\nAnswer (book): Answer: C. Torek\nReference: Shackelford 7/e p416"},{"n":142,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Ivor Lewis operation is the treatment of choice for cancer involving .............. esophagus: (MHSSMCET 2009)","options":[{"letter":"A","text":"Upper 1/3rd"},{"letter":"B","text":"Middle 1/3rd"},{"letter":"C","text":"Lower 1/3rd"},{"letter":"D","text":"Entire esophagus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Middle 1/3rd","explanation":"Tumor Margin for Curative Excision\n• In GI malignancies (stomachQ, small intestineQ, colonQ and proximal rectumQ), tumor margin for curative excision\nis 5cmQ except: − Esophagus: 10 cmQ − Distal rectum: 2 cmQ\nAnswer (book): Answer: B. Middle 1/3rd\nReference: Sabiston 20/e p1035-1036; Schwartz 10/e p1009; Bailey 27/e p1092; Shackelford 7/e p427-430"},{"n":143,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Which of the following surgical approach was first described by Orringer for the management of carcinoma esophagus? (J amd K 2005)","options":[{"letter":"A","text":"Transhiatal"},{"letter":"B","text":"Thoracoscopic"},{"letter":"C","text":"Left thoracoabdominal"},{"letter":"D","text":"Right thoracoabdominal"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Transhiatal","explanation":"a. Transhiatal"},{"n":144,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 408","pdfPage":397,"stem":"Commonest cause for mortality in Ivor Lewis operations: (AIIMS Nov 98)","options":[{"letter":"A","text":"Pulmonary atelectasis"},{"letter":"B","text":"Anastomotic leak"},{"letter":"C","text":"Thoracic duct fistula"},{"letter":"D","text":"Sub diaphragmatic collection"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Anastomotic leak","explanation":"Anastomotic leak following Ivor Lewis esophagectomy is a feared complication that in the past was\nassociated with a 50% mortality rate. The anastomosis is intrathoracic, leak cause severe mediastinitis.\nComplications of Esophagectomy\n• Anastomotic Leak (MC)\n• Anastomotic stricture\n• Pulmonary complications Q\n• Recurrent laryngeal nerve palsy\n• Chylothorax\nAnastomotic Leak after Esophagectomy\nAnswer (book): Answer: B. Anastomotic leak\nReference: Sabiston 20/e p1035-1036; Schwartz 10/e p1009; Shackelford 7/e p538-545"},{"n":145,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 409","pdfPage":397,"stem":"Which of the following operations was first described by Orringer? (COMEDK 2006)","options":[{"letter":"A","text":"Enbloc esophagectomy"},{"letter":"B","text":"Transhiatal esophagectomy"},{"letter":"C","text":"Thoracoscopic esophagectomy"},{"letter":"D","text":"Transthoracic esophagectomy"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Transhiatal esophagectomy","explanation":"• Incidence of anastomotic leak is higher following cervical anastomosis (10-15%) than intrathoracic anastomosis\n(5-10%).\n• Although leak is more common following cervical anastomosis, it is rarely life-threateningQ.\n• Anastomotic leak following Ivor Lewis esophagectomy is a feared complication that in the past was associated\nwith a 50% mortality rateQ.\n• Confirmation is usually possible by Gastrografin swallowQ or instillation of contrast through the nasogastric tube.\n• Immediate intervention is required, and attempts at direct repair with muscle flap reinforcement and wide\ndrainage are often successfulQ.\n• Patients who are unstable or severely ill should be diverted with a spit fistula, and either excluded at the hiatus,\nor have the conduit closed and returned to the abdomenQ.\n• Pulmonary complications are the MC cause of postoperative morbidity and mortality in transhiatal\nesophagectomyQ\nAnswer (book): Answer: B. Transhiatal esophagectomy"},{"n":146,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 409","pdfPage":397,"stem":"The ideal replacement for the esophagus after esophagectomy is: (COMEDK 2010)","options":[{"letter":"A","text":"Stomach"},{"letter":"B","text":"Jejunum"},{"letter":"C","text":"Colon"},{"letter":"D","text":"Synthetic stent"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Stomach","explanation":"a. Stomach"},{"n":147,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 409","pdfPage":397,"stem":"After esophagectomy, stomach tube is based on supply form: (MHSSMCET 2006)","options":[{"letter":"A","text":"Right gastroepiploic artery"},{"letter":"B","text":"Right gastric artery"},{"letter":"C","text":"Left gastroepiploic artery"},{"letter":"D","text":"Left gastric artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Right gastroepiploic artery, B. Right gastric artery","explanation":"a. Right gastroepiploic artery, b. Right gastric artery\nLEIOMYOMA"},{"n":148,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 409","pdfPage":397,"stem":"Commonest benign tumor of the esophagus: (JIPMER 2014, DPG 2009 Feb)","options":[{"letter":"A","text":"Leiomyoma"},{"letter":"B","text":"Papilloma"},{"letter":"C","text":"Adenoma"},{"letter":"D","text":"Hemangioma"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Leiomyoma","explanation":"a. Leiomyoma (Ref: Sabiston 20/e p1032; Schwartz 10/e p1216; Bailey 27/e p1084; Shackelford 7/e p465-469)"},{"n":149,"chapter":"Esophagus","src":"question on PDF p. 397 · answer on PDF p. 409","pdfPage":397,"stem":"This characteristic appearance is seen on barium swallow in: (Recent Question 2017)","options":[{"letter":"A","text":"Achalasia cardia"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Leiomyoma"},{"letter":"D","text":"Diffuse esophageal spasm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Leiomyoma","explanation":"• Barium swallow is IOC for leiomyoma (classical, smooth, contoured, punched-out defect)Q\nAnswer (book): Answer: C. Leiomyoma\nReference: Sabiston 20/e p1032; Schwartz 10/e p1017; Bailey 27/e p1085"},{"n":150,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Endoscopic treatment of leiomyoma of esophagus is contraindicated due to: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Infection"},{"letter":"B","text":"Chances of dissemination"},{"letter":"C","text":"Perforation"},{"letter":"D","text":"Perforation and dissemination"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Perforation","explanation":"c. Perforation\nDYSPHAGIA"},{"n":151,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Intermittent dysphagia is caused by: (PGI June 2004)","options":[{"letter":"A","text":"Stricture"},{"letter":"B","text":"Reflux esophagitis"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"Pharyngeal diverticulum"},{"letter":"E","text":"Diffuse esophageal spasm"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Reflux esophagitis, D. Pharyngeal diverticulum, E. Diffuse esophageal spasm","explanation":"Dysphagia Progressive Achalasia SclerodermaQ Peptic strictureQ CarcinomaQ\n• Lower esophageal ring (Schatzki’s ring)Q\n• Diffuse esophageal spasmQ\n• Zenker’s diverticulumQ\nAnswer (book): Answer: B. Reflux esophagitis, D. Pharyngeal diverticulum, E. Diffuse esophageal spasm\nReference: Sabiston 20/e p1049; Schwartz 10/e p625"},{"n":152,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"A 60-year-old patient presenting with dysphagia of 6 weeks duration with solid foods, now can swallow only liquids. Investigation done for diagnosis: (PGI Dec 2003)","options":[{"letter":"A","text":"CXR"},{"letter":"B","text":"Ba swallow"},{"letter":"C","text":"Endoscopy"},{"letter":"D","text":"USG"},{"letter":"E","text":"C.T. Scan"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"CXR, B. Ba swallow, C. Endoscopy, D. USG, E. C.T. Scan","explanation":"The clinical history is suggestive of carcinoma esophagus. All of the given investigations are used for\nthe complete work-up.\nAnswer (book): Answer: A. CXR, B. Ba swallow, C. Endoscopy, D. USG, E. C.T. Scan"},{"n":153,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Investigation of choice for dysphagia for solids: (PGI Dec 2000)","options":[{"letter":"A","text":"Barium swallow"},{"letter":"B","text":"Endoscopy"},{"letter":"C","text":"X-ray chest"},{"letter":"D","text":"C.T. Scan"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Endoscopy","explanation":"b. Endoscopy"},{"n":154,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Odynophagia occurs in: (AIIMS GIS Dec 2011, PGI June 96)","options":[{"letter":"A","text":"Achalasia"},{"letter":"B","text":"Herpes esophagitis"},{"letter":"C","text":"Monilial esophagitis"},{"letter":"D","text":"Barrett’s esophagus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Herpes esophagitis, C. Monilial esophagitis","explanation":"If odynophagia is present, candidial (monilial) or herpes esophagitis or pill induced esophagitis should\nbe suspected.\nOdynophagia\n• Odynophagia means painful swallowing seen in inflammatory lesions of food passage (i.e. oral cavity, pharynx\nand esophagus)\n• Causes: − Candidial (monilial) esophagitisQ − Herpes esophagitisQ − Pill induced esophagitisQ\nAnswer (book): Answer: B. Herpes esophagitis, C. Monilial esophagitis\nReference: Harrison 19/e p1901, 1909; Bailey 27/e p1103"},{"n":155,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"A 40-year-old female patient presented with dysphagia to both liquids and solids and regurgitation for 3 months. The dysphagia was non-progressive. What is the most likely diagnosis? (AIIMS May 2006)","options":[{"letter":"A","text":"Carcinoma of the esophagus"},{"letter":"B","text":"Lower esophageal mucosal ring"},{"letter":"C","text":"Achalasia cardia"},{"letter":"D","text":"Reflux esophagitis with esophageal stricture"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Achalasia cardia","explanation":"Presence of dysphagia to both solids and liquids suggests the diagnosis of achalasia.\nAnswer (book): Answer: C. Achalasia cardia"},{"n":156,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Dysphagia lusoria is caused by: (Karnataka 2013, PGI SS June 2001)","options":[{"letter":"A","text":"Abnormal elongation of arch of aorta"},{"letter":"B","text":"Aneurysm of arch of aorta"},{"letter":"C","text":"Esophageal web"},{"letter":"D","text":"Esophageal diverticula"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Abnormal elongation of arch of aorta","explanation":"Causes of Dysphagia Lusoria\nAbnormal right subclavian arteryQ (MC) Right aortic archQ Double aortic archQ Abnormal innominate arteryQ\n• Vascular ring (constriction) formed by a PDA or a ligamentum arteriosum and the pulmonary artery or aortic\narchQ.\nAnswer (book): Answer: A. Abnormal elongation of arch of aorta\nReference: Sabiston 20/e p1610; Bailey 27/e p1105"},{"n":157,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 409","pdfPage":398,"stem":"Dysphagia lusoria is due to: (Recent Question 2016, 2014, AIIMS Nov 2003)","options":[{"letter":"A","text":"Esophageal diverticulum"},{"letter":"B","text":"Aneurysm of aorta"},{"letter":"C","text":"Esophageal web"},{"letter":"D","text":"Compression by aberrant blood vessel"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Compression by aberrant blood vessel","explanation":"Intermittent\nQ\nAnswer (book): Answer: D. Compression by aberrant blood vessel\nReference: Sabiston 20/e p1581; Bailey 27/e p1105"},{"n":158,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"All are true about dysphagia lusoria except: (DPG 2008)","options":[{"letter":"A","text":"Right aortic arch"},{"letter":"B","text":"Vascular ring"},{"letter":"C","text":"Due to aberrant subclavian artery causing pressure on esophagus"},{"letter":"D","text":"Acquired in later life"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Acquired in later life","explanation":"Dysphagia lusoria is a disorder of swallowing caused due to vascular anomaliesQ (developmental or\ncongenital abnormalities).\nAnswer (book): Answer: D. Acquired in later life\nReference: Sabiston 20/e p1581"},{"n":159,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Mackler’s triad includes: (PGI Nov 2009)","options":[{"letter":"A","text":"Vomiting"},{"letter":"B","text":"Subcutaneous emphysema"},{"letter":"C","text":"Lower thoracic pain"},{"letter":"D","text":"Peripheral cyanosis"},{"letter":"E","text":"Pleural effusion"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Vomiting, B. Subcutaneous emphysema, C. Lower thoracic pain","explanation":"a. Vomiting, b. Subcutaneous emphysema, c. Lower thoracic pain  (Ref: Sabiston 20/e p1025-1026; Schwartz 10/e p1018; Bailey 27/e\np1073; Shackelford 7/e p478-484)"},{"n":160,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"True about Boerhaave’s syndrome: (PGI Nov 2009)","options":[{"letter":"A","text":"MC at lower 1/3rd"},{"letter":"B","text":"Hematemesis is early symptoms"},{"letter":"C","text":"Acute chest pain"},{"letter":"D","text":"Surgically treated"},{"letter":"E","text":"Operation is done after 24 hours"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"MC at lower 1/3rd, C. Acute chest pain, D. Surgically treated","explanation":"a. MC at lower 1/3rd, c. Acute chest pain, d. Surgically treated"},{"n":161,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"True about esophageal injury: (PGI June 2009)","options":[{"letter":"A","text":"Barium swallow is diagnostic"},{"letter":"B","text":"Treatment is primary repair"},{"letter":"C","text":"MC after penetrating injury"},{"letter":"D","text":"Mortality increased if repair after 24 hours"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Barium swallow is diagnostic, B. Treatment is primary repair, C. MC after penetrating injury, D.","explanation":"a. Barium swallow is diagnostic, b. Treatment is primary repair, c. MC after penetrating injury, d. Mortality increased if\nrepaired after 24 hours"},{"n":162,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Boerhaave’s syndrome, true is: (PGI May 2005)","options":[{"letter":"A","text":"Iatrogenic"},{"letter":"B","text":"Silent manifestation"},{"letter":"C","text":"Present with acute chest pain"},{"letter":"D","text":"Treatment is surgical"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Present with acute chest pain, D. Treatment is surgical","explanation":"c. Present with acute chest pain, d. Treatment is surgical"},{"n":163,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Which is most common site for iatrogenic esophageal perforation? (Recent Question 2017, Recent Question 2014, DNB 2013, 2012, AIIMS Nov 97)","options":[{"letter":"A","text":"Abdominal portion"},{"letter":"B","text":"Cervical portion"},{"letter":"C","text":"Above arch of aorta"},{"letter":"D","text":"Below arch of aorta"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cervical portion","explanation":"Esophageal Perforation Iatrogenic\nSpontaneous\n• Most common typeQ\n• Caused by endoscopyQ\n• MC site is cervical esophagus (cricopharyngeal area)Q\nAnswer (book): Answer: B. Cervical portion\nReference: Sabiston 20/e p1025-1026; Schwartz 10/e p1018; Bailey 27/e p1073; Shackelford 7/e p478-479"},{"n":164,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Commonest cause of esophageal perforation is:","options":[{"letter":"A","text":"Acid ingestion"},{"letter":"B","text":"Hyperemesis"},{"letter":"C","text":"Instrumentation"},{"letter":"D","text":"Carcinoma infiltrating"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Instrumentation 165.","explanation":"c. Instrumentation"},{"n":165,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"A 40-year-old female presents with perforation of distal third of esophagus. Best form of management is: (JIPMER GIS 2011)","options":[{"letter":"A","text":"Antibiotics and drainage"},{"letter":"B","text":"Tubal drainage"},{"letter":"C","text":"Primary resection and anastomosis"},{"letter":"D","text":"Esophagectomy with bringing proximal end as fistula in neck"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Esophagectomy with bringing proximal end as fistula in neck","explanation":"d. Esophagectomy with bringing proximal end as fistula in neck"},{"n":166,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"In majority of patients with esophageal leaks in thoracic cavity of less than 12 hours duration, the treatment of choice is: (UPSC 97)","options":[{"letter":"A","text":"Primary closure, drainage and antibiotics"},{"letter":"B","text":"Early esophagogastrostomy"},{"letter":"C","text":"Exclusion and diversion of continuity"},{"letter":"D","text":"Total esophagectomy and gastric pull up"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Primary closure, drainage and antibiotics","explanation":"• Esophageal rupture after vomiting\n• MC site: left posterolateral side of the distal esophagusQ\nAnswer (book): Answer: A. Primary closure, drainage and antibiotics"},{"n":167,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Best flap for esophagus repair:","options":[{"letter":"A","text":"Colon"},{"letter":"B","text":"Stomach"},{"letter":"C","text":"Jejunum"},{"letter":"D","text":"Latissimus dorsi"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Stomach","explanation":"Operative Repair of Esophageal Perforation\n• The principles of repair comprise a clear exposure of the perforation and debridement of devitalized tissue,\nfollowed by a primary closure.\n• Following debridement of devitalized tissue, primary mucosal repair should then be performed with interrupted,\nabsorbable suture, taking care to minimize esophageal stricturing while obtaining adequate suture purchase on\nvital tissue.\n• The muscular layer is then reapproximated with an interrupted or running sutureQ.\n• Subsequent coverage with a vascular pedicle, such as an intercostal muscle flap, and pleural, pericardial, or\nomental pedicle allows further buttressing of a repair and is recommended whenever feasibleQ.\n• Gastric fundus may also be suitable tissue reinforcement especially for the distal perforationQ.\n• Depending on the site of perforation, any of the antireflux procedures (Belsey Mark IV, Nissen, Dor, Toupet) may\nbe used to buttress the repair.\nAnswer (book): Answer: B. Stomach\nReference: Shackelford 7/e p483"},{"n":168,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"In esophageal perforation all are seen except: (UPPG 2000)","options":[{"letter":"A","text":"Pain"},{"letter":"B","text":"Bradycardia"},{"letter":"C","text":"Fever"},{"letter":"D","text":"Hypotension"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bradycardia","explanation":"b. Bradycardia"},{"n":169,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"Boerhaave’s syndrome is due to: (Recent Question 2016, DNB 2012, UPPG 2007)","options":[{"letter":"A","text":"Drug induced esophagus perforation"},{"letter":"B","text":"Corrosive injury"},{"letter":"C","text":"Spontaneous perforation"},{"letter":"D","text":"Gastroesophageal reflux disease"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Spontaneous perforation","explanation":"c. Spontaneous perforation"},{"n":170,"chapter":"Esophagus","src":"question on PDF p. 398 · answer on PDF p. 410","pdfPage":398,"stem":"When a ‘spontaneous perforation’ of the esophagus occurs as a result of severe barotrauma while a person vomits against a closed glottis, the condition is known as: (UPSC 2008)","options":[{"letter":"A","text":"Mallory-Weiss syndrome"},{"letter":"B","text":"Plummer-Vinson syndrome"},{"letter":"C","text":"Kartagener syndrome"},{"letter":"D","text":"Boerhaave’s syndrome"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Boerhaave’s syndrome","explanation":"d. Boerhaave’s syndrome"},{"n":171,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Longitudinal tear of esophagus is seen in: (MHPGMCET 2002)","options":[{"letter":"A","text":"Boerhaave’s syndrome"},{"letter":"B","text":"Mallory-Weiss syndrome"},{"letter":"C","text":"Nutcracker’s esophagus"},{"letter":"D","text":"Lye stricture"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Boerhaave’s syndrome","explanation":"a. Boerhaave’s syndrome"},{"n":172,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"In Boerhaave’s syndrome, perforation of esophagus is seen at? (MHSSMCET 2009)","options":[{"letter":"A","text":"Upper anterior"},{"letter":"B","text":"Lower posterior"},{"letter":"C","text":"Upper posterior"},{"letter":"D","text":"Lower anterior"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Lower posterior","explanation":"b. Lower posterior"},{"n":173,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Most common site a spontaneous rupture of esophagus is: (Recent Question 2017, DNB 2009)","options":[{"letter":"A","text":"Cricopharyngeal junction"},{"letter":"B","text":"Cardioesophageal junction"},{"letter":"C","text":"Mid esophagus"},{"letter":"D","text":"After the crossing of arch of aorta"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Cardioesophageal junction","explanation":"b. Cardioesophageal junction"},{"n":174,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Investigation of choice for esophageal rupture is? (DNB 2014)","options":[{"letter":"A","text":"Dynamic MRI"},{"letter":"B","text":"Rigid esophagoscopy"},{"letter":"C","text":"Barium contrast swallow"},{"letter":"D","text":"Water soluble low molecular weight contrast swallow"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Water soluble low molecular weight contrast swallow","explanation":"d. Water soluble low molecular weight contrast swallow"},{"n":175,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Which of the following is true about Boerhaave’s syndrome? (Recent Question 2017)","options":[{"letter":"A","text":"May present with peritonitis"},{"letter":"B","text":"Forceful vomiting against open glottis"},{"letter":"C","text":"Upper third esophagus location"},{"letter":"D","text":"Most patients are managed by conservative management"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"May present with peritonitis","explanation":"a. May present with peritonitis (Ref: Sabiston 20/e p1025; Schwartz 10/e p1018; Bailey 27/e p1072)"},{"n":176,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Safest contrast in esophageal perforation: (Recent Question 2018)","options":[{"letter":"A","text":"Iohexol"},{"letter":"B","text":"Barium sulphate"},{"letter":"C","text":"Gadolinium"},{"letter":"D","text":"Hypaque"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Hypaque","explanation":"“Iodinated Contrast Materials Water-soluble iodinated contrast media can be used to visualize the\nupper gastrointestinal tract. These contrast materials are considered safer than barium sulfate in patients with\nesophageal perforation or communication between esophagus and airways and when there is a risk of aspiration into\nthe bronchi. They are also used for the examination of the esophagus in the early postoperative period following\nesophageal surgery or correction of hiatal hernia. The demonstartion of leak is a contraindication for the withdrawal\nof the postoperative gastric tube. The most commonly used iodinated water-soluble contrast media are Gastrograffin\nand Hypaque.”- Diseases of the Esophagus By G. Vantrappen, J. Hellemans (2012)/p135\nAnswer (book): Answer: D. Hypaque\nReference: Diseases of the Esophagus By G. Vantrappen, J. Hellemans (2012)/p135"},{"n":177,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"True about esophageal perforation: (PGI November 2017)","options":[{"letter":"A","text":"Morbidity is mainly due to mediastinal infection"},{"letter":"B","text":"Partial tear involving mucosa should be managed conservatively"},{"letter":"C","text":"Simple exploration and end to end anastomosis is done as soon as possible in all cases"},{"letter":"D","text":"Spontaneous perforation most commonly occur in mid thoracic esophagus"},{"letter":"E","text":"Serum amylase levels may be high as a result of absorption of amylase from the pleural cavity"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Morbidity is mainly due to mediastinal infection, B. Partial tear involving mucosa should be","explanation":"managed conservatively,\ne. Serum amylase levels may be high as a result of absorption of amylase from the pleural cavity\nAnswer (book): Answer: A. Morbidity is mainly due to mediastinal infection, B. Partial tear involving mucosa should be"},{"n":178,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"Esophageal atresia is most commonly associated with: (KGMC 2011)","options":[{"letter":"A","text":"Respiratory anomalies"},{"letter":"B","text":"Anorectal malformations"},{"letter":"C","text":"Genitourinary"},{"letter":"D","text":"CVS"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"CVS","explanation":"d. CVS (Ref: Sabiston 20/e p1866-1868; Schwartz 10/e p608-609; Bailey 27/e p133; Shackelford 7/e p509-515)"},{"n":179,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 410","pdfPage":399,"stem":"The most common type of tracheoesophageal fistula is: (Recent Question 2017, Recent Question 2014, MAHE 2008, 2007)","options":[{"letter":"A","text":"Esophageal atresia without tracheoesophageal fistula"},{"letter":"B","text":"Esophageal atresia with proximal tracheoesophageal fistula"},{"letter":"C","text":"Esophageal atresia with distal tracheoesophageal fistula"},{"letter":"D","text":"Esophageal atresia with proximal and distal tracheoesophageal fistula"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Esophageal atresia with distal tracheoesophageal fistula","explanation":"c. Esophageal atresia with distal tracheoesophageal fistula"},{"n":180,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"What is the type of tracheoesophageal fistula (TEF) seen on barium swallow?","options":[{"letter":"A","text":"Atresia with proximal TEF"},{"letter":"B","text":"Atresia with distal TEF"},{"letter":"C","text":"Atresia with both proximal and distal TEF"},{"letter":"D","text":"TEF without esophageal atresia"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"TEF without esophageal atresia","explanation":"d. TEF without esophageal atresia (Ref: Sabiston 20/e p1867; Schwartz 10/e p1609; Bailey 27/e p133)\n  Type of tracheoesophageal fistula (TEF) seen on barium swallow is H type (TEF without esophageal atresia)."},{"n":181,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"Malignant tracheoesophageal fistula best treated with: (PGI May 2005)","options":[{"letter":"A","text":"Radiotherapy"},{"letter":"B","text":"Chemotherapy"},{"letter":"C","text":"Stenting"},{"letter":"D","text":"Tube"},{"letter":"E","text":"Surgical correction"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Stenting","explanation":"c. Stenting"},{"n":182,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"Treatment of malignant tracheoesophageal fistula includes: (PGI June 2007)","options":[{"letter":"A","text":"Expandable metal stent"},{"letter":"B","text":"Surgery with graft"},{"letter":"C","text":"Gastrostomy tube"},{"letter":"D","text":"Radiotherapy"},{"letter":"E","text":"Chemotherapy"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Expandable metal stent, B. Surgery with graft, C. Gastrostomy tube","explanation":"Malignant Tracheoesophageal Fistula\nIt is a sign of incurable esophageal carcinomaQ Some have advocated surgical bypass and esophageal exclusion,\nbut this is a major procedure Self expanding metallic stent is the best treatmentQ Semi-rigid prosthetic tubings may\nbe used (Gastrostomy tube)Q\nType of tracheoesophageal fistula (TEF) seen on barium swallow is H type (TEF without esophageal atresia).\nAnswer (book): Answer: A. Expandable metal stent, B. Surgery with graft, C. Gastrostomy tube\nReference: CSDT 11/e p1314; Bailey 27/e p1095"},{"n":183,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"Which one of the following life - threatening congenital anomalies in the newborn presents with polyhydramnios, aspiration pneumonia, excessive salivation and difficulty in passing a nasogastric tube? (APPG 2016)","options":[{"letter":"A","text":"Choanal atresia"},{"letter":"B","text":"Tracheoesophageal fistula"},{"letter":"C","text":"Diaphragmatic hernia"},{"letter":"D","text":"Gastroschisis"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Tracheoesophageal fistula","explanation":"b. Tracheoesophageal fistula"},{"n":184,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"Which of the following is associated with poor prognosis in tracheo-esophageal fistula in children? (Recent Question 2016)","options":[{"letter":"A","text":"Weight <2000 gms"},{"letter":"B","text":"Major cardiac anomaly"},{"letter":"C","text":"Proximal TE fistula with distal esophageal atresia"},{"letter":"D","text":"Vertebral anomaly"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Major cardiac anomaly","explanation":"b. Major cardiac anomaly"},{"n":185,"chapter":"Esophagus","src":"question on PDF p. 399 · answer on PDF p. 411","pdfPage":399,"stem":"Schatzki’s ring is: (PGI Dec 98)","options":[{"letter":"A","text":"Mucosal ring at squamocolumnar junction"},{"letter":"B","text":"Muscular ring"},{"letter":"C","text":"Dysphagia is the symptom"},{"letter":"D","text":"Inflammatory stricture"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Mucosal ring at squamocolumnar junction, C. Dysphagia is the symptom","explanation":"a. Mucosal ring at squamocolumnar junction, c. Dysphagia is the symptom  (Ref: Sabiston 20/e p1026-1027; Schwartz 10/e p984;\nBailey 27/e p1102; Shackelford 7/e p89-90)"},{"n":186,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"What is the diagnosis based on the given barium swallow findings?","options":[{"letter":"A","text":"Esophageal web"},{"letter":"B","text":"Carcinoma esophagus"},{"letter":"C","text":"Schatzki ring"},{"letter":"D","text":"Leiomyoma"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Schatzki ring","explanation":"c. Schatzki ring (Ref: Sabiston 20/e p1027; Schwartz 10/e p984; Bailey 27/e p1102)"},{"n":187,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"Schatzki ring is seen at: (UPPG 2009)","options":[{"letter":"A","text":"Mid-esophagus"},{"letter":"B","text":"Lower-esophagus"},{"letter":"C","text":"Junction of lower esophagus"},{"letter":"D","text":"None"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Lower esophagus","explanation":"b. Lower esophagus"},{"n":188,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"False about Schatzki ring is: (Punjab 2007)","options":[{"letter":"A","text":"Occurs at lower part of esophagus"},{"letter":"B","text":"Involves mucosa and submucosa"},{"letter":"C","text":"Involves mucosa, submucosa and muscularis"},{"letter":"D","text":"Located at squamocolumnar junction"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Involves mucosa, submucosa and muscularis","explanation":"c. Involves mucosa, submucosa and muscularis"},{"n":189,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"True about Schatzki’s ring: (PGI Nov 2010)","options":[{"letter":"A","text":"Has skeletal muscle"},{"letter":"B","text":"Located at lower esophagus"},{"letter":"C","text":"Causes dysphagia"},{"letter":"D","text":"Contain all layers of esophagus"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Located at lower esophagus, C. Causes dysphagia","explanation":"b. Located at lower esophagus, c. Causes dysphagia"},{"n":190,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"Schatzki ring: (DNB 2007, MHSSMCET 2007)","options":[{"letter":"A","text":"Can be treated by PPI alone"},{"letter":"B","text":"Occurs at GE junction"},{"letter":"C","text":"Type A ring"},{"letter":"D","text":"Type C ring"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Occurs at GE junction","explanation":"Types of Esophageal Ring on Barium Examination Located few cm proximal to GE junction\nType B\nSchatzki’s ring: MC esophageal ring found on esophagogram, at GE junctionQ\nType C\nLocated at most distal portion of esophagus, formed by diaphragmatic crural pressure\nAnswer (book): Answer: B. Occurs at GE junction\nReference: Gastroenterol Hepatol (NY); 2010 November 6 (11): 701-704"},{"n":191,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"What is the most probable diagnosis on the basis of given endoscopy image? (Recent Question 2016)","options":[{"letter":"A","text":"GAVE"},{"letter":"B","text":"Schatzki ring"},{"letter":"C","text":"Barrett’s esophagus"},{"letter":"D","text":"Esophageal varices"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Schatzki ring","explanation":"b. Schatzki ring (Ref: Sabiston 20/e p1026; Schwartz 10/e p984; Bailey 27/e p1102; Shackelford 7/e p89-90)"},{"n":192,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"A foreign body usually gets arrested in which part of esophagus? (DNB 2003)","options":[{"letter":"A","text":"Cardiac part of the esophagus"},{"letter":"B","text":"In the middle third of the esophagus"},{"letter":"C","text":"Below the cricopharynx"},{"letter":"D","text":"Above the cricopharynx"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Above the cricopharynx","explanation":"The first constriction where the esophagus commences is at the cricopharyngeal sphincter: This is the\nnarrowest portion of the esophagus and is the most common site of foreign body.\nAnswer (book): Answer: D. Above the cricopharynx\nReference: Schwartz 9/e p2378; Dhingra 4/e p64"},{"n":193,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"A child was brought by his mother to the emergency with history of accidental swallowing of coin. Chest X-ray is given below. What is the location of foreign body in this child? (Recent Question 2016)","options":[{"letter":"A","text":"Esophagus"},{"letter":"B","text":"Trachea"},{"letter":"C","text":"Bronchus"},{"letter":"D","text":"None of the above"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Esophagus","explanation":"“Coins in the esophagus are round in appearance on the frontal view whereas coins in the trachea are\nusually seen on end and are linear in shape.” Foreign Body\n• Coins account for 70% of pediatric ingested foreign bodies\n• Coins will typically become ‘stuck’ at the level of the cricopharyngeus muscle. Coin\nChest X-ray Anteroposterior (AP) View\nIn trachea\n• Visualized in the sagittal planeQ (acquired while entering through vocal cords)\nIn esophagus\n• Visualized in coronal orientationQ\nImage-based question: the picture / video this question refers to is on PDF p. 400 of the source and is not reproduced here.\nAnswer (book): Answer: A. Esophagus"},{"n":194,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 411","pdfPage":400,"stem":"Which of the following is true about esophageal anatomy? (JIPMER GIS 2011)","options":[{"letter":"A","text":"Cervical esophagus is posterior and little right to trachea"},{"letter":"B","text":"Thoracic esophagus is crossed by aortic arch posteriorly"},{"letter":"C","text":"Thoracic esophagus is crossed by left main bronchus posteriorly"},{"letter":"D","text":"Lower esophagus before entering the diaphragm is anterior and left sided"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Lower esophagus before entering the diaphragm is anterior and left sided","explanation":"Type A\nAnswer (book): Answer: D. Lower esophagus before entering the diaphragm is anterior and left sided\nReference: Sabiston 20/e p1067; Schwartz 10/e p941-947; Shackelford 7/e p18-24"},{"n":195,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 412","pdfPage":400,"stem":"Non-progressive contraction of esophagus are: (AIIMS May 2011, All India 2009)","options":[{"letter":"A","text":"Primary"},{"letter":"B","text":"Secondary"},{"letter":"C","text":"Tertiary"},{"letter":"D","text":"Quaternary"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Tertiary","explanation":"Tertiary Contractions of Esophagus\n• Tertiary contractions are simultaneous, non progressive, non peristaltic waves that can occur throughout the\nesophagusQ\n• Tertiary contractions represent uncoordinated contractions of the smooth muscles that are responsible for the\n‘Cork Screw’ appearance of esophageal spasm on Barium swallow\n• Tertiary contractions do not have a physiological function and may be observed in the elderly and in patients with\nesophageal motility disordersQ\nAnswer (book): Answer: C. Tertiary\nReference: Sabiston 20/e p1014-1015"},{"n":196,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 412","pdfPage":400,"stem":"Distance between upper incisors and gastroesophageal junction is: (DPG 97)","options":[{"letter":"A","text":"25 cm"},{"letter":"B","text":"30 cm"},{"letter":"C","text":"40 cm"},{"letter":"D","text":"60 cm"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"40 cm","explanation":"Esophageal Constrictions No.\nDistance from incisor teeth | Bony level | Anatomical Landmark | 1 | 15 cm | Q | C6 | Pharyngoesophageal junction\n(At beginningQ) | 2 | 25 cm | Q | 3 | 40 cmQ | Aortic arch, left bronchusQ T10 | Pierces diaphragmQ\nBALD: Beginning, Aortic arch, Left Bronchus, DiaphragmQ\nAnswer (book): Answer: C. 40 cm"},{"n":197,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 412","pdfPage":400,"stem":"Third constriction of the esophagus is at the level of: (CMC 98)","options":[{"letter":"A","text":"Left bronchus crossing the aorta"},{"letter":"B","text":"Where it pierces the diaphragm"},{"letter":"C","text":"Junction of the esophagus and stomach"},{"letter":"D","text":"Cricopharynx"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Where it pierces the diaphragm","explanation":"b. Where it pierces the diaphragm"},{"n":198,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 412","pdfPage":400,"stem":"Structure not passing through the esophageal hiatus: (AIIMS Nov 2011)","options":[{"letter":"A","text":"Left phrenic nerve"},{"letter":"B","text":"Right vagus nerve"},{"letter":"C","text":"Left vagus nerve"},{"letter":"D","text":"Left gastric artery"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Left phrenic nerve","explanation":"a. Left phrenic nerve"},{"n":199,"chapter":"Esophagus","src":"question on PDF p. 400 · answer on PDF p. 412","pdfPage":400,"stem":"The normal narrowing in the middle of the esophagus is caused by: (COMEDK 2007)","options":[{"letter":"A","text":"Azygos vein"},{"letter":"B","text":"Hemiazygos vein"},{"letter":"C","text":"Right main stem bronchus"},{"letter":"D","text":"Left main stem bronchus"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Left main stem bronchus","explanation":"d. Left main stem bronchus"},{"n":200,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"False statement about esophagus: (PGI Nov 2011)","options":[{"letter":"A","text":"Thoracic esophagus is supplied directly by aorta"},{"letter":"B","text":"Bleeding from varices occurs from midesophagus"},{"letter":"C","text":"Cervical esophagus drains to deep cervical nodes"},{"letter":"D","text":"It has rich lymphatic network"},{"letter":"E","text":"Abdominal part of esophagus drains to left gastric"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Bleeding from varices occurs from midesophagus","explanation":"• Bleeding from esophageal varices most commonly occur in the distal esophagusQ.\nAnswer (book): Answer: B. Bleeding from varices occurs from midesophagus"},{"n":201,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Normal LES pressure: (Recent Question 2017)","options":[{"letter":"A","text":"6–26 mm Hg"},{"letter":"B","text":"30–50 mm Hg"},{"letter":"C","text":"50–60 mm Hg"},{"letter":"D","text":"60–70 mm Hg"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"6–26 mm Hg","explanation":"“The normal LOS is 3–4 cm long and has a pressure of 10–25 mm Hg.”-Bailey 27/e p1068\nAnswer (book): Answer: A. 6–26 mm Hg\nReference: Sabiston 20/e p1016; Bailey 27/e p1068"},{"n":202,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Dysphagia in esophagus means which invasion? (Recent Question 2017)","options":[{"letter":"A","text":"Mucosal"},{"letter":"B","text":"Submucosal"},{"letter":"C","text":"Transmural"},{"letter":"D","text":"Node"}],"multi":null,"correctSet":["C"],"answerIdx":2,"answerLetter":"C","answerText":"Transmural","explanation":"c. Transmural (Ref: Schwartz 10/e p1004)\nDIAPHRAGM"},{"n":203,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Fluoroscopy is used for diagnosis of: (PGI June 98)","options":[{"letter":"A","text":"LV function"},{"letter":"B","text":"Diaphragmatic palsy"},{"letter":"C","text":"Valvular calcification"},{"letter":"D","text":"Pericardial effusion"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Diaphragmatic palsy","explanation":"• Fluoroscopy is used for diagnosis of diaphragmatic palsyQ.\nAnswer (book): Answer: B. Diaphragmatic palsy"},{"n":204,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Diagnosis of traumatic rupture of diaphragm is made by: (PGI June 2007)","options":[{"letter":"A","text":"Laparoscopy"},{"letter":"B","text":"Chest X-ray"},{"letter":"C","text":"Diagnostic peritoneal lavage"},{"letter":"D","text":"CT"}],"multi":null,"correctSet":["A"],"answerIdx":0,"answerLetter":"A","answerText":"Laparoscopy","explanation":"a. Laparoscopy (Ref: Sabiston 20/e p432; Schwartz 10/e p202-203; Bailey 27/e p365)"},{"n":205,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Diaphragm develops from all of the following structures, except: (All India 2011)","options":[{"letter":"A","text":"Septum transversum"},{"letter":"B","text":"Pleuroperitoneal membrane"},{"letter":"C","text":"Cervical myotomes"},{"letter":"D","text":"Dorsal mesocardium"}],"multi":null,"correctSet":["D"],"answerIdx":3,"answerLetter":"D","answerText":"Dorsal mesocardium","explanation":"Development of Diaphragm\n• Septum transversum → Central tendon\n• Mesentery of esophagus → CruraQ\n• Cervical myotomes (muscular input)Q\nQ\n• Pleuroperitoneal membranes → Small intermediate muscular portionQ\n• Body wall → Peripheral muscular diaphragmQ\nAnswer (book): Answer: D. Dorsal mesocardium\nReference: Langman 11/e p161"},{"n":206,"chapter":"Esophagus","src":"question on PDF p. 401 · answer on PDF p. 412","pdfPage":401,"stem":"Which of the following incisions is taken for diaphragmatic surgery? (AIIMS May 2014)","options":[{"letter":"A","text":"Transverse"},{"letter":"B","text":"Circumferential"},{"letter":"C","text":"Vertical"},{"letter":"D","text":"Radial"}],"multi":null,"correctSet":["B"],"answerIdx":1,"answerLetter":"B","answerText":"Circumferential","explanation":"Circumferential incision is generally taken for diaphragmatic surgery.\nDiaphragmatic Incisions\n• Diaphragmatic incisions can be divided into three groups: circumferential, central tendon, and radial.\n1. Circumferential incisions:\n– Circumferential incisions in the periphery result in little loss of function.\n– Must be at least 5 cm lateral to the edge of the central tendon to avoid the posterolateral and anterolateral\nbranches of the phrenic nerve.\n– Difficult to correctly realign after a long operation.\n– Placement of surgical clips on each side of the muscular incision can greatly facilitate the correct spatial\norientation on closing.\n2. Incisions in the central tendon:\n– Do not interrupt any major branch of the nerve itself.\n– Provide excellent visualization of the abdomen from the thorax, and vice versa.\n– Easy to open and to close.\nAnswer (book): Answer: B. Circumferential\nReference: Sabiston and Spencer’s Surgery of Chest 8/e p chapter 7"}]};
const LOKSEWA = {"name":"Federal Loksewa — Medical Officer (2083-01-04)","noKey":true,"questions":[{"n":1,"chapter":"Cardiology","src":"Loksewa paper p. 2 (Medical Officer 2083-01-04)","pdfPage":2,"stem":"Which of the following is the first step in the management of a patient with suspected Acute Myocardial Infarction (AMI)?","options":[{"letter":"A","text":"Administer PPI"},{"letter":"B","text":"Perform immediate catheterization"},{"letter":"C","text":"Start IV fluids"},{"letter":"D","text":"Administer aspirin"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":2,"chapter":"Anesthesiology","src":"Loksewa paper p. 2 (Medical Officer 2083-01-04)","pdfPage":2,"stem":"Most cardiotoxic local anesthetic agents:","options":[{"letter":"A","text":"Lignocaine"},{"letter":"B","text":"Bupivacaine"},{"letter":"C","text":"Prilocaine"},{"letter":"D","text":"Procaine"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":3,"chapter":"Orthopedics","src":"Loksewa paper p. 2 (Medical Officer 2083-01-04)","pdfPage":2,"stem":"The earliest radiological change seen in a case of acute osteomyelitis is:","options":[{"letter":"A","text":"Bony sclerosis"},{"letter":"B","text":"Loss of plane between soft tissue and muscle"},{"letter":"C","text":"Periosteal reaction"},{"letter":"D","text":"Sequestrum formation"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":4,"chapter":"Orthopedics","src":"Loksewa paper p. 2 (Medical Officer 2083-01-04)","pdfPage":2,"stem":"In transverse fracture of the patella, the treatment is:","options":[{"letter":"A","text":"Wire fixation"},{"letter":"B","text":"Plaster cylinder"},{"letter":"C","text":"Patellectomy"},{"letter":"D","text":"Excision of small fragment"}],"multi":null,"correctSet":[],"answerIdx":null,"answerLetter":null,"answerText":null,"explanation":null},{"n":5,"chapter":"Orthop